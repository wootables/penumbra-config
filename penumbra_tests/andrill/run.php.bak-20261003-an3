    // Platform rewrites its cookie on every render: what it reads back on the
    // way up for anything the crumb does not carry (Activity).
    $ck2 = array('range' => $p0['w']['rangeParam'], 'from' => $p0['w']['formFrom'], 'to' => $p0['w']['formTo'],
                 'cmp' => ($p0['w']['cmpOn'] || $p0['w']['cmpPaused']) ? 1 : 0, 'cfrom' => $p0['w']['cmpFormFrom'], 'cto' => $p0['w']['cmpFormTo'],
                 'actions_preset' => $p0['actions_preset'], 'excl_admins' => $p0['excl_admins'] ? 1 : 0, 'excl_automation' => $p0['excl_automation'] ? 1 : 0,
                 'excl_me' => $p0['excl_me'] ? 1 : 0);
    $rp = rep_resolve(via_url(carry_down($p0)));
    $p1 = plat_resolve(via_url(carry_up($rp)), $ck2);
    $n++;
    $d = window_diff($p0['w'], $p1['w']);
    foreach (array('excl_admins', 'excl_automation', 'excl_me', 'user', 'ouc', 'actions_preset') as $k) if ($d === '' && $p1[$k] !== $p0[$k]) $d = $k;
    if ($d !== '') { $bad++; if ($first === '') $first = "$d get=" . json_encode($get) . ' cookie=' . json_encode($ck); }
}
echo "    $n round trips\n";
t_eq($bad, 0, 'window, comparison, weekday/hour, all three toggles, Activity, user and department all come back' . ($first ? " [first: $first]" : ''));

