// ---- the two pages' inline parsing, emulated (pinned by section 7) ----------
$OPT = array('last24h' => true);
function plat_resolve($get, $cookie) {   // analytics_all.php
    global $OPT;
    $prefOr = function ($k, $d) use ($cookie) { return array_key_exists($k, $cookie) ? $cookie[$k] : $d; };
    $w = t_penumbra_an_parse_window($get, $prefOr, $OPT);
    $fs = $w['formSubmitted'];
    $ouc = isset($get['ouc']) ? preg_replace('/\D/', '', (string)$get['ouc']) : '';
    if ($ouc !== '' && !preg_match('/^(\d{2}|\d{6})$/', $ouc)) $ouc = '';
    $ap = isset($get['actions_preset']) ? strtolower(trim($get['actions_preset'])) : (string)$prefOr('actions_preset', 'all');
    if (!in_array($ap, array('all', 'view', 'change', 'deliver', 'errors'), true)) $ap = 'all';
    return array('w' => $w,
        'excl_admins'     => $fs ? isset($get['excl_admins'])     : (bool)$prefOr('excl_admins', false),
        'excl_automation' => $fs ? isset($get['excl_automation']) : (bool)$prefOr('excl_automation', false),
        'excl_me'         => $fs ? isset($get['excl_me'])         : (bool)$prefOr('excl_me', false),
        'user'            => isset($get['user']) ? trim($get['user']) : '',
        'ouc'             => $ouc,
        'actions_preset'  => $ap);
}
// The report page - since the switch (2026-10-02) the engine at report scope,
// as an admin ($anCanSeePeople): no cookie (the window parse gets the defaults),
// the three toggles from the address alone (=1).
function rep_resolve($get) {
    global $OPT;
    $w = t_penumbra_an_parse_window($get, function ($k, $d) { return $d; }, $OPT);
    $ouc = isset($get['ouc']) ? preg_replace('/\D/', '', (string)$get['ouc']) : '';
    if ($ouc !== '' && !preg_match('/^(\d{2}|\d{6})$/', $ouc)) $ouc = '';
    return array('w' => $w,
        'excl_admins'     => isset($get['excl_admins'])     && (string)$get['excl_admins'] === '1',
        'excl_automation' => isset($get['excl_automation']) && (string)$get['excl_automation'] === '1',
        'excl_me'         => isset($get['excl_me'])         && (string)$get['excl_me'] === '1',
        'user'            => isset($get['user']) ? trim((string)$get['user']) : '',
        'ouc'             => $ouc,
        'family'          => isset($get['platform']) && (string)$get['platform'] === '1');
}
$TOGGLES = array('excl_admins', 'excl_automation', 'excl_me');
// What the page SHOWS. The four date-box values only populate hidden inputs
// ("remembered" dates) and are compared only when the source had them.
$FORM_KEYS = array('formFrom', 'formTo', 'cmpFormFrom', 'cmpFormTo');
function window_diff($src, $dst) {
    global $FORM_KEYS;
    foreach ($src as $k => $v) {
        if ($k === 'formSubmitted') continue;
        if (in_array($k, $FORM_KEYS, true)) { if ($v !== '' && $dst[$k] !== $v) return $k; continue; }
        if (!array_key_exists($k, $dst) || $dst[$k] !== $v) return $k;
    }
    return '';
}
function carry_down($pl) {               // analytics_all.php's $anDrillCarry
    return t_penumbra_an_carry_params($pl['w'], array('excl_admins' => $pl['excl_admins'], 'excl_automation' => $pl['excl_automation'],
        'excl_me' => $pl['excl_me'], 'user' => $pl['user'], 'ouc' => $pl['ouc'], 'platform' => true));
}
function carry_up($rp) {                 // the report scope's $anUpHref (chosen state) - all three toggles as shown
    return t_penumbra_an_carry_params($rp['w'], array('excl_admins' => $rp['excl_admins'], 'excl_automation' => $rp['excl_automation'],
        'excl_me' => $rp['excl_me'], 'user' => $rp['user'], 'ouc' => $rp['ouc']));
}
// The address really goes through a URL: build it, then parse it back.
function via_url($params) { parse_str(http_build_query($params), $out); return $out; }

