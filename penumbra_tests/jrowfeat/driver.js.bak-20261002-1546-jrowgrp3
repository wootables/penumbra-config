    rec(flipId, idx >= 0 && !!rowIn('Exempt|||Checked', idx) && !rowIn('Exempt|||Unchecked', idx),
        'row ' + (idx + 1) + ' in Exempt|||Checked ' + !!rowIn('Exempt|||Checked', idx) + ', in Exempt|||Unchecked ' + !!rowIn('Exempt|||Unchecked', idx));
    var obox1 = boxOfBand('Expedited|||Unchecked');
    rec('Y-nested-boxscroll', oScroll0 > 0 && !!obox1 && obox1 !== obox && obox1.scrollTop === oScroll0,
        'the Expedited|||Unchecked box was scrolled ' + oScroll0 + ', after the regroup ' + (obox1 ? obox1.scrollTop : '?') + ' (a new box: ' + (!!obox1 && obox1 !== obox) + ')');
  }
  S.nested = function () { return nestedCheck('Y-nested-bands', 'Y-nested-flip'); };
  S.nestedsent = function () { return nestedCheck('Y-nestedsent-bands', null); };
  // Grouping BY the toggle from the dialog: as level 1, then under PROTOCOL TYPE.
  S.pickgrp = async function () {
    clickEl(document.getElementById('groupTableBtn'));
    await sleep(80);
    var tv = toggleValueIn('groupingColumnSelector');
    rec('P-pickgrp-offered', !!tv, 'the dialog offers the toggle as "' + tv + '"');
    if (!tv) return;
    pickCustom('groupingColumnSelector', tv);
    var before = hides();
    clickEl(document.getElementById('confirmGroupingBtn'));
    await until(function () { return hides() > before && document.querySelectorAll('#groupedResultsContainer .group-wrapper').length > 0; }, 30000);
    await sleep(600);
    var got = bands(0), want = wantBands(false);
    rec('Y-pickgrp', canon(got) === canon(want), 'bands ' + brief(got) + ' want ' + brief(want));
    clickEl(document.getElementById('configureGroupingBtn'));
    await sleep(120);
    pickCustom('groupingColumnSelector', 'PROTOCOL TYPE');
    await sleep(60);
    var tv2 = toggleValueIn('groupingColumnSelector2');
    if (tv2) pickCustom('groupingColumnSelector2', tv2);
    before = hides();
    clickEl(document.getElementById('confirmGroupingBtn'));
    await until(function () { return hides() > before; }, 30000);
    await sleep(600);
    var got2 = bands(1), want2 = wantBands(true);
    rec('Y-pickgrp-nested', !!tv2 && canon(got2) === canon(want2), 'level 2 offered as "' + tv2 + '" | sub-bands ' + brief(got2) + ' want ' + brief(want2));
  };
  // A toggle labelled like a real column (STATUS): grouping by STATUS means the
  // real column, as a search on it does.
  S.shadow = async function () {
    var got = bands(0);
    var want = {}; FX.forEach(function (r, i) { (want[r.STATUS] = want[r.STATUS] || []).push(i); });
    rec('Y-shadow', canon(got) === canon(want), 'bands ' + brief(got) + ' want ' + brief(want));
  };
  // A search still on: after the tick moves the row, the search still holds.
  function hiddenBySearch(tr) { return tr.classList.contains('search-hidden') || tr.style.display === 'none'; }
  S.flipsearch = async function () {
    $('#tableSearch').val('STATUS = Approved');
    JR.runTableSearch();
    await sleep(900);
    await expandAll();
    var all = bandTrs(document.getElementById('groupedResultsContainer'));
    var live = all.filter(function (tr) { return !hiddenBySearch(tr); });
    var closedLive = live.filter(function (tr) { return FX[rowIndexOf(tr)].STATUS === 'Closed'; }).length;
    rec('P-flipsearch-on', live.length === 27 && closedLive === 0, 'rows left by the search ' + live.length + ', Closed among them ' + closedLive);
    var pick = rowsOf('Unchecked', 10).filter(function (tr) { return FX[rowIndexOf(tr)].STATUS === 'Approved'; })[3];
    var idx = pick ? rowIndexOf(pick) : -1;
    if (pick) clickEl(boxOf(pick));
    await sleep(1500);
    all = bandTrs(document.getElementById('groupedResultsContainer'));
    live = all.filter(function (tr) { return !hiddenBySearch(tr); });
    closedLive = live.filter(function (tr) { return FX[rowIndexOf(tr)].STATUS === 'Closed'; }).length;
    var mv = idx >= 0 ? rowIn('Checked', idx) : null;
    rec('Y-flipsearch', !!mv && !hiddenBySearch(mv) && live.length === 27 && closedLive === 0 && !rowIn('Unchecked', idx),
        'moved to Checked ' + !!mv + ', rows left by the search ' + live.length + ', Closed among them ' + closedLive);
  };

  // Leaving a snapshot comparison puts back the grouping stashed on entering it -
  // here the toggle, by the label (this harness's picker lists its sentinel).
  S.cmpexit = async function () {
    if (!JR.setPreCompare || !JR._restorePreCompareGrouping) throw new Error('hook: no compare-exit access');
    JR.setPreCompare({ column: 'Reviewed', agg: null, sort: null });
    var before = hides();
    var ok = JR._restorePreCompareGrouping();
    await until(function () { return hides() > before && document.querySelectorAll('#groupedResultsContainer .group-wrapper').length > 0; }, 8000);
    await sleep(500);
    var got = bands(0), want = wantBands(false);
    rec('Y-cmpexit', ok === true && canon(got) === canon(want), 'regrouped ' + ok + ' | bands ' + brief(got) + ' want ' + brief(want));
  };

  (async function () {
    try {
      if (SCN === 'bylate') probeFirstBuild();
      await boot();
      if (!S[SCN]) throw new Error('unknown scenario ' + SCN);
      await S[SCN]();
      await sleep(50);
    } catch (e) {
      R.fatal = String((e && e.stack) || e);
      R.bootState = { flatRows: document.querySelectorAll('#resultsTable > tbody > tr').length, hides: hides(), queryDone: window.__queryDone,
                      grouped: $('#groupedResultsContainer').is(':visible'), errors: (window.__errors || []).slice(0, 5) };
    }
    R.errors = window.__errors.concat(window.__rejections).slice(0, 10);
    R.hookErr = [window.__JR_ERR, window.__JR_ERR2].filter(Boolean).join('; ');
    R.missing = window.__JR_MISSING || [];
    R.confirms = window.__confirms.slice(0, 5);
    window.__JRRESULT = R;
    window.__JRDONE = true;
    document.getElementById('out').textContent = 'DONE';
  })();
})();
