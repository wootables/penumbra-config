      tick('PROTOCOL TYPE', false);
      tick('TITLE', true);          // PROTOCOL NO. + TITLE: unique, but a different key
      await sleep(200);
      var t = $('#journalKeyUniqueNote').text();
      rec('K-keychg', /Unique/.test(t) && /2 marked/.test(t) && /2 row notes?/.test(t),
          'note before "' + before + '" after "' + t + '"');
      tick('TITLE', false);
      tick('PROTOCOL TYPE', true);
      await sleep(200);
      var t2 = $('#journalKeyUniqueNote').text();
      rec('K-keyback', /Unique/.test(t2) && !/marked/.test(t2), 'back on the saved key: "' + t2 + '"');
    }
  };

  // ---- the two nits of 2026-10-02 -----------------------------------------
  async function openFlatNote(idx) {
    var k = keyOfIndex(idx);
    var b = findNotesBtn(document.getElementById('resultsTable'), k);
    if (!b) return null;
    clickEl(b);
    await sleep(200);
    var tr = b.closest('tr'), child = tr.nextElementSibling;
    return (child && child.classList.contains('journal-note-child')) ? child : null;
  }
  // The row-note Post button against the journal panel's, on a DARK theme
  // (body.is-dark), with the panel's lazy stylesheet loaded as it is once the
  // panel has been opened: same colours, and the row button keeps its size.
  S.postbtn = async function () {
    var child = await openFlatNote(4);
    rec('P-postbtn-open', !!child, 'a row note opened: ' + !!child);
    if (!child) return;
    var link = document.createElement('link');
    link.rel = 'stylesheet'; link.href = 'penumbra_journal.css';
    var loaded = new Promise(function (r) { link.onload = r; link.onerror = r; });
    document.head.appendChild(link);
    await loaded;
    var box = document.createElement('div');
    box.innerHTML = '<div class="journal-composer-buttons"><button type="button" class="journal-post-btn">Post</button></div>';
    document.body.appendChild(box);
    var row = child.querySelector('.journal-rownote-post'), panel = box.querySelector('.journal-post-btn');
    document.body.classList.add('is-dark');
    await sleep(50);
    var cr = getComputedStyle(row), cp = getComputedStyle(panel);
    rec('B-postbtn-dark', cr.color === cp.color && cr.backgroundColor === cp.backgroundColor,
        'row ' + cr.color + ' on ' + cr.backgroundColor + ' | panel ' + cp.color + ' on ' + cp.backgroundColor);
    rec('B-postbtn-size', cr.fontSize === '12px', 'row Post font-size after the panel stylesheet loaded: ' + cr.fontSize);
    document.body.classList.remove('is-dark');
    box.remove();
  };
  function fileDrag(type, el, x, y, files) {
    var dt = new DataTransfer();
    for (var i = 0; i < files.length; i++) dt.items.add(files[i]);
    var ev = new DragEvent(type, { bubbles: true, cancelable: true, composed: true, dataTransfer: dt, clientX: x, clientY: y });
    el.dispatchEvent(ev);
    return ev;
  }
  // A file dropped on an open row-note card is attached to that note (and the
  // app-wide import never sees it); a data file dropped on the table still
  // imports, exactly as before.
  S.dropnote = async function () {
    var child = await openFlatNote(4);
    rec('P-drop-open', !!child, 'a row note opened: ' + !!child);
    if (!child) return;
    var panel = child.querySelector('.journal-rownote-panel');
    panel.scrollIntoView({ block: 'center' });
    await sleep(50);
    var r = panel.getBoundingClientRect(), x = r.left + r.width / 2, y = r.top + r.height / 2;
    var file = new File(['hello note'], 'notes.txt', { type: 'text/plain' });
    // Stands where the app-wide import listens (a document-level drop handler,
    // bound like it): counts the drops that reach it.
    window.__importSaw = 0;
    $(document).on('drop.jrspy', function () { window.__importSaw++; });
    fileDrag('dragenter', document.body, x, y, [file]);
    var under = document.elementFromPoint(x, y) || panel;
    fileDrag('dragover', under, x, y, [file]);
    await sleep(30);
    rec('D-drop-armed', panel.classList.contains('journal-drop-target') && document.body.classList.contains('journal-drop-armed')
        && getComputedStyle(document.getElementById('importDragOverlay')).display === 'none',
        'card lit ' + panel.classList.contains('journal-drop-target') + ', overlay display ' + getComputedStyle(document.getElementById('importDragOverlay')).display);
    var rowsBefore = document.querySelectorAll('#resultsTable > tbody > tr').length;
    under = document.elementFromPoint(x, y) || panel;
    fileDrag('drop', under, x, y, [file]);
    await sleep(600);
    var pill = child.querySelector('.journal-attach-selected');
    var inp = child.querySelector('.journal-attach-input');
    rec('D-drop-attach', /notes\.txt/.test(pill ? pill.textContent : '') && inp && inp.files && inp.files.length === 1
        && document.querySelectorAll('#resultsTable > tbody > tr').length === rowsBefore && !panel.classList.contains('journal-drop-target')
        && window.__importSaw === 0,
        'pill "' + (pill ? pill.textContent.trim() : '') + '", input files ' + (inp && inp.files ? inp.files.length : '?')
        + ', rows ' + rowsBefore + ' -> ' + document.querySelectorAll('#resultsTable > tbody > tr').length + ', drops the import saw ' + window.__importSaw);
    // A CSV dropped on the table (outside any note) is still imported.
    var cell = document.querySelector('#resultsTable > tbody > tr:last-child > td:last-child');
    cell.scrollIntoView({ block: 'center' });
    await sleep(50);
    var cr = cell.getBoundingClientRect(), cx = cr.left + 3, cy = cr.top + 3;
    var csv = new File(['ALPHA,BETA\n1,2\n3,4\n'], 'data.csv', { type: 'text/csv' });
    fileDrag('dragenter', document.body, cx, cy, [csv]);
    fileDrag('dragover', document.elementFromPoint(cx, cy) || cell, cx, cy, [csv]);
    var lit = document.body.classList.contains('journal-drop-armed');
    var sawBefore = window.__importSaw;
    fileDrag('drop', document.elementFromPoint(cx, cy) || cell, cx, cy, [csv]);
    await sleep(100);
    $(document).off('drop.jrspy');
    rec('D-drop-elsewhere', window.__importSaw === sawBefore + 1 && !lit,
        'a CSV dropped on the table reached the import: ' + (window.__importSaw - sawBefore) + ' (drop target armed over the table: ' + lit + ')');
  };

  // The setup changed WHILE the report is grouped: the group tables follow
  // (rebuilt from the flat table - their widths and footers are positional).
  function groupJournalHeads() {
    return leafTables().map(function (t) {
      var head = t.tHead ? t.tHead.rows[t.tHead.rows.length - 1] : null;
      if (!head) return '';
      return Array.prototype.map.call(head.querySelectorAll(':scope > [data-column^="__JOURNAL"]'), function (th) { return th.getAttribute('data-column'); }).join(',');
    });
  }
  function groupRowsJournalCount() {
    var n = [];
    leafTables().forEach(function (t) {
      Array.prototype.forEach.call(t.tBodies[0] ? t.tBodies[0].rows : [], function (tr) {
        if (tr.classList.contains('journal-note-child')) return;
        n.push(tr.querySelectorAll(':scope > [data-column^="__JOURNAL"]').length);
      });
    });
    return n;
  }
  S.cfggrp = async function () {
    if (window.Penumbra && window.Penumbra.syncJournalRowConfigUI) window.Penumbra.syncJournalRowConfigUI();
    await sleep(100);
    clickEl(document.getElementById('journalAddToggleBtn'));
    await sleep(900);
    var defs = (window._penumbraJournalToggles || []).map(function (d) { return '__JOURNAL_TOGGLE__' + d.key; });
    var want = defs.concat(['__JOURNAL_NOTES']).join(',');
    var heads = groupJournalHeads(), counts = groupRowsJournalCount();
    rec('G-cfggrp-add', defs.length === 2 && heads.length > 0 && heads.every(function (h) { return h === want; })
        && counts.length === FX.length && counts.every(function (c) { return c === 3; }),
        'want ' + want + ' | group heads ' + JSON.stringify(heads.slice(0, 3)) + ' | rows with 3 cells ' + counts.filter(function (c) { return c === 3; }).length + '/' + counts.length);
    var rn = document.getElementById('journalRowNotesEnable');
    rn.checked = false; $(rn).trigger('change');
    await sleep(900);
    heads = groupJournalHeads(); counts = groupRowsJournalCount();
    var flatNotes = document.querySelectorAll('#resultsTable [data-column="__JOURNAL_NOTES"]').length;
    rec('G-cfggrp-notesoff', heads.length > 0 && heads.every(function (h) { return h.indexOf('__JOURNAL_NOTES') === -1 && h.split(',').length === 2; })
        && counts.every(function (c) { return c === 2; }) && flatNotes === 0,
        'group heads ' + JSON.stringify(heads.slice(0, 3)) + ' | flat notes cells ' + flatNotes);
  };
  // The summary footer lines up with the header column for column - with '#'
  // hidden (the footer holds VISIBLE columns only), and after a journal column
  // is hidden by the viewer.
  function footerAligned() {
    var hdr = document.getElementById('tableHeader');
    var tf = document.querySelector('#resultsTable > tfoot > tr.total-row-data');
    if (!hdr || !tf) return { ok: false, why: 'no footer' };
    var vis = Array.prototype.filter.call(hdr.children, function (th) { return th.style.display !== 'none'; })
      .map(function (th) { return th.getAttribute('data-column'); });
    var cells = Array.prototype.map.call(tf.children, function (td) { return td.getAttribute('data-column'); });
    return { ok: vis.join('|') === cells.join('|'), why: 'header ' + vis.join(',') + ' | footer ' + cells.join(',') };
  }
  S.footer = async function () {
    await sleep(300);
    var tf = document.querySelector('#resultsTable > tfoot > tr.total-row-data');
    rec('P-footer', !!tf && /\$/.test(tf.textContent), 'summary footer present: ' + !!tf + ' "' + (tf ? tf.textContent.replace(/\s+/g, ' ').trim().slice(0, 60) : '') + '"');
    var a = footerAligned();
    rec('F-footer-align', a.ok, a.why);
    // The viewer hides the Reviewed column (as the column chooser does: every
    // cell display:none), the footer is rebuilt, the journal pass runs again.
    $('#resultsTable [data-column="__JOURNAL_TOGGLE__toggle1"]').css('display', 'none');
    JR.updateTotalRow();
    if (window.Penumbra.applyJournalToggles) window.Penumbra.applyJournalToggles();
    await sleep(500);
    var b = footerAligned();
    rec('F-footer-hidden', b.ok, b.why);
  };

  // The status bar's "custom layout" pill compares the on-screen columns with
  // the report's saved layout: the journal columns are in neither on purpose.
  S.ccpill = async function () {
    // Nudge the status bar's #resultCount observer for a fresh refresh (the
    // ungroup path does the same), now that the journal columns are in.
    var rc = document.getElementById('resultCount');
    if (rc) { var c = document.createComment(''); rc.appendChild(c); rc.removeChild(c); }
    await sleep(400);
    var pill = document.getElementById('sbCustomCols');
    var shown = pill ? getComputedStyle(pill).display !== 'none' : null;
    var jth = document.querySelectorAll('#tableHeader th[data-column^="__JOURNAL"]').length;
    rec('C-ccpill', jth === 2 && shown === false, 'journal headers ' + jth + ', custom-layout pill shown ' + shown + ' "' + ($('#sbCustomColsDiff').text() || '').replace(/\s+/g, ' ').slice(0, 120) + '"');
  };

  (async function () {
    try {
      await boot();
      if (!S[SCN]) throw new Error('unknown scenario ' + SCN);
      await S[SCN]();
      await sleep(50);
    } catch (e) {
      R.fatal = String((e && e.stack) || e);
      R.bootState = { flatRows: document.querySelectorAll('#resultsTable > tbody > tr').length, hides: hides(), queryDone: window.__queryDone,
                      grouped: $('#groupedResultsContainer').is(':visible'), errors: (window.__errors || []).slice(0, 5) };
    }
    R.errors = window.__errors.concat(window.__rejections).slice(0, 10);
    R.hookErr = [window.__JR_ERR, window.__JR_ERR2].filter(Boolean).join('; ');
    R.missing = window.__JR_MISSING || [];
    R.confirms = window.__confirms.slice(0, 5);
    window.__JRRESULT = R;
    window.__JRDONE = true;
    document.getElementById('out').textContent = 'DONE';
  })();
})();
