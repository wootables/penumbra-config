                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                if (isset($data[$rk][$ck]) && isset($data[$rk][$ck]['values'])) {
                                    $allValsForPos = array_merge($allValsForPos, $data[$rk][$ck]['values']);
                                }
                            }
                        }
                        if ($effectiveCornerAgg === 'avg') {
                            $colSum = pivot_compute_agg_from_values($allValsForPos, 'sum');
                            $cornerVal = count($sortedColKeys) > 0 ? $colSum / count($sortedColKeys) : 0;
                        } else {
                            $cornerVal = pivot_compute_agg_from_values($allValsForPos, $effectiveCornerAgg);
                        }
                    }
                    $formatted = pivot_format_value($cornerVal, $effectiveCornerAgg, $isCurrency, $sourceMaxDecimals, true);
                    $html .= "<td style='{$footerCss}'><strong>{$formatted}</strong></td>";
                } else {
                    $displayGrandTotal = $grandTotals[$idx];

                    if ($aggType === 'pct_change') {
                        if (count($sortedColKeys) > 1) {
                            $firstColKey = $sortedColKeys[0];
                            $lastColKey = $sortedColKeys[count($sortedColKeys) - 1];
                            $baseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                            $_cpcBaseT = $aggTypes[$baseIdx];
                            $firstTotal = pivot_total_slot_scalar(isset($colTotalsFinal[$firstColKey][$baseIdx]) ? $colTotalsFinal[$firstColKey][$baseIdx] : null, $_cpcBaseT);
                            $lastTotal = pivot_total_slot_scalar(isset($colTotalsFinal[$lastColKey][$baseIdx]) ? $colTotalsFinal[$lastColKey][$baseIdx] : null, $_cpcBaseT);
                            if ($firstTotal === null || $lastTotal === null || $firstTotal == 0 || $firstTotal >= 1e308 || $firstTotal <= -1e308) {
                                $displayGrandTotal = 'N/A';
                            } else {
                                $displayGrandTotal = (($lastTotal - $firstTotal) / $firstTotal) * 100;
                            }
                        } else {
                            $displayGrandTotal = 'N/A';
                        }
                    } elseif ($aggType === 'diff') {
                        // Whole-span change: last column's base total minus the first's
                        if (count($sortedColKeys) > 1) {
                            $dcBaseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                            $_dcBaseT = $aggTypes[$dcBaseIdx];
                            $dcFirst = pivot_total_slot_scalar(isset($colTotalsFinal[$sortedColKeys[0]][$dcBaseIdx]) ? $colTotalsFinal[$sortedColKeys[0]][$dcBaseIdx] : null, $_dcBaseT);
                            $dcLast = pivot_total_slot_scalar(isset($colTotalsFinal[$sortedColKeys[count($sortedColKeys) - 1]][$dcBaseIdx]) ? $colTotalsFinal[$sortedColKeys[count($sortedColKeys) - 1]][$dcBaseIdx] : null, $_dcBaseT);
                            $displayGrandTotal = (!is_numeric($dcFirst) || !is_numeric($dcLast) || abs($dcFirst) >= 1e308 || abs($dcLast) >= 1e308) ? 'N/A' : ($dcLast - $dcFirst);
                        } else {
                            $displayGrandTotal = 'N/A';
                        }
                    } elseif ($aggType === 'pct_change:down' || $aggType === 'diff:down') {
                        // Vertical whole-span: first row's base total to the last row's
                        $vcBaseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                        if (count($allRowKeys) > 1) {
                            $_vcBaseT = $aggTypes[$vcBaseIdx];
                            $vcFirstT = pivot_total_slot_scalar(isset($rowTotalsMap[$allRowKeys[0]][$vcBaseIdx]) ? $rowTotalsMap[$allRowKeys[0]][$vcBaseIdx] : null, $_vcBaseT);
                            $vcLastT = pivot_total_slot_scalar(isset($rowTotalsMap[$allRowKeys[count($allRowKeys) - 1]][$vcBaseIdx]) ? $rowTotalsMap[$allRowKeys[count($allRowKeys) - 1]][$vcBaseIdx] : null, $_vcBaseT);
                            if (!is_numeric($vcFirstT) || !is_numeric($vcLastT) || abs($vcFirstT) >= 1e308 || abs($vcLastT) >= 1e308) {
                                $displayGrandTotal = 'N/A';
                            } elseif ($aggType === 'pct_change:down') {
                                $displayGrandTotal = ($vcFirstT == 0) ? 'N/A' : (($vcLastT - $vcFirstT) / $vcFirstT) * 100;
                            } else {
                                $displayGrandTotal = $vcLastT - $vcFirstT;
                            }
                        } else {
                            $displayGrandTotal = 'N/A';
                        }
                    } elseif ($aggType === 'pct_row_total' || $aggType === 'pct_col_total' || $aggType === 'pct_grand_total'
                        || $aggType === 'pct_parent_row' || $aggType === 'pct_parent_col'
                        || $aggType === 'pct_cum' || $aggType === 'pct_cum:down') {
                        $displayGrandTotal = 100;
                    } elseif (pivot_is_running_total_like($aggType)) {
                        $baseIdx2 = pivot_find_base_agg_idx($aggTypes, $idx);
                        $displayGrandTotal = 0;
                        foreach ($sortedColKeys as $ck) {
                            $displayGrandTotal += (isset($colTotalsFinal[$ck][$baseIdx2]) ? $colTotalsFinal[$ck][$baseIdx2] : 0);
                        }
                    } elseif ($aggType === 'running_count' || $aggType === 'running_count:down') {
                        // Sum of all cell counts across all rows and columns
                        $displayGrandTotal = 0;
                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                $cd = isset($data[$rk][$ck]) ? $data[$rk][$ck] : null;
                                $displayGrandTotal += $cd ? (isset($cd['count']) ? $cd['count'] : (isset($cd['values']) ? count($cd['values']) : 0)) : 0;
                            }
                        }
                    } elseif ($aggType === 'index' || $aggType === 'index:down') {
                        $sum = 0; $count = 0;
                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                $v = $cellValuesMap[$rk][$ck][$idx];
                                if (is_numeric($v)) { $sum += $v; $count++; }
                            }
                        }
                        $displayGrandTotal = ($count > 0) ? $sum / $count : 'N/A';
                    } elseif ($aggType === 'avg') {
                        // Compute grand average consistent with row-level avg logic: sum / number of columns
                        $allAvgValues = array();
                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                if (isset($data[$rk][$ck]) && isset($data[$rk][$ck]['values'])) {
                                    $allAvgValues = array_merge($allAvgValues, $data[$rk][$ck]['values']);
                                }
                            }
                        }
                        $totalSum = pivot_compute_agg_from_values($allAvgValues, 'sum');
                        $displayGrandTotal = count($sortedColKeys) > 0 ? $totalSum / count($sortedColKeys) : 0;
                    } elseif ($aggType === 'distinct') {
                        $displayGrandTotal = count($grandTotals[$idx]);
                    } elseif ($aggType === 'mode') {
                        $maxF = 0; $m = '';
                        foreach ($grandTotals[$idx] as $k => $f) {
                            if ($f > $maxF) { $maxF = $f; $m = $k; }
                        }
                        $displayGrandTotal = $m;
                    } elseif (pivot_is_wavg_agg($aggType)) {
                        $displayGrandTotal = !empty($grandTotals[$idx]['w']) ? pivot_wavg_of($grandTotals[$idx]) : null;
                    } elseif (pivot_is_pctile_agg($aggType)) {
                        $displayGrandTotal = count($grandTotals[$idx]) ? pivot_percentile_of($grandTotals[$idx], pivot_percentile_p($aggType)) : null;
                    } elseif ($aggType === 'stddev') {
                        $displayGrandTotal = (count($grandTotals[$idx]) >= 2) ? pivot_sample_stddev($grandTotals[$idx]) : null;
                    } elseif ($aggType === 'range') {
                        $displayGrandTotal = ($grandTotals[$idx]['min'] >= 1e308) ? null : ($grandTotals[$idx]['max'] - $grandTotals[$idx]['min']);
                    } elseif ($aggType === 'antimode') {
                        $displayGrandTotal = pivot_antimode_from_freq($grandTotals[$idx]);
                    } elseif ($aggType === 'formula') {
                        // Corner cell: evaluate formula with grand totals as context
                        $_fAstCr = isset($formulaASTs[$idx]) ? $formulaASTs[$idx] : null;
                        if (!$_fAstCr) {
                            $displayGrandTotal = null;
                        } else {
                            $_fCtxCr = array();
                            foreach ($aggTypes as $_oi3 => $_ot3) {
                                if ($_ot3 === 'formula') continue;
                                $_lblCr = isset($aggDisplayLabels[$_oi3]) ? $aggDisplayLabels[$_oi3] : pivot_get_agg_label($_ot3);
                                $_vCr = isset($grandTotals[$_oi3]) ? $grandTotals[$_oi3] : null;
                                $_fCtxCr[$_lblCr] = (is_numeric($_vCr) && is_finite($_vCr)) ? (float)$_vCr : null;
                            }
                            $displayGrandTotal = pivot_eval_formula($_fAstCr, $_fCtxCr);
                        }
                    }

                    $formatted = pivot_format_value($displayGrandTotal, $aggType, $isCurrency, $sourceMaxDecimals, true, pivot_unit_base($aggTypes, $idx));
                    $html .= "<td style='{$footerCss}'><strong>{$formatted}</strong></td>";
                }
            }
        }
    }

    $html .= '</tr></tfoot></table>';
    return $html;
}

function pivot_render_hierarchy_level(&$html, $node, $currentDepth, $targetDepth, $isLeafLevel, $isMulti, $subLabels, $needsGTSubHeaders, $thCss, $subHeaderCss, $s) {
    if ($currentDepth === $targetDepth) {
        $keys = array_keys($node);
        $isIndexed = isset($keys[0]) && $keys[0] === 0;

        if ($isIndexed) {
            // Leaf array - render each entry
            foreach ($node as $key) {
                if ($isMulti) {
                    $html .= "<th style='{$thCss}' colspan='" . count($subLabels) . "'>" . htmlspecialchars($key) . "</th>";
                } elseif ($needsGTSubHeaders) {
                    $html .= "<th style='{$thCss}' rowspan='2'>" . htmlspecialchars($key) . "</th>";
                } else {
                    $html .= "<th style='{$thCss}'>" . htmlspecialchars($key) . "</th>";
                }
            }
        } else {
            // Intermediate object - render keys with colspan
            foreach ($node as $key => $child) {
                $leaves = pivot_count_leaves($child);
                $colspan = $isMulti ? $leaves * count($subLabels) : $leaves;
                $html .= "<th style='{$thCss}' colspan='{$colspan}'>" . htmlspecialchars($key) . "</th>";
            }
        }
    } else {
        // Not at target depth yet - recurse into children
        $keys = array_keys($node);
        $isIndexed = isset($keys[0]) && $keys[0] === 0;
        if ($isIndexed) return; // leaf array, can't go deeper
        foreach ($node as $child) {
            pivot_render_hierarchy_level($html, $child, $currentDepth + 1, $targetDepth, $isLeafLevel, $isMulti, $subLabels, $needsGTSubHeaders, $thCss, $subHeaderCss, $s);
        }
    }
}

function generate_pivot_csv_string($flatRows, $pivotSettings) {
    $rowFields = isset($pivotSettings['rows']) ? $pivotSettings['rows'] : array();
    $colFields = isset($pivotSettings['cols']) ? $pivotSettings['cols'] : array();
    $valField = isset($pivotSettings['vals']) ? $pivotSettings['vals'] : '';
    $aggTypes = isset($pivotSettings['agg']) ? $pivotSettings['agg'] : array('sum');
    if (!is_array($aggTypes)) $aggTypes = array($aggTypes);
    $aggCustomLabels = isset($pivotSettings['aggLabels']) ? $pivotSettings['aggLabels'] : null;
    $aggDisplayLabels = pivot_build_agg_display_labels($aggTypes, $aggCustomLabels);
    $aggFormulas = isset($pivotSettings['aggFormulas']) ? $pivotSettings['aggFormulas'] : null;
    $formulaASTs = pivot_parse_all_formulas($aggTypes, $aggFormulas ? $aggFormulas : array());
    $sortOrder = isset($pivotSettings['sortOrder']) ? $pivotSettings['sortOrder'] : 'asc';
    $colSortOrder = isset($pivotSettings['colSortOrder']) ? $pivotSettings['colSortOrder'] : $sortOrder;
    $totalColAggs = isset($pivotSettings['totalColAggs']) ? $pivotSettings['totalColAggs'] : null;
    $totalRowAggs = isset($pivotSettings['totalRowAggs']) ? $pivotSettings['totalRowAggs'] : null;
    $totalRowAggLabels = isset($pivotSettings['totalRowAggLabels']) ? $pivotSettings['totalRowAggLabels'] : null;
    $totalRowAggBaseIdx = isset($pivotSettings['totalRowAggBaseIdx']) ? $pivotSettings['totalRowAggBaseIdx'] : null;
    $rowTotalBaseMap = pivot_resolve_row_total_base_indices($totalRowAggs, $aggTypes, $totalRowAggBaseIdx);
    $aggColOverrides = isset($pivotSettings['aggColOverrides']) ? $pivotSettings['aggColOverrides'] : null;
    $extraValFields = pivot_get_extra_val_fields($aggColOverrides, $valField);
    $aggFilters = isset($pivotSettings['aggFilters']) ? $pivotSettings['aggFilters'] : null;

    $pivotData = pivot_process_data($flatRows, $rowFields, $colFields, $valField, $extraValFields, $aggFilters, $aggTypes);
    $data = $pivotData['data'];
    if (empty($data)) return '';

    // Helper: resolve override column for a given agg index (returns null if no override)
    $_aggCol = function($aggIdx) use ($aggColOverrides, $aggTypes) {
        if (!$aggColOverrides) return null;
        if (pivot_is_derived_agg($aggTypes[$aggIdx])) {
            $baseIdx = null;
            for ($i = $aggIdx - 1; $i >= 0; $i--) {
                if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
            }
            if ($baseIdx === null) {
                for ($i = 0; $i < count($aggTypes); $i++) {
                    if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
                }
            }
            return $baseIdx !== null ? (isset($aggColOverrides[$baseIdx]) ? $aggColOverrides[$baseIdx] : null) : null;
        }
        return isset($aggColOverrides[$aggIdx]) ? $aggColOverrides[$aggIdx] : null;
    };

    // Helper: resolve filter index for a given agg index
    $_aggFilterIdx = function($aggIdx) use ($aggFilters, $aggTypes) {
        if (!$aggFilters || !is_array($aggFilters)) return null;
        if (isset($aggFilters[$aggIdx]) && $aggFilters[$aggIdx] !== null && $aggFilters[$aggIdx] !== '') {
            return $aggIdx;
        }
        if (pivot_is_derived_agg($aggTypes[$aggIdx])) {
            $baseIdx = null;
            for ($i = $aggIdx - 1; $i >= 0; $i--) {
                if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
            }
            if ($baseIdx === null) {
                for ($i = 0; $i < count($aggTypes); $i++) {
                    if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
                }
            }
            if ($baseIdx !== null && isset($aggFilters[$baseIdx]) && $aggFilters[$baseIdx] !== null && $aggFilters[$baseIdx] !== '') {
                return $baseIdx;
            }
        }
        return null;
    };

    $isCurrency = pivot_detect_currency($flatRows, $valField);

    // Detect max decimals for formatting
    $sourceMaxDecimals = 0;
    $checkedValues = 0;
    foreach ($data as $rk => $cols) {
        foreach ($cols as $ck => $cellData) {
            if (isset($cellData['values'])) {
                foreach ($cellData['values'] as $sv) {
                    $svClean = str_replace(array('$', ',', '(', ')'), '', trim((string)$sv));
                    $dotPos = strpos($svClean, '.');
                    if ($dotPos !== false) {
                        $decs = strlen($svClean) - $dotPos - 1;
                        if ($decs > $sourceMaxDecimals) $sourceMaxDecimals = $decs;
                    }
                    $checkedValues++;
                }
            }
            if ($checkedValues > 500) break;
        }
        if ($checkedValues > 500) break;
    }

    // Sort keys
    $allRowKeys = array_keys($data);
    $customSortOrders = isset($pivotSettings['customSortOrders']) ? $pivotSettings['customSortOrders'] : array();
    // Hoisted out of the two usort callbacks below - custom_sort_pivot_keys() used
    // to resolve a comparator per field PER COMPARISON.
    $rowFieldCmp = pivot_build_field_comparators($rowFields, $customSortOrders);
    $colFieldCmp = pivot_build_field_comparators($colFields, $customSortOrders);
    usort($allRowKeys, function($a, $b) use ($sortOrder, $rowFields, $rowFieldCmp) {
        return custom_sort_pivot_keys($a, $b, $rowFields, $rowFieldCmp, $sortOrder === 'desc' ? 'desc' : 'asc');
    });

    $allColKeysSet = array();
    foreach ($data as $cols) {
        foreach (array_keys($cols) as $ck) $allColKeysSet[$ck] = true;
    }
    $sortedColKeys = array_keys($allColKeysSet);
    usort($sortedColKeys, function($a, $b) use ($colSortOrder, $colFields, $colFieldCmp) {
        return custom_sort_pivot_keys($a, $b, $colFields, $colFieldCmp, $colSortOrder === 'desc' ? 'desc' : 'asc');
    });
    // "Fill empty periods" (:fill on a single period-split column field):
    // insert missing periods as synthetic column keys. The gap walk needs
    // ascending labels - flip a descending sort around it. Mirrors main.js.
    $_fillSf = pivot_cols_fill_spec($colFields);
    if ($_fillSf !== null) {
        if ($colSortOrder === 'desc') $sortedColKeys = array_reverse($sortedColKeys);
        pivot_expand_colkeys_with_gaps($sortedColKeys, $_fillSf['split'], $_fillSf);
        if ($colSortOrder === 'desc') $sortedColKeys = array_reverse($sortedColKeys);
    }

    $isMulti = count($aggTypes) > 1;
    $hasGrandTotalCol = (count($sortedColKeys) > 1 && count($colFields) > 0);
    $rowTotalAggTypes = ($totalRowAggs && count($totalRowAggs) > 0) ? $totalRowAggs : $aggTypes;
    $numRowFields = count($rowFields);

    // Apply column-value-based sorting if sortCriteria is present
    $sortCriteriaData = isset($pivotSettings['sortCriteria']) ? $pivotSettings['sortCriteria'] : null;
    if ($sortCriteriaData && !empty($sortCriteriaData)) {
        pivot_apply_value_sort($allRowKeys, $data, $sortedColKeys, $aggTypes, $numRowFields, $sortCriteriaData, $hasGrandTotalCol, $rowTotalAggTypes);
    }

    // Apply rank (Top N / Bottom N) filtering
    pivot_apply_rank($allRowKeys, $data, $pivotSettings, $sortedColKeys, $aggTypes);

    $fp = fopen('php://temp', 'r+');
    // BOM for Excel
    fwrite($fp, "\xEF\xBB\xBF");

    // Header row - for CSV, flatten multi-agg as "ColName (AggLabel)"
    $headers = array();
    foreach ($rowFields as $f) $headers[] = pivot_field_display_label($f);
    $numColFields = count($colFields);
    foreach ($sortedColKeys as $colKey) {
        $displayCol = str_replace('|||', ' - ', $colKey);
        // When no col fields, use agg label instead of empty string
        if ($displayCol === '' && $numColFields === 0) {
            $displayCol = $isMulti ? $valField : $aggTypes[0] . '(' . $valField . ')';
        }
        if ($isMulti) {
            foreach ($aggTypes as $_hi => $at) {
                $headers[] = $displayCol . ' (' . $aggDisplayLabels[$_hi] . ')';
            }
        } else {
            $headers[] = $displayCol;
        }
    }
    if ($hasGrandTotalCol) {
        $gtCount = count($rowTotalAggTypes);
        $rowTotalCsvLabels = ($rowTotalAggTypes === $aggTypes) ? $aggDisplayLabels : pivot_build_agg_display_labels($rowTotalAggTypes, $totalRowAggLabels);
        if ($gtCount > 1 || $isMulti) {
            foreach ($rowTotalAggTypes as $_gi => $at) {
                $headers[] = 'Grand Total (' . $rowTotalCsvLabels[$_gi] . ')';
            }
        } else {
            // Derive label
            if ($totalRowAggs && count($totalRowAggs) === 1) {
                $headers[] = pivot_agg_total_label($totalRowAggs[0]);
            } elseif (count($aggTypes) === 1) {
                $headers[] = pivot_agg_total_label($aggTypes[0]);
            } else {
                $headers[] = 'Grand Total';
            }
        }
    }
    fputcsv($fp, $headers);

    // Data rows - 3-pass algorithm for context-dependent aggregation types
    // (pct_change, pct_row_total, pct_col_total, index)
    $numAggs = count($aggTypes);

    // --- PASS 1: Compute base values and accumulate row/col totals ---
    // Time intelligence: same loop-invariant setup the HTML renderer builds, so
    // an emailed / exported YTD resets on exactly the same year boundaries.
    $_tiColInfo = pivot_period_info($colFields);
    $_tiColOk   = pivot_ytd_axis_usable($sortedColKeys, $_tiColInfo);
    $_tiPrevCol = array(); $_tiSeenCol = null;
    foreach ($sortedColKeys as $_tiCk) { $_tiPrevCol[$_tiCk] = $_tiSeenCol; $_tiSeenCol = $_tiCk; }
    $_tiColYoy = pivot_yoy_index($sortedColKeys, $_tiColInfo);
    $_csvRollWins = array();
    $csvCellValues = array();   // csvCellValues[rowKey][colKey][aggIdx] = value
    $csvRowTotals = array();    // csvRowTotals[rowKey][aggIdx] = sum
    $csvColTotals = array();    // csvColTotals[colKey][aggIdx] = sum

    foreach ($allRowKeys as $rowKey) {
        $csvCellValues[$rowKey] = array();
        $csvRowTotals[$rowKey] = array_fill(0, $numAggs, 0);
        $previousCellData = null;

        foreach ($sortedColKeys as $colIndex => $colKey) {
            if (!isset($csvColTotals[$colKey])) {
                $csvColTotals[$colKey] = array_fill(0, $numAggs, 0);
            }
            $cellData = isset($data[$rowKey][$colKey]) ? $data[$rowKey][$colKey] : null;
            $csvCellValues[$rowKey][$colKey] = array();

            foreach ($aggTypes as $aggIdx => $at) {
                if (pivot_is_roll($at) && !pivot_is_roll_down($at)) {
                    $rB = pivot_find_base_agg_type($aggTypes, $aggIdx);
                    $rV = pivot_extract_agg_value($cellData, $rB, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                    if (!isset($_csvRollWins[$rowKey][$aggIdx])) $_csvRollWins[$rowKey][$aggIdx] = array();
                    $_csvRollWins[$rowKey][$aggIdx][] = (is_numeric($rV) && abs($rV) < 1e308) ? (float)$rV : null;
                    $rM = pivot_roll_mean($_csvRollWins[$rowKey][$aggIdx], pivot_roll_n($at));
                    $csvCellValues[$rowKey][$colKey][$aggIdx] = ($rM === null) ? 'N/A' : $rM;
                } elseif (pivot_is_roll_down($at)) {
                    $rBD = pivot_find_base_agg_type($aggTypes, $aggIdx);
                    $csvCellValues[$rowKey][$colKey][$aggIdx] = pivot_extract_agg_value($cellData, $rBD, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                } elseif ($at === 'yoy') {
                    $yPk = pivot_yoy_prev_key($colKey, $_tiColInfo, $_tiColYoy);
                    if ($yPk === null) {
                        $csvCellValues[$rowKey][$colKey][$aggIdx] = 'N/A';
                    } else {
                        $yB = pivot_find_base_agg_type($aggTypes, $aggIdx);
                        $yPrevCell = isset($data[$rowKey][$yPk]) ? $data[$rowKey][$yPk] : null;
                        $yC = pivot_extract_agg_value($cellData, $yB, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $yP = pivot_extract_agg_value($yPrevCell, $yB, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $csvCellValues[$rowKey][$colKey][$aggIdx] = (!is_numeric($yC) || !is_numeric($yP) || $yP == 0 || abs($yC) >= 1e308 || abs($yP) >= 1e308)
                            ? 'N/A' : (($yC - $yP) / $yP) * 100;
                    }
                } elseif ($at === 'pct_change') {
                    if ($colIndex === 0) {
                        $csvCellValues[$rowKey][$colKey][$aggIdx] = 'N/A';
                    } else {
                        $baseAt = pivot_find_base_agg_type($aggTypes, $aggIdx);
                        $curVal = pivot_extract_agg_value($cellData, $baseAt, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $prevVal = pivot_extract_agg_value($previousCellData, $baseAt, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        if ($prevVal == 0 || $prevVal >= 1e308 || $prevVal <= -1e308) {
                            $csvCellValues[$rowKey][$colKey][$aggIdx] = 'N/A';
                        } else {
                            $csvCellValues[$rowKey][$colKey][$aggIdx] = (($curVal - $prevVal) / $prevVal) * 100;
                        }
                    }
                } elseif ($at === 'diff') {
                    // Absolute change vs the previous column
                    if ($colIndex === 0) {
                        $csvCellValues[$rowKey][$colKey][$aggIdx] = 'N/A';
                    } else {
                        $baseAt = pivot_find_base_agg_type($aggTypes, $aggIdx);
                        $dCur = pivot_extract_agg_value($cellData, $baseAt, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $dPrev = pivot_extract_agg_value($previousCellData, $baseAt, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $csvCellValues[$rowKey][$colKey][$aggIdx] = (!is_numeric($dCur) || !is_numeric($dPrev) || abs($dCur) >= 1e308 || abs($dPrev) >= 1e308) ? 'N/A' : ($dCur - $dPrev);
                    }
                } elseif ($at === 'pct_change:down' || $at === 'diff:down' || $at === 'index:down') {
                    // Raw base value; the vertical pass below transforms it
                    $baseAt = pivot_find_base_agg_type($aggTypes, $aggIdx);
                    $csvCellValues[$rowKey][$colKey][$aggIdx] = pivot_extract_agg_value($cellData, $baseAt, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                } elseif (pivot_is_running_total_like($at)) {
