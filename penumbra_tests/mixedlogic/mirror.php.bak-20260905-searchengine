                    else {
                        $ixBase = pivot_find_base_agg_type($aggTypes, $aggIdx);
                        $ixCur = pivot_extract_agg_value($cellData, $ixBase, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $ixRefCell = isset($data[$rowKey][$_ixBaseColKey]) ? $data[$rowKey][$_ixBaseColKey] : null;
                        $ixRef = pivot_extract_agg_value($ixRefCell, $ixBase, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $values[] = (!is_numeric($ixCur) || !is_numeric($ixRef) || $ixRef == 0 || abs($ixRef) >= 1e308)
                            ? 'N/A' : ($ixCur / $ixRef) * 100;
                    }
                } elseif ($aggType === 'yoy') {
                    // Percent change vs THE SAME PERIOD last year, matched by
                    // label rather than by counting columns back.
                    $yoyPrevKey = pivot_yoy_prev_key($colKey, $_tiColInfo, $_tiColYoy);
                    if ($yoyPrevKey === null) {
                        $values[] = 'N/A';
                    } else {
                        $yBase = pivot_find_base_agg_type($aggTypes, $aggIdx);
                        $yPrevCell = isset($data[$rowKey][$yoyPrevKey]) ? $data[$rowKey][$yoyPrevKey] : null;
                        $yCur = pivot_extract_agg_value($cellData, $yBase, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $yPrv = pivot_extract_agg_value($yPrevCell, $yBase, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $values[] = (!is_numeric($yCur) || !is_numeric($yPrv) || $yPrv == 0 || abs($yCur) >= 1e308 || abs($yPrv) >= 1e308)
                            ? 'N/A' : (($yCur - $yPrv) / $yPrv) * 100;
                    }
                } elseif ($aggType === 'yoy:down') {
                    // Raw base value; the vertical pass pairs prior-year rows.
                    $yBaseD = pivot_find_base_agg_type($aggTypes, $aggIdx);
                    $values[] = pivot_extract_agg_value($cellData, $yBaseD, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                } elseif (pivot_is_ytd($aggType) && !($aggType === 'ytd:down' ? $_tiRowOk : $_tiColOk)) {
                    // YTD asked for on an axis that carries no year at all.
                    $values[] = 'N/A';
                } elseif (pivot_is_running_total_like($aggType)) {
                    $baseAggType = pivot_find_base_agg_type($aggTypes, $aggIdx);
                    $currentVal = pivot_extract_agg_value($cellData, $baseAggType, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                    if (pivot_is_run_total_down($aggType)) {
                        // Store raw base value; vertical pass below will accumulate
                        $values[] = $currentVal;
                    } else {
                        if (!isset($cellValuesMap[$rowKey])) $cellValuesMap[$rowKey] = array();
                        if (!isset($cellValuesMap[$rowKey]['__runningTotals'])) $cellValuesMap[$rowKey]['__runningTotals'] = array();
                        if (!isset($cellValuesMap[$rowKey]['__runningTotals'][$aggIdx])) {
                            $cellValuesMap[$rowKey]['__runningTotals'][$aggIdx] = 0;
                        }
                        // YTD = Running Total + a reset at each year boundary. On an
                        // :fy / :fyq axis the registry yields FISCAL years, so this
                        // one line gives fiscal YTD with no extra branch - as in js.
                        $_tiPk = isset($_tiPrevCol[$colKey]) ? $_tiPrevCol[$colKey] : null;
                        if (pivot_ytd_reset($aggType, $_tiPk, $colKey, $_tiColInfo)) {
                            $cellValuesMap[$rowKey]['__runningTotals'][$aggIdx] = 0;
                        }
                        $cellValuesMap[$rowKey]['__runningTotals'][$aggIdx] += $currentVal;
                        $values[] = $cellValuesMap[$rowKey]['__runningTotals'][$aggIdx];
                    }
                } elseif ($aggType === 'running_count' || $aggType === 'running_count:down') {
                    $currentCount = $cellData ? (isset($cellData['count']) ? $cellData['count'] : (isset($cellData['values']) ? count($cellData['values']) : 0)) : 0;
                    if ($aggType === 'running_count:down') {
                        // Store raw count; vertical pass below will accumulate
                        $values[] = $currentCount;
                    } else {
                        if (!isset($cellValuesMap[$rowKey])) $cellValuesMap[$rowKey] = array();
                        if (!isset($cellValuesMap[$rowKey]['__runningCounts'])) $cellValuesMap[$rowKey]['__runningCounts'] = array();
                        if (!isset($cellValuesMap[$rowKey]['__runningCounts'][$aggIdx])) {
                            $cellValuesMap[$rowKey]['__runningCounts'][$aggIdx] = 0;
                        }
                        $cellValuesMap[$rowKey]['__runningCounts'][$aggIdx] += $currentCount;
                        $values[] = $cellValuesMap[$rowKey]['__runningCounts'][$aggIdx];
                    }
                } elseif ($aggType === 'pct_cum:down') {
                    // Store the raw base value; the vertical pass accumulates and
                    // divides by the column total (Cumulative % ↓ / Pareto).
                    $values[] = pivot_extract_agg_value($cellData, pivot_find_base_agg_type($aggTypes, $aggIdx), $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                } elseif (in_array($aggType, array('pct_row_total', 'pct_col_total', 'pct_grand_total', 'index', 'pct_parent_row', 'pct_parent_col', 'pct_cum'))) {
                    $values[] = null; // Placeholder for pass 2
                } else {
                    $values[] = pivot_extract_agg_value($cellData, $aggType, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                }
            }

            $previousCellData = $cellData;

            // Store values for pass 2
            if (!isset($cellValuesMap[$rowKey])) $cellValuesMap[$rowKey] = array();
            $cellValuesMap[$rowKey][$colKey] = $values;

            // Initialize column totals
            if (!isset($colTotalsFinal[$colKey])) {
                $colTotalsFinal[$colKey] = array();
                foreach ($aggTypes as $aggType) {
                    if ($aggType === 'min') { $colTotalsFinal[$colKey][] = 1e308; }
                    elseif ($aggType === 'max') { $colTotalsFinal[$colKey][] = -1e308; }
                    elseif ($aggType === 'mode') { $colTotalsFinal[$colKey][] = array(); }
                    elseif ($aggType === 'distinct') { $colTotalsFinal[$colKey][] = array(); }
                    elseif ($aggType === 'stddev' || pivot_is_pctile_agg($aggType)) { $colTotalsFinal[$colKey][] = array(); }   // merged numeric values
                    elseif (pivot_is_wavg_agg($aggType)) { $colTotalsFinal[$colKey][] = array('w' => 0, 'wv' => 0); }
                    elseif ($aggType === 'range') { $colTotalsFinal[$colKey][] = array('min' => 1e308, 'max' => -1e308); }
                    elseif ($aggType === 'antimode') { $colTotalsFinal[$colKey][] = array(); } // value => freq, insertion-ordered
                    else { $colTotalsFinal[$colKey][] = 0; }
                }
            }

            // Accumulate totals (skip special types)
            foreach ($aggTypes as $idx => $aggType) {
                if (pivot_is_derived_agg($aggType)) continue;
                $val = $values[$idx];

                if ($aggType === 'min') {
                    if ($val < 1e308) {
                        $rowTotals[$idx] = min($rowTotals[$idx], $val);
                        $colTotalsFinal[$colKey][$idx] = min($colTotalsFinal[$colKey][$idx], $val);
                    }
                } elseif ($aggType === 'max') {
                    if ($val > -1e308) {
                        $rowTotals[$idx] = max($rowTotals[$idx], $val);
                        $colTotalsFinal[$colKey][$idx] = max($colTotalsFinal[$colKey][$idx], $val);
                    }
                } elseif ($aggType === 'mode') {
                    $_bucket = pivot_resolve_agg_bucket($cellData, $aggColOverrides, $idx, $_aggFilterIdx($idx));
                    if ($_bucket && isset($_bucket['values'])) {
                        foreach ($_bucket['values'] as $v) {
                            $vk = (string)$v;
                            if (!isset($rowTotals[$idx][$vk])) $rowTotals[$idx][$vk] = 0;
                            $rowTotals[$idx][$vk]++;
                            if (!isset($colTotalsFinal[$colKey][$idx][$vk])) $colTotalsFinal[$colKey][$idx][$vk] = 0;
                            $colTotalsFinal[$colKey][$idx][$vk]++;
                        }
                    }
                } elseif ($aggType === 'distinct') {
                    $_bucket = pivot_resolve_agg_bucket($cellData, $aggColOverrides, $idx, $_aggFilterIdx($idx));
                    if ($_bucket && isset($_bucket['distinct'])) {
                        foreach (array_keys($_bucket['distinct']) as $v) {
                            $rowTotals[$idx][$v] = true;
                            $colTotalsFinal[$colKey][$idx][$v] = true;
                        }
                    }
                } elseif (pivot_is_wavg_agg($aggType)) {
                    // Merge Sw and S(v*w) so the total is the TRUE weighted average.
                    $_wvB = pivot_resolve_agg_bucket($cellData, $aggColOverrides, $idx, $_aggFilterIdx($idx));
                    $_wvP = pivot_wavg_pair($_wvB, pivot_wavg_weight_col($aggType));
                    if ($_wvP !== null) {
                        pivot_wavg_add($rowTotals[$idx], $_wvP);
                        pivot_wavg_add($colTotalsFinal[$colKey][$idx], $_wvP);
                    }
                } elseif ($aggType === 'stddev' || pivot_is_pctile_agg($aggType)) {
                    // Merge the cell's numeric values so row/col totals are the
                    // TRUE stddev over all contributing rows (never a stddev of stddevs)
                    $_bucket = pivot_resolve_agg_bucket($cellData, $aggColOverrides, $idx, $_aggFilterIdx($idx));
                    if ($_bucket && isset($_bucket['values'])) {
                        foreach (pivot_parse_numeric_values($_bucket['values']) as $_n) {
                            $rowTotals[$idx][] = $_n;
                            $colTotalsFinal[$colKey][$idx][] = $_n;
                        }
                    }
                } elseif ($aggType === 'range') {
                    $_bucket = pivot_resolve_agg_bucket($cellData, $aggColOverrides, $idx, $_aggFilterIdx($idx));
                    if ($_bucket) {
                        if ($_bucket['min'] < $rowTotals[$idx]['min']) $rowTotals[$idx]['min'] = $_bucket['min'];
                        if ($_bucket['max'] > $rowTotals[$idx]['max']) $rowTotals[$idx]['max'] = $_bucket['max'];
                        if ($_bucket['min'] < $colTotalsFinal[$colKey][$idx]['min']) $colTotalsFinal[$colKey][$idx]['min'] = $_bucket['min'];
                        if ($_bucket['max'] > $colTotalsFinal[$colKey][$idx]['max']) $colTotalsFinal[$colKey][$idx]['max'] = $_bucket['max'];
                    }
                } elseif ($aggType === 'antimode') {
                    $_bucket = pivot_resolve_agg_bucket($cellData, $aggColOverrides, $idx, $_aggFilterIdx($idx));
                    if ($_bucket && isset($_bucket['values'])) {
                        foreach ($_bucket['values'] as $v) {
                            $vk = (string)$v;
                            if (!isset($rowTotals[$idx][$vk])) $rowTotals[$idx][$vk] = 0;
                            $rowTotals[$idx][$vk]++;
                            if (!isset($colTotalsFinal[$colKey][$idx][$vk])) $colTotalsFinal[$colKey][$idx][$vk] = 0;
                            $colTotalsFinal[$colKey][$idx][$vk]++;
                        }
                    }
                } else {
                    $rowTotals[$idx] += $val;
                    $colTotalsFinal[$colKey][$idx] += $val;
                }
            }
        }

        $rowTotalsMap[$rowKey] = $rowTotals;
    }

    // Clean up running total trackers
    foreach ($allRowKeys as $rk) {
        if (isset($cellValuesMap[$rk]['__runningTotals'])) {
            unset($cellValuesMap[$rk]['__runningTotals']);
        }
        if (isset($cellValuesMap[$rk]['__runningCounts'])) {
            unset($cellValuesMap[$rk]['__runningCounts']);
        }
    }

    // ---- % of Parent denominators (2026-08-26, mirrors main.js) ----
    $_hasParentRow = in_array('pct_parent_row', $aggTypes);
    $_hasParentCol = in_array('pct_parent_col', $aggTypes);
    $_pfxOf = 'pivot_parent_prefix_of';
    $parentRowSums = array(); $parentRowTotSums = array();
    $parentColSums = array(); $parentColTotSums = array();
    if ($_hasParentRow || $_hasParentCol) {
        $_ps = pivot_build_parent_sums($allRowKeys, $sortedColKeys, $cellValuesMap, $aggTypes);
        $parentRowSums = $_ps['rowSums']; $parentRowTotSums = $_ps['rowTot'];
        $parentColSums = $_ps['colSums']; $parentColTotSums = $_ps['colTot'];
    }

    // VERTICAL PASS: :down types top-to-bottom. Running types ACCUMULATE; the
    // pairwise types (% Change ↓ / Change ↓ / Index ↓, 2026-08-25) TRANSFORM
    // each cell against the previous / first row's raw base value.
    $hasVertical = pivot_has_vertical_down($aggTypes);
    if ($hasVertical) {
        foreach ($sortedColKeys as $ck) {
            $colAccum = array();
            $vRollWin = array();
            $vPrevRaw = array();
            $vFirstRaw = array();
            foreach ($allRowKeys as $rk) {
                if (!isset($cellValuesMap[$rk][$ck])) continue;
                foreach ($aggTypes as $idx => $at) {
                    if (pivot_is_roll_down($at)) {
                        if (!isset($vRollWin[$idx])) $vRollWin[$idx] = array();
                        $_rv = $cellValuesMap[$rk][$ck][$idx];
                        $vRollWin[$idx][] = (is_numeric($_rv) && abs($_rv) < 1e308) ? (float)$_rv : null;
                        $_rm = pivot_roll_mean($vRollWin[$idx], pivot_roll_n($at));
                        $cellValuesMap[$rk][$ck][$idx] = ($_rm === null) ? 'N/A' : $_rm;
                    } elseif (pivot_is_running_down($at)) {
                        if (!isset($colAccum[$idx])) $colAccum[$idx] = 0;
                        // YTD ↓ restarts when the ROW axis steps into a new year.
                        $_tiPr = isset($_tiPrevRow[$rk]) ? $_tiPrevRow[$rk] : null;
                        if (pivot_ytd_reset($at, $_tiPr, $rk, $_tiRowInfo)) $colAccum[$idx] = 0;
                        $rawVal = is_numeric($cellValuesMap[$rk][$ck][$idx]) ? $cellValuesMap[$rk][$ck][$idx] : 0;
                        $colAccum[$idx] += $rawVal;
                        $cellValuesMap[$rk][$ck][$idx] = $colAccum[$idx];
                    } elseif ($at === 'pct_cum:down') {
                        // Running share of the column total, down the rows.
                        $cdBase = pivot_find_base_agg_idx($aggTypes, $idx);
                        if (!isset($colAccum[$idx])) $colAccum[$idx] = 0;
                        $cdRaw = is_numeric($cellValuesMap[$rk][$ck][$idx]) ? (float)$cellValuesMap[$rk][$ck][$idx] : 0;
                        $colAccum[$idx] += $cdRaw;
                        $cdTot = isset($colTotalsFinal[$ck][$cdBase]) ? $colTotalsFinal[$ck][$cdBase] : 0;
                        $cellValuesMap[$rk][$ck][$idx] = (!is_numeric($cdTot) || $cdTot == 0 || $cdTot >= 1e308 || $cdTot <= -1e308)
                            ? 'N/A' : ($colAccum[$idx] / $cdTot) * 100;
                    } elseif ($at === 'pct_change:down' || $at === 'diff:down' || $at === 'index:down') {
                        $raw = is_numeric($cellValuesMap[$rk][$ck][$idx]) ? (float)$cellValuesMap[$rk][$ck][$idx] : 0;
                        if (!isset($vFirstRaw[$idx])) {
                            $vFirstRaw[$idx] = $raw;
                            // First row mirrors the horizontal first-column convention:
                            // Index ↓ starts at 100, the change types have no predecessor.
                            $cellValuesMap[$rk][$ck][$idx] = ($at === 'index:down') ? 100 : 'N/A';
                        } elseif ($at === 'pct_change:down') {
                            $cellValuesMap[$rk][$ck][$idx] = ($vPrevRaw[$idx] == 0) ? 'N/A' : (($raw - $vPrevRaw[$idx]) / $vPrevRaw[$idx]) * 100;
                        } elseif ($at === 'diff:down') {
                            $cellValuesMap[$rk][$ck][$idx] = $raw - $vPrevRaw[$idx];
                        } else { // index:down
                            $cellValuesMap[$rk][$ck][$idx] = ($vFirstRaw[$idx] == 0) ? 'N/A' : ($raw / $vFirstRaw[$idx]) * 100;
                        }
                        $vPrevRaw[$idx] = $raw;
                    }
                }
            }
            // YoY down: pair each row with the SAME period one year earlier, by
            // label. A second walk, because the prior-year row can sort AFTER
            // this one (descending row sort) and would not yet be visited.
            $yoyRaw = array();
            foreach ($allRowKeys as $rk) {
                if (!isset($cellValuesMap[$rk][$ck])) continue;
                foreach ($aggTypes as $idx => $at) {
                    if ($at !== 'yoy:down' && $at !== 'prioryear:down') continue;
                    $v = $cellValuesMap[$rk][$ck][$idx];
                    $yoyRaw[$idx][$rk] = (is_numeric($v) && abs($v) < 1e308) ? (float)$v : null;
                }
            }
            foreach ($allRowKeys as $rk) {
                if (!isset($cellValuesMap[$rk][$ck])) continue;
                foreach ($aggTypes as $idx => $at) {
                    if ($at !== 'yoy:down' && $at !== 'prioryear:down') continue;
                    $pk = pivot_yoy_prev_key($rk, $_tiRowInfo, $_tiRowYoy);
                    $cur = isset($yoyRaw[$idx][$rk]) ? $yoyRaw[$idx][$rk] : null;
                    $prv = ($pk === null || !isset($yoyRaw[$idx][$pk])) ? null : $yoyRaw[$idx][$pk];
                    if ($at === 'prioryear:down') {
                        $cellValuesMap[$rk][$ck][$idx] = ($prv === null) ? 'N/A' : $prv;
                        continue;
                    }
                    $cellValuesMap[$rk][$ck][$idx] = ($cur === null || $prv === null || $prv == 0)
                        ? 'N/A' : (($cur - $prv) / $prv) * 100;
                }
            }
        }
    }

    // Pre-compute grand totals for pct_grand_total (and the Cumulative %
    // totals conventions, which divide by the grand).
    $preGrandTotals = array_fill(0, count($aggTypes), 0);
    if (in_array('pct_grand_total', $aggTypes) || in_array('pct_cum', $aggTypes) || in_array('pct_cum:down', $aggTypes)) {
        foreach ($sortedColKeys as $ck) {
            foreach ($aggTypes as $gi => $gat) {
                if (!pivot_is_derived_agg($gat)) {
                    $preGrandTotals[$gi] += $colTotalsFinal[$ck][$gi];
                }
            }
        }
    }

    // ========================================================================
    // PASS 2: Calculate context-dependent aggregations
    // ========================================================================

    foreach ($allRowKeys as $rowIndex => $rowKey) {
        $rowTotals = $rowTotalsMap[$rowKey];
        $_cumAcc = array();   // per-row Cumulative % accumulators

        foreach ($sortedColKeys as $colIndex => $colKey) {
            $values =& $cellValuesMap[$rowKey][$colKey];

            foreach ($aggTypes as $idx => $aggType) {
                if ($aggType === 'pct_parent_row') {
                    // % of the IMMEDIATE parent row group's total for this column
                    // (single row field -> parent = all rows = % of Column Total).
                    $baseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                    $cellVal = $values[$baseIdx];
                    $prPfx = $_pfxOf($rowKey);
                    $prDen = isset($parentRowSums[$prPfx][$colKey][$baseIdx]) ? $parentRowSums[$prPfx][$colKey][$baseIdx] : 0;
                    $values[$idx] = (!is_numeric($cellVal) || $prDen == 0 || !is_finite($prDen)) ? 'N/A' : ($cellVal / $prDen) * 100;
                } elseif ($aggType === 'pct_parent_col') {
                    // % of the IMMEDIATE parent column group's total within this row
                    // (single column field -> parent = all columns = % of Row Total).
                    $baseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                    $cellVal = $values[$baseIdx];
                    $pcPfx = $_pfxOf($colKey);
                    $pcDen = isset($parentColSums[$rowKey][$pcPfx][$baseIdx]) ? $parentColSums[$rowKey][$pcPfx][$baseIdx] : 0;
                    $values[$idx] = (!is_numeric($cellVal) || $pcDen == 0 || !is_finite($pcDen)) ? 'N/A' : ($cellVal / $pcDen) * 100;
                } elseif ($aggType === 'pct_cum') {
                    // Cumulative % across columns: running share of the row total.
                    $baseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                    $cellVal = $values[$baseIdx];
                    if (!isset($_cumAcc[$idx])) $_cumAcc[$idx] = 0;
                    $_cumAcc[$idx] += (is_numeric($cellVal) && is_finite($cellVal)) ? (float)$cellVal : 0;
                    $cumDen = $rowTotals[$baseIdx];
                    $values[$idx] = (!is_numeric($cumDen) || $cumDen == 0 || $cumDen >= 1e308 || $cumDen <= -1e308) ? 'N/A' : ($_cumAcc[$idx] / $cumDen) * 100;
                } elseif ($aggType === 'pct_row_total') {
                    $baseAggType = pivot_find_base_agg_type($aggTypes, $idx);
                    $baseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                    $cellVal = $values[$baseIdx];
                    $rowTotal = $rowTotals[$baseIdx];
                    if ($rowTotal == 0 || $rowTotal >= 1e308 || $rowTotal <= -1e308) {
                        $values[$idx] = 'N/A';
                    } else {
                        $values[$idx] = ($cellVal / $rowTotal) * 100;
                    }
                } elseif ($aggType === 'pct_col_total') {
                    $baseAggType = pivot_find_base_agg_type($aggTypes, $idx);
                    $baseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                    $cellVal = $values[$baseIdx];
                    $colTotal = $colTotalsFinal[$colKey][$baseIdx];
                    if ($colTotal == 0 || $colTotal >= 1e308 || $colTotal <= -1e308) {
                        $values[$idx] = 'N/A';
                    } else {
                        $values[$idx] = ($cellVal / $colTotal) * 100;
                    }
                } elseif ($aggType === 'index') {
                    if ($colIndex === 0) {
                        $values[$idx] = 100;
                    } else {
                        // Use nearest-preceding base agg index directly - array_search
                        // would return the FIRST match of that type and collapse multiple
                        // filtered Sums/Counts into the same base.
                        $baseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                        $firstColKey = $sortedColKeys[0];
                        $firstColVal = $cellValuesMap[$rowKey][$firstColKey][$baseIdx];
                        $currentVal = $values[$baseIdx];
                        if ($firstColVal == 0 || $firstColVal >= 1e308 || $firstColVal <= -1e308) {
                            $values[$idx] = 'N/A';
                        } else {
                            $values[$idx] = ($currentVal / $firstColVal) * 100;
                        }
                    }
                } elseif ($aggType === 'pct_grand_total') {
                    $baseAggType = pivot_find_base_agg_type($aggTypes, $idx);
                    $baseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                    $cellVal = $values[$baseIdx];
                    $grandTotal = $preGrandTotals[$baseIdx];
                    if ($grandTotal == 0 || $grandTotal >= 1e308 || $grandTotal <= -1e308) {
                        $values[$idx] = 'N/A';
                    } else {
                        $values[$idx] = ($cellVal / $grandTotal) * 100;
                    }
                } elseif ($aggType === 'formula') {
                    // Evaluate formula with per-cell context: map each non-formula
                    // row's display label to its current cell value.
                    $_fAst = isset($formulaASTs[$idx]) ? $formulaASTs[$idx] : null;
                    if (!$_fAst) {
                        $values[$idx] = null;
                    } else {
                        $_fCtx = array();
                        foreach ($aggTypes as $otherIdx => $otherType) {
                            if ($otherType === 'formula') continue;
                            $_lbl = isset($aggDisplayLabels[$otherIdx]) ? $aggDisplayLabels[$otherIdx] : pivot_get_agg_label($otherType);
                            $_v = isset($values[$otherIdx]) ? $values[$otherIdx] : null;
                            $_fCtx[$_lbl] = (is_numeric($_v) && is_finite($_v)) ? (float)$_v : null;
                        }
                        $values[$idx] = pivot_eval_formula($_fAst, $_fCtx);
                    }
                }
            }
            unset($values);
        }
    }

    // ---- heatmap() domains for the pivot grid ------------------------------
    // Twin of the browser's pass (js/main.js, just above its own THIRD PASS).
    // Runs AFTER the derived aggregations are final and BEFORE any cell is
    // emitted, because a scale cannot colour one cell without having seen all
    // of them. Domains are ALWAYS partitioned by aggregation index first -
    // dollars and percents must never share a ramp - and scale= subdivides
    // within that: grid (one domain), row (per pivot row), col (per column).
    $pivotHeatRules = array();
    $pivotHeatColorizers = array();
    foreach ($formatRules as $_hr) {
        if (isset($_hr['type']) && $_hr['type'] === 'heat' && $_hr['target'] === 'pivot') {
            $pivotHeatRules[] = $_hr;
        }
    }
    if (!empty($pivotHeatRules)) {
        foreach ($pivotHeatRules as $_hri => $_hrule) {
            // A bare heatmap(pivot) skips DERIVATIVE aggregations: they already
            // encode a relative measure, and they are the columns most likely to
            // carry a semantic colour rule of their own (a % Change with
            // format(... 'color: green') on a saturated fill measured 1.04:1).
            foreach ($aggTypes as $_aggIdx => $_aggType) {
                if (!empty($_hrule['columns'])) {
                    $_lbl = strtoupper($aggDisplayLabels[$_aggIdx]);
                    if (!in_array($_lbl, $_hrule['columns'], true)) continue;
                } else if (pivot_is_derived_agg($_aggType)) {
                    continue;
                }
                $_buckets = array();
                foreach ($allRowKeys as $_rk) {
                    foreach ($sortedColKeys as $_ck) {
                        if (!isset($cellValuesMap[$_rk][$_ck][$_aggIdx])) continue;
                        $_v = $cellValuesMap[$_rk][$_ck][$_aggIdx];
                        if (!is_numeric($_v) || !is_finite((float)$_v)) continue;
                        if ((float)$_v === 1e308 || (float)$_v === -1e308) continue;
                        $_pk = $_hrule['scale'] === 'row' ? $_rk
                             : ($_hrule['scale'] === 'col' ? $_ck : '*');
                        if (!isset($_buckets[$_pk])) $_buckets[$_pk] = array();
                        $_buckets[$_pk][] = (float)$_v;
                    }
                }
                foreach ($_buckets as $_pk => $_vals) {
                    $_dom = pnb_heat_domain_from($_vals, $_hrule['range'], $_hrule['mid']);
                    if ($_dom !== null) {
                        $pivotHeatColorizers[$_hri . "\x1f" . $_aggIdx . "\x1f" . $_pk] = $_dom;
                    }
                }
            }
        }
    }

    // ========================================================================
    // PASS 3: Render body rows
    // ========================================================================

    $previousLevels = array_fill(0, $numRowFields, null);
    // Cumulative % ↓ row-total accumulators (rows render in display order)
    $_cumDnRT = array();
    $_cumDnOvRT = array();

    foreach ($allRowKeys as $rowIndex => $rowKey) {
        $rowTotals = $rowTotalsMap[$rowKey];
        $bg = ($rowIndex % 2 === 0) ? $s['oddBg'] : $s['evenBg'];
        $html .= "<tr style='background-color: {$bg};'>";
        $rowParts = explode('|||', $rowKey);

        // Rank "(Other)" annotation helper - muted (N rows) suffix. Counts are
        // per (Other) rowKey (2026-08-25): a per-group rank scope has one
        // (Other) per parent group, each with its own rolled-up count.
        $_otherAnnot = '';
        $_ocMap = pivot_other_row_counts();
        $_otherCount = isset($_ocMap[$rowKey]) ? (int)$_ocMap[$rowKey] : 0;
        if ($_otherCount > 0) {
            $_otherAnnot = ' <span style="font-weight:normal; font-style:italic; color:#888; font-size:0.9em; margin-left:4px;">(' . $_otherCount . ' rows)</span>';
        }

        // Row field cells
        if ($rowLayout === 'nested' && $numRowFields > 1) {
            for ($level = 0; $level < $numRowFields - 1; $level++) {
                $groupKey = implode('|||', array_slice($rowParts, 0, $level + 1));
                if ($groupKey !== $previousLevels[$level]) {
                    $isBold = ($level === 0) ? ' font-weight: bold;' : '';
                    $_rawPart = isset($rowParts[$level]) ? $rowParts[$level] : '[Blank]';
                    $cellContent = htmlspecialchars($_rawPart);
                    if ($hasPivotRewrites) {
                        $_rw = $applyPivotRewrite(pivot_field_base($rowFields[$level]), $_rawPart, $rowParts);
                        if ($_rw !== null) $cellContent = $_rw;
                    }
                    // Rank "(Other)" annotation - only at level 0 for nested layouts
                    if ($_rawPart === '(Other)' && $_otherAnnot !== ''
                        && ($level === 0 || (isset($rowParts[$level - 1]) && $rowParts[$level - 1] !== '(Other)'))) {
                        $cellContent .= $_otherAnnot;
                    }
                    $_lvlFmt = $evalRowFieldCellStyle($level, $rowParts, $rowTotals);
                    $html .= "<td style='{$tdRowHeaderCss} vertical-align: middle;{$isBold} background-color: {$bg};{$_lvlFmt}' rowspan='" . $rowGroupCounts[$groupKey] . "'>{$cellContent}</td>";
                    $previousLevels[$level] = $groupKey;
                    for ($d = $level + 1; $d < $numRowFields; $d++) {
                        $previousLevels[$d] = null;
                    }
                }
            }
            // Leaf level
            $_rawLeaf = isset($rowParts[$numRowFields - 1]) ? $rowParts[$numRowFields - 1] : '[Blank]';
            $leafVal = htmlspecialchars($_rawLeaf);
            if ($hasPivotRewrites) {
                $_rwLeaf = $applyPivotRewrite(pivot_field_base($rowFields[$numRowFields - 1]), $_rawLeaf, $rowParts);
                if ($_rwLeaf !== null) $leafVal = $_rwLeaf;
            }
            // Per-group rank scope: the "(Other)" sits at the LEAF level with a
            // real parent label above it - annotate it here (outermost check).
            if ($_rawLeaf === '(Other)' && $_otherAnnot !== ''
                && ($numRowFields === 1 || $rowParts[$numRowFields - 2] !== '(Other)')) {
                $leafVal .= $_otherAnnot;
            }
            $_leafFmt = $evalRowFieldCellStyle($numRowFields - 1, $rowParts, $rowTotals);
            $html .= "<td style='{$tdRowHeaderCss} background-color: {$bg};{$_leafFmt}'>{$leafVal}</td>";
        } else {
            // Flat layout
            foreach ($rowParts as $_fpi => $part) {
                $_flatContent = htmlspecialchars($part);
                if ($hasPivotRewrites && isset($rowFields[$_fpi])) {
                    $_rwFlat = $applyPivotRewrite(pivot_field_base($rowFields[$_fpi]), $part, $rowParts);
                    if ($_rwFlat !== null) $_flatContent = $_rwFlat;
                }
                // Rank "(Other)" annotation - outermost "(Other)" position in flat layout
                if ($part === '(Other)' && $_otherAnnot !== ''
                    && ($_fpi === 0 || (isset($rowParts[$_fpi - 1]) && $rowParts[$_fpi - 1] !== '(Other)'))) {
                    $_flatContent .= $_otherAnnot;
                }
                $_flatFmt = $evalRowFieldCellStyle($_fpi, $rowParts, $rowTotals);
                $html .= "<td style='{$tdRowHeaderCss} background-color: {$bg};{$_flatFmt}'>{$_flatContent}</td>";
            }
        }

        // Data cells
        foreach ($sortedColKeys as $colIndex => $colKey) {
            $values = $cellValuesMap[$rowKey][$colKey];

            // Evaluate format rules for this pivot cell group
            $pivotRowOvr = array();
            $pivotCellOvr = array();
            if ($hasPivotFormat) {
                $pseudoRow = array();
                // Add non-dimension columns from matching flat row first (lowest priority)
                if (!empty($pivotFlatLookup)) {
                    $_lkey = $rowKey . '###' . $colKey;
                    if (isset($pivotFlatLookup[$_lkey])) {
                        foreach ($pivotFlatLookup[$_lkey] as $_fk => $_fv) {
                            $pseudoRow[$_fk] = (string)$_fv;
                        }
                    }
                }
                // Add agg label → value mappings (override flat row values)
                // Use disambiguated display labels to avoid key collisions with duplicate derived types
                foreach ($aggTypes as $_pi => $_pat) {
                    $pseudoRow[$aggDisplayLabels[$_pi]] = $values[$_pi];
                }
                // Add value field name → first agg value (always override flat row raw value)
                $pseudoRow[$valField] = isset($values[0]) ? $values[0] : '';
                // Add row field values so conditions can reference them
                foreach ($rowFields as $_rfi => $_rfName) {
                    $pseudoRow[$_rfName] = isset($rowParts[$_rfi]) ? $rowParts[$_rfi] : '';
                }
                // Add column field values so conditions can reference them
                $_colParts = explode('|||', $colKey);
                foreach ($colFields as $_cfi => $_cfName) {
                    $pseudoRow[$_cfName] = isset($_colParts[$_cfi]) ? $_colParts[$_cfi] : '';
                }
                // No heat rules here: pivot heat is resolved from the value grid
                // above, not from a pseudo-row of dimension strings.
                $_fmtResult = evaluate_row_formatting($pseudoRow, $rowIndex, $pivotCfPrepared['row'], $pivotCfPrepared['cell']);
                $pivotRowOvr = $_fmtResult['row'];
                $pivotCellOvr = $_fmtResult['cells'];
            }

            foreach ($values as $idx => $val) {
                $aggType = $aggTypes[$idx];
                $displayValue = $val;
                // Blank with NULL, never with ''.
                //
                // pivot_format_value() decides "is this blank?" with STRICT
                // comparisons, so an empty STRING matches none of them:
                // '' === 1e308 is false, '' === 0 is false. It then falls
                // through to (float)'' === 0.0 and prints "$0" - re-numifying
                // the very value this block just tried to blank. null exits on
                // the function's first line instead.
                //
                // Effect before this fix: an EMPTY min/max cell showed "$0" in
                // the emailed HTML while the CSV and XLSX attachments of the
                // same run showed it blank (they hand the raw sentinel to the
                // formatter and its 1e308 guard fires). The zero-blank on the
                // next line had the identical bug, so a 0-valued sum also
                // printed "$0" in email where the browser blanks it.
                if ($val === 1e308 || $val === -1e308) $displayValue = null;
                if ($val === 0 && !pivot_zero_is_meaningful($aggType)) {
                    $displayValue = null;
                }
                $formatted = pivot_format_value($displayValue, $aggType, $isCurrency, $sourceMaxDecimals, false, pivot_unit_base($aggTypes, $idx));
                $cellStyle = "{$tdDataCss} background-color: {$bg};";
                // heatmap() fill goes in BEFORE the format() overrides below, so
                // an explicit format(cell, ...) rule still wins: these are all
                // appended to one inline style string and the LAST declaration
                // of a property takes effect.
                if (!empty($pivotHeatColorizers)) {
                    foreach ($pivotHeatRules as $_hri => $_hrule) {
                        $_pk = $_hrule['scale'] === 'row' ? $rowKey
                             : ($_hrule['scale'] === 'col' ? $colKey : '*');
                        $_key = $_hri . "\x1f" . $idx . "\x1f" . $_pk;
                        if (!isset($pivotHeatColorizers[$_key])) continue;
                        if (!is_numeric($val) || !is_finite((float)$val)) continue;
                        if ((float)$val === 1e308 || (float)$val === -1e308) continue;
                        $_hcss = pnb_heat_css_for((float)$val, $pivotHeatColorizers[$_key], $_hrule, $themeName);
                        if ($_hcss !== '') $cellStyle .= ' ' . str_replace(';', '; ', $_hcss) . ';';
                    }
                }
                if ($hasPivotFormat) {
                    $aggLabel = strtoupper($aggDisplayLabels[$idx]);
                    $valFieldUpper = strtoupper($valField);
                    // Row-level overrides
                    foreach ($pivotRowOvr as $_p => $_v) {
                        $cellStyle .= " {$_p}: {$_v};";
                    }
                    // Cell-level overrides: check agg label (e.g., "% CHANGE")
                    if (isset($pivotCellOvr[$aggLabel])) {
                        foreach ($pivotCellOvr[$aggLabel] as $_p => $_v) {
                            $cellStyle .= " {$_p}: {$_v};";
                        }
                    }
                    // Also check value field name as target (e.g., "AMOUNT_TOTAL")
                    if ($valFieldUpper !== $aggLabel && isset($pivotCellOvr[$valFieldUpper])) {
                        foreach ($pivotCellOvr[$valFieldUpper] as $_p => $_v) {
                            $cellStyle .= " {$_p}: {$_v};";
                        }
                    }
                }
                $html .= "<td style='{$cellStyle}'>{$formatted}</td>";
            }
        }

        // Grand Total column
        if (count($sortedColKeys) > 1 && $numColFields > 0) {
            if ($totalRowAggs && count($totalRowAggs) > 0) {
                foreach ($totalRowAggs as $_rtLoopIdx => $rowAggType) {
                    $_rtFormatType = $rowAggType; // may change to base agg type for aggregation-aware overrides
                    if (pivot_is_derived_agg($rowAggType)) {
                        // Derived type: use pre-computed cell values from cellValuesMap.
                        // Prefer $_rtLoopIdx when it's a direct match - when totalRowAggs
                        // has the same shape as aggTypes, the row-total index IS the
                        // main agg index. Falls back to first-match-by-type otherwise.
                        $derivIdx = (isset($aggTypes[$_rtLoopIdx]) && $aggTypes[$_rtLoopIdx] === $rowAggType) ? $_rtLoopIdx : array_search($rowAggType, $aggTypes, true);
                        if ($derivIdx === false) {
                            $overrideRowTotal = 'N/A';
                        } elseif ($rowAggType === 'pct_row_total') {
                            $overrideRowTotal = 100;
                        } elseif ($rowAggType === 'pct_parent_row') {
                            $ovprBase = pivot_find_base_agg_idx($aggTypes, $derivIdx);
                            $ovprNum = isset($rowTotalsMap[$rowKey][$ovprBase]) ? $rowTotalsMap[$rowKey][$ovprBase] : null;
                            $ovprPfx = $_pfxOf($rowKey);
                            $ovprDen = isset($parentRowTotSums[$ovprPfx][$ovprBase]) ? $parentRowTotSums[$ovprPfx][$ovprBase] : 0;
                            $overrideRowTotal = (!is_numeric($ovprNum) || $ovprDen == 0 || !is_finite($ovprDen)) ? 'N/A' : ($ovprNum / $ovprDen) * 100;
                        } elseif ($rowAggType === 'pct_parent_col' || $rowAggType === 'pct_cum') {
                            $overrideRowTotal = 100;
                        } elseif ($rowAggType === 'pct_cum:down') {
                            $ovcdBase = pivot_find_base_agg_idx($aggTypes, $derivIdx);
                            if (!isset($_cumDnOvRT[$derivIdx])) $_cumDnOvRT[$derivIdx] = 0;
                            $ovcdNum = isset($rowTotalsMap[$rowKey][$ovcdBase]) ? $rowTotalsMap[$rowKey][$ovcdBase] : 0;
                            $_cumDnOvRT[$derivIdx] += (is_numeric($ovcdNum) && is_finite($ovcdNum)) ? (float)$ovcdNum : 0;
                            $overrideRowTotal = ($preGrandTotals[$ovcdBase] == 0 || !is_finite($preGrandTotals[$ovcdBase])) ? 'N/A' : ($_cumDnOvRT[$derivIdx] / $preGrandTotals[$ovcdBase]) * 100;
                        } elseif ($rowAggType === 'pct_change') {
                            $baseAggType = pivot_find_base_agg_type($aggTypes, $derivIdx);
                            if (count($sortedColKeys) > 1) {
                                $firstCK = $sortedColKeys[0];
                                $lastCK = $sortedColKeys[count($sortedColKeys) - 1];
                                $firstCD = isset($data[$rowKey][$firstCK]) ? $data[$rowKey][$firstCK] : null;
                                $lastCD = isset($data[$rowKey][$lastCK]) ? $data[$rowKey][$lastCK] : null;
                                $_derivOc = $_aggCol($derivIdx);
                                $_derivFi = $_aggFilterIdx($derivIdx);
                                $firstV = pivot_extract_agg_value($firstCD, $baseAggType, $_derivOc, $_derivFi);
                                $lastV = pivot_extract_agg_value($lastCD, $baseAggType, $_derivOc, $_derivFi);
                                if ($firstV == 0 || $firstV >= 1e308 || $firstV <= -1e308) {
                                    $overrideRowTotal = 'N/A';
                                } else {
                                    $overrideRowTotal = (($lastV - $firstV) / $firstV) * 100;
                                }
                            } else {
                                $overrideRowTotal = 'N/A';
                            }
                        } elseif ($rowAggType === 'diff') {
                            // Overall change: last column minus first column
                            $dOvBase = pivot_find_base_agg_type($aggTypes, $derivIdx);
                            if (count($sortedColKeys) > 1) {
                                $dOvFirstCD = isset($data[$rowKey][$sortedColKeys[0]]) ? $data[$rowKey][$sortedColKeys[0]] : null;
                                $dOvLastCD = isset($data[$rowKey][$sortedColKeys[count($sortedColKeys) - 1]]) ? $data[$rowKey][$sortedColKeys[count($sortedColKeys) - 1]] : null;
                                $dOvFirst = pivot_extract_agg_value($dOvFirstCD, $dOvBase, $_aggCol($derivIdx), $_aggFilterIdx($derivIdx));
                                $dOvLast = pivot_extract_agg_value($dOvLastCD, $dOvBase, $_aggCol($derivIdx), $_aggFilterIdx($derivIdx));
                                $overrideRowTotal = (!is_numeric($dOvFirst) || !is_numeric($dOvLast) || abs($dOvFirst) >= 1e308 || abs($dOvLast) >= 1e308) ? 'N/A' : ($dOvLast - $dOvFirst);
                            } else {
                                $overrideRowTotal = 'N/A';
                            }
                        } elseif ($rowAggType === 'pct_change:down' || $rowAggType === 'diff:down') {
                            // Vertical pairwise: this row's base total vs the previous row's
                            $vOvBaseIdx = pivot_find_base_agg_idx($aggTypes, $derivIdx);
                            $vOvPrevRK = ($rowIndex > 0 && isset($allRowKeys[$rowIndex - 1])) ? $allRowKeys[$rowIndex - 1] : null;
                            $vOvCurT = isset($rowTotalsMap[$rowKey][$vOvBaseIdx]) ? $rowTotalsMap[$rowKey][$vOvBaseIdx] : null;
                            $vOvPrevT = ($vOvPrevRK !== null && isset($rowTotalsMap[$vOvPrevRK][$vOvBaseIdx])) ? $rowTotalsMap[$vOvPrevRK][$vOvBaseIdx] : null;
                            if ($vOvPrevRK === null || !is_numeric($vOvCurT) || !is_numeric($vOvPrevT) || abs($vOvCurT) >= 1e308 || abs($vOvPrevT) >= 1e308) {
                                $overrideRowTotal = 'N/A';
                            } elseif ($rowAggType === 'pct_change:down') {
                                $overrideRowTotal = ($vOvPrevT == 0) ? 'N/A' : (($vOvCurT - $vOvPrevT) / $vOvPrevT) * 100;
                            } else {
                                $overrideRowTotal = $vOvCurT - $vOvPrevT;
                            }
                        } elseif ($rowAggType === 'pct_col_total' || $rowAggType === 'pct_grand_total') {
                            $sum = 0;
                            foreach ($sortedColKeys as $ck) {
                                $v = isset($cellValuesMap[$rowKey][$ck][$derivIdx]) ? $cellValuesMap[$rowKey][$ck][$derivIdx] : 0;
                                if (is_numeric($v)) $sum += $v;
                            }
                            $overrideRowTotal = $sum;
                        } elseif ($rowAggType === 'index' || $rowAggType === 'index:down') {
                            $sum = 0; $count = 0;
                            foreach ($sortedColKeys as $ck) {
                                $v = isset($cellValuesMap[$rowKey][$ck][$derivIdx]) ? $cellValuesMap[$rowKey][$ck][$derivIdx] : 0;
                                if (is_numeric($v)) { $sum += $v; $count++; }
                            }
                            $overrideRowTotal = ($count > 0) ? $sum / $count : 'N/A';
                        } elseif (pivot_is_running_total_like($rowAggType)) {
                            $lastCK2 = $sortedColKeys[count($sortedColKeys) - 1];
                            $overrideRowTotal = isset($cellValuesMap[$rowKey][$lastCK2][$derivIdx]) ? $cellValuesMap[$rowKey][$lastCK2][$derivIdx] : 0;
                        } elseif ($rowAggType === 'running_count' || $rowAggType === 'running_count:down') {
                            $lastCK2 = $sortedColKeys[count($sortedColKeys) - 1];
                            $overrideRowTotal = isset($cellValuesMap[$rowKey][$lastCK2][$derivIdx]) ? $cellValuesMap[$rowKey][$lastCK2][$derivIdx] : 0;
                        } else {
                            $overrideRowTotal = 'N/A';
                        }
                    } else {
                        // Aggregation-aware: use pre-computed base index mapping
                        $_rtBaseIdx = (isset($rowTotalBaseMap[$_rtLoopIdx]) && $rowTotalBaseMap[$_rtLoopIdx] >= 0) ? $rowTotalBaseMap[$_rtLoopIdx] : false;
                        if ($_rtBaseIdx === false) {
                            foreach ($aggTypes as $_bi => $_at) {
                                if (!pivot_is_derived_agg($_at)) { $_rtBaseIdx = $_bi; break; }
                            }
                        }
                        if ($_rtBaseIdx !== false && $rowAggType !== $aggTypes[$_rtBaseIdx] && !pivot_is_derived_agg($aggTypes[$_rtBaseIdx]) && $aggTypes[$_rtBaseIdx] !== 'mode' && $aggTypes[$_rtBaseIdx] !== 'antimode') {
                            $overrideRowTotal = pivot_compute_override_total_from_cell_values('row', $rowKey, $sortedColKeys, $cellValuesMap, $_rtBaseIdx, $rowAggType);
                            $_rtFormatType = $aggTypes[$_rtBaseIdx]; // format using base agg type (e.g. 'count' not 'avg')
                        } else {
                            $overrideRowTotal = pivot_compute_override_total('row', $rowKey, $sortedColKeys, $data, $rowAggType,
                                $_rtBaseIdx !== false ? $_aggCol($_rtBaseIdx) : null,
                                $_rtBaseIdx !== false ? $_aggFilterIdx($_rtBaseIdx) : null);
                            $_rtFormatType = $rowAggType;
                        }
                    }
                    $formatted = pivot_format_value($overrideRowTotal, $_rtFormatType, $isCurrency, $sourceMaxDecimals, true);
                    $html .= "<td style='{$grandTotalCss}'><strong>{$formatted}</strong></td>";
                }
            } else {
                foreach ($aggTypes as $idx => $aggType) {
                    $displayRowTotal = $rowTotals[$idx];

                    if ($aggType === 'pct_change') {
                        $baseAggType = pivot_find_base_agg_type($aggTypes, $idx);
                        if (count($sortedColKeys) > 1) {
                            $firstColKey = $sortedColKeys[0];
                            $lastColKey = $sortedColKeys[count($sortedColKeys) - 1];
                            $firstCellData = isset($data[$rowKey][$firstColKey]) ? $data[$rowKey][$firstColKey] : null;
                            $lastCellData = isset($data[$rowKey][$lastColKey]) ? $data[$rowKey][$lastColKey] : null;
                            $firstVal = pivot_extract_agg_value($firstCellData, $baseAggType, $_aggCol($idx), $_aggFilterIdx($idx));
                            $lastVal = pivot_extract_agg_value($lastCellData, $baseAggType, $_aggCol($idx), $_aggFilterIdx($idx));
                            if ($firstVal == 0 || $firstVal >= 1e308 || $firstVal <= -1e308) {
                                $displayRowTotal = 'N/A';
                            } else {
                                $displayRowTotal = (($lastVal - $firstVal) / $firstVal) * 100;
                            }
                        } else {
                            $displayRowTotal = 'N/A';
                        }
                    } elseif ($aggType === 'diff') {
                        // Overall change: last column minus first column (successive
                        // differences telescope to exactly this)
                        if (count($sortedColKeys) > 1) {
                            $dBase = pivot_find_base_agg_type($aggTypes, $idx);
                            $dFirstCD = isset($data[$rowKey][$sortedColKeys[0]]) ? $data[$rowKey][$sortedColKeys[0]] : null;
                            $dLastCD = isset($data[$rowKey][$sortedColKeys[count($sortedColKeys) - 1]]) ? $data[$rowKey][$sortedColKeys[count($sortedColKeys) - 1]] : null;
                            $dFirstV = pivot_extract_agg_value($dFirstCD, $dBase, $_aggCol($idx), $_aggFilterIdx($idx));
                            $dLastV = pivot_extract_agg_value($dLastCD, $dBase, $_aggCol($idx), $_aggFilterIdx($idx));
                            $displayRowTotal = (!is_numeric($dFirstV) || !is_numeric($dLastV) || abs($dFirstV) >= 1e308 || abs($dLastV) >= 1e308) ? 'N/A' : ($dLastV - $dFirstV);
                        } else {
                            $displayRowTotal = 'N/A';
                        }
                    } elseif ($aggType === 'pct_change:down' || $aggType === 'diff:down') {
                        // Vertical pairwise: this row's base total vs the PREVIOUS row's
                        $vdBaseIdx = pivot_find_base_agg_idx($aggTypes, $idx);
                        $vdPrevRK = ($rowIndex > 0 && isset($allRowKeys[$rowIndex - 1])) ? $allRowKeys[$rowIndex - 1] : null;
                        $vdCurT = isset($rowTotals[$vdBaseIdx]) ? $rowTotals[$vdBaseIdx] : null;
                        $vdPrevT = ($vdPrevRK !== null && isset($rowTotalsMap[$vdPrevRK][$vdBaseIdx])) ? $rowTotalsMap[$vdPrevRK][$vdBaseIdx] : null;
                        if ($vdPrevRK === null || !is_numeric($vdCurT) || !is_numeric($vdPrevT) || abs($vdCurT) >= 1e308 || abs($vdPrevT) >= 1e308) {
                            $displayRowTotal = 'N/A';
                        } elseif ($aggType === 'pct_change:down') {
                            $displayRowTotal = ($vdPrevT == 0) ? 'N/A' : (($vdCurT - $vdPrevT) / $vdPrevT) * 100;
                        } else {
                            $displayRowTotal = $vdCurT - $vdPrevT;
                        }
                    } elseif ($aggType === 'pct_row_total') {
                        $displayRowTotal = 100;
                    } elseif ($aggType === 'pct_parent_row') {
                        $prtBase = pivot_find_base_agg_idx($aggTypes, $idx);
                        $prtNum = isset($rowTotalsMap[$rowKey][$prtBase]) ? $rowTotalsMap[$rowKey][$prtBase] : null;
                        $prtPfx = $_pfxOf($rowKey);
                        $prtDen = isset($parentRowTotSums[$prtPfx][$prtBase]) ? $parentRowTotSums[$prtPfx][$prtBase] : 0;
                        $displayRowTotal = (!is_numeric($prtNum) || $prtDen == 0 || !is_finite($prtDen)) ? 'N/A' : ($prtNum / $prtDen) * 100;
                    } elseif ($aggType === 'pct_parent_col' || $aggType === 'pct_cum') {
                        $displayRowTotal = 100;
                    } elseif ($aggType === 'pct_cum:down') {
                        $cdrBase = pivot_find_base_agg_idx($aggTypes, $idx);
                        if (!isset($_cumDnRT[$idx])) $_cumDnRT[$idx] = 0;
                        $cdrNum = isset($rowTotalsMap[$rowKey][$cdrBase]) ? $rowTotalsMap[$rowKey][$cdrBase] : 0;
                        $_cumDnRT[$idx] += (is_numeric($cdrNum) && is_finite($cdrNum)) ? (float)$cdrNum : 0;
                        $displayRowTotal = ($preGrandTotals[$cdrBase] == 0 || !is_finite($preGrandTotals[$cdrBase])) ? 'N/A' : ($_cumDnRT[$idx] / $preGrandTotals[$cdrBase]) * 100;
                    } elseif ($aggType === 'pct_col_total') {
                        $sum = 0;
                        foreach ($sortedColKeys as $ck) {
                            $v = $cellValuesMap[$rowKey][$ck][$idx];
                            if (is_numeric($v)) $sum += $v;
                        }
                        $displayRowTotal = $sum;
                    } elseif ($aggType === 'index' || $aggType === 'index:down') {
                        $sum = 0; $count = 0;
                        foreach ($sortedColKeys as $ck) {
                            $v = $cellValuesMap[$rowKey][$ck][$idx];
                            if (is_numeric($v)) { $sum += $v; $count++; }
                        }
                        $displayRowTotal = ($count > 0) ? $sum / $count : 'N/A';
                    } elseif ($aggType === 'pct_grand_total') {
                        $sum = 0;
                        foreach ($sortedColKeys as $ck) {
                            $v = $cellValuesMap[$rowKey][$ck][$idx];
                            if (is_numeric($v)) $sum += $v;
                        }
                        $displayRowTotal = $sum;
                    } elseif (pivot_is_running_total_like($aggType)) {
                        $lastColKey = $sortedColKeys[count($sortedColKeys) - 1];
                        $displayRowTotal = $cellValuesMap[$rowKey][$lastColKey][$idx];
                    } elseif ($aggType === 'running_count' || $aggType === 'running_count:down') {
                        $lastColKey = $sortedColKeys[count($sortedColKeys) - 1];
