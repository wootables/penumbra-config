        'prioryear' => 'LY', 'prioryear:down' => "LY\xe2\x86\x93"
    );
    static $baseSuffix = array(
        'sum' => 'sum', 'count' => 'cnt', 'avg' => 'avg', 'median' => 'med',
        'min' => 'min', 'max' => 'max', 'mode' => 'mode', 'distinct' => 'dist',
        'stddev' => 'sd', 'range' => 'rng', 'count_filled' => 'fill',
        'count_blank' => 'blank', 'antimode' => 'anti'
    );
    // Count occurrences of each derived type
    $derivedCounts = array();
    foreach ($aggTypes as $at) {
        if (pivot_is_derived_agg($at)) {
            $derivedCounts[$at] = isset($derivedCounts[$at]) ? $derivedCounts[$at] + 1 : 1;
        }
    }

    $labels = array();
    foreach ($aggTypes as $i => $at) {
        // Custom label takes priority
        if ($customLabels && !empty($customLabels[$i])) {
            $labels[] = $customLabels[$i];
            continue;
        }
        if (pivot_is_derived_agg($at) && isset($derivedCounts[$at]) && $derivedCounts[$at] > 1) {
