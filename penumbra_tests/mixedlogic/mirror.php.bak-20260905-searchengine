                        $pyCell = isset($data[$rowKey][$pyKey]) ? $data[$rowKey][$pyKey] : null;
                        $pyVal = pivot_extract_agg_value($pyCell, $pyBase, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
