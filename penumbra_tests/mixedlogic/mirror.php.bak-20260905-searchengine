                            $csvCellValues[$rk][$ck][$idx] = ($csvVPrevRaw[$idx] == 0) ? 'N/A' : (($raw - $csvVPrevRaw[$idx]) / $csvVPrevRaw[$idx]) * 100;
                        } elseif ($at === 'diff:down') {
