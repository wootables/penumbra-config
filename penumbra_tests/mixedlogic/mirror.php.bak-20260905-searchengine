                    $values[] = pivot_extract_agg_value($cellData, $pyBaseD, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                } elseif (pivot_index_base_label($aggType) !== null && !pivot_is_index_down($aggType)) {
