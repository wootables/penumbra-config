    $needsGTSubHeaders = ($totalRowAggs && count($totalRowAggs) > 1);

    // Pre-compute inline styles - scale padding with font size for PDF compactness
    $thPad = max(2, min(9, $adjustedFontSize));
    $tdPad = max(2, min(7, $adjustedFontSize - 1));
    $subPad = max(1, min(5, $adjustedFontSize - 2));
    $tableCss = "font-family: {$s['fontName']}, sans-serif; font-size: {$adjustedFontSize}px; border-collapse: collapse; width: 100%;";
    $headerGrad = isset($s['headerGradient']) ? " background: {$s['headerGradient']};" : '';
    $thCss = "background-color: {$s['headerBg']};{$headerGrad} color: {$s['headerFont']}; padding: {$thPad}px; text-align: center; border: 1px solid {$s['borderColor']}; font-weight: bold;";
    $tdDataCss = "padding: {$tdPad}px; border: 1px solid {$s['borderColor']}; color: {$s['dataFont']}; font-size: {$adjustedFontSize}px; text-align: right;";
    $tdRowHeaderCss = "padding: {$tdPad}px; border: 1px solid {$s['borderColor']}; color: {$s['dataFont']}; font-size: {$adjustedFontSize}px; text-align: left;";
    $grandTotalCss = "padding: {$tdPad}px; border: 1px solid {$s['borderColor']}; color: {$s['dataFont']}; font-weight: bold; font-size: {$adjustedFontSize}px; text-align: right; background-color: {$s['groupHeaderBg']};";
    $footerCss = "font-weight: bold; padding: {$tdPad}px; border: 1px solid {$s['borderColor']}; border-top: 2px solid {$s['headerBg']}; color: {$s['headerFont']}; background-color: {$s['headerBg']};{$headerGrad} text-align: right; font-size: {$adjustedFontSize}px;";
    $subHeaderCss = "background-color: {$s['headerBg']};{$headerGrad} color: {$s['headerFont']}; padding: {$subPad}px; text-align: center; border: 1px solid {$s['borderColor']}; font-weight: normal; font-size: " . ($adjustedFontSize - 1) . "px;";

    $html = "<table style='{$tableCss}'><thead>";

    // ========================================================================
    // HEADER RENDERING
    // ========================================================================

    if ($numColFields < 2 || $colLayout === 'flat') {
        // --- FLAT / SINGLE COL FIELD HEADERS ---
        $hasSubRow = $isMulti || $needsGTSubHeaders;

        $html .= '<tr>';
        // Row field headers
        foreach ($rowFields as $i => $field) {
