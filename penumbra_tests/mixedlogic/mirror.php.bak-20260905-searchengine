    $_rnLbl = pivot_roll_n($aggType);
    if ($_rnLbl !== null) return $_rnLbl . (pivot_is_roll_sum($aggType) ? '-Period Total ' : '-Period Avg ') . (pivot_is_roll_down($aggType) ? "\xe2\x86\x93" : "\xe2\x86\x92");
    $_ppLbl = pivot_percentile_p($aggType);
