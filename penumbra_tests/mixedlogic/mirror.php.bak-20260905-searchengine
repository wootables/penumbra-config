    $html .=   'You are receiving this because <em>Email on success</em> is enabled for this task (in the scheduler\'s On Completion options). Turn it off there if you no longer want success notifications. This is an automated message from the Penumbra scheduler - replies are not monitored.';
    $html .= '</td></tr>';
    $html .= '</table></td></tr></table></body></html>';

    // --- Subject ---
    $subject_label = preg_replace('/[\r\n]+/', ' ', (string)$label);
    $subject = '[Penumbra] ' . $headline . ': ' . $subject_label;
    if ($task_id !== '') { $subject .= ' (task #' . $task_id . ')'; }

    // --- Headers + MIME body (same quoted-printable multipart the failure path
    // uses; no admin BCC - this is owner-only, see docblock). ---
    $boundary = '----=_Part_' . md5(uniqid(mt_rand(), true));
