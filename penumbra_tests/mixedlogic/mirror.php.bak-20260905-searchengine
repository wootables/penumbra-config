        unset($csvCellValues[$rowKey]['__runningCounts']);
    }

    // VERTICAL PASS for CSV: accumulate :down running types top-to-bottom
    $hasVertical = pivot_has_vertical_down($aggTypes);
    if ($hasVertical) {
