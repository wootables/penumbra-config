                    } else {
                        $baseAggType = pivot_find_base_agg_type($aggTypes, $aggIdx);
                        $dCur = pivot_extract_agg_value($cellData, $baseAggType, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $dPrev = pivot_extract_agg_value($previousCellData, $baseAggType, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $values[] = (!is_numeric($dCur) || !is_numeric($dPrev) || abs($dCur) >= 1e308 || abs($dPrev) >= 1e308) ? 'N/A' : ($dCur - $dPrev);
                    }
                } elseif ($aggType === 'pct_change:down' || $aggType === 'diff:down' || $aggType === 'index:down') {
