        foreach ($colFields as $cf) { $_cfB = pivot_field_base($cf); if (!isset($ctx[$_cfB])) $ctx[$_cfB] = ''; }
        foreach ($aggTypes as $ai => $at) {
            $ctx[$aggDisplayLabels[$ai]] = ($totals !== null && isset($totals[$ai]) && is_numeric($totals[$ai])) ? $totals[$ai] : 0;
        }
        $ctx[$valField] = ($totals !== null && isset($totals[0]) && is_numeric($totals[0])) ? $totals[0] : 0;
        $style = '';
        foreach ($pivotRowFieldCellRules[$tU] as $rfcRule) {
            $apply = false;
