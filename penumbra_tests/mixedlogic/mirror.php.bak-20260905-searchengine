        // Freeze pane at row 1
        $xml .= '<sheetViews><sheetView' . ($isFirst ? ' tabSelected="1"' : '') . ' workbookViewId="0">'
            . '<pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/>'
            . '<selection pane="bottomLeft" activeCell="A2" sqref="A2"/>'
            . '</sheetView></sheetViews>';

        // Column widths
        $xml .= '<cols>';
        for ($c = 0; $c < $colCount; $c++) {
            $colNum = $c + 1;
            $xml .= '<col min="' . $colNum . '" max="' . $colNum . '" width="' . $colWidths[$c] . '" customWidth="1"/>';
        }
        $xml .= '</cols>';

        $xml .= '<sheetData>';

        // Header row (row 1, ht=25)
        $xml .= '<row r="1" ht="25" customHeight="1">';
        for ($c = 0; $c < $colCount; $c++) {
            $cellRef = _xlsx_col_letter($c) . '1';
            $si = $ssIndex[$headers[$c]];
            $xml .= '<c r="' . $cellRef . '" t="s" s="1"><v>' . $si . '</v></c>';
