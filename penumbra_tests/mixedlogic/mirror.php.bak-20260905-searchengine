        $xml .= '</row>';

        // Data rows (row 2+), with any group bands emitted just before the data
        // row they introduce. A band is one bold merged cell carrying the label
        // and its subtree count, at ITS OWN outline level; data sits one level
        // deeper so the band is what collapses it away.
        $rowNum = 2;
        foreach ($cleanRows as $ri => $cleanRow) {
            if (isset($_bands[$ri])) {
                foreach ($_bands[$ri] as $_band) {
                    $_bLabel = $_band['label'];
                    if (!isset($ssIndex[$_bLabel])) {
                        $ssIndex[$_bLabel] = $ssCount;
                        $sharedStrings[] = $_bLabel;
                        $ssCount++;
