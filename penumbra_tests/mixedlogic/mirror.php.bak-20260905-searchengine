function pivot_evaluate_filter($row, $filterStr, $fieldMap = null) {
    if (!$filterStr || !is_string($filterStr) || trim($filterStr) === '') return true;

    // Split on ' OR ' first (lower precedence)
    $orParts = preg_split('/ OR /i', $filterStr);
    foreach ($orParts as $orPart) {
        $orPart = trim($orPart);
        if ($orPart === '') continue;

        // Split on ' AND ' (higher precedence)
        $andParts = preg_split('/ AND /i', $orPart);
        $andPass = true;
        foreach ($andParts as $andPart) {
            $andPart = trim($andPart);
            if ($andPart === '') continue;
            if (!pivot_evaluate_single_condition($row, $andPart, $fieldMap)) {
                $andPass = false;
                break;
            }
        }
        if ($andPass) return true; // Any OR branch passing means the whole filter passes
    }
    return false;
}

function pivot_evaluate_single_condition($row, $condition, $fieldMap = null) {
    // Parse: COLUMN OPERATOR VALUE
    // Column names may contain spaces if quoted, but typically are single words or underscore-separated
    // `contains` is the one word operator, matching the browser's typed syntax
    // (main.js parseAdvancedQuery) and the Visual Search Builder, which writes a
    // prefix test as the anchored regex `COL = /^X/` - never as "starts with".
    if (!preg_match('/^(.+?)\s*(>=|<=|!=|<>|>|<|=|contains)\s*(.+)$/i', $condition, $m)) {
        return true; // Unparseable condition - pass through
    }
    $colName = trim($m[1]);
    $operator = strtolower(trim($m[2]));
    $filterVal = trim($m[3]);

    // Remove surrounding quotes from filter value if present
    if (strlen($filterVal) >= 2 && (
        ($filterVal[0] === '"' && $filterVal[strlen($filterVal) - 1] === '"') ||
        ($filterVal[0] === "'" && $filterVal[strlen($filterVal) - 1] === "'")
    )) {
        $filterVal = substr($filterVal, 1, -1);
    }

    // Resolve field name case-insensitively
    $actualKey = $colName;
    if ($fieldMap) {
        $upper = strtoupper($colName);
        if (isset($fieldMap[$upper])) {
            $actualKey = $fieldMap[$upper];
        }
    } else {
        // Try case-insensitive lookup directly
        $found = false;
        foreach ($row as $k => $v) {
            if (strcasecmp($k, $colName) === 0) {
                $actualKey = $k;
                $found = true;
                break;
            }
        }
    }

    $rowVal = isset($row[$actualKey]) ? (string)$row[$actualKey] : '';
    // Clean @@HTML/@@JSON markers
    if (strpos($rowVal, '@@HTML') === 0) { $rowVal = strip_tags(substr($rowVal, 6)); $rowVal = trim($rowVal); }
    if (strpos($rowVal, '@@JSON') === 0) { $rowVal = trim(substr($rowVal, 6)); }

    // Determine if both values are numeric for numeric comparison
    $numRow = pivot_parse_value($rowVal);
    $numFilter = pivot_parse_value($filterVal);
    $bothNumeric = ($numRow !== false && $numFilter !== false);

    switch ($operator) {
        case '=':
            if ($bothNumeric) return $numRow == $numFilter;
            return strcasecmp($rowVal, $filterVal) === 0;
        case '!=':
        case '<>':
            if ($bothNumeric) return $numRow != $numFilter;
            return strcasecmp($rowVal, $filterVal) !== 0;
        // RELATIONAL operators require BOTH sides to be numbers. A value that is
        // not a number is EXCLUDED, never compared as text.
        //
        // This used to fall back to strcasecmp, which meant a numeric filter
        // silently matched text: "AMT > 5" kept a row whose AMT was 'notanum',
        // because "notanum" > "5" lexicographically ('n' > '5'). The browser
        // returns false for those, so the SAME filtered aggregation counted
        // different rows on screen and in a scheduled email - a filtered bucket
        // came out count=2 in email and count=1 in the browser over identical
        // rows. Measured across 110 value x operator combinations: the two
        // engines disagreed on 23, ALL of them relational, and never on
        // '=' / '!=' / 'contains'.
        //
        // Covers three shapes at once, all confirmed against the browser: a
        // non-numeric ROW value ('notanum' > 5), a non-numeric FILTER value
        // (AMT < ZZZ), and an empty row value ('' < 5). Equality and contains
        // are deliberately untouched - they are string comparisons on both
        // sides and already agreed.
        //
        // Cost, accepted: a lexicographic ">" on a TEXT column no longer
        // matches here. The browser never supported it either, so this removes
        // a behavior that only ever existed in email.
        // Twin: the relational arm of the browser's parsed-query evaluator.
        case '>':
            return $bothNumeric ? ($numRow > $numFilter) : false;
        case '<':
            return $bothNumeric ? ($numRow < $numFilter) : false;
        case '>=':
            return $bothNumeric ? ($numRow >= $numFilter) : false;
        case '<=':
            return $bothNumeric ? ($numRow <= $numFilter) : false;
        case 'contains':
            return stripos($rowVal, $filterVal) !== false;
        default:
            return true;
    }
}

function pivot_empty_agg_value($aggType) {
    if ($aggType === 'min') return 1e308;
    if ($aggType === 'max') return -1e308;
    return 0;
}

function pivot_extract_agg_value($cellData, $aggType, $overrideCol = null, $filterIdx = null) {
    if (!$cellData || !is_array($cellData)) return pivot_empty_agg_value($aggType);

    // If a filter index is specified and filtered buckets exist, use them
    if ($filterIdx !== null && isset($cellData['_filteredBuckets'][$filterIdx])) {
        $fb = $cellData['_filteredBuckets'][$filterIdx];
        if ($aggType === 'count') {
            return $fb['count'];
        }
        // Resolve source: filtered bucket's _colData if override, else filtered bucket's main
        $fsrc = $fb['main'];
        if ($overrideCol && isset($fb['_colData'][$overrideCol])) {
            $fsrc = $fb['_colData'][$overrideCol];
        }
        switch ($aggType) {
            case 'sum':    return $fsrc['sum'];
            case 'avg':
                $nc = isset($fsrc['numericCount']) ? $fsrc['numericCount'] : 0;
                return $nc > 0 ? ($fsrc['sum'] / $nc) : 0;
            case 'median':
                if (empty($fsrc['values'])) return 0;
                $nums = array();
                foreach ($fsrc['values'] as $v) {
                    $pv = pivot_parse_value($v);
                    if ($pv !== false) $nums[] = $pv;
                }
                if (empty($nums)) return 0;
                sort($nums);
                $mid = (int)floor(count($nums) / 2);
                return (count($nums) % 2 === 0)
                    ? ($nums[$mid - 1] + $nums[$mid]) / 2
                    : $nums[$mid];
            // Return the EMPTY sentinel, never 0 - twin of the unfiltered branch
            // below and of extractAggregationValue() in js/main.js.
            case 'min': return $fsrc['min'];
            case 'max': return $fsrc['max'];
            case 'distinct': return count($fsrc['distinct']);
            case 'mode':
                $freq = array();
                $maxFreq = 0;
                $mode = '';
                foreach ($fsrc['values'] as $v) {
                    $key = (string)$v;
                    if (!isset($freq[$key])) $freq[$key] = 0;
                    $freq[$key]++;
                    if ($freq[$key] > $maxFreq) {
                        $maxFreq = $freq[$key];
                        $mode = $key;
                    }
                }
                return $mode;
            case 'stddev':
                return pivot_sample_stddev(pivot_parse_numeric_values(isset($fsrc['values']) ? $fsrc['values'] : array()));
            case 'range':
                return ($fsrc['min'] >= 1e308 || $fsrc['max'] <= -1e308) ? 0 : ($fsrc['max'] - $fsrc['min']);
            case 'count_filled':
                // Buckets only ever hold non-blank values, so the list length IS the filled count
                return isset($fsrc['values']) ? count($fsrc['values']) : 0;
            case 'count_blank':
                // Every row contributes one slot per column: blanks = rows - non-blank values
                return max(0, $fb['count'] - (isset($fsrc['values']) ? count($fsrc['values']) : 0));
            case 'antimode':
                return pivot_antimode_from_values(isset($fsrc['values']) ? $fsrc['values'] : array());
            default:
                $_pp = pivot_percentile_p($aggType);
                if ($_pp !== null) return pivot_percentile_of(pivot_parse_numeric_values(isset($fsrc['values']) ? $fsrc['values'] : array()), $_pp);
                $_wc = pivot_wavg_weight_col($aggType);
                if ($_wc !== null) return pivot_wavg_of(pivot_wavg_pair($fsrc, $_wc));
                return 0;
        }
    }

    // Resolve data bucket: override column or top-level
    $src = $cellData;
    if ($overrideCol && isset($cellData['_colData'][$overrideCol])) {
        $src = $cellData['_colData'][$overrideCol];
    }
    switch ($aggType) {
        case 'count':
            return $cellData['count']; // count is always row count (column-independent)
        case 'sum':
            return $src['sum'];
        case 'avg':
            $nc = isset($src['numericCount']) ? $src['numericCount'] : (isset($src['count']) ? $src['count'] : 0);
            return $nc > 0 ? ($src['sum'] / $nc) : 0;
        case 'median':
            if (empty($src['values'])) return 0;
            $nums = array();
            foreach ($src['values'] as $v) {
                $pv = pivot_parse_value($v);
                if ($pv !== false) $nums[] = $pv;
            }
            if (empty($nums)) return 0;
            sort($nums);
            $mid = (int)floor(count($nums) / 2);
            return (count($nums) % 2 === 0)
                ? ($nums[$mid - 1] + $nums[$mid]) / 2
                : $nums[$mid];
        case 'min':
            // 1e308/-1e308 IS the "nothing to measure" sentinel here, and every
            // consumer downstream already speaks it: pivot_format_value() blanks
            // it for all three builders (HTML/CSV/XLSX), the row/column total
            // accumulators seed with it, and their merge guards are written as
            // `if ($val < 1e308)` precisely to skip it.
            //
            // Coercing to 0 defeated all of that twice over. min/max are
            // deliberately EXCLUDED from the zero-blanking rule in
            // pivot_format_value (0 is a meaningful minimum), so an empty cell
            // printed a literal 0 that read as data - AND, worse, `0 < 1e308`
            // passes the merge guard, so every empty cell in a sparse pivot
            // dragged a spurious 0 into the row/column Min total.
            // Twin: extractAggregationValue() in js/main.js.
            return $src['min'];
        case 'max':
            return $src['max'];
        case 'distinct':
            return count($src['distinct']);
        case 'mode':
            $freq = array();
            $maxFreq = 0;
            $mode = '';
            foreach ($src['values'] as $v) {
                $key = (string)$v;
                if (!isset($freq[$key])) $freq[$key] = 0;
                $freq[$key]++;
                if ($freq[$key] > $maxFreq) {
                    $maxFreq = $freq[$key];
                    $mode = $key;
                }
            }
            return $mode;
        case 'stddev':
            return pivot_sample_stddev(pivot_parse_numeric_values(isset($src['values']) ? $src['values'] : array()));
        case 'range':
            return ($src['min'] >= 1e308 || $src['max'] <= -1e308) ? 0 : ($src['max'] - $src['min']);
        case 'count_filled':
            // Buckets only ever hold non-blank values, so the list length IS the filled count
            return isset($src['values']) ? count($src['values']) : 0;
        case 'count_blank':
            // Every row contributes one slot per column: blanks = rows - non-blank values
            return max(0, $cellData['count'] - (isset($src['values']) ? count($src['values']) : 0));
        case 'antimode':
            return pivot_antimode_from_values(isset($src['values']) ? $src['values'] : array());
        default:
            $_ppM = pivot_percentile_p($aggType);
            if ($_ppM !== null) return pivot_percentile_of(pivot_parse_numeric_values(isset($src['values']) ? $src['values'] : array()), $_ppM);
            $_wcM = pivot_wavg_weight_col($aggType);
            if ($_wcM !== null) return pivot_wavg_of(pivot_wavg_pair($src, $_wcM));
            return 0;
    }
}

function pivot_get_extra_val_fields($aggColOverrides, $mainValField) {
    $extras = array();
    if (!$aggColOverrides || !is_array($aggColOverrides)) return $extras;
    $mainUpper = strtoupper($mainValField);
    foreach ($aggColOverrides as $col) {
        if ($col && strtoupper($col) !== $mainUpper && !in_array(strtoupper($col), $extras)) {
            $extras[] = strtoupper($col);
        }
    }
    return $extras;
}

function pivot_resolve_agg_bucket($cellData, $aggColOverrides, $aggIdx, $filterIdx = null) {
    if (!$cellData) return $cellData;

    // If filtered bucket requested, resolve from there
    if ($filterIdx !== null && isset($cellData['_filteredBuckets'][$filterIdx])) {
        $fb = $cellData['_filteredBuckets'][$filterIdx];
        if ($aggColOverrides) {
            $col = isset($aggColOverrides[$aggIdx]) ? $aggColOverrides[$aggIdx] : null;
            if ($col && isset($fb['_colData'][$col])) return $fb['_colData'][$col];
        }
        return $fb['main'];
    }

    if (!$aggColOverrides) return $cellData;
    $col = isset($aggColOverrides[$aggIdx]) ? $aggColOverrides[$aggIdx] : null;
    if ($col && isset($cellData['_colData'][$col])) return $cellData['_colData'][$col];
    return $cellData;
}

function pivot_other_excluded_count($set = null) {
    static $count = 0;
    if ($set !== null) $count = (int)$set;
    return $count;
}

function pivot_other_row_counts($set = null) {
    static $map = array();
    if ($set !== null) $map = is_array($set) ? $set : array();
    return $map;
}

function pivot_apply_rank(&$allRowKeys, &$data, $pivotSettings, $sortedColKeys, $aggTypes) {
    $rankDir   = isset($pivotSettings['rankDir'])   ? $pivotSettings['rankDir']   : null;
    $rankN     = isset($pivotSettings['rankN'])      ? (int)$pivotSettings['rankN'] : 0;
    $rankAgg   = isset($pivotSettings['rankAgg'])    ? $pivotSettings['rankAgg']   : null;
    $rankOther = isset($pivotSettings['rankOther'])  ? $pivotSettings['rankOther'] : true;

    // Reset the "(Other)" count so stale values from a previous pivot don't leak.
    pivot_other_excluded_count(0);

    pivot_other_row_counts(array());

    // Skip if rank is not configured. (The "not needed because N covers every
    // row" shortcut moved into the GLOBAL branch below - a per-group scope
    // must still run even when N exceeds the total row count.)
    if (!$rankDir || $rankDir === 'none' || $rankN <= 0) return;
    if (!$rankAgg) $rankAgg = isset($aggTypes[0]) ? $aggTypes[0] : 'sum';

    // Resolve the rank scope (2026-08-25): a parent row-field token means
    // "Top/Bottom N within each group of that field". Unresolvable or
    // leaf-level scopes quietly fall back to the global rank. Mirrors main.js.
    $rankScope = isset($pivotSettings['rankScope']) ? $pivotSettings['rankScope'] : null;
    $_scopeRows = isset($pivotSettings['rows']) && is_array($pivotSettings['rows']) ? $pivotSettings['rows'] : array();
    $scopeIdx = -1;
    if ($rankScope) {
        $_scU = strtoupper(trim((string)$rankScope));
        for ($_si = 0; $_si < count($_scopeRows) - 1; $_si++) {
            if (strtoupper(trim((string)$_scopeRows[$_si])) === $_scU) { $scopeIdx = $_si; break; }
        }
    }
    if ($scopeIdx === -1 && $rankN >= count($allRowKeys)) return;

    // Resolve override column for the rank aggregation type
    $aggColOverrides = isset($pivotSettings['aggColOverrides']) ? $pivotSettings['aggColOverrides'] : null;
    $_rankAggIdx = array_search($rankAgg, $aggTypes, true);
    $_rankCol = ($_rankAggIdx !== false && $aggColOverrides && isset($aggColOverrides[$_rankAggIdx])) ? $aggColOverrides[$_rankAggIdx] : null;

    // 1) Compute rank value per row (sum of rankAgg across all columns)
    $rankValues = array();
    foreach ($allRowKeys as $rk) {
        $total = 0;
        if (isset($data[$rk]) && is_array($data[$rk])) {
            foreach ($sortedColKeys as $ck) {
                if (isset($data[$rk][$ck])) {
                    $val = pivot_extract_agg_value($data[$rk][$ck], $rankAgg, $_rankCol);
                    // SKIP the empty sentinel: is_numeric(1e308) is TRUE, so one
                    // empty min/max cell made the whole row's rank value 1e308 and
                    // a row with NO DATA won "top N by min". Twin: js/main.js.
                    if (is_numeric($val) && abs($val) < 1e308) $total += $val;
                }
            }
        }
        $rankValues[$rk] = $total;
    }

    // Merge a set of excluded row keys' cell buckets into one synthetic
    // "(Other)" row's data (shared by the global and per-group paths).
    $_buildOther = function($exclKeys) use (&$data) {
        $otherRow = array();
        foreach ($exclKeys as $exKey) {
            if (!isset($data[$exKey]) || !is_array($data[$exKey])) continue;
            foreach ($data[$exKey] as $ck => $cellData) {
                if (!is_array($cellData)) continue;
                if (!isset($otherRow[$ck])) {
                    $otherRow[$ck] = array(
                        'sum' => 0,
                        'count' => 0,
                        'numericCount' => 0,
                        'min' => 1e308,
                        'max' => -1e308,
                        'distinct' => array(),
                        'values' => array()
                    );
                }
                $otherRow[$ck]['sum'] += isset($cellData['sum']) ? $cellData['sum'] : 0;
                $otherRow[$ck]['count'] += isset($cellData['count']) ? $cellData['count'] : 0;
                $otherRow[$ck]['numericCount'] += isset($cellData['numericCount']) ? $cellData['numericCount'] : 0;
                if (isset($cellData['min']) && $cellData['min'] < $otherRow[$ck]['min']) {
                    $otherRow[$ck]['min'] = $cellData['min'];
                }
                if (isset($cellData['max']) && $cellData['max'] > $otherRow[$ck]['max']) {
                    $otherRow[$ck]['max'] = $cellData['max'];
                }
                if (isset($cellData['values']) && is_array($cellData['values'])) {
                    foreach ($cellData['values'] as $v) {
                        $otherRow[$ck]['values'][] = $v;
                    }
                }
                if (isset($cellData['distinct']) && is_array($cellData['distinct'])) {
                    foreach ($cellData['distinct'] as $dk => $dv) {
                        $otherRow[$ck]['distinct'][$dk] = true;
                    }
                }
                if (isset($cellData['_colData']) && is_array($cellData['_colData'])) {
                    if (!isset($otherRow[$ck]['_colData'])) $otherRow[$ck]['_colData'] = array();
                    foreach ($cellData['_colData'] as $_ek => $_eData) {
                        if (!isset($otherRow[$ck]['_colData'][$_ek])) {
                            $otherRow[$ck]['_colData'][$_ek] = array('sum' => 0, 'numericCount' => 0, 'min' => 1e308, 'max' => -1e308, 'distinct' => array(), 'values' => array());
                        }
                        $_dst =& $otherRow[$ck]['_colData'][$_ek];
                        $_dst['sum'] += isset($_eData['sum']) ? $_eData['sum'] : 0;
                        $_dst['numericCount'] += isset($_eData['numericCount']) ? $_eData['numericCount'] : 0;
                        if (isset($_eData['min']) && $_eData['min'] < $_dst['min']) $_dst['min'] = $_eData['min'];
                        if (isset($_eData['max']) && $_eData['max'] > $_dst['max']) $_dst['max'] = $_eData['max'];
                        if (isset($_eData['values'])) foreach ($_eData['values'] as $v) $_dst['values'][] = $v;
                        if (isset($_eData['distinct'])) foreach ($_eData['distinct'] as $dk => $dv) $_dst['distinct'][$dk] = true;
                        unset($_dst);
                    }
                }
            }
        }
        return $otherRow;
    };

    if ($scopeIdx !== -1) {
        // ---- Top/Bottom N within each scope group (2026-08-25) ----
        // Rank the CHILD GROUPS one level below the scope field, inside every
        // scope group, by the rank value totalled over each child's subtree.
        // Parents keep the pivot's own order; kept children read as a
        // leaderboard; each group gets its own "(Other)". Mirrors main.js.
        $childLevel = $scopeIdx + 1;
        $numParts = count(explode('|||', isset($allRowKeys[0]) ? $allRowKeys[0] : ''));
        $parentOrder = array();
        $parentMap = array();
        foreach ($allRowKeys as $rk) {
            $parts = explode('|||', $rk);
            $pk = implode('|||', array_slice($parts, 0, $childLevel));
            $ckey = implode('|||', array_slice($parts, 0, $childLevel + 1));
            if (!isset($parentMap[$pk])) { $parentMap[$pk] = array('childOrder' => array(), 'children' => array()); $parentOrder[] = $pk; }
            if (!isset($parentMap[$pk]['children'][$ckey])) { $parentMap[$pk]['children'][$ckey] = array('leaves' => array(), 'val' => 0); $parentMap[$pk]['childOrder'][] = $ckey; }
            $parentMap[$pk]['children'][$ckey]['leaves'][] = $rk;
            $parentMap[$pk]['children'][$ckey]['val'] += isset($rankValues[$rk]) ? $rankValues[$rk] : 0;
        }
        $newRowKeys = array();
        $allExcluded = array();
        $countsMap = array();
        foreach ($parentOrder as $pk) {
            $P = $parentMap[$pk];
            $sortedChildren = $P['childOrder'];
            usort($sortedChildren, function($a, $b) use ($P, $rankDir) {
                $va = $P['children'][$a]['val'];
                $vb = $P['children'][$b]['val'];
                if ($rankDir === 'top') return ($vb > $va) ? 1 : (($vb < $va) ? -1 : 0);
                return ($va > $vb) ? 1 : (($va < $vb) ? -1 : 0);
            });
            $keptC = array_slice($sortedChildren, 0, $rankN);
            $exclC = array_slice($sortedChildren, $rankN);
            foreach ($keptC as $c) {
                foreach ($P['children'][$c]['leaves'] as $lv) $newRowKeys[] = $lv;
            }
            if (empty($exclC)) continue;   // <=N children: all shown, no (Other)
            $exclLeaves = array();
            foreach ($exclC as $c) {
                foreach ($P['children'][$c]['leaves'] as $lv) { $exclLeaves[] = $lv; $allExcluded[] = $lv; }
            }
            if ($rankOther) {
                $otherParts = explode('|||', $pk);
                while (count($otherParts) < $numParts) $otherParts[] = '(Other)';
                $gOtherKey = implode('|||', $otherParts);
                $data[$gOtherKey] = $_buildOther($exclLeaves);
                $countsMap[$gOtherKey] = count($exclLeaves);
                $newRowKeys[] = $gOtherKey;
            }
        }
        pivot_other_excluded_count(count($allExcluded));
        pivot_other_row_counts($countsMap);
        $allRowKeys = $newRowKeys;
        return;
    }

    // ---- Global rank (unchanged behavior) ----
    // 2) Sort row keys by rank value
    $rankSorted = $allRowKeys; // copy
    usort($rankSorted, function($a, $b) use ($rankValues, $rankDir) {
        $va = $rankValues[$a];
        $vb = $rankValues[$b];
        if ($rankDir === 'top') {
            return ($vb > $va) ? 1 : (($vb < $va) ? -1 : 0);
        } else {
            return ($va > $vb) ? 1 : (($va < $vb) ? -1 : 0);
        }
    });

    // 3) Slice to first N keys
    $keptKeys = array_slice($rankSorted, 0, $rankN);
    $excludedKeys = array_slice($rankSorted, $rankN);

    // 4) Build "(Other)" synthetic row from excluded keys
    if ($rankOther && !empty($excludedKeys)) {
        // Remember how many source rows got rolled into "(Other)" so the
        // body renderer can annotate the label.
        pivot_other_excluded_count(count($excludedKeys));
        // Build otherKey with the same number of |||-separated parts as real row keys
        // so nested/flat rendering emits the correct number of cells.
        $sampleKey = !empty($allRowKeys) ? $allRowKeys[0] : (!empty($keptKeys) ? $keptKeys[0] : '');
        $numParts = count(explode('|||', $sampleKey));
        $otherKey = implode('|||', array_fill(0, $numParts, '(Other)'));

        $data[$otherKey] = $_buildOther($excludedKeys);
        pivot_other_row_counts(array($otherKey => count($excludedKeys)));
    }

    // 5) Re-order: keep the original sort order for kept keys, "(Other)" at bottom
    $keptSet = array_flip($keptKeys);
    $result = array();
    foreach ($allRowKeys as $rk) {
        if (isset($keptSet[$rk])) {
            $result[] = $rk;
        }
    }
    if ($rankOther && !empty($excludedKeys)) {
        $result[] = $otherKey;
    }
    $allRowKeys = $result;
}

function pivot_count_after_rank($flatRows, $pivotSettings) {
    $rowFields = isset($pivotSettings['rows']) ? $pivotSettings['rows'] : array();
    $colFields = isset($pivotSettings['cols']) ? $pivotSettings['cols'] : array();
    $valField  = isset($pivotSettings['vals']) ? $pivotSettings['vals'] : '';
    $aggTypes  = isset($pivotSettings['agg'])  ? $pivotSettings['agg']  : array('sum');
    if (!is_array($aggTypes)) $aggTypes = array($aggTypes);
    $aggCustomLabels = isset($pivotSettings['aggLabels']) ? $pivotSettings['aggLabels'] : null;
    $aggDisplayLabels = pivot_build_agg_display_labels($aggTypes, $aggCustomLabels);
    $sortOrder    = isset($pivotSettings['sortOrder'])    ? $pivotSettings['sortOrder']    : 'asc';
    $colSortOrder = isset($pivotSettings['colSortOrder']) ? $pivotSettings['colSortOrder'] : $sortOrder;

    if (empty($valField) || (empty($rowFields) && empty($colFields))) {
        return count($flatRows);
    }

    $aggColOverrides = isset($pivotSettings['aggColOverrides']) ? $pivotSettings['aggColOverrides'] : null;
    $_extraVals = pivot_get_extra_val_fields($aggColOverrides, $valField);
    $pivotData = pivot_process_data($flatRows, $rowFields, $colFields, $valField, $_extraVals);
    $data = $pivotData['data'];
    if (empty($data)) return 0;

    $allRowKeys = array_keys($data);
    $customSortOrders = isset($pivotSettings['customSortOrders']) ? $pivotSettings['customSortOrders'] : array();
    // Hoisted out of the two usort callbacks below - custom_sort_pivot_keys() used
    // to resolve a comparator per field PER COMPARISON.
    $rowFieldCmp = pivot_build_field_comparators($rowFields, $customSortOrders);
    $colFieldCmp = pivot_build_field_comparators($colFields, $customSortOrders);
    usort($allRowKeys, function($a, $b) use ($sortOrder, $rowFields, $rowFieldCmp) {
        return custom_sort_pivot_keys($a, $b, $rowFields, $rowFieldCmp, $sortOrder === 'desc' ? 'desc' : 'asc');
    });

    $allColKeysSet = array();
    foreach ($data as $cols) {
        foreach (array_keys($cols) as $ck) $allColKeysSet[$ck] = true;
    }
    $sortedColKeys = array_keys($allColKeysSet);
    usort($sortedColKeys, function($a, $b) use ($colSortOrder, $colFields, $colFieldCmp) {
        return custom_sort_pivot_keys($a, $b, $colFields, $colFieldCmp, $colSortOrder === 'desc' ? 'desc' : 'asc');
    });
    // "Fill empty periods" (:fill on a single period-split column field):
    // insert missing periods as synthetic column keys. The gap walk needs
    // ascending labels - flip a descending sort around it. Mirrors main.js.
    $_fillSf = pivot_cols_fill_spec($colFields);
    if ($_fillSf !== null) {
        if ($colSortOrder === 'desc') $sortedColKeys = array_reverse($sortedColKeys);
        pivot_expand_colkeys_with_gaps($sortedColKeys, $_fillSf['split'], $_fillSf);
        if ($colSortOrder === 'desc') $sortedColKeys = array_reverse($sortedColKeys);
    }

    // Apply rank in place (on copies)
    pivot_apply_rank($allRowKeys, $data, $pivotSettings, $sortedColKeys, $aggTypes);

    return count($allRowKeys);
}

function pivot_wavg_weight_col($aggType) {
    if (preg_match('/^wavg@(.+)$/i', (string)$aggType, $m)) return strtoupper(trim($m[1]));
    return null;
}

function pivot_is_wavg_agg($aggType) { return pivot_wavg_weight_col($aggType) !== null; }

function pivot_wavg_of($pair) {
    return (is_array($pair) && !empty($pair['w'])) ? ($pair['wv'] / $pair['w']) : 0;
}

function pivot_wavg_pair($bucket, $weightCol) {
    if (!is_array($bucket) || !$weightCol || !isset($bucket['wpairs'][$weightCol])) return null;
    return $bucket['wpairs'][$weightCol];
}

function pivot_wavg_add(&$acc, $pair) {
    if (!is_array($pair)) return;
    $acc['w'] += $pair['w'];
    $acc['wv'] += $pair['wv'];
}

function pivot_percentile_p($aggType) {
    if (preg_match('/^p([1-9]\d?)$/', (string)$aggType, $m)) return (int)$m[1];
    return null;
}

function pivot_is_pctile_agg($aggType) { return pivot_percentile_p($aggType) !== null; }

function pivot_percentile_of($nums, $p) {
    if (empty($nums)) return 0;
    $a = $nums;
    sort($a, SORT_NUMERIC);
    return _snippet_percentile_of($a, $p);
}

function pivot_sample_stddev($nums) {
    if (!$nums || count($nums) < 2) return 0;
    $n = 0; $mean = 0.0; $m2 = 0.0;
    foreach ($nums as $x) {
        $n++;
        $d = $x - $mean;
        $mean += $d / $n;
        $m2 += $d * ($x - $mean);
    }
    return sqrt($m2 / ($n - 1));
}

function pivot_antimode_from_values($values) {
    $freq = array();
    foreach ($values as $v) {
        $k = (string)$v;
        if (!isset($freq[$k])) $freq[$k] = 0;
        $freq[$k]++;
    }
    if (empty($freq)) return '';
    $best = null; $bestF = PHP_INT_MAX;
    foreach ($freq as $k => $f) {
        if ($f < $bestF) { $bestF = $f; $best = $k; }
    }
    return (string)$best;
}

function pivot_antimode_from_freq($freq) {
    if (empty($freq)) return '';
    $best = null; $bestF = PHP_INT_MAX;
    foreach ($freq as $k => $f) {
        if ($f < $bestF) { $bestF = $f; $best = $k; }
    }
    return (string)$best;
}

function pivot_parse_numeric_values($values) {
    $nums = array();
    if (!$values) return $nums;
    foreach ($values as $v) {
        if (is_numeric($v)) { $nums[] = (float)$v; continue; }
        $pv = pivot_parse_value($v);
        if ($pv !== false) $nums[] = $pv;
    }
    return $nums;
}

function pivot_compute_agg_from_values($values, $aggType) {
    // No values at all, and (below) values but none numeric: both are "nothing
    // to measure", and min/max must not report that as 0.
    if (!$values || count($values) === 0) return pivot_empty_agg_value($aggType);

    if ($aggType === 'mode') {
        $freq = array();
        $maxF = 0;
        $m = '';
        foreach ($values as $v) {
            $key = (string)$v;
            if (!isset($freq[$key])) $freq[$key] = 0;
            $freq[$key]++;
            if ($freq[$key] > $maxF) { $maxF = $freq[$key]; $m = $key; }
        }
        return $m;
    }
    if ($aggType === 'distinct') {
        return count(array_unique(array_map('strval', $values)));
    }
    if ($aggType === 'antimode') {
        return pivot_antimode_from_values($values);
    }
    if ($aggType === 'count') {
        return count($values);
    }
    // Buckets only hold non-blank values, so length IS the filled count.
    if ($aggType === 'count_filled') {
        return count($values);
    }
    // Blanks never enter the value arrays, so count_blank cannot be answered
    // from a merged values list alone - callers that support it
    // (pivot_compute_override_total) subtract from the walked row counts instead.
    if ($aggType === 'count_blank') {
        return 0;
    }

    // Parse to numbers for other types
    $numericValues = array();
    foreach ($values as $v) {
        if (is_numeric($v)) {
            $numericValues[] = (float)$v;
        } else {
            $parsed = pivot_parse_value($v);
            if ($parsed !== false) $numericValues[] = $parsed;
        }
    }
    if (empty($numericValues)) return pivot_empty_agg_value($aggType);

    switch ($aggType) {
        case 'sum':
            return array_sum($numericValues);
        case 'avg':
            return array_sum($numericValues) / count($numericValues);
        case 'median':
            sort($numericValues);
            $mid = (int)floor(count($numericValues) / 2);
            return (count($numericValues) % 2 === 0)
                ? ($numericValues[$mid - 1] + $numericValues[$mid]) / 2
                : $numericValues[$mid];
        case 'min':
            return min($numericValues);
        case 'max':
            return max($numericValues);
        case 'stddev':
            return pivot_sample_stddev($numericValues);
        case 'range':
            return max($numericValues) - min($numericValues);
        default:
            $_ppV = pivot_percentile_p($aggType);
            if ($_ppV !== null) return pivot_percentile_of($numericValues, $_ppV);
            return array_sum($numericValues);
    }
}

function pivot_is_derived_agg($aggType) {
    // Base names only. The ':down' forms are matched by STRIPPING the suffix and
    // re-testing, exactly as _isDerivedAgg() does in js/main.js - not by listing
    // them again. Enumerating them here was a second hand-maintained copy of the
    // same fact, and it had already drifted: JS accepted pct_row_total:down,
    // pct_col_total:down, pct_grand_total:down, pct_parent_row:down,
    // pct_parent_col:down and formula:down as derived while this list did not.
    // Those six are not reachable today (the trigger parser's
    // _knownColonSuffixes allow-list, js/main.js ~43011, does not emit them), so
    // the divergence was latent - but it would have gone live the moment one of
    // them was offered, and it is the kind of gap that only shows up in email.
    // Strip-and-retest makes the two engines agree BY CONSTRUCTION.
    static $derived = array('pct_change', 'diff', 'pct_row_total', 'pct_col_total',
        'pct_parent_row', 'pct_parent_col', 'pct_cum', 'index', 'pct_grand_total',
        'running_total', 'running_count',
        'ytd', 'yoy', 'prioryear', 'formula');
    // roll<N> and index@LABEL are parameterized, so neither can appear above.
    if (in_array($aggType, $derived, true)) return true;
    $base = str_replace(':down', '', (string)$aggType);
    if ($base !== $aggType && in_array($base, $derived, true)) return true;
    return pivot_is_roll($aggType) || pivot_index_base_label($aggType) !== null;
}

function pivot_parent_prefix_of($k) {
    $p = explode('|||', (string)$k);
    return implode('|||', array_slice($p, 0, max(count($p) - 1, 0)));
}

function pivot_build_parent_sums($allRowKeys, $sortedColKeys, $cellValuesMap, $aggTypes) {
    $rowSums = array(); $rowTot = array(); $colSums = array(); $colTot = array();
    $n = count($aggTypes);
    foreach ($allRowKeys as $rk) {
        $pfx = pivot_parent_prefix_of($rk);
        if (!isset($rowSums[$pfx])) { $rowSums[$pfx] = array(); $rowTot[$pfx] = array_fill(0, $n, 0); }
        if (!isset($colSums[$rk])) $colSums[$rk] = array();
        foreach ($sortedColKeys as $ck) {
            if (!isset($cellValuesMap[$rk][$ck])) continue;
            $cpfx = pivot_parent_prefix_of($ck);
            if (!isset($rowSums[$pfx][$ck])) $rowSums[$pfx][$ck] = array_fill(0, $n, 0);
            if (!isset($colSums[$rk][$cpfx])) $colSums[$rk][$cpfx] = array_fill(0, $n, 0);
            if (!isset($colTot[$cpfx])) $colTot[$cpfx] = array_fill(0, $n, 0);
            foreach ($aggTypes as $i => $t) {
                if (pivot_is_derived_agg($t)) continue;
                $v = isset($cellValuesMap[$rk][$ck][$i]) ? $cellValuesMap[$rk][$ck][$i] : null;
                if (is_numeric($v) && is_finite($v)) {
                    $rowSums[$pfx][$ck][$i] += $v;
                    $rowTot[$pfx][$i] += $v;
                    $colSums[$rk][$cpfx][$i] += $v;
                    $colTot[$cpfx][$i] += $v;
                }
            }
        }
    }
    return array('rowSums' => $rowSums, 'rowTot' => $rowTot, 'colSums' => $colSums, 'colTot' => $colTot);
}

function pivot_has_vertical_down($aggTypes) {
    foreach ((array)$aggTypes as $at) {
        if (pivot_is_running_down($at)
            || $at === 'pct_change:down' || $at === 'diff:down' || $at === 'index:down'
            || $at === 'pct_cum:down' || $at === 'yoy:down' || $at === 'prioryear:down'
            || pivot_is_roll_down($at)) return true;
    }
    return false;
}

function pivot_find_base_agg_type($aggTypes, $currentIdx) {
    // STRING-VALUED bases (mode/antimode) are skipped (2026-08-25, mirrors
    // main.js findBaseAggType): a change/%/index over text is N/A by
    // construction. Falls back to the old any-non-derived rule only when no
    // numeric base exists at all.
    for ($i = $currentIdx - 1; $i >= 0; $i--) {
        if (!pivot_is_derived_agg($aggTypes[$i]) && $aggTypes[$i] !== 'mode' && $aggTypes[$i] !== 'antimode') return $aggTypes[$i];
    }
    for ($i = 0; $i < count($aggTypes); $i++) {
        if (!pivot_is_derived_agg($aggTypes[$i]) && $aggTypes[$i] !== 'mode' && $aggTypes[$i] !== 'antimode') return $aggTypes[$i];
    }
    for ($i = 0; $i < count($aggTypes); $i++) {
        if (!pivot_is_derived_agg($aggTypes[$i])) return $aggTypes[$i];
    }
    return 'sum';
}

function pivot_find_base_agg_idx($aggTypes, $currentIdx) {
    // Same string-base skip as pivot_find_base_agg_type - keep in lockstep.
    for ($i = $currentIdx - 1; $i >= 0; $i--) {
        if (!pivot_is_derived_agg($aggTypes[$i]) && $aggTypes[$i] !== 'mode' && $aggTypes[$i] !== 'antimode') return $i;
    }
    for ($i = 0; $i < count($aggTypes); $i++) {
        if (!pivot_is_derived_agg($aggTypes[$i]) && $aggTypes[$i] !== 'mode' && $aggTypes[$i] !== 'antimode') return $i;
    }
    for ($i = 0; $i < count($aggTypes); $i++) {
        if (!pivot_is_derived_agg($aggTypes[$i])) return $i;
    }
    return 0;
}

function pivot_parse_formula($expr) {
    if (!is_string($expr)) throw new Exception('Formula is empty');
    $s = trim($expr);
    if ($s === '') throw new Exception('Formula is empty');
    $tokens = array();
    $len = strlen($s);
    $i = 0;
    while ($i < $len) {
        $c = $s[$i];
        if ($c === ' ' || $c === "\t" || $c === "\n" || $c === "\r") { $i++; continue; }
        if (($c >= '0' && $c <= '9') || $c === '.') {
            $start = $i;
            while ($i < $len && ((($s[$i] >= '0') && ($s[$i] <= '9')) || $s[$i] === '.')) $i++;
            $numStr = substr($s, $start, $i - $start);
            if (!is_numeric($numStr)) throw new Exception('Invalid number at position ' . $start);
            $tokens[] = array('type' => 'num', 'value' => (float)$numStr);
            continue;
        }
        if ($c === '{') {
            $end = strpos($s, '}', $i);
            if ($end === false) throw new Exception('Unclosed label reference - missing "}"');
            $label = trim(substr($s, $i + 1, $end - $i - 1));
            if ($label === '') throw new Exception('Empty label reference "{}"');
            $tokens[] = array('type' => 'label', 'value' => $label);
            $i = $end + 1;
            continue;
        }
        if ($c === '+' || $c === '-' || $c === '*' || $c === '/' || $c === '(' || $c === ')') {
            $tokens[] = array('type' => 'op', 'value' => $c);
            $i++;
            continue;
        }
        throw new Exception('Unexpected character "' . $c . '" at position ' . $i);
    }
    if (empty($tokens)) throw new Exception('Formula is empty');

    $pos = 0;
    $n = count($tokens);

    $parseExpression = null;
    $parseTerm = null;
    $parseFactor = null;

    $parseFactor = function () use (&$tokens, &$pos, &$n, &$parseExpression, &$parseFactor) {
        if ($pos >= $n) throw new Exception('Unexpected end of formula');
        $tok = $tokens[$pos];
        if ($tok['type'] === 'op' && $tok['value'] === '-') {
            $pos++;
            $inner = $parseFactor();
            return array('type' => 'neg', 'operand' => $inner);
        }
        if ($tok['type'] === 'op' && $tok['value'] === '+') {
            $pos++;
            return $parseFactor();
        }
        if ($tok['type'] === 'num') { $pos++; return array('type' => 'num', 'value' => $tok['value']); }
        if ($tok['type'] === 'label') { $pos++; return array('type' => 'label', 'name' => $tok['value']); }
        if ($tok['type'] === 'op' && $tok['value'] === '(') {
            $pos++;
            $inner = $parseExpression();
            if ($pos >= $n || $tokens[$pos]['type'] !== 'op' || $tokens[$pos]['value'] !== ')') {
                throw new Exception('Missing closing ")"');
            }
            $pos++;
            return $inner;
        }
        throw new Exception('Unexpected token "' . $tok['value'] . '"');
    };

    $parseTerm = function () use (&$tokens, &$pos, &$n, &$parseFactor, &$parseTerm) {
        $left = $parseFactor();
        while ($pos < $n && $tokens[$pos]['type'] === 'op' &&
               ($tokens[$pos]['value'] === '*' || $tokens[$pos]['value'] === '/')) {
            $op = $tokens[$pos]['value'];
            $pos++;
            $right = $parseFactor();
            $left = array('type' => 'binop', 'op' => $op, 'left' => $left, 'right' => $right);
        }
        return $left;
    };

    $parseExpression = function () use (&$tokens, &$pos, &$n, &$parseTerm, &$parseExpression) {
        $left = $parseTerm();
        while ($pos < $n && $tokens[$pos]['type'] === 'op' &&
               ($tokens[$pos]['value'] === '+' || $tokens[$pos]['value'] === '-')) {
            $op = $tokens[$pos]['value'];
            $pos++;
            $right = $parseTerm();
            $left = array('type' => 'binop', 'op' => $op, 'left' => $left, 'right' => $right);
        }
        return $left;
    };

    $ast = $parseExpression();
    if ($pos < $n) {
        throw new Exception('Unexpected token "' . $tokens[$pos]['value'] . '" at end of formula');
    }
    return $ast;
}

function pivot_eval_formula($ast, $ctx) {
    if (!$ast) return null;
    switch ($ast['type']) {
        case 'num':
            return $ast['value'];
        case 'label':
            if (!isset($ctx[$ast['name']])) return null;
            $v = $ctx[$ast['name']];
            if (!is_numeric($v)) return null;
            if (is_infinite($v) || is_nan($v)) return null;
            return (float)$v;
        case 'neg':
            $inner = pivot_eval_formula($ast['operand'], $ctx);
            return $inner === null ? null : -$inner;
        case 'binop':
            $l = pivot_eval_formula($ast['left'], $ctx);
            $r = pivot_eval_formula($ast['right'], $ctx);
            if ($l === null || $r === null) return null;
            switch ($ast['op']) {
                case '+': $out = $l + $r; break;
                case '-': $out = $l - $r; break;
                case '*': $out = $l * $r; break;
                case '/':
                    if ($r == 0) return null;
                    $out = $l / $r;
                    break;
                default: return null;
            }
            if (is_infinite($out) || is_nan($out)) return null;
            return $out;
    }
    return null;
}

function pivot_parse_all_formulas($aggTypes, $aggFormulas) {
    $asts = array();
    if (!is_array($aggTypes)) return $asts;
    foreach ($aggTypes as $idx => $t) {
        if ($t !== 'formula') { $asts[] = null; continue; }
        $expr = isset($aggFormulas[$idx]) ? $aggFormulas[$idx] : '';
        if ($expr === null || $expr === '') { $asts[] = null; continue; }
        try { $asts[] = pivot_parse_formula($expr); }
        catch (Exception $e) { $asts[] = null; }
    }
    return $asts;
}

function pivot_detect_currency($flatRows, $valField) {
    if (empty($flatRows)) return false;
    // Resolve field name case-insensitively
    $resolved = $valField;
    $firstRow = reset($flatRows);
    if (!isset($firstRow[$valField])) {
        $upper = strtoupper($valField);
        foreach (array_keys($firstRow) as $k) {
            if (strtoupper($k) === $upper) { $resolved = $k; break; }
        }
    }
    $sampleSize = min(count($flatRows), 100);
    $currencyCount = 0;
    for ($i = 0; $i < $sampleSize; $i++) {
        $val = isset($flatRows[$i][$resolved]) ? (string)$flatRows[$i][$resolved] : '';
        if (strpos($val, '$') !== false) $currencyCount++;
    }
    return ($sampleSize > 0 && $currencyCount > ($sampleSize * 0.5));
}

function pivot_format_value($value, $aggType, $isCurrency, $sourceMaxDecimals, $showZero = false, $unitBase = null) {
    if ($value === null) return '';

    if ($value === 'N/A') return '<span style="color:#999">-</span>';

    if ($aggType === 'mode' || $aggType === 'distinct' || $aggType === 'antimode') {
        if ($value === '---') return '<span style="color:#999">-</span>';
        return htmlspecialchars((string)$value);
    }

    // Percentage types
    if (in_array($aggType, array('pct_change', 'pct_change:down', 'pct_row_total', 'pct_col_total', 'pct_grand_total',
        'pct_parent_row', 'pct_parent_col', 'pct_cum', 'pct_cum:down', 'yoy', 'yoy:down'))) {
        if (!is_numeric($value)) return htmlspecialchars((string)$value);
        return number_format((float)$value, 1) . '%';
    }

    // Index type
    if (pivot_is_index_agg($aggType)) {
        if (!is_numeric($value)) return htmlspecialchars((string)$value);
        return number_format((float)$value, 1);
    }

    // Running count: always integer
    if ($aggType === 'running_count' || $aggType === 'running_count:down') {
        if (!is_numeric($value)) return htmlspecialchars((string)$value);
        return number_format((float)$value, 0);
    }

    if ($value === 1e308 || $value === -1e308 || $value === INF || $value === -INF) return '';
    // A computed Change of 0 means "no change" - meaningful data, never hidden
    if ($value === 0 && !pivot_zero_is_meaningful($aggType) && !$showZero) return '';

    $numVal = (float)$value;
    // Stddev and the rolling averages floor at 2 decimals (like the flat
    // footer) - the spread, or the smoothed mean, of integer data is usually
    // fractional and would otherwise round away the very signal it exists for.
    $avgDecimals = ($aggType === 'avg' || $aggType === 'median' || pivot_is_pctile_agg($aggType) || pivot_is_wavg_agg($aggType)) ? min(max($sourceMaxDecimals, 0), 4)
        : (($aggType === 'stddev' || (pivot_is_roll($aggType) && !pivot_is_roll_sum($aggType))) ? min(max($sourceMaxDecimals, 2), 4) : 0);
    $decimals = max($avgDecimals, $sourceMaxDecimals);

    $formatted = number_format($numVal, $decimals);

    $_curType = ($unitBase !== null && pivot_inherits_base_units($aggType)) ? $unitBase : $aggType;
    if ($isCurrency && !pivot_is_count_like($_curType)) {
        return '$' . $formatted;
    }
    return $formatted;
}

function _pivot_resolve_override_bucket($cd, $overrideCol, $filterIdx) {
    if (!$cd) return null;
    $baseCell = $cd;
    if ($filterIdx !== null && isset($cd['_filteredBuckets'][$filterIdx])) {
        $fb = $cd['_filteredBuckets'][$filterIdx];
        $baseCell = array(
            'count'        => isset($fb['count']) ? $fb['count'] : 0,
            'sum'          => isset($fb['main']['sum']) ? $fb['main']['sum'] : 0,
            'numericCount' => isset($fb['main']['numericCount']) ? $fb['main']['numericCount'] : 0,
            'min'          => isset($fb['main']['min']) ? $fb['main']['min'] : 1e308,
            'max'          => isset($fb['main']['max']) ? $fb['main']['max'] : -1e308,
            'distinct'     => isset($fb['main']['distinct']) ? $fb['main']['distinct'] : array(),
            'values'       => isset($fb['main']['values']) ? $fb['main']['values'] : array(),
        );
        if (isset($fb['_colData'])) $baseCell['_colData'] = $fb['_colData'];
    }
    if ($overrideCol && isset($baseCell['_colData'][$overrideCol])) {
        return $baseCell['_colData'][$overrideCol];
    }
    return $baseCell;
}

function pivot_compute_override_total($direction, $key, $iterKeys, $pivotDataArr, $overrideAgg, $overrideCol = null, $filterIdx = null) {
    // Weighted average cannot be rebuilt from a merged value list - it needs
    // the per-bucket Sw / S(v*w) pairs. Walk them directly. (This path feeds
    // the CSV and XLSX row/column totals.)
    $_wavgCol = pivot_wavg_weight_col($overrideAgg);
    if ($_wavgCol !== null) {
        $acc = array('w' => 0, 'wv' => 0);
        foreach ($iterKeys as $k2) {
            $cd = ($direction === 'row')
                ? (isset($pivotDataArr[$key][$k2]) ? $pivotDataArr[$key][$k2] : null)
                : (isset($pivotDataArr[$k2][$key]) ? $pivotDataArr[$k2][$key] : null);
            $bucket = _pivot_resolve_override_bucket($cd, $overrideCol, $filterIdx);
            pivot_wavg_add($acc, pivot_wavg_pair($bucket, $_wavgCol));
        }
        return pivot_wavg_of($acc);
    }
    $values = array();
    if ($direction === 'row') {
        foreach ($iterKeys as $colKey) {
            $cd = isset($pivotDataArr[$key][$colKey]) ? $pivotDataArr[$key][$colKey] : null;
            $bucket = _pivot_resolve_override_bucket($cd, $overrideCol, $filterIdx);
            if ($bucket && isset($bucket['values'])) $values = array_merge($values, $bucket['values']);
        }
    } else {
        foreach ($iterKeys as $rowKey) {
            $cd = isset($pivotDataArr[$rowKey][$key]) ? $pivotDataArr[$rowKey][$key] : null;
            $bucket = _pivot_resolve_override_bucket($cd, $overrideCol, $filterIdx);
            if ($bucket && isset($bucket['values'])) $values = array_merge($values, $bucket['values']);
        }
    }

    // For count: sum each cell's 'count' (includes rows with empty values),
    // not count($values) which only counts non-empty entries. When a filter
    // is in play, use the filtered bucket's count so we only count rows the
    // filter matched. count_blank shares the walk: blanks = walked row count
    // minus the merged non-blank values.
    if ($overrideAgg === 'count' || $overrideAgg === 'count_blank') {
        $totalCount = 0;
        if ($direction === 'row') {
            foreach ($iterKeys as $colKey) {
                if (!isset($pivotDataArr[$key][$colKey])) continue;
                $cd = $pivotDataArr[$key][$colKey];
                if ($filterIdx !== null && isset($cd['_filteredBuckets'][$filterIdx]['count'])) {
                    $totalCount += $cd['_filteredBuckets'][$filterIdx]['count'];
                } elseif (isset($cd['count'])) {
                    $totalCount += $cd['count'];
                }
            }
        } else {
            foreach ($iterKeys as $rowKey) {
                if (!isset($pivotDataArr[$rowKey][$key])) continue;
                $cd = $pivotDataArr[$rowKey][$key];
                if ($filterIdx !== null && isset($cd['_filteredBuckets'][$filterIdx]['count'])) {
                    $totalCount += $cd['_filteredBuckets'][$filterIdx]['count'];
                } elseif (isset($cd['count'])) {
                    $totalCount += $cd['count'];
                }
            }
        }
        return ($overrideAgg === 'count_blank') ? max(0, $totalCount - count($values)) : $totalCount;
    }

    // For avg: compute average per cell (total sum / number of iteration keys)
    if ($overrideAgg === 'avg') {
        $totalSum = pivot_compute_agg_from_values($values, 'sum');
        return count($iterKeys) > 0 ? $totalSum / count($iterKeys) : 0;
    }

    return pivot_compute_agg_from_values($values, $overrideAgg);
}

function pivot_compute_override_total_from_cell_values($direction, $key, $iterKeys, $cellValuesMap, $aggIdx, $overrideAgg) {
    $cellVals = array();
    foreach ($iterKeys as $iterKey) {
        $rk = ($direction === 'row') ? $key : $iterKey;
        $ck = ($direction === 'row') ? $iterKey : $key;
        if (isset($cellValuesMap[$rk][$ck][$aggIdx]) && is_numeric($cellValuesMap[$rk][$ck][$aggIdx])) {
            $cellVals[] = (float)$cellValuesMap[$rk][$ck][$aggIdx];
        }
    }
    // An all-empty row: min/max report the sentinel, everything else 0.
    if (empty($cellVals)) return pivot_empty_agg_value($overrideAgg);
    switch ($overrideAgg) {
        case 'sum': return array_sum($cellVals);
        case 'count': return count($cellVals);
        case 'avg': return array_sum($cellVals) / count($cellVals);
        case 'min': return min($cellVals);
        case 'max': return max($cellVals);
        case 'median':
            sort($cellVals);
            $mid = (int)floor(count($cellVals) / 2);
            return (count($cellVals) % 2 === 0) ? ($cellVals[$mid - 1] + $cellVals[$mid]) / 2 : $cellVals[$mid];
        case 'distinct': return count(array_unique($cellVals));
        case 'mode':
            $freq = array(); $maxF = 0; $m = 0;
            foreach ($cellVals as $v) {
                $k = (string)$v;
                if (!isset($freq[$k])) $freq[$k] = 0;
                $freq[$k]++;
                if ($freq[$k] > $maxF) { $maxF = $freq[$k]; $m = $v; }
            }
            return $m;
        case 'stddev': return pivot_sample_stddev($cellVals);
        case 'range': return max($cellVals) - min($cellVals);
        // Over per-cell aggregated values, "filled" and "blank" mean cells
        // with / without a numeric value in this row or column.
        case 'count_filled': return count($cellVals);
        case 'count_blank': return max(0, count($iterKeys) - count($cellVals));
        case 'antimode':
            // Least-common cell value, first-seen tie (parallel first-value map
            // so the returned value keeps its numeric type like mode's does).
            $freqA = array(); $firstA = array();
            foreach ($cellVals as $v) {
                $k = (string)$v;
                if (!isset($freqA[$k])) { $freqA[$k] = 0; $firstA[$k] = $v; }
                $freqA[$k]++;
            }
            if (empty($freqA)) return 0;
            $bestK = null; $bestF = PHP_INT_MAX;
            foreach ($freqA as $k => $f) {
                if ($f < $bestF) { $bestF = $f; $bestK = $k; }
            }
            return $firstA[$bestK];
        default:
            // A percentile OVERRIDE runs over the per-cell values in this row or
            // column, the same convention every other override here uses.
            $_ppO = pivot_percentile_p($overrideAgg);
            if ($_ppO !== null) return pivot_percentile_of($cellVals, $_ppO);
            return array_sum($cellVals);
    }
}

function pivot_resolve_row_total_base_indices($rowAggs, $aggTypes, $explicitBaseIdx = null) {
    if (!$rowAggs || !$aggTypes) return array();
    // If explicit base indices are provided and match the count, use them directly
    if ($explicitBaseIdx && is_array($explicitBaseIdx) && count($explicitBaseIdx) === count($rowAggs)) {
        return $explicitBaseIdx;
    }
    // Build per-type position lists so same-type tokens consume successive
    // base positions instead of all collapsing to the first match.
    // Example: aggTypes=[sum,sum,count], rowAggs=[sum,sum,count] →
    // [0,1,2] (not [0,0,2]). Needed when multiple filtered aggregations of
    // the same base type are present and the user specifies matching tokens.
    $nonDerivedBases = array();
    $typePositions = array(); // type => ordered list of indices in $aggTypes
    foreach ($aggTypes as $i => $at) {
        if (!pivot_is_derived_agg($at)) {
            $nonDerivedBases[] = $i;
            if (!isset($typePositions[$at])) $typePositions[$at] = array();
            $typePositions[$at][] = $i;
        }
    }
    $typeCursor = array(); // type => next position to consume
    $result = array();
    $lastMatchedBaseIdx = -1;
    $fallbackCounter = 0;
    foreach ($rowAggs as $j => $rat) {
        if (isset($typePositions[$rat]) && count($typePositions[$rat]) > 0) {
            // Direct type match - consume next unused position, falling back
            // to the last position when all have been consumed.
            $cursor = isset($typeCursor[$rat]) ? $typeCursor[$rat] : 0;
            $chosen = ($cursor < count($typePositions[$rat]))
                ? $typePositions[$rat][$cursor]
                : $typePositions[$rat][count($typePositions[$rat]) - 1];
            $typeCursor[$rat] = $cursor + 1;
            $lastMatchedBaseIdx = $chosen;
            $result[] = $chosen;
        } elseif ($lastMatchedBaseIdx !== -1) {
            // Override (e.g. 'avg' when main has 'sum') - inherit from last matched base
            $result[] = $lastMatchedBaseIdx;
        } else {
            // No predecessor: consume next non-derived base in order
            if ($fallbackCounter < count($nonDerivedBases)) {
                $result[] = $nonDerivedBases[$fallbackCounter];
                $fallbackCounter++;
            } elseif (!empty($nonDerivedBases)) {
                $result[] = $nonDerivedBases[count($nonDerivedBases) - 1];
            } else {
                $result[] = -1;
            }
        }
    }
    return $result;
}

function pivot_count_leaves($node) {
    if (!is_array($node) || empty($node)) {
        return 1;
    }
    // Indexed arrays (key 0 exists) are leaf-level entries
    if (isset($node[0])) {
        return count($node);
    }
    // Associative arrays are intermediate hierarchy nodes - recurse
    $total = 0;
    foreach ($node as $child) {
        $total += pivot_count_leaves($child);
    }
    return $total;
}

function pivot_apply_value_sort(&$allRowKeys, $data, $sortedColKeys, $aggTypes, $numRowFields, $sortCriteria, $hasGrandTotalCol, $rowTotalAggTypes) {
    if (empty($sortCriteria) || empty($allRowKeys)) return;

    // Use first criterion only (primary sort)
    $criterion = $sortCriteria[0];
    $colIndex = isset($criterion['colIndex']) ? (int)$criterion['colIndex'] : -1;
    $direction = isset($criterion['direction']) ? $criterion['direction'] : 'asc';

    if ($colIndex < $numRowFields) return; // Sorting by a row field column - already handled by sortOrder

    $numAggs = count($aggTypes);
    $numDataCols = count($sortedColKeys) * $numAggs;
    $dataPos = $colIndex - $numRowFields; // 0-based position in data columns

    $isGrandTotal = false;
    $targetColKey = null;
    $targetAggType = null;

    if ($dataPos < $numDataCols) {
        // Regular data column
        $colKeyIdx = (int)floor($dataPos / $numAggs);
        $aggIdx = $dataPos % $numAggs;
        if ($colKeyIdx < count($sortedColKeys)) {
            $targetColKey = $sortedColKeys[$colKeyIdx];
            $targetAggType = isset($aggTypes[$aggIdx]) ? $aggTypes[$aggIdx] : $aggTypes[0];
        }
    } else if ($hasGrandTotalCol) {
        // Grand Total column
        $isGrandTotal = true;
        $gtPos = $dataPos - $numDataCols;
        $targetAggType = isset($rowTotalAggTypes[$gtPos]) ? $rowTotalAggTypes[$gtPos] : $rowTotalAggTypes[0];
    }

    if (!$isGrandTotal && $targetColKey === null) return;

    // For context-dependent agg types, use their base type for sorting
    // (the actual displayed value depends on cross-cell context, but the base value
    // provides a reasonable sort order)
    if (pivot_is_derived_agg($targetAggType)) {
        if ($isGrandTotal) {
            // For GT columns, find base type from rowTotalAggTypes
            $targetAggType = pivot_find_base_agg_type($rowTotalAggTypes, isset($gtPos) ? $gtPos : 0);
        } else {
            $targetAggType = pivot_find_base_agg_type($aggTypes, isset($aggIdx) ? $aggIdx : 0);
        }
    }

    // Pre-compute sort values for each row key
    $sortValues = array();
    foreach ($allRowKeys as $rowKey) {
        if ($isGrandTotal) {
            // Compute Grand Total: aggregate across all columns for this row
            $allValues = array();
            if (isset($data[$rowKey])) {
                foreach ($data[$rowKey] as $ck => $cellData) {
                    if (isset($cellData['values'])) {
                        foreach ($cellData['values'] as $v) {
                            $parsed = pivot_parse_value($v);
                            if ($parsed !== false) $allValues[] = $parsed;
                        }
                    }
                }
            }
            $sortValues[$rowKey] = pivot_compute_agg_from_values($allValues, $targetAggType);
        } else {
            // Regular column: extract cell value
            if (isset($data[$rowKey][$targetColKey])) {
                $cellData = $data[$rowKey][$targetColKey];
                $val = pivot_extract_agg_value($cellData, $targetAggType);
                // Handle special types that need context
                if ($val === null || $val === 'N/A') {
                    $sortValues[$rowKey] = null;
                } else {
                    $sortValues[$rowKey] = $val;
                }
            } else {
                $sortValues[$rowKey] = null;
            }
        }
    }

    // Sort by computed values
    usort($allRowKeys, function($a, $b) use ($sortValues, $direction) {
        $valA = $sortValues[$a];
        $valB = $sortValues[$b];

        // Nulls sort to bottom
        if ($valA === null && $valB === null) return 0;
        if ($valA === null) return 1;
        if ($valB === null) return -1;

        // Numeric comparison
        if ($valA == $valB) return 0;
        $cmp = ($valA < $valB) ? -1 : 1;
        return ($direction === 'desc') ? -$cmp : $cmp;
    });
}

function pivot_process_data($flatRows, $rowFields, $colFields, $valField, $extraValFields = null, $aggFilters = null, $aggTypes = null) {
    // Weight columns needed by any wavg@COL aggregation. Sw and S(v*w) must be
    // accumulated HERE, row by row: a bucket's values[] holds only non-blank
    // entries, so two columns' arrays are not row-aligned and pairing them
    // afterwards would pair a value with another row's weight.
    $_weightCols = array();
    if ($aggTypes !== null) {
        foreach ((array)$aggTypes as $_at) {
            $_wc = pivot_wavg_weight_col($_at);
            if ($_wc !== null && !in_array($_wc, $_weightCols, true)) $_weightCols[] = $_wc;
        }
    }
    $data = array();
    $rowValues = array();
    $colValues = array();
    $hasExtras = $extraValFields && count($extraValFields) > 0;

    // Determine if any agg filters are active
    $hasAggFilters = false;
    $activeFilterIndices = array(); // aggIdx => filterStr (only for non-null filters)
    if ($aggFilters && is_array($aggFilters)) {
        foreach ($aggFilters as $_fi => $_fv) {
            if ($_fv !== null && $_fv !== '' && is_string($_fv)) {
                $hasAggFilters = true;
                $activeFilterIndices[$_fi] = $_fv;
            }
        }
    }

    // Build case-insensitive field name map from first row to handle case mismatches
    // between pivot settings (stored uppercase) and data keys (may vary by DB driver)
    $fieldMap = array(); // maps uppercase field name -> actual data key
    if (!empty($flatRows)) {
        $firstRow = reset($flatRows);
        foreach (array_keys($firstRow) as $k) {
            $fieldMap[strtoupper($k)] = $k;
        }
    }
    // Helper: resolve field name to actual data key (case-insensitive)
    $_resolveField = function($field) use ($fieldMap) {
        if (isset($fieldMap[$field])) return $fieldMap[$field];
        $upper = strtoupper($field);
        if (isset($fieldMap[$upper])) return $fieldMap[$upper];
        return $field; // fallback to original
    };

    // Resolve all field names once. A field token may carry a :split variant
    // (AWARD_DATE:fy) - the BASE resolves to the data key; the split, when
    // present, buckets the value while the keys are built (mirrors main.js).
    $_specify = function($tok) use ($_resolveField) {
        $sf = pivot_parse_field_token($tok);
        return array('key' => $_resolveField($sf['base']), 'split' => $sf['split'], 'binWidth' => $sf['binWidth'], 'binEdges' => $sf['binEdges']);
    };
    $rowFieldSpecs = array_map($_specify, $rowFields);
    $colFieldSpecs = array_map($_specify, $colFields);
    // Auto bin widths resolve against the SAME rows this pivot is built from,
    // so every consumer (keys, totals, fill) agrees on the width.
    foreach ($rowFieldSpecs as &$_bsp) {
        if ($_bsp['split'] === 'bin' && empty($_bsp['binWidth'])) $_bsp['binWidth'] = pivot_resolve_auto_bin_width($_bsp['key'], $flatRows);
    }
    unset($_bsp);
    foreach ($colFieldSpecs as &$_bsp) {
        if ($_bsp['split'] === 'bin' && empty($_bsp['binWidth'])) $_bsp['binWidth'] = pivot_resolve_auto_bin_width($_bsp['key'], $flatRows);
    }
    unset($_bsp);
    $resolvedValField = $_resolveField($valField);
    $_specPart = function($row, $spec) {
        $raw = isset($row[$spec['key']]) ? (string)$row[$spec['key']] : '';
        if ($spec['split'] === 'bins') {
            $val = pivot_bins_bucket_label($raw, isset($spec['binEdges']) ? $spec['binEdges'] : null);
        } else if ($spec['split'] === 'bin' || $spec['split'] === 'binlog') {
            $val = pivot_bin_bucket_label($spec['split'], $raw, isset($spec['binWidth']) ? $spec['binWidth'] : null);
        } else {
            $val = ($spec['split'] !== null)
                ? pivot_split_bucket_label($spec['split'], $raw)
                : pivot_clean_field_value($raw);
        }
        return ($val === '') ? '[Blank]' : $val;
    };

    foreach ($flatRows as $row) {
        // Build row key - clean @@HTML/@@JSON markers from field values
        $rowParts = array();
        foreach ($rowFieldSpecs as $spec) {
            $rowParts[] = $_specPart($row, $spec);
        }
        $rowKey = implode('|||', $rowParts);

        // Build col key - clean @@HTML/@@JSON markers from field values
        $colParts = array();
        foreach ($colFieldSpecs as $spec) {
            $colParts[] = $_specPart($row, $spec);
        }
        $colKey = implode('|||', $colParts);

        // Track unique first-field values
        if (count($rowFieldSpecs) > 0) {
            $rowValues[$_specPart($row, $rowFieldSpecs[0])] = true;
        }
        if (count($colFieldSpecs) > 0) {
            $colValues[$_specPart($row, $colFieldSpecs[0])] = true;
        }

        // Initialize cell if needed
        if (!isset($data[$rowKey])) $data[$rowKey] = array();
        if (!isset($data[$rowKey][$colKey])) {
            $cellInit = array(
                'sum' => 0,
                'count' => 0,
                'numericCount' => 0,
                'min' => 1e308,
                'max' => -1e308,
                'distinct' => array(),
                'values' => array()
            );
            if ($hasExtras) {
                $cellInit['_colData'] = array();
                foreach ($extraValFields as $_ef) {
                    $cellInit['_colData'][$_ef] = array(
                        'sum' => 0, 'numericCount' => 0, 'min' => 1e308, 'max' => -1e308, 'wpairs' => array(),
                        'distinct' => array(), 'values' => array()
                    );
                }
            }
            // Initialize filtered buckets if agg filters are active
            if ($hasAggFilters) {
                $cellInit['_filteredBuckets'] = array();
                foreach ($activeFilterIndices as $_fi => $_fv) {
                    $fbInit = array(
                        'count' => 0,
                        'main' => array('sum' => 0, 'numericCount' => 0, 'min' => 1e308, 'max' => -1e308, 'wpairs' => array(), 'distinct' => array(), 'values' => array())
                    );
                    // If extraValFields exist, also add _colData to the filter bucket
                    if ($hasExtras) {
                        $fbInit['_colData'] = array();
                        foreach ($extraValFields as $_ef) {
                            $fbInit['_colData'][$_ef] = array(
                                'sum' => 0, 'numericCount' => 0, 'min' => 1e308, 'max' => -1e308, 'wpairs' => array(),
                                'distinct' => array(), 'values' => array()
                            );
                        }
                    }
                    $cellInit['_filteredBuckets'][$_fi] = $fbInit;
                }
            }
            $data[$rowKey][$colKey] = $cellInit;
        }

        // Helper: aggregate a raw value into a bucket
        $_aggBucket = function(&$bucket, $rawVal, $row = null) use ($_weightCols, $fieldMap) {
            if ($rawVal === null) $rawVal = '';
            $valStr = (string)$rawVal;
            $cleanStr = $valStr;
            if (strpos($cleanStr, '@@HTML') === 0) { $cleanStr = strip_tags(substr($cleanStr, 6)); $cleanStr = trim($cleanStr); }
            if (strpos($cleanStr, '@@JSON') === 0) { $cleanStr = trim(substr($cleanStr, 6)); }
            $numValue = pivot_parse_value($cleanStr);
            if ($numValue !== false) {
                $bucket['sum'] += $numValue;
                $bucket['numericCount']++;
                if ($numValue < $bucket['min']) $bucket['min'] = $numValue;
                if ($numValue > $bucket['max']) $bucket['max'] = $numValue;
                // Weighted pairs: a row counts only when BOTH its value and its
                // weight parse as numbers (a blank weight is not a zero weight).
                if (!empty($_weightCols) && $row !== null) {
                    foreach ($_weightCols as $_wcol) {
                        $_wkey = isset($fieldMap[$_wcol]) ? $fieldMap[$_wcol] : $_wcol;
                        if (!isset($row[$_wkey])) continue;
                        $_wraw = (string)$row[$_wkey];
                        if (strpos($_wraw, '@@HTML') === 0) $_wraw = trim(strip_tags(substr($_wraw, 6)));
                        elseif (strpos($_wraw, '@@JSON') === 0) $_wraw = trim(substr($_wraw, 6));
                        $_wnum = pivot_parse_value($_wraw);
                        if ($_wnum === false) continue;
                        if (!isset($bucket['wpairs'][$_wcol])) $bucket['wpairs'][$_wcol] = array('w' => 0, 'wv' => 0);
                        $bucket['wpairs'][$_wcol]['w'] += $_wnum;
                        $bucket['wpairs'][$_wcol]['wv'] += $numValue * $_wnum;
                    }
                }
            }
            $trimmed = trim($cleanStr);
            if ($trimmed !== '') {
                $bucket['distinct'][$trimmed] = true;
                $bucket['values'][] = $trimmed;
            }
        };

        $cell =& $data[$rowKey][$colKey];
        $cell['count']++;

        // Aggregate main value column
        $_aggBucket($cell, isset($row[$resolvedValField]) ? $row[$resolvedValField] : '', $row);

        // Aggregate extra override columns
        if ($hasExtras) {
            foreach ($extraValFields as $_ef) {
                $resolvedExtra = $_resolveField($_ef);
                $_aggBucket($cell['_colData'][$_ef], isset($row[$resolvedExtra]) ? $row[$resolvedExtra] : '', $row);
            }
        }

        // Aggregate into filtered buckets for each active filter
        if ($hasAggFilters) {
            foreach ($activeFilterIndices as $_fi => $_fv) {
                if (pivot_evaluate_filter($row, $_fv, $fieldMap)) {
                    $cell['_filteredBuckets'][$_fi]['count']++;
                    $_aggBucket($cell['_filteredBuckets'][$_fi]['main'], isset($row[$resolvedValField]) ? $row[$resolvedValField] : '', $row);
                    // Also aggregate extra columns into filter bucket
                    if ($hasExtras) {
                        foreach ($extraValFields as $_ef) {
                            $resolvedExtra = $_resolveField($_ef);
                            $_aggBucket($cell['_filteredBuckets'][$_fi]['_colData'][$_ef], isset($row[$resolvedExtra]) ? $row[$resolvedExtra] : '', $row);
                        }
                    }
                }
            }
        }

        unset($cell);
    }

    return array(
        'data' => $data,
        'rowValues' => array_keys($rowValues),
        'colValues' => array_keys($colValues)
    );
}

function generate_pivot_html($flatRows, $pivotSettings, $themeName, $isEmail = false, $formatRules = array(), $rewriteRules = array()) {
    global $theme_styles;
    $s = isset($theme_styles[$themeName]) ? $theme_styles[$themeName] : $theme_styles['theme-default'];
    $adjustedFontSize = $s['fontSize'] + 2;

    // Extract settings with defaults
    $rowFields = isset($pivotSettings['rows']) ? $pivotSettings['rows'] : array();
    $colFields = isset($pivotSettings['cols']) ? $pivotSettings['cols'] : array();
    $valField = isset($pivotSettings['vals']) ? $pivotSettings['vals'] : '';
    $aggTypes = isset($pivotSettings['agg']) ? $pivotSettings['agg'] : array('sum');
    if (!is_array($aggTypes)) $aggTypes = array($aggTypes);
    $aggCustomLabels = isset($pivotSettings['aggLabels']) ? $pivotSettings['aggLabels'] : null;
    $aggDisplayLabels = pivot_build_agg_display_labels($aggTypes, $aggCustomLabels);
    $aggFormulas = isset($pivotSettings['aggFormulas']) ? $pivotSettings['aggFormulas'] : null;
    $formulaASTs = pivot_parse_all_formulas($aggTypes, $aggFormulas ? $aggFormulas : array());
    $rowLayout = isset($pivotSettings['rowLayout']) ? $pivotSettings['rowLayout'] : 'nested';
    $colLayout = isset($pivotSettings['colLayout']) ? $pivotSettings['colLayout'] : 'nested';
    // Migrate removed 'drilldown' layout to 'nested'
    if ($rowLayout === 'drilldown') $rowLayout = 'nested';
    if ($colLayout === 'drilldown') $colLayout = 'nested';
    // Email clients (Gmail, Outlook) cannot reliably render rowspan - force flat layouts
    if ($isEmail) {
        $rowLayout = 'flat';
        $colLayout = 'flat';
    }
    $sortOrder = isset($pivotSettings['sortOrder']) ? $pivotSettings['sortOrder'] : 'asc';
    $colSortOrder = isset($pivotSettings['colSortOrder']) ? $pivotSettings['colSortOrder'] : $sortOrder;
    $totalColAggs = isset($pivotSettings['totalColAggs']) ? $pivotSettings['totalColAggs'] : null;
    $totalRowAggs = isset($pivotSettings['totalRowAggs']) ? $pivotSettings['totalRowAggs'] : null;
    $totalRowAggLabels = isset($pivotSettings['totalRowAggLabels']) ? $pivotSettings['totalRowAggLabels'] : null;
    $totalRowAggBaseIdx = isset($pivotSettings['totalRowAggBaseIdx']) ? $pivotSettings['totalRowAggBaseIdx'] : null;
    $rowTotalBaseMap = pivot_resolve_row_total_base_indices($totalRowAggs, $aggTypes, $totalRowAggBaseIdx);
    $aggColOverrides = isset($pivotSettings['aggColOverrides']) ? $pivotSettings['aggColOverrides'] : null;
    $extraValFields = pivot_get_extra_val_fields($aggColOverrides, $valField);
    $aggFilters = isset($pivotSettings['aggFilters']) ? $pivotSettings['aggFilters'] : null;

    // Validate required fields
    if (empty($valField) || (empty($rowFields) && empty($colFields))) {
        return '<p style="color:var(--accent-danger, #cc0000); padding:10px;">Pivot settings are incomplete (missing value field or row/column fields).</p>';
    }

    // Process data
    $pivotData = pivot_process_data($flatRows, $rowFields, $colFields, $valField, $extraValFields, $aggFilters, $aggTypes);
    $data = $pivotData['data'];

    if (empty($data)) {
        return '<p>No pivot data to display.</p>';
    }

    // Helper: resolve override column for a given agg index (returns null if no override)
    $_aggCol = function($aggIdx) use ($aggColOverrides, $aggTypes) {
        if (!$aggColOverrides) return null;
        // For derived aggs, inherit from base agg
        if (pivot_is_derived_agg($aggTypes[$aggIdx])) {
            $baseIdx = null;
            for ($i = $aggIdx - 1; $i >= 0; $i--) {
                if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
            }
            if ($baseIdx === null) {
                for ($i = 0; $i < count($aggTypes); $i++) {
                    if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
                }
            }
            return $baseIdx !== null ? (isset($aggColOverrides[$baseIdx]) ? $aggColOverrides[$baseIdx] : null) : null;
        }
        return isset($aggColOverrides[$aggIdx]) ? $aggColOverrides[$aggIdx] : null;
    };

    // Helper: resolve filter index for a given agg index (returns the agg index if it has
    // a filter, or the base agg's index for derived types, or null if no filter)
    $_aggFilterIdx = function($aggIdx) use ($aggFilters, $aggTypes) {
        if (!$aggFilters || !is_array($aggFilters)) return null;
        // Check if this agg index has a filter directly
        if (isset($aggFilters[$aggIdx]) && $aggFilters[$aggIdx] !== null && $aggFilters[$aggIdx] !== '') {
            return $aggIdx;
        }
        // For derived aggs, inherit from base agg
        if (pivot_is_derived_agg($aggTypes[$aggIdx])) {
            $baseIdx = null;
            for ($i = $aggIdx - 1; $i >= 0; $i--) {
                if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
            }
            if ($baseIdx === null) {
                for ($i = 0; $i < count($aggTypes); $i++) {
                    if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
                }
            }
            if ($baseIdx !== null && isset($aggFilters[$baseIdx]) && $aggFilters[$baseIdx] !== null && $aggFilters[$baseIdx] !== '') {
                return $baseIdx;
            }
        }
        return null;
    };

    // Detect currency and max decimals
    $isCurrency = pivot_detect_currency($flatRows, $valField);

    $sourceMaxDecimals = 0;
    $checkedValues = 0;
    foreach ($data as $rk => $cols) {
        foreach ($cols as $ck => $cellData) {
            if (isset($cellData['values'])) {
                foreach ($cellData['values'] as $sv) {
                    $svClean = str_replace(array('$', ',', '(', ')'), '', trim((string)$sv));
                    $dotPos = strpos($svClean, '.');
                    if ($dotPos !== false) {
                        $decs = strlen($svClean) - $dotPos - 1;
                        if ($decs > $sourceMaxDecimals) $sourceMaxDecimals = $decs;
                    }
                    $checkedValues++;
                }
            }
            if ($checkedValues > 500) break;
        }
        if ($checkedValues > 500) break;
    }

    // Sort row keys and col keys
    $allRowKeys = array_keys($data);
    $customSortOrders = isset($pivotSettings['customSortOrders']) ? $pivotSettings['customSortOrders'] : array();
    // Hoisted out of the two usort callbacks below - custom_sort_pivot_keys() used
    // to resolve a comparator per field PER COMPARISON.
    $rowFieldCmp = pivot_build_field_comparators($rowFields, $customSortOrders);
    $colFieldCmp = pivot_build_field_comparators($colFields, $customSortOrders);
    usort($allRowKeys, function($a, $b) use ($sortOrder, $rowFields, $rowFieldCmp) {
        return custom_sort_pivot_keys($a, $b, $rowFields, $rowFieldCmp, $sortOrder === 'desc' ? 'desc' : 'asc');
    });

    $allColKeysSet = array();
    foreach ($data as $cols) {
        foreach (array_keys($cols) as $ck) {
            $allColKeysSet[$ck] = true;
        }
    }
    $sortedColKeys = array_keys($allColKeysSet);
    usort($sortedColKeys, function($a, $b) use ($colSortOrder, $colFields, $colFieldCmp) {
        return custom_sort_pivot_keys($a, $b, $colFields, $colFieldCmp, $colSortOrder === 'desc' ? 'desc' : 'asc');
    });
    // "Fill empty periods" (:fill on a single period-split column field):
    // insert missing periods as synthetic column keys. The gap walk needs
    // ascending labels - flip a descending sort around it. Mirrors main.js.
    $_fillSf = pivot_cols_fill_spec($colFields);
    if ($_fillSf !== null) {
        if ($colSortOrder === 'desc') $sortedColKeys = array_reverse($sortedColKeys);
        pivot_expand_colkeys_with_gaps($sortedColKeys, $_fillSf['split'], $_fillSf);
        if ($colSortOrder === 'desc') $sortedColKeys = array_reverse($sortedColKeys);
    }

    $numRowFields = count($rowFields);
    $numColFields = count($colFields);
    $firstAggType = $aggTypes[0];
    $isMulti = count($aggTypes) > 1;
    $subLabels = $aggDisplayLabels;

    // Prepare conditional formatting rules for pivot cells.
    // Column list includes: agg labels, value field, row fields, col fields, AND all
    // source data columns - so conditions can reference any column (e.g., CONTRIB_COLLEGE = '{LEAD_COLLEGE}')
    $pivotCfPrepared = array('header' => array(), 'row' => array(), 'cell' => array());
    $hasPivotFormat = false;
    $hasPivotHeaderFormat = false;
    $pivotFlatLookup = array();
    // $pivotColumns is read OUTSIDE the format branch too - by the rewrite()
    // prep below (prepare_rewrite_rules' column list) - so it must
    // be built unconditionally. It used to live inside if(!empty($formatRules)),
    // making every no-format pivot task warn "Undefined variable
    // $pivotColumns/$hasPivotHeaderFormat" each run (php82_errors.log 2026-07-25).
    $pivotColumns = $aggDisplayLabels;
    if (!in_array($valField, $pivotColumns)) {
        $pivotColumns[] = $valField;
    }
    foreach ($rowFields as $_rf) {
        if (!in_array($_rf, $pivotColumns)) $pivotColumns[] = $_rf;
    }
    foreach ($colFields as $_cf) {
        if (!in_array($_cf, $pivotColumns)) $pivotColumns[] = $_cf;
    }
    // Include ALL source data columns so conditions can reference non-dimension columns
    if (!empty($flatRows)) {
        $_firstFlatRow = reset($flatRows);
        foreach (array_keys($_firstFlatRow) as $_fk) {
            if (!in_array($_fk, $pivotColumns)) $pivotColumns[] = $_fk;
        }
    }
    if (!empty($formatRules)) {
        $pivotCfPrepared = prepare_format_rules($formatRules, $pivotColumns, $flatRows, $themeName);
        $hasPivotFormat = (!empty($pivotCfPrepared['row']) || !empty($pivotCfPrepared['cell']));
        $hasPivotHeaderFormat = !empty($pivotCfPrepared['header']);

        // Build flat row lookup: rowKey###colKey → first matching flat row
        // so non-dimension column values are available in the pseudo-row for condition evaluation
        if ($hasPivotFormat && !empty($flatRows)) {
            // Build case-insensitive field map (same logic as pivot_process_data)
            $_ffMap = array();
            $_firstFR = reset($flatRows);
            foreach (array_keys($_firstFR) as $_fk) {
                $_ffMap[strtoupper($_fk)] = $_fk;
            }
            $_resRf = array();
            foreach ($rowFields as $_rf) {
                $_ru = strtoupper($_rf);
                $_resRf[] = isset($_ffMap[$_ru]) ? $_ffMap[$_ru] : $_rf;
            }
            $_resCf = array();
            foreach ($colFields as $_cf) {
                $_cu = strtoupper($_cf);
                $_resCf[] = isset($_ffMap[$_cu]) ? $_ffMap[$_cu] : $_cf;
            }
            foreach ($flatRows as $_frow) {
                $_rparts = array();
                foreach ($_resRf as $_rf) {
                    $_raw = isset($_frow[$_rf]) ? (string)$_frow[$_rf] : '';
                    $_val = pivot_clean_field_value($_raw);
                    $_rparts[] = ($_val === '') ? '[Blank]' : $_val;
                }
                $_cparts = array();
                foreach ($_resCf as $_cf) {
                    $_raw = isset($_frow[$_cf]) ? (string)$_frow[$_cf] : '';
                    $_val = pivot_clean_field_value($_raw);
                    $_cparts[] = ($_val === '') ? '[Blank]' : $_val;
                }
                $_lkey = implode('|||', $_rparts) . '###' . implode('|||', $_cparts);
                if (!isset($pivotFlatLookup[$_lkey])) {
                    $pivotFlatLookup[$_lkey] = $_frow;
                }
            }
        }
    }

    // --- Pivot format(header) helper ---
    // Build a map of headerTextUpper => inline CSS string from header format rules.
    $pivotHeaderStyles = array(); // headerTextUpper => 'prop: val; ...'
    if ($hasPivotHeaderFormat) {
        foreach ($pivotCfPrepared['header'] as $hRule) {
            $hTarget = strtoupper($hRule['targetColumn']);
            $hStyle = isset($hRule['style']) ? $hRule['style'] : '';
            // Aggregate conditions were already pre-evaluated (and nulled or
            // dropped) by prepare_format_rules; this direct call is the
            // backstop for any rule shape that slipped through with a
            // condition still attached. The old function_exists() guard hid
            // that the function did not exist - styles applied unconditionally.
            if (!empty($hRule['condition'])) {
                if (!evaluate_aggregate_condition_php($hRule['condition'], $flatRows)) {
                    continue;
                }
            }
            if (!isset($pivotHeaderStyles[$hTarget])) $pivotHeaderStyles[$hTarget] = '';
            $pivotHeaderStyles[$hTarget] .= ' ' . $hStyle;
        }
    }

    // --- Pivot rewrite() preparation ---
    // Build rewrite map: fieldNameUpper => array of prepare_rewrite_rules() rules
    // (keys: targetColumn, condition, template, plus '_parsed' when a condition exists)
    $pivotRewriteMap = array();
    if (!empty($rewriteRules)) {
        $allFieldsUpper = array_map(function($f) { return strtoupper(pivot_field_base($f)); }, array_merge($rowFields, $colFields));
