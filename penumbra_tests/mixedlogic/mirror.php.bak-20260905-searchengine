                        $_rcLookupIdx = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        if ($_rcLookupIdx === false || count($sortedColKeys) === 0) {
