        . '<font><sz val="' . $fontSize . '"/><color rgb="FF' . $dataFont . '"/><name val="' . _xlsx_esc($fontName) . '"/></font>'        // 2: normal data
        . '<font><b/><sz val="' . $fontSize . '"/><color rgb="FF' . $dataFont . '"/><name val="' . _xlsx_esc($fontName) . '"/></font>'    // 3: bold data
