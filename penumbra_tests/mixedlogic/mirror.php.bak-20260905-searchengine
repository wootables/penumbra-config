                    } else {
                        $prevKey = $sortedColKeys[$ci - 1];
                        $prevVal = isset($cellValues[$rowKey][$prevKey][$baseIdx]) ? $cellValues[$rowKey][$prevKey][$baseIdx] : 0;
                        $curVal = isset($cellValues[$rowKey][$colKey][$baseIdx]) ? $cellValues[$rowKey][$colKey][$baseIdx] : 0;
                        $cellValues[$rowKey][$colKey][$aggIdx] = ($prevVal != 0) ? (($curVal - $prevVal) / $prevVal) * 100 : null;
                    }
                }
            } elseif ($at === 'index') {
                $baseIdx = $_resolveBaseIdx($aggIdx);
                $firstKey = $sortedColKeys[0];
                $firstVal = isset($cellValues[$rowKey][$firstKey][$baseIdx]) ? $cellValues[$rowKey][$firstKey][$baseIdx] : 0;
                foreach ($sortedColKeys as $colKey) {
                    $curVal = isset($cellValues[$rowKey][$colKey][$baseIdx]) ? $cellValues[$rowKey][$colKey][$baseIdx] : 0;
                    $cellValues[$rowKey][$colKey][$aggIdx] = ($firstVal != 0) ? ($curVal / $firstVal) * 100 : null;
                }
            } elseif ($at === 'diff') {
                // Absolute change vs the previous column
                $baseIdx = $_resolveBaseIdx($aggIdx);
                foreach ($sortedColKeys as $ci => $colKey) {
                    if ($ci === 0) {
                        $cellValues[$rowKey][$colKey][$aggIdx] = null;
                    } else {
                        $prevKey = $sortedColKeys[$ci - 1];
                        $prevVal = isset($cellValues[$rowKey][$prevKey][$baseIdx]) ? $cellValues[$rowKey][$prevKey][$baseIdx] : 0;
                        $curVal = isset($cellValues[$rowKey][$colKey][$baseIdx]) ? $cellValues[$rowKey][$colKey][$baseIdx] : 0;
                        $cellValues[$rowKey][$colKey][$aggIdx] = (is_numeric($curVal) && is_numeric($prevVal)) ? ($curVal - $prevVal) : null;
                    }
                }
            } elseif ($at === 'pct_change:down' || $at === 'diff:down' || $at === 'index:down') {
                // Vertical pairwise: base slots are filled for every row in pass 1,
                // so the previous / first ROW's base value is directly readable.
                $baseIdx = $_resolveBaseIdx($aggIdx);
                $rowPos = array_search($rowKey, $allRowKeys, true);
                $firstRK = $allRowKeys[0];
                foreach ($sortedColKeys as $colKey) {
                    $curVal = isset($cellValues[$rowKey][$colKey][$baseIdx]) ? $cellValues[$rowKey][$colKey][$baseIdx] : 0;
                    if ($rowPos === 0 || $rowPos === false) {
                        $cellValues[$rowKey][$colKey][$aggIdx] = ($at === 'index:down') ? 100 : null;
                    } elseif ($at === 'index:down') {
                        $fVal = isset($cellValues[$firstRK][$colKey][$baseIdx]) ? $cellValues[$firstRK][$colKey][$baseIdx] : 0;
                        $cellValues[$rowKey][$colKey][$aggIdx] = (is_numeric($fVal) && $fVal != 0 && is_numeric($curVal)) ? ($curVal / $fVal) * 100 : null;
                    } else {
                        $prevRK = $allRowKeys[$rowPos - 1];
                        $pVal = isset($cellValues[$prevRK][$colKey][$baseIdx]) ? $cellValues[$prevRK][$colKey][$baseIdx] : 0;
                        if ($at === 'pct_change:down') {
                            $cellValues[$rowKey][$colKey][$aggIdx] = (is_numeric($pVal) && $pVal != 0 && is_numeric($curVal)) ? (($curVal - $pVal) / $pVal) * 100 : null;
                        } else {
                            $cellValues[$rowKey][$colKey][$aggIdx] = (is_numeric($pVal) && is_numeric($curVal)) ? ($curVal - $pVal) : null;
                        }
                    }
                }
            } elseif ($at === 'pct_grand_total') {
                $baseIdx = $_resolveBaseIdx($aggIdx);
                foreach ($sortedColKeys as $colKey) {
                    $cellVal = isset($cellValues[$rowKey][$colKey][$baseIdx]) ? $cellValues[$rowKey][$colKey][$baseIdx] : 0;
                    $grandTotal = $xlsxPreGrandTotals[$baseIdx];
                    if ($grandTotal == 0 || $grandTotal >= 1e308 || $grandTotal <= -1e308) {
                        $cellValues[$rowKey][$colKey][$aggIdx] = null;
                    } else {
                        $cellValues[$rowKey][$colKey][$aggIdx] = ($cellVal / $grandTotal) * 100;
                    }
                }
            } elseif ($at === 'formula') {
                // XLSX: evaluate formula with per-cell context
                $_fAstXb = isset($formulaASTs[$aggIdx]) ? $formulaASTs[$aggIdx] : null;
                foreach ($sortedColKeys as $colKey) {
                    if (!$_fAstXb) {
                        $cellValues[$rowKey][$colKey][$aggIdx] = null;
                        continue;
                    }
                    $_fCtxXb = array();
                    foreach ($aggTypes as $_oi7 => $_ot7) {
                        if ($_ot7 === 'formula') continue;
                        $_lblXb = isset($aggDisplayLabels[$_oi7]) ? $aggDisplayLabels[$_oi7] : pivot_get_agg_label($_ot7);
                        $_vXb = isset($cellValues[$rowKey][$colKey][$_oi7]) ? $cellValues[$rowKey][$colKey][$_oi7] : null;
                        $_fCtxXb[$_lblXb] = (is_numeric($_vXb) && is_finite($_vXb)) ? (float)$_vXb : null;
                    }
                    $cellValues[$rowKey][$colKey][$aggIdx] = pivot_eval_formula($_fAstXb, $_fCtxXb);
                }
            }
        }
    }

    // --- PASS 3: Build output rows ---
    $dataRows = array();
    foreach ($allRowKeys as $rowKey) {
        $row = array();
        $rowParts = explode('|||', $rowKey);
        foreach ($rowParts as $p) $row[] = $p;

        // Data cells
        foreach ($sortedColKeys as $colKey) {
            foreach ($aggTypes as $aggIdx => $at) {
                $val = $cellValues[$rowKey][$colKey][$aggIdx];
                $row[] = $xlsxFormatVal($val, $at, $aggIdx);
            }
        }

        // Grand Total column
        if ($hasGrandTotalCol) {
            foreach ($rowTotalAggTypes as $rtIdx => $at) {
                if (pivot_is_derived_agg($at)) {
                    // Special agg types need custom GT computation (can't just aggregate raw values)
                    if ($at === 'pct_change') {
                        // Find the nearest preceding base row-total token, then map to the
                        // main aggTypes index. Fallback: if $rowTotalAggTypes is the same as
                        // $aggTypes (no override), the base row-total idx IS the main idx.
                        $_xlsBaseRtIdx = pivot_find_base_agg_idx($rowTotalAggTypes, $rtIdx);
                        if ($rowTotalAggTypes === $aggTypes) {
                            $_xlsPcBaseIdx = $_xlsBaseRtIdx;
                        } else {
                            $_xlsPcBaseIdx = (isset($rowTotalBaseMap[$_xlsBaseRtIdx]) && $rowTotalBaseMap[$_xlsBaseRtIdx] >= 0)
                                ? $rowTotalBaseMap[$_xlsBaseRtIdx]
                                : false;
                        }
                        $baseAggType = ($_xlsPcBaseIdx !== false && isset($aggTypes[$_xlsPcBaseIdx])) ? $aggTypes[$_xlsPcBaseIdx] : 'sum';
                        $_xlsPcOc = ($_xlsPcBaseIdx !== false) ? $_aggCol($_xlsPcBaseIdx) : null;
                        $_xlsPcFi = ($_xlsPcBaseIdx !== false) ? $_aggFilterIdx($_xlsPcBaseIdx) : null;
                        if (count($sortedColKeys) > 1) {
                            $firstColKey = $sortedColKeys[0];
                            $lastColKey  = $sortedColKeys[count($sortedColKeys) - 1];
                            $firstCellData = isset($data[$rowKey][$firstColKey]) ? $data[$rowKey][$firstColKey] : null;
                            $lastCellData  = isset($data[$rowKey][$lastColKey])  ? $data[$rowKey][$lastColKey]  : null;
                            $firstVal = pivot_extract_agg_value($firstCellData, $baseAggType, $_xlsPcOc, $_xlsPcFi);
                            $lastVal  = pivot_extract_agg_value($lastCellData, $baseAggType, $_xlsPcOc, $_xlsPcFi);
                            if ($firstVal == 0 || $firstVal >= 1e308 || $firstVal <= -1e308) {
                                $totalVal = null;
                            } else {
                                $totalVal = (($lastVal - $firstVal) / $firstVal) * 100;
                            }
                        } else {
                            $totalVal = null;
                        }
                    } elseif ($at === 'diff') {
                        // Overall change: last column minus first column
                        $_xlsDPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        $_xlsDBaseIdx = ($_xlsDPos !== false) ? pivot_find_base_agg_idx($aggTypes, $_xlsDPos) : false;
                        if ($_xlsDBaseIdx !== false && count($sortedColKeys) > 1) {
                            $_xlsDBase = $aggTypes[$_xlsDBaseIdx];
                            $_xlsDFirstCD = isset($data[$rowKey][$sortedColKeys[0]]) ? $data[$rowKey][$sortedColKeys[0]] : null;
                            $_xlsDLastCD = isset($data[$rowKey][$sortedColKeys[count($sortedColKeys) - 1]]) ? $data[$rowKey][$sortedColKeys[count($sortedColKeys) - 1]] : null;
                            $_xlsDFirst = pivot_extract_agg_value($_xlsDFirstCD, $_xlsDBase, $_aggCol($_xlsDBaseIdx), $_aggFilterIdx($_xlsDBaseIdx));
                            $_xlsDLast = pivot_extract_agg_value($_xlsDLastCD, $_xlsDBase, $_aggCol($_xlsDBaseIdx), $_aggFilterIdx($_xlsDBaseIdx));
                            $totalVal = (!is_numeric($_xlsDFirst) || !is_numeric($_xlsDLast) || abs($_xlsDFirst) >= 1e308 || abs($_xlsDLast) >= 1e308) ? null : ($_xlsDLast - $_xlsDFirst);
                        } else {
                            $totalVal = null;
                        }
                    } elseif ($at === 'pct_change:down' || $at === 'diff:down') {
                        // Vertical pairwise: this row's base total vs the previous row's
                        $_xlsVdPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        $_xlsVdBaseIdx = ($_xlsVdPos !== false) ? pivot_find_base_agg_idx($aggTypes, $_xlsVdPos) : false;
                        $_xlsVdRowPos = array_search($rowKey, $allRowKeys, true);
                        if ($_xlsVdBaseIdx === false || $_xlsVdRowPos === false || $_xlsVdRowPos === 0) {
                            $totalVal = null;
                        } else {
                            $_xlsVdPrevRK = $allRowKeys[$_xlsVdRowPos - 1];
                            $_xlsVdCurT = isset($rowTotalsMap[$rowKey][$_xlsVdBaseIdx]) ? $rowTotalsMap[$rowKey][$_xlsVdBaseIdx] : null;
                            $_xlsVdPrevT = isset($rowTotalsMap[$_xlsVdPrevRK][$_xlsVdBaseIdx]) ? $rowTotalsMap[$_xlsVdPrevRK][$_xlsVdBaseIdx] : null;
                            if (!is_numeric($_xlsVdCurT) || !is_numeric($_xlsVdPrevT)) {
                                $totalVal = null;
                            } elseif ($at === 'pct_change:down') {
                                $totalVal = ($_xlsVdPrevT == 0) ? null : (($_xlsVdCurT - $_xlsVdPrevT) / $_xlsVdPrevT) * 100;
                            } else {
                                $totalVal = $_xlsVdCurT - $_xlsVdPrevT;
                            }
                        }
                    } elseif ($at === 'pct_row_total') {
                        $totalVal = 100;
                    } elseif ($at === 'pct_parent_row') {
                        $_xprPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        if ($_xprPos === false) { $totalVal = null; }
                        else {
                            $_xprB = pivot_find_base_agg_idx($aggTypes, $_xprPos);
                            $_xprN = isset($rowTotalsMap[$rowKey][$_xprB]) ? $rowTotalsMap[$rowKey][$_xprB] : null;
                            $_xprP = pivot_parent_prefix_of($rowKey);
                            $_xprD = ($xlsParent && isset($xlsParent['rowTot'][$_xprP][$_xprB])) ? $xlsParent['rowTot'][$_xprP][$_xprB] : 0;
                            $totalVal = (!is_numeric($_xprN) || $_xprD == 0) ? null : ($_xprN / $_xprD) * 100;
                        }
                    } elseif ($at === 'pct_parent_col' || $at === 'pct_cum') {
                        $totalVal = 100;
                    } elseif ($at === 'pct_cum:down') {
                        $_xcdPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        if ($_xcdPos === false) { $totalVal = null; }
                        else {
                            $_xcdB = pivot_find_base_agg_idx($aggTypes, $_xcdPos);
                            if (!isset($_xlsCumDnRT[$rtIdx])) $_xlsCumDnRT[$rtIdx] = 0;
                            $_xcdN = isset($rowTotalsMap[$rowKey][$_xcdB]) ? $rowTotalsMap[$rowKey][$_xcdB] : 0;
                            $_xlsCumDnRT[$rtIdx] += is_numeric($_xcdN) ? (float)$_xcdN : 0;
                            $totalVal = ($xlsxPreGrandTotals[$_xcdB] == 0) ? null : ($_xlsCumDnRT[$rtIdx] / $xlsxPreGrandTotals[$_xcdB]) * 100;
                        }
                    } elseif ($at === 'pct_col_total') {
                        // Prefer $rtIdx when it's a direct type match (no override).
                        // Fall back to first-match-by-type for hand-typed overrides.
                        $pctColIdx = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        if ($pctColIdx === false) {
                            $totalVal = null;
                        } else {
                            $sum = 0;
                            foreach ($sortedColKeys as $ck) {
                                $v = isset($cellValues[$rowKey][$ck][$pctColIdx]) ? $cellValues[$rowKey][$ck][$pctColIdx] : 0;
                                if (is_numeric($v)) $sum += $v;
                            }
                            $totalVal = $sum;
                        }
                    } elseif ($at === 'index' || $at === 'index:down') {
                        $idxPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        if ($idxPos === false) {
                            $totalVal = null;
                        } else {
                            $sum = 0; $count = 0;
                            foreach ($sortedColKeys as $ck) {
                                $v = isset($cellValues[$rowKey][$ck][$idxPos]) ? $cellValues[$rowKey][$ck][$idxPos] : 0;
                                if (is_numeric($v)) { $sum += $v; $count++; }
                            }
                            $totalVal = ($count > 0) ? $sum / $count : null;
                        }
                    } elseif ($at === 'pct_grand_total') {
                        // Sum pct_grand_total values across columns for this row
                        $pgtIdx = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        if ($pgtIdx === false) {
                            $totalVal = null;
                        } else {
                            $sum = 0;
                            foreach ($sortedColKeys as $ck) {
                                $v = isset($cellValues[$rowKey][$ck][$pgtIdx]) ? $cellValues[$rowKey][$ck][$pgtIdx] : 0;
                                if (is_numeric($v)) $sum += $v;
                            }
                            $totalVal = $sum;
                        }
                    } elseif (pivot_is_running_total_like($at)) {
                        // Running total row summary = last column's running total value
                        $_xrtLookup = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        if ($_xrtLookup === false || count($sortedColKeys) === 0) {
                            $totalVal = null;
                        } else {
                            $lastCK = $sortedColKeys[count($sortedColKeys) - 1];
                            $totalVal = isset($cellValues[$rowKey][$lastCK][$_xrtLookup]) ? $cellValues[$rowKey][$lastCK][$_xrtLookup] : 0;
                        }
                    } elseif ($at === 'running_count' || $at === 'running_count:down') {
                        // Running count row summary = last column's running count value
                        $_xrcLookup = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        if ($_xrcLookup === false || count($sortedColKeys) === 0) {
                            $totalVal = null;
                        } else {
                            $lastCK = $sortedColKeys[count($sortedColKeys) - 1];
                            $totalVal = isset($cellValues[$rowKey][$lastCK][$_xrcLookup]) ? $cellValues[$rowKey][$lastCK][$_xrcLookup] : 0;
                        }
                    } elseif ($at === 'formula') {
                        // XLSX row-total: evaluate formula with this row's totals as context
                        $_fAstXr = isset($formulaASTs[$rtIdx]) ? $formulaASTs[$rtIdx] : null;
                        if (!$_fAstXr) {
                            $totalVal = null;
                        } else {
                            $_fCtxXr = array();
                            foreach ($aggTypes as $_oi8 => $_ot8) {
                                if ($_ot8 === 'formula') continue;
                                $_lblXr = isset($aggDisplayLabels[$_oi8]) ? $aggDisplayLabels[$_oi8] : pivot_get_agg_label($_ot8);
                                $_vXr = isset($rowTotalsMap[$rowKey][$_oi8]) ? $rowTotalsMap[$rowKey][$_oi8] : null;
                                $_fCtxXr[$_lblXr] = (is_numeric($_vXr) && is_finite($_vXr)) ? (float)$_vXr : null;
                            }
                            $totalVal = pivot_eval_formula($_fAstXr, $_fCtxXr);
                        }
                    } else {
                        $totalVal = null;
                    }
                    $row[] = $xlsxFormatVal($totalVal, $at);
                } else {
                    // Normal agg types: aggregation-aware override
                    $_xlsRtBaseIdx = (isset($rowTotalBaseMap[$rtIdx]) && $rowTotalBaseMap[$rtIdx] >= 0) ? $rowTotalBaseMap[$rtIdx] : false;
                    if ($_xlsRtBaseIdx === false) {
                        foreach ($aggTypes as $_bi => $_aat) {
                            if (!pivot_is_derived_agg($_aat)) { $_xlsRtBaseIdx = $_bi; break; }
                        }
                    }
                    if ($_xlsRtBaseIdx !== false && $at !== $aggTypes[$_xlsRtBaseIdx] && !pivot_is_derived_agg($aggTypes[$_xlsRtBaseIdx]) && $aggTypes[$_xlsRtBaseIdx] !== 'mode' && $aggTypes[$_xlsRtBaseIdx] !== 'antimode') {
                        $totalVal = pivot_compute_override_total_from_cell_values('row', $rowKey, $sortedColKeys, $cellValues, $_xlsRtBaseIdx, $at);
                        $_xlsRtFmtType = $aggTypes[$_xlsRtBaseIdx];
                    } else {
                        $totalVal = pivot_compute_override_total('row', $rowKey, $sortedColKeys, $data, $at,
                            $_xlsRtBaseIdx !== false ? $_aggCol($_xlsRtBaseIdx) : null,
                            $_xlsRtBaseIdx !== false ? $_aggFilterIdx($_xlsRtBaseIdx) : null);
                        $_xlsRtFmtType = $at;
                    }
                    $row[] = $xlsxFormatVal($totalVal, $_xlsRtFmtType);
                }
            }
        }

        $dataRows[] = $row;
    }

    // =====================================================
    // BUILD FOOTER ROW (column totals)
    // =====================================================
    $footerRow = null;
    if (count($allRowKeys) > 1) {
        $footerRow = array();
        // Footer label in first row-field column
        // Derive col total label
        $colTotalLabel = 'Grand Total';
        if ($totalColAggs) {
            $uniqueOverrides = array();
            foreach ($totalColAggs as $v) {
                if ($v && !in_array($v, $uniqueOverrides)) $uniqueOverrides[] = $v;
            }
            if (count($uniqueOverrides) === 1) {
                $colTotalLabel = pivot_agg_total_label($uniqueOverrides[0]);
            } elseif (count($uniqueOverrides) > 1) {
                $colTotalLabel = 'Summary';
            } else {
                $colTotalLabel = (count($aggTypes) === 1) ? pivot_agg_total_label($aggTypes[0]) : 'Grand Total';
            }
        } else {
            $colTotalLabel = (count($aggTypes) === 1) ? pivot_agg_total_label($aggTypes[0]) : 'Grand Total';
        }
        $footerRow[] = $colTotalLabel;
        for ($i = 1; $i < $numRowFields; $i++) $footerRow[] = '';

        // Per-column footer totals - need to track previous column totals for pct_change
        $previousColTotalsXlsx = null;
        foreach ($sortedColKeys as $colIndex => $colKey) {
            // Compute the base totals for this column (needed for pct_change tracking)
            $colBaseTotals = array();
            foreach ($aggTypes as $aggIdx => $at) {
                if (!pivot_is_derived_agg($at)) {
                    $colBaseTotals[$aggIdx] = pivot_compute_override_total('col', $colKey, $allRowKeys, $data, $at, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                }
            }

            foreach ($aggTypes as $aggIdx => $at) {
                // Check for per-position override
                $effectiveAgg = $at;
                if ($totalColAggs && isset($totalColAggs[$aggIdx]) && $totalColAggs[$aggIdx]) {
                    $effectiveAgg = $totalColAggs[$aggIdx];
                }

                if (pivot_is_derived_agg($effectiveAgg)) {
                    if ($effectiveAgg === 'pct_change') {
                        if ($colIndex === 0 || !$previousColTotalsXlsx) {
                            $totalVal = null;
                        } else {
                            // Use nearest-preceding base agg index directly - array_search
                            // would return the FIRST occurrence of that type and collapse
                            // multiple filtered bases.
                            $baseNumIdx = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                            $currentTotal = isset($colBaseTotals[$baseNumIdx]) ? $colBaseTotals[$baseNumIdx] : 0;
                            $prevTotal = isset($previousColTotalsXlsx[$baseNumIdx]) ? $previousColTotalsXlsx[$baseNumIdx] : 0;
                            if ($prevTotal == 0 || $prevTotal >= 1e308 || $prevTotal <= -1e308) {
                                $totalVal = null;
                            } else {
                                $totalVal = (($currentTotal - $prevTotal) / $prevTotal) * 100;
                            }
                        }
                    } elseif ($effectiveAgg === 'diff') {
                        // Change vs the previous column's total
                        if ($colIndex === 0 || !$previousColTotalsXlsx) {
                            $totalVal = null;
                        } else {
                            $dBaseIdx = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                            $dCurT = isset($colBaseTotals[$dBaseIdx]) ? $colBaseTotals[$dBaseIdx] : 0;
                            $dPrevT = isset($previousColTotalsXlsx[$dBaseIdx]) ? $previousColTotalsXlsx[$dBaseIdx] : 0;
                            $totalVal = (!is_numeric($dCurT) || !is_numeric($dPrevT)) ? null : ($dCurT - $dPrevT);
                        }
                    } elseif ($effectiveAgg === 'pct_change:down' || $effectiveAgg === 'diff:down') {
                        // Footer for a vertical type: FIRST row to LAST row of this column
                        $vBaseIdx = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                        $vBase = $aggTypes[$vBaseIdx];
                        if (count($allRowKeys) > 1) {
                            $vFirstCD = isset($data[$allRowKeys[0]][$colKey]) ? $data[$allRowKeys[0]][$colKey] : null;
                            $vLastCD = isset($data[$allRowKeys[count($allRowKeys) - 1]][$colKey]) ? $data[$allRowKeys[count($allRowKeys) - 1]][$colKey] : null;
                            $vFirstV = pivot_extract_agg_value($vFirstCD, $vBase, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                            $vLastV = pivot_extract_agg_value($vLastCD, $vBase, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                            if (!is_numeric($vFirstV) || !is_numeric($vLastV) || abs($vFirstV) >= 1e308 || abs($vLastV) >= 1e308) {
                                $totalVal = null;
                            } elseif ($effectiveAgg === 'pct_change:down') {
                                $totalVal = ($vFirstV == 0) ? null : (($vLastV - $vFirstV) / $vFirstV) * 100;
                            } else {
                                $totalVal = $vLastV - $vFirstV;
                            }
                        } else {
                            $totalVal = null;
                        }
                    } elseif ($effectiveAgg === 'pct_row_total') {
                        $sum = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($cellValues[$rk][$colKey][$aggIdx]) ? $cellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) $sum += $v;
                        }
                        $totalVal = $sum;
                    } elseif ($effectiveAgg === 'pct_col_total') {
                        $totalVal = 100;
                    } elseif ($effectiveAgg === 'pct_parent_row') {
                        $totalVal = 100;
                    } elseif ($effectiveAgg === 'pct_parent_col') {
                        $xpcB = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                        $xpcN = isset($colTotalsMap[$colKey][$xpcB]) ? $colTotalsMap[$colKey][$xpcB] : null;
                        $xpcP = pivot_parent_prefix_of($colKey);
                        $xpcD = ($xlsParent && isset($xlsParent['colTot'][$xpcP][$xpcB])) ? $xlsParent['colTot'][$xpcP][$xpcB] : 0;
                        $totalVal = (!is_numeric($xpcN) || $xpcD == 0) ? null : ($xpcN / $xpcD) * 100;
                    } elseif ($effectiveAgg === 'pct_cum') {
                        $xcfB = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                        $xcfI = array_search($colKey, $sortedColKeys, true);
                        $xcfC = 0;
                        for ($xcfj = 0; $xcfj <= $xcfI; $xcfj++) {
                            $xcfv = isset($colTotalsMap[$sortedColKeys[$xcfj]][$xcfB]) ? $colTotalsMap[$sortedColKeys[$xcfj]][$xcfB] : 0;
                            if (is_numeric($xcfv)) $xcfC += $xcfv;
                        }
                        $totalVal = ($xlsxPreGrandTotals[$xcfB] == 0) ? null : ($xcfC / $xlsxPreGrandTotals[$xcfB]) * 100;
                    } elseif ($effectiveAgg === 'pct_cum:down') {
                        $totalVal = 100;
                    } elseif ($effectiveAgg === 'index' || $effectiveAgg === 'index:down') {
                        $sum = 0; $count = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($cellValues[$rk][$colKey][$aggIdx]) ? $cellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) { $sum += $v; $count++; }
                        }
                        $totalVal = ($count > 0) ? $sum / $count : null;
                    } elseif ($effectiveAgg === 'pct_grand_total') {
                        // Use $aggIdx directly - we're iterating main aggs, so
                        // position IS $aggIdx. array_search-by-type would
                        // collapse multiple same-type derived columns.
                        $sum = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($cellValues[$rk][$colKey][$aggIdx]) ? $cellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) $sum += $v;
                        }
                        $totalVal = $sum;
                    } elseif (pivot_is_running_total_like($effectiveAgg)) {
                        $sum = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($cellValues[$rk][$colKey][$aggIdx]) ? $cellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) $sum += $v;
                        }
                        $totalVal = $sum;
                    } elseif ($effectiveAgg === 'running_count' || $effectiveAgg === 'running_count:down') {
                        $sum = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($cellValues[$rk][$colKey][$aggIdx]) ? $cellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) $sum += $v;
                        }
                        $totalVal = $sum;
                    } elseif ($effectiveAgg === 'formula') {
                        // XLSX column footer: evaluate formula with column totals as context
                        $_fAstXff = isset($formulaASTs[$aggIdx]) ? $formulaASTs[$aggIdx] : null;
                        if (!$_fAstXff) {
                            $totalVal = null;
                        } else {
                            $_fCtxXff = array();
                            foreach ($aggTypes as $_oi9 => $_ot9) {
                                if ($_ot9 === 'formula') continue;
                                $_lblXff = isset($aggDisplayLabels[$_oi9]) ? $aggDisplayLabels[$_oi9] : pivot_get_agg_label($_ot9);
                                $_vXff = isset($colTotalsMap[$colKey][$_oi9]) ? $colTotalsMap[$colKey][$_oi9] : null;
                                $_fCtxXff[$_lblXff] = (is_numeric($_vXff) && is_finite($_vXff)) ? (float)$_vXff : null;
                            }
                            $totalVal = pivot_eval_formula($_fAstXff, $_fCtxXff);
                        }
                    } else {
                        $totalVal = null;
                    }
                    $footerRow[] = $xlsxFormatVal($totalVal, $effectiveAgg, $aggIdx);
                } else {
                    $_xlsBaseAgg = $aggTypes[$aggIdx];
                    if ($effectiveAgg !== $_xlsBaseAgg && !pivot_is_derived_agg($_xlsBaseAgg) && $_xlsBaseAgg !== 'mode' && $_xlsBaseAgg !== 'antimode') {
                        $totalVal = pivot_compute_override_total_from_cell_values('col', $colKey, $allRowKeys, $cellValues, $aggIdx, $effectiveAgg);
                        $_xlsFtFmtType = $_xlsBaseAgg;
                    } else {
                        $totalVal = isset($colBaseTotals[$aggIdx]) ? $colBaseTotals[$aggIdx] : pivot_compute_override_total('col', $colKey, $allRowKeys, $data, $effectiveAgg, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $_xlsFtFmtType = $effectiveAgg;
                    }
                    $footerRow[] = $xlsxFormatVal($totalVal, $_xlsFtFmtType, $aggIdx);
                }
            }
            $previousColTotalsXlsx = $colBaseTotals;
        }

        // Footer Grand Total corner cell(s)
        if ($hasGrandTotalCol) {
            foreach ($rowTotalAggTypes as $rtIdx => $rtAgg) {
                if (pivot_is_derived_agg($rtAgg)) {
                    // Special agg types in footer corner
                    if ($rtAgg === 'pct_change') {
                        // Overall % change from first column total to last column total
                        if (count($sortedColKeys) > 1) {
                            // Same fix as the row GT case above - map the row-total
                            // token's base to the correct main aggTypes index rather
                            // than array_search-by-type.
                            $_xlsCrBaseRtIdx = pivot_find_base_agg_idx($rowTotalAggTypes, $rtIdx);
                            if ($rowTotalAggTypes === $aggTypes) {
                                $_xlsCrPcBaseIdx = $_xlsCrBaseRtIdx;
                            } else {
                                $_xlsCrPcBaseIdx = (isset($rowTotalBaseMap[$_xlsCrBaseRtIdx]) && $rowTotalBaseMap[$_xlsCrBaseRtIdx] >= 0)
                                    ? $rowTotalBaseMap[$_xlsCrBaseRtIdx]
                                    : false;
                            }
                            $baseAggType = ($_xlsCrPcBaseIdx !== false && isset($aggTypes[$_xlsCrPcBaseIdx])) ? $aggTypes[$_xlsCrPcBaseIdx] : 'sum';
                            $_xlsCrPcOc = ($_xlsCrPcBaseIdx !== false) ? $_aggCol($_xlsCrPcBaseIdx) : null;
                            $_xlsCrPcFi = ($_xlsCrPcBaseIdx !== false) ? $_aggFilterIdx($_xlsCrPcBaseIdx) : null;
                            $firstTotal = pivot_compute_override_total('col', $sortedColKeys[0], $allRowKeys, $data, $baseAggType, $_xlsCrPcOc, $_xlsCrPcFi);
                            $lastTotal  = pivot_compute_override_total('col', $sortedColKeys[count($sortedColKeys) - 1], $allRowKeys, $data, $baseAggType, $_xlsCrPcOc, $_xlsCrPcFi);
                            if ($firstTotal == 0 || $firstTotal >= 1e308 || $firstTotal <= -1e308) {
                                $cornerVal = null;
                            } else {
                                $cornerVal = (($lastTotal - $firstTotal) / $firstTotal) * 100;
                            }
                        } else {
                            $cornerVal = null;
                        }
                    } elseif ($rtAgg === 'diff') {
                        // Whole-span change of the base column totals
                        $_xlsCrDPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $rtAgg) ? $rtIdx : array_search($rtAgg, $aggTypes, true);
                        $_xlsCrDBaseIdx = ($_xlsCrDPos !== false) ? pivot_find_base_agg_idx($aggTypes, $_xlsCrDPos) : false;
                        if ($_xlsCrDBaseIdx === false || count($sortedColKeys) < 2) {
                            $cornerVal = null;
                        } else {
                            $_xlsCrDBase = $aggTypes[$_xlsCrDBaseIdx];
                            $_xlsCrDFirst = pivot_compute_override_total('col', $sortedColKeys[0], $allRowKeys, $data, $_xlsCrDBase, $_aggCol($_xlsCrDBaseIdx), $_aggFilterIdx($_xlsCrDBaseIdx));
                            $_xlsCrDLast = pivot_compute_override_total('col', $sortedColKeys[count($sortedColKeys) - 1], $allRowKeys, $data, $_xlsCrDBase, $_aggCol($_xlsCrDBaseIdx), $_aggFilterIdx($_xlsCrDBaseIdx));
                            $cornerVal = (!is_numeric($_xlsCrDFirst) || !is_numeric($_xlsCrDLast)) ? null : ($_xlsCrDLast - $_xlsCrDFirst);
                        }
                    } elseif ($rtAgg === 'pct_change:down' || $rtAgg === 'diff:down') {
                        // Vertical whole-span: first row's base total to the last row's
                        $_xlsCrVPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $rtAgg) ? $rtIdx : array_search($rtAgg, $aggTypes, true);
                        $_xlsCrVBaseIdx = ($_xlsCrVPos !== false) ? pivot_find_base_agg_idx($aggTypes, $_xlsCrVPos) : false;
                        if ($_xlsCrVBaseIdx === false || count($allRowKeys) < 2) {
                            $cornerVal = null;
                        } else {
                            $_xlsCrVFirst = isset($rowTotalsMap[$allRowKeys[0]][$_xlsCrVBaseIdx]) ? $rowTotalsMap[$allRowKeys[0]][$_xlsCrVBaseIdx] : null;
                            $_xlsCrVLast = isset($rowTotalsMap[$allRowKeys[count($allRowKeys) - 1]][$_xlsCrVBaseIdx]) ? $rowTotalsMap[$allRowKeys[count($allRowKeys) - 1]][$_xlsCrVBaseIdx] : null;
                            if (!is_numeric($_xlsCrVFirst) || !is_numeric($_xlsCrVLast)) {
                                $cornerVal = null;
                            } elseif ($rtAgg === 'pct_change:down') {
                                $cornerVal = ($_xlsCrVFirst == 0) ? null : (($_xlsCrVLast - $_xlsCrVFirst) / $_xlsCrVFirst) * 100;
                            } else {
                                $cornerVal = $_xlsCrVLast - $_xlsCrVFirst;
                            }
                        }
                    } elseif ($rtAgg === 'pct_row_total') {
                        $cornerVal = 100;
                    } elseif ($rtAgg === 'pct_col_total') {
                        $cornerVal = 100;
                    } elseif ($rtAgg === 'pct_parent_row' || $rtAgg === 'pct_parent_col'
                        || $rtAgg === 'pct_cum' || $rtAgg === 'pct_cum:down') {
                        $cornerVal = 100;
                    } elseif ($rtAgg === 'index' || $rtAgg === 'index:down') {
                        $idxPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $rtAgg) ? $rtIdx : array_search($rtAgg, $aggTypes, true);
                        if ($idxPos === false) {
                            $cornerVal = null;
                        } else {
                            $sum = 0; $count = 0;
                            foreach ($allRowKeys as $rk) {
                                foreach ($sortedColKeys as $ck) {
                                    $v = isset($cellValues[$rk][$ck][$idxPos]) ? $cellValues[$rk][$ck][$idxPos] : 0;
                                    if (is_numeric($v)) { $sum += $v; $count++; }
                                }
                            }
                            $cornerVal = ($count > 0) ? $sum / $count : null;
                        }
                    } elseif ($rtAgg === 'pct_grand_total') {
                        $cornerVal = 100;
                    } elseif (pivot_is_running_total_like($rtAgg)) {
                        // Sum of all base agg column totals
                        $_xlsCrRtBase = pivot_find_base_agg_idx($rowTotalAggTypes, $rtIdx);
                        if ($rowTotalAggTypes === $aggTypes) {
                            $baseIdx = $_xlsCrRtBase;
                        } else {
                            $baseIdx = (isset($rowTotalBaseMap[$_xlsCrRtBase]) && $rowTotalBaseMap[$_xlsCrRtBase] >= 0)
                                ? $rowTotalBaseMap[$_xlsCrRtBase]
                                : false;
                        }
                        $sum = 0;
                        if ($baseIdx !== false) {
                            foreach ($sortedColKeys as $ck) {
                                $sum += isset($colTotalsMap[$ck][$baseIdx]) ? $colTotalsMap[$ck][$baseIdx] : 0;
                            }
                        }
                        $cornerVal = $sum;
                    } elseif ($rtAgg === 'running_count' || $rtAgg === 'running_count:down') {
                        // Sum of all cell counts across all rows and columns
                        $cornerVal = 0;
                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                $cd = isset($data[$rk][$ck]) ? $data[$rk][$ck] : null;
                                $cornerVal += $cd ? (isset($cd['count']) ? $cd['count'] : (isset($cd['values']) ? count($cd['values']) : 0)) : 0;
                            }
                        }
                    } else {
                        $cornerVal = null;
                    }
                    $footerRow[] = $xlsxFormatVal($cornerVal, $rtAgg);
                } else {
                    // Normal agg: compute across all rows and all columns
                    // Resolve base index for format type
                    $_xlsCrBaseIdx = (isset($rowTotalBaseMap[$rtIdx]) && $rowTotalBaseMap[$rtIdx] >= 0) ? $rowTotalBaseMap[$rtIdx] : false;
                    if ($_xlsCrBaseIdx === false) {
                        foreach ($aggTypes as $_cbi => $_cat) {
                            if (!pivot_is_derived_agg($_cat)) { $_xlsCrBaseIdx = $_cbi; break; }
                        }
                    }
                    $_xlsCrFmtType = ($_xlsCrBaseIdx !== false && $rtAgg !== $aggTypes[$_xlsCrBaseIdx]) ? $aggTypes[$_xlsCrBaseIdx] : $rtAgg;

                    if ($_xlsCrBaseIdx !== false && $rtAgg !== $aggTypes[$_xlsCrBaseIdx] && !pivot_is_derived_agg($aggTypes[$_xlsCrBaseIdx]) && $aggTypes[$_xlsCrBaseIdx] !== 'mode' && $aggTypes[$_xlsCrBaseIdx] !== 'antimode') {
                        // Aggregation-aware: use pre-computed cell values
                        $crCellVals = array();
                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                if (isset($cellValues[$rk][$ck][$_xlsCrBaseIdx]) && is_numeric($cellValues[$rk][$ck][$_xlsCrBaseIdx])) {
                                    $crCellVals[] = (float)$cellValues[$rk][$ck][$_xlsCrBaseIdx];
                                }
                            }
                        }
                        if (empty($crCellVals)) {
                            $cornerVal = 0;
                        } elseif ($rtAgg === 'avg') {
                            $cornerVal = array_sum($crCellVals) / count($sortedColKeys);
                        } elseif ($rtAgg === 'count') {
                            $cornerVal = count($crCellVals);
                        } else {
                            $cornerVal = pivot_compute_agg_from_values($crCellVals, $rtAgg);
                        }
                    } else {
                        $allVals = array();
                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                $cellData = isset($data[$rk][$ck]) ? $data[$rk][$ck] : null;
                                if ($cellData) {
                                    $_xlsCrBucket = pivot_resolve_agg_bucket($cellData, $aggColOverrides, $_xlsCrBaseIdx !== false ? $_xlsCrBaseIdx : 0, $_xlsCrBaseIdx !== false ? $_aggFilterIdx($_xlsCrBaseIdx) : null);
                                    if ($_xlsCrBucket && isset($_xlsCrBucket['values'])) {
                                        foreach ($_xlsCrBucket['values'] as $v) {
                                            $parsed = pivot_parse_value($v);
                                            if ($parsed !== false) $allVals[] = $parsed;
                                        }
                                    }
                                }
                            }
                        }
                        if ($rtAgg === 'avg') {
                            $totalSum = pivot_compute_agg_from_values($allVals, 'sum');
                            $cornerVal = count($sortedColKeys) > 0 ? $totalSum / count($sortedColKeys) : 0;
                        } else {
                            $cornerVal = pivot_compute_agg_from_values($allVals, $rtAgg);
                        }
                    }
                    $footerRow[] = $xlsxFormatVal($cornerVal, $_xlsCrFmtType);
                }
            }
        }
    }

    return array(
        'headerRows' => $headerRows,
        'dataRows' => $dataRows,
        'colTypes' => $colTypes,
        'merges' => $merges,
        'numRowFields' => $numRowFields,
        'hasGrandTotalCol' => $hasGrandTotalCol,
        'hasSubRow' => $hasSubRow,
        'isMulti' => $isMulti,
        'footerRow' => $footerRow,
        'totalCols' => $totalCols,
        'isCurrency' => $isCurrency,
        'sourceMaxDecimals' => $sourceMaxDecimals
    );
}

function _cf_compute_group_agg_raw($rows, $aggCol, $aggType, $groupByCol = null, $groupKey = null) {
    $values = array();
    $rawCells = array();    // Raw cell text, fed to the shared summary engine
    $rawTexts = array();    // Preserve original cell text for date min/max display
    $srcPrefix = '';
    $srcSuffix = '';
    $srcMaxDecimals = 0;
    $srcFormatDetected = false;
    $isDateColumn = false;
    $dateCheckDone = false;

    // Detect if aggCol is a virtual (@@JSON nested) column
    $isVirtualAgg = false;
    $upperAggCol = strtoupper($aggCol);
    $isVirtualGroupBy = false;
    $upperGroupByCol = $groupByCol ? strtoupper($groupByCol) : null;
    if (!empty($rows)) {
        $firstRow = reset($rows);
        $sampleVirtual = _search_get_virtual_columns($firstRow);
        if (isset($sampleVirtual[$upperAggCol])) {
            $isVirtualAgg = true;
        }
        if ($upperGroupByCol && isset($sampleVirtual[$upperGroupByCol])) {
            $isVirtualGroupBy = true;
        }
    }

    foreach ($rows as $row) {
        // Collect cell values - may be multiple for virtual columns
        $cellTexts = array();
        if ($isVirtualAgg) {
            if ($isVirtualGroupBy && $groupKey !== null) {
                // Both grouping and agg columns are virtual - use structured data
                // to filter nested rows where grouping column matches group key
                $sources = _search_get_structured_virtual_data($row);
                foreach ($sources as $src) {
                    $srcCols = array();
                    foreach ($src['columns'] as $c) $srcCols[strtoupper($c)] = true;
                    if (isset($srcCols[$upperAggCol]) && isset($srcCols[$upperGroupByCol])) {
                        // Same source - filter nested rows by group key
                        foreach ($src['rows'] as $nRow) {
                            $nGroupVal = isset($nRow[$upperGroupByCol]) ? trim((string)$nRow[$upperGroupByCol]) : '';
                            if ($nGroupVal === '') $nGroupVal = '[Blank]';
                            if ($nGroupVal === $groupKey) {
                                $nAggVal = isset($nRow[$upperAggCol]) ? trim((string)$nRow[$upperAggCol]) : '';
                                $cellTexts[] = $nAggVal;
                            }
                        }
                    } elseif (isset($srcCols[$upperAggCol])) {
                        // Agg column in different source - take all values
                        foreach ($src['rows'] as $nRow) {
                            $nAggVal = isset($nRow[$upperAggCol]) ? trim((string)$nRow[$upperAggCol]) : '';
                            $cellTexts[] = $nAggVal;
                        }
                    }
                }
            } else {
                // Grouping is normal column, agg is virtual - take all values
                $vCols = _search_get_virtual_columns($row);
                $vVals = isset($vCols[$upperAggCol]) ? $vCols[$upperAggCol] : array();
                foreach ($vVals as $vv) {
                    $cellTexts[] = trim((string)$vv);
                }
            }
        } else {
            // Find the column (case-insensitive) - single value
            $cellVal = null;
            foreach ($row as $k => $v) {
                if (strtoupper($k) === $upperAggCol) {
                    $cellVal = $v;
                    break;
                }
            }
            $cellTexts[] = ($cellVal === null) ? '' : trim((string)$cellVal);
        }

        // Raw cell text for every path, so the shared summary engine can be
        // handed exactly what the browser's accumulator receives. (2026-08-30)
        foreach ($cellTexts as $cellStr) $rawCells[] = $cellStr;
        foreach ($cellTexts as $cellStr) {
            if ($aggType === 'count') {
                if ($cellStr !== '') $values[] = 1;
            } elseif ($aggType === 'count_distinct') {
                if ($cellStr !== '') $values[] = $cellStr;
            } else {
                if ($cellStr === '') continue;

                // Detect if column contains dates (check first non-empty cell)
                if (!$dateCheckDone) {
                    $dateCheckDone = true;
                    // Common date patterns
                    if (preg_match('#^\d{1,2}[/\-]\d{1,2}[/\-]\d{2,4}#', $cellStr) ||
                        preg_match('#^\d{4}[/\-]\d{1,2}[/\-]\d{1,2}#', $cellStr) ||
                        preg_match('#^\d{1,2}-[A-Za-z]{3}-\d{2,4}$#', $cellStr) ||
                        preg_match('#^[A-Za-z]+ \d{1,2}, \d{4}$#', $cellStr)) {
                        $testTs = strtotime($cellStr);
                        if ($testTs !== false && $testTs > 0) {
                            $isDateColumn = true;
                        }
                    }
                }

                if ($isDateColumn && ($aggType === 'min' || $aggType === 'max')) {
                    // Parse as date for min/max comparison
                    $ts = strtotime($cellStr);
                    if ($ts !== false && $ts > 0) {
                        $values[] = $ts;
                        $rawTexts[] = $cellStr;
                    }
                } else {
                    // Numeric path
                    if (!$srcFormatDetected) {
                        if (substr($cellStr, 0, 1) === '$') $srcPrefix = '$';
                        if (substr($cellStr, -1) === '%') $srcSuffix = '%';
                        $srcFormatDetected = true;
                    }
                    $stripped = preg_replace('/[$%,\s]/', '', $cellStr);
                    $dotPos = strpos($stripped, '.');
                    if ($dotPos !== false) {
                        $dec = strlen($stripped) - $dotPos - 1;
                        if ($dec > $srcMaxDecimals) $srcMaxDecimals = $dec;
                    }
                    $num = preg_replace('/[^0-9.\-]/', '', $cellStr);
                    if (is_numeric($num)) $values[] = (float)$num;
                }
            }
        }
    }

    $empty = array('value' => null, 'isDate' => false, 'rawText' => null, 'prefix' => '', 'suffix' => '', 'maxDecimals' => 0);

    // ONE aggregation engine, matching js/main.js's _rcaApply(): EVERY type -
    // including the original six - is computed by the same
    // penumbra_compute_summary() the column footers use, so a scheduled send
    // cannot disagree with the screen. Group mode used to carry its own switch,
    // which is why its vocabulary sat six types behind the registry that
    // already implements median, range, stddev, mode, antimode and the counting
    // family. The browser proved the six are unchanged under this engine before
    // the same move was made here; the php fixtures assert their exact values.
    $_regType = penumbra_group_agg_registry_type($aggType);
    {
        if (empty($rawCells)) return $empty;
        $r = penumbra_compute_summary($rawCells, $_regType, penumbra_is_toggle_column($aggCol));
        if ($r === null) return $empty;
        // 'text' (mode/antimode) travels in rawText so the caller renders the
        // winning VALUE rather than casting a string to a number.
        $isTextKind = (isset($r['kind']) && $r['kind'] === 'text');
        return array(
            'value'       => $isTextKind ? 0 : $r['value'],
            'isDate'      => (isset($r['kind']) && $r['kind'] === 'date'),
            'rawText'     => $isTextKind ? (string)$r['value']
                             : ((isset($r['kind']) && $r['kind'] === 'date') ? $r['text'] : null),
            'prefix'      => (!empty($r['isCurrency'])) ? '$' : '',
            'suffix'      => (!empty($r['isPercent'])) ? '%' : '',
            'maxDecimals' => isset($r['decimals']) ? (int)$r['decimals'] : 0
        );
    }

}

function compute_group_agg_summary($rows, $aggCol, $aggType, $groupByCol = null, $groupKey = null) {
    // Display labels for the email header (keeps the long-standing "Average" wording).
    // Twin of _GROUP_AGG_LABELS in js/main.js. 'Average' rather than the
    // browser's 'Avg' is long-standing email wording and stays.
    $aggLabels = array(
        'sum' => 'Sum', 'avg' => 'Average', 'min' => 'Min', 'max' => 'Max',
        'count' => 'Count', 'count_distinct' => 'Distinct',
        'median' => 'Median', 'range' => 'Range', 'stddev' => 'Std Dev',
        'count_blank' => 'Blank', 'mode' => 'Mode', 'antimode' => 'Antimode'
    );
    $raw = _cf_compute_group_agg_raw($rows, $aggCol, $aggType, $groupByCol, $groupKey);
    if ($raw['value'] === null) return null;
    $aggResult = $raw['value'];
    $aggResultText = $raw['rawText'];

    if ($aggResultText) {
        $formatted = $aggResultText;
    } elseif ($aggType === 'count' || $aggType === 'count_distinct') {
        $formatted = number_format($aggResult, 0);
    } elseif ($aggType === 'avg') {
        $avgDec = max($raw['maxDecimals'], 2);
        $formatted = number_format($aggResult, $avgDec);
    } else {
        $formatted = number_format($aggResult, $raw['maxDecimals']);
    }
    $formatted = $raw['prefix'] . $formatted . $raw['suffix'];
    $label = isset($aggLabels[$aggType]) ? $aggLabels[$aggType] : $aggType;
    return $label . ' of ' . htmlspecialchars($aggCol) . ': ' . $formatted;
}

function _cf_group_summary_label($groupAgg) {
    if (!$groupAgg || empty($groupAgg['column']) || empty($groupAgg['type'])) return null;
    $labels = array('sum' => 'Sum', 'avg' => 'Avg', 'min' => 'Min', 'max' => 'Max', 'count' => 'Count', 'count_distinct' => 'Distinct');
    $t = $groupAgg['type'];
    $lbl = isset($labels[$t]) ? $labels[$t] : $t;
    return $lbl . ' of ' . $groupAgg['column'];
}

function _cf_split_group_summary_query($parsedQuery, $labelUpper) {
    $rowParts = array();
    $summaryConds = array();
    $n = count($parsedQuery);
    for ($i = 0; $i < $n; $i++) {
        $part = $parsedQuery[$i];
        $isSummary = isset($part['type']) && $part['type'] === 'condition' && isset($part['column']) &&
            strtoupper(preg_replace('/^\{[\'"]?|[\'"]?\}$/', '', $part['column'])) === $labelUpper;
        if ($isSummary) {
            $summaryConds[] = array('op' => $part['op'], 'value' => $part['value']);
            if ($i + 1 < $n && isset($parsedQuery[$i + 1]['type']) && $parsedQuery[$i + 1]['type'] === 'logical') {
                $i++;
            } elseif (!empty($rowParts) && $rowParts[count($rowParts) - 1]['type'] === 'logical') {
                array_pop($rowParts);
            }
        } else {
            $rowParts[] = $part;
        }
    }
    while (!empty($rowParts) && $rowParts[0]['type'] === 'logical') array_shift($rowParts);
    while (!empty($rowParts) && $rowParts[count($rowParts) - 1]['type'] === 'logical') array_pop($rowParts);
    return array('rowParts' => $rowParts, 'summaryConds' => $summaryConds);
}

function _cf_compare_group_summary($num, $isDate, $op, $rhs, $hasVal) {
    if (strtolower((string)$rhs) === 'empty') {
        return ($op === '=') ? !$hasVal : $hasVal;
    }
    if ($isDate) {
        $ts = strtotime($rhs);
        $rhsNum = ($ts !== false) ? (float)$ts : NAN;
    } else {
        $clean = preg_replace('/[^0-9.\-]/', '', (string)$rhs);
        $rhsNum = is_numeric($clean) ? (float)$clean : NAN;
    }
    if (is_nan((float)$num) || is_nan($rhsNum)) {
        if ($op === '=') return false;
        if ($op === '!=' || $op === '<>') return true;
        return false;
    }
    switch ($op) {
        case '>':  return $num >  $rhsNum;
        case '<':  return $num <  $rhsNum;
        case '>=': return $num >= $rhsNum;
        case '<=': return $num <= $rhsNum;
        case '=':  return $num == $rhsNum;
        case '!=':
        case '<>': return $num != $rhsNum;
        case 'contains': return strpos((string)$num, (string)$rhs) !== false;
        default: return false;
    }
}

function _cf_match_group_summary($num, $isDate, $summaryConds) {
    if (empty($summaryConds)) return true;
    $hasVal = ($num !== null);
    $cmpNum = $hasVal ? (float)$num : NAN;
    foreach ($summaryConds as $c) {
        $rhs = preg_replace('/^[\'"]|[\'"]$/', '', trim((string)$c['value']));
        if (!_cf_compare_group_summary($cmpNum, $isDate, $c['op'], $rhs, $hasVal)) return false;
    }
    return true;
}

function parse_format_args($argString) {
    $args = array();
    $current = '';
    $parenDepth = 0;
    $inQuote = false;
    $quoteChar = '';
    $len = strlen($argString);

    $inGuard = false; // inside a \x02...\x02 pre-formatted-number guard

    for ($i = 0; $i < $len; $i++) {
        $ch = $argString[$i];
        if ($ch === "\x02") {
            // A guarded number like \x021,234\x02 is atomic: its thousands comma
            // must not split the argument list (round()/fixed() output nested in
            // an enclosing call). Mirrors the browser splitters' guard awareness.
            $inGuard = !$inGuard;
        } else if (!$inQuote && ($ch === "'" || $ch === '"')) {
            $inQuote = true;
            $quoteChar = $ch;
        } else if ($inQuote && $ch === $quoteChar && ($i === 0 || $argString[$i - 1] !== '\\')) {
            $inQuote = false;
        } else if (!$inQuote && $ch === '(') {
            $parenDepth++;
        } else if (!$inQuote && $ch === ')') {
            $parenDepth--;
        }

        if ($ch === ',' && !$inQuote && !$inGuard && $parenDepth === 0) {
            $args[] = trim($current);
            $current = '';
        } else {
            $current .= $ch;
        }
    }
    $args[] = trim($current);

    // Strip outer quotes. A single-quoted argument also drops the backslash from
    // \' - the loop above already treated it as an escaped quote, so it is noise
    // once the wrapping quotes are gone, and leaving it in printed a literal
    // `Sponsor\'s Board` in scheduled email. Written and reverted once
    // (2026-08-11) while the browser still aborted its whole render on the real
    // apostrophe this produces; that guard is fixed, so both engines carry it now.
    //
    // Double-quoted arguments are deliberately left alone: the \" inside an
    // `action(infobox, ..., "raw|...")` payload is load-bearing for the nested
    // re-parse. Twin of parseFunctionArgs() in js/main.js.
    // Strip only when the argument IS one quoted literal - the first UNESCAPED
    // closing quote must be the final character. Testing just first-and-last
    // char also fired on `'Smith' = 'Smith'`, returning `Smith' = 'Smith` and
    // breaking every quoted case() condition. Strict narrowing; browser twin in
    // parseFunctionArgs (js/main.js).
    $cleaned = array();
    foreach ($args as $arg) {
        $argLen = strlen($arg);
        if ($argLen >= 2) {
            $qc = $arg[0];
            if ($qc === "'" || $qc === '"') {
                $closeAt = -1;
                for ($k = 1; $k < $argLen; $k++) {
                    if ($arg[$k] === $qc && $arg[$k - 1] !== '\\') { $closeAt = $k; break; }
                }
                if ($closeAt === $argLen - 1) {
                    $inner = substr($arg, 1, $argLen - 2);
                    $arg = ($qc === "'") ? str_replace("\\'", "'", $inner) : $inner;
                }
            }
        }
        $cleaned[] = $arg;
    }
    return $cleaned;
}

function _pnb_heat_jsround($x) { return (int)floor($x + 0.5); }

function _pnb_heat_cbrt($x) { return $x < 0 ? -pow(-$x, 1 / 3) : pow($x, 1 / 3); }

function _pnb_heat_srgb_to_linear($c) {
    $c = $c / 255;
    return $c <= 0.04045 ? $c / 12.92 : pow(($c + 0.055) / 1.055, 2.4);
}

function _pnb_heat_linear_to_srgb($c) {
    $v = $c <= 0.0031308 ? $c * 12.92 : 1.055 * pow($c, 1 / 2.4) - 0.055;
    return max(0, min(255, _pnb_heat_jsround($v * 255)));
}

function _pnb_heat_rgb_to_oklab($rgb) {
    $r = _pnb_heat_srgb_to_linear($rgb[0]);
    $g = _pnb_heat_srgb_to_linear($rgb[1]);
    $b = _pnb_heat_srgb_to_linear($rgb[2]);
    $l = _pnb_heat_cbrt(0.4122214708 * $r + 0.5363325363 * $g + 0.0514459929 * $b);
    $m = _pnb_heat_cbrt(0.2119034982 * $r + 0.6806995451 * $g + 0.1073969566 * $b);
    $s = _pnb_heat_cbrt(0.0883024619 * $r + 0.2817188376 * $g + 0.6299787005 * $b);
    return array(
        0.2104542553 * $l + 0.7936177850 * $m - 0.0040720468 * $s,
        1.9779984951 * $l - 2.4285922050 * $m + 0.4505937099 * $s,
        0.0259040371 * $l + 0.7827717662 * $m - 0.8086757660 * $s
    );
}

function _pnb_heat_oklab_to_rgb($lab) {
    $l_ = $lab[0] + 0.3963377774 * $lab[1] + 0.2158037573 * $lab[2];
    $m_ = $lab[0] - 0.1055613458 * $lab[1] - 0.0638541728 * $lab[2];
    $s_ = $lab[0] - 0.0894841775 * $lab[1] - 1.2914855480 * $lab[2];
    $l = $l_ * $l_ * $l_; $m = $m_ * $m_ * $m_; $s = $s_ * $s_ * $s_;
    return array(
        _pnb_heat_linear_to_srgb(4.0767416621 * $l - 3.3077115913 * $m + 0.2309699292 * $s),
        _pnb_heat_linear_to_srgb(-1.2684380046 * $l + 2.6097574011 * $m - 0.3413193965 * $s),
        _pnb_heat_linear_to_srgb(-0.0041960863 * $l - 0.7034186147 * $m + 1.7076147010 * $s)
    );
}

function pnb_heat_parse_color($css) {
    if (!$css) return null;
    $s = trim((string)$css);
    if ($s === '') return null;
    if ($s[0] === '#') {
        $h = substr($s, 1);
        if (strlen($h) === 3) $h = $h[0].$h[0].$h[1].$h[1].$h[2].$h[2];
        if (strlen($h) !== 6 || !ctype_xdigit($h)) return null;
        return array(hexdec(substr($h,0,2)), hexdec(substr($h,2,2)), hexdec(substr($h,4,2)));
    }
    if (preg_match('/^rgba?\(([^)]+)\)$/i', $s, $m)) {
        $p = array_map('trim', explode(',', $m[1]));
        if (count($p) < 3) return null;
        if (count($p) > 3 && (float)$p[3] <= 0.01) return null;   // transparent = no colour
        return array((float)$p[0], (float)$p[1], (float)$p[2]);
    }
    return null;
}

function pnb_heat_to_hex($rgb) {
    $out = '#';
    foreach (array(0,1,2) as $i) {
        $out .= str_pad(dechex(max(0, min(255, _pnb_heat_jsround($rgb[$i])))), 2, '0', STR_PAD_LEFT);
    }
    return $out;
}

function pnb_heat_theme_var($name, $fallback, $themeName = null) {
    if ($themeName === null) {
        $themeName = isset($GLOBALS['current_email_theme']) ? $GLOBALS['current_email_theme'] : 'theme-default';
    }
    $themes = penumbra_get_themes();
    if (isset($themes[$themeName]['vars'][$name]) && $themes[$themeName]['vars'][$name] !== '') {
        return $themes[$themeName]['vars'][$name];
    }
    if (isset($themes['theme-default']['vars'][$name])) return $themes['theme-default']['vars'][$name];
    return $fallback;
}

function _pnb_heat_rotate_hue($rgb, $deg) {
    $lab = _pnb_heat_rgb_to_oklab($rgb);
    $rad = $deg * M_PI / 180;
    $cos = cos($rad); $sin = sin($rad);
    return _pnb_heat_oklab_to_rgb(array($lab[0], $lab[1] * $cos - $lab[2] * $sin, $lab[1] * $sin + $lab[2] * $cos));
}

function pnb_heat_build_ramp($name, $themeName = null) {
    $surface  = pnb_heat_parse_color(pnb_heat_theme_var('bg-surface', '#ffffff', $themeName));
    $primary  = pnb_heat_parse_color(pnb_heat_theme_var('brand-primary', '#336699', $themeName));
    $textMain = pnb_heat_parse_color(pnb_heat_theme_var('text-main', '#222222', $themeName));
    if (!$surface)  $surface  = array(255,255,255);
    if (!$primary)  $primary  = array(51,102,153);
    if (!$textMain) $textMain = array(34,34,34);
    switch ($name) {
        case 'mono':      return array(array(0,$surface), array(1,$textMain));
        // Complement, NOT --brand-secondary: in 14 of 17 themes secondary is a
        // lighter TINT of primary, so secondary->primary does not diverge.
        case 'diverging': return array(array(0,_pnb_heat_rotate_hue($primary,180)), array(0.5,$surface), array(1,$primary));
        case 'warm':      return array(array(0,$surface), array(1,_pnb_heat_rotate_hue($primary,35)));
        case 'cool':      return array(array(0,$surface), array(1,_pnb_heat_rotate_hue($primary,-35)));
        default:          return array(array(0,$surface), array(1,$primary));
    }
}

function pnb_heat_sample($ramp, $t) {
    // NaN/INF fails to the FLOOR, never the last stop - see the JS twin.
    if (!is_finite($t)) return $ramp[0][1];
    if ($t <= $ramp[0][0]) return $ramp[0][1];
    for ($i = 1; $i < count($ramp); $i++) {
        if ($t <= $ramp[$i][0]) {
            $lo = $ramp[$i-1]; $hi = $ramp[$i];
            $span = $hi[0] - $lo[0];
            $k = $span <= 0 ? 0 : ($t - $lo[0]) / $span;
            $a = _pnb_heat_rgb_to_oklab($lo[1]); $b = _pnb_heat_rgb_to_oklab($hi[1]);
            return _pnb_heat_oklab_to_rgb(array(
                $a[0] + ($b[0]-$a[0]) * $k,
                $a[1] + ($b[1]-$a[1]) * $k,
                $a[2] + ($b[2]-$a[2]) * $k
            ));
        }
    }
    return $ramp[count($ramp)-1][1];
}

function _pnb_heat_rel_lum($rgb) {
    $f = function ($c) {
        $c = $c / 255;
        return $c <= 0.03928 ? $c / 12.92 : pow(($c + 0.055) / 1.055, 2.4);
    };
    return 0.2126 * $f($rgb[0]) + 0.7152 * $f($rgb[1]) + 0.0722 * $f($rgb[2]);
}

function pnb_heat_contrast($a, $b) {
    $l1 = _pnb_heat_rel_lum($a); $l2 = _pnb_heat_rel_lum($b);
    return (max($l1,$l2) + 0.05) / (min($l1,$l2) + 0.05);
}

function pnb_heat_readable_on($fill, $themeName = null) {
    $main = pnb_heat_parse_color(pnb_heat_theme_var('text-main', '#222222', $themeName));
    if (!$main) $main = array(34,34,34);
    if (pnb_heat_contrast($fill, $main) >= 4.5) return null;
    $white = array(255,255,255); $black = array(0,0,0);
    return pnb_heat_contrast($fill,$white) >= pnb_heat_contrast($fill,$black) ? $white : $black;
}

function pnb_heat_num_from($txt) {
    if ($txt === null) return null;
    $s = trim((string)$txt);
    if ($s === '') return null;
    $neg = false;
    if (preg_match('/^\(.*\)$/', $s)) { $neg = true; $s = trim(substr($s, 1, -1)); }
    $s = preg_replace('/[,\s]/', '', $s);
    $s = preg_replace('/%$/', '', $s);
    if ($s === '') return null;
    // The minus can sit on EITHER side of the currency symbol - "-$5" and "$-5"
    // both occur - so scan the whole non-numeric prefix for it. Testing only the
    // first character and then stripping the prefix silently ate the sign in
    // "$-5", turning a credit into a charge of equal size.
    preg_match('/^[^\d.]*/', $s, $_lm);
    $lead = $_lm[0];
    if (strpos($lead, '-') !== false) $neg = true;
    $s = substr($s, strlen($lead));
    if (!preg_match('/^(\d+\.?\d*|\.\d+)$/', $s)) return null;
    $n = (float)$s;
    if (!is_finite($n)) return null;
    return $neg ? -$n : $n;
}

function _pnb_heat_percentile($sorted, $p) {
    $n = count($sorted);
    if ($n === 0) return 0;
    $idx = ($p / 100) * ($n - 1);
    $lo = (int)floor($idx); $hi = (int)ceil($idx);
    if ($lo === $hi) return $sorted[$lo];
    return $sorted[$lo] + ($sorted[$hi] - $sorted[$lo]) * ($idx - $lo);
}

function pnb_heat_domain_from($values, $range = null, $mid = null) {
    $nums = array();
    foreach ($values as $v) {
        if (is_numeric($v) && is_finite((float)$v)) $nums[] = (float)$v;
    }
    if (!count($nums)) return null;

    $min = $nums[0]; $max = $nums[0];
    for ($j = 1; $j < count($nums); $j++) {
        if ($nums[$j] < $min) $min = $nums[$j];
        if ($nums[$j] > $max) $max = $nums[$j];
    }

    // range= resolves EACH SIDE independently: number, pN, or empty for auto.
    $txt = $range !== null ? trim((string)$range) : '';
    if (strpos($txt, ':') !== false) {
        $parts = explode(':', $txt);
        $sorted = null;
        $resolve = function ($tok, $fallback) use (&$sorted, $nums) {
            $tok = trim((string)$tok);
            if ($tok === '') return $fallback;
            if (preg_match('/^p([\d.]+)$/i', $tok, $pm)) {
                if ($sorted === null) { $sorted = $nums; sort($sorted); }
                return _pnb_heat_percentile($sorted, (float)$pm[1]);
            }
            return is_numeric($tok) ? (float)$tok : $fallback;
        };
        $min = $resolve(isset($parts[0]) ? $parts[0] : '', $min);
        $max = $resolve(isset($parts[1]) ? $parts[1] : '', $max);
    }
    if ($max < $min) { $t = $min; $min = $max; $max = $t; }

    $dom = array('min' => $min, 'max' => $max, 'mid' => null, 'count' => count($nums), 'sorted' => null);
    if (count($nums) <= 20000) { $sortedAll = $nums; sort($sortedAll); $dom['sorted'] = $sortedAll; }
    if ($mid !== null && (string)$mid !== '' && is_numeric($mid)) $dom['mid'] = (float)$mid;
    return $dom;
}

function _pnb_heat_shape($t, $curve) {
    if ($curve === 'sqrt') return sqrt($t);
    if ($curve === 'log') { $k = 99; return log(1 + $t * $k) / log(1 + $k); }
    return $t;
}

function _pnb_heat_rank_t($sorted, $v) {
    $n = count($sorted);
    if (!$n) return null;
    $lo = 0; $hi = $n;
    while ($lo < $hi) { $m = (int)(($lo + $hi) >> 1); if ($sorted[$m] < $v) $lo = $m + 1; else $hi = $m; }
    $first = $lo; $hi = $n; $lo2 = $first;
    while ($lo2 < $hi) { $m2 = (int)(($lo2 + $hi) >> 1); if ($sorted[$m2] <= $v) $lo2 = $m2 + 1; else $hi = $m2; }
    $pos = ($first + $lo2 - 1) / 2;
    return $n <= 1 ? 0.5 : $pos / ($n - 1);
}

function pnb_heat_css_for($value, $domain, $opts, $themeName = null) {
    if (!is_numeric($value) || !is_finite((float)$value)) return '';
    $v = (float)$value;
    $curve = isset($opts['curve']) && $opts['curve'] !== '' ? $opts['curve'] : 'linear';
    $bins  = isset($opts['bins']) ? (int)$opts['bins'] : 0;
    $wantText = !isset($opts['text']) || $opts['text'] !== 'keep';
    $min = $domain['min']; $max = $domain['max']; $mid = $domain['mid'];
    $span = $max - $min;

    if ($curve === 'rank' && $mid === null) {
        $rt = $domain['sorted'] === null ? null : _pnb_heat_rank_t($domain['sorted'], $v);
        $t = $rt === null ? 0.5 : $rt;
    } else if ($mid !== null) {
        $reach = max(abs($max - $mid), abs($mid - $min));
        if ($reach <= 0) {
            $t = 0.5;
        } else {
            $d = ($v - $mid) / $reach;
            $s = _pnb_heat_shape(min(1, abs($d)), $curve);
            $t = 0.5 + ($d < 0 ? -$s : $s) / 2;
        }
    } else {
        // CLAMP BEFORE SHAPING - an explicit range= can leave values outside the
        // domain, and log/sqrt of a negative is NaN. See the JS twin's note.
        $raw = $span <= 0 ? 0.5 : ($v - $min) / $span;
        $t = _pnb_heat_shape(max(0, min(1, $raw)), $curve);
    }
    if (!is_finite($t)) $t = 0;
    $t = max(0, min(1, $t));
    if ($bins > 1) $t = _pnb_heat_jsround($t * ($bins - 1)) / ($bins - 1);

    $ramp = pnb_heat_build_ramp(isset($opts['ramp']) && $opts['ramp'] !== '' ? $opts['ramp'] : 'brand', $themeName);
    $fill = pnb_heat_sample($ramp, $t);
    $css = 'background-color:' . pnb_heat_to_hex($fill);
    if ($wantText) {
        $fg = pnb_heat_readable_on($fill, $themeName);
        if ($fg) $css .= ';color:' . pnb_heat_to_hex($fg);
    }
    return $css;
}

function pnb_heat_parse_args($args) {
    if (!is_array($args) || !count($args)) return null;
    $target = strtolower(trim((string)$args[0]));
    if ($target !== 'cell' && $target !== 'row' && $target !== 'pivot') return null;

    $valid = array(
        'scale' => array('col','row','shared','grid'),
        'scope' => array('filtered','all','page'),
        'ramp'  => array('brand','warm','cool','diverging','mono'),
        'curve' => array('linear','sqrt','log','rank'),
        'text'  => array('auto','keep')
    );
    $rule = array(
        'type' => 'heat', 'target' => $target, 'columns' => array(),
        'scale' => $target === 'pivot' ? 'grid' : 'col',
        'scope' => 'filtered', 'ramp' => 'brand', 'curve' => 'linear',
        'range' => null, 'mid' => null, 'bins' => 0, 'text' => 'auto',
        // parity with the format() rule shape so the shared plumbing does not choke
        'condition' => null, 'style' => '', 'targetColumn' => null
    );

    $sawColumns = false;
    for ($i = 1; $i < count($args); $i++) {
        $raw = trim((string)$args[$i]);
        if ($raw === '') continue;
        $eq = strpos($raw, '=');
        if ($eq !== false && $eq > 0) {
            $k = strtolower(trim(substr($raw, 0, $eq)));
            $v = trim(substr($raw, $eq + 1));
            if (isset($valid[$k])) {
                $lv = strtolower($v);
                if (in_array($lv, $valid[$k], true)) $rule[$k] = $lv;
            } else if ($k === 'range') {
                $rule['range'] = $v;
            } else if ($k === 'mid') {
                $rule['mid'] = $v;
            } else if ($k === 'bins') {
                $b = (int)$v;
                if ($b > 1) $rule['bins'] = $b;
            }
            continue;
        }
        if (!$sawColumns) {
            $sawColumns = true;
            $cols = array();
            foreach (explode('|', $raw) as $c) {
                $c = strtoupper(trim($c));
                if ($c !== '') $cols[] = $c;
            }
            $rule['columns'] = $cols;
        }
    }

    if ($target === 'pivot' && $rule['scale'] === 'shared') $rule['scale'] = 'grid';
    if ($target !== 'pivot' && $rule['scale'] === 'grid')   $rule['scale'] = 'col';
    if ($target === 'row') $rule['scale'] = 'col';
    if ($target !== 'pivot' && !count($rule['columns'])) return null;

    return $rule;
}

function parse_heatmap_rules($snippetText) {
    if (!$snippetText || !trim($snippetText)) return array();
    $text = preg_replace('/\/\*[\s\S]*?\*\//', '', $snippetText);
    $text = preg_replace_callback(
        '/(\'[^\']*\'|"[^"]*"|\/\/[^\/\n]*\/\/)|\/\/.*$/m',
        function($m) { return isset($m[1]) && $m[1] !== "" ? $m[1] : ""; },
        $text
    );
    $text = preg_replace('/`[^`]+`/', '', $text);

    $rules = array();
    $name = 'heatmap';
    $nameLen = strlen($name);      // 7 - NOT the 6 that parse_format_rules hardcodes
    $findFrom = 0;

    while (true) {
        $lower = strtolower($text);
        $start = _snippet_find_call($lower, $name, $findFrom);
        if ($start === false) break;
        if (!isset($text[$start + $nameLen]) || $text[$start + $nameLen] !== '(') {
            $findFrom = $start + $nameLen;
            continue;
        }
        $openParen = $start + $nameLen;

        $depth = 1; $inQ = false; $qCh = ''; $end = -1;
        for ($i = $openParen + 1; $i < strlen($text); $i++) {
            $c = $text[$i];
            if ($inQ) { if ($c === $qCh) $inQ = false; continue; }
            if ($c === '"' || $c === "'") { $inQ = true; $qCh = $c; continue; }
            if ($c === '(') $depth++;
            if ($c === ')') $depth--;
            if ($depth === 0) { $end = $i; break; }
        }
        if ($end === -1) break;

        $argsStr = substr($text, $openParen + 1, $end - $openParen - 1);
        $rule = pnb_heat_parse_args(parse_format_args($argsStr));
        if ($rule !== null) $rules[] = $rule;

        $text = substr($text, 0, $start) . substr($text, $end + 1);
        $findFrom = 0;
    }
    return $rules;
}

function parse_format_rules($snippetText) {
    if (!$snippetText || !trim($snippetText)) return array();

    // Strip block comments
    $text = preg_replace('/\/\*[\s\S]*?\*\//', '', $snippetText);
    // Strip // line comments (but preserve quoted strings and //exact// patterns)
    $text = preg_replace_callback(
        '/(\'[^\']*\'|"[^"]*"|\/\/[^\/\n]*\/\/)|\/\/.*$/m',
        function($m) { return isset($m[1]) && $m[1] !== "" ? $m[1] : ""; },
        $text
    );
    // Remove backtick-delimited strings
    $text = preg_replace('/`[^`]+`/', '', $text);

    $rules = array();

    $findFrom = 0;
    while (true) {
        $lower = strtolower($text);
        // Word-boundary scan: a bare strpos() matches inside date_format() too.
        $start = _snippet_find_call($lower, 'format', $findFrom);
        if ($start === false) break;

        // Adjacency: the '(' must immediately follow the name, matching engine
        // A's extractor and _snippet_remove_balanced_call. Binding to a paren
        // at any distance made prose like 'format (PDF list)' yield a bogus
        // rule that the browser does not extract.
        if (!isset($text[$start + 6]) || $text[$start + 6] !== '(') {
            $findFrom = $start + 6;
            continue;
        }
        $openParen = $start + 6;

        // Find matching close paren
        $depth = 1;
        $inQ = false;
        $qCh = '';
        $end = -1;
        for ($i = $openParen + 1; $i < strlen($text); $i++) {
            $c = $text[$i];
            if ($inQ) {
                if ($c === $qCh) $inQ = false;
                continue;
            }
            if ($c === '"' || $c === "'") { $inQ = true; $qCh = $c; continue; }
            if ($c === '(') $depth++;
            if ($c === ')') $depth--;
            if ($depth === 0) { $end = $i; break; }
        }
        if ($end === -1) break;

        $argsStr = substr($text, $openParen + 1, $end - $openParen - 1);
        $cleanArgs = parse_format_args($argsStr);
        $argCount = count($cleanArgs);

        if ($argCount > 0) {
            $type = strtolower($cleanArgs[0]);
            $rule = null;

            if ($type === 'row' && $argCount === 3) {
                $rule = array('type' => 'row', 'condition' => $cleanArgs[1], 'style' => $cleanArgs[2], 'targetColumn' => null);
            } else if ($type === 'cell' && $argCount === 3) {
                $rule = array('type' => 'cell', 'targetColumn' => strtoupper($cleanArgs[1]), 'condition' => null, 'style' => $cleanArgs[2]);
            } else if ($type === 'cell' && $argCount === 4) {
                $rule = array('type' => 'cell', 'targetColumn' => strtoupper($cleanArgs[1]), 'condition' => $cleanArgs[2], 'style' => $cleanArgs[3]);
            } else if ($type === 'header' && $argCount === 3) {
                $rule = array('type' => 'header', 'targetColumn' => strtoupper($cleanArgs[1]), 'condition' => null, 'style' => $cleanArgs[2]);
            } else if ($type === 'header' && $argCount === 4) {
                $rule = array('type' => 'header', 'targetColumn' => strtoupper($cleanArgs[1]), 'condition' => $cleanArgs[2], 'style' => $cleanArgs[3]);
            }

            if ($rule !== null) $rules[] = $rule;
        }

        $text = substr($text, 0, $start) . substr($text, $end + 1);
        $findFrom = 0; // text shifted - rescan from the top
    }

    // heatmap() rules join the SAME array with type 'heat' - the browser does
    // exactly this (both are pushed into conditionalFormattingRules), and it is
    // what lets heatmap reach the renderers through the $formatRules parameter
    // they already take, with no change to any of the eight call sites.
    // Parsed from the ORIGINAL text: the loop above has been consuming $text.
    foreach (parse_heatmap_rules($snippetText) as $_heatRule) {
        $rules[] = $_heatRule;
    }

    return $rules;
}

function penumbra_resolve_css_vars($cssVal, $themeName = null) {
    if (strpos($cssVal, 'var(') === false) return $cssVal;
    if ($themeName === null) {
        $themeName = isset($GLOBALS['current_email_theme']) ? $GLOBALS['current_email_theme'] : 'theme-default';
    }
    $themes = penumbra_get_themes();
    $vars = isset($themes[$themeName]['vars']) ? $themes[$themeName]['vars'] : array();
    $defaultVars = isset($themes['theme-default']['vars']) ? $themes['theme-default']['vars'] : array();

    $prev = null;
    $guard = 0;
    while ($prev !== $cssVal && $guard < 6) {
        $prev = $cssVal;
        $cssVal = preg_replace_callback(
            '/var\(\s*--([a-zA-Z0-9-]+)\s*(?:,\s*([^()]*))?\)/',
            function ($m) use ($vars, $defaultVars) {
                $name = $m[1];
                $fallback = isset($m[2]) ? trim($m[2]) : '';
                if (isset($vars[$name]) && $vars[$name] !== '') return $vars[$name];
                if ($fallback !== '') return $fallback;
                if (isset($defaultVars[$name]) && $defaultVars[$name] !== '') return $defaultVars[$name];
                return '';
            },
            $cssVal
        );
        $guard++;
    }
    return $cssVal;
}

function parse_css_properties($cssStr, $allowed = null) {
    $result = array();
    $parts = explode(';', $cssStr);
    foreach ($parts as $part) {
        $kv = explode(':', $part, 2);
        if (count($kv) === 2) {
            $prop = strtolower(trim($kv[0]));
            $val = trim($kv[1]);
            // Resolve theme var() refs to concrete colors -- mail clients can't (see
            // penumbra_resolve_css_vars). Cheap no-op when the value has no var().
            $val = penumbra_resolve_css_vars($val);
            if ($prop !== '' && $val !== '') {
                if ($allowed === null || in_array($prop, $allowed)) {
                    $result[$prop] = $val;
                }
            }
        }
    }
    return $result;
}

function parse_format_condition($conditionStr, $columns) {
    if (!$conditionStr || !trim($conditionStr)) return array();

    // Build column lookup (uppercase => original)
    $colMap = array();
    foreach ($columns as $c) $colMap[strtoupper($c)] = $c;
    $colKeys = array_keys($colMap);
    usort($colKeys, function($a, $b) { return strlen($b) - strlen($a); });

    // Operator map
    $opMap = array(
        '>=' => '>=', '=>' => '>=', '<=' => '<=', '=<' => '<=',
        '!=' => '!=', '<>' => '!=', '!/' => '!/',
        '==' => '=', '=' => '=', 'eq' => '=', 'ne' => '!=',
        '>' => '>', 'gt' => '>', '<' => '<', 'lt' => '<',
    );
    $opKeys = array_keys($opMap);
    usort($opKeys, function($a, $b) { return strlen($b) - strlen($a); });

    // Pad operators with spaces (protect quoted/regex regions)
    $padded = preg_replace_callback(
        '#(//.*?//|!?/(?:\\\\/|[^/])+/[iI]?|"[^"]*"|\'[^\']*\')|(>=|<=|<>|!=|==|>|<|=)#',
        function($m) { return (isset($m[1]) && $m[1] !== "") ? $m[1] : " " . $m[2] . " "; },
        $conditionStr
    );

    // Tokenize
    preg_match_all('#\{[^}]+\}|//.*?//|!?/.*?/[iI]?|"[^"]+"|\'[^\']+\'|\S+#', $padded, $matches);
    $tokens = isset($matches[0]) ? $matches[0] : array();

    // Allow an UNQUOTED month-name + year as one date value after a comparison
    // operator (HIRE_DATE >= Feb 2025), mirroring the client parseAdvancedQuery
    // and this file's SEARCH-parser twin (php_parse_search_query) - the
    // tokenizer split the pair on the space, so _cf_parse_date otherwise saw
    // 'Feb' alone and the condition never matched.
    $_fcMonthTok = '/^(?:jan|january|feb|february|mar|march|apr|april|may|jun|june|jul|july|aug|august|sep|september|oct|october|nov|november|dec|december)$/i';
    $_fcYearTok  = '/^\d{4}$/';
    for ($fcMi = 0; $fcMi + 2 < count($tokens); $fcMi++) {
        $fcIsOp = false;
        foreach ($opKeys as $ok) { if ($ok === $tokens[$fcMi]) { $fcIsOp = true; break; } }
        if (!$fcIsOp) continue;
        $fcA = $tokens[$fcMi + 1]; $fcB = $tokens[$fcMi + 2];
        if ((preg_match($_fcMonthTok, $fcA) && preg_match($_fcYearTok, $fcB)) ||
            (preg_match($_fcYearTok, $fcA) && preg_match($_fcMonthTok, $fcB))) {
            array_splice($tokens, $fcMi + 1, 2, array($fcA . ' ' . $fcB));
        }
    }

    $i = 0;
    $count = count($tokens);
    $tree = array();

    while ($i < $count) {
        $condition = null;
        $slice = array_slice($tokens, $i);
        $t0 = $slice[0];
        $t1 = isset($slice[1]) ? $slice[1] : null;
        $t2 = isset($slice[2]) ? $slice[2] : null;
        $parsed = false;

        // Find operator match for t1
        $foundOp = null;
        if ($t1 !== null) {
            foreach ($opKeys as $ok) {
                if ($ok === $t1) { $foundOp = $ok; break; }
            }
        }

        // 1. {COLUMN} syntax
        if (!$parsed && substr($t0, 0, 1) === '{' && substr($t0, -1) === '}') {
            $colName = strtoupper(preg_replace('/^\{[\'"]?|[\'"]?\}$/', '', $t0));
            if ($foundOp !== null && $t2 !== null) {
                $condition = array('type' => 'condition', 'column' => $colName, 'op' => $opMap[$foundOp], 'value' => $t2);
                $i += 3;
                $parsed = true;
            } else if ($t1 !== null) {
                // 2-token fallback: {COLUMN} VALUE → implicit contains
                $condition = array('type' => 'condition', 'column' => $colName, 'op' => 'contains', 'value' => $t1);
                $i += 2;
                $parsed = true;
            }
        }

        // 1b. Quoted column names
        if (!$parsed) {
            $fc = substr($t0, 0, 1);
            $lc = substr($t0, -1);
            if (($fc === "'" && $lc === "'") || ($fc === '"' && $lc === '"')) {
                $unq = strtoupper(substr($t0, 1, -1));
                if (isset($colMap[$unq])) {
                    if ($foundOp !== null && $t2 !== null) {
                        $condition = array('type' => 'condition', 'column' => $colMap[$unq], 'op' => $opMap[$foundOp], 'value' => $t2);
                        $i += 3;
                        $parsed = true;
                    } else if ($t1 !== null) {
                        $condition = array('type' => 'condition', 'column' => $colMap[$unq], 'op' => 'contains', 'value' => $t1);
                        $i += 2;
                        $parsed = true;
                    }
                }
            }
        }

        // 1c. # row number
        if (!$parsed && $t0 === '#') {
            if ($foundOp !== null && $t2 !== null) {
                $condition = array('type' => 'condition', 'column' => '#', 'op' => $opMap[$foundOp], 'value' => $t2);
                $i += 3;
                $parsed = true;
            } else if ($t1 !== null) {
                $condition = array('type' => 'condition', 'column' => '#', 'op' => '=', 'value' => $t1);
                $i += 2;
                $parsed = true;
            }
        }

        // 2. Multi-word column detection
        if (!$parsed) {
            foreach ($colKeys as $colKey) {
                $words = explode(' ', $colKey);
                $wc = count($words);
                if (count($slice) < $wc) continue;

                $match = true;
                for ($j = 0; $j < $wc; $j++) {
                    $ct = preg_replace('/^[\'"]|[\'"]$/', '', $slice[$j]);
                    if (strtoupper($ct) !== $words[$j]) { $match = false; break; }
                }

                if ($match) {
                    $opTok = isset($slice[$wc]) ? $slice[$wc] : null;
                    $valTok = isset($slice[$wc + 1]) ? $slice[$wc + 1] : null;

                    $matchedOp = null;
                    if ($opTok !== null) {
                        foreach ($opKeys as $ok) {
                            if ($ok === $opTok) { $matchedOp = $ok; break; }
                        }
                    }

                    if ($matchedOp !== null && $valTok !== null) {
                        $condition = array('type' => 'condition', 'column' => $colMap[$colKey], 'op' => $opMap[$matchedOp], 'value' => $valTok);
                        $i += $wc + 2;
                        $parsed = true;
                        break;
                    } else if ($opTok !== null) {
                        $condition = array('type' => 'condition', 'column' => $colMap[$colKey], 'op' => 'contains', 'value' => $opTok);
                        $i += $wc + 1;
                        $parsed = true;
                        break;
                    }
                }
            }
        }

        // 3. Fallback
        if (!$parsed) {
            $t0IsOp = null;
            foreach ($opKeys as $ok) {
                if ($ok === $t0) { $t0IsOp = $ok; break; }
            }

            $fallbackOp = null;
            if ($t1 !== null) {
                foreach ($opKeys as $ok) {
                    if ($ok === $t1) { $fallbackOp = $ok; break; }
                }
            }

            if ($t0IsOp === null && $fallbackOp !== null && $t2 !== null) {
                // Literal comparison: val1 op val2
                $condition = array('type' => 'literal', 'leftValue' => $t0, 'op' => $opMap[$fallbackOp], 'value' => $t2);
                $i += 3;
            } else if ($t0IsOp !== null && $t1 !== null) {
                // Global operator+value: > 100
                $condition = array('type' => 'global', 'op' => $opMap[$t0IsOp], 'value' => $t1);
                $i += 2;
            } else {
                // Bare word: global contains
                $condition = array('type' => 'global', 'op' => 'contains', 'value' => $t0);
                $i += 1;
            }
        }

        // Push condition
        if ($condition !== null && isset($condition['value']) && trim($condition['value']) !== '') {
            $tree[] = $condition;
        }

        // Logical connector
        if ($i < $count) {
            $next = strtolower($tokens[$i]);
            if ($next === 'and' || $next === 'or') {
                $tree[] = array('type' => 'logical', 'op' => $next);
                $i++;
            } else if (count($tree) > 0) {
                $last = $tree[count($tree) - 1];
                if ($last['type'] !== 'logical') {
                    $tree[] = array('type' => 'logical', 'op' => 'and');
                }
            }
        }
    }

    return $tree;
}

function _cf_get_cell_value($colName, $rowDataUpper) {
    $key = strtoupper(preg_replace('/^\{[\'"]?|[\'"]?\}$/', '', (string)$colName));
    $raw = isset($rowDataUpper[$key]) ? $rowDataUpper[$key] : '';
    $val = (string)$raw;
    if (strpos($val, '@@HTML') === 0) $val = substr($val, 6);
    if (strpos($val, '@@JSON') === 0) $val = substr($val, 6);
    $val = strip_tags($val);
    $val = html_entity_decode($val, ENT_QUOTES, 'UTF-8');
    return trim($val);
}

function _cf_parse_num($str) {
    $s = trim(str_replace("\x02", '', (string)$str));
    if (preg_match('/^\([\d,.\$%]+\)$/', $s)) {
        $s = '-' . trim($s, '()');
    }
    $s = preg_replace('/[\$,%]/', '', $s);
    if (!is_numeric($s)) return false;
    return (float)$s;
}

function _cf_is_numeric_str($str) {
    return (bool)preg_match('/^[-+]?\$?(\d{1,3}(,\d{3})*|\d+)(\.\d+)?%?$/', str_replace("\x02", '', (string)$str));
}

function _sr_resolve_keyword_date($raw) {
    $trimVal = trim((string)$raw);
    if ($trimVal === '') return null;
    if (preg_match('/^(?:SYSDATE|NOW|TODAY)(?:\(\))?\s*([+-]\s*\d+)?$/i', $trimVal, $dateMatch)) {
        $dateOffset = isset($dateMatch[1]) ? (int)str_replace(' ', '', $dateMatch[1]) : 0;
        return strtoupper(date('d-M-y', strtotime("{$dateOffset} days")));
    }
    return null;
}

function _sr_resolve_relative_date($raw) {
    $trimVal = trim((string)$raw);
    if ($trimVal === '') return null;

    // 1. Strict keywords (TODAY, SYSDATE-7, NOW+1)
    $kw = _sr_resolve_keyword_date($trimVal);
    if ($kw !== null) return $kw;

    // 1b. Fiscal year (NC State: FY runs Jul 1 -> Jun 30, labeled by the calendar
    // year it ENDS). Optional "first|last day of" + a FY reference; with the
    // prefix returns the start/end date, without it the FY number. strtotime has
    // no fiscal concept, so this must run before the natural-language fallback.
    if (preg_match('/^(?:(first|last)\s+day\s+of\s+)?(?:(this|last|next)\s+|(\d+)\s+)?fiscal\s+years?(?:\s+(ago|from\s+now|ahead))?$/i', $trimVal, $fy)) {
        $FY_START_MONTH = 7; // July
        $curY  = (int)date('Y');
        $curMo = (int)date('n');
        $curFYStartYear = ($curMo >= $FY_START_MONTH) ? $curY : $curY - 1;
        $fyRel = 0;
        if (!empty($fy[2])) {
            $fyRel = (strtolower($fy[2]) === 'last') ? -1 : ((strtolower($fy[2]) === 'next') ? 1 : 0);
        } elseif (!empty($fy[3])) {
            $fyN  = (int)$fy[3];
            $fyDir = isset($fy[4]) ? strtolower(trim($fy[4])) : 'ago';
            $fyRel = ($fyDir !== '' && $fyDir !== 'ago') ? $fyN : -$fyN;
        }
        $fyStartYear = $curFYStartYear + $fyRel;
        $fyMode = isset($fy[1]) ? strtolower($fy[1]) : '';
        if ($fyMode === 'first') {
            return strtoupper(date('d-M-y', mktime(0, 0, 0, $FY_START_MONTH, 1, $fyStartYear)));
        } elseif ($fyMode === 'last') {
            return strtoupper(date('d-M-y', mktime(0, 0, 0, $FY_START_MONTH, 0, $fyStartYear + 1)));
        }
        return (string)($fyStartYear + 1);
    }

    // 2. Natural language. Only apply if it is NOT already a hardcoded DD-MON-YY
    // date and NOT a plain number.
    // CRITICAL: do NOT blanket-strtotime every remaining value - a bare word like
    // "MAY"/"FRIDAY" or a surname "May"/"Day" is a legitimate TEXT value that
    // strtotime would silently turn into a date. Only coerce a recognised
    // relative phrase or a value that carries a digit.
    if (!preg_match('/^\d{1,2}-[a-zA-Z]{3}-(\d{2}|\d{4})$/', $trimVal) && !is_numeric($trimVal)) {
        $isRelativeDatePhrase =
               preg_match('/^(?:yesterday|tomorrow)$/i', $trimVal)
            || preg_match('/^(?:first|last)\s+day\s+of\s+(?:last|this|next)\s+(?:month|year|quarter)$/i', $trimVal)
            || preg_match('/^(?:last|next)\s+(?:sunday|monday|tuesday|wednesday|thursday|friday|saturday)$/i', $trimVal);
        if ($isRelativeDatePhrase || preg_match('/\d/', $trimVal)) {
            // Year/quarter boundaries computed explicitly - strtotime's
            // 'first day of last year' is month arithmetic and 'quarter' is not
            // a relunit at all (the client resolves these via moment startOf/endOf).
            if (preg_match('/^(first|last)\s+day\s+of\s+(last|this|next)\s+(year|quarter)$/i', $trimVal, $fl)) {
                $flEdge = strtolower($fl[1]);
                $flShift = (strtolower($fl[2]) === 'last') ? -1 : ((strtolower($fl[2]) === 'next') ? 1 : 0);
                $flY = (int)date('Y');
                if (strtolower($fl[3]) === 'year') {
                    $flY += $flShift;
                    $flTs = ($flEdge === 'first') ? mktime(0, 0, 0, 1, 1, $flY) : mktime(0, 0, 0, 12, 31, $flY);
                } else {
                    $flQ = (int)(floor(((int)date('n') - 1) / 3) * 3 + 1) + $flShift * 3;
                    if ($flQ < 1) { $flQ += 12; $flY -= 1; }
                    if ($flQ > 12) { $flQ -= 12; $flY += 1; }
                    $flTs = ($flEdge === 'first') ? mktime(0, 0, 0, $flQ, 1, $flY) : mktime(0, 0, 0, $flQ + 3, 0, $flY);
                }
                return strtoupper(date('d-M-y', $flTs));
            }
            // Normalize: strip a trailing "from today"/"from now"
            // (e.g. "3 years ago from today" -> "3 years ago")
            $strtotimeVal = preg_replace('/\s+from\s+(?:today|now)\s*$/i', '', $trimVal);
            $ts = strtotime($strtotimeVal);
            if ($ts !== false) {
                return strtoupper(date('d-M-y', $ts));
            }
        }
    }

    return null;
}

function _cf_parse_date($str) {
    static $cache = array();

    // \x02 guards (nested now()/date_format()/data() values) would trip the
    // first-char fast-reject below - strip before parsing.
    $s = trim(str_replace("\x02", '', (string)$str));
    if ($s === '') return false;
    if (array_key_exists($s, $cache)) return $cache[$s];

    // Fast reject: supported formats start with a digit OR a month name
    // ("Feb 2025" / "February 2025"). Matches JS _couldBeDate. Words that start
    // with a month prefix ("Marketing", "Junior") pass this gate but fail the
    // format loop below.
    if (($s[0] < '0' || $s[0] > '9') && !preg_match('/^(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)/i', $s)) {
        if (count($cache) < 5000) $cache[$s] = false;
        return false;
    }

    // Oracle timestamp "DD-MMM-YY HH:MI:SS..." -> keep just the DD-MMM-YY part.
    $probe = $s;
    if (preg_match('/^\d{2}-[A-Za-z]{3}-\d{2}\s/', $probe)) {
        $probe = substr($probe, 0, 9);
    }

    // Same format list / priority order as the browser.
    static $formats = array(
        array('Y-m-d H:i:s.u', 'second'),
        array('Y-m-d H:i:s',   'second'),
        array('m/d/Y', 'day'),
        array('n/j/Y', 'day'),
        array('Y-m-d', 'day'),
        array('Y-n-j', 'day'),
        array('d-M-y', 'day'),
        array('j-M-y', 'day'),
        array('m/Y', 'month'),
        // Month + year variants (month granularity), mirroring js/main.js. Y-m-d /
        // Y-n-j above win for full dates: createFromFormat flags the trailing data
        // ("2022-05-15" vs 'Y-m') as a warning, which the getLastErrors() check
        // below rejects. PHP's F/M month tokens are case-insensitive and accept
        // abbreviations. Bare month ("Feb", "05") stays unsupported (ambiguous).
        array('Y-m', 'month'),
        array('F Y', 'month'),
        array('M Y', 'month'),
        array('Y F', 'month'),
        array('Y M', 'month'),
        array('Y', 'year'),
    );

    $result = false;
    foreach ($formats as $f) {
        // moment's strict YYYY matches EXACTLY 4 digits; PHP's 'Y' would otherwise
        // accept "05" (year 5) or "199". Keep parity with the browser - only treat a
        // bare number as a year when it is 4 digits.
        if ($f[0] === 'Y' && !preg_match('/^\d{4}$/', $probe)) continue;
        $dt = DateTime::createFromFormat('!' . $f[0], $probe);
        if ($dt === false) continue;
        // Reject loose matches (trailing data / impossible dates). PHP 8.2's
        // getLastErrors() returns false when the parse was completely clean.
        $errs = DateTime::getLastErrors();
        if ($errs !== false && (((int)$errs['warning_count'] > 0) || ((int)$errs['error_count'] > 0))) {
            continue;
        }
        // moment pivots 2-digit years 00-68 => 2000s, 69-99 => 1900s; PHP's 'y'
        // pivots at 69/70. Only the year "69" differs - correct it so
        // "15-JAN-69" means 1969 here like it does in the browser and in
        // _penumbra_summary_parse_date.
        if (strpos($f[0], 'y') !== false && (int)$dt->format('Y') === 2069) {
            $dt->modify('-100 years');
        }
        $result = array('ts' => $dt->getTimestamp(), 'gran' => $f[1]);
        break;
    }

    if (count($cache) >= 5000) $cache = array();
    $cache[$s] = $result;
    return $result;
}

function _cf_date_floor($ts, $gran) {
    switch ($gran) {
        case 'second': return $ts;
        case 'month':  return mktime(0, 0, 0, (int)date('n', $ts), 1, (int)date('Y', $ts));
        case 'year':   return mktime(0, 0, 0, 1, 1, (int)date('Y', $ts));
        case 'day':
        default:       return mktime(0, 0, 0, (int)date('n', $ts), (int)date('j', $ts), (int)date('Y', $ts));
    }
}

function _cf_test_condition($op, $searchValue, $cellText, $rowDataUpper) {
    // Strip \x02 number-guards first: a condition value produced by a nested
    // now()/round()/data() call arrives guarded, and every branch below (date,
    // numeric, text equality/contains) must see the real text.
    $compareValue = trim(preg_replace('/^[\'"]|[\'"]$/', '', str_replace("\x02", '', (string)$searchValue)));

    // Resolve {COLUMN} placeholder
    if (preg_match('/^\{([^}]+)\}$/', $compareValue, $ph)) {
        $compareValue = _cf_get_cell_value($ph[1], $rowDataUpper);
    }

    // "empty" keyword
    if (strtolower($compareValue) === 'empty') {
        return ($op === '=') ? ($cellText === '') : ($cellText !== '');
    }

    // Exact-match: //pattern//
    if (substr($compareValue, 0, 2) === '//' && substr($compareValue, -2) === '//') {
        $pattern = preg_quote(substr($compareValue, 2, -2), '/');
        $m = @preg_match('/^' . $pattern . '$/i', $cellText);
        return ($op === '!=' || $op === '<>') ? !$m : (bool)$m;
    }

    // Regex: /pattern/ or /pattern/i or !/
    if ($op === '!/' || (substr($compareValue, 0, 1) === '/' && strlen($compareValue) > 1)) {
        if ($op === '!/') {
            $pattern = $compareValue;
            $flags = 'i';
        } else {
            $lastSlash = strrpos($compareValue, '/');
            $pattern = substr($compareValue, 1, $lastSlash - 1);
            $flagStr = substr($compareValue, $lastSlash + 1);
            $flags = ($flagStr === 'I') ? '' : 'i';
        }
        $regex = '/' . str_replace('/', '\\/', $pattern) . '/' . $flags;
        $m = @preg_match($regex, $cellText);
        if ($m === false) {
            // Invalid pattern (compile error): the browser returns false for
            // EVERY operator. preg_match returns FALSE here, and !$m on FALSE
            // made negated ops (!=, <>, !/) match every row instead.
            return false;
        }
        return ($op === '!=' || $op === '<>' || $op === '!/') ? !$m : (bool)$m;
    }

    // Range-list check (e.g., "1-5, 10")
    if (_cf_is_numeric_str($cellText) && !_cf_is_numeric_str($compareValue)
        && (strpos($compareValue, ',') !== false || strpos($compareValue, '-') !== false)
        && preg_match('/^[\d,\-.\$%\s]+$/', $compareValue)) {
        $cellNum = _cf_parse_num($cellText);
        if ($cellNum !== false) {
            $items = array_map('trim', explode(',', $compareValue));
            $inRange = false;
            foreach ($items as $item) {
                if (strpos($item, '-') !== false) {
                    $parts = explode('-', $item, 2);
                    $min = _cf_parse_num($parts[0]);
                    $max = _cf_parse_num($parts[1]);
                    if ($min !== false && $max !== false && $cellNum >= $min && $cellNum <= $max) {
                        $inRange = true; break;
                    }
                } else {
                    $sNum = _cf_parse_num($item);
                    if ($sNum !== false && $cellNum == $sNum) {
                        $inRange = true; break;
                    }
                }
            }
            if ($op === '=' || $op === 'contains') return $inRange;
            if ($op === '!=' || $op === '<>') return !$inRange;
        }
    }

    // Numeric comparison
    if (_cf_is_numeric_str($cellText) && _cf_is_numeric_str($compareValue)) {
        $cn = _cf_parse_num($cellText);
        $sn = _cf_parse_num($compareValue);
        if ($cn !== false && $sn !== false) {
            switch ($op) {
                case '=':  return $cn == $sn;
                case '!=': return $cn != $sn;
                case '>':  return $cn > $sn;
                case '<':  return $cn < $sn;
                case '>=': return $cn >= $sn;
                case '<=': return $cn <= $sn;
            }
        }
    }

    // Accounting format fallback
    if (preg_match('/^\([\d,.\$%]+\)$/', $cellText) || preg_match('/^\([\d,.\$%]+\)$/', $compareValue)) {
        $cn = _cf_parse_num($cellText);
        $sn = _cf_parse_num($compareValue);
        if ($cn !== false && $sn !== false) {
            switch ($op) {
                case '=':  return $cn == $sn;
                case '!=': return $cn != $sn;
                case '>':  return $cn > $sn;
                case '<':  return $cn < $sn;
                case '>=': return $cn >= $sn;
                case '<=': return $cn <= $sn;
            }
        }
    }

    // Date comparison. Mirrors the browser's testCondition() (js/main.js
    // ~line 37660): for any operator other than 'contains', if BOTH the search
    // value and the cell parse as dates, compare them at the search value's
    // granularity. Without this, ordering operators (>, <, >=, <=) on date
    // columns fall through to the text branch below -- which only implements
    // contains/=/!= -- so every row evaluates false and date-range count()s
    // return 0 in scheduled emails while working fine in the browser.
    if ($op !== 'contains') {
        // Relative dates on the SEARCH side only (TODAY-30, first day of last
        // month, this fiscal year). The cell side stays strict - a cell that
        // literally reads "yesterday" is data, not an instruction. When the text
        // is not a relative date the resolver returns null and nothing changes,
        // so a non-date column still falls through to the text comparison below
        // with the original value intact.
        $relSearch = _cf_parse_date($compareValue);
        if (!$relSearch) {
            $relResolved = _sr_resolve_keyword_date($compareValue);
            if ($relResolved !== null) $relSearch = _cf_parse_date($relResolved);
        }
        $searchDate = $relSearch;
        if ($searchDate !== false) {
            $cellDate = _cf_parse_date($cellText);
            if ($cellDate !== false) {
                $g  = $searchDate['gran'];
                $cv = _cf_date_floor($cellDate['ts'], $g);
                $sv = _cf_date_floor($searchDate['ts'], $g);
                switch ($op) {
                    case '=':  return $cv === $sv;
                    case '!=': return $cv !== $sv;
                    case '>':  return $cv >  $sv;
                    case '<':  return $cv <  $sv;
                    case '>=': return $cv >= $sv;
                    case '<=': return $cv <= $sv;
                }
            }
        }
    }

    // Text comparison (case-insensitive)
    $lCell = strtolower(trim($cellText));
    $lComp = strtolower(trim($compareValue));

    if ($op === 'contains') return strpos($lCell, $lComp) !== false;
    if ($op === '=' && $lCell === $lComp) return true;
    if ($op === '!=' && $lCell !== $lComp) return true;

    // Slug match for = (ignore punctuation/spaces)
    if ($op === '=') {
        $sCell = preg_replace('/[^a-z0-9]/', '', $lCell);
        $sComp = preg_replace('/[^a-z0-9]/', '', $lComp);
        return $sCell === $sComp;
    }

    return false;
}

function evaluate_format_condition($rowData, $parsedCondition) {
    if (!$parsedCondition || count($parsedCondition) === 0) return true;

    // Build uppercase lookup
    $upper = array();
    foreach ($rowData as $k => $v) $upper[strtoupper($k)] = $v;

    // Evaluate each condition part
    $results = array();
    $ops = array();

    foreach ($parsedCondition as $part) {
        if ($part['type'] === 'logical') {
            $ops[] = $part['op'];
            continue;
        }

        if ($part['type'] === 'literal') {
            $results[] = _cf_test_condition($part['op'], $part['value'], (string)$part['leftValue'], $upper);
        } else if ($part['type'] === 'global') {
            // Global: check all columns
            $isNeg = in_array($part['op'], array('!=', '<>', '!/'));
            if ($isNeg) {
                $posOp = ($part['op'] === '!/') ? 'contains' : '=';
                $anyMatch = false;
                foreach ($upper as $col => $val) {
                    $cv = _cf_get_cell_value($col, $upper);
                    if (_cf_test_condition($posOp, $part['value'], $cv, $upper)) {
                        $anyMatch = true; break;
                    }
                }
                $results[] = !$anyMatch;
            } else {
                $found = false;
                foreach ($upper as $col => $val) {
                    $cv = _cf_get_cell_value($col, $upper);
                    if (_cf_test_condition($part['op'], $part['value'], $cv, $upper)) {
                        $found = true; break;
                    }
                }
                $results[] = $found;
            }
        } else {
            // Column-targeted
            $cv = _cf_get_cell_value($part['column'], $upper);
            $results[] = _cf_test_condition($part['op'], $part['value'], $cv, $upper);
        }
    }

    // AND has higher precedence than OR
    $consumed = array();
    for ($idx = 0; $idx < count($ops); $idx++) {
        if ($ops[$idx] === 'and') {
            if (!array_key_exists($idx + 1, $results)) {
                // Dangling trailing "and" (condition text ended with a logical):
                // PHP 8 warned "Undefined array key" once PER ROW here and the
                // null coerced to false. Keep the false, drop the warning.
                $results[$idx + 1] = false;
            }
            $results[$idx + 1] = ($results[$idx] && $results[$idx + 1]);
            $consumed[$idx] = true;
        }
    }

    // OR remaining
    $remaining = array();
    for ($idx = 0; $idx < count($results); $idx++) {
        if (!isset($consumed[$idx])) $remaining[] = $results[$idx];
    }

    if (count($remaining) === 0) return false;
    foreach ($remaining as $r) {
        if ($r) return true;
    }
    return false;
}

function cf_agg_fn_names() {
    return 'count_filled|count_blank|count|sum|avg|min|max|distinct|median|mode|stddev|range|antimode|wavg|p\d{1,2}';
}

function evaluate_aggregate_condition_php($conditionString, $rows) {
    $cond = trim((string)$conditionString);
    if ($cond === '') return true;
    if (!is_array($rows)) $rows = array();

    $cols = array();
    $first = reset($rows);
    if (is_array($first)) $cols = array_keys($first);
    // Third entry point into the _snippet_* aggregate family - apply the same
    // row/column case normalization the two dispatch entries do (mixed-case
    // SQL aliases otherwise zero out every column aggregate).
    $norm = _snippet_normalize_case($rows, $cols);
    $rows = $norm[0];
    $cols = $norm[1];

    for ($i = 0; $i < 5; $i++) {
        $found = 0;
        $cond = preg_replace_callback('/\b(' . cf_agg_fn_names() . ')\(([^()]*)\)/i',
            function ($m) use (&$found, $rows, $cols) {
                $found++;
                $func = strtolower($m[1]);
                $query = trim(preg_replace('/^\'|\'$/', '', trim($m[2])));
                // Trailing bare ', all|total|unfiltered': the server rowset has
                // no live search filter, so scope == the same rows - strip it.
                $query = preg_replace('/,\s*(all|total|unfiltered)\s*$/i', '', $query);

                $colName = null;
                $condStr = null;
                if ($func === 'count') {
                    $condStr = ($query !== '') ? $query : null;
                } else {
                    $commaPos = strpos($query, ',');
                    if ($commaPos !== false) {
                        $colName = strtoupper(trim(substr($query, 0, $commaPos)));
                        $condStr = trim(substr($query, $commaPos + 1));
                    } else {
                        $colName = strtoupper(trim($query));
                    }
                }

                $data = _snippet_expand_virtual_rows($rows, $colName, $condStr, $cols);
                $filtered = _snippet_filter_rows($data, $cols, $condStr);

                if ($func === 'count') {
                    return (string)count($filtered);
                }
                if ($func === 'distinct') {
                    $seen = array();
                    foreach ($filtered as $row) {
                        if (isset($row[$colName])) $seen[(string)$row[$colName]] = true;
                    }
                    return (string)count($seen);
                }
                // Counting forms read RAW cell text, so they run before the numeric
                // parse below discards non-numeric values. Twin: main.js.
                if ($func === 'count_filled' || $func === 'count_blank') {
                    $filledN = 0;
                    foreach ($filtered as $row) {
                        $rv = isset($row[$colName]) ? trim(_cf_clean_raw_value($row[$colName])) : '';
                        if ($rv !== '') $filledN++;
                    }
                    return (string)(($func === 'count_filled') ? $filledN : (count($filtered) - $filledN));
                }

                $values = array();
                foreach ($filtered as $row) {
                    if (!isset($row[$colName])) continue;
                    $n = _cf_parse_num(_cf_clean_raw_value($row[$colName]));
                    if ($n !== false) $values[] = $n;
                }
                if (count($values) === 0) return '0';

                switch ($func) {
                    case 'sum': return (string)array_sum($values);
                    case 'avg': return (string)(array_sum($values) / count($values));
                    case 'max': return (string)max($values);
                    case 'min': return (string)min($values);
                    case 'median':
                        sort($values);
                        $mid = (int)floor(count($values) / 2);
                        return (string)((count($values) % 2 !== 0)
                            ? $values[$mid]
                            : (($values[$mid - 1] + $values[$mid]) / 2));
                    case 'mode':
                        $freq = array();
                        $best = 'N/A';
                        $bf = 0;
                        foreach ($filtered as $row) {
                            $v = isset($row[$colName]) ? (string)$row[$colName] : '';
                            if (!isset($freq[$v])) $freq[$v] = 0;
                            $freq[$v]++;
                            if ($freq[$v] > $bf) { $bf = $freq[$v]; $best = $v; }
                        }
                        return (string)$best;
                    case 'stddev':
                        return (string)_snippet_stddev_of($values);
                    case 'range':
                        return (string)(max($values) - min($values));
                }

                // Percentiles: pNN defers to the same helper the snippet
                // percentile() uses, so the two can never drift. Twin: main.js.
                if (preg_match('/^p([1-9]\d?)$/', $func, $pm)) {
                    $sortedV = $values;
                    sort($sortedV);
                    return (string)_snippet_percentile_of($sortedV, (int)$pm[1]);
                }

                // Recognized by the detector but not computable here (antimode and
                // wavg need a raw value list / a second weight column). Emit a token
                // the final numeric gate cannot parse, so the condition resolves to
                // FALSE and the rule drops. '0' would have been WORSE than useless:
                // "stddev(X) < 5" would have read as "0 < 5" and come out TRUE.
                return 'NaN';
            }, $cond);
        if ($found === 0) break;
    }

    // Final "<num> <op> <num>" gate - the browser's exact rule, plus leading
    // minus and '==' support (mirrored into main.js the same day; a negative
    // sum()/min() otherwise made the condition silently false in both engines).
    if (!preg_match('/^\s*(-?\d*\.?\d+)\s*([<>=!]+)\s*(-?\d*\.?\d+)\s*$/', $cond, $cm)) {
        return false;
    }
    $L = (float)$cm[1];
    $R = (float)$cm[3];
    switch ($cm[2]) {
        case '=': case '==':  return $L == $R;
        case '!=': case '<>': return $L != $R;
        case '>':             return $L > $R;
        case '<':             return $L < $R;
        case '>=':            return $L >= $R;
        case '<=':            return $L <= $R;
    }
    return false;
}

function prepare_format_rules($formatRules, $columns, $aggRows = null, $themeName = null) {
    $allowedProps = array('color', 'background-color', 'font-weight', 'font-style', 'border',
        'border-left', 'border-right', 'border-top', 'border-bottom',
        'font-family', 'font-size', 'text-decoration', 'text-transform');
    $headerAllowed = array('color', 'background-color', 'font-weight', 'font-style', 'border',
        'border-left', 'border-right', 'border-bottom', 'border-top', 'text-decoration');

    $result = array('header' => array(), 'row' => array(), 'cell' => array(), 'heat' => array());

    foreach ($formatRules as $rule) {
        // ---- heatmap() ----------------------------------------------------
        // A SCALE, not a predicate: its domain has to be measured across every
        // row before any single cell can be coloured, so it is resolved here
        // (where $aggRows is the full rowset) rather than per row below. It
        // carries no 'style' string, so it must never reach parse_css_properties.
        if (isset($rule['type']) && $rule['type'] === 'heat') {
            if ($rule['target'] === 'pivot') continue;      // handled by generate_pivot_html
            if ($aggRows === null || !is_array($aggRows) || !count($aggRows)) continue;

            // Column name -> the row key that actually carries it (case-insensitive).
            $keyFor = array();
            $firstRow = reset($aggRows);
            if (is_array($firstRow)) {
                foreach (array_keys($firstRow) as $k) { $keyFor[strtoupper($k)] = $k; }
            }

            $buckets = array();
            foreach ($aggRows as $r) {
                if (!is_array($r)) continue;
                foreach ($rule['columns'] as $col) {
                    if (!isset($keyFor[$col])) continue;
                    $v = pnb_heat_num_from(_cf_clean_raw_value($r[$keyFor[$col]]));
                    if ($v === null) continue;
                    $bk = $rule['scale'] === 'shared' ? '*' : $col;
                    if (!isset($buckets[$bk])) $buckets[$bk] = array();
                    $buckets[$bk][] = $v;
                }
            }
            $domains = array();
            foreach ($buckets as $bk => $vals) {
                $d = pnb_heat_domain_from($vals, $rule['range'], $rule['mid']);
                if ($d !== null) $domains[$bk] = $d;
            }
            $prepared = $rule;
            $prepared['_domains'] = $domains;
            $prepared['_keyFor']  = $keyFor;
            $prepared['_theme']   = $themeName;
            $result['heat'][] = $prepared;
            continue;
        }

        $prepared = $rule;
        // Aggregate-shaped conditions (sum(X) > N, count(...) >= N, ...) are
        // GLOBAL, not per-row: the browser pre-evaluates them ONCE via
        // evaluateAggregateCondition and applies the cached boolean to every
        // row/cell/header (main.js ~8804). Mirror that here: a true condition
        // becomes unconditional, a false one drops the rule. Same 8-name
        // detector regex as the browser. parse_format_condition would
        // otherwise mis-read the call as a column condition and the rule
        // would silently never fire in emails.
        if (!empty($prepared['condition']) && $aggRows !== null &&
            preg_match('/\b(' . cf_agg_fn_names() . ')\s*\(/i', $prepared['condition'])) {
            if (evaluate_aggregate_condition_php($prepared['condition'], $aggRows)) {
                $prepared['condition'] = null;
            } else {
                continue;
            }
        }
        $prepared['_css'] = parse_css_properties(
            $rule['style'],
            $rule['type'] === 'header' ? $headerAllowed : $allowedProps
        );
        if ($prepared['condition']) {
            $prepared['_parsed'] = parse_format_condition($prepared['condition'], $columns);
            // Rewrite a toggle condition's value to the stored '1'/'0'. The rows here
            // already CARRY the toggle column, so the column resolved fine - only the
            // value did not, which made format(Done = ☑, ...) a silent no-op even
            // though count(Done = ☑) worked. ☑/☐ is exactly what the UI's value
            // autocomplete hands out, so this is the form users actually write.
            $prepared['_parsed'] = _snippet_normalize_toggle_tree($prepared['_parsed'], _snippet_journal_toggles());
        }
        $result[$rule['type']][] = $prepared;
    }

    return $result;
}

function evaluate_row_formatting($row, $rowIndex, $rowRules, $cellRules, $heatRules = array()) {
    // Inject row number for # conditions
    $rowWithIndex = $row;
    $rowWithIndex['#'] = $rowIndex + 1;

    // ---- heatmap() fills, computed FIRST -------------------------------
    // Seeded before the format() rules below so an explicit format(cell, ...)
    // still wins: these arrays are merged prop-by-prop and format overwrites,
    // matching the browser, where the heat style is prepended to the inline
    // style string and the later declaration takes effect.
    $heatCells = array();
    $heatRow = array();
    if (!empty($heatRules)) {
        foreach ($heatRules as $hr) {
            $theme = isset($hr['_theme']) ? $hr['_theme'] : null;
            $keyFor = isset($hr['_keyFor']) ? $hr['_keyFor'] : array();
            foreach ($hr['columns'] as $col) {
                if (!isset($keyFor[$col]) || !array_key_exists($keyFor[$col], $row)) continue;
                $v = pnb_heat_num_from(_cf_clean_raw_value($row[$keyFor[$col]]));
                if ($v === null) continue;

                // scale=row builds its domain from THIS row's named columns, so
                // it cannot be precomputed - each row is its own scale.
                if ($hr['scale'] === 'row') {
                    $rowVals = array();
                    foreach ($hr['columns'] as $c2) {
                        if (!isset($keyFor[$c2]) || !array_key_exists($keyFor[$c2], $row)) continue;
                        $v2 = pnb_heat_num_from(_cf_clean_raw_value($row[$keyFor[$c2]]));
                        if ($v2 !== null) $rowVals[] = $v2;
                    }
                    $dom = pnb_heat_domain_from($rowVals, $hr['range'], $hr['mid']);
                } else {
                    $bk = $hr['scale'] === 'shared' ? '*' : $col;
                    $dom = isset($hr['_domains'][$bk]) ? $hr['_domains'][$bk] : null;
                }
                if ($dom === null) continue;

                $css = pnb_heat_css_for($v, $dom, $hr, $theme);
                if ($css === '') continue;
                $props = parse_css_properties($css, array('background-color', 'color'));
                if (empty($props)) continue;

                if ($hr['target'] === 'row') {
                    foreach ($props as $p => $pv) { $heatRow[$p] = $pv; }
                    break;   // one column drives the whole row
                }
                $cu = strtoupper($keyFor[$col]);
                if (!isset($heatCells[$cu])) $heatCells[$cu] = array();
                foreach ($props as $p => $pv) { $heatCells[$cu][$p] = $pv; }
            }
        }
    }

    // Evaluate row rules
    $rowOverrides = $heatRow;
    foreach ($rowRules as $rr) {
        $shouldApply = false;
        if (!isset($rr['_parsed'])) {
            $shouldApply = true;
        } else {
            $shouldApply = evaluate_format_condition($rowWithIndex, $rr['_parsed']);
        }
        if ($shouldApply) {
            foreach ($rr['_css'] as $prop => $val) {
                $rowOverrides[$prop] = $val;
            }
        }
    }

    // Evaluate cell rules per column. Seeded with the heat fills so a matching
    // format(cell, ...) rule below overwrites the same property and wins.
    $cellOverrides = $heatCells;
    if (!empty($cellRules)) {
        foreach ($row as $colName => $cell) {
            $colUpper = strtoupper($colName);
            $overrides = isset($cellOverrides[$colUpper]) ? $cellOverrides[$colUpper] : array();
            foreach ($cellRules as $cr) {
                if ($cr['targetColumn'] !== null && $colUpper !== $cr['targetColumn']) continue;
                $shouldApply = false;
                if ($cr['condition'] === null) {
                    $shouldApply = true;
                } else if (isset($cr['_parsed'])) {
                    $shouldApply = evaluate_format_condition($rowWithIndex, $cr['_parsed']);
                }
                if ($shouldApply) {
                    foreach ($cr['_css'] as $prop => $val) {
                        $overrides[$prop] = $val;
                    }
                }
            }
            if (!empty($overrides)) {
                $cellOverrides[$colUpper] = $overrides;
            }
        }
    }

    return array('row' => $rowOverrides, 'cells' => $cellOverrides);
}

function _cf_clean_raw_value($val) {
    if (!is_string($val)) return (string)$val;
    if (strpos($val, '@@HTML') === 0) return substr($val, 6);
    if (strpos($val, '@@JSON') === 0) return substr($val, 6);
    return $val;
}

function parse_rewrite_rules($snippetText) {
    if (!$snippetText || !trim($snippetText)) return array();

    // Strip block comments
    $text = preg_replace('/\/\*[\s\S]*?\*\//', '', $snippetText);
    // Strip // line comments (but preserve quoted strings and //exact// patterns)
    $text = preg_replace_callback(
        '/(\'[^\']*\'|"[^"]*"|\/\/[^\/\n]*\/\/)|\/\/.*$/m',
        function($m) { return isset($m[1]) && $m[1] !== "" ? $m[1] : ""; },
        $text
    );
    // Remove backtick-delimited strings
    $text = preg_replace('/`[^`]+`/', '', $text);

    $rules = array();

    $findFrom = 0;
    while (true) {
        $lower = strtolower($text);
        // Word-boundary scan - see _snippet_find_call(). No collision today, but
        // the next fn name ending in "rewrite" would silently eat this call.
        $start = _snippet_find_call($lower, 'rewrite', $findFrom);
        if ($start === false) break;

        // Adjacency - same rule as the format() extractor above.
        if (!isset($text[$start + 7]) || $text[$start + 7] !== '(') {
            $findFrom = $start + 7;
            continue;
        }
        $openParen = $start + 7;

        // Find matching close paren
        $depth = 1;
        $inQ = false;
        $qCh = '';
        $end = -1;
        for ($i = $openParen + 1; $i < strlen($text); $i++) {
            $c = $text[$i];
            if ($inQ) {
                if ($c === $qCh) $inQ = false;
                continue;
            }
            if ($c === '"' || $c === "'") { $inQ = true; $qCh = $c; continue; }
            if ($c === '(') $depth++;
            if ($c === ')') $depth--;
            if ($depth === 0) { $end = $i; break; }
        }
        if ($end === -1) break;

        $argsStr = substr($text, $openParen + 1, $end - $openParen - 1);
        $cleanArgs = parse_format_args($argsStr);
        $argCount = count($cleanArgs);

        if ($argCount === 3) {
            // rewrite(COLUMN, CONDITION, TEMPLATE)
            $rules[] = array(
                'targetColumn' => strtoupper($cleanArgs[0]),
                'condition'    => $cleanArgs[1],
                'template'     => $cleanArgs[2]
            );
        } else if ($argCount === 2) {
            // rewrite(COLUMN, TEMPLATE)
            $rules[] = array(
                'targetColumn' => strtoupper($cleanArgs[0]),
                'condition'    => null,
                'template'     => $cleanArgs[1]
            );
        }

        $text = substr($text, 0, $start) . substr($text, $end + 1);
        $findFrom = 0; // text shifted - rescan from the top
    }

    // --- sparkline_cell(TARGET_COLUMN, COL1|COL2|COL3, COLOR?) ---
    // A SECOND scan, deliberately separate from the rewrite() one above rather
    // than folded into it: the two take different argument shapes, and this way
    // neither scan's word-boundary logic has to know about the other. The rules
    // land in the SAME array, so they inherit the whole rewrite pipeline (row
    // lookup, condition prep, cell write) exactly as the browser's do.
    $findFrom = 0;
    while (true) {
        $lower = strtolower($text);
        $start = _snippet_find_call($lower, 'sparkline_cell', $findFrom);
        if ($start === false) break;

        $nameLen = strlen('sparkline_cell');
        if (!isset($text[$start + $nameLen]) || $text[$start + $nameLen] !== '(') {
            $findFrom = $start + $nameLen;
            continue;
        }
        $openParen = $start + $nameLen;

        $depth = 1; $inQ = false; $qCh = ''; $end = -1;
        for ($i = $openParen + 1; $i < strlen($text); $i++) {
            $c = $text[$i];
            if ($inQ) {
                if ($c === $qCh) $inQ = false;
                continue;
            }
            if ($c === '"' || $c === "'") { $inQ = true; $qCh = $c; continue; }
            if ($c === '(') $depth++;
            if ($c === ')') $depth--;
            if ($depth === 0) { $end = $i; break; }
        }
        if ($end === -1) break;

        $cleanArgs = parse_format_args(substr($text, $openParen + 1, $end - $openParen - 1));
        if (count($cleanArgs) >= 2) {
            $cols = array();
            foreach (explode('|', $cleanArgs[1]) as $c) {
                $c = trim($c);
                if ($c !== '') $cols[] = $c;
            }
            if (count($cols)) {
                $_o = _sparkline_opts($cleanArgs, 2);
                $rules[] = array(
                    'targetColumn' => strtoupper($cleanArgs[0]),
                    'condition'    => null,
                    'template'     => null,
                    '_spark'       => array(
                        'cols'    => $cols,
                        'color'   => _sparkline_color($_o['color'] === '' ? null : $_o['color']),
                        'curve'   => $_o['curve'],
                        'scale'     => $_o['scale'],
                        'total_w'   => $_o['total_w'],
                        'width_set' => $_o['width_set']
                    )
                );
            }
        }

        $text = substr($text, 0, $start) . substr($text, $end + 1);
        $findFrom = 0;
    }

    return $rules;
}

function prepare_rewrite_rules($rewriteRules, $columns, $allRows = null) {
    $result = array();
    foreach ($rewriteRules as $rule) {
        $prepared = $rule;
        if ($rule['condition']) {
            $prepared['_parsed'] = parse_format_condition($rule['condition'], $columns);
            // Rewrite a toggle condition's value to the stored '1'/'0'. The rows here
            // already CARRY the toggle column, so the column resolved fine - only the
            // value did not, which made format(Done = ☑, ...) a silent no-op even
            // though count(Done = ☑) worked. ☑/☐ is exactly what the UI's value
            // autocomplete hands out, so this is the form users actually write.
            $prepared['_parsed'] = _snippet_normalize_toggle_tree($prepared['_parsed'], _snippet_journal_toggles());
        }

        // scale=shared: one maximum for the WHOLE column so the bars can be
        // compared row to row. Computed here, once, because apply_rewrite_to_row()
        // only ever sees a single row and could never work it out. Without
        // $allRows the rule silently keeps per-row scaling, which is the safe
        // degradation - the pivot path does not pass rows and does not need to.
        if (isset($prepared['_spark']) &&
            isset($prepared['_spark']['scale']) && $prepared['_spark']['scale'] === 'shared' &&
            is_array($allRows) && count($allRows)) {
            $m = 0;
            foreach ($allRows as $r) {
                $upper = array();
                foreach ($r as $k => $v) $upper[strtoupper($k)] = $v;
                foreach (_sparkline_row_series($upper, $prepared['_spark']['cols']) as $sv) {
                    $a = abs($sv);
                    if (is_finite($a) && $a > $m) $m = $a;
                }
            }
            if ($m > 0) $prepared['_spark']['_shared_max'] = $m;
        }

        $result[] = $prepared;
    }
    return $result;
}

function apply_rewrite_to_row($row, $rowIndex, $rewriteRules) {
    if (empty($rewriteRules)) return array();

    $rewrites = array();
    $rowWithIndex = $row;
    $rowWithIndex['#'] = $rowIndex + 1;

    // Build uppercase lookup for column values
    $upperRow = array();
    foreach ($row as $k => $v) $upperRow[strtoupper($k)] = $v;

    foreach ($rewriteRules as $rule) {
        $shouldApply = false;
        if ($rule['condition'] === null || !isset($rule['_parsed']) || empty($rule['_parsed'])) {
            $shouldApply = true;
        } else {
            $shouldApply = evaluate_format_condition($rowWithIndex, $rule['_parsed']);
        }

        if ($shouldApply) {
            $target = $rule['targetColumn'];

            // sparkline_cell: content is COMPUTED from this row across the named
            // columns, so there is no template to interpolate. Mirrors the
            // browser's early return in the same position.
            if (isset($rule['_spark'])) {
                $rewrites[$target] = '@@HTML' . _sparkline_bars_html(
                    _sparkline_row_series($upperRow, $rule['_spark']['cols']),
                    array(
                        'color'   => $rule['_spark']['color'],
                        'curve'   => isset($rule['_spark']['curve']) ? $rule['_spark']['curve'] : 'linear',
                        'total_w'   => isset($rule['_spark']['total_w']) ? $rule['_spark']['total_w'] : null,
                        'width_set' => !empty($rule['_spark']['width_set']),
                        // Set by the shared-scale pre-pass in prepare_rewrite_rules();
                        // absent means "scale to this row's own peak".
                        'max_abs' => isset($rule['_spark']['_shared_max']) ? $rule['_spark']['_shared_max'] : 0
                    )
                );
                continue;
            }

            $template = $rule['template'];

            // Get the target column's raw value for {val}
            $targetVal = isset($upperRow[$target]) ? $upperRow[$target] : '';
            $cleanTargetVal = _cf_clean_raw_value($targetVal);

            // Replace {val} placeholder (case-insensitive)
            // Case-insensitive: the browser substitutes ANY casing of {val},
            // so {vAl} must not mail as literal text.
            $result = str_ireplace('{val}', $cleanTargetVal, $template);

            // Replace all {COLUMN_NAME} placeholders
            if (preg_match_all('/\{([a-zA-Z0-9_ ]+)\}/', $result, $matches)) {
                foreach ($matches[0] as $idx => $fullMatch) {
                    $colKey = strtoupper($matches[1][$idx]);
                    if ($colKey === 'VAL') continue; // already handled
                    $rawVal = isset($upperRow[$colKey]) ? $upperRow[$colKey] : '';
                    $cleanVal = _cf_clean_raw_value($rawVal);
                    $result = str_replace($fullMatch, $cleanVal, $result);
                }
            }

            // Prefix with @@HTML so formatCellContent renders it as HTML
            // (handles script stripping, link stripping, etc.)
            $rewrites[$target] = '@@HTML' . $result;
        }
    }

    return $rewrites;
}

function _snippet_detect_virtual_columns($data) {
    static $cache = null;
    static $cacheKey = null;
    $key = count($data); // simple fingerprint; resets if row count changes
    if ($cacheKey === $key && $cache !== null) return $cache;
    $cache = array();
    $cacheKey = $key;
    if (empty($data)) return $cache;
    // Sample first few rows to detect virtual columns
    $sampleSize = min(count($data), 5);
    for ($i = 0; $i < $sampleSize; $i++) {
        $vCols = _search_get_virtual_columns($data[$i]);
        foreach ($vCols as $k => $v) {
            $cache[$k] = true;
        }
    }
    return $cache;
}

function _snippet_expand_virtual_rows($data, $targetCol, $condStr, $columns) {
    if (empty($data)) return $data;

    $virtualCols = _snippet_detect_virtual_columns($data);
    if (empty($virtualCols)) return $data;

    // Check if target column is virtual
    $targetIsVirtual = $targetCol && isset($virtualCols[strtoupper($targetCol)]);

    // Check if condition references any virtual column
    // Use word-boundary matching to prevent "KEYWORD" from falsely
    // matching inside "KEYWORDS" (which would incorrectly trigger
    // expansion and drop the KEYWORDS main column from base entries)
    $condRefsVirtual = false;
    $condVirtualCols = array();
    if ($condStr) {
        $condUpper = strtoupper($condStr);
        foreach ($virtualCols as $vColName => $v) {
            if (preg_match('/\b' . preg_quote($vColName, '/') . '\b/', $condUpper)) {
                $condRefsVirtual = true;
                $condVirtualCols[] = $vColName;
            }
        }
    }

    if (!$targetIsVirtual && !$condRefsVirtual) return $data;

    // Build set of required columns: a source must contain at least one
    // of these to be expanded. This prevents unrelated @@JSON sources
    // (e.g. KEYWORDS) from producing phantom expanded rows that inherit
    // flat virtual-column values from the base entries.
    $requiredCols = array();
    if ($targetIsVirtual) $requiredCols[strtoupper($targetCol)] = true;
    foreach ($condVirtualCols as $cc) $requiredCols[$cc] = true;

    // Augment $columns with virtual column names (passed by reference if available)
    // so that parse_format_condition can recognize them in conditions
    // This is done via a static so callers can retrieve it
    $allVirtualNames = array_keys($virtualCols);
    _snippet_set_expanded_columns($columns, $allVirtualNames);

    // Expand: for each row, if it has @@JSON cells, create one expanded row per nested row
    $expanded = array();
    foreach ($data as $row) {
        $sources = _search_get_structured_virtual_data($row);
        if (empty($sources)) {
            // No @@JSON in this row - pass through as-is
            $expanded[] = $row;
            continue;
        }

        // Build base row: parent columns WITHOUT @@JSON cell values
        $baseRow = array();
        foreach ($row as $k => $v) {
            $strVal = ($v === null) ? '' : (string)$v;
            if (strpos($strVal, '@@JSON') !== false) continue; // skip @@JSON cells
            $baseRow[strtoupper($k)] = $v;
        }

        // Collect nested rows only from sources that contain required columns
        $nestedRowsFound = false;
        foreach ($sources as $src) {
            // Only expand sources that contain at least one required column
            $sourceRelevant = false;
            foreach ($requiredCols as $reqCol => $v) {
                if (in_array($reqCol, $src['columns'])) { $sourceRelevant = true; break; }
            }
            if (!$sourceRelevant) continue;

            foreach ($src['rows'] as $nRow) {
                $nestedRowsFound = true;
                $expandedRow = $baseRow; // start with parent columns
                foreach ($nRow as $nk => $nv) {
                    $expandedRow[$nk] = $nv; // nested columns override
                }
                $expanded[] = $expandedRow;
            }
        }

        if (!$nestedRowsFound) {
            // @@JSON existed but had no parseable rows - keep parent row
            $expanded[] = $row;
        }
    }
    return $expanded;
}

function _snippet_set_expanded_columns($baseColumns = null, $virtualNames = null) {
    static $expandedColumns = null;
    if ($baseColumns === false) { $expandedColumns = null; return null; } // per-task reset
    if ($baseColumns !== null) {
        $merged = $baseColumns;
        $existing = array();
        foreach ($merged as $c) $existing[strtoupper($c)] = true;
        foreach ($virtualNames as $vc) {
            if (!isset($existing[$vc])) {
                $merged[] = $vc;
            }
        }
        $expandedColumns = $merged;
    }
    return $expandedColumns;
}

function _snippet_journal_toggles($resolver = null) {
    static $r = null;
    if ($resolver !== null) $r = ($resolver === false) ? null : $resolver;
    return $r;
}

function _snippet_merge_journal_cols($cols, $jt) {
    $out = is_array($cols) ? $cols : array();
    if (!$jt || empty($jt['colNames'])) return $out;
    foreach ($jt['colNames'] as $n) {
        $found = false;
        foreach ($out as $c) { if (strtoupper((string)$c) === strtoupper((string)$n)) { $found = true; break; } }
        if (!$found) $out[] = $n;
    }
    return $out;
}

function _snippet_condition_uses_notes($conditionStr) {
    if ($conditionStr === null || $conditionStr === '') return false;
    return (bool)preg_match('/(^|[\s(\[{"\'])NOTES\s*(=|!=|<>|>=|<=|>|<)/i', (string)$conditionStr);
}

function _snippet_normalize_toggle_tree($tree, $jt) {
    if (!is_array($tree) || !$jt || empty($jt['colNames'])) return $tree;
    $names = array();
    foreach ($jt['colNames'] as $n) $names[strtoupper((string)$n)] = true;
    foreach ($tree as $k => $node) {
        if (!is_array($node)) continue;
        if (isset($node['type']) && $node['type'] === 'condition' && isset($node['column'])) {
            $col = strtoupper(preg_replace('/^\{[\'"]?|[\'"]?\}$/', '', (string)$node['column']));
            if (isset($names[$col]) && isset($node['value'])) {
                $want = journalToggleWantExport($node['value']);
                if ($want !== null) $tree[$k]['value'] = $want ? '1' : '0';
            }
        } else {
            $tree[$k] = _snippet_normalize_toggle_tree($node, $jt);
        }
    }
    return $tree;
}

function _snippet_toggle_eval_row($row, $jt) {
    if (!$jt || !is_array($row)) return $row;
    foreach (journalExportToggleRowValues($jt, $row) as $tn => $tv) $row[$tn] = $tv;
    return $row;
}

function _snippet_filter_rows($data, $columns, $conditionStr) {
    if ($conditionStr === null || $conditionStr === '') {
        return $data;
    }
    $expandedCols = _snippet_set_expanded_columns();
    $effectiveCols = $expandedCols ? $expandedCols : $columns;
    $jt = _snippet_journal_toggles();
    if ($jt) $effectiveCols = _snippet_merge_journal_cols($effectiveCols, $jt);
    $parsed = parse_format_condition($conditionStr, $effectiveCols);
    if (!$parsed) {
        return $data;
    }
    if ($jt) $parsed = _snippet_normalize_toggle_tree($parsed, $jt);
    $filtered = array();
    foreach ($data as $row) {
        // Toggles are evaluated from a row COPY - the returned rows stay clean,
        // matching the browser engines (condition-aware, value side unsupported).
        if (evaluate_format_condition($jt ? _snippet_toggle_eval_row($row, $jt) : $row, $parsed)) {
            $filtered[] = $row;
        }
    }
    return $filtered;
}

function _snippet_strip_scope_arg($args) {
    $n = count($args);
    if ($n >= 2 && preg_match('/^(all|total|unfiltered)$/i', trim((string)$args[$n - 1]))) {
        array_pop($args);
    }
    return $args;
}

function _snippet_count($args, $data, $columns) {
    $condStr = isset($args[0]) ? trim($args[0]) : null;
    // Ignore args[1] (scope) - no browser search context on the server.
    $data = _snippet_expand_virtual_rows($data, null, $condStr, $columns);
    $rows = _snippet_filter_rows($data, $columns, $condStr);
    return (string) count($rows);
}

function _snippet_missing_col($colName, $columns) {
    if ($colName === null || $colName === '' || $colName === '#') return false;
    if (!is_array($columns) || count($columns) === 0) return false;
    $expandedCols = _snippet_set_expanded_columns();
    if (is_array($expandedCols) && in_array($colName, $expandedCols, true)) return false;
    if (in_array($colName, $columns, true)) return false;
    return true;
}

function _snippet_sum($args, $data, $columns) {
    $args = _snippet_strip_scope_arg($args);
    if (!isset($args[0])) {
        return '0';
    }
    $colName = strtoupper(trim($args[0]));
    $condStr = isset($args[1]) ? trim($args[1]) : null;
    $data = _snippet_expand_virtual_rows($data, $colName, $condStr, $columns);
    if (_snippet_missing_col($colName, $columns)) return 'NaN';
    $rows = _snippet_filter_rows($data, $columns, $condStr);

    $sum = 0;
    foreach ($rows as $row) {
        if (!isset($row[$colName])) {
            continue;
        }
        $raw = _cf_clean_raw_value($row[$colName]);
        $num = _cf_parse_num($raw);
        if ($num !== false) {
            $sum += $num;
        }
    }
    // Return clean number string - drop trailing zeros after decimal
    if (floor($sum) == $sum) {
        return (string)(int)$sum;
    }
    return (string)$sum;
}

function _snippet_avg($args, $data, $columns) {
    $args = _snippet_strip_scope_arg($args);
    if (!isset($args[0])) {
        return '0';
    }
    $colName = strtoupper(trim($args[0]));
    $condStr = isset($args[1]) ? trim($args[1]) : null;
    $data = _snippet_expand_virtual_rows($data, $colName, $condStr, $columns);
    if (_snippet_missing_col($colName, $columns)) return 'NaN';
    $rows = _snippet_filter_rows($data, $columns, $condStr);

    $sum = 0;
    $count = 0;
    foreach ($rows as $row) {
        if (!isset($row[$colName])) {
            continue;
        }
        $raw = _cf_clean_raw_value($row[$colName]);
        $num = _cf_parse_num($raw);
        if ($num !== false) {
            $sum += $num;
            $count++;
        }
    }

    if ($count === 0) {
        return '0';
    }
    $avg = $sum / $count;
    // RAW, like engines A and B. Rounding to 2dp HERE poisoned every enclosing
    // call, because all three engines resolve nesting by substituting the inner
    // result back into the text and re-scanning: round(avg(X),3) saw the
    // already-rounded 1911.72 and mailed 1911.720 where the browser said
    // 1911.722. Display rounding now happens ONCE, in execute_email_snippet's
    // number pass, for plain and HTML output alike.
    if (floor($avg) == $avg) {
        return (string)(int)$avg;
    }
    return (string)$avg;
}

function _snippet_min($args, $data, $columns) {
    $args = _snippet_strip_scope_arg($args);
    if (!isset($args[0])) {
        return '';
    }
    $colName = strtoupper(trim($args[0]));
    $condStr = isset($args[1]) ? trim($args[1]) : null;
    $data = _snippet_expand_virtual_rows($data, $colName, $condStr, $columns);
    if (_snippet_missing_col($colName, $columns)) return 'NaN';
    $rows = _snippet_filter_rows($data, $columns, $condStr);

    // Collect values with their originals
    $numericEntries = array();
    $dateEntries = array();
    $hasNumeric = false;

    foreach ($rows as $row) {
        if (!isset($row[$colName])) {
            continue;
        }
        $raw = _cf_clean_raw_value($row[$colName]);
        if ($raw === '' || $raw === null) {
            continue;
        }
        $num = _cf_parse_num($raw);
        if ($num !== false) {
            $hasNumeric = true;
            $numericEntries[] = array('num' => $num, 'orig' => $row[$colName]);
        } else {
            // Try parsing as date
            $ts = @strtotime($raw);
            if ($ts !== false) {
                $dateEntries[] = array('ts' => $ts, 'orig' => $row[$colName]);
            }
        }
    }

    if ($hasNumeric && count($numericEntries) > 0) {
        $minEntry = $numericEntries[0];
        foreach ($numericEntries as $e) {
            if ($e['num'] < $minEntry['num']) {
                $minEntry = $e;
            }
        }
        return (string)$minEntry['orig'];
    }

    if (count($dateEntries) > 0) {
        $minEntry = $dateEntries[0];
        foreach ($dateEntries as $e) {
            if ($e['ts'] < $minEntry['ts']) {
                $minEntry = $e;
            }
        }
        // \x02-guarded: a date string must not go through the number pass
        // ('2026-08-07' was mailing as '2,026-8-7').
        return "\x02" . (string)$minEntry['orig'] . "\x02";
    }

    // Nothing to take a minimum OF. Browser twin (~main.js:29237) answers 'N/A'
    // here; the old '' silently vanished mid-sentence in an email subtitle, and
    // fed date_format() an empty subject that mailed 'Invalid Date'.
    return 'N/A';
}

function _snippet_max($args, $data, $columns) {
    $args = _snippet_strip_scope_arg($args);
    if (!isset($args[0])) {
        return '';
    }
    $colName = strtoupper(trim($args[0]));
    $condStr = isset($args[1]) ? trim($args[1]) : null;
    $data = _snippet_expand_virtual_rows($data, $colName, $condStr, $columns);
    if (_snippet_missing_col($colName, $columns)) return 'NaN';
    $rows = _snippet_filter_rows($data, $columns, $condStr);

    $numericEntries = array();
    $dateEntries = array();
    $hasNumeric = false;

    foreach ($rows as $row) {
        if (!isset($row[$colName])) {
            continue;
        }
        $raw = _cf_clean_raw_value($row[$colName]);
        if ($raw === '' || $raw === null) {
            continue;
        }
        $num = _cf_parse_num($raw);
        if ($num !== false) {
            $hasNumeric = true;
            $numericEntries[] = array('num' => $num, 'orig' => $row[$colName]);
        } else {
            $ts = @strtotime($raw);
            if ($ts !== false) {
                $dateEntries[] = array('ts' => $ts, 'orig' => $row[$colName]);
            }
        }
    }

    if ($hasNumeric && count($numericEntries) > 0) {
        $maxEntry = $numericEntries[0];
        foreach ($numericEntries as $e) {
            if ($e['num'] > $maxEntry['num']) {
                $maxEntry = $e;
            }
        }
        return (string)$maxEntry['orig'];
    }

    if (count($dateEntries) > 0) {
        $maxEntry = $dateEntries[0];
        foreach ($dateEntries as $e) {
            if ($e['ts'] > $maxEntry['ts']) {
                $maxEntry = $e;
            }
        }
        // \x02-guarded like _snippet_min()'s date branch.
        return "\x02" . (string)$maxEntry['orig'] . "\x02";
    }

    // Nothing to take a maximum OF - see _snippet_min()'s twin comment.
    return 'N/A';
}

function _snippet_median($args, $data, $columns) {
    $args = _snippet_strip_scope_arg($args);
    if (!isset($args[0])) {
        return '0';
    }
    $colName = strtoupper(trim($args[0]));
    $condStr = isset($args[1]) ? trim($args[1]) : null;
    $data = _snippet_expand_virtual_rows($data, $colName, $condStr, $columns);
    if (_snippet_missing_col($colName, $columns)) return 'NaN';
    $rows = _snippet_filter_rows($data, $columns, $condStr);

    $values = array();
    foreach ($rows as $row) {
        if (!isset($row[$colName])) {
            continue;
        }
        $raw = _cf_clean_raw_value($row[$colName]);
        $num = _cf_parse_num($raw);
        if ($num !== false) {
            $values[] = $num;
        }
    }

    $count = count($values);
    if ($count === 0) {
        return '0';
    }

    sort($values);
    $mid = (int) floor($count / 2);

    if ($count % 2 === 0) {
        $median = ($values[$mid - 1] + $values[$mid]) / 2;
    } else {
        $median = $values[$mid];
    }

    // RAW - see the note in _snippet_avg().
    if (floor($median) == $median) {
        return (string)(int)$median;
    }
    return (string)$median;
}

function _snippet_display_number($v) {
    if (!is_finite($v)) return '0';
    if (floor($v) == $v && abs($v) < 1e15) return (string)(int)$v;
    // RAW - see the note in _snippet_avg(). The doc comment above used to say
    // engine C had no whole-output pass and so had to round here; it does have
    // one (execute_email_snippet step 2), and it now runs for plain output too.
    return (string)$v;
}

function _snippet_percentile_of($sorted, $pct) {
    $n = count($sorted);
    if ($n === 0) return 0;
    if ($n === 1) return $sorted[0];
    $rank = ($pct / 100) * ($n - 1);
    $lo = (int)floor($rank);
    $hi = (int)ceil($rank);
    if ($lo === $hi) return $sorted[$lo];
    return $sorted[$lo] + ($sorted[$hi] - $sorted[$lo]) * ($rank - $lo);
}

function _snippet_stddev_of($values) {
    $n = count($values);
    if ($n < 2) return 0;
    $mean = array_sum($values) / $n;
    $m2 = 0;
    foreach ($values as $v) { $m2 += ($v - $mean) * ($v - $mean); }
    return sqrt($m2 / ($n - 1));
}

function _snippet_numeric_column($data, $columns, $colName, $condStr) {
    $data = _snippet_expand_virtual_rows($data, $colName, $condStr, $columns);
    $rows = _snippet_filter_rows($data, $columns, $condStr);
    $values = array();
    foreach ($rows as $row) {
        if (!isset($row[$colName])) continue;
        $num = _cf_parse_num(_cf_clean_raw_value($row[$colName]));
        if ($num !== false) $values[] = $num;
    }
    return $values;
}

function _snippet_percentile($args, $data, $columns) {
    $args = _snippet_strip_scope_arg($args);
    if (!isset($args[0]) || !isset($args[1])) return 'Invalid Percentile';
    $pct = trim($args[0]);
    if (!is_numeric($pct)) return 'Invalid Percentile';
    $pct = (float)$pct;
    if ($pct < 0 || $pct > 100) return 'Invalid Percentile';
    $colName = strtoupper(trim($args[1]));
    if ($colName === '') return 'Invalid Percentile';
    $condStr = isset($args[2]) ? trim($args[2]) : null;

    $values = _snippet_numeric_column($data, $columns, $colName, $condStr);
    if (count($values) === 0) return '0';
    sort($values);
    return _snippet_display_number(_snippet_percentile_of($values, $pct));
}

function _snippet_stddev($args, $data, $columns) {
    $args = _snippet_strip_scope_arg($args);
    if (!isset($args[0])) return '0';
    $colName = strtoupper(trim($args[0]));
    $condStr = isset($args[1]) ? trim($args[1]) : null;

    // After the column helper so its virtual-row expansion state is fresh.
    $values = _snippet_numeric_column($data, $columns, $colName, $condStr);
    if (_snippet_missing_col($colName, $columns)) return 'NaN';
    if (count($values) === 0) return '0';
    return _snippet_display_number(_snippet_stddev_of($values));
}

function _snippet_mode($args, $data, $columns) {
    $args = _snippet_strip_scope_arg($args);
    if (!isset($args[0])) {
        return '';
    }
    $colName = strtoupper(trim($args[0]));
    $condStr = isset($args[1]) ? trim($args[1]) : null;
    $data = _snippet_expand_virtual_rows($data, $colName, $condStr, $columns);
    if (_snippet_missing_col($colName, $columns)) return 'NaN';
    $rows = _snippet_filter_rows($data, $columns, $condStr);

    // Track frequency and first-seen order
    $freq = array();
    $firstSeen = array();
    $idx = 0;

    foreach ($rows as $row) {
        if (!isset($row[$colName])) {
            continue;
        }
        $raw = _cf_clean_raw_value($row[$colName]);
        if ($raw === '' || $raw === null) {
            continue;
        }
        $key = (string)$raw;
        if (!isset($freq[$key])) {
            $freq[$key] = 0;
            $firstSeen[$key] = $idx;
        }
        $freq[$key]++;
        $idx++;
    }

    if (empty($freq)) {
        return '';
    }

    // Find the max frequency
    $maxFreq = 0;
    foreach ($freq as $f) {
        if ($f > $maxFreq) {
            $maxFreq = $f;
        }
    }

    // Among values with max frequency, pick the one first seen
    $bestKey = null;
    $bestOrder = PHP_INT_MAX;
    foreach ($freq as $key => $f) {
        if ($f === $maxFreq && $firstSeen[$key] < $bestOrder) {
            $bestOrder = $firstSeen[$key];
            $bestKey = $key;
        }
    }

    // \x02-guarded: engine A shields mode() output behind a string-literal
    // token, so a digit-string mode like '07030' must not mail as '7,030'.
    return ($bestKey !== null) ? "\x02" . $bestKey . "\x02" : '';
}

function _snippet_distinct($args, $data, $columns) {
    $args = _snippet_strip_scope_arg($args);
    if (!isset($args[0])) {
        return '0';
    }
    $colName = strtoupper(trim($args[0]));
    $condStr = isset($args[1]) ? trim($args[1]) : null;
    $data = _snippet_expand_virtual_rows($data, $colName, $condStr, $columns);
    if (_snippet_missing_col($colName, $columns)) return 'NaN';
    $rows = _snippet_filter_rows($data, $columns, $condStr);

    $seen = array();
    foreach ($rows as $row) {
        if (!isset($row[$colName])) {
            continue;
        }
        // SQL COUNT(DISTINCT ...) semantics: trim + drop blank/NULL, matching the
        // browser engines A (~main.js:25073) + B (~37196) so distinct() agrees in
        // the main snippet, subtitle/infobox, and scheduled email alike.
        $key = trim((string)_cf_clean_raw_value($row[$colName]));
        if ($key === '') {
            continue;
        }
        $seen[$key] = true;
    }

    return (string) count($seen);
}

function _snippet_rank($args, $data, $columns) {
    // A/B return DIAGNOSTIC TEXT here; C used to return '', so a report that
    // read 'Invalid Rank'/'N/A' on screen mailed a blank. Contract taken from
    // engine B (js/main.js ~52030-52049): a missing/zero/non-numeric N is
    // 'Invalid Rank'; having nothing to rank, or an out-of-range index, is
    // 'N/A' - the same 'N/A' min()/max()/lookup()/mode() already return.
    // (int)'abc' is 0 in PHP, so the $n === 0 test also covers B's isNaN case.
    if (!isset($args[0]) || !isset($args[1])) {
        return 'Invalid Rank';
    }
    $n = (int) trim($args[0]);
    if ($n === 0) {
        return 'Invalid Rank';
    }
    $colName = strtoupper(trim($args[1]));
    $condStr = isset($args[2]) ? trim($args[2]) : null;
    $data = _snippet_expand_virtual_rows($data, $colName, $condStr, $columns);
    $rows = _snippet_filter_rows($data, $columns, $condStr);

    // Collect numeric entries with original values
    $entries = array();
    foreach ($rows as $row) {
        if (!isset($row[$colName])) {
            continue;
        }
        $raw = _cf_clean_raw_value($row[$colName]);
        $num = _cf_parse_num($raw);
        if ($num !== false) {
            $entries[] = array('num' => $num, 'orig' => $row[$colName]);
        }
    }

    if (empty($entries)) {
        return 'N/A';
    }

    if ($n > 0) {
        // Top N: sort descending by num
        usort($entries, '_snippet_rank_sort_desc');
        $idx = $n - 1; // 1-indexed to 0-indexed
    } else {
        // Bottom N: sort ascending by num
        usort($entries, '_snippet_rank_sort_asc');
        $idx = abs($n) - 1;
    }

    // DEDUPE BY VALUE. Engines A and B rank over UNIQUE values
    // (Array.from(new Set(rankValues)), js/main.js ~52046); C ranked over every
    // ROW, so as soon as a column held duplicates rank(2, COL) returned the
    // second ROW rather than the second distinct VALUE - 30 where the browser
    // said 20, and rank(3) gave 30 where the browser said 10. Dedupe AFTER the
    // sort so the survivor of each value is the first in ranked order, and keep
    // the whole entry rather than the bare number so the "return the original
    // cell text" behaviour (zip codes, trailing-zero money like 1200.50) is
    // unaffected. Found 2026-08-29, once the parity corpus gained a DUP column -
    // the original fixture was all-distinct, so nothing could catch it.
    $seenRankNums = array();
    $uniqueEntries = array();
    foreach ($entries as $entry) {
        $numKey = (string)$entry['num'];
        if (isset($seenRankNums[$numKey])) {
            continue;
        }
        $seenRankNums[$numKey] = true;
        $uniqueEntries[] = $entry;
    }
    $entries = $uniqueEntries;

    if ($idx < 0 || $idx >= count($entries)) {
        return 'N/A';
    }

    return (string) $entries[$idx]['orig'];
}

function _snippet_rank_sort_desc($a, $b) {
    if ($a['num'] == $b['num']) {
        return 0;
    }
    return ($a['num'] > $b['num']) ? -1 : 1;
}

function _snippet_rank_sort_asc($a, $b) {
    if ($a['num'] == $b['num']) {
        return 0;
    }
    return ($a['num'] < $b['num']) ? -1 : 1;
}

function _snippet_calc($args) {
    if (empty($args) || !isset($args[0])) {
        return '0';
    }
    $expr = trim($args[0]);
    if ($expr === '') {
        return '0';
    }
    // Strip \x02 number-guards and their thousands commas from nested
    // round()/fixed() results so calc(round(x,0)*2) computes instead of
    // failing the charset check - engine B's calc does the same.
    $expr = str_replace(array("\x02", ','), '', $expr);
    // A NO-DATA operand makes the whole expression unknown - browser twin does
    // the same (main.js case 'calc'). Must run BEFORE the charset check below,
    // which would otherwise collapse "N/A+5" to '0' while the browser said 'N/A'.
    if (preg_match('~N/A~i', $expr)) {
        return 'N/A';
    }
    // Only allow digits, operators, parens, decimal points, scientific notation, spaces
    if (!preg_match('/^[0-9+\-*\/%().eE\s]+$/', $expr)) {
        return '0';
    }
    // Prevent empty parens or double operators that could cause eval issues
    if (preg_match('/\(\s*\)/', $expr)) {
        return '0';
    }
    $result = '0';
    // Use eval with error suppression
    $oldLevel = error_reporting(0);
    try {
        $evalResult = @eval('return (' . $expr . ');');
        if ($evalResult === false && $expr !== 'false') {
            $result = '0';
        } elseif (!is_finite($evalResult)) {
            $result = '0';
        } else {
            $result = (string)$evalResult;
        }
    } catch (\Throwable $e) {
        // \Throwable, not just Exception: @eval() raises ParseError / DivisionByZeroError
        // (Error, not Exception - and @ does not suppress a *thrown* Error), so catching
        // only Exception let a malformed calc() crash the whole scheduled run.
        $result = '0';
    }
    error_reporting($oldLevel);
    return $result;
}

function _snippet_round($args) {
    if (empty($args) || !isset($args[0])) {
        return '0';
    }
    // 'N/A' is the codebase's NO-DATA answer (min()/max()/rank()/lookup()/mode()
    // all return it). Propagate it instead of collapsing to '0', and keep the
    // browser twin's output identical - see the matching guard in main.js's
    // case 'round'. Without this, round(min(EMPTY_COL), 2) read 'NaN' on screen
    // and '0' in the email off the same snippet and the same empty result set.
    if (preg_match('~^\s*N/A\s*$~i', (string)$args[0])) {
        return 'N/A';
    }
    $val = _cf_parse_num(trim($args[0]));
    if ($val === false) {
        return '0';
    }
    $decimals = 0;
    if (isset($args[1])) {
        $d = _cf_parse_num(trim($args[1]));
        if ($d !== false) {
            $decimals = (int)$d;
        }
    }
    // \x02-guarded like _snippet_fixed(), so execute_email_snippet's number pass
    // keeps the author's EXACT decimals. Before 2026-07-29 this returned a bare
    // number, the pass then clamped it to 2 decimals and dropped trailing zeros,
    // and round(x, 3) mailed as "1,234.57" while the browser showed 1234.568.
    // The browser engines were fixed the same day (main.js: engine A emits an
    // __UNFORMATTED_LITERAL_ token, engine B its own \x02 guard), so round() has
    // to be guarded here too or "Browser + Email" stops being true.
    // number_format needs a non-negative precision; PHP's round() accepts a
    // NEGATIVE $decimals (round to tens/hundreds), so the rounding keeps the raw
    // value while only the DISPLAY precision is floored at 0.
    $rounded = round($val, $decimals);
    return "\x02" . number_format($rounded, max(0, min(20, $decimals)), '.', ',') . "\x02";
}

function _snippet_abs($args) {
    $v = isset($args[0]) ? _cf_parse_num(trim($args[0])) : false;
    return ($v === false) ? 'NaN' : (string)abs($v);
}

function _snippet_floor($args) {
    $v = isset($args[0]) ? _cf_parse_num(trim($args[0])) : false;
    return ($v === false) ? 'NaN' : (string)floor($v);
}

function _snippet_ceil($args) {
    $v = isset($args[0]) ? _cf_parse_num(trim($args[0])) : false;
    return ($v === false) ? 'NaN' : (string)ceil($v);
}

function _snippet_mod($args) {
    $a = isset($args[0]) ? _cf_parse_num(trim($args[0])) : false;
    $b = isset($args[1]) ? _cf_parse_num(trim($args[1])) : false;
    if ($a === false || $b === false || (float)$b == 0.0) {
        return 'NaN';
    }
    return (string)fmod($a, $b);
}

function _snippet_fixed($args) {
    $v = isset($args[0]) ? _cf_parse_num(trim($args[0])) : false;
    if ($v === false) {
        return 'NaN';
    }
    $p = 2;
    if (isset($args[1])) {
        $pn = _cf_parse_num(trim($args[1]));
        if ($pn !== false) {
            $p = max(0, min(8, (int)$pn));
        }
    }
    return "\x02" . number_format($v, $p, '.', ',') . "\x02";
}

function _snippet_now_norm_unit($u) {
    if ($u === 'M') return 'month';
    if ($u === 'm') return 'minute';
    switch (strtolower($u)) {
        case 'y': case 'yr': case 'yrs': case 'year': case 'years':       return 'year';
        case 'mo': case 'mon': case 'month': case 'months':               return 'month';
        case 'w': case 'wk': case 'wks': case 'week': case 'weeks':       return 'week';
        case 'd': case 'day': case 'days':                                return 'day';
        case 'h': case 'hr': case 'hrs': case 'hour': case 'hours':       return 'hour';
        case 'min': case 'mins': case 'minute': case 'minutes':           return 'minute';
        case 's': case 'sec': case 'secs': case 'second': case 'seconds': return 'second';
    }
    return '';
}

function _snippet_date_offset_re() {
    return '/^[+-]?\d+\s+(year|years|y|month|months|M|week|weeks|w|day|days|d|hour|hours|h|minute|minutes|m|second|seconds|s)$/';
}

function _snippet_apply_date_offsets($ts, $offsets) {
    if (!is_array($offsets) || empty($offsets)) return $ts;
    foreach ($offsets as $off) {
        if (preg_match('/^([+-]?\d+)\s+(\S+)$/', trim($off), $om)) {
            $n = (int)$om[1];
            $unit = _snippet_now_norm_unit($om[2]);
            if ($unit === '') continue;
            if ($unit === 'month' || $unit === 'year') {
                // moment CLAMPS month/year arithmetic (Jan 31 +1 month =
                // Feb 28/29, Feb 29 +1 year = Feb 28); strtotime OVERFLOWS
                // into the next month (Mar 2/3) - so a task running on a
                // month-end day mailed a different date than the browser
                // preview. Shift year/month, clamp the day to the target
                // month's length, keep time-of-day.
                $Y = (int)date('Y', $ts); $Mo = (int)date('n', $ts); $D = (int)date('j', $ts);
                $H = (int)date('G', $ts); $I = (int)date('i', $ts); $S = (int)date('s', $ts);
                if ($unit === 'year') {
                    $Y += $n;
                } else {
                    $mIdx = ($Y * 12 + ($Mo - 1)) + $n;
                    $Y = intdiv($mIdx, 12);
                    $Mo = ($mIdx % 12) + 1;
                    if ($Mo < 1) { $Mo += 12; $Y -= 1; }
                }
                $maxD = (int)date('t', mktime(0, 0, 0, $Mo, 1, $Y));
                if ($D > $maxD) $D = $maxD;
                $ts = mktime($H, $I, $S, $Mo, $D, $Y);
            } else {
                $shifted = strtotime(($n >= 0 ? '+' : '-') . abs($n) . ' ' . $unit, $ts);
                if ($shifted !== false) $ts = $shifted;
            }
        }
    }
    return $ts;
}

function _snippet_now($args) {
    // Resolve format + optional relative offsets, mirroring the browser's now()
    // (js/main.js ~line 23816):
    //   now()                              -> today, MM/DD/YYYY
    //   now('FORMAT')                      -> today, formatted
    //   now('FORMAT','-1 year','+6 days')  -> formatted, with chained offsets
    // A trailing arg is an offset when it matches "<+/-N> <unit>"; otherwise the
    // call is treated as a legacy unquoted format whose commas were literal.
    $offsetRe = _snippet_date_offset_re();

    $format  = (isset($args[0]) && trim($args[0]) !== '') ? $args[0] : 'MM/DD/YYYY';
    $offsets = array();

    if (count($args) > 1) {
        $tail = array_slice($args, 1);
        $hasOffsets = false;
        foreach ($tail as $a) {
            if (preg_match($offsetRe, trim($a))) { $hasOffsets = true; break; }
        }
        if ($hasOffsets) {
            foreach ($tail as $a) {
                $a = trim($a);
                if (preg_match($offsetRe, $a)) $offsets[] = $a;
            }
        } else {
            // Legacy unquoted format-with-commas: rejoin every arg as the format.
            $format = implode(', ', $args);
        }
    }
    if (trim($format) === '') $format = 'MM/DD/YYYY';

    // Base timestamp, then apply chained offsets (in source order, like moment).
    $ts = _snippet_apply_date_offsets(time(), $offsets);

    // Render once with the offset-adjusted timestamp, uppercased to match the
    // browser (Moment.js .toUpperCase()). \x02-guarded so the number pass
    // cannot re-group date digits ('08/07/2026' was mailing as '8/7/2,026'
    // via leading-zero drop + year comma). Numeric readers strip the guard.
    return "\x02" . strtoupper(date(_snippet_moment_to_php_format($format), $ts)) . "\x02";
}

function _snippet_moment_to_php_format($format) {
    static $momentToPhp = array(
        // 4-char tokens
        'YYYY' => 'Y', 'MMMM' => 'F', 'dddd' => 'l',
        // 3-char tokens (SSS = ms; ints have none, so it renders 000 - still
        // beats mailing the literal letters)
        'MMM' => 'M', 'ddd' => 'D', 'SSS' => 'v',
        // 2-char tokens (Do = ordinal day '7th'; ZZ = +0000-style offset)
        'YY' => 'y', 'MM' => 'm', 'DD' => 'd', 'HH' => 'H', 'hh' => 'h',
        'mm' => 'i', 'ss' => 's', 'Do' => 'jS', 'ZZ' => 'O',
        // 1-char tokens (case-sensitive: M = month, m = minute; X = unix
        // seconds; Z = +00:00-style offset). PHP has no unpadded minute/
        // second, so m/s render zero-padded - closer than literal letters.
        'M' => 'n', 'D' => 'j', 'H' => 'G', 'h' => 'g', 'A' => 'A', 'a' => 'a',
        'm' => 'i', 's' => 's', 'X' => 'U', 'Z' => 'P',
    );

    $format = (string)$format;
    $phpFormat = '';
    $len = strlen($format);
    $pos = 0;
    while ($pos < $len) {
        $matched = false;
        foreach ($momentToPhp as $tok => $code) {
            $tl = strlen($tok);
            if (substr($format, $pos, $tl) === $tok) {
                $phpFormat .= $code;
                $pos += $tl;
                $matched = true;
                break;
            }
        }
        if (!$matched) {
            $ch = $format[$pos];
            // moment escapes literal text in [brackets] - honor it so
            // now('[Week] w') prints "Week ..." instead of token soup.
            if ($ch === '[') {
                $close = strpos($format, ']', $pos + 1);
                if ($close !== false) {
                    for ($bi = $pos + 1; $bi < $close; $bi++) {
                        $bc = $format[$bi];
                        if (($bc >= 'a' && $bc <= 'z') || ($bc >= 'A' && $bc <= 'Z')) {
                            $phpFormat .= '\\' . $bc;
                        } else {
                            $phpFormat .= $bc;
                        }
                    }
                    $pos = $close + 1;
                    continue;
                }
            }
            // Escape literal letters so date() renders them as text, not codes.
            if (($ch >= 'a' && $ch <= 'z') || ($ch >= 'A' && $ch <= 'Z')) {
                $phpFormat .= '\\' . $ch;
            } else {
                $phpFormat .= $ch;
            }
            $pos++;
        }
    }
    return $phpFormat;
}

function _snippet_date_format_offsets($args) {
    $offsets = array();
    if (!is_array($args) || count($args) < 2) return $offsets;
    $re = _snippet_date_offset_re();
    foreach (array_slice($args, 1) as $a) {
        $a = trim((string)$a);
        if (preg_match($re, $a)) $offsets[] = $a;
    }
    return $offsets;
}

function _snippet_date_format_normalize($args) {
    $parts = array();
    if (is_array($args) && count($args) > 1) {
        $re = _snippet_date_offset_re();
        foreach (array_slice($args, 1) as $a) {
            if (!preg_match($re, trim((string)$a))) $parts[] = $a;
        }
    }
    $fmt = !empty($parts) ? implode(', ', $parts) : 'MM/DD/YYYY';
    $fmt = trim(str_replace(array("'", '"'), '', (string)$fmt));
    return ($fmt === '') ? 'MM/DD/YYYY' : $fmt;
}

function _snippet_resolve_date_subject($arg, $data = null, $columns = null) {
    $s = trim(str_replace("\x02", '', (string)$arg));
    $s = preg_replace('/^[\'"]|[\'"]$/', '', $s);
    if ($s === '') return false;
    if (strcasecmp($s, 'now') === 0) return time();
    $r = _cf_parse_date($s);
    if ($r !== false) return $r['ts'];
    // Bare column name -> that column's value on the first row (browser
    // resolver step 7; the help documents this SUBJECT form as supported).
    if (is_array($data) && !empty($data)) {
        $colUpper = strtoupper($s);
        $first = reset($data);
        if (is_array($first) && array_key_exists($colUpper, $first)) {
            $r2 = _cf_parse_date((string)_cf_clean_raw_value($first[$colUpper]));
            if ($r2 !== false) return $r2['ts'];
        }
    }
    return false;
}

function _snippet_date_subject_fallback($arg) {
    $s = trim(str_replace("\x02", '', (string)$arg));
    $s = trim(preg_replace('/^[\'"]|[\'"]$/', '', $s));
    if ($s === '' || strcasecmp($s, 'N/A') === 0) return 'N/A';
    // Unevaluated aggregate form, for the paths that hand the raw text through.
    if (preg_match('/^(min|max)\s*\([^)]*\)$/i', $s)) return 'N/A';
    return 'Invalid Date';
}

function _snippet_date_diff_fallback($endArg, $startArg) {
    return (_snippet_date_subject_fallback($endArg) === 'N/A' ||
            _snippet_date_subject_fallback($startArg) === 'N/A') ? 'N/A' : 'Invalid Date';
}

function _snippet_agree_unit_word($word, $value) {
    $base = preg_replace('/s$/i', '', (string)$word);
    if ((int)$value === 1) return $base;
    return $base . (($base === strtoupper($base)) ? 'S' : 's');
}

function _snippet_date_format($args, $data = null, $columns = null) {
    // === false, not !$ts: a valid timestamp can be 0 (1970-01-01) or
    // negative (any pre-1970 date), both of which are falsy.
    $ts = _snippet_resolve_date_subject(isset($args[0]) ? $args[0] : '', $data, $columns);
    if ($ts === false) {
        // 'N/A' when the subject simply had no data (zero-row result set),
        // 'Invalid Date' only for real bad input - engines A and B do the same.
        return _snippet_date_subject_fallback(isset($args[0]) ? $args[0] : '');
    }

    // Trailing relative offsets, applied through the SAME helper now() uses
    // (month/year clamping included), so date_format(DUE, 'MM/DD/YYYY',
    // '+30 days') agrees with the browser. Date arithmetic on a date other
    // than today had no other expression: date_format(X, 'X') gives an epoch
    // but nothing reads an epoch back in.
    $ts = _snippet_apply_date_offsets($ts, _snippet_date_format_offsets($args));

    // \x02-guarded like _snippet_now() so the number pass leaves the date alone.
    return "\x02" . date(_snippet_moment_to_php_format(_snippet_date_format_normalize($args)), $ts) . "\x02";
}

function _snippet_date_diff($args, $data = null, $columns = null) {
    if (!isset($args[0]) || !isset($args[1])) {
        return '0';
    }
    $endTime = _snippet_resolve_date_subject($args[0], $data, $columns);
    $startTime = _snippet_resolve_date_subject($args[1], $data, $columns);
    if ($endTime === false || $startTime === false) {
        // 'N/A' when a subject simply had no data (zero-row result set),
        // 'Invalid Date' only for real bad input - engines A and B do the same.
        return _snippet_date_diff_fallback($args[0], $args[1]);
    }

    // Args 2+ rejoined: an unquoted template containing commas arrives split.
    $template = (count($args) > 2) ? implode(', ', array_slice($args, 2)) : 'days';
    $cleanFormat = trim(str_replace(array("'", '"'), '', $template));
    if ($cleanFormat === '') $cleanFormat = 'days';
    $lowerFormat = strtolower($cleanFormat);

    $absDiff = abs($endTime - $startTime);

    // DST-CORRECTED delta, used by the CALENDAR units (day/week) ONLY.
    // moment .diff() subtracts the UTC-offset delta for exactly those two:
    //     day:  (this - that - zoneDelta) / 864e5
    //     week: (this - that - zoneDelta) / 6048e5
    // and NOT for second/minute/hour (those are real elapsed time), nor for
    // the unitless .diff() the TEMPLATE path below mirrors - so $absDiff
    // stays raw for all of those. Without this correction a span crossing a
    // DST boundary lands an hour short of a whole number of days and floor()
    // drops one: 01-JAN-24 -> 15-MAR-24 measured 73.9583 days and mailed 74
    // where the browser said 75 - wrong for most of the year, silently.
    // Engines A and B need no equivalent: they ARE moment. Found by the
    // parity corpus 2026-08-29 (cases dd_days_default / dd_days_reversed /
    // dd_nested_minmax / dd_big_no_commas).
    // date('Z') is seconds east of UTC in the default timezone - the same
    // zone _snippet_resolve_date_subject() resolved these timestamps in.
    $zoneDelta  = (int)date('Z', $startTime) - (int)date('Z', $endTime);
    $absDiffCal = abs(($endTime - $startTime) - $zoneDelta);

    $singleUnits = array('years', 'months', 'weeks', 'days', 'hours', 'minutes', 'seconds',
                         'year', 'month', 'week', 'day', 'hour', 'minute', 'second');
    if (in_array($lowerFormat, $singleUnits, true)) {
        // Scalar path - moment .diff() truncates toward zero to an INTEGER for
        // every unit; the day unit adds +1 to the count of full 24h periods.
        $unit = preg_replace('/s$/', '', $lowerFormat);
        switch ($unit) {
            case 'second': $value = (int)$absDiff; break;
            case 'minute': $value = (int)floor($absDiff / 60); break;
            case 'hour':   $value = (int)floor($absDiff / 3600); break;
            case 'week':   $value = (int)floor($absDiffCal / 604800); break;
            case 'day':    $value = (int)floor($absDiffCal / 86400) + 1; break;
            case 'month':  $value = abs(_snippet_date_diff_months($endTime, $startTime)); break;
            case 'year':   $value = abs(_snippet_date_diff_years($endTime, $startTime)); break;
            default:       $value = (int)floor($absDiffCal / 86400) + 1; break;
        }
        // Guarded: engine A shields date_diff output from its number pass via a
        // string-literal token, so '1500' days must not mail as '1,500'.
        return "\x02" . (string)$value . "\x02";
    }

    // TEMPLATE path - one unsigned decomposition via moment.duration's own
    // bubble algorithm (months = days * 4800/146097, i.e. 30.436875-day
    // months - NOT calendar-walk months; a 365-day span is '0 years,
    // 11 months, 30 days' in the browser and must be here too).
    $seconds = $absDiff;
    $dd = (int)floor($seconds / 86400);
    $rem = $seconds - $dd * 86400;
    $dh = (int)floor($rem / 3600); $rem -= $dh * 3600;
    $dm = (int)floor($rem / 60);
    $ds = (int)($rem - $dm * 60);
    $dM = (int)floor($dd * 4800 / 146097);
    $dd -= (int)ceil($dM * 146097 / 4800);
    if ($dd < 0) $dd = 0;
    $dy = (int)floor($dM / 12);
    $dM = $dM % 12;
    $dw = 0;
    if (preg_match('/weeks?/i', $cleanFormat)) {
        $dw = (int)floor($dd / 7);
        $dd = $dd % 7;
    }

    $unitValues = array('year' => $dy, 'month' => $dM, 'week' => $dw,
                        'day' => $dd, 'hour' => $dh, 'minute' => $dm, 'second' => $ds);
    $result = $cleanFormat;
    foreach ($unitValues as $unitWord => $v) {
        $result = preg_replace_callback('/\b(' . $unitWord . 's?)\b/i', function ($m) use ($v) {
            return $v . ' ' . _snippet_agree_unit_word($m[1], $v);
        }, $result);
    }
    // Guarded for the same reason as the scalar path above.
    return "\x02" . $result . "\x02";
}

function _snippet_date_diff_months($endTime, $startTime) {
    $endY = (int)date('Y', $endTime);
    $endM = (int)date('n', $endTime);
    $endD = (int)date('j', $endTime);
    $startY = (int)date('Y', $startTime);
    $startM = (int)date('n', $startTime);
    $startD = (int)date('j', $startTime);

    $months = ($endY - $startY) * 12 + ($endM - $startM);
    if ($endD < $startD) {
        $months--;
    }
    return $months;
}

function _snippet_date_diff_years($endTime, $startTime) {
    $endY = (int)date('Y', $endTime);
    $endM = (int)date('n', $endTime);
    $endD = (int)date('j', $endTime);
    $startY = (int)date('Y', $startTime);
    $startM = (int)date('n', $startTime);
    $startD = (int)date('j', $startTime);

    $years = $endY - $startY;
    if ($endM < $startM || ($endM === $startM && $endD < $startD)) {
        $years--;
    }
    return $years;
}

function _snippet_string($args) {
    if (empty($args) || !isset($args[0])) {
        return '';
    }
    // \x02 number-guards from nested round()/fixed()/date fns are display
    // armor, not content - strip them from every arg so ops see the real text
    // (string(length, round(x,0)) must not count guard bytes).
    foreach ($args as $k => $v) {
        if (is_string($v) && strpos($v, "\x02") !== false) {
            $args[$k] = str_replace("\x02", '', $v);
        }
