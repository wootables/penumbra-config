                        $_rtLookupIdx = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $at) ? $rtIdx : array_search($at, $aggTypes, true);
                        if ($_rtLookupIdx === false || count($sortedColKeys) === 0) {
