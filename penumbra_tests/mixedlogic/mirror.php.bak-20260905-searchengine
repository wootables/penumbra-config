                        }
                        $csvCellValues[$rowKey]['__runningTotals'][$aggIdx] += $curVal;
                        $csvCellValues[$rowKey][$colKey][$aggIdx] = $csvCellValues[$rowKey]['__runningTotals'][$aggIdx];
                    }
                } elseif ($at === 'running_count' || $at === 'running_count:down') {
                    $curCount = $cellData ? (isset($cellData['count']) ? $cellData['count'] : (isset($cellData['values']) ? count($cellData['values']) : 0)) : 0;
                    if ($at === 'running_count:down') {
                        $csvCellValues[$rowKey][$colKey][$aggIdx] = $curCount;
                    } else {
                        if (!isset($csvCellValues[$rowKey]['__runningCounts'])) {
