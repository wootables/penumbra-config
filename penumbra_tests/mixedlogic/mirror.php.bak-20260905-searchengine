                    if (!isset($_rollWins[$rowKey][$aggIdx])) $_rollWins[$rowKey][$aggIdx] = array();
                    $_rollWins[$rowKey][$aggIdx][] = (is_numeric($rVal) && abs($rVal) < 1e308) ? (float)$rVal : null;
                    $rMean = pivot_roll_mean($_rollWins[$rowKey][$aggIdx], pivot_roll_n($aggType));
