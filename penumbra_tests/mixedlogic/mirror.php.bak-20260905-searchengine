        $freezeRow = $numHeaderRows + 1; // freeze below all header rows

        // Register all header and data strings in shared strings
        foreach ($pdHeaderRows as $hRow) {
            foreach ($hRow as $hVal) {
                $hStr = (string)$hVal;
                if ($hStr !== '' && !isset($ssIndex[$hStr])) {
                    $ssIndex[$hStr] = $ssCount;
                    $sharedStrings[] = $hStr;
                    $ssCount++;
                }
            }
        }
        foreach ($pdDataRows as $dRow) {
            foreach ($dRow as $dVal) {
                $dStr = (string)$dVal;
                if ($dStr !== '') {
                    $cleanNum = str_replace(array('$', ','), '', $dStr);
                    $isNum = (is_numeric($cleanNum) && trim($dStr) !== '');
                    if (!$isNum && !isset($ssIndex[$dStr])) {
                        $ssIndex[$dStr] = $ssCount;
                        $sharedStrings[] = $dStr;
                        $ssCount++;
                    }
                }
            }
        }
        if ($pdFooterRow) {
            foreach ($pdFooterRow as $fVal) {
                $fStr = (string)$fVal;
                if ($fStr !== '') {
                    $cleanNum = str_replace(array('$', ','), '', $fStr);
                    $isNum = (is_numeric($cleanNum) && trim($fStr) !== '');
                    if (!$isNum && !isset($ssIndex[$fStr])) {
                        $ssIndex[$fStr] = $ssCount;
                        $sharedStrings[] = $fStr;
                        $ssCount++;
                    }
                }
            }
        }

        // Compute column widths
        $pivotColWidths = array();
        for ($c = 0; $c < $pdTotalCols; $c++) {
            $maxLen = 10;
            // Check headers
            foreach ($pdHeaderRows as $hRow) {
                if (isset($hRow[$c])) {
                    $len = strlen((string)$hRow[$c]) * 1.2 + 2;
                    if ($len > $maxLen) $maxLen = $len;
                }
            }
            // Check data
            foreach ($pdDataRows as $dRow) {
                if (isset($dRow[$c])) {
                    $len = strlen((string)$dRow[$c]) * 1.2 + 2;
                    if ($len > $maxLen) $maxLen = $len;
                }
            }
            if ($maxLen < 12) $maxLen = 12;
            if ($maxLen > 50) $maxLen = 50;
            $pivotColWidths[$c] = round($maxLen, 2);
        }

        // Helper to pick GT data style from a value string
        // GT styles: 21=plain, 22=$dec, 23=$nodec, 24=commadec, 25=deconly, 26=commaonly
        $_pickGTDataStyle = function($val) {
            $stripped = str_replace(array('$', ','), '', $val);
            if (!is_numeric($stripped) || trim($val) === '') return 21;
            $hasDollar  = (strpos($val, '$') !== false);
            $hasDecimal = (strpos($val, '.') !== false);
            if ($hasDollar) return $hasDecimal ? 22 : 23;
            $hasComma = (strpos($val, ',') !== false);
            if ($hasComma && $hasDecimal) return 24;
            if ($hasDecimal) return 25;
            if ($hasComma) return 26;
            return 21;
        };

        // Helper to pick GT footer style from a value string
        // GT footer styles: 30=plain, 31=$dec, 32=$nodec, 33=commadec, 34=deconly, 35=commaonly
        $_pickGTFooterStyle = function($val) {
            $stripped = str_replace(array('$', ','), '', $val);
            if (!is_numeric($stripped) || trim($val) === '') return 30;
            $hasDollar  = (strpos($val, '$') !== false);
            $hasDecimal = (strpos($val, '.') !== false);
            if ($hasDollar) return $hasDecimal ? 31 : 32;
            $hasComma = (strpos($val, ',') !== false);
            if ($hasComma && $hasDecimal) return 33;
            if ($hasDecimal) return 34;
            if ($hasComma) return 35;
            return 30;
        };

        $xml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            . '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">';

        // Freeze pane below header rows AND to the right of row-field (anchor) columns
        // Use stickyColCount from pivot settings if available (user-configured value),
        // otherwise fall back to numRowFields. Hard cap at 3 matches client-side getStickyClass().
        $pivotCfg = isset($apiResult['pivot']) ? $apiResult['pivot'] : array();
        $stickyCount = isset($pivotCfg['stickyColCount']) && is_numeric($pivotCfg['stickyColCount'])
            ? (int)$pivotCfg['stickyColCount']
            : $pdNumRowFields;
        $frozenCols = min($stickyCount, $pdNumRowFields, 3);
        // Safety: never freeze all columns - leave at least one scrollable
        if ($pdTotalCols > 0 && $frozenCols >= $pdTotalCols) {
            $frozenCols = max(0, $pdTotalCols - 1);
            if ($frozenCols > 3) $frozenCols = 3;
        }
        $freezeColLetter = _xlsx_col_letter($frozenCols); // first unfrozen column letter
        $freezeCell = $freezeColLetter . $freezeRow;
        if ($frozenCols > 0) {
            // Both rows and columns frozen: 4-pane model, activePane = bottomRight
            $xml .= '<sheetViews><sheetView' . ($isFirst ? ' tabSelected="1"' : '') . ' workbookViewId="0">'
                . '<pane xSplit="' . $frozenCols . '" ySplit="' . $numHeaderRows . '" topLeftCell="' . $freezeCell . '" activePane="bottomRight" state="frozen"/>'
                . '<selection pane="bottomRight" activeCell="' . $freezeCell . '" sqref="' . $freezeCell . '"/>'
                . '</sheetView></sheetViews>';
        } else {
            // Only rows frozen
            $freezeCell = 'A' . $freezeRow;
            $xml .= '<sheetViews><sheetView' . ($isFirst ? ' tabSelected="1"' : '') . ' workbookViewId="0">'
                . '<pane ySplit="' . $numHeaderRows . '" topLeftCell="' . $freezeCell . '" activePane="bottomLeft" state="frozen"/>'
                . '<selection pane="bottomLeft" activeCell="' . $freezeCell . '" sqref="' . $freezeCell . '"/>'
                . '</sheetView></sheetViews>';
        }

        // Column widths
        $xml .= '<cols>';
        for ($c = 0; $c < $pdTotalCols; $c++) {
            $colNum = $c + 1;
            $xml .= '<col min="' . $colNum . '" max="' . $colNum . '" width="' . $pivotColWidths[$c] . '" customWidth="1"/>';
        }
        $xml .= '</cols>';

        $xml .= '<sheetData>';

        // --- Header rows ---
        $xlsxRow = 1;
        foreach ($pdHeaderRows as $hri => $hRow) {
            $isSubRow = ($hri === 1 && $pdHasSubRow);
            $xml .= '<row r="' . $xlsxRow . '" ht="22" customHeight="1">';
            for ($c = 0; $c < $pdTotalCols; $c++) {
                $cellRef = _xlsx_col_letter($c) . $xlsxRow;
                $val = isset($hRow[$c]) ? (string)$hRow[$c] : '';
                $colType = isset($pdColTypes[$c]) ? $pdColTypes[$c] : 'data';

                // Determine style
                if ($colType === 'grandTotal') {
                    $styleId = $isSubRow ? 29 : 28; // GT header or GT sub-header
                } elseif ($isSubRow && $val !== '') {
                    $styleId = 27; // sub-header
                } else {
                    $styleId = 1; // normal header
                }

                // Skip empty cells that are part of a merge (they'll be covered by the merge)
                if ($val === '' && $hri === 1) {
                    // First header row: check if this is part of a horizontal merge
                    $inMerge = false;
                    foreach ($pdMerges as $m) {
                        if ($m['row'] === 1 && $c > $m['startCol'] && $c <= $m['endCol']) {
                            $inMerge = true;
                            break;
                        }
                    }
                    if ($inMerge) {
                        // Write an empty styled cell (Excel requires it in merged ranges)
                        $xml .= '<c r="' . $cellRef . '" s="' . $styleId . '"/>';
                        continue;
                    }
                }
                if ($val === '' && $isSubRow && $c < $pdNumRowFields) {
                    // Sub-row: row field placeholders (vertically merged with row 1)
                    $xml .= '<c r="' . $cellRef . '" s="1"/>';
                    continue;
                }

                if ($val !== '' && isset($ssIndex[$val])) {
                    $xml .= '<c r="' . $cellRef . '" t="s" s="' . $styleId . '"><v>' . $ssIndex[$val] . '</v></c>';
                } else {
                    $xml .= '<c r="' . $cellRef . '" s="' . $styleId . '"/>';
                }
            }
            $xml .= '</row>';
            $xlsxRow++;
        }

        // --- Data rows ---
        foreach ($pdDataRows as $ri => $dRow) {
            $isOdd = ($ri % 2 === 0); // 0-indexed: row 0 = odd style
            $xml .= '<row r="' . $xlsxRow . '">';
            for ($c = 0; $c < $pdTotalCols; $c++) {
                $cellRef = _xlsx_col_letter($c) . $xlsxRow;
                $val = isset($dRow[$c]) ? (string)$dRow[$c] : '';
                $colType = isset($pdColTypes[$c]) ? $pdColTypes[$c] : 'data';

                if ($colType === 'grandTotal') {
                    // Grand Total column - always uses GT style (no zebra striping)
                    $styleId = $_pickGTDataStyle($val);
                    $numericVal = _xlsx_try_numeric($val, $val);
                    if ($numericVal !== false) {
                        $xml .= '<c r="' . $cellRef . '" s="' . $styleId . '"><v>' . $numericVal . '</v></c>';
                    } else {
                        if ($val !== '' && isset($ssIndex[$val])) {
                            $xml .= '<c r="' . $cellRef . '" t="s" s="' . $styleId . '"><v>' . $ssIndex[$val] . '</v></c>';
                        } else {
                            $xml .= '<c r="' . $cellRef . '" s="' . $styleId . '"/>';
                        }
                    }
                } elseif ($colType === 'rowField') {
                    // Row field - left-aligned, zebra-striped
                    $styleId = $isOdd ? 2 : 3;
                    if ($val !== '' && isset($ssIndex[$val])) {
                        $xml .= '<c r="' . $cellRef . '" t="s" s="' . $styleId . '"><v>' . $ssIndex[$val] . '</v></c>';
                    } else if ($val !== '') {
                        // register new
                        if (!isset($ssIndex[$val])) {
                            $ssIndex[$val] = $ssCount;
                            $sharedStrings[] = $val;
                            $ssCount++;
                        }
                        $xml .= '<c r="' . $cellRef . '" t="s" s="' . $styleId . '"><v>' . $ssIndex[$val] . '</v></c>';
                    } else {
                        $xml .= '<c r="' . $cellRef . '" s="' . $styleId . '"/>';
                    }
                } else {
                    // Data column - zebra-striped, number-format-aware
                    $styleId = _xlsx_pick_data_style($val, $val, $isOdd);
                    $numericVal = _xlsx_try_numeric($val, $val);
                    if ($numericVal !== false) {
                        $xml .= '<c r="' . $cellRef . '" s="' . $styleId . '"><v>' . $numericVal . '</v></c>';
                    } else {
                        if ($val !== '' && isset($ssIndex[$val])) {
                            $xml .= '<c r="' . $cellRef . '" t="s" s="' . $styleId . '"><v>' . $ssIndex[$val] . '</v></c>';
                        } else if ($val !== '') {
                            if (!isset($ssIndex[$val])) {
                                $ssIndex[$val] = $ssCount;
                                $sharedStrings[] = $val;
                                $ssCount++;
                            }
                            $xml .= '<c r="' . $cellRef . '" t="s" s="' . $styleId . '"><v>' . $ssIndex[$val] . '</v></c>';
                        } else {
                            $xml .= '<c r="' . $cellRef . '" s="' . $styleId . '"/>';
                        }
                    }
                }
            }
            $xml .= '</row>';
            $xlsxRow++;
        }

        // --- Footer row ---
        if ($pdFooterRow) {
            $xml .= '<row r="' . $xlsxRow . '">';
            for ($c = 0; $c < $pdTotalCols; $c++) {
                $cellRef = _xlsx_col_letter($c) . $xlsxRow;
                $val = isset($pdFooterRow[$c]) ? (string)$pdFooterRow[$c] : '';
                $colType = isset($pdColTypes[$c]) ? $pdColTypes[$c] : 'data';

                if ($colType === 'grandTotal') {
                    // GT footer
                    $styleId = $_pickGTFooterStyle($val);
                } else {
                    // Regular footer
                    $styleId = _xlsx_pick_footer_style($val, $val);
                }

                $numericVal = _xlsx_try_numeric($val, $val);
                if ($numericVal !== false) {
                    $xml .= '<c r="' . $cellRef . '" s="' . $styleId . '"><v>' . $numericVal . '</v></c>';
                } else {
                    if ($val !== '' && isset($ssIndex[$val])) {
                        $xml .= '<c r="' . $cellRef . '" t="s" s="' . $styleId . '"><v>' . $ssIndex[$val] . '</v></c>';
                    } else if ($val !== '') {
                        if (!isset($ssIndex[$val])) {
                            $ssIndex[$val] = $ssCount;
                            $sharedStrings[] = $val;
                            $ssCount++;
                        }
                        $xml .= '<c r="' . $cellRef . '" t="s" s="' . $styleId . '"><v>' . $ssIndex[$val] . '</v></c>';
                    } else {
                        $xml .= '<c r="' . $cellRef . '" s="' . $styleId . '"/>';
                    }
                }
            }
            $xml .= '</row>';
            $xlsxRow++;
        }

        $xml .= '</sheetData>';

        // --- Merge cells for multi-agg header colspan and row-field rowspan ---
        $mergeCells = array();

        // Horizontal merges (colspan for multi-agg groups in header row 1)
        foreach ($pdMerges as $m) {
            $startCell = _xlsx_col_letter($m['startCol']) . $m['row'];
            $endCell = _xlsx_col_letter($m['endCol']) . $m['row'];
            if ($startCell !== $endCell) {
                $mergeCells[] = $startCell . ':' . $endCell;
            }
        }

        // Vertical merges (row-field columns spanning both header rows)
        if ($pdHasSubRow) {
            for ($c = 0; $c < $pdNumRowFields; $c++) {
                $startCell = _xlsx_col_letter($c) . '1';
                $endCell = _xlsx_col_letter($c) . $numHeaderRows;
                $mergeCells[] = $startCell . ':' . $endCell;
            }

            // If single agg but GT has sub-headers: data columns need vertical merge too
            if (!$pd['isMulti']) {
                for ($c = $pdNumRowFields; $c < $pdTotalCols; $c++) {
                    if (isset($pdColTypes[$c]) && $pdColTypes[$c] === 'data') {
                        $startCell = _xlsx_col_letter($c) . '1';
                        $endCell = _xlsx_col_letter($c) . $numHeaderRows;
                        $mergeCells[] = $startCell . ':' . $endCell;
                    }
                }
            }
        }

        if (!empty($mergeCells)) {
            $xml .= '<mergeCells count="' . count($mergeCells) . '">';
            foreach ($mergeCells as $mc) {
                $xml .= '<mergeCell ref="' . $mc . '"/>';
            }
            $xml .= '</mergeCells>';
        }

        $xml .= '</worksheet>';

        $fileName = 'sheet' . $sheetIndex . '.xml';
        $sheetFiles[$fileName] = $xml;
        $sheetNames[] = array('name' => 'Pivot Data', 'file' => $fileName, 'id' => $sheetIndex);
        $sheetIndex++;
    }

    // --- Rebuild shared strings XML (footer may have added new entries) ---
    $ssXml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        . '<sst xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" count="' . $ssCount . '" uniqueCount="' . $ssCount . '">';
    foreach ($sharedStrings as $s) {
        if (strpos($s, "\n") !== false || strpos($s, "\r") !== false || $s !== ltrim($s) || $s !== rtrim($s)) {
            $ssXml .= '<si><t xml:space="preserve">' . _xlsx_esc($s) . '</t></si>';
        } else {
            $ssXml .= '<si><t>' . _xlsx_esc($s) . '</t></si>';
        }
    }
    $ssXml .= '</sst>';

    // --- Content_Types.xml (dynamic per sheet count) ---
    $contentTypes = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        . '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
        . '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
        . '<Default Extension="xml" ContentType="application/xml"/>'
        . '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>'
        . '<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>'
        . '<Override PartName="/xl/sharedStrings.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"/>';
    foreach ($sheetNames as $sn) {
        $contentTypes .= '<Override PartName="/xl/worksheets/' . $sn['file'] . '" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>';
    }
    $contentTypes .= '</Types>';

    // _rels/.rels
    $rels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        . '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
        . '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>'
        . '</Relationships>';

    // xl/_rels/workbook.xml.rels (dynamic per sheet count)
    $wbRels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        . '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">';
    foreach ($sheetNames as $sn) {
        $wbRels .= '<Relationship Id="rId' . $sn['id'] . '" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/' . $sn['file'] . '"/>';
    }
    $nextRid = count($sheetNames) + 1;
    $wbRels .= '<Relationship Id="rId' . $nextRid . '" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>';
    $wbRels .= '<Relationship Id="rId' . ($nextRid + 1) . '" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/sharedStrings" Target="sharedStrings.xml"/>';
    $wbRels .= '</Relationships>';

    // xl/workbook.xml (dynamic sheets)
    $workbook = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        . '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'
        . '<sheets>';
    foreach ($sheetNames as $sn) {
        $workbook .= '<sheet name="' . _xlsx_esc($sn['name']) . '" sheetId="' . $sn['id'] . '" r:id="rId' . $sn['id'] . '"/>';
    }
    $workbook .= '</sheets></workbook>';

    // --- Assemble ZIP ---
    $tmpFile = tempnam(sys_get_temp_dir(), 'penumbra_xlsx_');
    if ($tmpFile === false) {
        log_scheduler("XLSX Error: Could not create temp file.");
        return "";
    }

    $zip = new ZipArchive();
    if ($zip->open($tmpFile, ZipArchive::OVERWRITE) !== true) {
        log_scheduler("XLSX Error: Could not open ZipArchive.");
        @unlink($tmpFile);
        return "";
    }

    $zip->addFromString('[Content_Types].xml', $contentTypes);
    $zip->addFromString('_rels/.rels', $rels);
    $zip->addFromString('xl/_rels/workbook.xml.rels', $wbRels);
    $zip->addFromString('xl/workbook.xml', $workbook);
    $zip->addFromString('xl/styles.xml', $styles);
    $zip->addFromString('xl/sharedStrings.xml', $ssXml);
    foreach ($sheetFiles as $fileName => $xml) {
        $zip->addFromString('xl/worksheets/' . $fileName, $xml);
    }
    $zip->close();

    $xlsxData = file_get_contents($tmpFile);
    @unlink($tmpFile);

    return $xlsxData;
}

function _xlsx_pick_data_style($rawVal, $cleanVal, $isOdd) {
    $base = $isOdd ? 0 : 1; // odd styles are at even indices, even styles at odd

    // Multi-line or @@JSON/@@HTML → always plain string style
    if (strpos($cleanVal, "\n") !== false) return $isOdd ? 2 : 3;
    if (substr($rawVal, 0, 6) === '@@JSON' || substr($rawVal, 0, 6) === '@@HTML') return $isOdd ? 2 : 3;

    // Try to parse as number (strip $ and ,)
    $stripped = str_replace(array('$', ','), '', $rawVal);
    if (!is_numeric($stripped) || trim($rawVal) === '') return $isOdd ? 2 : 3;

    $hasDollar  = (strpos($rawVal, '$') !== false);
    $hasComma   = (strpos($rawVal, ',') !== false);
    $hasDecimal = (strpos($rawVal, '.') !== false);

    if ($hasDollar) {
        return $hasDecimal ? (6 + $base) : (8 + $base);   // $#,##0.00 or $#,##0
    }
    if ($hasComma && $hasDecimal) return 10 + $base;       // #,##0.00
    if ($hasDecimal)              return 12 + $base;       // 0.00
    if ($hasComma)                return 14 + $base;       // #,##0

    // Plain integer - no numFmt, just plain data style
    return $isOdd ? 2 : 3;
}

function _xlsx_pick_footer_style($rawVal, $cleanVal) {
    $stripped = str_replace(array('$', ','), '', $rawVal);
    if (!is_numeric($stripped) || trim($rawVal) === '') return 4; // plain footer

    $hasDollar  = (strpos($rawVal, '$') !== false);
    $hasComma   = (strpos($rawVal, ',') !== false);
    $hasDecimal = (strpos($rawVal, '.') !== false);

    if ($hasDollar) {
        return $hasDecimal ? 16 : 17;  // $#,##0.00 or $#,##0
    }
    if ($hasComma && $hasDecimal) return 18;  // #,##0.00
    if ($hasDecimal)              return 19;  // 0.00
    if ($hasComma)                return 20;  // #,##0

    return 4; // plain integer footer
}

function _xlsx_try_numeric($rawVal, $cleanVal) {
    // Multi-line → not numeric
    if (strpos($cleanVal, "\n") !== false) return false;
    if (substr($rawVal, 0, 6) === '@@JSON' || substr($rawVal, 0, 6) === '@@HTML') return false;
    if (trim($rawVal) === '') return false;

    $stripped = str_replace(array('$', ','), '', $rawVal);
    if (is_numeric($stripped)) {
        return (string)(float)$stripped; // Normalize: "1,234.50" → "1234.5"
    }
    // Handle accounting negatives: ($1,234)
    $s = trim($rawVal);
    if (substr($s, 0, 1) === '(' && substr($s, -1) === ')') {
        $inner = str_replace(array('$', ',', '(', ')'), '', $s);
        if (is_numeric($inner)) {
            return (string)(-(float)$inner);
        }
    }
    return false;
}

function _xlsx_html_to_text($html) {
    $text = preg_replace('/<br\s*\/?>/i', "\n", $html);
    $text = preg_replace('/<\/(p|div|li|tr)>/i', "\n", $text);
    $text = strip_tags($text);
    $text = html_entity_decode($text, ENT_QUOTES, 'UTF-8');
    $text = preg_replace("/\n{3,}/", "\n\n", $text);
    return trim($text);
}

function _xlsx_format_json($data, $indent) {
    $space = str_repeat('   ', $indent);
    $lines = array();

    // Helper: strip nested @@HTML prefix and HTML tags from leaf values
    $cleanLeaf = function($v) {
        $s = (string)$v;
        if (strpos($s, '@@HTML') === 0) return strip_tags(substr($s, 6));
        return $s;
    };

    if (is_array($data)) {
        $isAssoc = false;
        if (!empty($data)) {
            $keys = array_keys($data);
            $isAssoc = ($keys !== range(0, count($data) - 1));
        }

        if ($isAssoc) {
            foreach ($data as $key => $val) {
                if (is_array($val)) {
                    $lines[] = $space . $key . ':';
                    $lines[] = _xlsx_format_json($val, $indent + 1);
                } else {
                    $lines[] = $space . $key . ': ' . $cleanLeaf($val);
                }
            }
        } else {
            // Only add blank-line separators for multi-key objects
            $multiKey = (!empty($data) && is_array($data[0]) && count($data[0]) > 1);
            foreach ($data as $i => $item) {
                if (is_array($item)) {
                    if ($i > 0 && $multiKey) $lines[] = '';
                    $lines[] = _xlsx_format_json($item, $indent);
                } else {
                    $lines[] = $space . '- ' . $cleanLeaf($item);
                }
            }
        }
    } else {
        $s = (string)$data;
        if (strpos($s, '@@HTML') === 0) return strip_tags(substr($s, 6));
        return $s;
    }

    return implode("\n", $lines);
}

function _xlsx_col_letter($index) {
    $letter = '';
    while ($index >= 0) {
        $letter = chr(($index % 26) + 65) . $letter;
        $index = intval($index / 26) - 1;
    }
    return $letter;
}

function _xlsx_esc($str) {
    return htmlspecialchars((string)$str, ENT_QUOTES, 'UTF-8');
}

function php_parse_search_query($query, $columns) {
    if (!$query || trim($query) === '') {
        return array();
    }

    // --- Operator map (sorted longest-first for matching priority) ---
    $operators = array(
        '>=' => '>=',
        '=>' => '>=',
        '<=' => '<=',
        '=<' => '<=',
        '!=' => '!=',
        '<>' => '!=',
        '!/' => '!/',
        '==' => '=',
        'eq' => '=',
        'ne' => '!=',
        'gt' => '>',
        'lt' => '<',
        '='  => '=',
        '>'  => '>',
        '<'  => '<'
    );
    $operatorKeys = array_keys($operators);
    // Already sorted longest-first above, but be explicit
    usort($operatorKeys, '_search_sort_by_length_desc');

    // --- Build column map (uppercase key → original name), sorted longest-first ---
    $columnMap = array();
    foreach ($columns as $c) {
        $columnMap[strtoupper($c)] = $c;
    }
    $columnKeys = array_keys($columnMap);
    usort($columnKeys, '_search_sort_by_length_desc');

    // --- Space operators only OUTSIDE protected delimiters ---
    // Regex matches: //exact//, !/regex/flags, /regex/flags, "quoted", 'quoted', or bare operators
    $processedQuery = preg_replace_callback(
        '#(//.*?//|!?/(?:\\\\/|[^/])+/[iI]?|"[^"]*"|\'[^\']*\')|(>=|<=|<>|!=|==|>|<|=)#',
        '_search_space_operators_callback',
        $query
    );

    // --- Tokenize ---
    // Match: {COLUMN}, //exact//, !/regex/, /regex/, "quoted", 'quoted', or non-whitespace
    preg_match_all('#\\{[^}]+\\}|//.*?//|!?/.*?/[iI]?|"[^"]+"|\'[^\']+\'|\\S+#', $processedQuery, $matches);
    $tokens = isset($matches[0]) ? $matches[0] : array();

    // Allow an UNQUOTED month-name + year as a single date value after a comparison
    // operator (e.g. `DATE >= Feb 2025` / `DATE >= 2025 February`), mirroring
    // js/main.js parseAdvancedQuery. The tokenizer split the pair on the space;
    // rejoin it in the value slot so _cf_parse_date sees "Feb 2025" whole. Quoted
    // and no-space forms (2025-02, 02/2025) already work. Only fires immediately
    // after an operator token, so column / global / contains tokens are untouched.
    $_sbMonthTok = '/^(?:jan|january|feb|february|mar|march|apr|april|may|jun|june|jul|july|aug|august|sep|september|oct|october|nov|november|dec|december)$/i';
    $_sbYearTok  = '/^\d{4}$/';
    for ($mi = 0; $mi + 2 < count($tokens); $mi++) {
        if (!in_array($tokens[$mi], $operatorKeys, true)) continue;
        $a = $tokens[$mi + 1]; $b = $tokens[$mi + 2];
        if ((preg_match($_sbMonthTok, $a) && preg_match($_sbYearTok, $b)) ||
            (preg_match($_sbYearTok, $a) && preg_match($_sbMonthTok, $b))) {
            array_splice($tokens, $mi + 1, 2, array($a . ' ' . $b));
        }
    }

    $tokenCount = count($tokens);
    $pos = 0; // current position (replaces closure `i` from JS)

    // --- Parse one expression starting at $pos ---
    // We use a while loop + helper instead of recursion/closures for PHP 5.3 compat

    $queryTree = array();

    while ($pos < $tokenCount) {
        $condition = null;
        $currentTokens = array_slice($tokens, $pos);
        $ctLen = count($currentTokens);

        $firstToken = $currentTokens[0];

        // --- 1. Check for {COLUMN} syntax ---
        if (substr($firstToken, 0, 1) === '{' && substr($firstToken, -1) === '}') {
            $colNameRaw = strtoupper(preg_replace('/^\\{[\'"]?|[\'"]?\\}$/', '', $firstToken));

            $operatorToken = ($ctLen > 1) ? $currentTokens[1] : null;
            $valueToken = ($ctLen > 2) ? $currentTokens[2] : null;
            $opKey = ($operatorToken !== null) ? _search_find_op_key($operatorToken, $operatorKeys) : null;

            if ($opKey !== null && $valueToken !== null) {
                $condition = array(
                    'type'   => 'condition',
                    'column' => $colNameRaw,
                    'op'     => $operators[$opKey],
                    'value'  => $valueToken
                );
                $pos += 3;
            }
        }

        // --- 1b. Check for quoted column names ---
        if ($condition === null) {
            $fFirst = substr($firstToken, 0, 1);
            $fLast  = substr($firstToken, -1);
            if (($fFirst === "'" && $fLast === "'") || ($fFirst === '"' && $fLast === '"')) {
                $unquotedCol = strtoupper(substr($firstToken, 1, -1));
                if (isset($columnMap[$unquotedCol])) {
                    $operatorToken = ($ctLen > 1) ? $currentTokens[1] : null;
                    $valueToken = ($ctLen > 2) ? $currentTokens[2] : null;
                    $opKey = ($operatorToken !== null) ? _search_find_op_key($operatorToken, $operatorKeys) : null;

                    if ($opKey !== null && $valueToken !== null) {
                        $condition = array(
                            'type'   => 'condition',
                            'column' => $columnMap[$unquotedCol],
                            'op'     => $operators[$opKey],
                            'value'  => $valueToken
                        );
                        $pos += 3;
                    } elseif ($opKey === null && $ctLen > 1) {
                        $condition = array(
                            'type'   => 'condition',
                            'column' => $columnMap[$unquotedCol],
                            'op'     => 'contains',
                            'value'  => $currentTokens[1]
                        );
                        $pos += 2;
                    }
                }
            }
        }

        // --- 1c. Special handling for # (row number) column ---
        // Must be checked before standard column detection (mirrors JS parseAdvancedQuery)
        if ($condition === null && $firstToken === '#') {
            $operatorToken = ($ctLen > 1) ? $currentTokens[1] : null;
            $valueToken = ($ctLen > 2) ? $currentTokens[2] : null;
            $opKey = ($operatorToken !== null) ? _search_find_op_key($operatorToken, $operatorKeys) : null;

            if ($opKey !== null && $valueToken !== null) {
                // Explicit: # = 5, # > 10, # >= 1
                $condition = array('type' => 'condition', 'column' => '#', 'op' => $operators[$opKey], 'value' => $valueToken);
                $pos += 3;
            } elseif ($ctLen > 1 && $currentTokens[1] !== null) {
                // Implicit: # 5, # 1-200, # 1,5,10
                $condition = array('type' => 'condition', 'column' => '#', 'op' => '=', 'value' => $currentTokens[1]);
                $pos += 2;
            }
        }

        // --- 2. Standard multi-word column detection (longest match first) ---
        if ($condition === null) {
            foreach ($columnKeys as $colKey) {
                $colKeyWords = explode(' ', $colKey);
                $colWordCount = count($colKeyWords);
                $match = true;

                if ($ctLen < $colWordCount) {
                    $match = false;
                } else {
                    for ($j = 0; $j < $colWordCount; $j++) {
                        $cleaned = preg_replace('/^[\'"]|[\'"]$/', '', $currentTokens[$j]);
                        if (strtoupper($cleaned) !== $colKeyWords[$j]) {
                            $match = false;
                            break;
                        }
                    }
                }

                if ($match) {
                    $operatorTokenIndex = $colWordCount;
                    $opToken = ($operatorTokenIndex < $ctLen) ? $currentTokens[$operatorTokenIndex] : null;
                    $opFound = ($opToken !== null) ? _search_find_op_key($opToken, $operatorKeys) : null;
                    $valueTokenIndex = $operatorTokenIndex + 1;

                    if ($opFound !== null && $valueTokenIndex < $ctLen) {
                        $condition = array(
                            'type'   => 'condition',
                            'column' => $columnMap[$colKey],
                            'op'     => $operators[$opFound],
                            'value'  => $currentTokens[$valueTokenIndex]
                        );
                        $pos += $colWordCount + 2;
                        break;
                    } elseif ($opFound === null && $operatorTokenIndex < $ctLen) {
                        $condition = array(
                            'type'   => 'condition',
                            'column' => $columnMap[$colKey],
                            'op'     => 'contains',
                            'value'  => $currentTokens[$operatorTokenIndex]
                        );
                        $pos += $colWordCount + 1;
                        break;
                    }
                }
            }
        }

        // --- 3. Fallback logic ---
        if ($condition === null) {
            $part1 = $tokens[$pos];
            $part2 = ($pos + 1 < $tokenCount) ? $tokens[$pos + 1] : null;
            $part3 = ($pos + 2 < $tokenCount) ? $tokens[$pos + 2] : null;

            // 3a. Literal comparison fallback (e.g., "1 = 1", "0 < 1")
            // part1 is NOT an operator, part2 IS an operator, part3 exists
            $isPart1Op = _search_find_op_key($part1, $operatorKeys);
            $isPart2Op = ($part2 !== null) ? _search_find_op_key($part2, $operatorKeys) : null;

            if ($isPart1Op === null && $isPart2Op !== null && $part3 !== null) {
                $condition = array(
                    'type'      => 'literal',
                    'leftValue' => $part1,
                    'op'        => $operators[$isPart2Op],
                    'value'     => $part3
                );
                $pos += 3;
            }
            // 3b. Operator-first global (e.g., "= value", "!= value")
            elseif ($isPart1Op !== null && $part2 !== null) {
                $condition = array(
                    'type'  => 'global',
                    'op'    => $operators[$isPart1Op],
                    'value' => $part2
                );
                $pos += 2;
            }
            // 3c. Bare text → global contains
            else {
                $condition = array(
                    'type'  => 'global',
                    'op'    => 'contains',
                    'value' => $part1
                );
                $pos += 1;
            }
        }

        // Only add conditions with non-empty values
        if ($condition !== null && isset($condition['value']) && trim($condition['value']) !== '') {
            $queryTree[] = $condition;
        }

        // --- Check for AND/OR logical keywords ---
        if ($pos < $tokenCount) {
            $nextLower = strtolower($tokens[$pos]);
            if ($nextLower === 'and' || $nextLower === 'or') {
                $queryTree[] = array(
                    'type' => 'logical',
                    'op'   => $nextLower
                );
                $pos++;
            } elseif (count($queryTree) > 0) {
                $lastEntry = $queryTree[count($queryTree) - 1];
                if ($lastEntry['type'] !== 'logical') {
                    // Implicit AND between adjacent conditions
                    $queryTree[] = array('type' => 'logical', 'op' => 'and');
                }
            }
        }
    }

    return $queryTree;
}

function _search_sort_by_length_desc($a, $b) {
    return strlen($b) - strlen($a);
}

function _search_space_operators_callback($matches) {
    // $matches[1] = protected group (regex, exact, quoted) - return as-is
    // $matches[2] = bare operator - surround with spaces
    if (isset($matches[1]) && $matches[1] !== '') {
        return $matches[1];
    }
    return ' ' . $matches[2] . ' ';
}

function _search_find_op_key($token, $operatorKeys) {
    foreach ($operatorKeys as $opKey) {
        if ($opKey === $token) {
            return $opKey;
        }
    }
    return null;
}

function php_evaluate_search_row($row, $parsedQuery, $columns, $requireRowMatch = false) {
    if (!$parsedQuery || count($parsedQuery) === 0) {
        return true;
    }
    if ($requireRowMatch) {
        return _php_evaluate_with_row_match($row, $parsedQuery, $columns);
    }

    // Normal path: compute virtual cols and call inner function
    $needsVirtual = false;
    foreach ($parsedQuery as $_qp) {
        if ($_qp['type'] === 'global' || $_qp['type'] === 'condition') {
            $needsVirtual = true;
            break;
        }
    }
    $virtualCols = $needsVirtual ? _search_get_virtual_columns($row) : array();
    return _php_evaluate_search_row_with_virtual($row, $parsedQuery, $columns, $virtualCols);
}

function _php_evaluate_search_row_with_virtual($row, $parsedQuery, $columns, $virtualCols) {
    // Build a case-insensitive lookup map of the row
    $rowUpper = array();
    foreach ($row as $k => $v) {
        $rowUpper[strtoupper($k)] = $v;
    }

    $results = array();
    $ops = array();

    foreach ($parsedQuery as $part) {
        if ($part['type'] === 'logical') {
            $ops[] = $part['op'];
            continue;
        }

        $matched = false;

        // --- Literal comparison ---
        if ($part['type'] === 'literal') {
            $leftVal = (string)$part['leftValue'];
            $matched = php_test_search_condition($part['op'], $part['value'], $leftVal, $row, $columns);
        }
        // --- Global search (all columns) ---
        elseif ($part['type'] === 'global') {
            $isNegation = ($part['op'] === '!=' || $part['op'] === '<>' || $part['op'] === '!/');

            if ($isNegation) {
                // Negation: row matches only if NO column matches the positive version
                $positiveOp = ($part['op'] === '!/') ? 'contains' : '=';
                $anyMatched = false;
                foreach ($columns as $colName) {
                    $cellText = _search_get_cell_value($colName, $rowUpper);
                    if (php_test_search_condition($positiveOp, $part['value'], $cellText, $row, $columns)) {
                        $anyMatched = true;
                        break;
                    }
                }
                // Also check virtual columns from @@JSON cells
                if (!$anyMatched && !empty($virtualCols)) {
                    foreach ($virtualCols as $vColValues) {
                        foreach ($vColValues as $vVal) {
                            if (php_test_search_condition($positiveOp, $part['value'], $vVal, $row, $columns)) {
                                $anyMatched = true;
                                break 2;
                            }
                        }
                    }
                }
                $matched = !$anyMatched;
            } else {
                // Positive: row matches if ANY column matches
                foreach ($columns as $colName) {
                    $cellText = _search_get_cell_value($colName, $rowUpper);
                    if (php_test_search_condition($part['op'], $part['value'], $cellText, $row, $columns)) {
                        $matched = true;
                        break;
                    }
                }
                // Also check virtual columns from @@JSON cells
                if (!$matched && !empty($virtualCols)) {
                    foreach ($virtualCols as $vColValues) {
                        foreach ($vColValues as $vVal) {
                            if (php_test_search_condition($part['op'], $part['value'], $vVal, $row, $columns)) {
                                $matched = true;
                                break 2;
                            }
                        }
                    }
                }
            }
        }
        // --- Column-specific condition ---
        elseif ($part['type'] === 'condition') {
            $colName = preg_replace('/^\\{[\'"]?|[\'"]?\\}$/', '', $part['column']);
            $upperCol = strtoupper($colName);

            // Virtual columns take priority over main columns (matches JS behavior)
            if (!empty($virtualCols) && isset($virtualCols[$upperCol])) {
                // Match if ANY nested value satisfies the condition
                foreach ($virtualCols[$upperCol] as $vVal) {
                    if (php_test_search_condition($part['op'], $part['value'], $vVal, $row, $columns)) {
                        $matched = true;
                        break;
                    }
                }
            } else {
                // Fall back to main column
                $cellText = _search_get_cell_value($colName, $rowUpper);
                $matched = php_test_search_condition($part['op'], $part['value'], $cellText, $row, $columns);
            }
        }

        $results[] = $matched;
    }

    // --- Combine results: AND first, then OR ---
    // Process AND operators (left to right)
    for ($i = 0; $i < count($ops); $i++) {
        if ($ops[$i] === 'and') {
            $results[$i + 1] = ($results[$i] && $results[$i + 1]);
            $results[$i] = 'processed';
        }
    }
    // OR: any remaining non-processed result being true means match
    $orResults = array();
    foreach ($results as $r) {
        if ($r !== 'processed') {
            $orResults[] = $r;
        }
    }

    if (count($orResults) === 0) {
        return false;
    }
    foreach ($orResults as $r) {
        if ($r) return true;
    }
    return false;
}

function _php_evaluate_with_row_match($row, $parsedQuery, $columns) {
    $sources = _search_get_structured_virtual_data($row);
    if (empty($sources)) {
        // No @@JSON data - fall through to normal evaluation
        $virtualCols = _search_get_virtual_columns($row);
        return _php_evaluate_search_row_with_virtual($row, $parsedQuery, $columns, $virtualCols);
    }

    // Collect column names referenced in conditions
    $referencedCols = array();
    foreach ($parsedQuery as $part) {
        if ($part['type'] === 'condition' && isset($part['column'])) {
            $col = strtoupper(preg_replace('/^\\{[\'"]?|[\'"]?\\}$/', '', $part['column']));
            $referencedCols[$col] = true;
        }
    }

    // Find which sources are referenced by at least one targeted condition
    $referencedSourceIdxs = array();
    for ($si = 0; $si < count($sources); $si++) {
        foreach ($referencedCols as $col => $dummy) {
            if (in_array($col, $sources[$si]['columns'])) {
                $referencedSourceIdxs[] = $si;
                break;
            }
        }
    }

    // If no conditions target any nested column, fall through to normal eval
    if (empty($referencedSourceIdxs)) {
        $virtualCols = _search_get_virtual_columns($row);
        return _php_evaluate_search_row_with_virtual($row, $parsedQuery, $columns, $virtualCols);
    }

    // Get the full flattened virtual columns (for non-iterated sources)
    $fullVirtual = _search_get_virtual_columns($row);

    // Iterate each referenced source's rows
    foreach ($referencedSourceIdxs as $srcIdx) {
        $iterSource = $sources[$srcIdx];

        foreach ($iterSource['rows'] as $singleRow) {
            // Build projected virtual cols: start with full arrays
            $projected = $fullVirtual; // PHP copies arrays

            // Override columns from THIS source with single-row values
            foreach ($singleRow as $col => $val) {
                $projected[$col] = array($val); // single-element array
            }

            // Evaluate with projected virtual columns
            $passed = _php_evaluate_search_row_with_virtual($row, $parsedQuery, $columns, $projected);

            if ($passed) {
                return true;
            }
        }
    }

    // No sub-table row satisfied the query
    return false;
}

function _search_get_virtual_columns($row) {
    $virtualCols = array();
    foreach ($row as $colName => $cellValue) {
        $strVal = ($cellValue === null) ? '' : (string)$cellValue;
        $jsonIdx = strpos($strVal, '@@JSON');
        if ($jsonIdx === false) continue;

        $jsonStr = substr($strVal, $jsonIdx + 6);
        $jsonData = json_decode($jsonStr, true);
        if (!is_array($jsonData) || !isset($jsonData[0]) || !is_array($jsonData[0])) continue;

        $keys = array_keys($jsonData[0]);
        foreach ($keys as $key) {
            $upperKey = strtoupper($key);
            if (!isset($virtualCols[$upperKey])) {
                $virtualCols[$upperKey] = array();
            }
            foreach ($jsonData as $jsonRow) {
                $val = isset($jsonRow[$key]) ? $jsonRow[$key] : '';
                $virtualCols[$upperKey][] = ($val === null) ? '' : (string)$val;
            }
        }
    }
    return $virtualCols;
}

function _search_get_structured_virtual_data($row) {
    $sources = array();
    foreach ($row as $colName => $cellValue) {
        $strVal = ($cellValue === null) ? '' : (string)$cellValue;
        $jsonIdx = strpos($strVal, '@@JSON');
        if ($jsonIdx === false) continue;

        $jsonStr = substr($strVal, $jsonIdx + 6);
        $jsonData = json_decode($jsonStr, true);
        if (!is_array($jsonData) || empty($jsonData) || !is_array($jsonData[0])) continue;

        $keys = array_keys($jsonData[0]);
        $columns = array();
        foreach ($keys as $k) {
            $columns[] = strtoupper($k);
        }

        $rows = array();
        foreach ($jsonData as $jsonRow) {
            $rowMap = array();
            foreach ($keys as $k) {
                $val = isset($jsonRow[$k]) ? $jsonRow[$k] : '';
                $rowMap[strtoupper($k)] = ($val === null) ? '' : (string)$val;
            }
            $rows[] = $rowMap;
        }

        $sources[] = array('columns' => $columns, 'rows' => $rows);
    }
    return $sources;
}

function _search_get_cell_value($colName, $rowUpper) {
    $key = strtoupper($colName);
    $raw = isset($rowUpper[$key]) ? (string)$rowUpper[$key] : '';

    // Strip @@HTML prefix
    if (strpos($raw, '@@HTML') === 0) {
        $raw = substr($raw, 6);
    }

    // Strip HTML tags and trim
    return trim(strip_tags($raw));
}

function php_test_search_condition($op, $searchValue, $cellText, $row = null, $columns = null) {
    // 1. Strip quotes from searchValue
    $compareValue = trim(preg_replace('/^[\'"]|[\'"]$/', '', (string)$searchValue));

    // 2. Resolve {COLUMN} placeholders
    if (preg_match('/^\\{([^}]+)\\}$/', $compareValue, $phMatch)) {
        if ($row !== null) {
            $rowUpper = array();
            foreach ($row as $k => $v) {
                $rowUpper[strtoupper($k)] = $v;
            }
            $compareValue = _search_get_cell_value($phMatch[1], $rowUpper);
        }
    }

    // 3. Empty check
    if (strtolower($compareValue) === 'empty') {
        return ($op === '=') ? ($cellText === '') : ($cellText !== '');
    }

    // 4. Exact match: //pattern// (literal, not regex - escape metacharacters)
    if (substr($compareValue, 0, 2) === '//' && substr($compareValue, -2) === '//') {
        $pattern = preg_quote(substr($compareValue, 2, -2), '/');
        // Anchored match, case-insensitive
        $result = @preg_match('/^' . $pattern . '$/i', $cellText);
        if ($result === false) return false; // safety fallback
        $matched = ($result === 1);
        return ($op === '!=' || $op === '<>') ? !$matched : $matched;
    }

    // 5. Free regex: /pattern/ or !/ operator
    if ($op === '!/' || (substr($compareValue, 0, 1) === '/' && strlen($compareValue) > 1)) {
        if ($op === '!/') {
            $pattern = $compareValue;
            $flags = 'i';
        } else {
            // Extract pattern between slashes, check for trailing flag
            $lastSlash = strrpos($compareValue, '/');
            if ($lastSlash > 0) {
                $pattern = substr($compareValue, 1, $lastSlash - 1);
                $trailingFlag = substr($compareValue, $lastSlash + 1);
                // Case-sensitive if ends with uppercase I
                $flags = ($trailingFlag === 'I') ? '' : 'i';
            } else {
                $pattern = substr($compareValue, 1);
                $flags = 'i';
            }
        }

        $result = @preg_match('/' . $pattern . '/' . $flags, $cellText);
        if ($result === false) return false; // invalid regex
        $matched = ($result === 1);
        return ($op === '!=' || $op === '<>' || $op === '!/') ? !$matched : $matched;
    }

    // 6. Numeric comparison
    // Strict numeric check: only treat as number if it looks purely numeric/currency/percentage
    // Uses same regex as JS isNumericStr: proper thousands formatting required

    // 6a. Range/list logic FIRST (e.g., "1-5" or "1,5,10")
    // Only if compareValue contains comma or dash but is NOT itself a standalone number
    $isRangeCandidate = !_search_is_numeric_str($compareValue)
        && (strpos($compareValue, ',') !== false || strpos($compareValue, '-') !== false);

    if (_search_is_numeric_str($cellText) && $isRangeCandidate) {
        // Ensure compareValue contains only valid range chars
        if (preg_match('/^[\\d,\\-\\.\\$%\\s]+$/', $compareValue)) {
            $cellNum = (float)preg_replace('/[\\$,%]/', '', $cellText);
            if (!is_nan($cellNum)) {
                $isInList = _search_num_in_range_list($cellNum, $compareValue);
                if ($op === '=' || $op === 'contains') return $isInList;
                if ($op === '!=' || $op === '<>') return !$isInList;
            }
        }
    }

    // 6b. Standard numeric comparison
    if (_search_is_numeric_str($cellText) && _search_is_numeric_str($compareValue)) {
        $cellNum = (float)preg_replace('/[\\$,%]/', '', $cellText);
        $searchNum = (float)preg_replace('/[\\$,%]/', '', $compareValue);

        if (!is_nan($cellNum) && !is_nan($searchNum)) {
            switch ($op) {
                case '=':       return $cellNum == $searchNum;
                case '!=':      return $cellNum != $searchNum;
                case '>':       return $cellNum > $searchNum;
                case '<':       return $cellNum < $searchNum;
                case '>=':      return $cellNum >= $searchNum;
                case '<=':      return $cellNum <= $searchNum;
                case 'contains': return $cellNum == $searchNum;
            }
        }
    }

    // 7. Date comparison (skip for 'contains' - date comparison only for =, !=, >, <, >=, <=)
    if ($op !== 'contains') {
        // The keyword form first (strtotime does not understand SYSDATE-7), then
        // the pre-existing loose strtotime for everything else, so nothing that
        // used to parse here stops parsing. English phrases are deliberately NOT
        // resolved by us on this path any more - whatever strtotime made of them
        // before this feature, it makes of them again.
        $relResolved = _sr_resolve_keyword_date($compareValue);
        $searchTs = ($relResolved !== null) ? @strtotime($relResolved) : @strtotime($compareValue);
        if ($searchTs !== false && $searchTs !== -1) {
            $cellTs = @strtotime($cellText);
            if ($cellTs !== false && $cellTs !== -1) {
                switch ($op) {
                    case '=':  return date('Y-m-d', $cellTs) === date('Y-m-d', $searchTs);
                    case '!=': return date('Y-m-d', $cellTs) !== date('Y-m-d', $searchTs);
                    case '>':  return $cellTs > $searchTs;
                    case '<':  return $cellTs < $searchTs;
                    case '>=': return $cellTs >= $searchTs;
                    case '<=': return $cellTs <= $searchTs;
                }
            }
        }
    }

    // 8. Text comparison
    $cleanCell = strtolower(trim($cellText));
    $cleanSearch = strtolower(trim($compareValue));

    if ($op === 'contains') {
        return ($cleanSearch === '') ? true : (strpos($cleanCell, $cleanSearch) !== false);
    }
    if ($op === '=') {
        if ($cleanCell === $cleanSearch) return true;
        // Slugify fallback: strip non-alphanumeric, compare
        $slugCell = preg_replace('/[^a-z0-9]/', '', $cleanCell);
        $slugSearch = preg_replace('/[^a-z0-9]/', '', $cleanSearch);
        return $slugCell === $slugSearch;
    }
    if ($op === '!=') {
        return $cleanCell !== $cleanSearch;
    }

    return false;
}

function _search_is_numeric_str($str) {
    return (bool)preg_match('/^[-+]?\\$?(\\d{1,3}(,\\d{3})*|\\d+)(\\.\\d+)?%?$/', (string)$str);
}

function _search_num_in_range_list($num, $rangeListStr) {
    $items = explode(',', (string)$rangeListStr);
    foreach ($items as $item) {
        $item = trim($item);
        if (strpos($item, '-') !== false) {
            $parts = explode('-', $item, 2);
            $min = (float)preg_replace('/[\\$,%]/', '', $parts[0]);
            $max = (float)preg_replace('/[\\$,%]/', '', $parts[1]);
            if (!is_nan($min) && !is_nan($max) && $num >= $min && $num <= $max) {
                return true;
            }
        } else {
            $sNum = (float)preg_replace('/[\\$,%]/', '', $item);
            if (!is_nan($sNum) && $num == $sNum) {
                return true;
            }
        }
    }
    return false;
}

function _journal_normalize_toggle_conditions($parsedQuery, $toggleResolver) {
    if (!$toggleResolver || empty($parsedQuery) || empty($toggleResolver['colNames'])) return $parsedQuery;
    $names = array();
    foreach ($toggleResolver['colNames'] as $n) $names[strtoupper((string)$n)] = true;
    foreach ($parsedQuery as $i => $part) {
        if (!isset($part['type']) || $part['type'] !== 'condition' || !isset($part['column'])) continue;
        $colName = preg_replace('/^\{[\'"]?|[\'"]?\}$/', '', (string)$part['column']);
        if (!isset($names[strtoupper($colName)])) continue;
        $want = journalToggleWantExport(isset($part['value']) ? $part['value'] : '');
        if ($want === null) continue; // not a toggle-ish value; leave it alone
        $parsedQuery[$i]['value'] = $want ? '1' : '0';
    }
    return $parsedQuery;
}

function php_apply_search_filter($data, $viewMode, $searchFilter, $recipientVars = null, $toggleResolver = null) {
    if (!$searchFilter || trim($searchFilter) === '') {
        return $data;
    }

    $resolvedFilter = $searchFilter;

    // Resolve per-recipient variables if provided
    if ($recipientVars !== null && is_array($recipientVars)) {
        $varMap = array(
            '{FNAME}'    => isset($recipientVars['fname'])    ? $recipientVars['fname']    : '',
            '{LNAME}'    => isset($recipientVars['lname'])    ? $recipientVars['lname']    : '',
            '{USERNAME}' => isset($recipientVars['username']) ? $recipientVars['username'] : '',
            '{EMAIL}'    => isset($recipientVars['email'])    ? $recipientVars['email']    : '',
            '{OUC2D}'    => isset($recipientVars['ouc2d'])    ? $recipientVars['ouc2d']    : '',
            '{OUC4D}'    => isset($recipientVars['ouc4d'])    ? $recipientVars['ouc4d']    : '',
            '{OUC6D}'    => isset($recipientVars['ouc6d'])    ? $recipientVars['ouc6d']    : '',
            '{DEPT}'     => isset($recipientVars['dept'])     ? $recipientVars['dept']     : '',
            '{OUC}'      => isset($recipientVars['ouc'])      ? $recipientVars['ouc']      : '',
            '{EMPL_ID}'  => isset($recipientVars['empl_id'])  ? $recipientVars['empl_id']  : '',
            '{EMPL_ID4}' => _sr_empl_id4($recipientVars)
        );
        foreach ($varMap as $placeholder => $value) {
            $resolvedFilter = str_ireplace($placeholder, $value, $resolvedFilter);
        }
    }

    // Determine columns from the first row of data
    $columns = array();
    if ($viewMode === 'grouped') {
        // Grouped data: array of groups, each group has rows
        // Find first non-empty group to get columns
        foreach ($data as $group) {
            if (is_array($group) && !empty($group)) {
                // Check if group is an array of rows (numeric keys) or has a 'rows' key
                $firstRow = null;
                if (isset($group['rows']) && is_array($group['rows']) && !empty($group['rows'])) {
                    $firstRow = $group['rows'][0];
                } elseif (isset($group[0]) && is_array($group[0])) {
                    $firstRow = $group[0];
                }
                if ($firstRow !== null) {
                    $columns = array_keys($firstRow);
                    break;
                }
            }
        }
    } else {
        // Standard or pivot: flat array of rows
        if (!empty($data) && is_array($data)) {
            $firstRow = reset($data);
            if (is_array($firstRow)) {
                $columns = array_keys($firstRow);
            }
        }
    }

    if (empty($columns)) {
        return $data;
    }

    // Add # to columns so the parser recognizes it as a valid column
    if (!in_array('#', $columns)) {
        $columns[] = '#';
    }

    // Add virtual column names from @@JSON cells so the parser recognizes them
    // (e.g., SPECIES, COUNT from nested sub-tables). Without this, queries like
    // "SPECIES = Chicken" fall through to global search and fail to match.
    $firstDataRow = null;
    if ($viewMode === 'grouped') {
        foreach ($data as $group) {
            if (is_array($group) && !empty($group)) {
                if (isset($group['rows']) && is_array($group['rows']) && !empty($group['rows'])) {
                    $firstDataRow = $group['rows'][0];
                } elseif (isset($group[0]) && is_array($group[0])) {
                    $firstDataRow = $group[0];
                }
                if ($firstDataRow !== null) break;
            }
        }
    } else {
        if (!empty($data) && is_array($data)) {
            $firstDataRow = reset($data);
        }
    }
    if ($firstDataRow !== null) {
        $virtualCols = _search_get_virtual_columns($firstDataRow);
        foreach ($virtualCols as $vColName => $vColValues) {
            if (!in_array($vColName, array_map('strtoupper', $columns))) {
                $columns[] = $vColName;
            }
        }
    }

    // Journal toggle columns are filter-time VIRTUAL columns: registered here so
    // the parser recognizes "Done", and evaluated per row below - but never
    // written into the rows themselves, so rawData (snapshots, change diffs,
    // DB dumps) stays clean. Same shape as the synthetic '#' column above.
    // Without this the condition degrades to a literal comparison that is always
    // false, which reads as a legitimately empty report rather than an error.
    if ($toggleResolver && !empty($toggleResolver['colNames'])) {
        foreach ($toggleResolver['colNames'] as $tName) {
            if (!in_array(strtoupper($tName), array_map('strtoupper', $columns))) {
                $columns[] = $tName;
            }
        }
    }

    // Detect __ROW modifier: require nested-column conditions to match within same sub-table row
    $requireRowMatch = false;
    if (preg_match('/^__ROW\s+/i', $resolvedFilter)) {
        $requireRowMatch = true;
        $resolvedFilter = preg_replace('/^__ROW\s+/i', '', $resolvedFilter);
    }

    $parsedQuery = php_parse_search_query($resolvedFilter, $columns);
    if (empty($parsedQuery)) {
        return $data;
    }
    // "Done = ☑" -> "Done = 1" (the stored form). Must run AFTER parsing so we
    // only rewrite values whose column is actually a toggle.
    $parsedQuery = _journal_normalize_toggle_conditions($parsedQuery, $toggleResolver);

    // Filter based on viewMode
    if ($viewMode === 'grouped') {
        $filtered = array();
        $globalRowNum = 0; // Global row counter across all groups
        foreach ($data as $groupKey => $group) {
            // Determine group row structure
            $rows = null;
            $hasRowsKey = false;
            if (isset($group['rows']) && is_array($group['rows'])) {
                $rows = $group['rows'];
                $hasRowsKey = true;
            } elseif (is_array($group) && isset($group[0]) && is_array($group[0])) {
                $rows = $group;
            }

            if ($rows === null) {
                continue;
            }

            $filteredRows = array();
            foreach ($rows as $row) {
                $globalRowNum++;
                // Inject # (1-based row number) for evaluation, matching front-end behavior
                $evalRow = $row;
                $evalRow['#'] = (string)$globalRowNum;
                if ($toggleResolver) {
                    foreach (journalExportToggleRowValues($toggleResolver, $row) as $tn => $tv) $evalRow[$tn] = $tv;
                }
                if (php_evaluate_search_row($evalRow, $parsedQuery, $columns, $requireRowMatch)) {
                    $filteredRows[] = $row; // Keep original row without injected # / toggles
                }
            }

            // Only keep non-empty groups
            if (!empty($filteredRows)) {
                if ($hasRowsKey) {
                    $newGroup = $group;
                    $newGroup['rows'] = array_values($filteredRows);
                    $filtered[$groupKey] = $newGroup;
                } else {
                    $filtered[$groupKey] = array_values($filteredRows);
                }
            }
        }
        return $filtered;
    } else {
        // Standard or pivot: filter flat array of rows
        $filtered = array();
        $rowNum = 0;
        foreach ($data as $row) {
            $rowNum++;
            if (is_array($row)) {
                // Inject # (1-based row number) for evaluation, matching front-end behavior
                $evalRow = $row;
                $evalRow['#'] = (string)$rowNum;
                if ($toggleResolver) {
                    foreach (journalExportToggleRowValues($toggleResolver, $row) as $tn => $tv) $evalRow[$tn] = $tv;
                }
                if (php_evaluate_search_row($evalRow, $parsedQuery, $columns, $requireRowMatch)) {
                    $filtered[] = $row; // Keep original row without injected # / toggles
                }
            }
        }
        return array_values($filtered);
    }
}

function apply_search_filter_via_raw($apiResult, $searchFilter, $recipientVars = null) {
    $rawData = isset($apiResult['rawData']) ? $apiResult['rawData'] : (isset($apiResult['data']) ? $apiResult['data'] : array());

    // For pivot mode, processedData = rawData (pivot needs all columns)
    $isPivot = (isset($apiResult['viewMode']) && $apiResult['viewMode'] === 'pivot') ||
               (isset($apiResult['pivot']) && !empty($apiResult['pivot']));

    // Grouped report with a per-group summary whose label the filter references
    // (e.g. "Sum of AMOUNT > 50000")? Then summary conditions filter whole GROUPS:
    // row conditions narrow rows first, the summary is recomputed on the survivors,
    // and groups failing the summary are dropped. Mirrors runTableSearch() in main.js.
    $groupBy  = isset($apiResult['groupBy']) ? $apiResult['groupBy'] : null;
    $groupAgg = (isset($apiResult['groupAgg']) && is_array($apiResult['groupAgg'])) ? $apiResult['groupAgg'] : null;
    $summaryLabel = (!$isPivot && $groupBy && $groupAgg) ? _cf_group_summary_label($groupAgg) : null;
    if ($summaryLabel) {
        $resolvedFilter = _cf_resolve_filter_recipient_vars($searchFilter, $recipientVars);
        if (stripos($resolvedFilter, $summaryLabel) !== false) {
            return _cf_apply_group_summary_filter($apiResult, $rawData, $resolvedFilter, $groupBy, $groupAgg, $summaryLabel);
        }
    }

    // Filter rawData (flat, all columns including hidden ones). The journal
    // toggle resolver lets the filter see "Done" as a column without writing it
    // into rawData - see php_apply_search_filter().
    $journalToggleResolver = isset($apiResult['journalToggleResolver']) ? $apiResult['journalToggleResolver'] : null;
    $journalToggleCols = (isset($apiResult['journalToggleCols']) && is_array($apiResult['journalToggleCols']))
        ? $apiResult['journalToggleCols'] : array();
    $filteredRaw = php_apply_search_filter($rawData, 'standard', $searchFilter, $recipientVars, $journalToggleResolver);
    $apiResult['rawData'] = $filteredRaw;

    if ($isPivot) {
        $apiResult['data'] = $filteredRaw;
    } else {
        // Re-derive processedData with column visibility, sorting, grouping
        // $apiResult contains the merged $state keys (sortCriteria, visibleColumns, columnOrder, groupBy, etc.)
        // Materialize the toggle columns onto a COPY first (rawData above stays
        // clean for snapshots/diffs), then pass their names as $preserveCols so
        // they survive this rebuild. Without BOTH halves the toggle column
        // silently disappeared from the delivered output whenever ANY search
        // filter, on any column, was configured.
        $forProcessing = $filteredRaw;
        if ($journalToggleResolver && !empty($forProcessing)) {
            foreach ($forProcessing as &$_jtRow) {
                if (!is_array($_jtRow)) continue;
                foreach (journalExportToggleRowValues($journalToggleResolver, $_jtRow) as $tn => $tv) {
                    $_jtRow[$tn] = $tv;
                }
            }
            unset($_jtRow);
        }
        $reprocessed = apply_state_logic($forProcessing, $apiResult, $journalToggleCols);
        $apiResult['data'] = $reprocessed['data'];
        $apiResult['viewMode'] = $reprocessed['viewMode'];
        if (isset($reprocessed['groupAgg'])) {
            $apiResult['groupAgg'] = $reprocessed['groupAgg'];
        }
    }

    return $apiResult;
}

function _cf_resolve_filter_recipient_vars($searchFilter, $recipientVars) {
    if ($recipientVars === null || !is_array($recipientVars)) return $searchFilter;
    $varMap = array(
        '{FNAME}'    => isset($recipientVars['fname'])    ? $recipientVars['fname']    : '',
        '{LNAME}'    => isset($recipientVars['lname'])    ? $recipientVars['lname']    : '',
        '{USERNAME}' => isset($recipientVars['username']) ? $recipientVars['username'] : '',
        '{EMAIL}'    => isset($recipientVars['email'])    ? $recipientVars['email']    : '',
        '{OUC2D}'    => isset($recipientVars['ouc2d'])    ? $recipientVars['ouc2d']    : '',
        '{OUC4D}'    => isset($recipientVars['ouc4d'])    ? $recipientVars['ouc4d']    : '',
        '{OUC6D}'    => isset($recipientVars['ouc6d'])    ? $recipientVars['ouc6d']    : '',
        '{DEPT}'     => isset($recipientVars['dept'])     ? $recipientVars['dept']     : '',
        '{OUC}'      => isset($recipientVars['ouc'])      ? $recipientVars['ouc']      : '',
        '{EMPL_ID}'  => isset($recipientVars['empl_id'])  ? $recipientVars['empl_id']  : '',
        '{EMPL_ID4}' => _sr_empl_id4($recipientVars)
    );
    return str_ireplace(array_keys($varMap), array_values($varMap), $searchFilter);
}

function _sr_sql_token_sub($sql, $probe) {
    if (!is_string($sql) || $sql === '') return $sql;
    $out      = '';
    $len      = strlen($sql);
    $i        = 0;
    $inString = false;
    while ($i < $len) {
        $ch = $sql[$i];

        // Comment bodies are inert, but any tokens inside them must still be
        // consumed (a downstream leftover-token check scans the whole string, so
        // an unresolved token in a comment would keep the query from executing).
        // Resolved bare and WITHOUT touching quote state - an apostrophe in
        // `-- don't do this` would otherwise flip $inString and mis-quote every
        // later token.
        if (!$inString && $ch === '-' && $i + 1 < $len && $sql[$i + 1] === '-') {
            $nl  = strpos($sql, "\n", $i);
            $seg = ($nl === false) ? substr($sql, $i) : substr($sql, $i, $nl - $i + 1);
            $out .= _sr_sql_token_sub_bare($seg, $probe);
            $i  += strlen($seg);
            continue;
        }
        if (!$inString && $ch === '/' && $i + 1 < $len && $sql[$i + 1] === '*') {
            $end = strpos($sql, '*/', $i + 2);
            $seg = ($end === false) ? substr($sql, $i) : substr($sql, $i, $end - $i + 2);
            $out .= _sr_sql_token_sub_bare($seg, $probe);
            $i  += strlen($seg);
            continue;
        }

        if ($ch === "'") {
            // A doubled '' inside a literal is an escaped quote, not a terminator.
            if ($inString && $i + 1 < $len && $sql[$i + 1] === "'") {
                $out .= "''";
                $i += 2;
                continue;
            }
            $inString = !$inString;
            $out .= $ch;
            $i++;
            continue;
        }

        $hit = $probe($sql, $i);
        if ($hit !== null) {
            $esc = str_replace("'", "''", (string)$hit[1]);
            $out .= $inString ? $esc : "'" . $esc . "'";
            $i  += $hit[0];
            continue;
        }

        $out .= $ch;
        $i++;
    }
    return $out;
}

function _sr_sql_token_sub_bare($seg, $probe) {
    $out = '';
    $len = strlen($seg);
    $i   = 0;
    while ($i < $len) {
        $hit = $probe($seg, $i);
        if ($hit !== null) {
            $out .= str_replace("'", "''", (string)$hit[1]);
            $i  += $hit[0];
            continue;
        }
        $out .= $seg[$i];
        $i++;
    }
    return $out;
}

function _sr_substitute_recipient_vars_sql($sql, $recipientVars) {
    if ($recipientVars === null || !is_array($recipientVars) || !is_string($sql) || $sql === '') return $sql;
    $varMap = array(
        'FNAME'    => isset($recipientVars['fname'])    ? $recipientVars['fname']    : '',
        'LNAME'    => isset($recipientVars['lname'])    ? $recipientVars['lname']    : '',
        'USERNAME' => isset($recipientVars['username']) ? $recipientVars['username'] : '',
        'EMAIL'    => isset($recipientVars['email'])    ? $recipientVars['email']    : '',
        'OUC2D'    => isset($recipientVars['ouc2d'])    ? $recipientVars['ouc2d']    : '',
        'OUC4D'    => isset($recipientVars['ouc4d'])    ? $recipientVars['ouc4d']    : '',
        'OUC6D'    => isset($recipientVars['ouc6d'])    ? $recipientVars['ouc6d']    : '',
        'DEPT'     => isset($recipientVars['dept'])     ? $recipientVars['dept']     : '',
        'OUC'      => isset($recipientVars['ouc'])      ? $recipientVars['ouc']      : '',
        'EMPL_ID'  => isset($recipientVars['empl_id'])  ? $recipientVars['empl_id']  : '',
        'EMPL_ID4' => _sr_empl_id4($recipientVars)
    );
    $probe = function($s, $i) use ($varMap) {
        if ($s[$i] !== '{') return null;
        if (!preg_match('/^\{([A-Za-z0-9_]+)\}/', substr($s, $i, 16), $m)) return null;
        $key = strtoupper($m[1]);
        if (!array_key_exists($key, $varMap)) return null;
        return array(strlen($m[0]), $varMap[$key]);
    };
    return _sr_sql_token_sub($sql, $probe);
}

function _sr_substitute_me_map_sql($sql, $meMap) {
    if (!is_array($meMap) || empty($meMap) || !is_string($sql) || $sql === '') return $sql;
    // Normalize keys to lowercase so me(OUC) and me(ouc) both resolve.
    $normMap = array();
    foreach ($meMap as $k => $v) { $normMap[strtolower(trim((string)$k))] = $v; }
    $probe = function($s, $i) use ($normMap) {
        $c = $s[$i];
        if ($c !== 'm' && $c !== 'M') return null;
        // Enforce a word boundary before 'me(' (mirrors query.php's \bme\() so we
        // do not match the 'me(' inside e.g. frame(...).
        if ($i > 0) {
            $p = $s[$i - 1];
            if (($p >= 'A' && $p <= 'Z') || ($p >= 'a' && $p <= 'z') || ($p >= '0' && $p <= '9') || $p === '_') return null;
        }
        if (!preg_match('/^me\(\s*([A-Za-z0-9_]*)\s*\)/i', substr($s, $i, 40), $m)) return null;
        $key = strtolower($m[1]);
        if (!array_key_exists($key, $normMap)) return null; // unmapped -> leave for query.php to empty
        return array(strlen($m[0]), $normMap[$key]);
    };
    return _sr_sql_token_sub($sql, $probe);
}

function _cf_apply_group_summary_filter($apiResult, $rawData, $resolvedFilter, $groupBy, $groupAgg, $summaryLabel) {
    // Build the column list from raw rows (+ '#', virtual cols, and the summary label).
    $columns = array();
    if (!empty($rawData) && is_array($rawData)) {
        $firstRow = reset($rawData);
        if (is_array($firstRow)) $columns = array_keys($firstRow);
    }
    if (!in_array('#', $columns)) $columns[] = '#';
    if (!empty($rawData)) {
        $firstRow = reset($rawData);
        if (is_array($firstRow)) {
            $virtualCols = _search_get_virtual_columns($firstRow);
            $upperCols = array_map('strtoupper', $columns);
            foreach ($virtualCols as $vColName => $vColValues) {
                if (!in_array($vColName, $upperCols)) $columns[] = $vColName;
            }
        }
    }
    if (!in_array(strtoupper($summaryLabel), array_map('strtoupper', $columns))) {
        $columns[] = $summaryLabel;
    }

    // __ROW modifier (correlate nested-column conditions within one sub-table row).
    $requireRowMatch = false;
    if (preg_match('/^__ROW\s+/i', $resolvedFilter)) {
        $requireRowMatch = true;
        $resolvedFilter = preg_replace('/^__ROW\s+/i', '', $resolvedFilter);
    }

    $parsedQuery = php_parse_search_query($resolvedFilter, $columns);
    $split = _cf_split_group_summary_query($parsedQuery, strtoupper($summaryLabel));
    $rowParts = $split['rowParts'];
    $summaryConds = $split['summaryConds'];

    // 1. Narrow flat rows by the row-level conditions (summary conditions excluded).
    $filteredRaw = array();
    $rowNum = 0;
    foreach ($rawData as $row) {
        $rowNum++;
        if (!is_array($row)) continue;
        if (empty($rowParts)) {
            $filteredRaw[] = $row;
            continue;
        }
        $evalRow = $row;
        $evalRow['#'] = (string)$rowNum;
        if (php_evaluate_search_row($evalRow, $rowParts, $columns, $requireRowMatch)) {
            $filteredRaw[] = $row;
        }
    }
    $filteredRaw = array_values($filteredRaw);
    $apiResult['rawData'] = $filteredRaw;

    // 2. Re-group the survivors.
    $reprocessed = apply_state_logic($filteredRaw, $apiResult);
    $grouped = $reprocessed['data'];
    $gAgg = isset($reprocessed['groupAgg']) ? $reprocessed['groupAgg'] : $groupAgg;
    $apiResult['viewMode'] = $reprocessed['viewMode'];
    $apiResult['groupAgg'] = $gAgg;

    // 3. Drop groups whose recomputed summary fails the summary conditions.
    if (!empty($summaryConds) && $reprocessed['viewMode'] === 'grouped' && is_array($grouped)) {
        $aggCol  = isset($gAgg['column']) ? $gAgg['column'] : null;
        $aggType = isset($gAgg['type'])   ? $gAgg['type']   : null;
        $gbCol   = isset($gAgg['groupByCol']) ? $gAgg['groupByCol'] : $groupBy;
        if ($aggCol && $aggType) {
            $kept = array();
            foreach ($grouped as $gKey => $group) {
                $rows = null;
                if (isset($group['rows']) && is_array($group['rows'])) {
                    $rows = $group['rows'];
                } elseif (is_array($group) && isset($group[0]) && is_array($group[0])) {
                    $rows = $group;
                } elseif (is_array($group)) {
                    $rows = $group;
                }
                if ($rows === null) { $kept[$gKey] = $group; continue; }
                $raw = _cf_compute_group_agg_raw($rows, $aggCol, $aggType, $gbCol, $gKey);
                if (_cf_match_group_summary($raw['value'], $raw['isDate'], $summaryConds)) {
                    $kept[$gKey] = $group;
                }
            }
            $grouped = $kept;
        }
    }

    $apiResult['data'] = $grouped;
    return $apiResult;
}

function _sr_empl_id4($vars) {
    if (!is_array($vars) || !isset($vars['empl_id'])) return '';
    $id = trim((string)$vars['empl_id']);
    return ($id === '') ? '' : substr($id, -4);
}

function lookup_recipient_coi_details($conn, $email) {
    $result = array('empl_id' => '', 'ouc' => '', 'ouc2d' => '', 'ouc4d' => '', 'ouc6d' => '', 'dept' => '', 'fname' => '', 'lname' => '');
    if (!$conn || empty($email)) return $result;
    try {
        $stmt = $conn->prepare("SELECT EMPLOYEE_ID, DEPARTMENT, FIRST_NAME, LAST_NAME FROM COI_CHECK_COMPLIANCE WHERE UPPER(EMAIL) = UPPER(:email) FETCH FIRST 1 ROWS ONLY");
        $stmt->bindValue(':email', $email, PDO::PARAM_STR);
        $stmt->execute();
        $row = $stmt->fetch(PDO::FETCH_ASSOC);
        if ($row) {
            $result['empl_id'] = isset($row['EMPLOYEE_ID']) ? trim((string)$row['EMPLOYEE_ID']) : '';
            $deptRaw = isset($row['DEPARTMENT']) ? trim((string)$row['DEPARTMENT']) : '';
            // OUC and DEPT both come from penumbra_directory.php, the single
            // resolver shared with get_email_recipients.php (which feeds the
            // scheduler form's live preview) and the analytics pages - so a
            // {DEPT} previewed, a {DEPT} sent, and a department charted all mean
            // the same thing. Do not re-derive either value here.
            $split = penumbraSplitDepartment($deptRaw);
            // OUC = first 6 characters of DEPARTMENT; may not always be digits for older units
            $result['ouc'] = $split['ouc'];
            // Derived OUC substrings
            $result['ouc2d'] = (strlen($result['ouc']) >= 2) ? substr($result['ouc'], 0, 2) : $result['ouc'];
            $result['ouc4d'] = (strlen($result['ouc']) >= 4) ? substr($result['ouc'], 0, 4) : $result['ouc'];
            $result['ouc6d'] = $result['ouc'];
            // DEPT = the department NAME. Strips the OUC prefix for BOTH live
            // separator forms - "066204 - X" AND the commoner "068301-X", which
            // the old " - "-only split here missed, sending the whole raw string.
            $result['dept'] = penumbraRecipientDept($deptRaw);
            // Name fields
            $result['fname'] = isset($row['FIRST_NAME']) ? trim((string)$row['FIRST_NAME']) : '';
            $result['lname'] = isset($row['LAST_NAME']) ? trim((string)$row['LAST_NAME']) : '';
        }
    } catch (Exception $e) {
        log_scheduler("Warning: COI lookup failed for '$email': " . $e->getMessage());
    }
    return $result;
}

function db_dump_clean_value($val) {
    if (!is_string($val) || $val === '') return $val;
    if (strpos($val, '@@HTML') === 0) {
        $stripped = strip_tags(substr($val, 6));
        return html_entity_decode($stripped, ENT_QUOTES, 'UTF-8');
    }
    if (strpos($val, '@@JSON') === 0) {
        return substr($val, 6);
    }
    // query.php also htmlspecialchars()-encodes raw string cells (line ~931).
    // Decode entities so &amp;/&lt;/&gt;/&quot;/&#039; restore to & < > " ' -
    // the dump should contain plaintext, not HTML-escaped plaintext.
    if (strpos($val, '&') !== false) {
        return html_entity_decode($val, ENT_QUOTES, 'UTF-8');
    }
    return $val;
}

function db_dump_type_from_meta($meta) {
    if (!is_array($meta)) return null;
    $native = isset($meta['native_type']) ? strtoupper($meta['native_type']) : '';
    if ($native === '') return null;

    // Strings - use the driver-reported length when reasonable, else VARCHAR2(4000).
    // We pad slightly (×1.5, min 50) because query.php sometimes wraps values with
    // @@HTML/<a>...</a> display markup that exceeds the raw column length. CLOB
    // stays CLOB but we materialize as VARCHAR2(4000) in v1 (no CLOB target
    // support yet - the runner truncates over-4000 values).
    if (in_array($native, array('VARCHAR2', 'VARCHAR', 'NVARCHAR2', 'CHAR', 'NCHAR'), true)) {
        $len = isset($meta['len']) ? (int)$meta['len'] : 0;
        if ($len <= 0) $len = 4000;
        $size = max(50, (int)($len * 1.5));
        if ($size > 4000) $size = 4000;
        return "VARCHAR2($size)";
    }
    if (in_array($native, array('CLOB', 'NCLOB', 'LONG'), true)) {
        return 'VARCHAR2(4000)'; // v1 fallback; over-length values truncated on insert
    }
    if ($native === 'NUMBER') {
        $prec  = isset($meta['precision']) ? (int)$meta['precision'] : 0;
        $scale = isset($meta['scale'])     ? (int)$meta['scale']     : -1;
        // Bare NUMBER (no precision) is fine and most flexible. Only declare
        // NUMBER(p,s) when both are real positive values - otherwise Oracle
        // may reject the declaration (e.g. scale=-127 means "any").
        if ($prec > 0 && $scale >= 0 && $scale <= $prec) return "NUMBER($prec,$scale)";
        return 'NUMBER';
    }
    // Map DATE/TIMESTAMP to VARCHAR2 in the destination, even when metadata
    // says otherwise. Reason: query.php fetches DATE values as strings via
    // PDO_OCI using whatever NLS_DATE_FORMAT the session has (e.g. MM/DD/YYYY
    // for this Oracle instance), and inserting them back into a real DATE
    // column requires TO_DATE() with a matching format - and the format may
    // differ across deployments or even rows. Storing as VARCHAR2(50)
    // preserves the user-visible string exactly; downstream queries that
    // need DATE semantics can TO_DATE() at consume time.
    if (in_array($native, array('DATE', 'TIMESTAMP'), true)) return 'VARCHAR2(50)';
    if (strpos($native, 'TIMESTAMP') === 0) return 'VARCHAR2(50)';
    if (in_array($native, array('FLOAT', 'BINARY_FLOAT', 'BINARY_DOUBLE'), true)) return $native;
    // Unknown / exotic native type - let the caller fall back to inference.
    return null;
}

function db_dump_ddl_type_families() {
    static $families = null;
    if ($families !== null) return $families;
    $families = array();
    $charTypes = array('VARCHAR2', 'NVARCHAR2', 'CHAR', 'NCHAR', 'VARCHAR', 'NVARCHAR',
                       'TEXT', 'NTEXT', 'CLOB', 'NCLOB', 'LONG');
    $numTypes  = array('NUMBER', 'INT', 'INTEGER', 'BIGINT', 'SMALLINT', 'TINYINT',
                       'DECIMAL', 'NUMERIC', 'FLOAT', 'REAL', 'MONEY', 'SMALLMONEY',
                       'BINARY_FLOAT', 'BINARY_DOUBLE');
    foreach (array(__DIR__ . '/cache/ddl_oracle.txt', __DIR__ . '/cache/ddl_mssql.txt') as $path) {
        if (!is_readable($path)) continue;
        $fh = @fopen($path, 'r');
        if (!$fh) continue;
        while (($line = fgets($fh)) !== false) {
            // Column lines look like "    COLNAME TYPE(...)[ NOT NULL],". The
            // "CREATE TABLE x (", "-- Table: x" and ");" lines never match.
            if (!preg_match('/^\s{4}(\S+)\s+([A-Za-z_0-9]+)/', $line, $m)) continue;
            $type = strtoupper($m[2]);
            if (in_array($type, $charTypes, true))     { $fam = 'char'; }
            else if (in_array($type, $numTypes, true)) { $fam = 'num'; }
            else                                       { continue; } // DATE/BIT/BLOB - not our call
            $col = strtoupper($m[1]);
            if (!isset($families[$col])) $families[$col] = array();
            $families[$col][$fam] = true;
        }
        fclose($fh);
    }
    return $families;
}

function db_dump_ddl_says_character($col) {
    $families = db_dump_ddl_type_families();
    $col = strtoupper(trim((string)$col));
    if (!isset($families[$col])) return false;
    return isset($families[$col]['char']) && !isset($families[$col]['num']);
}

function db_dump_existing_column_fits($existing_type, $new_type, $max_len) {
    $existing_type = strtoupper(trim((string)$existing_type));
    $new_type      = strtoupper(trim((string)$new_type));
    if ($existing_type === '' || $new_type === '') return false;

    // Split "VARCHAR2(80)" / "NUMBER" into family + declared size.
    $ex_family = $existing_type;
    $ex_size   = null;
    if (preg_match('/^([A-Z0-9_]+)\s*\(\s*(\d+)/', $existing_type, $m)) {
        $ex_family = $m[1];
        $ex_size   = (int)$m[2];
    }
    $new_family = $new_type;
    if (preg_match('/^([A-Z0-9_]+)\s*\(/', $new_type, $m2)) $new_family = $m2[1];

    $numeric = array('NUMBER', 'FLOAT', 'BINARY_FLOAT', 'BINARY_DOUBLE');

    // A LOB can hold anything this builder emits.
    if (in_array($ex_family, array('CLOB', 'NCLOB', 'LONG'), true)) return true;

    if (in_array($ex_family, array('VARCHAR2', 'NVARCHAR2', 'CHAR', 'NCHAR'), true)) {
        // Character column: the only risk is the widest value not fitting.
        if ($ex_size === null) return true;
        return ((int)$max_len <= $ex_size);
    }
    if (in_array($ex_family, $numeric, true)) {
        // A numeric column can only keep holding numeric output.
        return in_array($new_family, $numeric, true);
    }
    // DATE/TIMESTAMP/RAW/anything else: this builder never emits them, so a
    // match would be coincidental. Rebuild rather than gamble.
    return false;
}

function db_dump_ctas_eligible($options, $preflight, &$why = null) {
    $why = '';
    if (empty($options['dbdump_strip_html'])) {
        $why = 'Strip all HTML is off - raw SQL cannot reproduce the @@HTML display markup the buffered path stores';
        return false;
    }
    if (!empty($preflight['pivot']) || !empty($preflight['groupByColumn']) || !empty($preflight['group_by'])) {
        $why = 'report is in a pivot or grouped view';
        return false;
    }
    foreach (array('search_filter' => 'a saved search filter',
                   'custom_condition' => 'a custom skip condition') as $k => $label) {
        if (isset($options[$k]) && trim((string)$options[$k]) !== '') { $why = "task has $label"; return false; }
    }
    if (!empty($options['skip_no_change'])) { $why = 'skip_no_change needs the rows in PHP'; return false; }
    if (!empty($options['skip_empty']))     { $why = 'skip_empty needs the rows in PHP';     return false; }
    if (isset($options['dbdump_reload_mode']) && $options['dbdump_reload_mode'] === 'truncate') {
        // Preserve-table mode exists precisely so the table OBJECT survives a
        // reload - "grants, indexes, triggers, and dependent views survive"
        // (see the reload-strategy block). CTAS is DROP + CREATE + RENAME, so it
        // would destroy every one of those without the owner ever being asked.
        // Refuse and let the run fall back, so the choice stays theirs.
        $why = 'task uses preserve-table (truncate) reload, and CTAS would drop the table object '
             . 'along with its indexes, triggers and dependent views';
        return false;
    }

    $mode = isset($options['dbdump_columns_mode']) ? $options['dbdump_columns_mode'] : 'visible';
    $cols = (isset($options['dbdump_columns_custom']) && is_array($options['dbdump_columns_custom']))
          ? $options['dbdump_columns_custom'] : array();
    if ($mode !== 'custom' || empty($cols)) {
        $why = "columns mode is '$mode' - CTAS needs an explicit custom column list";
        return false;
    }

    $sql = isset($preflight['resolvedQuery']) ? trim((string)$preflight['resolvedQuery']) : '';
    if ($sql === '' || !preg_match('/^\s*(SELECT|WITH)\b/i', $sql)) {
        $why = 'resolved query is not a plain SELECT';
        return false;
    }

    // Every picked column must exist in the RAW query result. A column present
    // only in the processed view is computed at display time and has no SQL
    // behind it - CTAS would omit it without a word.
    $rawRow = null;
    if (isset($preflight['rawData']) && is_array($preflight['rawData'])) {
        foreach ($preflight['rawData'] as $r) { if (is_array($r)) { $rawRow = $r; break; } }
    }
    if ($rawRow === null) {
        $why = 'pre-flight returned no raw row to validate the column list against';
        return false;
    }
    $rawUpper = array();
    foreach ($rawRow as $k => $v) { $rawUpper[strtoupper(trim((string)$k))] = true; }
    $missing = array();
    foreach ($cols as $c) { if (!isset($rawUpper[strtoupper(trim((string)$c))])) $missing[] = $c; }
    if (!empty($missing)) {
        $why = 'column(s) exist only in the processed view, so they are display-computed and have no SQL: '
             . implode(', ', $missing);
        return false;
    }

    $table = isset($options['destination_table']) ? strtoupper(trim($options['destination_table'])) : '';
    if ($table === '' || strlen($table) > 28) {
        $why = 'destination name leaves no room for the _X build table (atomic swap required)';
        return false;
    }
    return true;
}

function db_dump_build_ctas_select($resolvedQuery, $columns, $rowLimit = 0) {
    $inner = rtrim(trim((string)$resolvedQuery), "; \t\n\r");
    $cols  = array();
    foreach ($columns as $c) { $cols[] = '"' . strtoupper(trim((string)$c)) . '"'; }
    $sql = 'SELECT ' . implode(', ', $cols) . ' FROM (' . $inner . ')';
    $rowLimit = (int)$rowLimit;
    if ($rowLimit > 0) {
        // ORDER BY 1 before the cap, matching query.php's limiter exactly and for
        // the same reason it gives: "Ensure deterministic row ordering when
        // applying a limit". A bare ROWNUM predicate returns an ARBITRARY subset,
        // so two runs of the same capped task could dump different rows. Only
        // added when a cap is actually in play - sorting 135k rows to then keep
        // all of them would be pure cost.
        $sql .= ' ORDER BY 1 FETCH FIRST ' . $rowLimit . ' ROWS ONLY';
    }
    return $sql;
}

function db_dump_stream_eligible($stream_requested, $options, $state, $driver_types_on, &$why = null) {
    $why = '';
    if (!$stream_requested) {
        $why = 'not enabled for this task';
        return false;
    }
    if (!$driver_types_on) {
        $why = 'driver column types are off - streaming must CREATE before any row arrives';
        return false;
    }
    if (!empty($state['pivot'])) {
        $why = 'report is in pivot view';
        return false;
    }
    if (!empty($state['groupByColumn']) || !empty($state['group_by'])) {
        $why = 'report is grouped';
        return false;
    }
    if (isset($options['search_filter']) && trim((string)$options['search_filter']) !== '') {
        $why = 'task has a saved search filter';
        return false;
    }
    if (!empty($options['skip_no_change'])) {
        $why = 'skip_no_change buffers the whole dataset for its snapshot anyway';
        return false;
    }
    if (!empty($options['skip_empty'])) {
        // The skip decision needs the row count BEFORE anything is built, and a
        // streamed run only learns it at the trailer - by which point the build
        // table exists and rows are in it. Refusing is simpler than unwinding.
        $why = 'skip_empty needs the row count before the build starts';
        return false;
    }
    if (isset($options['custom_condition']) && trim((string)$options['custom_condition']) !== '') {
        $why = 'task has a custom skip condition';
        return false;
    }
    $mode = isset($options['dbdump_columns_mode']) ? $options['dbdump_columns_mode'] : 'visible';
    $cols = (isset($options['dbdump_columns_custom']) && is_array($options['dbdump_columns_custom']))
          ? $options['dbdump_columns_custom'] : array();
    if ($mode !== 'custom' || empty($cols)) {
        $why = "columns mode is '$mode' - v1 streaming needs an explicit custom column list";
        return false;
    }
    $table = isset($options['destination_table']) ? strtoupper(trim($options['destination_table'])) : '';
    if ($table === '' || strlen($table) > 28) {
        $why = 'destination name leaves no room for the _X build table (atomic swap required)';
        return false;
    }
    return true;
}

function db_dump_resolve_column_types($rows, $columns_meta, &$provenance_out = null, &$facts_out = null, $allow_meta_only = false) {
    // $provenance_out reports which source won per column ('meta'|'ddl'|'inferred').
    // A non-empty $columns_meta does NOT imply any column resolved from it: a
    // driver can return well-formed entries carrying no usable native_type, in
    // which case every column silently falls back to inference.
    // $facts_out surfaces the per-column data evidence (notably max_len) so the
    // caller can ask db_dump_existing_column_fits() whether a preserved column
    // still works, without re-scanning every row.
    //
    // $allow_meta_only lets a caller resolve the column set from driver metadata
    // ALONE, with no rows in hand. Default false preserves the historical
    // contract exactly: no rows => no columns => the caller skips the run and
    // leaves the existing destination table intact. The batched/streaming
    // DB_DUMP path passes true because it must CREATE the destination before it
    // has read a single row - see the ordering note below for what that path
    // still has to narrow for itself.
    $provenance_out = array();
    // Start from inference so we have correct upper-case column names + a
    // safe fallback for any column the driver didn't return metadata for.
    // $facts carries the evidence (widths, leading zeros) the DDL layer reuses.
    $rows_present = (is_array($rows) && count($rows) > 0);
    $facts = array();
    $inferred = infer_db_dump_column_types($rows, $facts);
    $facts_out = $facts;

    // Build name → type map from columns_meta. The 'name' field is whatever
    // the query SELECT'd it as (alias-respecting), so uppercase it to match.
    $meta_by_name = array();
    if (is_array($columns_meta)) {
        foreach ($columns_meta as $m) {
            if (!is_array($m) || empty($m['name'])) continue;
            $key = strtoupper(trim((string)$m['name']));
            // Same identifier rule inference applies to row keys. A column the
            // driver named is no more insertable than an inferred one if Oracle
            // cannot name it unquoted. Only warn when there were no rows to
            // infer from - otherwise inference has already logged this column
            // and a second line would double-report every bad alias.
            if (!preg_match('/^[A-Z][A-Z0-9_]{0,29}$/', $key)) {
                if (!$rows_present) {
                    log_scheduler("  Warning: DB_DUMP skipping column '" . $m['name'] . "' - the name needs a quoted Oracle identifier"
                        . " (usually because it contains a space). Re-alias it with letters, digits and underscores only,"
                        . " e.g. AS " . strtoupper(preg_replace('/[^A-Za-z0-9_]+/', '_', trim((string)$m['name']))) . ".");
                }
                continue;
            }
            $type = db_dump_type_from_meta($m);
            if ($type !== null) $meta_by_name[$key] = $type;
        }
    }

    // Nothing to build from: no rows AND either no usable metadata or a caller
    // that did not opt into metadata-only resolution. Returning empty is what
    // makes the caller skip the run and leave the existing table intact.
    if (empty($inferred) && !($allow_meta_only && !empty($meta_by_name))) return array();

    // Column SET and ORDER stay with inference whenever rows are present;
    // metadata contributes TYPES only. Two reasons, both load-bearing:
    //   1. $rows at the call site is ALREADY narrowed by the task's column mode
    //      (visible/custom), while $columns_meta still describes the full driver
    //      result. Taking the set from metadata here would resurrect every
    //      column the user deliberately excluded, as an all-NULL column.
    //   2. The caller detects schema drift with !== on the column-name arrays,
    //      which is order-sensitive - reordering would force a one-time rebuild
    //      of every existing preserve-table destination for no gain.
    // With no rows, metadata is the only source of both. A caller passing
    // $allow_meta_only is responsible for narrowing $columns_meta to the task's
    // column mode BEFORE calling; this function cannot infer that intent.
    $ordered = $rows_present ? array_keys($inferred) : array_keys($meta_by_name);

    // Prefer the metadata-derived type; fall back to inference per column.
    $out = array();
    foreach ($ordered as $col) {
        $inferred_type = isset($inferred[$col]) ? $inferred[$col] : null;
        if (isset($meta_by_name[$col])) {
            $out[$col] = $meta_by_name[$col];
            $provenance_out[$col] = 'meta';
        } else if ($inferred_type === 'NUMBER' && db_dump_ddl_says_character($col)) {
            // The driver gave no usable type and the data is all digits, so
            // inference wants NUMBER - but the source schema calls this column
            // character in every table that declares it. That makes it an
            // identifier, and NUMBER would strip its leading zeros on insert.
            // Only ever widens NUMBER -> VARCHAR2, never the reverse, so a wrong
            // hint costs a text column rather than destroyed data.
            $size = isset($facts[$col]['varchar_size']) ? $facts[$col]['varchar_size'] : 50;
            $out[$col] = "VARCHAR2($size)";
            $provenance_out[$col] = 'ddl';
        } else if ($inferred_type !== null) {
            $out[$col] = $inferred_type;
            $provenance_out[$col] = 'inferred';
        } else {
            // Metadata listed the column but reported no usable native_type,
            // and there are no rows to infer from. Nothing honest to declare,
            // so leave it out rather than guess a width the insert would
            // silently truncate against.
            continue;
        }
        // db_dump_existing_column_fits() reads max_len to decide whether an
        // existing column is still wide enough to preserve. Inference fills
        // that from the real data; on the metadata-only path there is no data,
        // so synthesize it from the declared width. A missing entry reads as 0
        // there, which waves through a column that may be far too narrow.
        if (!isset($facts_out[$col])) {
            $declared = 0;
            if (preg_match('/\((\d+)/', $out[$col], $dm)) $declared = (int)$dm[1];
            $facts_out[$col] = array(
                'max_len'      => $declared,
                'varchar_size' => ($declared > 0 ? $declared : 50),
                'leading_zero' => false,
                'all_digits'   => false,
            );
        }
    }
    return $out;
}

function infer_db_dump_column_types($rows, &$facts_out = null) {
    // $facts_out exposes the per-column evidence behind each decision so callers
    // can apply extra hint sources without re-scanning the rows:
    //   [UPPER_NAME => ['max_len'=>int, 'varchar_size'=>int,
    //                   'leading_zero'=>bool, 'all_digits'=>bool]]
    $facts_out = array();
    if (!is_array($rows) || count($rows) === 0) return array();
    // Use first row's keys to establish column order (PHP arrays preserve
    // insertion order; the report driver hands rows back in the query's
    // SELECT-list order).
    $first = null;
    foreach ($rows as $r) { if (is_array($r)) { $first = $r; break; } }
    if (!$first) return array();

    $cols = array();
    foreach (array_keys($first) as $rawName) {
        $name = strtoupper(trim((string)$rawName));
        if (!preg_match('/^[A-Z][A-Z0-9_]{0,29}$/', $name)) {
            // Say what is actually wrong. The old wording - "use an AS alias" -
            // misfires on the common case, which is a column that IS aliased,
            // as a QUOTED identifier containing a space ("FISCAL YEAR"). The
            // author reads it, sees their alias, and has no idea what to change.
            log_scheduler("  Warning: DB_DUMP skipping column '$rawName' - the name needs a quoted Oracle identifier"
                . " (usually because it contains a space). Re-alias it with letters, digits and underscores only,"
                . " e.g. AS " . strtoupper(preg_replace('/[^A-Za-z0-9_]+/', '_', trim((string)$rawName))) . ".");
            continue;
        }
        $cols[$name] = array(
            'orig'         => $rawName,
            'all_int'      => true,
            'all_decimal'  => true,
            'max_len'      => 0,
            'any_value'    => false,
            'leading_zero' => false,
        );
    }
    if (empty($cols)) return array();

    foreach ($rows as $row) {
        if (!is_array($row)) continue;
        foreach ($cols as $name => &$info) {
            $v = isset($row[$info['orig']]) ? $row[$info['orig']] : null;
            if ($v === null || $v === '') continue;
            $info['any_value'] = true;
            $sv = is_string($v) ? $v : (string)$v;
            $len = strlen($sv);
            if ($len > $info['max_len']) $info['max_len'] = $len;
            if ($info['all_int']     && !preg_match('/^-?\d+$/', $sv))                $info['all_int']     = false;
            if ($info['all_decimal'] && !preg_match('/^-?\d+(\.\d+)?$/', $sv))         $info['all_decimal'] = false;
            // A digit string with a SIGNIFICANT leading zero is an identifier
            // (EMPLOYEE_ID '001234567', zip '02134'), never a quantity. Typing
            // it NUMBER silently destroys the zeros on insert. Matches '007' and
            // '00' but deliberately not '0', '0.5' or '-0.5', which are numbers.
            if (!$info['leading_zero'] && preg_match('/^-?0\d/', $sv))                $info['leading_zero'] = true;
        }
        unset($info);
    }

    $out = array();
    foreach ($cols as $name => $info) {
        $size = max(50, $info['max_len'] * 2);
        if ($size > 4000) $size = 4000;
        $facts_out[$name] = array(
            'max_len'      => $info['max_len'],
            'varchar_size' => $size,
            'leading_zero' => $info['leading_zero'],
            'all_digits'   => ($info['any_value'] && ($info['all_int'] || $info['all_decimal'])),
        );
        if (!$info['any_value']) {
            // No non-empty values seen - default to VARCHAR2(50). Better than
            // guessing NUMBER (which would reject any future non-numeric value).
            $out[$name] = 'VARCHAR2(50)';
            continue;
        }
        if (($info['all_int'] || $info['all_decimal']) && !$info['leading_zero']) {
            $out[$name] = 'NUMBER';
        } else {
            $out[$name] = "VARCHAR2($size)";
        }
    }
    return $out;
}

function _sr_normalize_auth_list($authorized_raw) {
    $items = array_map('trim', explode(',', (string)$authorized_raw));
    $list = array();
    foreach ($items as $raw_item) {
        $normalized = extractAuthIdentifier($raw_item);
        if ($normalized !== '') $list[] = strtoupper($normalized);
    }
    return $list;
}

function _sr_recipient_auth_failure($entry, $authorized_list, $owner_id, $oracleConn) {
    global $allowedUsers; // From db_connection.php (Admins)
    $r = trim((string)$entry);
    if ($r === '') return null;

    // Extract bare email from "Name <email>" format if present
    if (preg_match('/<([^>]+)>/', $r, $emailMatch)) {
        $r = trim($emailMatch[1]);
    }

    $r_upper = strtoupper($r);

    // 1. Allow explicit matches in normalized Authorized List
    if (in_array($r_upper, $authorized_list)) return null;

    // 2. Deny non-NCSU unless explicitly authorized
    // Allow @ncsu.edu OR simple alphanumeric strings (assumed Unity IDs)
    if (stripos($r, '@ncsu.edu') === false && !preg_match('/^[a-zA-Z0-9]+$/', $r)) {
        return $r;
    }

    // 3. NCSU User Validation
    $unity_id = strtoupper(explode('@', $r)[0]);
    $is_admin = is_array($allowedUsers) && (in_array($unity_id, $allowedUsers) || in_array(strtolower($unity_id), $allowedUsers));
    $is_owner = ($unity_id === $owner_id);
    $is_authorized_unity = in_array($unity_id, $authorized_list);
    if ($is_admin || $is_owner || $is_authorized_unity) return null;

    // 4. OUC-based authorization: look up recipient's OUC and check prefix match
    // against access list entries (mirrors web-side checkAuthorization logic)
    $recipEmail = (strpos($r, '@') !== false) ? $r : $r . '@ncsu.edu';
    $coiAuth = lookup_recipient_coi_details($oracleConn, $recipEmail);
    $recipOuc = isset($coiAuth['ouc']) ? strtoupper(trim((string)$coiAuth['ouc'])) : '';
    if ($recipOuc !== '' && strlen($recipOuc) >= 2) {
        // Build credential variants at each hierarchical level (matching web-side approach)
        $ouc_credentials = array($recipOuc);
        if (strlen($recipOuc) >= 4) {
            $ouc_credentials[] = substr($recipOuc, 0, 4);
        }
        $ouc_credentials[] = substr($recipOuc, 0, 2);
        foreach ($ouc_credentials as $ouc_cred) {
            if (in_array($ouc_cred, $authorized_list)) return null;
        }
    }
    return $unity_id;
}

function _sr_filter_subscribers_by_access($conn, $report_short_id, $entries) {
    $out = array('checked' => false, 'allowed' => $entries, 'dropped' => array(), 'numeric_id' => null);
    try {
        $stmt = $conn->prepare("SELECT ID, OWNER_ID, AUTHORIZED FROM PENUMBRA_REPORTS WHERE TRIM(SHORT_ID) = :rid");
        $stmt->bindValue(':rid', trim((string)$report_short_id));
        $stmt->execute();
        $row = $stmt->fetch(PDO::FETCH_ASSOC);
        if (!$row) return $out;
        $authRaw = isset($row['AUTHORIZED']) ? $row['AUTHORIZED'] : '';
        if (is_resource($authRaw)) $authRaw = stream_get_contents($authRaw);
        $authList = _sr_normalize_auth_list($authRaw);
        $out['numeric_id'] = (int)$row['ID'];
        $out['checked'] = true;
        if (in_array('PUBLIC', $authList)) return $out; // everyone passes
        $ownerId = strtoupper((string)$row['OWNER_ID']);
        $allowed = array();
        $dropped = array();
        foreach ($entries as $e) {
            $email = (is_array($e) && isset($e['email'])) ? trim((string)$e['email']) : '';
            if ($email === '') continue;
            if (_sr_recipient_auth_failure($email, $authList, $ownerId, $conn) === null) {
                $allowed[] = $e;
            } else {
                $dropped[] = $e;
            }
        }
        $out['allowed'] = $allowed;
        $out['dropped'] = $dropped;
    } catch (Exception $e) {
        // Unreadable -> unchecked pass-through (see docblock).
    }
    return $out;
}

function _sr_persist_subscriber_removal($conn, $taskId, $droppedEmails) {
    $set = array();
    foreach ($droppedEmails as $de) {
        $de = strtolower(trim((string)$de));
        if ($de !== '') $set[$de] = true;
    }
    if (empty($set)) return;
    $stmt = $conn->prepare("SELECT OPTIONS FROM PENUMBRA_SCHEDULED_TASKS WHERE ID = :tid");
    $stmt->bindValue(':tid', $taskId);
    $stmt->execute();
    $row = $stmt->fetch(PDO::FETCH_ASSOC);
    if (!$row) return;
    $raw = is_resource($row['OPTIONS']) ? stream_get_contents($row['OPTIONS']) : $row['OPTIONS'];
    $opts = json_decode((string)$raw, true);
    if (!is_array($opts) || !isset($opts['subscribers']) || !is_array($opts['subscribers'])) return;
    $kept = array();
    foreach ($opts['subscribers'] as $s) {
        $se = (is_array($s) && isset($s['email'])) ? strtolower(trim((string)$s['email'])) : '';
        if ($se !== '' && isset($set[$se])) continue;
        $kept[] = $s;
    }
    $opts['subscribers'] = array_values($kept);
    $upd = $conn->prepare("UPDATE PENUMBRA_SCHEDULED_TASKS SET OPTIONS = :opts WHERE ID = :tid");
    $upd->bindValue(':opts', json_encode($opts));
    $upd->bindValue(':tid', $taskId);
    $upd->execute();
}

function execute_scheduled_report($report_id, $api_index_url, $task_subject, $password = null, $prompt_answers = array(), $recipients_str = '', $recipient_vars = null, $row_limit_override = null, $me_map = array(), $stream_row_callback = null, $toobig_recoverable = false) {
    global $allowedUsers; // From db_connection.php (Admins)
    
    $api_query_url = str_replace('index.php', 'query.php', $api_index_url);
    
    // Default: Assume we cannot bypass permissions
    $use_bypass_key = false;

    try {
        log_scheduler("Fetching report definition and permissions...");
        $oracleConn = getConnectionForTable('DUAL');
        if (!$oracleConn) return array('error' => "Database connection failed.");
        
        // 1. Fetch Report Data AND Permissions (Owner/Authorized)
        $sql = "SELECT ID, STATE_DATA, OWNER_ID, AUTHORIZED FROM PENUMBRA_REPORTS WHERE TRIM(SHORT_ID) = :report_id";
        $stmt = $oracleConn->prepare($sql);
        $stmt->bindValue(':report_id', $report_id, PDO::PARAM_STR);
        $stmt->execute();
        $report_data = $stmt->fetch(PDO::FETCH_ASSOC);
        
        // Flagged distinctly because this is the one error return with no
        // numeric_id to offer - the report row is gone, so there is nothing to
        // resolve. Every caller's audit + notification block is gated on
        // numeric_id, so without this flag a vanished report is indistinguishable
        // from success at the call site and fails silently, forever.
        if (!$report_data) return array('error' => "Report '$report_id' not found.", 'report_missing' => true);
        
        $numeric_id = (int)$report_data['ID'];
        $owner_id = strtoupper($report_data['OWNER_ID']);
        
        // Parse Authorized List (Handle nulls and whitespace)
        // Normalize entries so "Name <user@ncsu.edu>" becomes "USER", etc.
        $authorized_raw = isset($report_data['AUTHORIZED']) ? $report_data['AUTHORIZED'] : '';
        $authorized_list = _sr_normalize_auth_list($authorized_raw);

        // Check if report is explicitly Public
        $is_public = in_array('PUBLIC', $authorized_list);

        // --- SECURITY CHECK ---
        // Per-entry logic lives in _sr_recipient_auth_failure() (shared with the
        // subscriber auto-unsubscribe pass); this loop keeps the historic
        // fail-fast semantics and blame labels exactly.
        if (!$is_public) {
            $all_recipients_valid = true;
            $bad_recipient = '';

            $recips = preg_split('/[;,]/', $recipients_str);

            foreach ($recips as $r) {
                $r = trim($r);
                if (empty($r)) continue;
                $authFail = _sr_recipient_auth_failure($r, $authorized_list, $owner_id, $oracleConn);
                if ($authFail !== null) {
                    $all_recipients_valid = false;
                    $bad_recipient = $authFail;
                    break;
                }
            }
            
            // FAIL FAST: If any recipient is invalid, abort immediately.
            // Do not call the API. Do not pass Go.
                if (!$all_recipients_valid) {
                return array(
                    'error' => "Security Violation: Report is private and recipient '$bad_recipient' is not authorized.", 
                    'numeric_id' => $numeric_id
                );
            }
            
            // If we are here, everyone is trusted -> Enable Bypass
            $use_bypass_key = true;
            log_scheduler("  Security Check Passed: All recipients authorized. Enabling API bypass.");
        } else {
            // PUBLIC report: every recipient is authorized BY DEFINITION, so the
            // per-recipient validation above is vacuously satisfied and the bypass
            // key must be enabled here too.
            //
            // This else-branch did not exist before 2026-08-18 and its absence
            // silently broke EVERY scheduled PUBLIC report from 2026-08-12 on.
            // Why it stayed hidden for a week: with no key, the runner POSTs no
            // scheduler_key, so query.php never elevates the run and $currentUserKey
            // stays empty (the scheduler sends no KDUSER). query.php's empty-identity
            // gate - added 2026-08-11, which correctly assumed "the Scheduler sets
            // $currentUserKey = 'SCHEDULER', so server-to-server runs never land
            // here" - then rejected the run with "Access Denied: your sign-in session
            // has expired". The caller's stripos($data_response, 'Access Denied')
            // mapped that to the MISLEADING "Report is private and recipients include
            // unauthorized users", which is the opposite of the truth: the report is
            // public and the recipients were fine.
            //
            // Before that gate existed a keyless public run still worked, because it
            // fell through to the !$isAdmin branch and passed the $can_view check on
            // a public report - which is why this only started failing on 08-12.
            $use_bypass_key = true;
            log_scheduler("  Security Check Passed: report is public - all recipients authorized. Enabling API bypass.");
        }
        // ----------------------

        // Read CLOB via OCI8 to avoid PDO's 4000-byte buffer corruption
        $preloaded_state_json = readClobViaOci8('PENUMBRA_REPORTS', 'STATE_DATA', 'TRIM(SHORT_ID)', $report_id);
        $state = safe_json_decode($preloaded_state_json);
        // numeric_id on every error return from here on - see the block comment at
        // the curl call below for why omitting it silently kills the failure email.
        if (!$state) return array('error' => "Invalid report state JSON.", 'numeric_id' => isset($numeric_id) ? $numeric_id : null);

        if (isset($state['encrypted']) && $state['encrypted'] === true) {
            log_scheduler("Decrypting report...");
            if (!$password) return array('error' => "Report is encrypted but no password provided.", 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
            $decrypted_str = decrypt_penumbra_state($password, $state['content']);
            if ($decrypted_str === false) return array('error' => "Decryption failed (Bad Password).", 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
            $state = safe_json_decode($decrypted_str);
            if (!$state || !isset($state['query'])) return array('error' => "Decrypted state is invalid.", 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
        }
        
        if (!isset($state['query'])) return array('error' => "Report state missing query.", 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
        
        log_scheduler("Processing prompts...");
        $resolvedPrompts = array();
        $resolvedPromptsByName = array();
        try {
            $sql_query = process_scheduler_prompts($state['query'], $prompt_answers, $resolvedPrompts, $resolvedPromptsByName, $me_map);
        } catch (Exception $e) {
            return array('error' => "Prompt Error: " . $e->getMessage(), 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
        }
        if (!empty($resolvedPrompts)) {
            $rpPairs = array();
            foreach ($resolvedPrompts as $rpk => $rpv) {
                $rpPairs[] = $rpk . '=' . ($rpv !== null ? $rpv : 'NULL');
            }
            log_scheduler("  Resolved prompts: " . implode(', ', $rpPairs));
        }

    } catch (Exception $e) { return array('error' => "DB Error: " . $e->getMessage(), 'numeric_id' => isset($numeric_id) ? $numeric_id : null); }

    // Resolve admin-supplied me() macros. A scheduled run has no live Shibboleth
    // identity (query.php would empty every me()), so the task carries an explicit
    // per-token map. Runs BEFORE the recipient-var pass so a me(ouc)->{OUC} mapping
    // chains into per-recipient resolution below; a literal mapping is quoted in
    // place here. See _sr_substitute_me_map_sql().
    if (is_array($me_map) && !empty($me_map)) {
        $sql_query = _sr_substitute_me_map_sql($sql_query, $me_map);
    }

    // Apply per-recipient variable substitution in query. Values always land
    // inside a single-quoted literal - quotes are supplied when the author did
    // not write them. See _sr_substitute_recipient_vars_sql().
    if ($recipient_vars && is_array($recipient_vars)) {
        $sql_query = _sr_substitute_recipient_vars_sql($sql_query, $recipient_vars);
    }

    // If query still contains recipient vars (no $recipient_vars provided), return metadata
    // without executing - the caller will re-invoke per-recipient with actual values
    $queryVarTokens = array('{FNAME}', '{LNAME}', '{USERNAME}', '{EMAIL}', '{OUC2D}', '{OUC4D}', '{OUC6D}', '{DEPT}', '{OUC}', '{EMPL_ID}', '{EMPL_ID4}');
    $queryHasRecipientVars = false;
    foreach ($queryVarTokens as $qvt) {
        if (stripos($sql_query, $qvt) !== false) {
            $queryHasRecipientVars = true;
            break;
        }
    }
    if ($queryHasRecipientVars) {
        log_scheduler("  Query contains unresolved recipient variables -- returning metadata only.");
        return array_merge($state, array(
            'data' => array(),
            'viewMode' => isset($state['pivot']) && !empty($state['pivot']) ? 'pivot' : 'standard',
            'reportTitle' => isset($state['reportTitle']) ? $state['reportTitle'] : $task_subject,
            'numeric_id' => $numeric_id,
            'resolvedPrompts' => $resolvedPrompts,
            'resolvedPromptsByName' => $resolvedPromptsByName,
            'resolvedQuery' => $sql_query,
            'usesQueryVars' => true
        ));
    }

    $params = array(
        'query_template' => $sql_query,
        'params' => '[]',
        'noLimit' => (isset($state['noLimit']) && $state['noLimit'] === true) ? 'true' : 'false',
        'short_id' => $report_id
    );

    // DB_DUMP row-limit override: when the task specifies a row mode it takes
    // precedence over the report's own saved limiter. 'all' => no cap; 'enforce'
    // => cap at the given count, passed to query.php as limitRows (which applies
    // the same ORDER BY 1 + FETCH/TOP logic the 200 default uses). When the
    // override is null (every non-DB_DUMP caller), the report's noLimit stands.
    if (is_array($row_limit_override)) {
        $rloMode = '';
        if (isset($row_limit_override['mode'])) {
            $rloMode = $row_limit_override['mode'];
        }
        if ($rloMode === 'all') {
            $params['noLimit'] = 'true';
        } else if ($rloMode === 'enforce') {
            $params['noLimit'] = 'false';
            $rloLimit = 0;
            if (isset($row_limit_override['limit'])) {
                $rloLimit = (int)$row_limit_override['limit'];
            }
            if ($rloLimit < 1) {
                $rloLimit = 200;
            }
            $params['limitRows'] = $rloLimit;
        }
    }

    // If the query references [IMPORT] tags, look up linked imports for this report
    if (preg_match('/\[\s*IMPORT/i', $sql_query) && isset($numeric_id) && $numeric_id) {
        try {
            $importRows = queryViaOci8(
                "SELECT ID, IMPORT_NAME FROM PENUMBRA_IMPORTS WHERE REPORT_ID = :rid",
                array(':rid' => $numeric_id)
            );
            if (!empty($importRows)) {
                $importRefs = array();
                foreach ($importRows as $imp) {
                    $importRefs[strtoupper($imp['IMPORT_NAME'])] = $imp['ID'];
                }
                $params['importRefs'] = json_encode($importRefs);
                log_scheduler("  Attaching " . count($importRefs) . " persisted import(s) to query.");
            }
        } catch (Exception $e) {
            log_scheduler("  ERROR: Failed to look up imports: " . $e->getMessage());
            return array('error' => "Import lookup failed: " . $e->getMessage(), 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
        }
    }

    //  Inject a key if we validated the recipients
    if ($use_bypass_key && defined('SCHEDULER_SECRET_KEY')) {
        $params['scheduler_key'] = SCHEDULER_SECRET_KEY;
    }

    log_scheduler("Executing API request for report '$report_id' via $api_query_url");
    // log_scheduler("Request Params: " . json_encode($params)); // Uncomment for debug

    // Streaming: flip query.php into NDJSON mode and consume it chunk by chunk.
    $penumbraStreamState = null;
    $penumbraStreaming   = is_callable($stream_row_callback);
    if ($penumbraStreaming) {
        $params['stream'] = '1';
    }
    // Tell query.php this run's caller can absorb a 'too_much_data' answer, so
    // hitting the buffer guard is a MEASUREMENT, not an incident (2026-08-28).
    // Only honoured on a scheduler-key run, so a browser cannot mute its own
    // audit trail by posting the flag.
    if ($toobig_recoverable) {
        $params['toobig_probe'] = '1';
    }

    $ch2 = curl_init();
    curl_setopt($ch2, CURLOPT_URL, $api_query_url);
    curl_setopt($ch2, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch2, CURLOPT_SSL_VERIFYPEER, true);
    curl_setopt($ch2, CURLOPT_POST, true);
    curl_setopt($ch2, CURLOPT_USERAGENT, 'Penumbra-Scheduler/1.0');
    curl_setopt($ch2, CURLOPT_POSTFIELDS, http_build_query($params));
    // Timeouts: without these a wedged query.php stalls this runner instance
    // FOREVER (no curl default). 30 min ceiling comfortably covers the heaviest
    // known reports; on expiry the task fails loudly (CURL Error -> audit +
    // failure notification) instead of hanging silently.
    curl_setopt($ch2, CURLOPT_CONNECTTIMEOUT, 30);
    curl_setopt($ch2, CURLOPT_TIMEOUT, 1800);

    if ($penumbraStreaming) {
        // WRITEFUNCTION hands over arbitrary byte chunks that ignore line
        // boundaries; penumbra_ndjson_feed() buffers until a newline so a row
        // is only released once it is complete. Returning a length shorter than
        // the chunk aborts the transfer, so always return strlen($chunk).
        $penumbraStreamState = penumbra_ndjson_init();
        curl_setopt($ch2, CURLOPT_RETURNTRANSFER, false);
        curl_setopt($ch2, CURLOPT_WRITEFUNCTION,
            function ($ch, $chunk) use (&$penumbraStreamState, $stream_row_callback) {
                penumbra_ndjson_feed($penumbraStreamState, $chunk, $stream_row_callback);
                return strlen($chunk);
            });
    }

    $data_response = curl_exec($ch2);
    $httpCode2 = curl_getinfo($ch2, CURLINFO_HTTP_CODE);
    $curlErr = curl_error($ch2);
    curl_close($ch2);

    if ($penumbraStreamState !== null) {
        // Anything still in the buffer means the transfer stopped mid-line.
        penumbra_ndjson_finish($penumbraStreamState);
    }

    // EVERY error return from here down MUST carry numeric_id. The caller does
    //     if ($numeric_report_id) { log_penumbra_scheduler_audit(...) }
    // and send_scheduler_failure_email() is invoked from INSIDE that audit
    // function - so an error return without numeric_id silently skips BOTH the
    // SCHEDULE_FAIL/SCHEDULE_NOAUTH audit row AND the owner's "Email on failure"
    // notification. The task just fails, forever, in total silence.
    //
    // That is exactly what happened 2026-08-12..18: the public-report bypass bug
    // returned Access Denied here with no numeric_id, so two daily tasks died for
    // a week with the failure notification enabled and never sent. The same trap
    // had already been found once for deleted reports (see the 'report_missing'
    // flag above) but was only patched for that single case.
    //
    // $numeric_id is set near the top of this function, well before the API call,
    // so it is always available here; the isset() is belt-and-braces.
    if ($curlErr) {
        return array('error' => "CURL Error: " . $curlErr, 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
    }

    // Streaming returns BEFORE the buffered response handling below: with
    // WRITEFUNCTION in play $data_response is a bool, and the stripos() probes
    // further down would coerce it to "1" and hunt for error text in it.
    if ($penumbraStreamState !== null) {
        if ($httpCode2 !== 200) {
            $streamMsg = "API Execution Failed ($httpCode2) during streamed fetch";
            if ($penumbraStreamState['error'] !== null) {
                $streamMsg .= ": " . $penumbraStreamState['error'];
            }
            return array('error' => $streamMsg, 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
        }
        // A 200 with a broken stream is still a failure - the caller checks
        // penumbra_ndjson_usable(), but report the reason here where we have it.
        if ($penumbraStreamState['error'] !== null) {
            return array('error' => "Streamed fetch failed: " . $penumbraStreamState['error'],
                         'numeric_id' => isset($numeric_id) ? $numeric_id : null);
        }
        return array(
            'stream'          => $penumbraStreamState,
            'numeric_id'      => isset($numeric_id) ? $numeric_id : null,
            'resolvedQuery'   => $sql_query,
            'resolvedPrompts' => isset($resolvedPrompts) ? $resolvedPrompts : array(),
            'columns_meta'    => isset($penumbraStreamState['head']['columns_meta'])
                                 ? $penumbraStreamState['head']['columns_meta'] : array(),
        );
    }

    if ($httpCode2 !== 200) {
        $errJson = safe_json_decode($data_response);
        $msg = "API Execution Failed ($httpCode2)";
        if ($errJson && isset($errJson['error'])) $msg .= ": " . $errJson['error'];
        
        // Report what the server ACTUALLY said. This line used to hard-code
        // "Report is private and recipients include unauthorized users" for EVERY
        // Access Denied - which is exactly how the public-report bypass bug (fixed
        // 2026-08-18; see the $is_public else-branch above) stayed hidden for a
        // week. The real response was "your sign-in session has expired", i.e. the
        // run carried NO identity at all - the opposite diagnosis, and one that
        // pointed at report permissions instead of at the missing bypass key.
        // Note the genuine private/unauthorized-recipient case never reaches here:
        // it fails fast earlier with "Security Violation: ... is not authorized."
        if (stripos($data_response, 'Access Denied') !== false) {
            $whyDenied = ($errJson && isset($errJson['error'])) ? $errJson['error'] : 'Access Denied';
            return array('error' => 'Access Denied - server said: ' . $whyDenied, 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
        }
        if (stripos($data_response, 'missing expression') !== false) return array('error' => 'Invalid query: SQL Error 936 (Missing Expression). Check prompts.', 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
        
        // This is the generic non-200 path - it is where a QUERY_TIMEOUT lands
        // (query.php answers 500 + error_code 'timeout'), so without numeric_id
        // the 120s governor added 2026-08-16 would cancel a runaway scheduled
        // report and tell nobody at all.
        //
        // error_code is propagated (2026-08-26) so callers can tell WHY, not just
        // that it failed. DB_DUMP uses 'too_much_data' to switch itself to the
        // streaming path and retry - the guard has already measured real bytes at
        // the real moment, which is a far better trigger than any pre-flight
        // estimate could be.
        return array('error' => $msg,
                     'error_code' => ($errJson && isset($errJson['error_code'])) ? $errJson['error_code'] : null,
                     'numeric_id' => isset($numeric_id) ? $numeric_id : null);
    }
    
    $apiData = safe_json_decode($data_response);
    if (!$apiData || isset($apiData['error'])) {
        return array('error' => isset($apiData['error']) ? $apiData['error'] : "Invalid API response: " . substr($data_response, 0, 100), 'numeric_id' => isset($numeric_id) ? $numeric_id : null);
    }

    // --- JOURNAL TOGGLE STATUS for scheduled output (1/0 columns at the END) ---
    // Flat/standard mode only (toggles are a flat-view feature, like the browser);
    // grouped/pivot scheduled reports skip them, and notes are ignored. Injected
    // into a COPY so $apiData['data'] (rawData, used for snapshots) stays clean;
    // the preserved names ride through apply_state_logic's column filtering.
    $journal_toggle_cols = array();
    $journal_toggle_resolver = null;
    $flat_rows = isset($apiData['data']) ? $apiData['data'] : array();
    $sched_is_flat = empty($state['groupBy']) && empty($state['pivot'])
        && (!isset($apiData['viewMode']) || $apiData['viewMode'] === 'standard');
    if ($sched_is_flat && is_array($flat_rows) && !empty($flat_rows)) {
        require_once __DIR__ . '/journal_export.php';
        $jt = journalExportToggleColumns($report_id, $state, $flat_rows);
        $journal_toggle_cols = $jt['colNames'];
        // Carry the resolver so a configured search filter can EVALUATE the
        // toggles against rawData without materializing them there (rawData
        // feeds snapshots/diffs/DB dumps and must stay clean). rawData and
        // $flat_rows come from the same source, so the resolved column names
        // are identical - no risk of the filter naming a different column.
        if (!empty($journal_toggle_cols)) {
            $firstRaw = (isset($apiData['data']) && is_array($apiData['data'])) ? reset($apiData['data']) : null;
            $journal_toggle_resolver = journalExportToggleResolver(
                $report_id, $state, is_array($firstRaw) ? array_keys($firstRaw) : array());
        }
    }
    // Engine C (snippets) toggle awareness. Set UNCONDITIONALLY - `false` clears
    // it - because this static persists for the runner process, and a report
    // without toggles must not inherit the previous task's resolver.
    _snippet_journal_toggles($journal_toggle_resolver ? $journal_toggle_resolver : false);
    // Same hazard, older bug: clear the expanded-column static so this task's
    // snippets are never parsed against the PREVIOUS task's columns.
    _snippet_set_expanded_columns(false);
    $processed = apply_state_logic($flat_rows, $state, $journal_toggle_cols);
    $title = isset($state['reportTitle']) ? $state['reportTitle'] : $task_subject;

    // Fix pivot mode detection - and bypass column filtering for pivot (needs ALL columns)
    if (isset($apiData['viewMode']) && $apiData['viewMode'] === 'pivot') {
        $processed['viewMode'] = 'pivot';
        $processed['data'] = $apiData['data']; // Pivot needs all columns, not filtered
    } else if (isset($state['pivot']) && !empty($state['pivot'])) {
        $processed['viewMode'] = 'pivot';
        $processed['data'] = $apiData['data']; // Pivot needs all columns, not filtered
    }

    // Inject sortCriteria into pivot settings so all renderers (HTML, CSV, XLSX) can apply
    // column-value-based sorting. sortCriteria is saved at state top level, not inside pivot.
    if (isset($state['pivot']) && !empty($state['pivot']) && isset($state['sortCriteria']) && !empty($state['sortCriteria'])) {
        $state['pivot']['sortCriteria'] = $state['sortCriteria'];
    }
    // Inject customSortOrders into pivot settings so all renderers can apply custom ordering
    if (isset($state['pivot']) && !empty($state['pivot']) && isset($state['customSortOrders']) && !empty($state['customSortOrders'])) {
        $state['pivot']['customSortOrders'] = $state['customSortOrders'];
    }

    $extra = array(
        'reportTitle' => $title,
        'numeric_id' => $numeric_id,
        'resolvedPrompts' => $resolvedPrompts,
        'resolvedPromptsByName' => $resolvedPromptsByName,
        'resolvedQuery' => $sql_query,
        'rawData' => $apiData['data'],  // Unfiltered data (all columns) for snapshot creation
        'columns_meta' => isset($apiData['columns_meta']) ? $apiData['columns_meta'] : array(),
        // Journal toggles: the column names (so a re-derive after filtering can
        // preserve them) + the resolver (so the filter can evaluate them).
        'journalToggleCols' => $journal_toggle_cols,
        'journalToggleResolver' => $journal_toggle_resolver
    );
    if (isset($apiData['import_timestamps'])) {
        $extra['import_timestamps'] = $apiData['import_timestamps'];
    }
    // Merge processed results with state and extra info.
    // IMPORTANT: $processed keys (data, viewMode, groupAgg) must take precedence over
    // $state equivalents because apply_state_logic() enriches them (e.g., groupAgg gets
    // 'groupByCol' added). Use $state first, then $processed to overwrite.
    return array_merge($state, $processed, $extra);
}

function generate_snapshot_signature($processedData, $change_columns = null) {
    $sig_parts = array();
    foreach ($processedData as $row) {
        if (is_array($row)) {
            if ($change_columns && is_array($change_columns) && !empty($change_columns)) {
                // Filter to only specified columns
                $filtered = array();
                foreach ($change_columns as $col) {
                    $col_upper = strtoupper($col);
                    if (array_key_exists($col_upper, $row)) {
                        $filtered[$col_upper] = $row[$col_upper];
                    }
                }
                ksort($filtered);
                $sig_parts[] = json_encode($filtered);
            } else {
                ksort($row);
                $sig_parts[] = json_encode($row);
            }
        }
    }
    sort($sig_parts);
    return md5(implode('|', $sig_parts));
}

function penumbra_fetch_latest_scheduler_snapshot($numeric_report_id, $created_by, $report_password) {
    try {
        $meta_sql = "SELECT ID, SNAP_NAME, TO_CHAR(CREATED_AT, 'YYYY-MM-DD HH24:MI:SS') AS CREATED_AT FROM PENUMBRA_SNAPS WHERE REPORT_ID = :rid AND CREATED_BY = :cb AND DATA_SIGNATURE IS NOT NULL ORDER BY CREATED_AT DESC, ID DESC";
        $meta_rows = queryViaOci8($meta_sql, array(':rid' => $numeric_report_id, ':cb' => $created_by));
        if (empty($meta_rows)) {
            // No scheduler snapshot yet - fall back to the newest snapshot from
            // any creator (user saves / the UI's baseline prompt).
            $any_sql = "SELECT ID, SNAP_NAME, TO_CHAR(CREATED_AT, 'YYYY-MM-DD HH24:MI:SS') AS CREATED_AT FROM PENUMBRA_SNAPS WHERE REPORT_ID = :rid ORDER BY CREATED_AT DESC, ID DESC";
            $meta_rows = queryViaOci8($any_sql, array(':rid' => $numeric_report_id));
            if (empty($meta_rows)) return null;
            log_scheduler("  change analysis: no scheduler snapshot yet - using the newest saved snapshot as the baseline.");
        }
        $snap_id = (int)$meta_rows[0]['ID'];
        $snap_name = isset($meta_rows[0]['SNAP_NAME']) ? (string)$meta_rows[0]['SNAP_NAME'] : '';
        $snap_created = isset($meta_rows[0]['CREATED_AT']) ? (string)$meta_rows[0]['CREATED_AT'] : '';

        $data_rows = queryViaOci8("SELECT SNAP_DATA FROM PENUMBRA_SNAPS WHERE ID = :sid", array(':sid' => $snap_id));
        if (empty($data_rows) || !isset($data_rows[0]['SNAP_DATA'])) return null;
        $payload = (string)$data_rows[0]['SNAP_DATA'];
        if ($payload === '') return null;

        if (strpos($payload, 'PENUMBRA_GCM::') === 0) {
            if (empty($report_password)) {
                log_scheduler("  change analysis: latest snapshot is encrypted but the task has no report password - cannot diff.");
                return null;
            }
            $payload = decrypt_penumbra_state($report_password, $payload);
            if ($payload === false || $payload === null || $payload === '') {
                log_scheduler("  change analysis: failed to decrypt the latest snapshot - cannot diff.");
                return null;
            }
        }

        $decoded = json_decode($payload, true);
        if (!is_array($decoded)) {
            log_scheduler("  change analysis: latest snapshot payload is not valid JSON - cannot diff.");
            return null;
        }
        $rows = array();
        foreach ($decoded as $item) {
            if (is_array($item) && isset($item['rowData']) && is_array($item['rowData'])) {
                $rows[] = $item['rowData'];
            }
        }
        // Non-empty payload but no {rowData} items = an unrecognized legacy
        // format; treat as "no baseline" rather than diffing against nothing
        // (which would misreport every current row as New).
        if (empty($rows) && !empty($decoded)) {
            log_scheduler("  change analysis: snapshot #" . $snap_id . " has an unrecognized data format - cannot diff.");
            return null;
        }
        return array('id' => $snap_id, 'rows' => $rows, 'name' => $snap_name, 'created_at' => $snap_created);
    } catch (Exception $e) {
        log_scheduler("  change analysis: snapshot fetch failed - " . $e->getMessage());
        return null;
    }
}

function penumbra_first_run_baseline_unchanged($numeric_report_id, $report_password, $currentRows, $changeColumns, $label = 'run') {
    if (empty($currentRows) || !is_array($currentRows)) return false;
    $base = penumbra_fetch_latest_scheduler_snapshot($numeric_report_id, 'SCHEDULER', $report_password);
    if ($base === null || empty($base['rows'])) return false;
    $diff = penumbra_compute_snapshot_diff($currentRows, $base['rows'], $changeColumns);
    if ($diff === null) {
        log_scheduler("  First-$label baseline check: snapshot #" . $base['id'] . " is not comparable to the current data - treating as changed.");
        return false;
    }
    $changed = !empty($diff['new']) || !empty($diff['removed']) || !empty($diff['modified']);
    log_scheduler("  First-$label baseline check vs snapshot #" . $base['id']
        . (isset($base['name']) && $base['name'] !== '' ? " (" . $base['name'] . ")" : "")
        . ": " . penumbra_diff_counts_text($diff) . ".");
    return !$changed;
}

function penumbra_diff_plain_cell($value) {
    if ($value === null) return '';
    if (is_array($value)) $value = json_encode($value);
    $s = (string)$value;
    if (strpos($s, '@@HTML') === 0) {
        $s = strip_tags(preg_replace('/<br\s*\/?\s*>/i', ' ', substr($s, 6)));
    } else if (strpos($s, '@@JSON') === 0) {
        $s = substr($s, 6);
    } else if (strpos($s, '<') !== false && strpos($s, '>') !== false) {
        $s = strip_tags(preg_replace('/<br\s*\/?\s*>/i', ' ', $s));
    }
    $s = html_entity_decode($s, ENT_QUOTES, 'UTF-8');
    return trim(preg_replace('/\s+/', ' ', $s));
}

function penumbra_diff_normalize_cell($value) {
    $s = ($value === null) ? '' : (string)$value;
    // Fast path: untouched unless this is actually a resolver-decorated cell.
    if (strpos($s, 'resolver-link') === false) return $s;
    $hadPrefix = (strpos($s, '@@HTML') === 0);
    $body = $hadPrefix ? substr($s, 6) : $s;
    $body = preg_replace('/<a[^>]*class="resolver-link"[^>]*>(.*?)<\/a>/i', '$1', $body);
    if ($body === null) return $s; // PCRE bailed (bad UTF-8) - compare the original
    // Still contains markup? Keep it an @@HTML cell. Otherwise it is plain data
    // again and must compare equal to a pre-resolver snapshot's plain value.
    if ($hadPrefix && strpos($body, '<') !== false) $body = '@@HTML' . $body;
    return $body;
}

function penumbra_compute_snapshot_diff($currentRows, $snapshotRows, $keyColumns = null) {
    if (!is_array($currentRows) || !is_array($snapshotRows)) return null;

    // Normalize both sides: UPPERCASE keys, null -> '' strings (matches how
    // scheduler snapshots are stored and how the JS masterRowData is built).
    // Each side gets TWO parallel views at the same indices:
    //   *Norm - the raw values, used for OUTPUT (the email's rows, the [was:]
    //           side of a modified pair, Removed rows) so links still render.
    //   *Cmp  - penumbra_diff_normalize_cell() applied, used for row PAIRING and
    //           the non-key value diff, so app-generated presentation markup
    //           cannot masquerade as a data change.
    $curNorm = array();
    $curCmp  = array();
    $curOrig = array();
    foreach ($currentRows as $row) {
        if (!is_array($row)) continue;
        $n = array();
        $c = array();
        foreach ($row as $k => $v) {
            $ku = strtoupper((string)$k);
            if ($ku === '#') continue;
            $sv = ($v === null) ? '' : (string)$v;
            $n[$ku] = $sv;
            $c[$ku] = penumbra_diff_normalize_cell($sv);
        }
        $curNorm[] = $n;
        $curCmp[]  = $c;
        $curOrig[] = $row;
    }
    $snapNorm = array();
    $snapCmp  = array();
    foreach ($snapshotRows as $row) {
        if (!is_array($row)) continue;
        $n = array();
        $c = array();
        foreach ($row as $k => $v) {
            $ku = strtoupper((string)$k);
            if ($ku === '#') continue;
            $sv = ($v === null) ? '' : (string)$v;
            $n[$ku] = $sv;
            $c[$ku] = penumbra_diff_normalize_cell($sv);
        }
        $snapNorm[] = $n;
        $snapCmp[]  = $c;
    }
    if (empty($curNorm)) return null;

    $curCols  = array_keys($curNorm[0]);
    $snapCols = !empty($snapNorm) ? array_keys($snapNorm[0]) : array();

    // Resolve the effective key columns (mirrors the client's effectiveKeyColumns)
    $customMode = is_array($keyColumns) && !empty($keyColumns);
    $effectiveKeys = null; // null = full-row signature
    if ($customMode) {
        $effectiveKeys = array();
        foreach ($keyColumns as $kc) {
            $kcu = strtoupper(trim((string)$kc));
            if ($kcu !== '' && $kcu !== '#' && !in_array($kcu, $effectiveKeys)) $effectiveKeys[] = $kcu;
        }
        // If none of the chosen key columns exist in the current data, every row
        // would share one signature and the diff would be meaningless.
        $anyPresent = false;
        foreach ($effectiveKeys as $ek) { if (in_array($ek, $curCols)) { $anyPresent = true; break; } }
        if (empty($effectiveKeys) || !$anyPresent) return null;
    } else if (!empty($snapNorm)) {
        $curSet = $curCols;  sort($curSet);
        $snapSet = $snapCols; sort($snapSet);
        if ($curSet !== $snapSet) {
            $effectiveKeys = array_values(array_intersect($snapCols, $curCols));
            if (empty($effectiveKeys)) return null; // no shared columns - not comparable
        }
    }

    // Row signature over the effective keys (fixed column order -> stable JSON)
    $sigFor = function ($normRow) use ($effectiveKeys) {
        if ($effectiveKeys === null) {
            $r = $normRow;
            ksort($r);
            return json_encode($r);
        }
        $parts = array();
        foreach ($effectiveKeys as $k) {
            $parts[$k] = isset($normRow[$k]) ? $normRow[$k] : '';
        }
        return json_encode($parts);
    };

    // Index snapshot rows by signature, suffixing duplicates "_1", "_2", ...
    // Holds the row INDEX, not the row, so each consumer picks its own view:
    // $snapCmp[$i] to compare, $snapNorm[$i] to render.
    $oldBySig = array();
    $oldCounts = array();
    foreach ($snapCmp as $si => $sc) {
        $base = $sigFor($sc);
        $oldCounts[$base] = isset($oldCounts[$base]) ? $oldCounts[$base] + 1 : 1;
        $sig = ($oldCounts[$base] > 1) ? $base . '_' . ($oldCounts[$base] - 1) : $base;
        $oldBySig[$sig] = $si;
    }

    $newRows = array();
    $modified = array();
    $unchangedRows = array();
    $matchedOldSigs = array();
    $curCounts = array();

    foreach ($curCmp as $i => $cc) {
        $base = $sigFor($cc);
        $curCounts[$base] = isset($curCounts[$base]) ? $curCounts[$base] + 1 : 1;
        $sig = ($curCounts[$base] > 1) ? $base . '_' . ($curCounts[$base] - 1) : $base;

        if (isset($oldBySig[$sig])) {
            $oldIdx = $oldBySig[$sig];
            $matchedOldSigs[$sig] = true;
            $changed = array();
            if ($customMode) {
                // Compare non-key columns present on BOTH sides (the client's
                // _diffNonKeyCols); column-set mismatches are not per-row changes.
                // Both sides are the NEUTRALIZED view - the raw values still go
                // out below as 'row'/'oldRow' for the rendered was/now pair.
                $oldCmpRow = $snapCmp[$oldIdx];
                foreach ($cc as $k => $cv) {
                    if (in_array($k, $effectiveKeys)) continue;
                    if (!array_key_exists($k, $oldCmpRow)) continue;
                    if ($cv !== (string)$oldCmpRow[$k]) $changed[] = $k;
                }
            }
            if (!empty($changed)) {
                $modified[] = array('row' => $curOrig[$i], 'oldRow' => $snapNorm[$oldIdx], 'changedCols' => $changed);
            } else {
                $unchangedRows[] = $curOrig[$i];
            }
        } else {
            $newRows[] = $curOrig[$i];
        }
    }

    $removed = array();
    foreach ($oldBySig as $sig => $oldIdx) {
        if (!isset($matchedOldSigs[$sig])) $removed[] = $snapNorm[$oldIdx];
    }

    // Rows sharing their key with at least one other row on the same side.
    // Such rows pair positionally (the _N suffixing above), which is arbitrary
    // - surfaced so the caller can log a data-quality note in custom-key mode.
    $dupKeyCurrentRows = 0;
    foreach ($curCounts as $dupC) { if ($dupC > 1) $dupKeyCurrentRows += $dupC; }
    $dupKeySnapshotRows = 0;
    foreach ($oldCounts as $dupC) { if ($dupC > 1) $dupKeySnapshotRows += $dupC; }

    return array(
        'new'                => $newRows,
        'removed'            => $removed,
        'modified'           => $modified,
        'unchanged'          => $unchangedRows,
        'unchangedCount'     => count($unchangedRows),
        'dupKeyCurrentRows'  => $dupKeyCurrentRows,
        'dupKeySnapshotRows' => $dupKeySnapshotRows
    );
}

function penumbra_diff_counts_text($diff) {
    return count($diff['new']) . ' new, '
         . count($diff['removed']) . ' removed, '
         . count($diff['modified']) . ' modified ('
         . $diff['unchangedCount'] . ' unchanged)';
}

function penumbra_snaps_pin_supported() {
    static $sup = null;
    if ($sup !== null) return $sup;
    try {
        queryViaOci8("SELECT PINNED_BY FROM PENUMBRA_SNAPS WHERE ROWNUM = 1", array());
        $sup = true;
    } catch (Exception $e) {
        $sup = false;
    }
    return $sup;
}

function penumbra_annotate_json_subdiff($wasRaw, $nowRaw) {
    if (!is_string($wasRaw) || !is_string($nowRaw)) return null;
    if (strpos($wasRaw, '@@JSON') !== 0 || strpos($nowRaw, '@@JSON') !== 0) return null;
    $wasArr = json_decode(substr($wasRaw, 6), true);
    $nowArr = json_decode(substr($nowRaw, 6), true);
    if (!is_array($wasArr) || !is_array($nowArr) || count($wasArr) === 0 || count($nowArr) === 0) return null;
    if (!isset($wasArr[0]) || !isset($nowArr[0])) return null; // assoc (key-value) payload: no sub-rows
    foreach ($wasArr as $r) { if (!is_array($r)) return null; }
    foreach ($nowArr as $r) { if (!is_array($r)) return null; }

    $sep = "\xE2\x90\x9F"; // U+241F, the same joiner the row-signature code uses
    $cellStr = function ($v) {
        if (is_array($v)) return (string)json_encode($v);
        return trim((string)($v === null ? '' : $v));
    };
    $sig = function ($row) use ($sep, $cellStr) {
        $parts = array();
        foreach ($row as $k => $v) {
            if ($k === '__PNBDIFF') continue;
            $parts[] = $k . '=' . $cellStr($v);
        }
        return implode($sep, $parts);
    };
    $firstVal = function ($row) use ($cellStr) {
        foreach ($row as $k => $v) {
            if ($k === '__PNBDIFF') continue;
            return $cellStr($v);
        }
        return '';
    };

    $wasStat = array_fill(0, count($wasArr), null);
    $nowStat = array_fill(0, count($nowArr), null);

    // Pass 1: exact multiset match -> unmarked on both sides.
    $pool = array();
    foreach ($wasArr as $i => $r) { $pool[$sig($r)][] = $i; }
    foreach ($nowArr as $i => $r) {
        $s = $sig($r);
        if (!empty($pool[$s])) { $wasStat[array_shift($pool[$s])] = 'same'; $nowStat[$i] = 'same'; }
    }
    // Pass 2: leftovers sharing a first-column value pair up as "changed"
    // (sub-rows have no declared key; the first column is the best stand-in).
    $fpool = array();
    foreach ($wasArr as $i => $r) { if ($wasStat[$i] === null) $fpool[$firstVal($r)][] = $i; }
    foreach ($nowArr as $i => $r) {
        if ($nowStat[$i] !== null) continue;
        $f = $firstVal($r);
        if (!empty($fpool[$f])) { $wasStat[array_shift($fpool[$f])] = 'changed'; $nowStat[$i] = 'changed'; }
    }
    // Pass 3: the rest exist on one side only.
    foreach ($wasStat as $i => $st) { if ($st === null) $wasStat[$i] = 'removed'; }
    foreach ($nowStat as $i => $st) { if ($st === null) $nowStat[$i] = 'added'; }

    $any = false;
    $mark = function ($arr, $stat) use (&$any) {
        $out = array();
        foreach ($arr as $i => $row) {
            unset($row['__PNBDIFF']);
            if ($stat[$i] !== 'same') { $row['__PNBDIFF'] = $stat[$i]; $any = true; }
            $out[] = $row;
        }
        return $out;
    };
    $wasOut = $mark($wasArr, $wasStat);
    $nowOut = $mark($nowArr, $nowStat);
    if (!$any) return null;

    $flags = JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES;
    return array(
        'was' => '@@JSON' . json_encode($wasOut, $flags),
        'now' => '@@JSON' . json_encode($nowOut, $flags)
    );
}

function penumbra_build_diff_groups($diff, $columnOrder, $forEmail) {
    // Change-type column name for the export rendition - dodge collisions with
    // a real report column of the same name.
    $changeCol = 'CHANGE_TYPE';
    if (!$forEmail) {
        $upperCols = array_map('strtoupper', $columnOrder);
        while (in_array($changeCol, $upperCols)) $changeCol = '_' . $changeCol;
    }

    $buildRow = function ($srcRow, $srcIsNormalized, $oldRow, $changedCols, $changeLabel) use ($columnOrder, $forEmail, $changeCol) {
        $out = array();
        if (!$forEmail) $out[$changeCol] = $changeLabel;
        foreach ($columnOrder as $col) {
            $cu = strtoupper((string)$col);
            if ($srcIsNormalized) {
                $val = isset($srcRow[$cu]) ? $srcRow[$cu] : '';
            } else {
                $val = array_key_exists($col, $srcRow) ? $srcRow[$col] : (isset($srcRow[$cu]) ? $srcRow[$cu] : '');
            }
            if ($changedCols !== null && in_array($cu, $changedCols)) {
                $oldRaw = isset($oldRow[$cu]) ? $oldRow[$cu] : '';
                if ($forEmail) {
                    // @@JSON-vs-@@JSON pairs get sub-row diff marks first, so the
                    // rendered was/now tables tint added/removed/changed sub-rows
                    // (mirrors the client's _annotateJsonSubDiff; email-rendition
                    // only - the CSV/XLSX branch below keeps the raw values).
                    $wasSide = $oldRaw;
                    $nowSide = $val;
                    $subDiff = penumbra_annotate_json_subdiff($oldRaw, $val);
                    if ($subDiff !== null) { $wasSide = $subDiff['was']; $nowSide = $subDiff['now']; }
                    // Render BOTH sides with the SAME cell renderer the email uses for
                    // every other cell (formatCellContent), so a @@JSON / @@HTML value
                    // shows its rendered table / markup on each side instead of a
                    // flattened raw JSON string. Wrapped in @@HTML so the row renderer
                    // emits it as HTML; it re-sanitizes, and the nested tables + inline
                    // styles survive _sanitize_email_html_cell's allowlist.
                    $val = '@@HTML<div style="margin-bottom:4px;"><b>[was:]</b> ' . formatCellContent($wasSide) . '</div>'
                         . '<div><b>[now:]</b> ' . formatCellContent($nowSide) . '</div>';
                } else {
                    // CSV / XLSX cannot hold a nested table - keep the flattened text.
                    $oldPlain = penumbra_diff_plain_cell($oldRaw);
                    $newPlain = penumbra_diff_plain_cell($val);
                    $val = '[was:] ' . $oldPlain . "\n" . '[now:] ' . $newPlain;
                }
            }
            $out[$col] = $val;
        }
        return $out;
    };

    $groups = array();
    if (!empty($diff['new'])) {
        $rows = array();
        foreach ($diff['new'] as $r) $rows[] = $buildRow($r, false, null, null, 'New');
        $groups['New Rows'] = $rows;
    }
    if (!empty($diff['removed'])) {
        $rows = array();
        foreach ($diff['removed'] as $r) $rows[] = $buildRow($r, true, null, null, 'Removed');
        $groups['Removed Rows'] = $rows;
    }
    if (!empty($diff['modified'])) {
        $rows = array();
        // The diff compares the FULL row (incl. columns hidden from this output), so a
        // row can be "Modified" while its only changed column isn't displayed - it then
        // renders with no visible [was:]/[now:]. Detect that and add a subtle, generic
        // note to the group header so the reader isn't left wondering why a row is
        // flagged with nothing showing. Generic on purpose (no column names).
        $orderUpper = array_map('strtoupper', $columnOrder);
        $hiddenChanged = array(); // UPPER col name => true, for columns that changed but aren't shown
        foreach ($diff['modified'] as $m) {
            $rows[] = $buildRow($m['row'], false, $m['oldRow'], $m['changedCols'], 'Modified');
            foreach ($m['changedCols'] as $cc) {
                $ccu = strtoupper((string)$cc);
                if ($ccu !== '#' && !in_array($ccu, $orderUpper, true)) $hiddenChanged[$ccu] = true;
            }
        }
        $modLabel = 'Modified Rows';
        if ($forEmail && !empty($hiddenChanged)) {
            // Appended as plain text to the group name; the header renderer prints it
            // (then the row count). Names the culprit columns (like the client's
            // analysis-card list), capped so the header band stays readable.
            $hidNames = array_keys($hiddenChanged);
            sort($hidNames);
            $shownNames = array_slice($hidNames, 0, 6);
            $suffix = implode(', ', $shownNames);
            if (count($hidNames) > count($shownNames)) $suffix .= ', +' . (count($hidNames) - count($shownNames)) . ' more';
            $modLabel .= "  \u{2014} \u{26A0} some rows changed in columns not shown here: " . $suffix;
        }
        $groups[$modLabel] = $rows;
    }
    if (!empty($diff['unchanged'])) {
        $rows = array();
        foreach ($diff['unchanged'] as $r) $rows[] = $buildRow($r, false, null, null, 'Unchanged');
        $groups['Unchanged Rows'] = $rows;
    }
    return $groups;
}

function penumbra_extract_snap_type_clauses($filter) {
    $out = array('has' => false, 'stripped' => trim((string)$filter), 'include' => null, 'exclude' => array());
    if ($out['stripped'] === '') return $out;
    if (preg_match_all("/__SNAP_TYPE\s*(=|!=|<>)\s*'([^']*)'/i", $filter, $m, PREG_SET_ORDER)) {
        foreach ($m as $hit) {
            $out['has'] = true;
            $val = strtolower(trim($hit[2]));
            if ($hit[1] === '=') {
                if ($out['include'] === null) $out['include'] = array();
                $out['include'][$val] = true;
            } else {
                $out['exclude'][$val] = true;
            }
        }
    }
    if ($out['has']) {
        // Pattern order matters (client parity): the and/or-prefixed form first
        // strips every non-leading clause, leaving at most one leading clause
        // for the anchored forms.
        $s = $filter;
        $s = preg_replace("/\s+(and|or)\s+__SNAP_TYPE\s*(=|!=|<>)\s*'[^']*'/i", '', $s);
        $s = preg_replace("/^\s*__SNAP_TYPE\s*(=|!=|<>)\s*'[^']*'\s+(and|or)\s+/i", '', $s);
        $s = preg_replace("/^\s*__SNAP_TYPE\s*(=|!=|<>)\s*'[^']*'\s*$/i", '', $s);
        $out['stripped'] = trim(preg_replace('/\s{2,}/', ' ', $s));
    }
    return $out;
}

function penumbra_filter_diff_groups($groups, $snapClauses) {
    if (!is_array($groups) || empty($snapClauses['has'])) return $groups;
    $out = array();
    foreach ($groups as $name => $rows) {
        $base = preg_replace('/\s+\x{2014}\s+\x{26A0}.*$/us', '', (string)$name);
        $key = strtolower(trim($base));
        if ($snapClauses['include'] !== null && !isset($snapClauses['include'][$key])) continue;
        if (isset($snapClauses['exclude'][$key])) continue;
        $out[$name] = $rows;
    }
    return $out;
}

function _pnb_parse_cte_spans($sql) {
    $spans = array();
    if (!preg_match('/\bWITH\s+([A-Z0-9_]+)\s*(?:\([^)]*\)\s*)?AS\s*\(/', $sql, $h, PREG_OFFSET_CAPTURE)) {
        return $spans;
    }
    $name = $h[1][0];
    $pos  = $h[0][1] + strlen($h[0][0]) - 1;   // index of the body's '('
    $len  = strlen($sql);
    // Bounded so a pathological/unbalanced query can never spin here.
    for ($guard = 0; $guard < 200; $guard++) {
        $depth = 0; $i = $pos;
        for (; $i < $len; $i++) {
            $ch = $sql[$i];
            if ($ch === '(') { $depth++; }
            elseif ($ch === ')') { $depth--; if ($depth === 0) break; }
        }
        if ($i >= $len) break;                 // unbalanced - stop, keep what we have
        $spans[] = array('name' => $name, 'start' => $pos, 'end' => $i);
        $rest = substr($sql, $i + 1);
        if (!preg_match('/^\s*,\s*([A-Z0-9_]+)\s*(?:\([^)]*\)\s*)?AS\s*\(/', $rest, $n)) break;
        $name = $n[1];
        $pos  = $i + 1 + strlen($n[0]) - 1;
    }
    return $spans;
}

function _pnb_is_cte_reference($spans, $name, $at, $sql) {
    foreach ($spans as $s) {
        if ($s['name'] !== $name) continue;
        if ($at > $s['end']) return true;                       // in scope
        if ($at > $s['start'] && $at < $s['end']) {             // inside its own body
            return (bool)preg_match('/\bUNION\b/', substr($sql, $s['start'], $at - $s['start']));
        }
    }
    return false;
}

function extract_tables_from_query($sql) {
    if (empty($sql)) return '';
    $clean = strtoupper($sql);
    // Remove string literals and comments
    $clean = preg_replace("/'[^']*'/", '', $clean);
    $clean = preg_replace('/--[^\n]*/', '', $clean);
    $clean = preg_replace('/\/\*.*?\*\//s', '', $clean);

    $tables = array();
    $blacklist = array('DUAL', 'SELECT', 'WHERE', 'ON', 'AS', 'DISTINCT', 'CROSS',
                       'OUTER', 'INNER', 'LEFT', 'RIGHT', 'FULL', 'APPLY', 'VALUES', 'SET', 'UNNEST');

    // CTE names are query-local aliases, not objects anyone can go look at, so
    // `with awards as (...) select * from awards` must not report AWARDS.
    // SCOPE-aware (not name-only) so a CTE that SHADOWS a real table still
    // reports the real table - see _pnb_parse_cte_spans().
    // Browser twin: extractTablesFromQuery() in js/main.js - keep in step.
    $cteSpans = _pnb_parse_cte_spans($clean);

    // SQL uses FROM as an ARGUMENT SEPARATOR inside several functions, where what
    // follows is a COLUMN, not a table: EXTRACT(YEAR FROM S.LOG_DATE),
    // TRIM(LEADING '0' FROM CODE), SUBSTRING(X FROM 1 FOR 2). Un-guarded,
    // EXTRACT(YEAR FROM S.LOG_DATE) reported LOG_DATE as a table.
    $argSep = array('YEAR', 'MONTH', 'DAY', 'HOUR', 'MINUTE', 'SECOND', 'WEEK', 'QUARTER',
                    'DOW', 'DOY', 'EPOCH', 'TIMEZONE_HOUR', 'TIMEZONE_MINUTE', 'TIMEZONE_REGION',
                    'TIMEZONE_ABBR', 'LEADING', 'TRAILING', 'BOTH');

    if (preg_match_all('/([A-Z0-9_]+)?\s*(?:FROM|JOIN)\s+([A-Z0-9_]+(?:\.[A-Z0-9_]+)?)/i', $clean, $matches, PREG_SET_ORDER | PREG_OFFSET_CAPTURE)) {
        foreach ($matches as $m) {
            $prev_word = isset($m[1]) ? $m[1][0] : '';
            if (in_array($prev_word, $argSep, true)) continue;
            $full_name = $m[2][0];
            $name_at   = $m[2][1];   // offset of the NAME - what the scope test needs
            $table_name = (strpos($full_name, '.') !== false) ? substr($full_name, strpos($full_name, '.') + 1) : $full_name;
            // A SQL identifier can never start with a digit, so anything numeric
            // is noise from another FROM-as-separator form we have not enumerated
            // (SUBSTRING(NAME FROM 1 FOR 3) was reporting a table called "1").
            if ($table_name === '' || ctype_digit($table_name[0])) continue;
            if (!in_array($table_name, $blacklist)
                && !_pnb_is_cte_reference($cteSpans, $table_name, $name_at, $clean)
                && !in_array($table_name, $tables)) {
                $tables[] = $table_name;
            }
        }
    }
    return implode(', ', $tables);
}

function penumbra_init_email_budget() {
    global $MAX_TOTAL_EMAIL_SIZE, $MAX_EMAIL_BODY_SIZE;
    static $done = false;
    if ($done) return;
    $done = true;

    $limit = penumbra_probe_mta_size_limit();
    if ($limit > 0) {
        $MAX_TOTAL_EMAIL_SIZE = min($MAX_TOTAL_EMAIL_SIZE, (int)floor($limit * 0.95));
        log_scheduler("MTA advertises SIZE " . number_format($limit) . " - total email budget set to " . number_format($MAX_TOTAL_EMAIL_SIZE) . " bytes.");
    } else {
        $MAX_TOTAL_EMAIL_SIZE = min($MAX_TOTAL_EMAIL_SIZE, 9437184);
        log_scheduler("MTA SIZE probe unavailable - using conservative total email budget of " . number_format($MAX_TOTAL_EMAIL_SIZE) . " bytes.");
    }
    if ($MAX_EMAIL_BODY_SIZE > $MAX_TOTAL_EMAIL_SIZE) {
        $MAX_EMAIL_BODY_SIZE = $MAX_TOTAL_EMAIL_SIZE;
    }
}
