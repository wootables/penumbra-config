                    $xml .= '<row r="' . $rowNum . '" outlineLevel="' . $_band['level'] . '">';
                    $xml .= '<c r="A' . $rowNum . '" t="s" s="1"><v>' . $ssIndex[$_bLabel] . '</v></c>';
                    $xml .= '</row>';
                    if ($colCount > 1) {
