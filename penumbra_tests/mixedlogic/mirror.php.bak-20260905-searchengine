    if ($jt) $parsed = _snippet_normalize_toggle_tree($parsed, $jt);

    foreach ($data as $row) {
        if (evaluate_format_condition($jt ? _snippet_toggle_eval_row($row, $jt) : $row, $parsed)) {
            // \x02-guarded: engine A shields lookup() output behind a string-
            // literal token, so a zip/ID like '07030' must not mail as '7,030'.
            if (isset($row[$returnCol])) {
                return "\x02" . _cf_clean_raw_value($row[$returnCol]) . "\x02";
            }
            // Try case-insensitive column match
            foreach ($row as $key => $val) {
                if (strcasecmp($key, $returnCol) === 0) {
                    return "\x02" . _cf_clean_raw_value($val) . "\x02";
                }
            }
            // Row matched but the column is absent: B returns
            // `foundRowMap.get(col) || ''` = empty, so empty is correct HERE.
            return '';
        }
    }

    // NO row matched. B returns 'N/A' for exactly this case
    // (js/main.js ~52065: `foundRowMap ? ... : 'N/A'`); C returned empty, so a
    // lookup that displayed 'N/A' on screen mailed a blank.
    return 'N/A';
}

function _sparkline_dims() {
    // Mirrors PENUMBRA_SPARK_* in js/main.js - change them together.
    // total_w 160 makes 40 points (the bucket cap) come out at the original 3px
    // bar, so only SHORT series change when the width is fitted.
    return array('max_points' => 40, 'height' => 20, 'bar_w' => 3,
                 'total_w' => 160, 'max_bar_w' => 24, 'gap' => 1);
}

function _sparkline_bar_width($n, $totalW = null, $uncapped = false) {
    $d = _sparkline_dims();
    if ($n <= 0) return $d['bar_w'];
    if ($totalW === null || !$totalW) $totalW = $d['total_w'];
    $w = (int)floor(($totalW - ($n - 1) * $d['gap']) / $n);
    // The cap applies to the DEFAULT width only - an explicit width= is the
    // author asking for a size, and must not be silently ignored.
    if (!$uncapped && $w > $d['max_bar_w']) $w = $d['max_bar_w'];
    if ($w < 2) $w = 2;
    return $w;
}

function _sparkline_frac($v, $maxAbs, $curve) {
    $a = abs($v);
    if (!($maxAbs > 0)) return 0;
    if ($curve === 'log')  return log(1 + $a) / log(1 + $maxAbs);
    if ($curve === 'sqrt') return sqrt($a) / sqrt($maxAbs);
    return $a / $maxAbs;
}

function _sparkline_opts($args, $startAt) {
    $d = _sparkline_dims();
    $o = array('curve' => 'linear', 'scale' => 'row', 'total_w' => $d['total_w'], 'color' => '', 'width_set' => false);
    $n = is_array($args) ? count($args) : 0;
    for ($i = $startAt; $i < $n; $i++) {
        $raw = trim(str_replace("'", '', (string)$args[$i]));
        if ($raw === '') continue;
        $eq = strpos($raw, '=');
        if ($eq === false) {
            if ($o['color'] === '') $o['color'] = $raw;
            continue;
        }
        $k = strtolower(trim(substr($raw, 0, $eq)));
        $v = trim(substr($raw, $eq + 1));
        $vl = strtolower($v);
        if ($k === 'style') {
            // Recognised and DROPPED. line/area are browser-only (no inline SVG in
            // TCPDF, none in Outlook), so email renders the same data as bars.
            // Swallowing the key here stops it being mistaken for the colour.
            continue;
        } elseif ($k === 'curve' && in_array($vl, array('linear', 'log', 'sqrt'), true)) {
            $o['curve'] = $vl;
        } elseif ($k === 'scale' && in_array($vl, array('row', 'shared'), true)) {
            $o['scale'] = $vl;
        } elseif ($k === 'width') {
            $w = (int)$vl;
            if ($w >= 20 && $w <= 600) { $o['total_w'] = $w; $o['width_set'] = true; }
        } elseif ($k === 'color' || $k === 'colour') {
            $o['color'] = $v;
        }
    }
    return $o;
}

function _sparkline_bucket($vals, $maxPoints) {
    $n = count($vals);
    if ($n <= $maxPoints) return $vals;
    $out = array();
    $per = $n / $maxPoints;
    for ($i = 0; $i < $maxPoints; $i++) {
        $a = (int)floor($i * $per);
        $b = (int)floor(($i + 1) * $per);
        if ($b <= $a) $b = $a + 1;
        $sum = 0; $cnt = 0;
        for ($j = $a; $j < $b && $j < $n; $j++) { $sum += $vals[$j]; $cnt++; }
        $out[] = $cnt ? ($sum / $cnt) : 0;
    }
    return $out;
}

function _sparkline_color($raw) {
    $color = ($raw === null) ? '' : trim($raw);
    $color = ($color === '')
        ? penumbra_resolve_css_vars('var(--brand-primary)')
        : penumbra_resolve_css_vars($color);
    $color = preg_replace('/[^a-zA-Z0-9#(),.\s%-]/', '', $color);
    return ($color === '') ? '#007bff' : $color;
}

function _sparkline_bars_html($vals, $opts = array()) {
    if (!count($vals)) return '[No Sparkline Data]';
    // Back-compat: this used to take a bare colour string.
    if (!is_array($opts)) $opts = array('color' => $opts);
    $_d = _sparkline_dims();
    $H = $_d['height'];
    $color = isset($opts['color']) && $opts['color'] !== '' ? $opts['color'] : '#007bff';
    $curve = isset($opts['curve']) ? $opts['curve'] : 'linear';
    $totalW = isset($opts['total_w']) && $opts['total_w'] ? $opts['total_w'] : $_d['total_w'];
    $BAR_W = _sparkline_bar_width(count($vals), $totalW, !empty($opts['width_set']));
    $safeColor = htmlspecialchars($color, ENT_QUOTES, 'UTF-8');

    // An EXTERNAL maximum is how scale=shared works: every row is drawn against
    // one number rather than against its own peak.
    $maxAbs = (isset($opts['max_abs']) && $opts['max_abs'] > 0) ? $opts['max_abs'] : 0;
    if (!($maxAbs > 0)) {
        foreach ($vals as $v) {
            $a = abs($v);
            if (is_finite($a) && $a > $maxAbs) $maxAbs = $a;
        }
    }
    if (!($maxAbs > 0)) $maxAbs = 1;

    // Under a shared scale most rows legitimately sit near the floor, and a row
    // of 1px stubs is indistinguishable from an empty cell. The track shows the
    // range being measured against - mirrors .pnb-spark--tracked in the browser.
    // Inline styles + bgcolor, because mail clients drop the stylesheet.
    $tracked = (isset($opts['max_abs']) && $opts['max_abs'] > 0);
    $trackCss = $tracked
        ? ' background-color:#f0f0f0; border-bottom:1px solid #c8c8c8;'
        : '';
    $trackBg = $tracked ? ' bgcolor="#f0f0f0"' : '';
    $html = '<table cellpadding="0" cellspacing="0" border="0"' . $trackBg .
            ' style="border-collapse:collapse;display:inline-table;vertical-align:middle;' . $trackCss . '"><tr>';
    foreach ($vals as $v) {
        if (!is_finite($v)) $v = 0;
        // JS Math.round breaks .5 toward +Infinity; PHP round() breaks it away
        // from zero. floor(x + 0.5) reproduces the JS rule so the two engines
        // cannot pick different heights for the same series.
        $h = (int)floor(_sparkline_frac($v, $maxAbs, $curve) * $H + 0.5);
        if ($h < 1) $h = 1;
        if ($h > $H) $h = $H;   // above a shared max: clamp, do not overdraw
        // Sign is carried by POSITION, not colour: valign top hangs a negative
        // bar below the baseline, matching the browser's .is-neg rule.
        $valign = ($v < 0) ? 'top' : 'bottom';
        $html .= '<td valign="' . $valign . '" height="' . $H . '" style="height:' . $H . 'px; padding:0 1px 0 0;">';
        $html .= '<table cellpadding="0" cellspacing="0" border="0" width="' . $BAR_W . '" style="width:' . $BAR_W . 'px; border-collapse:collapse;"><tr>';
        $html .= '<td width="' . $BAR_W . '" height="' . $h . '" bgcolor="' . $safeColor . '" style="width:' . $BAR_W . 'px; height:' . $h . 'px; background-color:' . $safeColor . '; font-size:0; line-height:0;">&nbsp;</td>';
        $html .= '</tr></table></td>';
    }
    return $html . '</tr></table>';
}

function _sparkline_row_series($upperRow, $cols) {
    $vals = array();
    foreach ($cols as $c) {
        $key = strtoupper(trim($c));
        if ($key === '') continue;
        $num = isset($upperRow[$key]) ? _cf_parse_num(_cf_clean_raw_value($upperRow[$key])) : false;
        $vals[] = ($num === false) ? 0 : $num;
    }
    return $vals;
}

function _snippet_sparkline($args, $data, $columns) {
    $_d = _sparkline_dims();
    $MAX_POINTS = $_d['max_points'];

    if (!isset($args[0])) {
        return '[No Sparkline Data]';
    }
    $colName = strtoupper(trim($args[0]));
    $grpName = isset($args[1]) ? strtoupper(trim($args[1])) : '';
    if ($colName === '' || _snippet_missing_col($colName, $columns)) {
        return '[No Sparkline Data]';
    }

    // ---- series (mirrors _penumbraSparklineSeries) ----
    $vals = array();
    if ($grpName !== '' && !_snippet_missing_col($grpName, $columns)) {
        $sums = array();
        $order = array();
        foreach ($data as $row) {
            $k = isset($row[$grpName]) ? trim((string)$row[$grpName]) : '';
            if ($k === '') {
                continue;
            }
            $num = isset($row[$colName]) ? _cf_parse_num(_cf_clean_raw_value($row[$colName])) : false;
            if ($num === false) {
                $num = 0;
            }
            if (!array_key_exists($k, $sums)) {
                $sums[$k] = 0;
                $order[] = $k;
            }
            $sums[$k] += $num;
        }
        foreach ($order as $k) {
            $vals[] = $sums[$k];
        }
    } else {
        foreach ($data as $row) {
            if (!isset($row[$colName])) {
                continue;
            }
            $num = _cf_parse_num(_cf_clean_raw_value($row[$colName]));
            // A blank or non-numeric cell is SKIPPED, not zeroed - a gap is not
            // a measured zero, and drawing it as one invents a dip.
            if ($num !== false) {
                $vals[] = $num;
            }
        }
    }

    $vals = _sparkline_bucket($vals, $MAX_POINTS);
    if (!count($vals)) {
        return '[No Sparkline Data]';
    }
    $o = _sparkline_opts($args, 2);
    return _sparkline_bars_html($vals, array(
        'color'   => _sparkline_color($o['color'] === '' ? null : $o['color']),
        'curve'   => $o['curve'],
        'total_w'   => $o['total_w'],
        'width_set' => $o['width_set']
        // scale= is meaningless inline: there is only one series to scale.
    ));
}

function _snippet_progress_bar($args) {
    if (!isset($args[0]) || !isset($args[1])) {
        return '';
    }
    $val = _cf_parse_num(trim($args[0]));
    $max = _cf_parse_num(trim($args[1]));
    // Default = the active email theme's brand color (parity with engines A/B in
    // main.js). Mail clients can't evaluate CSS custom properties, so resolve the
    // var() to a concrete hex here. Deliberately NO in-CSS fallback on this one:
    // an in-CSS fallback outranks the resolver's theme-default step, so a report
    // carrying a theme name that has since left the registry would silently go
    // blue instead of the app default brand. The '' guard below is the real
    // backstop. An explicitly passed var(--...) gets resolved too -- without it
    // the sanitizer below would eat the hyphens and emit a broken color.
    $color = isset($args[2]) ? trim($args[2]) : 'var(--brand-primary)';
    $color = penumbra_resolve_css_vars($color);
    if ($color === '') {
        $color = '#007bff';
    }

    if ($val === false) {
        $val = 0;
    }
    if ($max === false || $max == 0) {
        $max = 1;
    }

    $pct = ($val / $max) * 100;
    $pct = min(100, max(0, $pct));
    $pctRound = round($pct, 1);

    // Sanitize color
    $color = preg_replace('/[^a-zA-Z0-9#(),.\s%]/', '', $color);

    $displayPct = (floor($pctRound) == $pctRound) ? (string)(int)$pctRound : (string)$pctRound;
    $pctLabel = $displayPct . '%';

    // Email-safe progress bar: single-row wrapper table with bar + label on one line.
    // Uses pixel widths for Outlook compatibility (no display:inline-block or % widths on TDs).
    $safeColor = htmlspecialchars($color, ENT_QUOTES, 'UTF-8');
    $barWidth = 120;
    $fillPx = max(1, (int)round($barWidth * $pct / 100));
    $emptyPx = $barWidth - $fillPx;

    // Outer table: one row with [bar cell] [label cell] - keeps everything on one line
    $html = '<table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;"><tr>';

    // Bar cell: nested table with fill + empty
    $html .= '<td valign="middle" style="padding:0;">';
    $html .= '<table cellpadding="0" cellspacing="0" border="0" width="' . $barWidth . '" style="width:' . $barWidth . 'px; height:20px; border:1px solid #ccc; border-collapse:collapse;">';
    $html .= '<tr>';
    if ($fillPx > 0) {
        $html .= '<td width="' . $fillPx . '" style="width:' . $fillPx . 'px; height:20px; background-color:' . $safeColor . '; font-size:0; line-height:0;" bgcolor="' . $safeColor . '">&nbsp;</td>';
    }
    if ($emptyPx > 0) {
        $html .= '<td width="' . $emptyPx . '" style="width:' . $emptyPx . 'px; height:20px; background-color:#e9ecef; font-size:0; line-height:0;" bgcolor="#e9ecef">&nbsp;</td>';
    }
    $html .= '</tr></table>';
    $html .= '</td>';

    // Label cell
    $html .= '<td valign="middle" style="padding:0 0 0 5px;"><b style="font-size:10px; color:inherit; white-space:nowrap;">' . $pctLabel . '</b></td>';

    $html .= '</tr></table>';

    return $html;
}

function _email_subtitle_line_breaks($html) {
    if ($html === '' || preg_match('/<[a-z][\s\S]*>/i', $html)) {
        return $html;
    }
    return str_replace("\n", '<br>', $html);
}

function _snippet_normalize_case($data, $columns) {
    $normData = array();
    if (is_array($data)) {
        foreach ($data as $row) {
            if (!is_array($row)) { $normData[] = $row; continue; }
            $normRow = array();
            foreach ($row as $k => $v) {
                $normRow[strtoupper((string)$k)] = $v;
            }
            $normData[] = $normRow;
        }
    }
    $normCols = array();
    if (is_array($columns)) {
        foreach ($columns as $c) { $normCols[] = strtoupper((string)$c); }
    }
    return array($normData, $normCols);
}

function execute_email_snippet($snippetText, $data, $columns, $viewMode, $promptValues = array(), $reportMeta = array(), $plainOutput = false) {
    if (!isset($snippetText) || trim($snippetText) === '') {
        return '';
    }

    // Case-insensitive column resolution - see _snippet_normalize_case.
    list($data, $columns) = _snippet_normalize_case($data, $columns);

    // info() parks its rendered tables here and returns a placeholder; reset per
    // call so indices always line up with THIS render and a per-recipient loop
    // does not accumulate one table per recipient in memory.
    $GLOBALS['penumbra_info_blocks'] = array();

    $text = $snippetText;

    // Protect backtick-delimited strings FIRST - they are JS-style template
    // literals and may contain parens that would otherwise confuse the
    // balanced-call paren counter and the outer regex match loop.
    // (Matches main.js:18331.)
    $protectedStrings = array();
    $protectedIndex = 0;
    $text = _snippet_protect_backticks($text, $protectedStrings, $protectedIndex);
    // Entries 0..$backtickCount-1 are backtick-origin. Their body restore is
    // deferred past the number-format pass below: backticks are the documented
    // escape from thousands-separator formatting, and the browser restores
    // them after its pass too (main.js ~25378 vs pass ~25308). Quote-origin
    // entries added later by _snippet_protect_strings() are NOT deferred -
    // the browser never shields quoted contents from its pass.
    $backtickCount = $protectedIndex;

    // Strip block comments: /* ... */
    $text = preg_replace('/\/\*.*?\*\//s', '', $text);

    // Strip line comments: // ... (but not inside quoted strings)
    $text = _snippet_strip_line_comments($text);

    // Remove format() and rewrite() calls (already handled separately)
    $text = _snippet_remove_balanced_call($text, 'format');
    $text = _snippet_remove_balanced_call($text, 'rewrite');
    // heatmap() is browser-only for now (phase 1). It is stripped here so the
    // raw call text never reaches an email body / PDF / subtitle - a snippet
    // function that is not removed by THIS engine leaks its source verbatim.
    // PHASE 3 will add the server-side extractor + colour math alongside this.
    // When it does, note that the format() extractor near the top of this file
    // hardcodes `$start + 6` (= strlen('format')) in its adjacency check and
    // openParen offset; 'heatmap' is 7, so that block must be parameterised on
    // the name rather than copy-pasted, or it will misparse SILENTLY.
    $text = _snippet_remove_balanced_call($text, 'heatmap');
    // sparkline_cell is a TABLE rule like the three above - it paints cells and
    // renders nothing where it stands, so strip it from every email surface.
    // Removed BEFORE the snippet-function pass so the inline sparkline() scan
    // never sees the tail of this longer name.
    $text = _snippet_remove_balanced_call($text, 'sparkline_cell');

    // noweb() is the OPPOSITE of web(): browser-hidden, export-visible. Unwrap
    // it here - keep the body, drop the call - so its content survives into the
    // mail/PDF and its nested functions are resolved by the loop below. Done
    // BEFORE the skip list so `web(noweb(x))` still resolves to nothing (the
    // outer web() removal eats the unwrapped body); the reverse order gives the
    // same answer, but this way the reasoning only has to run one direction.
    $text = _snippet_unwrap_balanced_call($text, 'noweb');

    // Remove skipped function calls - convert to empty string.
    // slide() and vis() render Chart.js canvases / interactive slideshows that
    // only work in the browser, so they are stripped here (same policy as web()).
    // NOTE the scanners are word-boundary aware, so the 'web' pass cannot bite
    // into a `noweb(` that somehow survived the unwrap above.
    // layout_switch() joins these for the same reason action() is here: it is an
    // interactive control with no meaning in a static email, and leaving it
    // unresolved would emit its raw source text into the message body.
    $skippedFunctions = array('action', 'vis', 'chain', 'web', 'slide', 'layout_switch', 'toggle_switch');
    foreach ($skippedFunctions as $fn) {
        $text = _snippet_remove_balanced_call($text, $fn);
    }

    // Protect remaining string literals (single/double quoted). Backticks
    // were already handled above, so this only covers 'foo' and "bar".
    $text = _snippet_protect_strings($text, $protectedStrings, $protectedIndex);

    // Iterative replacement loop (max 50 iterations)
    // \b keeps fn names from matching inside longer words (parity with main.js).
    // The body also allows ONE level of bare (unquoted) parentheses that is NOT a
    // function call, so an enclosing call still matches after an inner one has
    // resolved into text containing parens - e.g. lookup() returning
    // "Grant (Phase 2)" used to make the surrounding case() unmatchable, leaking
    // the literal `case(` into the mail. The negative lookbehind keeps a real
    // nested call blocking the outer match so resolution stays innermost-first.
    // Twin of engine A/B's regex in js/main.js. One name list feeds both the
    // dispatch alternation and the guard so they cannot drift.
    // noweb is absent on purpose - it is UNWRAPPED above and never reaches this
    // dispatch (same shape as web/slide/vis, which are removed above). info() is
    // a normal call and belongs here.
    $snippetFnNames = 'info|calc|progress_bar|sparkline|count|sum|avg|min|max|distinct|median|mode|now|rank|percentile|stddev|lookup|date_diff|date_format|round|abs|floor|ceil|mod|fixed|string|case|me|data';
    // PCRE2 requires every TOP-LEVEL branch of a lookbehind to be a fixed length,
    // and a nested (?:a|b) group of differing lengths does not qualify ("lookbehind
    // assertion is not fixed length"). Differing lengths ARE fine one branch per
    // alternative, so distribute the \b: \bcalc|\bcount|...
    $fnGuard = '\b' . str_replace('|', '|\b', $snippetFnNames);
    $pattern = '/\b(' . $snippetFnNames . ')\('
        . '((?:"[^"]*"|\'[^\']*\'|(?<!' . $fnGuard . ')\((?:"[^"]*"|\'[^\']*\'|[^()])*\)|[^()])*)'
        . '\)/i';

    for ($iteration = 0; $iteration < 50; $iteration++) {
        $matchFound = false;

        $text = preg_replace_callback($pattern, function ($match) use ($data, $columns, $viewMode, $promptValues, $reportMeta, &$protectedStrings, &$matchFound) {
            $matchFound = true;
            $funcName = strtolower($match[1]);
            $argsStr = $match[2];

            // Restore any protected strings in the arguments before parsing
            $argsStr = _snippet_restore_strings($argsStr, $protectedStrings);

            $args = parse_format_args($argsStr);

            // Dispatch to the appropriate handler
            // \Throwable, not Exception: PHP 8 engine failures (TypeError /
            // ValueError / DivisionByZeroError) extend Error, which
            // catch(Exception) cannot see - one bad handler used to kill the
            // entire runner cycle. Same widening _snippet_calc's eval guard has.
            try {
                $result = _snippet_dispatch($funcName, $args, $data, $columns, $viewMode, $promptValues, $reportMeta);
            } catch (\Throwable $e) {
                $result = '';
            }

            return $result;
        }, $text);

        if (!$matchFound) {
            break;
        }
    }

    // Restore remaining quote-protected strings. Backtick-origin entries stay
    // masked through the number pass below (`FY 2022` must not become
    // "FY 2,022"); the function-resolution loop above already restored any
    // placeholder used as an argument, so this only affects body text.
    $backtickStrings = array_slice($protectedStrings, 0, $backtickCount, true);
    $text = _snippet_restore_strings($text, array_slice($protectedStrings, $backtickCount, null, true));

    // Clean up JS artifacts
    // JS-artifact cleanup: only strip DECLARATION-shaped forms ("var x =" /
    // "let total=") - case-sensitive, and only when an identifier followed by
    // '=' comes next. The old \b(var|let|const)\s+/i form ate plain prose:
    // "Let us know" mailed as "us know".
    $text = preg_replace('/\b(?:var|let|const)\s+(?=[A-Za-z_$][\w$]*\s*=)/', '', $text);
    $text = preg_replace('/^\s*;\s*$/m', '', $text);
    $text = preg_replace('/;\s*$/m', '', $text);
    $text = preg_replace('/\n\s*\n/', "\n", $text);
    $text = trim($text);

    if ($text === '') {
        return '';
    }

    // Plain-output mode (report subtitle / by-line) used to RETURN HERE, skipping
    // the number pass entirely, on the stated grounds that "the subtitle resolver
    // has no number-format pass". That has not been true for a while: engine B
    // runs penumbraFormatNumbersInHtml over EVERY return, subtitles included
    // (js/main.js ~52158), so skipping it here made emailed subtitles disagree
    // with the browser - and, once the aggregates below started returning RAW
    // values, would have leaked floats like 1911.7221666667 into the inbox.
    // Plain mode now differs from HTML mode in ONE respect only: no styled
    // wrapper (see the return at the end of this function).

    // Format standalone numbers with thousands separators (matches JS toLocaleString behavior)
    // Step 1: Protect HTML tags from number formatting (progress_bar, etc. contain numbers in attributes)
    // Use \x01 delimiters so placeholders don't interfere with the word-boundary lookahead/lookbehind
    $_htmlTags = array();
    $_htmlIdx = 0;
    $text = preg_replace_callback('/<[^>]+>/', function($m) use (&$_htmlTags, &$_htmlIdx) {
        $placeholder = "\x01HTAG" . $_htmlIdx . "\x01";
        $_htmlTags[$placeholder] = $m[0];
        $_htmlIdx++;
        return $placeholder;
    }, $text);

    // Step 1b: lift \x02-guarded spans OUT of the text entirely.
    // Step 2 below is BOUNDARY-guarded - it lists \x02 in its lookaround
    // character classes - which only ever protected a guarded run's FIRST and
    // LAST digits. Any interior group separated by a character outside those
    // classes still matched, and '-' is exactly such a character, so
    // date_format(X,'YYYY-MM-DD') mailed as 2024-1-01 and 'DD-YYYY-MM' as
    // 01-2,024-01. Engines A and B never had this: penumbraFormatNumbersInHtml
    // (js/main.js ~33517) SEGMENTS the string and returns any \x02...\x02
    // segment untouched. Span-guard here too, via the same \x01 placeholder
    // idiom _snippet_info() already uses for exactly this reason (see its doc
    // comment, which spelled the flaw out). Restored below BEFORE the tag
    // restore, so a guarded value that itself carried an HTML tag still gets
    // its \x01HTAG placeholder resolved. Found by the parity corpus 2026-08-29.
    $_guarded = array();
    $_gIdx = 0;
    $text = preg_replace_callback('/\x02([^\x02]*)\x02/', function ($m) use (&$_guarded, &$_gIdx) {
        $placeholder = "\x01PNBGRD" . $_gIdx . "\x01";
        $_guarded[$placeholder] = $m[1];
        $_gIdx++;
        return $placeholder;
    }, $text);

    // Step 2: Format standalone numbers not adjacent to word characters.
    // Also skip: fragments of already comma-formatted numbers ("1,384.50"
    // must not have its "384.50" tail re-rounded) and \x02-guarded fixed() AND
    // round() output (exact-decimals display that must survive untouched).
    // Matches JS: toLocaleString(undefined, {maximumFractionDigits: 2})
    $text = preg_replace_callback('/(?<![a-zA-Z\d_,\x02.\/#])(-?\d+(?:\.\d+)?)(?![a-zA-Z\d_\x02\/]|[,.]\d)/', function($m) {
        $num = floatval($m[1]);
        // maximumFractionDigits: 2 - show up to 2 decimals, no trailing zeros
        if (floor($num) == $num) {
            return number_format($num, 0, '.', ',');
        }
        // Round to 2 decimals, then strip trailing zeros
        $formatted = number_format($num, 2, '.', ',');
        $formatted = rtrim(rtrim($formatted, '0'), '.');
        return $formatted;
    }, $text);

    // Restore the \x02-guarded spans lifted in step 1b. The number pass is
    // done, and this has to precede the tag restore below.
    foreach ($_guarded as $placeholder => $val) {
        $text = str_replace($placeholder, $val, $text);
    }

    // Step 3: Restore HTML tags
    foreach ($_htmlTags as $placeholder => $tag) {
        $text = str_replace($placeholder, $tag, $text);
    }

    // Restore backtick-protected content only NOW: after the number pass so
    // its digits are never comma-formatted, and after the tag restore because
    // a tag captured in step 1 may itself carry a __PSTR_n__ placeholder
    // (backtick literal inside an HTML attribute) - restoring any earlier
    // would miss those and leak raw placeholders into the delivered email.
    $text = _snippet_restore_strings($text, $backtickStrings);

    // Drop fixed()/round()'s \x02 guards now that the number pass is done
    $text = str_replace("\x02", '', $text);

    // info() tables last of all: they must clear the number pass AND the guard
    // strip untouched (see _snippet_info).
    $text = _snippet_restore_info_blocks($text);

    // Plain mode (subtitle / by-line) is prose: same number pass, no wrapper.
    if ($plainOutput) {
        return $text;
    }

    // Wrap in a styled div and return - bold to match browser rendering
    return '<div style="font-size: 12px; color: inherit; line-height: 1.6; font-weight: bold;">' . $text . '</div>';
}

function evaluate_custom_condition($conditionExpr, $data, $columns, $viewMode, $promptValues = array(), $reportMeta = array()) {
    if (!isset($conditionExpr) || trim($conditionExpr) === '') {
        return null; // empty = invalid
    }

    // Case-insensitive column resolution - see _snippet_normalize_case.
    list($data, $columns) = _snippet_normalize_case($data, $columns);

    $text = trim($conditionExpr);

    // Protect backtick-delimited strings FIRST (see execute_email_snippet
    // for rationale - matches main.js:18331).
    $protectedStrings = array();
    $protectedIndex = 0;
    $text = _snippet_protect_backticks($text, $protectedStrings, $protectedIndex);

    // Strip comments
    $text = preg_replace('/\/\*.*?\*\//s', '', $text);
    $text = _snippet_strip_line_comments($text);
    $text = trim($text);
    if ($text === '') return null;

    // Protect remaining string literals (single/double quoted).
    $text = _snippet_protect_strings($text, $protectedStrings, $protectedIndex);

    // Build the set of valid column names (base + virtual @@JSON + '#') so a
    // direct column argument that doesn't exist can be caught, rather than
    // silently yielding 0/'' and a wrong skip decision (a renamed/typo'd column
    // otherwise halts or forces delivery with no warning). Only validate when we
    // actually know the columns: with an empty result set $columns is empty too,
    // and sum()-of-nothing == 0 is a legitimate "skip when empty"-style test.
    $condValidCols = array();
    foreach ($columns as $c) $condValidCols[strtoupper($c)] = true;
    foreach (_snippet_detect_virtual_columns($data) as $vc => $_vcOn) $condValidCols[$vc] = true;
    $condCanValidate = !empty($condValidCols);
    $condValidCols['#'] = true;
    // Functions whose column argument MUST reference a real column (arg index).
    $condColArgIndex = array(
        'sum' => 0, 'avg' => 0, 'min' => 0, 'max' => 0,
        'median' => 0, 'mode' => 0, 'distinct' => 0, 'rank' => 1,
        // 2026-08-06 additions - percentile's column is arg 1 (N comes first).
        'percentile' => 1, 'stddev' => 0,
    );
    $condUnknownCol = null; // first offending column name, if any

    // Resolve snippet function calls iteratively (same as execute_email_snippet)
    $pattern = '/\b(calc|count|sum|avg|min|max|distinct|median|mode|now|rank|percentile|stddev|lookup|date_diff|date_format|round|abs|floor|ceil|mod|fixed|string|case|data)\(((?:"[^"]*"|\'[^\']*\'|[^()])*)\)/i';

    for ($iteration = 0; $iteration < 50; $iteration++) {
        $matchFound = false;

        $text = preg_replace_callback($pattern, function ($match) use ($data, $columns, $viewMode, $promptValues, $reportMeta, $condValidCols, $condCanValidate, $condColArgIndex, &$protectedStrings, &$matchFound, &$condUnknownCol) {
            $matchFound = true;
            $funcName = strtolower($match[1]);
            $argsStr = $match[2];

            $argsStr = _snippet_restore_strings($argsStr, $protectedStrings);
            $args = parse_format_args($argsStr);

            // Validate a direct column argument against the known column set.
            // (Nested calls resolve innermost-first, so $args here are already
            // literals - the column arg is a plain name, never an unresolved call.)
            if ($condCanValidate && $condUnknownCol === null && isset($condColArgIndex[$funcName])) {
                $ci = $condColArgIndex[$funcName];
                if (isset($args[$ci])) {
                    $colRef = preg_replace('/^[\'"]|[\'"]$/', '', trim($args[$ci]));
                    if ($colRef !== '' && !isset($condValidCols[strtoupper($colRef)])) {
                        $condUnknownCol = $args[$ci];
                    }
                }
            }

            // \Throwable for the same reason as execute_email_snippet's guard:
            // Error-family throwables from a handler must not kill the runner.
            try {
                $result = _snippet_dispatch($funcName, $args, $data, $columns, $viewMode, $promptValues, $reportMeta);
            } catch (\Throwable $e) {
                $result = '';
            }

            return $result;
        }, $text);

        if (!$matchFound) {
            break;
        }
    }

    // A direct column argument referenced a column that does not exist. Fail
    // loud (null -> CONDITION_EVAL_FAILED -> proceed with delivery) instead of
    // silently comparing against a 0/'' the missing column produced.
    if ($condUnknownCol !== null) {
        if (function_exists('log_scheduler')) {
            log_scheduler("  Custom condition references unknown column '" . $condUnknownCol . "' - cannot evaluate.");
        }
        return null;
    }

    // Restore protected strings
    $text = _snippet_restore_strings($text, $protectedStrings);

    // Strip fixed()/round()'s \x02 display guards so output compares as a number
    $text = str_replace("\x02", '', $text);

    // Clean up formatting artifacts (commas in numbers from snippet output)
    $text = trim($text);
    if ($text === '') return null;

    // Try to evaluate as a comparison expression:  <value> <op> <value>
    // where op is <, >, <=, >=, ==, =, != (single = is an alias for ==,
    // consistent with snippet format() syntax).
    // First strip commas from numbers (snippet output formats with thousands separators)
    $text = preg_replace('/(\d),(\d)/', '$1$2', $text);

    if (preg_match_all('/<=|>=|!=|==|<|>|=/', $text, $condOpsM, PREG_OFFSET_CAPTURE) && count($condOpsM[0]) > 0) {
        // Numeric comparison first: prefer the operator position where BOTH
        // sides parse via _cf_parse_num, so formatted aggregates min()/max()
        // return ($1,234.56, 12.5%, (500), 1.0E+25) compare as numbers, not
        // text. A number never contains <>=! so at most one such split exists.
        $condSplit = null;
        foreach ($condOpsM[0] as $condOpHit) {
            $cand = _custcond_split_sides($text, $condOpHit[1], strlen($condOpHit[0]), $condOpHit[0]);
            if ($condSplit === null) $condSplit = $cand;
            if (!$cand['leftQuoted'] && !$cand['rightQuoted']
                && $cand['left'] !== '' && $cand['right'] !== ''
                && $cand['leftNum'] !== false && $cand['rightNum'] !== false) {
                return _custcond_compare_numbers($cand['leftNum'], $cand['op'], $cand['rightNum']);
            }
        }

        // String comparison (strcmp) on the first operator split. A quoted
        // side is an explicit string literal; an UNQUOTED empty side means a
        // snippet function resolved to nothing (no rows, all-blank column,
        // typo'd name) - that is an evaluation failure, not a legitimate
        // "compare against empty": fail loud (null -> CONDITION_EVAL_FAILED)
        // instead of silently strcmp-ing against ''.
        $left  = $condSplit['left'];
        $right = $condSplit['right'];
        if (($left === '' && !$condSplit['leftQuoted']) || ($right === '' && !$condSplit['rightQuoted'])) {
            return null;
        }
        // A side that resolved to the literal 'NaN' is a snippet function that
        // could not answer on the server (row notes / journal toggles are
        // browser-only - see _snippet_dispatch). strcmp('NaN', '0') > 0 would
        // read as TRUE and silently skip the delivery: fail loud instead
        // (null -> CONDITION_EVAL_FAILED -> proceed with delivery).
        if (($left === 'NaN' && !$condSplit['leftQuoted']) || ($right === 'NaN' && !$condSplit['rightQuoted'])) {
            return null;
        }
        // An unquoted side still containing a comparison operator (chained or
        // unresolved expression), un-evaluated arithmetic (digits joined by
        // + or *), or function-call syntax (identifier glued to an open paren:
        // a typo'd or unavailable function the resolver left behind) cannot be
        // compared meaningfully - arithmetic must go through calc(). NOTE:
        // - and / are deliberately NOT flagged; date strings (07/06/2026,
        // 2026-07-06) legitimately string-compare, as documented. Values with
        // a space before ( ("Closed (auto)") also stay comparable.
        foreach (array(array($left, $condSplit['leftQuoted']), array($right, $condSplit['rightQuoted'])) as $condSide) {
            if ($condSide[1]) continue;
            if (preg_match('/[<>=!]/', $condSide[0])
                || preg_match('/\d\s*[+*]\s*[\d(]/', $condSide[0])
                || preg_match('/[A-Za-z_]\w*\(/', $condSide[0])) {
                return null;
            }
        }
        $cmp = strcmp($left, $right);
        switch ($condSplit['op']) {
            case '=':
            case '==': return $cmp === 0;
            case '!=': return $cmp !== 0;
            case '<':  return $cmp < 0;
            case '>':  return $cmp > 0;
            case '<=': return $cmp <= 0;
            case '>=': return $cmp >= 0;
        }
    }

    // If the result is just a number, treat non-zero as truthy
    $text = trim($text);
    if (is_numeric($text)) {
        return floatval($text) != 0;
    }

    // Could not parse - return null (invalid)
    return null;
}

function _custcond_split_sides($text, $opPos, $opLen, $op) {
    $left = trim(substr($text, 0, $opPos));
    $right = trim(substr($text, $opPos + $opLen));
    $leftQuoted = false;
    $rightQuoted = false;
    $left = _custcond_strip_outer_quotes($left, $leftQuoted);
    $right = _custcond_strip_outer_quotes($right, $rightQuoted);
    return array(
        'op'          => $op,
        'left'        => $left,
        'right'       => $right,
        'leftQuoted'  => $leftQuoted,
        'rightQuoted' => $rightQuoted,
        'leftNum'     => $leftQuoted ? false : _cf_parse_num($left),
        'rightNum'    => $rightQuoted ? false : _cf_parse_num($right),
    );
}

function _custcond_strip_outer_quotes($s, &$wasQuoted) {
    $wasQuoted = false;
    $len = strlen($s);
    if ($len >= 2) {
        $first = $s[0];
        $last = $s[$len - 1];
        if (($first === '"' && $last === '"') || ($first === "'" && $last === "'")) {
            $wasQuoted = true;
            return trim(substr($s, 1, $len - 2));
        }
    }
    return $s;
}

function _custcond_compare_numbers($leftNum, $op, $rightNum) {
    switch ($op) {
        case '<':  return $leftNum < $rightNum;
        case '>':  return $leftNum > $rightNum;
        case '<=': return $leftNum <= $rightNum;
        case '>=': return $leftNum >= $rightNum;
        case '=':
        case '==': return $leftNum == $rightNum;
        case '!=': return $leftNum != $rightNum;
    }
    return null;
}

function _snippet_strip_line_comments($text) {
    $result = '';
    $len = strlen($text);
    $i = 0;
    $inSingleQuote = false;
    $inDoubleQuote = false;

    while ($i < $len) {
        $ch = $text[$i];

        if ($inSingleQuote) {
            $result .= $ch;
            if ($ch === '\\' && $i + 1 < $len) {
                $i++;
                $result .= $text[$i];
            } elseif ($ch === "'") {
                $inSingleQuote = false;
            }
            $i++;
            continue;
        }

        if ($inDoubleQuote) {
            $result .= $ch;
            if ($ch === '\\' && $i + 1 < $len) {
                $i++;
                $result .= $text[$i];
            } elseif ($ch === '"') {
                $inDoubleQuote = false;
            }
            $i++;
            continue;
        }

        // Check for line comment - but first check if this is an exact-match
        // pattern like //Disclosure Expired// (two `//` on the same line).
        // Those are condition values, not comments, and must be preserved.
        if ($ch === '/' && $i + 1 < $len && $text[$i + 1] === '/') {
            $j = $i + 2;
            $foundClose = false;
            while ($j < $len && $text[$j] !== "\n") {
                if ($text[$j] === '/' && $j + 1 < $len && $text[$j + 1] === '/') {
                    $foundClose = true;
                    break;
                }
                $j++;
            }
            if ($foundClose) {
                // Preserve //...// as literal content; skip past the closing //.
                $result .= substr($text, $i, ($j + 2) - $i);
                $i = $j + 2;
                continue;
            }
            // Real line comment - skip to end of line
            while ($i < $len && $text[$i] !== "\n") {
                $i++;
            }
            continue;
        }

        if ($ch === "'") {
            $inSingleQuote = true;
        } elseif ($ch === '"') {
            $inDoubleQuote = true;
        }

        $result .= $ch;
        $i++;
    }

    return $result;
}

function _snippet_find_call($lowerText, $name, $from = 0) {
    $nLen = strlen($name);
    while (true) {
        $p = strpos($lowerText, $name, $from);
        if ($p === false) return false;
        if ($p === 0) return $p;
        $prev = $lowerText[$p - 1];
        if (!ctype_alnum($prev) && $prev !== '_') return $p;
        $from = $p + $nLen;
    }
}

function _snippet_remove_balanced_call($text, $funcName) {
    $result = '';
    $len = strlen($text);
    $fnLen = strlen($funcName);
    $i = 0;

    while ($i < $len) {
        $remaining = $len - $i;
        if ($remaining > $fnLen + 1) {
            $candidate = substr($text, $i, $fnLen);
            if (strcasecmp($candidate, $funcName) === 0 && $text[$i + $fnLen] === '(') {
                // Make sure it's not part of a larger word
                $validStart = true;
                if ($i > 0) {
                    $prevChar = $text[$i - 1];
                    if (ctype_alnum($prevChar) || $prevChar === '_') {
                        $validStart = false;
                    }
                }

                if ($validStart) {
                    // Found function call start - find the matching closing paren
                    $parenStart = $i + $fnLen;
                    $depth = 0;
                    $j = $parenStart;
                    $inSQ = false;
                    $inDQ = false;

                    while ($j < $len) {
                        $c = $text[$j];

                        if ($inSQ) {
                            if ($c === '\\' && $j + 1 < $len) {
                                $j += 2;
                                continue;
                            }
                            if ($c === "'") {
                                $inSQ = false;
                            }
                            $j++;
                            continue;
                        }

                        if ($inDQ) {
                            if ($c === '\\' && $j + 1 < $len) {
                                $j += 2;
                                continue;
                            }
                            if ($c === '"') {
                                $inDQ = false;
                            }
                            $j++;
                            continue;
                        }

                        if ($c === "'") {
                            $inSQ = true;
                        } elseif ($c === '"') {
                            $inDQ = true;
                        } elseif ($c === '(') {
                            $depth++;
                        } elseif ($c === ')') {
                            $depth--;
                            if ($depth === 0) {
                                // Skip the entire call
                                $i = $j + 1;
                                continue 2;
                            }
                        }
                        $j++;
                    }
                }
            }
        }

        $result .= $text[$i];
        $i++;
    }

    return $result;
}

function _snippet_unwrap_balanced_call($text, $funcName) {
    $result = '';
    $len = strlen($text);
    $fnLen = strlen($funcName);
    $i = 0;

    while ($i < $len) {
        $remaining = $len - $i;
        if ($remaining > $fnLen + 1) {
            $candidate = substr($text, $i, $fnLen);
            if (strcasecmp($candidate, $funcName) === 0 && $text[$i + $fnLen] === '(') {
                $validStart = true;
                if ($i > 0) {
                    $prevChar = $text[$i - 1];
                    if (ctype_alnum($prevChar) || $prevChar === '_') {
                        $validStart = false;
                    }
                }

                if ($validStart) {
                    $parenStart = $i + $fnLen;
                    $depth = 0;
                    $j = $parenStart;
                    $inSQ = false;
                    $inDQ = false;

                    while ($j < $len) {
                        $c = $text[$j];

                        if ($inSQ) {
                            if ($c === '\\' && $j + 1 < $len) { $j += 2; continue; }
                            if ($c === "'") { $inSQ = false; }
                            $j++;
                            continue;
                        }

                        if ($inDQ) {
                            if ($c === '\\' && $j + 1 < $len) { $j += 2; continue; }
                            if ($c === '"') { $inDQ = false; }
                            $j++;
                            continue;
                        }

                        if ($c === "'") {
                            $inSQ = true;
                        } elseif ($c === '"') {
                            $inDQ = true;
                        } elseif ($c === '(') {
                            $depth++;
                        } elseif ($c === ')') {
                            $depth--;
                            if ($depth === 0) {
                                // Emit the BODY (between the parens) and resume
                                // scanning after the closing paren. Padding spaces
                                // like the browser's markers are unnecessary here:
                                // this engine's dispatch regex is applied to the
                                // whole text afterwards, and nothing is glued to a
                                // word character by the splice.
                                $result .= substr($text, $parenStart + 1, $j - $parenStart - 1);
                                $i = $j + 1;
                                continue 2;
                            }
                        }
                        $j++;
                    }
                }
            }
        }

        $result .= $text[$i];
        $i++;
    }

    return $result;
}

function _snippet_protect_backticks($text, &$protectedStrings, &$protectedIndex) {
    // Match non-empty backtick-delimited strings. Backticks don't nest and
    // don't support escaping in the JS side (main.js:18331), so a simple
    // greedy-to-next-backtick match is equivalent.
    return preg_replace_callback('/`([^`]*)`/', function ($m) use (&$protectedStrings, &$protectedIndex) {
        $placeholder = '__PSTR_' . $protectedIndex . '__';
        $protectedStrings[$placeholder] = $m[1]; // inner content only
        $protectedIndex++;
        return $placeholder;
    }, $text);
}

function _snippet_protect_strings($text, &$protectedStrings, &$protectedIndex) {
    $result = '';
    $len = strlen($text);
    $i = 0;

    while ($i < $len) {
        $ch = $text[$i];

        if ($ch === '"' || $ch === "'") {
            $quote = $ch;
            $str = $ch;
            $i++;

            while ($i < $len) {
                $c = $text[$i];
                $str .= $c;
                if ($c === '\\' && $i + 1 < $len) {
                    $i++;
                    $str .= $text[$i];
                    $i++;
                    continue;
                }
                if ($c === $quote) {
                    $i++;
                    break;
                }
                $i++;
            }

            $placeholder = '__PSTR_' . $protectedIndex . '__';
            $protectedStrings[$placeholder] = $str;
            $protectedIndex++;
            $result .= $placeholder;
        } else {
            $result .= $ch;
            $i++;
        }
    }

    return $result;
}

function _snippet_restore_strings($text, $protectedStrings) {
    if (empty($protectedStrings)) {
        return $text;
    }

    $keys = array_keys($protectedStrings);
    for ($i = count($keys) - 1; $i >= 0; $i--) {
        $placeholder = $keys[$i];
        $original = $protectedStrings[$placeholder];
        $text = str_replace($placeholder, $original, $text);
    }

    return $text;
}

function _snippet_dispatch($funcName, $args, $data, $columns, $viewMode, $promptValues = array(), $reportMeta = array()) {
    // Row notes are browser-only - there is no note data on the server - so a
    // condition on the Notes column cannot be answered here. Returning 'NaN' makes
    // that visible in the delivered output, matching how a toggle used as a VALUE
    // already behaves. Previously it fell through to the literal branch and produced
    // a confident 0, which reads exactly like "no rows have notes".
    foreach ((array)$args as $_a) {
        if (is_string($_a) && _snippet_condition_uses_notes($_a)) return 'NaN';
    }
    switch ($funcName) {
        case 'count':
            return _snippet_count($args, $data, $columns);
        case 'sum':
            return _snippet_sum($args, $data, $columns);
        case 'avg':
            return _snippet_avg($args, $data, $columns);
        case 'min':
            return _snippet_min($args, $data, $columns);
        case 'max':
            return _snippet_max($args, $data, $columns);
        case 'distinct':
            return _snippet_distinct($args, $data, $columns);
        case 'median':
            return _snippet_median($args, $data, $columns);
        case 'mode':
            return _snippet_mode($args, $data, $columns);
        case 'rank':
            return _snippet_rank($args, $data, $columns);
        case 'percentile':
            return _snippet_percentile($args, $data, $columns);
        case 'stddev':
            return _snippet_stddev($args, $data, $columns);
        case 'lookup':
            return _snippet_lookup($args, $data, $columns);
        case 'calc':
            return _snippet_calc($args);
        case 'round':
            return _snippet_round($args);
        case 'abs':
            return _snippet_abs($args);
        case 'floor':
            return _snippet_floor($args);
        case 'ceil':
            return _snippet_ceil($args);
        case 'mod':
            return _snippet_mod($args);
        case 'fixed':
            return _snippet_fixed($args);
        case 'now':
            return _snippet_now($args);
        case 'date_format':
            // $data/$columns so a bare COLUMN NAME subject resolves (first
            // row's value) like the browser's shared resolver step 7.
            return _snippet_date_format($args, $data, $columns);
        case 'progress_bar':
            return _snippet_progress_bar($args);
        case 'sparkline':
            // $data/$columns because sparkline reads a whole COLUMN, not a
            // scalar argument the way progress_bar does.
            return _snippet_sparkline($args, $data, $columns);
        case 'date_diff':
            return _snippet_date_diff($args, $data, $columns);
        case 'string':
            return _snippet_string($args);
        case 'case':
            return _snippet_case($args, $data, $columns);
        case 'me':
            return _snippet_me($args);
        case 'data':
            return _snippet_data($args, $promptValues, $reportMeta);
        case 'info':
            return _snippet_info($args, $data, $columns, $viewMode, $promptValues, $reportMeta);
        default:
            return '';
    }
}

function _sr_current_recipient() {
    return (isset($GLOBALS['penumbra_email_recipient']) && is_array($GLOBALS['penumbra_email_recipient']))
        ? $GLOBALS['penumbra_email_recipient'] : null;
}

function _sr_report_last_access_map($oracleConn, $reportShortId) {
    $map = array();
    if (!$oracleConn || trim((string)$reportShortId) === '') return $map;
    try {
        // USER_KEY, not UID: UID is an Oracle built-in and aliasing to it is an
        // ORA-00923. :rid, not :uid, for the same family of reason (:uid is a
        // reserved bind name - ORA-01745).
        $st = $oracleConn->prepare(
            "SELECT a.USER_ID AS USER_KEY,
                    ROUND((SYSDATE - CAST(MAX(a.TIMESTAMP) AS DATE)) * 86400) AS SECS
               FROM PENUMBRA_AUDIT a
               JOIN PENUMBRA_REPORTS r ON a.REPORT_ID = r.ID
              WHERE TRIM(r.SHORT_ID) = :rid AND a.ACTION = 'OPEN'
              GROUP BY a.USER_ID");
        $st->bindValue(':rid', trim((string)$reportShortId), PDO::PARAM_STR);
        $st->execute();
        while ($row = $st->fetch(PDO::FETCH_ASSOC)) {
            $u = strtoupper(trim((string)$row['USER_KEY']));
            if ($u === '' || !isset($row['SECS']) || $row['SECS'] === null) continue;
            // Clamp at 0 - clock skew must not surface as a negative age, which
            // reads as "first visit" to every author's condition.
            $map[$u] = max(0, (int)$row['SECS']);
        }
    } catch (Exception $e) {
        log_scheduler("  data(lastaccess) lookup failed: " . $e->getMessage());
    }
    return $map;
}

function _sr_unity_is_admin($unityId) {
    global $allowedUsers;
    $u = trim((string)$unityId);
    if ($u === '' || !is_array($allowedUsers)) return false;
    return in_array(strtoupper($u), $allowedUsers, true)
        || in_array(strtolower($u), $allowedUsers, true)
        || in_array($u, $allowedUsers, true);
}

function _snippet_me($args) {
    $attr = isset($args[0]) ? trim($args[0]) : 'fname';
    // Strip quotes if present
    $attr = preg_replace('/^[\'"]|[\'"]$/', '', $attr);
    if ($attr === '') {
        $attr = 'fname';
    }
    // Map JS me() attributes to scheduler placeholder names
    $attrMap = array(
        'fname'    => 'FNAME',
        'name'     => 'FNAME',
        'lname'    => 'LNAME',
        'email'    => 'EMAIL',
        'mail'     => 'EMAIL',
        'unityid'  => 'USERNAME',
        'unity'    => 'USERNAME',
        'username' => 'USERNAME',
        'ouc'      => 'OUC',
        'ouc2d'    => 'OUC2D',
        'ouc4d'    => 'OUC4D',
        'ouc6d'    => 'OUC6D',
        'dept'     => 'DEPT',
        'department' => 'DEPT',
        'emplid'   => 'EMPL_ID',
        'empl_id'  => 'EMPL_ID',
        'employeeid' => 'EMPL_ID',
        'employee_id' => 'EMPL_ID',
        'emplid4'  => 'EMPL_ID4',
        'empl_id4' => 'EMPL_ID4',
    );
    $lower = strtolower($attr);
    $placeholder = isset($attrMap[$lower]) ? $attrMap[$lower] : strtoupper($attr);
    return '{' . $placeholder . '}';
}

function _snippet_data($args, $promptValues, $reportMeta = array()) {
    $type = isset($args[0]) ? trim($args[0]) : '';
    // Strip quotes if present
    $type = preg_replace('/^[\'"]|[\'"]$/', '', $type);
    if ($type === '') {
        return '';
    }

    $lower = strtolower($type);

    // prompt1-prompt6: indexed access to resolved prompt values.
    // \x02-guarded (engine A stores prompt values as string-literal tokens):
    // a date or ID answer like '01/15/2026' or '001132622' must not be
    // re-grouped by the number pass. Numeric/date readers strip the guard.
    if (preg_match('/^prompt(\d+)$/', $lower, $m)) {
        $idx = intval($m[1]) - 1;
        if (!isset($promptValues[$idx])) return 'undefined';
        $pv = $promptValues[$idx];
        // Multi-select answers arrive as arrays; the client joins with ','
        // ((string) would print the literal 'Array' plus a warning).
        if (is_array($pv)) $pv = implode(',', array_map('strval', $pv));
        return "\x02" . (string)$pv . "\x02";
    }

    // rowlimit: report-level metadata. Mirrors the browser where the value is
    // the #toggleLimitBtn.is-active state - true when the 200-row cap is on.
    // In the saved report state that's the inverse of noLimit.
    if ($lower === 'rowlimit') {
        $noLimit = isset($reportMeta['noLimit']) ? $reportMeta['noLimit'] : false;
        // Accept bool, 'true'/'false' strings, or 1/0.
        if (is_string($noLimit)) {
            $noLimit = (strtolower($noLimit) === 'true' || $noLimit === '1');
        } else {
            $noLimit = (bool)$noLimit;
        }
        return $noLimit ? 'false' : 'true';
    }

    // subtitle / byline: the report's saved subtitle text (raw, unresolved).
    // Checked BEFORE the prompt-name loop - reserved key, mirroring the browser
    // data() switch where subtitle/byline resolve ahead of prompts/URL params.
    if ($lower === 'subtitle' || $lower === 'byline') {
        return isset($reportMeta['reportSubtitle']) ? (string)$reportMeta['reportSubtitle'] : '';
    }

    // Named prompt lookup (case-insensitive match against prompt_answers keys)
    foreach ($promptValues as $key => $val) {
        if (is_string($key) && strtolower($key) === $lower) {
            // Arrays joined like the promptN branch; \x02-guarded the same.
            if (is_array($val)) $val = implode(',', array_map('strval', $val));
            return "\x02" . (string)$val . "\x02";
        }
    }

    // search: the search filter the scheduler actually applied to this email's
    // data ('' when none). Mirrors the browser's data('search') = #tableSearch
    // value, so case(data(search) != empty, ...) banners behave the same.
    if ($lower === 'search') {
        return isset($reportMeta['searchFilter']) ? (string)$reportMeta['searchFilter'] : '';
    }

    // lastaccess / last: seconds since THIS RECIPIENT last opened the report in
    // the browser, -1 when they never have (or we cannot tell). The browser
    // reads it from penumbra_vars.lastAccess; here it comes off the recipient
    // side-channel the per-recipient loop publishes (_sr_current_recipient).
    // A BROADCAST send has no single recipient, so it answers -1 rather than a
    // made-up 0 - "you haven't looked at this in N days" must never fire at
    // someone we know nothing about. (data(lastaccess) in a snippet also forces
    // per-recipient mode, so a broadcast is only reached when the key appears
    // somewhere that detection does not scan.) Guarded like the other numerics
    // so the number pass cannot comma-group 1209600 into 1,209,600.
    if ($lower === 'lastaccess' || $lower === 'last') {
        $_laRecip = _sr_current_recipient();
        $la = ($_laRecip !== null && isset($_laRecip['lastAccess'])) ? (int)$_laRecip['lastAccess'] : -1;
        return "\x02" . $la . "\x02";
    }

    // Browser-only modes: theme, density, colorder, colvisible, colsort, coltotal (column count),
    // count, timestamp, prompts, title, url, admin, pivot, group, snapshot,
    // rowexpand, executetime, vw, vh, pagerows, pagepos, pivot_rows, pivot_cols, pivot_vals, pivot_agg
    // These are meaningless in scheduled email context - return empty string.
    return '';
}

function _snippet_info($args, $data, $columns, $viewMode, $promptValues = array(), $reportMeta = array()) {
    $rc = _sr_current_recipient();
    if ($rc === null || empty($rc['isAdmin'])) return '';

    $sections = array(
        'identity'    => array('identity', 'me', 'user'),
        'report'      => array('report', 'data'),
        'view'        => array('view', 'table', 'columns'),
        'prompts'     => array('prompts', 'prompt'),
        'environment' => array('environment', 'env', 'server'),
        'engine'      => array('engine', 'app', 'build'),
    );
    $want = isset($args[0]) ? strtolower(trim(preg_replace('/^[\'"]|[\'"]$/', '', (string)$args[0]))) : '';
    if ($want === '') $want = 'all';
    $show = function ($name) use ($want, $sections) {
        return $want === 'all' || in_array($want, $sections[$name], true);
    };

    $out = '';
    // Parens become entities for the same reason the browser twin does it: the
    // left column is literal `data(count)` text and this engine's dispatch loop
    // re-scans its own output. Belt and braces with the placeholder above.
    $cell = function ($s) {
        return str_replace(array('(', ')'), array('&#40;', '&#41;'),
            htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'));
    };
    $sec = function ($t) use (&$out, $cell) {
        $out .= '<tr><th colspan="2" style="padding:4px 8px;background:#f1f3f5;color:#555;border-top:1px solid #dee2e6;'
             . 'border-bottom:1px solid #dee2e6;text-align:left;text-transform:uppercase;font-size:10px;letter-spacing:0.6px;">'
             . $cell($t) . '</th></tr>';
    };
    $row = function ($k, $v) use (&$out, $cell) {
        $s = ($v === null) ? '' : (string)$v;
        $out .= '<tr><td style="padding:2px 8px;border-bottom:1px solid #eee;color:#666;white-space:nowrap;vertical-align:top;">'
             . $cell($k) . '</td>'
             . '<td style="padding:2px 8px;border-bottom:1px solid #eee;word-break:break-word;vertical-align:top;">'
             . ($s === '' ? '<i style="opacity:0.55">(empty)</i>' : $cell($s)) . '</td></tr>';
    };
    $humanAge = function ($secs) {
        $n = (int)$secs;
        if ($n < 0) return 'never (no recorded visit)';
        if ($n < 60) return $n . ' second' . ($n === 1 ? '' : 's');
        $parts = array();
        foreach (array('day' => 86400, 'hour' => 3600, 'minute' => 60) as $label => $size) {
            $q = intdiv($n, $size);
            if ($q > 0) { $parts[] = $q . ' ' . $label . ($q === 1 ? '' : 's'); $n -= $q * $size; }
        }
        return implode(', ', array_slice($parts, 0, 2));
    };

    if ($show('identity')) {
        $sec('Identity - me()');
        // The SAME placeholders _snippet_me() produces, so what this table shows
        // is by construction what me() will resolve to for this recipient.
        foreach (array('fname' => 'FNAME', 'lname' => 'LNAME', 'unityid' => 'USERNAME', 'email' => 'EMAIL',
                       'dept' => 'DEPT', 'ouc' => 'OUC', 'ouc2d' => 'OUC2D', 'ouc4d' => 'OUC4D',
                       'ouc6d' => 'OUC6D', 'emplid' => 'EMPL_ID', 'emplid4' => 'EMPL_ID4') as $attr => $ph) {
            $row('me(' . $attr . ')', '{' . $ph . '}');
        }
        $row('recipient (raw)', isset($rc['email']) ? $rc['email'] : '');
        $row('unity id (raw)', isset($rc['username']) ? $rc['username'] : '');
        $row('app admin', !empty($rc['isAdmin']) ? 'true' : 'false');
    }

    if ($show('report')) {
        $sec('Report - data()');
        $row('data(subtitle)', isset($reportMeta['reportSubtitle']) ? $reportMeta['reportSubtitle'] : '');
        $row('data(count)', is_array($data) ? count($data) : 0);
        $row('data(search)', isset($reportMeta['searchFilter']) ? $reportMeta['searchFilter'] : '');
        $row('data(rowlimit)', _snippet_data(array('rowlimit'), $promptValues, $reportMeta));
        $la = ($rc !== null && isset($rc['lastAccess'])) ? (int)$rc['lastAccess'] : -1;
        $row('data(lastaccess)', $la . '  [' . $humanAge($la) . ']');
        // Browser-only keys, listed so nobody spends an afternoon wondering why
        // theirs is blank in an email but fine on screen.
        $row('browser-only keys', 'title, theme, density, url, admin, pivot_*, coltotal, colorder, colsort, colvisible, pagerows, pagepos, vw, vh, executetime, timestamp, prompts, snapshot, rowexpand - all empty here');
    }

    if ($show('view')) {
        $sec('View and data shape');
        $row('view mode', $viewMode);
        $row('rows (flat)', is_array($data) ? count($data) : 0);
        $row('columns', is_array($columns) ? count($columns) : 0);
        $row('column names', (is_array($columns) && $columns) ? implode(', ', $columns) : '');
        $firstRow = (is_array($data) && !empty($data)) ? reset($data) : null;
        $row('first row keys', is_array($firstRow) ? implode(', ', array_keys($firstRow)) : '(no rows)');
    }

    if ($show('prompts')) {
        $sec('Prompts');
        $any = false;
        if (is_array($promptValues)) {
            foreach ($promptValues as $k => $v) {
                if (is_array($v)) $v = implode(',', array_map('strval', $v));
                $label = is_int($k) ? ('data(prompt' . ($k + 1) . ')') : ('data(' . $k . ')');
                $row($label, $v);
                $any = true;
            }
        }
        if (!$any) $row('(none)', 'this send resolved no prompts');
    }

    if ($show('environment')) {
        $sec('Server environment');
        $row('PHP version', PHP_VERSION);
        $row('SAPI', PHP_SAPI);
        $row('host', php_uname('n'));
        $row('script', isset($_SERVER['SCRIPT_FILENAME']) ? $_SERVER['SCRIPT_FILENAME'] : __FILE__);
        $row('clock (server)', date('c'));
        $row('timezone', date_default_timezone_get());
        $row('memory / peak', round(memory_get_usage(true) / 1048576, 1) . ' MB / ' . round(memory_get_peak_usage(true) / 1048576, 1) . ' MB');
        $row('oci8 / pdo_oci', (extension_loaded('oci8') ? 'yes' : 'no') . ' / ' . (extension_loaded('pdo_oci') ? 'yes' : 'no'));
        $row('mbstring', extension_loaded('mbstring') ? 'yes' : 'no');
    }

    if ($show('engine')) {
        $sec('Engine');
        $row('snippet engine', 'C - scheduled email (schedule_runner.php)');
        $row('mode', 'per-recipient');
        $row('unavailable here', 'action(), chain(), vis(), slide(), web(), heatmap(), format(), rewrite() are stripped server-side');
        $row('noweb()', 'unwrapped - its content IS included in this email');
    }

    if ($out === '') {
        $row('info(' . $want . ')', 'unknown section - try all, identity, report, view, prompts, environment or engine');
    }

    $html = '<div style="margin:8px 0;border:1px solid #dee2e6;border-radius:4px;font-family:Consolas,\'Courier New\',monospace;'
          . 'font-size:11px;line-height:1.5;text-align:left;color:#222;background:#fff;">'
          . '<div style="padding:5px 8px;background:#336699;color:#fff;font-weight:bold;font-size:11px;letter-spacing:0.4px;">'
          . 'Penumbra info&#40;&#41; - admin diagnostics</div>'
          . '<table style="width:100%;border-collapse:collapse;"><tbody>' . $out . '</tbody></table>'
          . '</div>';

    if (!isset($GLOBALS['penumbra_info_blocks']) || !is_array($GLOBALS['penumbra_info_blocks'])) {
        $GLOBALS['penumbra_info_blocks'] = array();
    }
    $GLOBALS['penumbra_info_blocks'][] = $html;
    // \x01, matching the HTAG placeholders' delimiter: the letters either side of
    // the index keep the number pass's word-boundary lookarounds from seeing a
    // standalone number here.
    return "\x01PNBINFO" . (count($GLOBALS['penumbra_info_blocks']) - 1) . "\x01";
}

function _snippet_restore_info_blocks($text) {
    if (strpos((string)$text, "\x01PNBINFO") === false) return $text;
    $blocks = (isset($GLOBALS['penumbra_info_blocks']) && is_array($GLOBALS['penumbra_info_blocks']))
        ? $GLOBALS['penumbra_info_blocks'] : array();
    return preg_replace_callback("/\x01PNBINFO(\d+)\x01/", function ($m) use ($blocks) {
        return isset($blocks[(int)$m[1]]) ? $blocks[(int)$m[1]] : '';
    }, $text);
}

function penumbra_register_param_pairs($paramString, $pairs) {
    if (!is_string($paramString) || $paramString === '' || !is_array($pairs) || empty($pairs)) return;
    $GLOBALS['penumbra_param_pill_pairs'][$paramString] = $pairs;
}

function _render_param_pills($paramString, $ht) {
    if (empty($paramString)) return '';
    $pairs = array();
    if (isset($GLOBALS['penumbra_param_pill_pairs'][$paramString])) {
        foreach ($GLOBALS['penumbra_param_pill_pairs'][$paramString] as $lv) {
            $pairs[] = array((string)$lv[0], (string)$lv[1]);
        }
    } else {
        // Strip "Parameters: " prefix
        $raw = $paramString;
        if (strpos($raw, 'Parameters: ') === 0) {
            $raw = substr($raw, 12);
        }
        // Split into individual key: value pairs
        foreach (explode('; ', $raw) as $pair) {
            $colonPos = strpos($pair, ': ');
            if ($colonPos !== false) {
                $pairs[] = array(substr($pair, 0, $colonPos), substr($pair, $colonPos + 2));
            } else {
                $pairs[] = array('', $pair);
            }
        }
    }
    $html = "<div style='margin: 8px 0 0; line-height: 2.4;'>";
    foreach ($pairs as $lv) {
        $label = $lv[0];
        $value = $lv[1];
        $pillStyle = "display: inline-block; background-color: {$ht['pillBg']}; border: 1px solid {$ht['pillBorder']}; "
                   . "border-radius: 20px; padding: 3px 10px; margin: 0 4px 4px 0; font-size: 12px; font-family: Verdana, sans-serif;";
        $html .= "<span style='{$pillStyle}'>";
        if (!empty($label)) {
            $html .= "<span style='color: {$ht['pillLabel']}; font-weight: 500;'>" . htmlspecialchars($label) . ":</span> ";
        }
        // Truncate long values (matches front-end 50-char limit), full value on hover
        $displayValue = (strlen($value) > 50) ? substr($value, 0, 50) . '...' : $value;
        $titleAttr = (strlen($value) > 50) ? " title='" . htmlspecialchars($value, ENT_QUOTES) . "'" : '';
        $html .= "<strong style='color: {$ht['pillValue']};'{$titleAttr}>" . htmlspecialchars($displayValue) . "</strong>";
        $html .= "</span> ";
    }
    $html .= "</div>";
    return $html;
}

function penumbra_probe_mta_size_limit() {
    static $cached = null;
    if ($cached !== null) return $cached;
    $cached = 0;
    $host = ini_get('SMTP');
    if (!$host) $host = 'mta.oit.ncsu.edu';
    $port = (int)ini_get('smtp_port');
    if ($port <= 0) $port = 25;
    // Each exit below also RECORDS the outcome for the health picture: this probe
    // happens for its own reasons, so writing down what it saw costs nothing.
    //
    // It is OPPORTUNISTIC, not a heartbeat. penumbra_init_email_budget() is lazy -
    // it only runs when there are due tasks - so on a quiet day this may not fire
    // for hours. That is fine, and arguably ideal: it refreshes SMTP status at the
    // exact moment mail is about to be sent. Steady-state freshness is the
    // watchdog's job (penumbra_monitor.php probes live on every run).
    $fp = @fsockopen($host, $port, $errno, $errstr, 5);
    if (!$fp) {
        log_scheduler("MTA SIZE probe: cannot connect to {$host}:{$port} ({$errstr}).");
        penumbra_smtp_record($host, $port, false, trim((string)$errstr) !== '' ? $errstr : ('errno ' . $errno));
        return $cached;
    }
    stream_set_timeout($fp, 5);
    $banner = fgets($fp, 512);
    if ($banner === false || strpos($banner, '220') !== 0) {
        fclose($fp);
        // Answered but not ready for mail (e.g. 421 shutting down): reachable is
        // not the same as usable, so this counts as down.
        penumbra_smtp_record($host, $port, false, 'bad greeting: ' . trim((string)substr((string)$banner, 0, 80)));
        return $cached;
    }
    fwrite($fp, "EHLO penumbra-scheduler\r\n");
    while (($line = fgets($fp, 512)) !== false) {
        if (preg_match('/^250[- ]SIZE\s+(\d+)/i', trim($line), $m)) {
            $cached = (int)$m[1];
        }
        // Final line of the EHLO response has a space after the code
        // ("250 CHUNKING"); continuation lines use a dash ("250-SIZE ...").
        if (strlen($line) >= 4 && $line[3] === ' ') break;
        $meta = stream_get_meta_data($fp);
        if (!empty($meta['timed_out'])) break;
    }
    fwrite($fp, "QUIT\r\n");
    fclose($fp);
    // A healthy 220 + EHLO is "up" even if SIZE was not advertised - $cached
    // being 0 means "no SIZE extension", not "mail is broken".
    penumbra_smtp_record($host, $port, true,
        $cached > 0 ? ('SIZE ' . $cached) : 'connected (no SIZE advertised)');
    return $cached;
}

function penumbra_drop_oversized_attachment_parts(&$parts, &$names, $maxTotal) {
    $dropped = array();
    $minBodyQp = 131072; // 64KB floor body, QP-encoded, with headroom
    while (!empty($parts)) {
        $partsBytes = 0;
        foreach ($parts as $p) { $partsBytes += strlen($p) + 64; }
        if (($partsBytes + $minBodyQp + 2048) <= $maxTotal) break;
        $li = 0; $ls = -1;
        foreach ($parts as $i => $p) {
            if (strlen($p) > $ls) { $ls = strlen($p); $li = $i; }
        }
        $dropped[] = array(
            'name'  => isset($names[$li]) ? $names[$li] : ('attachment #' . ($li + 1)),
            'bytes' => $ls
        );
        array_splice($parts, $li, 1);
        array_splice($names, $li, 1);
    }
    return $dropped;
}

function penumbra_email_body_budget($rawHtml, $attachmentParts, $maxTotal, $maxBody) {
    $attBytes = 0;
    foreach ($attachmentParts as $p) {
        $attBytes += strlen($p) + 64; // + per-part boundary line
    }
    $overhead = 2048; // MIME headers, body-part headers, final boundary
    $rawLen = strlen($rawHtml);
    $qpLen  = strlen(quoted_printable_encode($rawHtml));
    if ($rawLen <= $maxBody && ($qpLen + $attBytes + $overhead) <= $maxTotal) {
        return array('fits' => true, 'budget' => $rawLen);
    }
    $ratio = ($rawLen > 0) ? ($qpLen / $rawLen) : 1.0;
    if ($ratio < 1.0) $ratio = 1.0;
    $allowedQp = $maxTotal - $attBytes - $overhead;
    $budget = (int)floor(($allowedQp / $ratio) * 0.98);
    if ($budget > $maxBody) $budget = $maxBody;
    // Floor keeps room for the header block + truncation notice even when the
    // attachments alone crowd the total limit (they ship regardless; the body
    // then carries only the header, the notice, and the links).
    if ($budget < 65536) $budget = 65536;
    return array('fits' => false, 'budget' => $budget);
}

function penumbra_email_unsub_strip($html, $liveLinkBase, $reportShortId, $taskId, $themeName = 'theme-default') {
    global $email_header_themes;
    $ht = array();
    if (is_array($email_header_themes)) {
        if (isset($email_header_themes[$themeName])) $ht = $email_header_themes[$themeName];
        else if (isset($email_header_themes['theme-default'])) $ht = $email_header_themes['theme-default'];
    }
    $pillText   = isset($ht['titleColor']) ? $ht['titleColor'] : '#555555';
    $pillBorder = isset($ht['tsColor']) ? $ht['tsColor'] : '#999999';

    $url = $liveLinkBase . '?id=' . rawurlencode(trim((string)$reportShortId)) . '&unsub=' . (int)$taskId;
    $strip = "<table role='presentation' align='right' cellpadding='0' cellspacing='0' style='border-collapse:separate; margin:0 0 8px 14px;'><tr>"
           . "<td style='border:1px solid {$pillBorder}; border-radius:999px; padding:4px 12px; font-family:Arial,Helvetica,sans-serif; font-size:11px; line-height:1.2; white-space:nowrap; mso-padding-alt:4px 12px;'>"
           . "<a href='" . htmlspecialchars($url, ENT_QUOTES) . "' style='color:{$pillText}; text-decoration:none; font-weight:600;'>&#128277;&nbsp;Unsubscribe</a>"
           . "</td></tr></table>";

    $h2 = stripos($html, '<h2');
    if ($h2 !== false) {
        return substr($html, 0, $h2) . $strip . substr($html, $h2);
    }
    if (preg_match('/<body[^>]*>/i', $html, $bm, PREG_OFFSET_CAPTURE)) {
        $pos = $bm[0][1] + strlen($bm[0][0]);
        return substr($html, 0, $pos) . $strip . substr($html, $pos);
    }
    return $strip . $html;
}

function generate_report_html($data, $viewMode, $themeName, $reportTitle, $includeLink, $linkUrl, $isEmail = false, $customLinkText = null, $linkSuffix = '', $preamble = '', $paramString = '', $pivotSettings = null, $importTsLines = array(), $groupAgg = null, $formatRules = array(), $rewriteRules = array(), $snippetOutput = '', $subtitleHtml = '', $extraLinksHtml = '', $truncateOpts = null, $headerNoteHtml = '') {
    global $theme_styles;
    $s = isset($theme_styles[$themeName]) ? $theme_styles[$themeName] : $theme_styles['theme-default'];

    $adjustedFontSize = $s['fontSize'] + 2;

    // Preprocess conditional formatting and rewrite rules
    $cfPrepared = array('header' => array(), 'row' => array(), 'cell' => array());
    $rwPrepared = array();
    if ((!empty($formatRules) || !empty($rewriteRules)) && !empty($data) && $viewMode !== 'pivot') {
        $cfColumns = array();
        if ($viewMode === 'grouped') {
            foreach ($data as $grp) {
                if (!empty($grp)) { $cfColumns = array_keys($grp[0]); break; }
            }
        } else {
            $first = reset($data);
            if (is_array($first)) $cfColumns = array_keys($first);
        }
        if (!empty($cfColumns)) {
            // Flat rowset for GLOBAL aggregate-condition pre-eval AND for
            // sparkline_cell's scale=shared - the same rows this email renders.
            // Hoisted above both branches: it used to be built inside the
            // format() branch, so a report with ONLY rewrite rules had no rowset
            // and a shared-scale sparkline would silently fall back to per-row.
            $cfAggRows = $data;
            if ($viewMode === 'grouped' && is_array($data)) {
                $cfAggRows = array();
                foreach ($data as $cfGrp) {
                    if (is_array($cfGrp)) {
                        foreach ($cfGrp as $cfGrpRow) { $cfAggRows[] = $cfGrpRow; }
                    }
                }
            }
            if (!empty($formatRules)) {
                // $themeName reaches heatmap's ramp builder - PHP has no
                // getComputedStyle, so the endpoints come from themes_config.php.
                $cfPrepared = prepare_format_rules($formatRules, $cfColumns, $cfAggRows, $themeName);
            }
            if (!empty($rewriteRules)) {
                $rwPrepared = prepare_rewrite_rules($rewriteRules, $cfColumns, $cfAggRows);
            }
        }
    }

    $css = "font-family: {$s['fontName']}, sans-serif; font-size: {$adjustedFontSize}px; border-collapse: collapse; width: 100%;";
    $headerGrad = isset($s['headerGradient']) ? " background: {$s['headerGradient']};" : '';
    $thCss = "background-color: {$s['headerBg']};{$headerGrad} color: {$s['headerFont']}; padding: 9px; text-align: left; border: 1px solid {$s['borderColor']};";
    $tdCss = "padding: 7px; border: 1px solid {$s['borderColor']}; color: {$s['dataFont']}; font-size: {$adjustedFontSize}px;";
    $groupHeaderCss = "background-color: {$s['groupHeaderBg']}; color: {$s['groupHeaderFont']}; font-weight: bold; padding: 8px; text-align: left; border: 1px solid {$s['borderColor']}; border-bottom: none; border-radius: 8px 8px 0 0;";

    // Style for totals
    $totalRowStyle = "font-weight: bold; padding: 7px; text-align: left; border: 1px solid {$s['borderColor']}; border-top: 2px solid {$s['headerBg']}; color: {$s['headerFont']}; background-color: {$s['headerBg']};{$headerGrad}";

    // No hidden elements anywhere in the body. Hidden divs - even a standard preheader -
    // can cause Gmail to insert inline "..." (show trimmed content) collapse buttons.
    // Threading / anti-duplication is handled exclusively via a unique Message-ID mail
    // header (added at send time), which forces Gmail to treat each delivery as a
    // separate thread so it never compares this email against a previous run.
     $html = "<!DOCTYPE html><html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'></head><body style='margin:0; padding:0; font-family: {$s['fontName']}, sans-serif;'>";
     $html .= "<table width='100%' border='0' cellspacing='0' cellpadding='0' style='width:100%; background-color:#ffffff;'><tr><td align='left'>";

    // Header Block
    // CHANGED: Improved counting logic for groups
    $rowCount = 0;
    $rowText = "";

    if ($viewMode === 'pivot') {
        // When rank filtering is active, show the actual visible row count
        $rankDirCheck = ($pivotSettings && isset($pivotSettings['rankDir'])) ? $pivotSettings['rankDir'] : null;
        if ($rankDirCheck && $rankDirCheck !== 'none' && $pivotSettings) {
            $rowCount = pivot_count_after_rank($data, $pivotSettings);
            $rowText = "Rows: {$rowCount} (pivoted)";
        } else {
            $rowCount = count($data);
            $rowText = "{$rowCount} source rows (pivoted)";
        }
    } else if ($viewMode === 'grouped') {
        $groupCount = count($data);
        foreach ($data as $grp) $rowCount += count($grp);
        $rowText = "{$rowCount} total rows, in {$groupCount} groups";
    } else {
        $rowCount = count($data);
        $rowText = "Rows: " . $rowCount;
    }

    // Get header block theme (title color, pill colors, etc.)
    global $email_header_themes;
    $ht = isset($email_header_themes[$themeName]) ? $email_header_themes[$themeName] : $email_header_themes['theme-default'];

    // Header block - built entirely with table markup.
    // Previously this used a <div style="border-left: 5px solid ..."> which Gmail
    // recognises as the canonical visual styling for quoted/replied email content
    // (the same way blockquotes are styled with a coloured left border in email
    // clients).  Gmail then collapses the content inside that div as "quoted"
    // and inserts ... (show trimmed content) buttons.  Using a table with a thin
    // coloured accent cell on the left achieves the identical visual result without
    // triggering Gmail's quote detection heuristic.
    $hasSnippetOutput = (!empty($snippetOutput) && trim($snippetOutput) !== '');

    // Outer header table: col 0 = 5px accent stripe, col 1 = metadata, [col 2 = snippet]
    $html .= "<table width='100%' border='0' cellspacing='0' cellpadding='0' "
           . "style='width:100%; border:1px solid {$ht['blockBorder']}; border-collapse:collapse; "
           . "background-color:{$ht['blockBg']}; margin-bottom:20px; border-radius:0 0 8px 8px;'><tr>";

    // Left accent stripe (replaces border-left on the old div)
    $html .= "<td style='width:5px; background-color:{$s['headerBg']}; padding:0; border-radius:0 0 0 8px;'></td>";

    // Metadata column
    $html .= "<td valign='top' style='padding:15px;'>";

    $titleStyle = "margin: 0; color: {$ht['titleColor']};";
    if (!empty($ht['titleExtra'])) $titleStyle .= " {$ht['titleExtra']}";
    $html .= "<h2 style='{$titleStyle}'>" . htmlspecialchars($reportTitle) . "</h2>";
    if (!empty($subtitleHtml) && trim($subtitleHtml) !== '') {
        // Report subtitle / by-line (already snippet-resolved; raw HTML is
        // author-trusted, same policy as $snippetOutput/$preamble).
        $html .= "<div style='margin: 4px 0 0; color: {$ht['tsColor']}; font-size: 13px; line-height: 1.5;'>" . $subtitleHtml . "</div>";
    }
    // $headerNoteHtml: optional inline context appended after the row counts
    // (e.g. the change-analysis "Compared against ..." baseline note). Inherits
    // this line's themed tsColor, so plain text + &middot; stay visible on
    // dark themes.
    $html .= "<p style='margin: 5px 0 0; color: {$ht['tsColor']}; font-size: 10px;'>&#8627; Data retrieved on: " . date("F j, Y, g:i A") . ". " . $rowText . ($headerNoteHtml !== '' ? " " . $headerNoteHtml : "") . "</p>";

    if (!empty($importTsLines)) {
        foreach ($importTsLines as $_itsLine) {
            $html .= "<p style='margin: 2px 0 0; color: {$ht['tsColor']}; font-size: 10px;'>" . htmlspecialchars($_itsLine) . "</p>";
        }
    }

    if (!empty($paramString)) {
        $html .= _render_param_pills($paramString, $ht);
    }

    if ($includeLink) {
        $finalLinkText = $customLinkText;
        if (!$finalLinkText) {
             $finalLinkText = ($viewMode === 'pivot')
                ? "View this report for the interactive pivot view with sorting and search."
                : "View this report to access the latest data. Additional exporting and analytics options are available.";
        }
        // Use the email-header title color (shown on this same blockBg above) so the
        // link contrasts on every theme. The old $s['headerBg'] is a table-header
        // *background* color -> dark-on-dark / invisible on dark themes (e.g. Amber Terminal).
        // $extraLinksHtml (e.g. the change-analysis "View the comparison analysis."
        // deep link) is INLINE content rendered side by side in the SAME line,
        // between the primary link and the suffix. Same include-link gate.
        $html .= "<p style='margin: 10px 0 0;'><a href='{$linkUrl}' style='color: {$ht['titleColor']}; font-weight: bold; text-decoration: underline;'>{$finalLinkText}</a>" . (!empty($extraLinksHtml) ? $extraLinksHtml : '') . htmlspecialchars($linkSuffix) . "</p>";
    }

    $html .= "</td>";  // end metadata column

    // Optional snippet column (right side)
    if ($hasSnippetOutput) {
        $html .= "<td valign='top' align='right' style='padding:15px 15px 15px 0; white-space:nowrap; font-size:14px; font-weight:bold; color:{$s['dataFont']};'>";
        $html .= $snippetOutput;
        $html .= "</td>";
    }

    $html .= "</tr></table>";  // end header table

    if (!empty($preamble)) {
            $html .= "<div style='margin: 0 0 20px 0; color: {$ht['tsColor']}; font-size: 12px; line-height: 1.5; white-space: pre-wrap;'>" . $preamble . "</div>";
        
    }                                                                                                                                                                               
                                                                                                                                                                               
    // --- Byte-budget truncation (scheduled emails) ---
    // When the caller passes truncateOpts {budget, linksHtml}, stop emitting
    // data rows once the accumulated HTML nears the budget, close the current
    // table cleanly, and render an informative notice (with the caller's links)
    // at the truncation point. The reserve keeps the closing tags + notice
    // inside the budget, and the row that crosses the line is rolled back, so
    // the returned string never exceeds the budget.
    $_truncBudget = (is_array($truncateOpts) && isset($truncateOpts['budget'])) ? (int)$truncateOpts['budget'] : 0;
    $_truncLinksHtml = (is_array($truncateOpts) && isset($truncateOpts['linksHtml'])) ? (string)$truncateOpts['linksHtml'] : '';
    $_truncLimit = ($_truncBudget > 0) ? max(16384, $_truncBudget - 8192 - strlen($_truncLinksHtml)) : 0;
    $_truncated = false;
    $_truncShownRows = 0;
    $_truncTotalGroups = 0;
    $_truncPartialGroup = null;
    $_truncOmittedGroupNames = array();

    if (empty($data)) {
        $html .= "<p>No results found.</p>";
    } else {
        if ($viewMode === 'pivot' && $pivotSettings) {
            // Pivot Rendering
            $_pivotHtmlChunk = generate_pivot_html($data, $pivotSettings, $themeName, $isEmail, $formatRules, $rewriteRules);
            if ($_truncLimit && (strlen($html) + strlen($_pivotHtmlChunk)) > $_truncLimit) {
                // A pivot table cannot be row-truncated without recomputing the
                // aggregation, so omit it entirely; the notice + links below
                // carry the reader to the live interactive view instead.
                $_truncated = true;
            } else {
                $html .= $_pivotHtmlChunk;
            }
        } else if ($viewMode === 'grouped') {
            // Grouped Rendering
            //
            // A nested grouping arrives FLAT, with the whole path repeated on
            // every leaf ("College > Dept > FY24"). Left alone that reads as an
            // unstructured list with a lot of duplicated text, so the ancestors
            // are re-derived and drawn as their own bands - each with its own
            // subtree count and summary - and the leaf shows only its own
            // segment, indented. A SINGLE-level grouping has no separator, so
            // every value below is depth 0 and the output is unchanged.
            // (2026-08-30)
            $_grpAnc = penumbra_group_ancestor_index($data);
            $_grpSeen = array();   // ancestor path already banded, per depth
            foreach ($data as $groupName => $groupRows) {
                if (empty($groupRows)) continue;
                $displayGroup = html_entity_decode($groupName, ENT_QUOTES);
                $_truncTotalGroups++;
                if ($_truncated) { $_truncOmittedGroupNames[] = $displayGroup; continue; }
                $_truncGroupStart = strlen($html);

                // Ancestor bands, outermost first. Comparing the FULL path at
                // each depth means a change high up re-bands everything below
                // it for free - the deeper paths differ too.
                $_segs = explode(PENUMBRA_GROUP_PATH_SEP, (string)$groupName);
                $_leafDepth = count($_segs) - 1;
                $_apath = '';
                for ($_d = 0; $_d < $_leafDepth; $_d++) {
                    $_apath = ($_d === 0) ? $_segs[0] : $_apath . PENUMBRA_GROUP_PATH_SEP . $_segs[$_d];
                    if (isset($_grpSeen[$_d]) && $_grpSeen[$_d] === $_apath) continue;
                    $_grpSeen[$_d] = $_apath;
                    $_anc = isset($_grpAnc['#' . $_apath]) ? $_grpAnc['#' . $_apath] : null;
                    if ($_anc === null) continue;
                    $_ancLabel = html_entity_decode($_anc['label'], ENT_QUOTES);
                    $_ancAgg = '';
                    if ($groupAgg && isset($groupAgg['column']) && isset($groupAgg['type'])) {
                        $_gbCol = isset($groupAgg['groupByCol']) ? $groupAgg['groupByCol'] : null;
                        $_aTxt = compute_group_agg_summary($_anc['rows'], $groupAgg['column'],
                            $groupAgg['type'], $_gbCol, $_anc['label']);
                        if ($_aTxt !== null) {
                            $_ancAgg = "<span style='font-style: italic; font-weight: normal;'>" . $_aTxt . "</span>";
                        }
                    }
                    // Outer bands read heavier than the leaf they contain, so
                    // depth is legible without relying on indentation alone -
                    // Outlook's Word engine is unreliable about nested margins.
                    $_ancSize = ($_d === 0) ? '1.05em' : '1em';
                    $_ancIndent = $_d * 18;
                    // An ancestor band is a section HEADING, not the cap of a
                    // table. $groupHeaderCss is built for the cap case -
                    // `border-radius: 8px 8px 0 0` with `border-bottom: none`,
                    // so it opens a box that the table below closes. An
                    // ancestor has another (indented) band below it instead, so
                    // that box never closed and the result was a rounded top
                    // nested inside an un-closed rounded top. Round it on all
                    // four corners and give the bottom border back, so it reads
                    // as a self-contained heading. Later declarations in a
                    // style attribute win, so appending is enough.
                    // (Outlook's Word engine ignores border-radius entirely and
                    // renders both square either way.)
                    $_ancShape = " border-bottom: 1px solid {$s['borderColor']};"
                               . " border-radius: 8px; margin-bottom: 4px;";
                    $html .= "<div style='{$groupHeaderCss}{$_ancShape} margin-left: {$_ancIndent}px; font-size: {$_ancSize};'>";
                    $html .= "<table width='100%' border='0' cellpadding='0' cellspacing='0' style='border-collapse:collapse;'><tr>";
                    $html .= "<td style='padding:0; border:none; text-align:left; font-weight:bold; color:inherit;'>"
                           . htmlspecialchars($_ancLabel)
                           . " <span style='font-size: 0.9em; font-weight: normal;'>" . count($_anc['rows']) . "</span></td>";
                    if ($_ancAgg !== '') {
                        $html .= "<td style='padding:0; border:none; text-align:right; white-space:nowrap; color:inherit;'>{$_ancAgg}</td>";
                    }
                    $html .= "</tr></table></div>";
                }
                // The leaf band names only its OWN segment - its ancestors are
                // already on screen directly above it. $displayGroup keeps the
                // FULL path, because the truncation notices below name groups
                // out of context and "Dept Level Approver" alone would not
                // identify one.
                $_leafLabel = ($_leafDepth > 0)
                    ? html_entity_decode($_segs[$_leafDepth], ENT_QUOTES) : $displayGroup;
                $_leafIndent = $_leafDepth * 18;

                $html .= "<div style='margin-bottom: 25px;" . ($_leafIndent ? " margin-left: {$_leafIndent}px;" : "") . "'>";
                $aggSummary = '';
                if ($groupAgg && isset($groupAgg['column']) && isset($groupAgg['type'])) {
                    $_gbCol = isset($groupAgg['groupByCol']) ? $groupAgg['groupByCol'] : null;
                    $aggText = compute_group_agg_summary($groupRows, $groupAgg['column'], $groupAgg['type'], $_gbCol, $groupName);
                    if ($aggText !== null) {
                        $aggSummary = "<span style='font-style: italic; font-weight: normal;'>" . $aggText . "</span>";
                    }
                }
                if ($aggSummary !== '') {
                    $html .= "<div style='{$groupHeaderCss}'><table width='100%' border='0' cellpadding='0' cellspacing='0' style='border-collapse:collapse;'><tr>";
                    $html .= "<td style='padding:0; border:none; text-align:left; font-weight:bold; color:inherit;'>" . htmlspecialchars($_leafLabel) . " <span style='font-size: 0.9em; font-weight: normal;'>" . count($groupRows) . "</span></td>";
                    $html .= "<td style='padding:0; border:none; text-align:right; white-space:nowrap; color:inherit;'>{$aggSummary}</td>";
                    $html .= "</tr></table></div>";
                } else {
                    $html .= "<div style='{$groupHeaderCss}'>" . htmlspecialchars($_leafLabel) . " <span style='font-size: 0.9em; font-weight: normal;'>" . count($groupRows) . "</span></div>";
                }
                
                $html .= "<table style='{$css}'>";
                $html .= "<thead><tr>";
                $headers = array_keys($groupRows[0]);
                foreach ($headers as $h) {
                    $hStyle = $thCss;
                    foreach ($cfPrepared['header'] as $hr) {
                        if ($hr['targetColumn'] !== null && strtoupper($h) !== $hr['targetColumn']) continue;
                        if ($hr['condition'] === null) {
                            foreach ($hr['_css'] as $prop => $val) $hStyle .= " {$prop}: {$val};";
                        }
                    }
                    $html .= "<th style='{$hStyle}'>" . htmlspecialchars($h) . "</th>";
                }
                $html .= "</tr></thead><tbody>";

                $_truncGrpShown = 0;
                foreach ($groupRows as $idx => $row) {
                    $_truncRowStart = strlen($html);
                    $bg = ($idx % 2 === 0) ? $s['oddBg'] : $s['evenBg'];
                    $fmt = evaluate_row_formatting($row, $idx, $cfPrepared['row'], $cfPrepared['cell'],
                        isset($cfPrepared['heat']) ? $cfPrepared['heat'] : array());
                    $rwMap = apply_rewrite_to_row($row, $idx, $rwPrepared);
                    if (isset($fmt['row']['background-color'])) $bg = $fmt['row']['background-color'];
                    $trExtra = '';
                    foreach ($fmt['row'] as $prop => $val) {
                        if ($prop !== 'background-color') $trExtra .= " {$prop}: {$val};";
                    }
                    $html .= "<tr style='background-color: {$bg};{$trExtra}'>";
                    foreach ($row as $colName => $cell) {
                        $colUpper = strtoupper($colName);
                        $cellBg = $bg;
                        $cellExtra = '';
                        // Merge row overrides + cell-specific overrides
                        $merged = $fmt['row'];
                        if (isset($fmt['cells'][$colUpper])) {
                            $merged = array_merge($merged, $fmt['cells'][$colUpper]);
                        }
                        if (isset($merged['background-color'])) $cellBg = $merged['background-color'];
                        foreach ($merged as $prop => $val) {
                            if ($prop !== 'background-color') $cellExtra .= " {$prop}: {$val};";
                        }
                        // Apply rewrite if this column was rewritten, else use original
                        $cellValue = isset($rwMap[$colUpper]) ? $rwMap[$colUpper] : $cell;
                        $html .= "<td style='{$tdCss} background-color: {$cellBg};{$cellExtra}'>" . formatCellContent($cellValue) . "</td>";
                    }
                    $html .= "</tr>";
                    if ($_truncLimit && strlen($html) > $_truncLimit) {
                        // Roll the crossing row back so the budget holds exactly.
                        $html = substr($html, 0, $_truncRowStart);
                        $_truncated = true;
                        break;
                    }
                    $_truncGrpShown++;
                }
                $_truncShownRows += $_truncGrpShown;
                if ($_truncated) {
                    if ($_truncGrpShown === 0) {
                        // Nothing of this group fit - drop its header/table shell
                        // entirely and report it as omitted.
                        $html = substr($html, 0, $_truncGroupStart);
                        $_truncOmittedGroupNames[] = $displayGroup;
                    } else {
                        // Close without the totals row: a total over a partial
                        // group would misread as the group's real total.
                        $html .= "</tbody></table></div>";
                        $_truncPartialGroup = array('name' => $displayGroup, 'shown' => $_truncGrpShown, 'total' => count($groupRows));
                    }
                } else {
                    $html .= "</tbody>";
                    $html .= renderTotalRow($groupRows, $headers, $totalRowStyle);
                    $html .= "</table></div>";
                }
            }
        } else {
            // Standard Rendering
            $html .= "<table style='{$css}'>";
            $html .= "<thead><tr>";
            $headers = array_keys($data[0]);
            foreach ($headers as $h) {
                $hStyle = $thCss;
                foreach ($cfPrepared['header'] as $hr) {
                    if ($hr['targetColumn'] !== null && strtoupper($h) !== $hr['targetColumn']) continue;
                    if ($hr['condition'] === null) {
                        foreach ($hr['_css'] as $prop => $val) $hStyle .= " {$prop}: {$val};";
                    }
                }
                $html .= "<th style='{$hStyle}'>" . htmlspecialchars($h) . "</th>";
            }
            $html .= "</tr></thead>";

            $html .= "<tbody>";
            foreach ($data as $idx => $row) {
                $_truncRowStart = strlen($html);
                $bg = ($idx % 2 === 0) ? $s['oddBg'] : $s['evenBg'];
                $fmt = evaluate_row_formatting($row, $idx, $cfPrepared['row'], $cfPrepared['cell'],
                    isset($cfPrepared['heat']) ? $cfPrepared['heat'] : array());
                $rwMap = apply_rewrite_to_row($row, $idx, $rwPrepared);
                if (isset($fmt['row']['background-color'])) $bg = $fmt['row']['background-color'];
                $trExtra = '';
                foreach ($fmt['row'] as $prop => $val) {
                    if ($prop !== 'background-color') $trExtra .= " {$prop}: {$val};";
                }
                $html .= "<tr style='background-color: {$bg};{$trExtra}'>";
                foreach ($row as $colName => $cell) {
                    $colUpper = strtoupper($colName);
                    $cellBg = $bg;
                    $cellExtra = '';
                    $merged = $fmt['row'];
                    if (isset($fmt['cells'][$colUpper])) {
                        $merged = array_merge($merged, $fmt['cells'][$colUpper]);
                    }
                    if (isset($merged['background-color'])) $cellBg = $merged['background-color'];
                    foreach ($merged as $prop => $val) {
                        if ($prop !== 'background-color') $cellExtra .= " {$prop}: {$val};";
                    }
                    // Apply rewrite if this column was rewritten, else use original
                    $cellValue = isset($rwMap[$colUpper]) ? $rwMap[$colUpper] : $cell;
                    $content = formatCellContent($cellValue);
                    $html .= "<td style='{$tdCss} background-color: {$cellBg};{$cellExtra}'>{$content}</td>";
                }
                $html .= "</tr>";
                if ($_truncLimit && strlen($html) > $_truncLimit) {
                    // Roll the crossing row back so the budget holds exactly.
                    $html = substr($html, 0, $_truncRowStart);
                    $_truncated = true;
                    break;
                }
                $_truncShownRows++;
            }
            $html .= "</tbody>";
            if (!$_truncated) {
                // Totals over a truncated table would misread as real totals.
                $html .= renderTotalRow($data, $headers, $totalRowStyle);
            }
            $html .= "</table>";
        }
    }

    // Truncation notice - rendered AT the truncation point (right where the
    // table stopped), naming what was cut and linking back to the full data.
    // Plain bordered block on the header-theme palette; deliberately NO
    // border-left accent stripe (Gmail treats left-border divs as quoted
    // content and collapses them - see the header block note above).
    if ($_truncated) {
        $_omittedRows = max(0, $rowCount - $_truncShownRows);
        if ($viewMode === 'pivot' && $pivotSettings) {
            $_truncMsg = "The pivoted table ({$rowText}) is too large to embed in this email, so it was omitted.";
        } else if ($viewMode === 'grouped') {
            $_truncMsg = "Showing " . number_format($_truncShownRows) . " of " . number_format($rowCount) . " rows &mdash; "
                       . number_format($_omittedRows) . " row" . ($_omittedRows == 1 ? "" : "s")
                       . " omitted to keep this email under the size limit.";
            $_truncGrpBits = array();
            if ($_truncPartialGroup !== null) {
                $_truncGrpBits[] = "<strong>" . htmlspecialchars($_truncPartialGroup['name']) . "</strong> is partially shown ("
                                 . number_format($_truncPartialGroup['shown']) . " of " . number_format($_truncPartialGroup['total']) . " rows)";
            }
            if (!empty($_truncOmittedGroupNames)) {
                $_truncNames = array_map('htmlspecialchars', array_slice($_truncOmittedGroupNames, 0, 5));
                $_truncMoreGrps = count($_truncOmittedGroupNames) - count($_truncNames);
                $_truncGrpBits[] = "not shown: <strong>" . implode('</strong>, <strong>', $_truncNames) . "</strong>"
                                 . ($_truncMoreGrps > 0 ? " and " . $_truncMoreGrps . " more group" . ($_truncMoreGrps == 1 ? "" : "s") : "");
            }
            if (!empty($_truncGrpBits)) {
                $_truncMsg .= " " . ucfirst(implode('; ', $_truncGrpBits)) . ".";
            }
        } else {
            $_truncMsg = "Showing the first " . number_format($_truncShownRows) . " of " . number_format($rowCount) . " rows &mdash; "
                       . number_format($_omittedRows) . " row" . ($_omittedRows == 1 ? "" : "s")
                       . " omitted to keep this email under the size limit.";
        }
        $html .= "<div style='margin: 0 0 20px 0; padding: 12px 15px; border: 1px solid {$ht['blockBorder']}; background-color: {$ht['blockBg']}; border-radius: 8px;'>";
        $html .= "<p style='margin: 0; color: {$ht['titleColor']}; font-weight: bold; font-size: 13px;'>&#9888;&#65039; Results truncated</p>";
        $html .= "<p style='margin: 6px 0 0; color: {$ht['tsColor']}; font-size: 12px; line-height: 1.5;'>" . $_truncMsg . "</p>";
        if ($_truncLinksHtml !== '') {
            $html .= $_truncLinksHtml;
        }
        $html .= "</div>";
    }

    // --- WRAPPER END ---
    $html .= "</td></tr></table>";
    // Note: uniqueness / anti-threading is handled solely by the single preheader div
    // at the very top of <body>. No additional hidden elements are used here because
    // mid-body hidden divs are what trigger Gmail's inline ... collapse buttons.
    $html .= "</body></html>";
    return $html;
}

function _drop_file_build_pdf_html($apiResult, $themeName, $reportTitle) {
    global $theme_styles;
    $processedData = isset($apiResult['data']) ? $apiResult['data'] : array();
    if (empty($processedData)) return '';

    $viewMode = isset($apiResult['viewMode']) ? $apiResult['viewMode'] : 'standard';

    // Row count guard (same as EMAIL task - TCPDF chokes on huge tables)
    $_maxRows = 4000;
    if (count($processedData) > $_maxRows) {
        log_scheduler("PDF skipped for DROP_FILE: too many rows (" . count($processedData) . ", max $_maxRows).");
        return '';
    }

    $_theme = isset($theme_styles[$themeName]) ? $theme_styles[$themeName] : (isset($theme_styles['theme-default']) ? $theme_styles['theme-default'] : array());
    $_hdrBg = isset($_theme['headerBg']) ? $_theme['headerBg'] : '#336699';
    $_hdrFg = isset($_theme['headerFont']) ? $_theme['headerFont'] : '#FFFFFF';
    $_cellBg = isset($_theme['oddBg']) ? $_theme['oddBg'] : '#FFFFFF';
    $_cellFg = isset($_theme['dataFont']) ? $_theme['dataFont'] : '#000000';
    $_altBg  = isset($_theme['evenBg']) ? $_theme['evenBg'] : '#F2F2F2';
    $_border = isset($_theme['borderColor']) ? $_theme['borderColor'] : '#DDDDDD';

    $html = '';

    if ($viewMode === 'pivot' && isset($apiResult['pivot']) && !empty($apiResult['pivot'])) {
        // Pivot: use the xlsx row builder for a flat cell layout
        if (function_exists('pivot_build_xlsx_rows')) {
            $_xlsxData = pivot_build_xlsx_rows($processedData, $apiResult['pivot']);
            $html .= '<table border="1" cellpadding="3" cellspacing="0">';
            // Header rows
            if (!empty($_xlsxData['headerRows'])) {
                foreach ($_xlsxData['headerRows'] as $_hRow) {
                    $html .= '<tr>';
                    foreach ($_hRow as $_hCell) {
                        $html .= '<th style="background-color:' . $_hdrBg . ';color:' . $_hdrFg . ';font-size:6px;padding:2px;">'
                            . htmlspecialchars((string)$_hCell) . '</th>';
                    }
                    $html .= '</tr>';
                }
            }
            // Data rows
            if (!empty($_xlsxData['dataRows'])) {
                $_ri = 0;
                foreach ($_xlsxData['dataRows'] as $_dRow) {
                    $_bg = ($_ri % 2 === 0) ? $_cellBg : $_altBg;
                    $html .= '<tr>';
                    foreach ($_dRow as $_dCell) {
                        $html .= '<td style="background-color:' . $_bg . ';color:' . $_cellFg . ';font-size:6px;padding:2px;">'
                            . htmlspecialchars((string)$_dCell) . '</td>';
                    }
                    $html .= '</tr>';
                    $_ri++;
                }
            }
            $html .= '</table>';
        }
    } else {
        // Standard or grouped: build a flat HTML table
        $rows = $processedData;
        // Flatten grouped data
        if ($viewMode === 'grouped') {
            $rows = array();
            foreach ($processedData as $gRows) {
                if (is_array($gRows)) {
                    foreach ($gRows as $r) $rows[] = $r;
                }
            }
        }

        if (empty($rows)) return '';

        $headers = array_keys($rows[0]);
        $html .= '<table border="1" cellpadding="3" cellspacing="0">';
        $html .= '<tr>';
        foreach ($headers as $h) {
            $html .= '<th style="background-color:' . $_hdrBg . ';color:' . $_hdrFg . ';font-size:6px;padding:2px;">'
                . htmlspecialchars($h) . '</th>';
        }
        $html .= '</tr>';

        $_ri = 0;
        foreach ($rows as $row) {
            $_bg = ($_ri % 2 === 0) ? $_cellBg : $_altBg;
            $html .= '<tr>';
            foreach ($headers as $h) {
                $val = isset($row[$h]) ? (string)$row[$h] : '';
                // Strip @@HTML and @@JSON prefixes (same as CSV generator)
                if (substr($val, 0, 6) === '@@HTML') {
                    $val = strip_tags(substr($val, 6));
                } elseif (substr($val, 0, 6) === '@@JSON') {
                    $val = substr($val, 6);
                }
                $html .= '<td style="background-color:' . $_bg . ';color:' . $_cellFg . ';font-size:6px;padding:2px;">'
                    . htmlspecialchars($val) . '</td>';
            }
            $html .= '</tr>';
            $_ri++;
        }
        $html .= '</table>';
    }

    return $html;
}

function generate_csv_string($apiResult) {
    if (empty($apiResult['data'])) return "";

    // Pivot CSV: use dedicated pivot CSV generator
    $viewMode = isset($apiResult['viewMode']) ? $apiResult['viewMode'] : 'standard';
    if ($viewMode === 'pivot' && isset($apiResult['pivot']) && !empty($apiResult['pivot'])) {
        return generate_pivot_csv_string($apiResult['data'], $apiResult['pivot']);
    }

    $data = $apiResult['data'];
    $fp = fopen('php://temp', 'r+');

    // Flatten if grouped
    $rows = $data;
    if (isset($apiResult['viewMode']) && $apiResult['viewMode'] === 'grouped') {
        $rows = array();
        foreach ($data as $gRows) {
            foreach ($gRows as $r) $rows[] = $r;
        }
    }

    if (empty($rows)) return "";

    // Write Header
    fputcsv($fp, array_keys($rows[0]));
    
    // Write Rows
    foreach ($rows as $row) {
        $cleanRow = array_map(function($cell) {
            $val = (string)$cell;
            // @@JSON is the one cell type that cannot defer wholesale: CSV does not
            // nest, so the payload stays raw JSON TEXT (same reason DB_DUMP keeps it
            // as a string). The values inside it still carry display markup, so
            // clean those and re-encode. generate_json_string() makes the opposite
            // choice on the same split, because there it can nest for real.
            if (substr($val, 0, 6) === '@@JSON') {
                $jsonStr = substr($val, 6);
                $decoded = json_decode($jsonStr, true);
                if (is_array($decoded)) {
                    array_walk_recursive($decoded, function(&$v) {
                        $v = db_dump_clean_value($v);
                    });
                    return json_encode($decoded);
                }
                return $jsonStr;
            }
            // @@HTML and plain cells: strip display markup AND decode the entities
            // query.php htmlspecialchars()-added, so the CSV carries plaintext -
            // "A & B", never "A &amp; B". Matches the .xlsx/.json of the same task,
            // the pivot branch above (via pivot_clean_field_value), and the browser's
            // own CSV download. Applies to the EMAIL attachment too - same function.
            return db_dump_clean_value($val);
        }, $row);
        
        fputcsv($fp, $cleanRow);
    }
    
    rewind($fp);
    $csv = stream_get_contents($fp);
    fclose($fp);
    
    // Add BOM for Excel
    return "\xEF\xBB\xBF" . $csv;
}

function generate_json_string($apiResult) {
    if (empty($apiResult['data'])) return "";

    $data = $apiResult['data'];
    $viewMode = isset($apiResult['viewMode']) ? $apiResult['viewMode'] : 'standard';

    // Flatten if grouped. Lossless: grouping is always by a column value, so the
    // group identity is already in each row - as is the CHANGE_TYPE column when
    // a change analysis built these groups.
    $rows = $data;
    if ($viewMode === 'grouped') {
        $rows = array();
        foreach ($data as $gRows) {
            foreach ($gRows as $r) $rows[] = $r;
        }
    }

    if (empty($rows)) return "";

    $out = array();
    foreach ($rows as $row) {
        $cleanRow = array();
        foreach ($row as $key => $cell) {
            // @@JSON is the one cell type that cannot defer: db_dump_clean_value()
            // hands back the raw JSON text because an Oracle column can only hold
            // a string. Here it can nest for real.
            if (is_string($cell) && strpos($cell, '@@JSON') === 0) {
                $decoded = json_decode(substr($cell, 6), true);
                if (is_array($decoded)) {
                    array_walk_recursive($decoded, function (&$v) {
                        $v = db_dump_clean_value($v);
                    });
                    $cleanRow[$key] = $decoded;
                } else {
                    $cleanRow[$key] = substr($cell, 6);
                }
                continue;
            }
            $cleanRow[$key] = db_dump_clean_value($cell);
        }
        $out[] = $cleanRow;
    }

    $json = json_encode($out, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if ($json === false) {
        log_scheduler("  Warning: JSON encoding failed (" . json_last_error_msg() . ").");
        return "";
    }
    return $json;
}

function generate_xlsx_string($apiResult, $themeName) {
    global $theme_styles, $total_exemptions;

    if (empty($apiResult['data'])) return "";

    $data = $apiResult['data'];
    $viewMode = isset($apiResult['viewMode']) ? $apiResult['viewMode'] : 'standard';

    // --- Build list of sheets: array of (sheetName => rows) ---
    $sheets = array();
    $_xlBands = array();      // data-row index => bands to emit immediately before it
    $_xlDataLevel = 0;        // outline level for this sheet's data rows
    $_xlNested = ($viewMode === 'grouped' && penumbra_group_is_nested($data));
    if ($_xlNested) {
        // A NESTED grouping gets ONE sheet with native Excel outline levels,
        // matching what the browser's own XLSX export produces (js/main.js,
        // "A NESTED grouping gets ONE sheet"). One sheet per group stops
        // meaning anything once there are parents: the composite name
        // ("College > Dept > FY24") blows past Excel's 31-character sheet-name
        // limit, so the leaf - the identifying part - is exactly what gets cut,
        // and the survivors collide into " #2"/" #3" dedup suffixes.
        //
        // Bands are recorded against the DATA row they precede rather than
        // being spliced into the row list, so the column-width, per-column
        // stats and footer machinery below still sees data rows only. A blank
        // band cell in a numeric column would otherwise flip `allNumeric` and
        // silently change the footer.
        $_flatRows = array();
        $_seen = array();
        foreach ($data as $groupName => $groupRows) {
            if (empty($groupRows)) continue;
            $segs = explode(PENUMBRA_GROUP_PATH_SEP, (string)$groupName);
            $leafDepth = count($segs) - 1;
            $_xlDataLevel = $leafDepth + 1;
            $pending = array();
            $apath = '';
            for ($d = 0; $d <= $leafDepth; $d++) {
                $apath = ($d === 0) ? $segs[0] : $apath . PENUMBRA_GROUP_PATH_SEP . $segs[$d];
                if ($d < $leafDepth && isset($_seen[$d]) && $_seen[$d] === $apath) continue;
                $_seen[$d] = $apath;
                $count = ($d === $leafDepth)
                    ? count($groupRows)
                    : _xlsx_subtree_count($data, $apath);
                $pending[] = array(
                    'label' => html_entity_decode($segs[$d], ENT_QUOTES, 'UTF-8') . '   (' . $count . ')',
                    'level' => $d
                );
            }
            $_xlBands[count($_flatRows)] = $pending;
            foreach ($groupRows as $r) $_flatRows[] = $r;
        }
        if (!empty($_flatRows)) $sheets['Grouped Data'] = $_flatRows;
    } else if ($viewMode === 'grouped') {
        foreach ($data as $groupName => $groupRows) {
            if (empty($groupRows)) continue;
            // Sanitize sheet name: remove illegal chars
            $name = html_entity_decode((string)$groupName, ENT_QUOTES, 'UTF-8');
            $name = preg_replace('/[\\\\\\/*?\\[\\]:]+/', '', $name);
            $name = trim($name);
            if ($name === '') $name = 'Sheet';
            // Append item count suffix, respecting Excel's 31-char sheet name limit
            $countSuffix = ' (' . count($groupRows) . ')';
            $maxBase = 31 - strlen($countSuffix);
            if ($maxBase < 1) $maxBase = 1;
            $name = substr($name, 0, $maxBase) . $countSuffix;
            // Deduplicate names
            $baseName = $name;
            $dupIdx = 2;
            while (isset($sheets[$name])) {
                $dedupSuffix = ' #' . $dupIdx;
                $name = substr($baseName, 0, 31 - strlen($dedupSuffix)) . $dedupSuffix;
                $dupIdx++;
            }
            $sheets[$name] = $groupRows;
        }
    } else if ($viewMode === 'pivot' && isset($apiResult['pivot']) && !empty($apiResult['pivot'])) {
        // Pivot - handled separately with its own sheet XML generation
        $pivotXlsxData = pivot_build_xlsx_rows($data, $apiResult['pivot']);
    } else {
        // Standard - single sheet, data is flat array of rows
        $sheets['Report Data'] = $data;
    }

    // For pivot mode, we may have no $sheets but have $pivotXlsxData instead
    $hasPivotSheet = isset($pivotXlsxData) && !empty($pivotXlsxData['dataRows']);
    if (empty($sheets) && !$hasPivotSheet) return "";

    // Resolve theme colors (fallback to theme-default)
    $t = isset($theme_styles[$themeName]) ? $theme_styles[$themeName] : $theme_styles['theme-default'];
    $headerBg    = str_replace('#', '', $t['headerBg']);
    $headerFont  = str_replace('#', '', $t['headerFont']);
    $oddBg       = str_replace('#', '', $t['oddBg']);
    $evenBg      = str_replace('#', '', $t['evenBg']);
    $dataFont    = str_replace('#', '', $t['dataFont']);
    $borderColor = str_replace('#', '', $t['borderColor']);
    $fontName    = isset($t['fontName']) ? $t['fontName'] : 'Verdana';
    $fontSize    = isset($t['fontSize']) ? $t['fontSize'] : 9;
    $groupHeaderBg = str_replace('#', '', isset($t['groupHeaderBg']) ? $t['groupHeaderBg'] : 'eeeeee');

    // --- Shared strings (global across all sheets) ---
    $sharedStrings = array();
    $ssIndex = array();
    $ssCount = 0;

    // Helper: register a string and return its shared-string index
    // We build $sharedStrings/$ssIndex/$ssCount by reference via this closure-like approach
    // (PHP 5.3: we just inline calls)

    // --- Number format IDs ---
    // Custom numFmts start at 164 per OOXML spec
    // 164 = "$"#,##0.00  (dollar + comma + 2 decimals)
    // 165 = "$"#,##0      (dollar + comma + no decimals)
    // 166 = #,##0.00      (comma + 2 decimals)
    // 167 = 0.00          (2 decimals only)
    // 168 = #,##0         (comma only)
    $NUMFMT_DOLLAR_DEC = 164;
    $NUMFMT_DOLLAR     = 165;
    $NUMFMT_COMMA_DEC  = 166;
    $NUMFMT_DEC        = 167;
    $NUMFMT_COMMA      = 168;

    // --- Pre-process ALL sheets: clean values, compute widths, detect numbers, build footer ---
    $sheetData = array(); // keyed by sheet name

    foreach ($sheets as $sheetName => $rows) {
        if (empty($rows)) continue;

        $headers = array_keys($rows[0]);
        $colCount = count($headers);

        // Register header strings
        foreach ($headers as $h) {
            if (!isset($ssIndex[$h])) {
                $ssIndex[$h] = $ssCount;
                $sharedStrings[] = $h;
                $ssCount++;
            }
        }

        // Column width tracking
        $colMaxLen = array_fill(0, $colCount, 0);
        for ($c = 0; $c < $colCount; $c++) {
            $colMaxLen[$c] = strlen($headers[$c]) * 1.5 + 5;
        }

        // Per-column stats for totals (same logic as renderTotalRow + JS hasCommas/maxDecimals)
        $colStats = array();
        foreach ($headers as $h) {
            $upperH = strtoupper($h);
            $isWhitelisted = false;
            if (!empty($total_exemptions)) {
                foreach ($total_exemptions as $term) {
                    if (strpos($upperH, strtoupper($term)) !== false) {
                        $isWhitelisted = true;
                        break;
                    }
                }
            }
            $colStats[$h] = array(
                'sum' => 0,
                'hasNumber' => false,
                'allNumeric' => true,
                'isCurrency' => false,
                'isWhitelisted' => $isWhitelisted,
                'hasCommas' => false,
                'maxDecimals' => 0
            );
        }

        $cleanRows = array();
        $rawRows = array();

        foreach ($rows as $row) {
            $cleanRow = array();
            $rawRow = array();
            foreach ($headers as $ci => $key) {
                $raw = isset($row[$key]) ? (string)$row[$key] : '';
                $rawRow[] = $raw;

                $val = $raw;
                // --- @@JSON: parse and format ---
                if (substr($val, 0, 6) === '@@JSON') {
                    $jsonStr = substr($val, 6);
                    $decoded = json_decode($jsonStr, true);
                    $val = ($decoded !== null) ? _xlsx_format_json($decoded, 0) : $jsonStr;
                }
                // --- @@HTML: strip tags, preserve <br> as newlines ---
                elseif (substr($val, 0, 6) === '@@HTML') {
                    $val = _xlsx_html_to_text(substr($val, 6));
                }
                // --- Plain HTML (tags present but no prefix) ---
                elseif (strpos($val, '<') !== false && strpos($val, '>') !== false) {
                    $val = _xlsx_html_to_text($val);
                }
                // --- Decode any remaining HTML entities (e.g. &amp; → &) ---
                else {
                    $val = html_entity_decode($val, ENT_QUOTES, 'UTF-8');
                }

                $cleanRow[] = $val;

                // Column width tracking (longest single line)
                $lines = explode("\n", $val);
                $longest = 0;
                foreach ($lines as $line) {
                    $ll = strlen($line);
                    if ($ll > $longest) $longest = $ll;
                }
                $effectiveLen = $longest * 1.2 + 2;
                if (strpos($val, '$') !== false || preg_match('/^\d{1,2}[\\/\\-]\d{1,2}[\\/\\-]\d{2,4}/', $val)) {
                    $effectiveLen += 6;
                }
                if ($effectiveLen > $colMaxLen[$ci]) {
                    $colMaxLen[$ci] = $effectiveLen;
                }

                // Register shared string (for non-numeric cells)
                if (!isset($ssIndex[$val])) {
                    // Only register if it won't be written as a numeric inline value.
                    // MUST match _xlsx_try_numeric logic: @@HTML/@@JSON raw values are NEVER
                    // written as inline numbers, so always register them as shared strings.
                    $isNum = false;
                    if (substr($raw, 0, 6) !== '@@HTML' && substr($raw, 0, 6) !== '@@JSON') {
                        $cleanNum = str_replace(array('$', ','), '', $val);
                        $isNum = (is_numeric($cleanNum) && trim($val) !== '' && strpos($val, "\n") === false);
                    }
                    if (!$isNum) {
                        $ssIndex[$val] = $ssCount;
                        $sharedStrings[] = $val;
                        $ssCount++;
                    }
                }

                // Totals stats from RAW value (before cleaning)
                $strVal = trim($raw);
                if ($strVal !== '' && substr($raw, 0, 6) !== '@@JSON' && substr($raw, 0, 6) !== '@@HTML') {
                    if (strpos($strVal, '$') !== false) {
                        $colStats[$key]['isCurrency'] = true;
                    }
                    if (strpos($strVal, ',') !== false) {
                        $colStats[$key]['hasCommas'] = true;
                    }
                    if (strpos($strVal, '.') !== false) {
                        $dotParts = explode('.', str_replace(array('$', ',', '(', ')'), '', $strVal));
                        if (count($dotParts) === 2) {
                            $decLen = strlen(preg_replace('/[^0-9]/', '', $dotParts[1]));
                            if ($decLen > $colStats[$key]['maxDecimals']) {
                                $colStats[$key]['maxDecimals'] = $decLen;
                            }
                        }
                    }
                    $numVal = parse_accounting_number($strVal);
                    if ($numVal !== false) {
                        $colStats[$key]['sum'] += $numVal;
                        $colStats[$key]['hasNumber'] = true;
                    } else {
                        $colStats[$key]['allNumeric'] = false;
                    }
                }
            }
            $cleanRows[] = $cleanRow;
            $rawRows[] = $rawRow;
        }

        // Clamp column widths
        $colWidths = array();
        for ($c = 0; $c < $colCount; $c++) {
            $w = $colMaxLen[$c];
            if ($w < 15) $w = 15;
            if ($w > 70) $w = 70;
            $colWidths[$c] = round($w, 2);
        }

        // --- Build footer row data (same engine as renderTotalRow) ---
        // Per-column summary type, resolved through the report's saved
        // columnSummaries exactly as the HTML/PDF footers do, so one workbook
        // and one email never disagree about what a column means.
        $_isCurrencyMap = array();
        foreach ($headers as $h) $_isCurrencyMap[$h] = $colStats[$h]['isCurrency'];
        $summaryTypes = penumbra_resolve_summaries($headers, $_isCurrencyMap, null);

        // Column values, keyed by header, pulled from the RAW rows (which
        // already skip @@JSON/@@HTML cells the same way the sum loop above does).
        $_colValues = array();
        foreach ($headers as $ci => $h) {
            $vals = array();
            foreach ($rawRows as $rr) $vals[] = isset($rr[$ci]) ? $rr[$ci] : '';
            $_colValues[$h] = $vals;
        }

        $footerCols = null;
        $footerLabel = '';
        $_results = array();
        $_typesShown = array();
        foreach ($summaryTypes as $h => $type) {
            $res = penumbra_compute_summary($_colValues[$h], $type, penumbra_is_toggle_column($h), penumbra_resolve_summary_formula($h));
            if ($res === null) continue;
            $_results[$h] = $res;
            $_typesShown[] = $type;
        }

        if (!empty($_typesShown)) {
            $footerLabel = penumbra_summary_header_label($_typesShown);
            $footerCols = array();
            $dataRowCount = count($cleanRows);
            foreach ($headers as $ci => $h) {
                if (!isset($_results[$h])) { $footerCols[$ci] = null; continue; }
                $cs = $colStats[$h];
                $type = $summaryTypes[$h];
                $display = penumbra_format_summary(
                    $_results[$h], $type, $cs['isCurrency'], $cs['maxDecimals']
                );
                // 'sum' keeps its live =SUM() formula so existing workbooks are
                // untouched and still recalculate when a user edits a cell.
                //
                // Every other type is written as a STATIC value. Excel does have
                // AVERAGE/MEDIAN/STDEV.S/COUNTA equivalents, but they would
                // evaluate over the CELLS while our summary evaluates the raw
                // display strings through parse_accounting_number - so a column
                // mixing text and numbers, or one carrying accounting-paren
                // negatives, could show a different number in the workbook than
                // in the email. Parity with the browser beats live recalc here.
                $isNumeric = ($_results[$h]['kind'] === 'num' || $_results[$h]['kind'] === 'int');
                // A live =SUM() is only safe when every contributing cell was
                // written to the sheet as a NUMBER. _xlsx_try_numeric() strips
                // only '$' and ',', so a percent ("12.5%"), an accounting-paren
                // negative rendered oddly, or a \x02-guarded value lands as a
                // shared STRING - and SUM() over strings evaluates to 0. Excel
                // shows the cached total until the first recalculation and then
                // silently zeroes it. This became reachable the moment the
                // summary parser started accepting '%', which is exactly what a
                // whitelisted RATE column contains.
                $formulaSafe = true;
                if ($type === 'sum') {
                    foreach ($_colValues[$h] as $_cv) {
                        if (trim((string)$_cv) === '') continue;
                        // (raw, clean) - passing the same string for both is the
                        // conservative reading: it only ever makes the gate
                        // stricter, never looser.
                        if (_xlsx_try_numeric($_cv, $_cv) === false) { $formulaSafe = false; break; }
                    }
                }
                $footerCols[$ci] = array(
                    'sum' => $isNumeric ? $_results[$h]['value'] : 0,
                    'summaryType' => $type,
                    'useFormula' => ($type === 'sum' && $formulaSafe),
                    'isNumeric' => $isNumeric,
                    'display' => $display,
                    'rawStyle' => $display,
                    'colLetter' => _xlsx_col_letter($ci),
                    'firstDataRow' => 2,
                    'lastDataRow' => $dataRowCount + 1 // header is row 1, data starts row 2
                );
            }
        }

        // Nested sheet: band rows sit BETWEEN data rows, so the data range is no
        // longer contiguous and a live SUM(D2:D51) would name the wrong last
        // row. Fall back to the static value the footer already computed - the
        // number is identical, it just stops recalculating if someone edits a
        // cell. Every other sheet keeps its formula, so existing workbooks are
        // byte-identical.
        $_isBanded = ($sheetName === 'Grouped Data' && !empty($_xlBands));
        if ($_isBanded && $footerCols !== null) {
