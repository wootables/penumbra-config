function pivot_build_agg_display_labels($aggTypes, $customLabels = null) {
    static $abbrevLabels = array(
        'pct_change' => '%Δ', 'pct_change:down' => "%\xce\x94\xe2\x86\x93",
        'diff' => "\xce\x94", 'diff:down' => "\xce\x94\xe2\x86\x93",
        'pct_row_total' => '%Row', 'pct_col_total' => '%Col',
        'pct_parent_row' => '%Par', 'pct_parent_col' => '%ParC',
