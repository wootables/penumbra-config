    // these failure notices share one visual language instead of drifting apart.
    // The shell emits byte-identical output to the inline version this replaced,
    // proven by penumbra_tests\emailshell (five framing branches, before/after
    // diff). Transport below is deliberately NOT shared - see the note there.
    $html  = penumbra_email_open($headline, $band_bg);
    $html .= penumbra_email_intro($intro);
    $html .= penumbra_email_callout('What went wrong', $error_html);
    $html .= penumbra_email_section('Task details', penumbra_email_kv_table($rows));
    $html .= $dbdump_section;   // optional, already assembled above
    $html .= penumbra_email_section('Full technical context', penumbra_email_pre($json));
    $html .= penumbra_email_cta($scheduler_url, $cta_label);
    $html .= penumbra_email_close('You are receiving this because you\'re a failure-notification recipient for this scheduled task (set in the scheduler\'s On Completion options). This is an automated message from the Penumbra scheduler - replies are not monitored.');

    // --- Subject ---
    $subject_label = preg_replace('/[\r\n]+/', ' ', (string)$label);
    $subject = '[Penumbra] ' . $headline . ': ' . $subject_label;
    if ($task_id !== '') { $subject .= ' (task #' . $task_id . ')'; }

    // --- Headers + MIME body ---
    // Wrap the HTML in a multipart/mixed part encoded quoted-printable - the same
    // structure the report emails use (see the EMAIL send path). Quoted-printable's
    // soft line breaks keep mail servers / Gmail from injecting spaces or hard
    // breaks into the long, newline-free HTML lines (which would otherwise surface
    // as literal characters in the rendered message). BCC the admin only when the
    // owner is the To; otherwise To is already the admin (avoids a duplicate).
    $boundary = '----=_Part_' . md5(uniqid(mt_rand(), true));
    $admin_is_recipient = false;
    foreach ($recips as $_r) {
        if (strtolower(trim($_r)) === strtolower($admin_bcc)) { $admin_is_recipient = true; break; }
    }
    $headers  = "MIME-Version: 1.0\r\n";
    $headers .= "From: Penumbra Scheduler <penumbra-scheduler@ncsu.edu>\r\n";
    if (!$admin_is_recipient) { $headers .= "Bcc: " . $admin_bcc . "\r\n"; }
    $headers .= "X-Auto-Response-Suppress: All\r\n";
    $headers .= "Auto-Submitted: auto-generated\r\n";
    $headers .= "Message-ID: <" . md5(uniqid(mt_rand(), true)) . "@ncsu.edu>\r\n";
    $headers .= "Content-Type: multipart/mixed;\r\n boundary=\"{$boundary}\"\r\n";

    $body  = "--{$boundary}\r\n";
    $body .= "Content-Type: text/html; charset=UTF-8\r\n";
    $body .= "Content-Transfer-Encoding: quoted-printable\r\n";
    $body .= "\r\n";
    $body .= quoted_printable_encode($html) . "\r\n";
    $body .= "--{$boundary}--\r\n";

    if (@mail($to, $subject, $body, $headers)) {
        $log_bcc = '';
        if (!$admin_is_recipient) { $log_bcc = ' (bcc ' . $admin_bcc . ')'; }
        log_scheduler("  Failure notification emailed to $to$log_bcc [$dedupe_key].");
    } else {
        log_scheduler("  Warning: failure-notification mail() returned false (to=$to).");
    }
}

function handle_missing_report_task($conn, $task, $context) {
    $taskId   = $task['ID'];
    $short_id = trim((string)$task['REPORT_ID']);

    log_scheduler("  Report '$short_id' no longer exists - deactivating task #$taskId so it stops re-arming.");

    $deactivated = false;
    try {
        $offStmt = $conn->prepare("UPDATE PENUMBRA_SCHEDULED_TASKS SET IS_ACTIVE = 0 WHERE ID = :id");
        $offStmt->bindValue(':id', $taskId);
        $offStmt->execute();
        $deactivated = ($offStmt->rowCount() > 0);
    } catch (Exception $e) {
        log_scheduler("  Warning: could not deactivate task #$taskId: " . $e->getMessage());
    }

    if ($deactivated) {
        log_scheduler("  Task #$taskId deactivated (IS_ACTIVE = 0).");
        $detail = "Report '$short_id' was not found - it no longer exists in PENUMBRA_REPORTS.\n\n"
                . "The report was most likely deleted after this task was created. A task cannot run "
                . "without its report, so the scheduler has deactivated task #$taskId rather than let it "
                . "fail on every future run.\n\n"
                . "To resume it, point the task at an existing report (or restore the deleted one) and "
                . "re-enable it in the scheduler.";
    } else {
        $detail = "Report '$short_id' was not found - it no longer exists in PENUMBRA_REPORTS.\n\n"
                . "The scheduler tried to deactivate task #$taskId automatically and could not, so it will "
                . "keep failing on every scheduled run until it is disabled or re-pointed by hand.";
    }

    $context['report_missing']   = true;
    $context['auto_deactivated'] = $deactivated;

    // Report id is null on purpose: the row is gone, so there is no numeric ID to
    // attribute the audit entry to (the column is nullable - see the null OK note
    // in log_penumbra_scheduler_audit). The short_id travels in the context.
    log_penumbra_scheduler_audit($conn, null, 'SCHEDULE_FAIL', $detail, $context);
}

function send_scheduler_success_email($report_id, $message, $context) {
    static $already_sent = array();
    if (!is_array($context)) { $context = array(); }

    // De-dupe: at most one success email per task per runner invocation.
    $task_id = _sfe_get($context, 'task_id', '');
    if ($task_id !== '') {
        $dedupe_key = 'task:' . $task_id;
    } else {
        $dedupe_key = 'msg:' . md5((string)$message);
    }
    if (isset($already_sent[$dedupe_key])) { return; }
    $already_sent[$dedupe_key] = true;

    // Resolve recipients from the task's notify spec ("me" = owner). No admin
    // fallback or BCC on success (see docblock) - if nothing resolves (e.g. the
    // spec is just "me" and the owner is unknown, with no explicit address) there
    // is no one to notify, so skip silently.
    $owner = trim((string)_sfe_get($context, 'owner', ''));
    $recips = _sfe_resolve_recipients(_sfe_get($context, 'notify_success_recipients', 'me'), $owner);
    if (empty($recips)) {
        log_scheduler("  Success notification skipped: no resolvable recipients [$dedupe_key].");
        return;
    }
    $to = implode(', ', $recips);

    // Display fields.
    $task_type  = _sfe_get($context, 'task_type', 'Scheduled task');
    $label      = _sfe_get($context, 'subject', '(untitled task)');
    $short_id   = _sfe_get($context, 'short_id', _sfe_get($context, 'report_short_id', (string)$report_id));
    $cron       = _sfe_get($context, 'cron', '(unknown)');
    $when       = date('Y-m-d H:i:s T');

    $type_names = array(
        'EMAIL'     => 'Email Report',
        'SNAPSHOT'  => 'Snapshot',
        'DROP_FILE' => 'Drop a File',
        'DB_DUMP'   => 'Dump to Data Source'
    );
    if (isset($type_names[$task_type])) { $type_label = $type_names[$task_type]; }
    else { $type_label = $task_type; }

    // Per-type intro framing.
    if ($task_type === 'SNAPSHOT') {
        $intro = 'A scheduled snapshot of your Penumbra report completed successfully. The details below summarize what was captured.';
    } else if ($task_type === 'DROP_FILE') {
        $intro = 'A scheduled file drop from your Penumbra report completed successfully. The details below summarize what was delivered.';
    } else if ($task_type === 'DB_DUMP') {
        $intro = 'A scheduled data-source dump from your Penumbra report completed successfully. The details below summarize what was written.';
    } else {
        $intro = 'A scheduled task on your Penumbra report completed successfully. The details below summarize the run.';
    }
    $headline = 'Scheduled task succeeded';
    $band_bg  = '#1f7a44';

    // One-time draft test (Test Run from new-task mode): make it unmistakable
    // that nothing recurring was created and the temporary task is gone.
    $is_transient_test = (_sfe_get($context, 'transient_test', false) === true);
    if ($is_transient_test) {
        $headline = 'One-time test run succeeded';
        $intro = 'Your one-time Test Run of a DRAFT scheduled task completed successfully. '
               . 'The draft was not added to the scheduled events - the temporary task removed itself after this single run. '
               . 'The details below summarize what it did.';
        // A draft test has no real schedule (the stored cron may be a
        // placeholder) - don't echo it.
        $cron = 'one-time (immediate)';
    }

    // Use the live/public host (same link the report emails use), NOT the
    // internal API host (oitras) the runner calls server-side.
    $scheduler_url = 'https://www3.acs.ncsu.edu/sponsor_migration/penumbra/index.php';
    if ($short_id !== '' && $short_id !== null) { $scheduler_url .= '?id=' . rawurlencode((string)$short_id); }

    $owner_disp = $owner;

    // --- Task details table ---
    $rows  = '';
    $rows .= _sfe_kv_row('Task', _sfe_h($type_label) . ' - #' . _sfe_h($task_id));
    $rows .= _sfe_kv_row('Label', _sfe_h($label));
    $rows .= _sfe_kv_row('Report', _sfe_h($short_id));
    $rows .= _sfe_kv_row('Schedule', '<code>' . _sfe_h($cron) . '</code>');
    if ($is_transient_test) {
