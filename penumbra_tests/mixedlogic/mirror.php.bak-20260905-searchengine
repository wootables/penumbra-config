                                $_fCtxCvr[$_lblCvr] = (is_numeric($_vCvr) && is_finite($_vCvr)) ? (float)$_vCvr : null;
                            }
                            $totalVal = pivot_eval_formula($_fAstCvr, $_fCtxCvr);
                        }
                    } else {
                        $totalVal = 'N/A';
                    }
                } else {
                    $_csvRtBaseIdx = (isset($rowTotalBaseMap[$rtIdx]) && $rowTotalBaseMap[$rtIdx] >= 0) ? $rowTotalBaseMap[$rtIdx] : false;
                    if ($_csvRtBaseIdx === false) {
                        foreach ($aggTypes as $_bi => $_aat) {
                            if (!pivot_is_derived_agg($_aat)) { $_csvRtBaseIdx = $_bi; break; }
                        }
                    }
                    if ($_csvRtBaseIdx !== false && $at !== $aggTypes[$_csvRtBaseIdx] && !pivot_is_derived_agg($aggTypes[$_csvRtBaseIdx]) && $aggTypes[$_csvRtBaseIdx] !== 'mode' && $aggTypes[$_csvRtBaseIdx] !== 'antimode') {
                        $totalVal = pivot_compute_override_total_from_cell_values('row', $rowKey, $sortedColKeys, $csvCellValues, $_csvRtBaseIdx, $at);
                        $_csvRtFmtType = $aggTypes[$_csvRtBaseIdx];
                    } else {
                        $totalVal = pivot_compute_override_total('row', $rowKey, $sortedColKeys, $data, $at,
                            $_csvRtBaseIdx !== false ? $_aggCol($_csvRtBaseIdx) : null,
                            $_csvRtBaseIdx !== false ? $_aggFilterIdx($_csvRtBaseIdx) : null);
                        $_csvRtFmtType = $at;
                    }
                }
                $formatted = strip_tags(pivot_format_value($totalVal, isset($_csvRtFmtType) ? $_csvRtFmtType : $at, $isCurrency, $sourceMaxDecimals, true));
                $row[] = $formatted;
            }
        }

        fputcsv($fp, $row);
    }

    // Footer row (column totals)
    if (count($allRowKeys) > 1) {
        $footerRow = array();
        // Derive col total label
        $colTotalLabel = 'Grand Total';
        if ($totalColAggs) {
            $uniqueOverrides = array();
            foreach ($totalColAggs as $v) {
                if ($v && !in_array($v, $uniqueOverrides)) $uniqueOverrides[] = $v;
            }
            if (count($uniqueOverrides) === 1) {
                $colTotalLabel = pivot_agg_total_label($uniqueOverrides[0]);
            } elseif (count($uniqueOverrides) > 1) {
                $colTotalLabel = 'Summary';
            }
        } elseif (count($aggTypes) === 1) {
            $colTotalLabel = pivot_agg_total_label($aggTypes[0]);
        }
        $footerRow[] = $colTotalLabel;
        for ($i = 1; $i < count($rowFields); $i++) $footerRow[] = '';

        // Per-column footer totals with per-position override
        // Need to track previous column base totals for pct_change calculation
        $csvPrevColBaseTotals = null;

        foreach ($sortedColKeys as $csvColIdx => $colKey) {
            // Compute base totals for this column (needed for pct_change tracking)
            $csvColBaseTotals = array();
            foreach ($aggTypes as $aggIdx => $at) {
                if (!pivot_is_derived_agg($at)) {
                    $csvColBaseTotals[$aggIdx] = $csvColTotals[$colKey][$aggIdx];
                }
            }

            foreach ($aggTypes as $aggIdx => $at) {
                $effectiveAgg = $at;
                if ($totalColAggs && isset($totalColAggs[$aggIdx]) && $totalColAggs[$aggIdx]) {
                    $effectiveAgg = $totalColAggs[$aggIdx];
                }

                // Context-dependent agg types need special handling
                if (pivot_is_derived_agg($effectiveAgg)) {
                    // Same stale-format guard as the row-total loop above
                    $_csvFtFmtType = $effectiveAgg;
                    if ($effectiveAgg === 'pct_change') {
                        if ($csvColIdx === 0 || !$csvPrevColBaseTotals) {
                            $totalVal = 'N/A';
                        } else {
                            $baseIdx = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                            $currentTotal = isset($csvColTotals[$colKey][$baseIdx]) ? $csvColTotals[$colKey][$baseIdx] : 0;
                            $prevTotal = isset($csvPrevColBaseTotals[$baseIdx]) ? $csvPrevColBaseTotals[$baseIdx] : 0;
                            if ($prevTotal == 0 || $prevTotal >= 1e308 || $prevTotal <= -1e308) {
                                $totalVal = 'N/A';
                            } else {
                                $totalVal = (($currentTotal - $prevTotal) / $prevTotal) * 100;
                            }
                        }
                    } elseif ($effectiveAgg === 'diff') {
                        // Change vs the previous column's total
                        if ($csvColIdx === 0 || !$csvPrevColBaseTotals) {
                            $totalVal = 'N/A';
                        } else {
                            $dBaseIdx = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                            $dCurT = isset($csvColTotals[$colKey][$dBaseIdx]) ? $csvColTotals[$colKey][$dBaseIdx] : 0;
                            $dPrevT = isset($csvPrevColBaseTotals[$dBaseIdx]) ? $csvPrevColBaseTotals[$dBaseIdx] : 0;
                            $totalVal = (!is_numeric($dCurT) || !is_numeric($dPrevT) || abs($dCurT) >= 1e308 || abs($dPrevT) >= 1e308) ? 'N/A' : ($dCurT - $dPrevT);
                        }
                    } elseif ($effectiveAgg === 'pct_change:down' || $effectiveAgg === 'diff:down') {
                        // Footer for a vertical type: FIRST row to LAST row of this column
                        $vBaseIdx = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                        $vBase = $aggTypes[$vBaseIdx];
                        if (count($allRowKeys) > 1) {
                            $vFirstCD = isset($data[$allRowKeys[0]][$colKey]) ? $data[$allRowKeys[0]][$colKey] : null;
                            $vLastCD = isset($data[$allRowKeys[count($allRowKeys) - 1]][$colKey]) ? $data[$allRowKeys[count($allRowKeys) - 1]][$colKey] : null;
                            $vFirstV = pivot_extract_agg_value($vFirstCD, $vBase, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                            $vLastV = pivot_extract_agg_value($vLastCD, $vBase, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                            if (!is_numeric($vFirstV) || !is_numeric($vLastV) || abs($vFirstV) >= 1e308 || abs($vLastV) >= 1e308) {
                                $totalVal = 'N/A';
                            } elseif ($effectiveAgg === 'pct_change:down') {
                                $totalVal = ($vFirstV == 0) ? 'N/A' : (($vLastV - $vFirstV) / $vFirstV) * 100;
                            } else {
                                $totalVal = $vLastV - $vFirstV;
                            }
                        } else {
                            $totalVal = 'N/A';
                        }
                    } elseif ($effectiveAgg === 'pct_row_total') {
                        $sum = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($csvCellValues[$rk][$colKey][$aggIdx]) ? $csvCellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) $sum += $v;
                        }
                        $totalVal = $sum;
                    } elseif ($effectiveAgg === 'pct_col_total') {
                        $totalVal = 100;
                    } elseif ($effectiveAgg === 'pct_parent_row') {
                        $totalVal = 100;
                    } elseif ($effectiveAgg === 'pct_parent_col') {
                        $pcB = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                        $pcN = isset($csvColTotals[$colKey][$pcB]) ? $csvColTotals[$colKey][$pcB] : null;
                        $pcP = pivot_parent_prefix_of($colKey);
                        $pcD = ($csvParent && isset($csvParent['colTot'][$pcP][$pcB])) ? $csvParent['colTot'][$pcP][$pcB] : 0;
                        $totalVal = (!is_numeric($pcN) || $pcD == 0) ? 'N/A' : ($pcN / $pcD) * 100;
                    } elseif ($effectiveAgg === 'pct_cum') {
                        $cfB = pivot_find_base_agg_idx($aggTypes, $aggIdx);
                        $cfI = array_search($colKey, $sortedColKeys, true);
                        $cfC = 0;
                        for ($cfj = 0; $cfj <= $cfI; $cfj++) {
                            $cfv = isset($csvColTotals[$sortedColKeys[$cfj]][$cfB]) ? $csvColTotals[$sortedColKeys[$cfj]][$cfB] : 0;
                            if (is_numeric($cfv)) $cfC += $cfv;
                        }
                        $totalVal = ($_csvGrandBase[$cfB] == 0) ? 'N/A' : ($cfC / $_csvGrandBase[$cfB]) * 100;
                    } elseif ($effectiveAgg === 'pct_cum:down') {
                        $totalVal = 100;
                    } elseif ($effectiveAgg === 'index' || $effectiveAgg === 'index:down') {
                        $sum = 0; $count = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($csvCellValues[$rk][$colKey][$aggIdx]) ? $csvCellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) { $sum += $v; $count++; }
                        }
                        $totalVal = ($count > 0) ? $sum / $count : 'N/A';
                    } elseif ($effectiveAgg === 'pct_grand_total') {
                        // Sum pct_grand_total values across rows for this column.
                        // Use $aggIdx directly - we're iterating main aggs, so the
                        // position IS $aggIdx. array_search-by-type would return the
                        // first occurrence and collapse multiple same-type derived
                        // columns into a single result.
                        $sum = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($csvCellValues[$rk][$colKey][$aggIdx]) ? $csvCellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) $sum += $v;
                        }
                        $totalVal = $sum;
                    } elseif (pivot_is_running_total_like($effectiveAgg)) {
                        // Sum running_total values across rows for this column
                        $sum = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($csvCellValues[$rk][$colKey][$aggIdx]) ? $csvCellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) $sum += $v;
                        }
                        $totalVal = $sum;
                    } elseif ($effectiveAgg === 'running_count' || $effectiveAgg === 'running_count:down') {
                        // Sum running_count values across rows for this column
                        $sum = 0;
                        foreach ($allRowKeys as $rk) {
                            $v = isset($csvCellValues[$rk][$colKey][$aggIdx]) ? $csvCellValues[$rk][$colKey][$aggIdx] : 0;
                            if (is_numeric($v)) $sum += $v;
                        }
                        $totalVal = $sum;
                    } elseif ($effectiveAgg === 'formula') {
                        // CSV column footer: evaluate formula with this column's totals as context
                        $_fAstCff = isset($formulaASTs[$aggIdx]) ? $formulaASTs[$aggIdx] : null;
                        if (!$_fAstCff) {
                            $totalVal = null;
                        } else {
                            $_fCtxCff = array();
                            foreach ($aggTypes as $_oi6 => $_ot6) {
                                if ($_ot6 === 'formula') continue;
                                $_lblCff = isset($aggDisplayLabels[$_oi6]) ? $aggDisplayLabels[$_oi6] : pivot_get_agg_label($_ot6);
                                $_vCff = isset($csvColTotals[$colKey][$_oi6]) ? $csvColTotals[$colKey][$_oi6] : null;
                                $_fCtxCff[$_lblCff] = (is_numeric($_vCff) && is_finite($_vCff)) ? (float)$_vCff : null;
                            }
                            $totalVal = pivot_eval_formula($_fAstCff, $_fCtxCff);
                        }
                    } else {
                        $totalVal = 'N/A';
                    }
                } else {
                    $_csvBaseAgg = $aggTypes[$aggIdx];
                    if ($effectiveAgg !== $_csvBaseAgg && !pivot_is_derived_agg($_csvBaseAgg) && $_csvBaseAgg !== 'mode' && $_csvBaseAgg !== 'antimode') {
                        $totalVal = pivot_compute_override_total_from_cell_values('col', $colKey, $allRowKeys, $csvCellValues, $aggIdx, $effectiveAgg);
                        $_csvFtFmtType = $_csvBaseAgg;
                    } else {
                        $totalVal = pivot_compute_override_total('col', $colKey, $allRowKeys, $data, $effectiveAgg, $_aggCol($aggIdx), $_aggFilterIdx($aggIdx));
                        $_csvFtFmtType = $effectiveAgg;
                    }
                }
                $formatted = strip_tags(pivot_format_value($totalVal, isset($_csvFtFmtType) ? $_csvFtFmtType : $effectiveAgg, $isCurrency, $sourceMaxDecimals, true));
                $footerRow[] = $formatted;
            }

            $csvPrevColBaseTotals = $csvColBaseTotals;
        }

        // Footer Grand Total corner cell(s)
        if ($hasGrandTotalCol) {
            foreach ($rowTotalAggTypes as $rtIdx => $rtAgg) {
                if (pivot_is_derived_agg($rtAgg)) {
                    // Same stale-format guard as the row-total loop above
                    $_csvCrFmtType = $rtAgg;
                    if ($rtAgg === 'pct_change') {
                        if (count($sortedColKeys) > 1) {
                            $firstCK = $sortedColKeys[0];
                            $lastCK  = $sortedColKeys[count($sortedColKeys) - 1];
                            $firstCD = isset($data[$allRowKeys[0]][$firstCK]) ? $data[$allRowKeys[0]][$firstCK] : null;
                            $lastCD  = isset($data[$allRowKeys[0]][$lastCK])  ? $data[$allRowKeys[0]][$lastCK]  : null;
                            // Map row-total token's base to the correct main aggTypes index
                            $_csvCrBaseRtIdx = pivot_find_base_agg_idx($rowTotalAggTypes, $rtIdx);
                            if ($rowTotalAggTypes === $aggTypes) {
                                $baseIdx = $_csvCrBaseRtIdx;
                            } else {
                                $baseIdx = (isset($rowTotalBaseMap[$_csvCrBaseRtIdx]) && $rowTotalBaseMap[$_csvCrBaseRtIdx] >= 0)
                                    ? $rowTotalBaseMap[$_csvCrBaseRtIdx]
                                    : false;
                            }
                            $firstTotal = ($baseIdx !== false && isset($csvColTotals[$firstCK][$baseIdx])) ? $csvColTotals[$firstCK][$baseIdx] : 0;
                            $lastTotal  = ($baseIdx !== false && isset($csvColTotals[$lastCK][$baseIdx]))  ? $csvColTotals[$lastCK][$baseIdx]  : 0;
                            if ($firstTotal == 0 || $firstTotal >= 1e308 || $firstTotal <= -1e308) {
                                $cornerVal = 'N/A';
                            } else {
                                $cornerVal = (($lastTotal - $firstTotal) / $firstTotal) * 100;
                            }
                        } else {
                            $cornerVal = 'N/A';
                        }
                    } elseif ($rtAgg === 'diff') {
                        // Whole-span change of the base column totals
                        $_ccDPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $rtAgg) ? $rtIdx : array_search($rtAgg, $aggTypes, true);
                        $_ccDBaseIdx = ($_ccDPos !== false) ? pivot_find_base_agg_idx($aggTypes, $_ccDPos) : false;
                        if ($_ccDBaseIdx === false || count($sortedColKeys) < 2) {
                            $cornerVal = 'N/A';
                        } else {
                            $_ccDFirst = isset($csvColTotals[$sortedColKeys[0]][$_ccDBaseIdx]) ? $csvColTotals[$sortedColKeys[0]][$_ccDBaseIdx] : 0;
                            $_ccDLast = isset($csvColTotals[$sortedColKeys[count($sortedColKeys) - 1]][$_ccDBaseIdx]) ? $csvColTotals[$sortedColKeys[count($sortedColKeys) - 1]][$_ccDBaseIdx] : 0;
                            $cornerVal = (!is_numeric($_ccDFirst) || !is_numeric($_ccDLast)) ? 'N/A' : ($_ccDLast - $_ccDFirst);
                        }
                    } elseif ($rtAgg === 'pct_change:down' || $rtAgg === 'diff:down') {
                        // Vertical whole-span: first row's base total to the last row's
                        $_ccVdPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $rtAgg) ? $rtIdx : array_search($rtAgg, $aggTypes, true);
                        $_ccVdBaseIdx = ($_ccVdPos !== false) ? pivot_find_base_agg_idx($aggTypes, $_ccVdPos) : false;
                        if ($_ccVdBaseIdx === false || count($allRowKeys) < 2) {
                            $cornerVal = 'N/A';
                        } else {
                            $_ccVdFirst = isset($csvRowTotals[$allRowKeys[0]][$_ccVdBaseIdx]) ? $csvRowTotals[$allRowKeys[0]][$_ccVdBaseIdx] : null;
                            $_ccVdLast = isset($csvRowTotals[$allRowKeys[count($allRowKeys) - 1]][$_ccVdBaseIdx]) ? $csvRowTotals[$allRowKeys[count($allRowKeys) - 1]][$_ccVdBaseIdx] : null;
                            if (!is_numeric($_ccVdFirst) || !is_numeric($_ccVdLast)) {
                                $cornerVal = 'N/A';
                            } elseif ($rtAgg === 'pct_change:down') {
                                $cornerVal = ($_ccVdFirst == 0) ? 'N/A' : (($_ccVdLast - $_ccVdFirst) / $_ccVdFirst) * 100;
                            } else {
                                $cornerVal = $_ccVdLast - $_ccVdFirst;
                            }
                        }
                    } elseif ($rtAgg === 'pct_row_total' || $rtAgg === 'pct_col_total'
                        || $rtAgg === 'pct_parent_row' || $rtAgg === 'pct_parent_col'
                        || $rtAgg === 'pct_cum' || $rtAgg === 'pct_cum:down') {
                        $cornerVal = 100;
                    } elseif ($rtAgg === 'index' || $rtAgg === 'index:down') {
                        $sum = 0; $count = 0;
                        $aggPos = (isset($aggTypes[$rtIdx]) && $aggTypes[$rtIdx] === $rtAgg) ? $rtIdx : array_search($rtAgg, $aggTypes, true);
                        if ($aggPos !== false) {
                            foreach ($allRowKeys as $rk) {
                                foreach ($sortedColKeys as $ck) {
                                    $v = isset($csvCellValues[$rk][$ck][$aggPos]) ? $csvCellValues[$rk][$ck][$aggPos] : 0;
                                    if (is_numeric($v)) { $sum += $v; $count++; }
                                }
                            }
                        }
                        $cornerVal = ($count > 0) ? $sum / $count : 'N/A';
                    } elseif ($rtAgg === 'pct_grand_total') {
                        $cornerVal = 100;
                    } elseif (pivot_is_running_total_like($rtAgg)) {
                        // Sum of all base agg column totals (same as grand total of base)
                        $_csvCrRtBase = pivot_find_base_agg_idx($rowTotalAggTypes, $rtIdx);
                        if ($rowTotalAggTypes === $aggTypes) {
                            $baseIdx = $_csvCrRtBase;
                        } else {
                            $baseIdx = (isset($rowTotalBaseMap[$_csvCrRtBase]) && $rowTotalBaseMap[$_csvCrRtBase] >= 0)
                                ? $rowTotalBaseMap[$_csvCrRtBase]
                                : false;
                        }
                        $sum = 0;
                        if ($baseIdx !== false) {
                            foreach ($sortedColKeys as $ck) {
                                $sum += isset($csvColTotals[$ck][$baseIdx]) ? $csvColTotals[$ck][$baseIdx] : 0;
                            }
                        }
                        $cornerVal = $sum;
                    } elseif ($rtAgg === 'running_count' || $rtAgg === 'running_count:down') {
                        // Sum of all cell counts across all rows and columns
                        $cornerVal = 0;
                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                $cd = isset($data[$rk][$ck]) ? $data[$rk][$ck] : null;
                                $cornerVal += $cd ? (isset($cd['count']) ? $cd['count'] : (isset($cd['values']) ? count($cd['values']) : 0)) : 0;
                            }
                        }
                    } else {
                        $cornerVal = 'N/A';
                    }
                } else {
                    // Resolve base index for format type
                    $_csvCrBaseIdx = (isset($rowTotalBaseMap[$rtIdx]) && $rowTotalBaseMap[$rtIdx] >= 0) ? $rowTotalBaseMap[$rtIdx] : false;
                    if ($_csvCrBaseIdx === false) {
                        foreach ($aggTypes as $_cbi => $_cat) {
                            if (!pivot_is_derived_agg($_cat)) { $_csvCrBaseIdx = $_cbi; break; }
                        }
                    }
                    $_csvCrFmtType = ($_csvCrBaseIdx !== false && $rtAgg !== $aggTypes[$_csvCrBaseIdx]) ? $aggTypes[$_csvCrBaseIdx] : $rtAgg;

                    if ($_csvCrBaseIdx !== false && $rtAgg !== $aggTypes[$_csvCrBaseIdx] && !pivot_is_derived_agg($aggTypes[$_csvCrBaseIdx]) && $aggTypes[$_csvCrBaseIdx] !== 'mode' && $aggTypes[$_csvCrBaseIdx] !== 'antimode') {
                        // Aggregation-aware: use pre-computed cell values
                        $crCellVals = array();
                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                if (isset($csvCellValues[$rk][$ck][$_csvCrBaseIdx]) && is_numeric($csvCellValues[$rk][$ck][$_csvCrBaseIdx])) {
                                    $crCellVals[] = (float)$csvCellValues[$rk][$ck][$_csvCrBaseIdx];
                                }
                            }
                        }
                        if (empty($crCellVals)) {
                            $cornerVal = 0;
                        } elseif ($rtAgg === 'avg') {
                            $cornerVal = array_sum($crCellVals) / count($sortedColKeys);
                        } elseif ($rtAgg === 'count') {
                            $cornerVal = count($crCellVals);
                        } else {
                            $cornerVal = pivot_compute_agg_from_values($crCellVals, $rtAgg);
                        }
                    } else {
                        $allVals = array();
                        $_csvCrOc = $_csvCrBaseIdx !== false ? $_aggCol($_csvCrBaseIdx) : null;
                        foreach ($allRowKeys as $rk) {
                            foreach ($sortedColKeys as $ck) {
                                $cellData = isset($data[$rk][$ck]) ? $data[$rk][$ck] : null;
                                if ($cellData) {
                                    $_csvCrBucket = pivot_resolve_agg_bucket($cellData, $aggColOverrides, $_csvCrBaseIdx !== false ? $_csvCrBaseIdx : 0, $_csvCrBaseIdx !== false ? $_aggFilterIdx($_csvCrBaseIdx) : null);
                                    if ($_csvCrBucket && isset($_csvCrBucket['values'])) {
                                        foreach ($_csvCrBucket['values'] as $v) {
                                            $parsed = pivot_parse_value($v);
                                            if ($parsed !== false) $allVals[] = $parsed;
                                        }
                                    }
                                }
                            }
                        }
                        if ($rtAgg === 'avg') {
                            $totalSum = pivot_compute_agg_from_values($allVals, 'sum');
                            $cornerVal = count($sortedColKeys) > 0 ? $totalSum / count($sortedColKeys) : 0;
                        } else {
                            $cornerVal = pivot_compute_agg_from_values($allVals, $rtAgg);
                        }
                    }
                }
                $formatted = strip_tags(pivot_format_value($cornerVal, isset($_csvCrFmtType) ? $_csvCrFmtType : $rtAgg, $isCurrency, $sourceMaxDecimals, true));
                $footerRow[] = $formatted;
            }
        }

        fputcsv($fp, $footerRow);
    }

    rewind($fp);
    $csvContent = stream_get_contents($fp);
    fclose($fp);
    return $csvContent;
}

function pivot_build_xlsx_rows($flatRows, $pivotSettings) {
    $rowFields = isset($pivotSettings['rows']) ? $pivotSettings['rows'] : array();
    $colFields = isset($pivotSettings['cols']) ? $pivotSettings['cols'] : array();
    $valField = isset($pivotSettings['vals']) ? $pivotSettings['vals'] : '';
    $aggTypes = isset($pivotSettings['agg']) ? $pivotSettings['agg'] : array('sum');
    if (!is_array($aggTypes)) $aggTypes = array($aggTypes);
    $aggCustomLabels = isset($pivotSettings['aggLabels']) ? $pivotSettings['aggLabels'] : null;
    $aggDisplayLabels = pivot_build_agg_display_labels($aggTypes, $aggCustomLabels);
    $aggFormulas = isset($pivotSettings['aggFormulas']) ? $pivotSettings['aggFormulas'] : null;
    $formulaASTs = pivot_parse_all_formulas($aggTypes, $aggFormulas ? $aggFormulas : array());
    $sortOrder = isset($pivotSettings['sortOrder']) ? $pivotSettings['sortOrder'] : 'asc';
    $colSortOrder = isset($pivotSettings['colSortOrder']) ? $pivotSettings['colSortOrder'] : $sortOrder;
    $totalColAggs = isset($pivotSettings['totalColAggs']) ? $pivotSettings['totalColAggs'] : null;
    $totalRowAggs = isset($pivotSettings['totalRowAggs']) ? $pivotSettings['totalRowAggs'] : null;
    $totalRowAggLabels = isset($pivotSettings['totalRowAggLabels']) ? $pivotSettings['totalRowAggLabels'] : null;
    $totalRowAggBaseIdx = isset($pivotSettings['totalRowAggBaseIdx']) ? $pivotSettings['totalRowAggBaseIdx'] : null;
    $rowTotalBaseMap = pivot_resolve_row_total_base_indices($totalRowAggs, $aggTypes, $totalRowAggBaseIdx);
    $aggColOverrides = isset($pivotSettings['aggColOverrides']) ? $pivotSettings['aggColOverrides'] : null;
    $extraValFields = pivot_get_extra_val_fields($aggColOverrides, $valField);
    $aggFilters = isset($pivotSettings['aggFilters']) ? $pivotSettings['aggFilters'] : null;

    $pivotData = pivot_process_data($flatRows, $rowFields, $colFields, $valField, $extraValFields, $aggFilters, $aggTypes);
    $data = $pivotData['data'];
    if (empty($data)) return array('headerRows' => array(), 'dataRows' => array(), 'colTypes' => array(), 'merges' => array(), 'numRowFields' => 0, 'hasGrandTotalCol' => false, 'footerRow' => null);

    // Helper: resolve override column for a given agg index (returns null if no override)
    $_aggCol = function($aggIdx) use ($aggColOverrides, $aggTypes) {
        if (!$aggColOverrides) return null;
        if (pivot_is_derived_agg($aggTypes[$aggIdx])) {
            $baseIdx = null;
            for ($i = $aggIdx - 1; $i >= 0; $i--) {
                if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
            }
            if ($baseIdx === null) {
                for ($i = 0; $i < count($aggTypes); $i++) {
                    if (!pivot_is_derived_agg($aggTypes[$i])) { $baseIdx = $i; break; }
                }
            }
            return $baseIdx !== null ? (isset($aggColOverrides[$baseIdx]) ? $aggColOverrides[$baseIdx] : null) : null;
