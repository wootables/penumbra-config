            // regex character class exactly like the JS engine's ^[chars]+ -
            // NOT PHP's native ltrim(), whose 'a..z' RANGE grammar diverges
            // from the browser's literal char set and throws a per-call
            // ValueError warning on malformed ranges in PHP 8. preg_quote is
            // a superset of the JS escapeCharClass (\ ] ^ -); /u keeps
            // multibyte chars whole, and a preg failure falls back to native.
            $lchars = isset($args[2]) ? $args[2] : '';
            if ($lchars === '') return ltrim($text);
            $lres = @preg_replace('/^[' . preg_quote($lchars, '/') . ']+/u', '', $text);
            return ($lres === null) ? ltrim($text, $lchars) : $lres;
        case 'rtrim':
            // Twin of ltrim above ([chars]+$).
            $rchars = isset($args[2]) ? $args[2] : '';
            if ($rchars === '') return rtrim($text);
            $rres = @preg_replace('/[' . preg_quote($rchars, '/') . ']+$/u', '', $text);
            return ($rres === null) ? rtrim($text, $rchars) : $rres;
        case 'replace':
            $find = isset($args[2]) ? $args[2] : '';
            $replace = isset($args[3]) ? $args[3] : '';
            return str_replace($find, $replace, $text);
        case 'regex_replace':
            // Parity with the client engine (js/penumbra_template.js
            // stringOp): always replaces ALL matches, capture groups $1-$9
            // in the replacement, $0 = whole match, flags limited to the
            // portable i/m/s subset. Error strings mirror the JS ones.
            $pattern     = isset($args[2]) ? $args[2] : '';
            $replacement = isset($args[3]) ? $args[3] : '';
            $rflags      = isset($args[4]) ? $args[4] : '';
            if ($pattern === '') {
                return '[Error: regex_replace requires a pattern]';
            }
            if ($rflags !== '' && preg_match('/[^ims]/', $rflags)) {
                return '[Error: Invalid regex flags: ' . $rflags . ']';
            }
            $rx = '~' . str_replace('~', '\~', $pattern) . '~' . $rflags;
            if (@preg_match($rx, '') === false) {
                return '[Error: Invalid regex pattern]';
            }
            $res = @preg_replace($rx, $replacement, $text);
            return ($res === null) ? '[Error: Invalid regex pattern]' : $res;
        case 'split':
            // Mirror the browser engine: 1-based index, negative-from-end, and
            // '2-4' (range) / '3-' (rest) syntax, with each part trimmed.
            // An EMPTY delimiter is a PHP 8 fatal: explode() throws ValueError
            // "separator cannot be empty" (an Error, invisible to catch(Exception)
            // guards) and kills the whole runner cycle. The client coerces with
            // `params[0] || ','` (js/penumbra_template.js), and an empty arg is
            // reachable via a typed blank, '' or a nested call that resolves
            // empty server-side only (e.g. data(theme)). Coerce identically.
            $delimiter  = (isset($args[2]) && $args[2] !== '') ? $args[2] : ',';
            $indexParam = isset($args[3]) ? (string)$args[3] : '1';
            $parts = explode($delimiter, $text);
            if (strpos($indexParam, '-') !== false && !preg_match('/^-?\d+$/', $indexParam)) {
                $r = explode('-', $indexParam);
                $start = ($r[0] === '') ? 1 : (int)$r[0];
                $end   = (isset($r[1]) && $r[1] !== '') ? (int)$r[1] : null;
                if ($start > 0) { $start = $start - 1; }           // 1-based -> 0-based
                $slice = ($end === null)
                    ? array_slice($parts, $start)
                    : array_slice($parts, $start, $end - $start);
                return implode($delimiter, array_map('trim', $slice));
            }
            $index = (int)$indexParam;
            if ($index < 0) {                                       // -1 = last
                $i = count($parts) + $index;
                return isset($parts[$i]) ? trim($parts[$i]) : '';
            }
            $i = ($index === 0) ? 0 : $index - 1;                   // 1-based; 0 = first
            return isset($parts[$i]) ? trim($parts[$i]) : '';
        case 'substr':
            $start = isset($args[2]) ? (int)$args[2] : 0;
            if (isset($args[3])) {
                $length = (int)$args[3];
                return substr($text, $start, $length);
            }
            return substr($text, $start);
        case 'concat':
            $result = '';
            for ($i = 1; $i < count($args); $i++) {
                $result .= $args[$i];
            }
            return $result;
        case 'padstart':
        case 'padend':
            $length = isset($args[2]) ? (int)$args[2] : 0;
            // An EMPTY pad string is a PHP 8 fatal: str_pad() throws
            // ValueError "Argument #3 ($pad_string) must be a non-empty
            // string", and a fatal in the runner kills the whole scheduled
            // task silently (the task log just stops). The browser never
            // notices because the client engine coerces with `params[1] || ' '`
            // - so `string(padend, X, 8, '')` rendered fine on screen and
            // killed the email. Coerce identically here. This bug predates
            // padend; padstart has carried it since it shipped.
            $char = (isset($args[3]) && $args[3] !== '') ? $args[3] : ' ';
            // Clamp the target length: str_pad() allocates $length bytes up
            // front, and a large value is an uncatchable memory-exhaustion
            // fatal (E_ERROR bailout - even catch(\Throwable) cannot see it)
            // that kills the whole runner cycle. 10000 chars is far beyond
            // any legitimate email padding.
            if ($length > 10000) { $length = 10000; }
            return str_pad($text, $length, $char,
                           ($op === 'padstart') ? STR_PAD_LEFT : STR_PAD_RIGHT);
        case 'length':
            return (string)strlen($text);
        default:
            return $text;
    }
}

function _snippet_case($args, $data, $columns) {
    if (empty($args)) {
        return '';
    }
    $count = count($args);

    // If odd number of args, last is the default
    $hasDefault = ($count % 2 === 1);
    $pairCount = $hasDefault ? ($count - 1) / 2 : $count / 2;

    for ($i = 0; $i < $pairCount; $i++) {
        $condition = $args[$i * 2];
        $value = $args[$i * 2 + 1];

        if (_snippet_case_eval_truthy($condition, $data, $columns)) {
            return $value;
        }
    }

    // Return default if present
    if ($hasDefault) {
        return $args[$count - 1];
    }

    return '';
}

function _snippet_case_eval_truthy($condition, $data, $columns) {
    $cond = trim($condition);

    // Unwrap \x02 number-guards from nested round()/fixed() results and strip
    // their thousands commas so the guarded value compares numerically - the
    // same normalization evaluate_custom_condition applies before comparing.
    // Without this, case(round(sum(X),0) > 100, ...) was ALWAYS false: the
    // guarded operand failed the literal regex, _cf_is_numeric_str, and the
    // date parse, and the text branch has no ordering ops. Per-span so commas
    // inside quoted literals are untouched.
    if (strpos($cond, "\x02") !== false) {
        $cond = preg_replace_callback('/\x02([^\x02]*)\x02/', function ($m) {
            return str_replace(',', '', $m[1]);
        }, $cond);
        $cond = str_replace("\x02", '', $cond); // unbalanced-guard safety
    }

    if ($cond === '') {
        return false;
    }

    $lower = strtolower($cond);
    if ($lower === 'true') {
        return true;
    }
    if ($lower === 'false' || $cond === '0') {
        return false;
    }

    // Scalar emptiness test: "<value> = empty" / "<value> != empty" where the
    // left side is a resolved scalar (e.g. data(search) with no active filter),
    // NOT a column. The browser keeps the resolved value as a protected literal,
    // so an empty value stays an explicit operand; after PHP's raw substitution
    // the left side of "data(search) != empty" simply vanishes when the search
    // is empty, leaving a dangling "!= empty" that parse_format_condition below
    // mis-reads as a global row condition (which fires true -> banner shows with
    // no filter). Match a bare/empty/quoted single-token left operand here. The
    // [^\s=<>!] token class can't span spaces, so a known column ("COLUMN =
    // empty") or a multi-token row condition still falls through untouched.
    if (preg_match('/^([^\s=<>!]*)\s*(==|!=|<>|=)\s*empty\s*$/i', $cond, $em)) {
        $lhs = $em[1];
        // Unwrap a surrounding quote pair to recover the literal value.
        if (strlen($lhs) >= 2 &&
            (($lhs[0] === "'" && substr($lhs, -1) === "'") ||
             ($lhs[0] === '"' && substr($lhs, -1) === '"'))) {
            $lhs = substr($lhs, 1, -1);
        }
        $isColumnRef = false;
        if ($lhs !== '') {
            $bare = strtoupper(preg_replace('/^\{|\}$/', '', $lhs));
            foreach ($columns as $c) {
                if (strtoupper($c) === $bare) { $isColumnRef = true; break; }
            }
        }
        if (!$isColumnRef) {
            $eq = ($em[2] === '=' || $em[2] === '==');
            $isEmpty = (trim($lhs) === '');
            return $eq ? $isEmpty : !$isEmpty;
        }
    }

    // Literal-vs-literal comparison (no column reference on either side).
    // Handles things like `data(rowlimit) = true` after rowlimit has been
    // resolved to the string 'true' or 'false', as well as 1 = 1, 'a' = 'b'.
    // Do this BEFORE parse_format_condition, which assumes a column is
    // involved and would otherwise fail to match.
    // The single-quoted alternative spans \' so an escaped apostrophe does not
    // end the literal early - `'O\'Brien'` has to match as ONE operand here or
    // the whole comparison falls through to the column-condition parser.
    // Browser twin: safeEvaluate's maskQuotes/stripOperand in js/main.js.
    $litRx = '(true|false|-?\d+(?:\.\d+)?|\'(?:[^\'\\\\]|\\\\.)*\'|"[^"]*")';
    if (preg_match('/^\s*' . $litRx . '\s*(==|!=|<>|<=|>=|=|<|>)\s*' . $litRx . '\s*$/i', $cond, $cm)) {
        $lhs = _snippet_case_literal_value($cm[1]);
        $rhs = _snippet_case_literal_value($cm[3]);
        $op = $cm[2];
        switch ($op) {
            case '==': case '=':  return $lhs == $rhs;
            case '!=': case '<>': return $lhs != $rhs;
            case '<':             return $lhs <  $rhs;
            case '>':             return $lhs >  $rhs;
            case '<=':            return $lhs <= $rhs;
            case '>=':            return $lhs >= $rhs;
        }
    }

    // Scalar regex comparison: "<value> = /pattern/" or "/pattern/ != <value>".
    // Mirrors main.js safeEvaluate's regex branch (~22806): the browser keeps
    // data()/me() results as protected string literals, so `data(search) =
    // /DEPART/` reaches it as 'FILTER TEXT' = /DEPART/ and is regex-tested
    // against the resolved text. After PHP's raw substitution the left side is
    // unquoted multi-token text, which parse_format_condition below would
    // mis-read as a row condition (a search-filter value usually parses as
    // one). A bare single-token known column (case(DEPT != /^06/, ...)) still
    // falls through so row-condition semantics are preserved. Like the
    // browser, the regex literal must sit at one END of the condition; a
    // compound `X and Y = /rx/` is regex-tested as one string here because the
    // raw substitution makes an `and` inside the value indistinguishable from
    // a logical one (pre-existing multi-token limitation).
    $rxLit = '\/(?:\\\\\/|[^\/])+\/[iI]?';
    $rxSide = 0; // 1 = regex literal on the right, 2 = on the left
    if (preg_match('/^\s*(.*?)\s*([<>=!]+)\s*(' . $rxLit . ')\s*$/', $cond, $rm)) {
        $rxSide = 1;
    } elseif (preg_match('/^\s*(' . $rxLit . ')\s*([<>=!]+)\s*(.*?)\s*$/', $cond, $rm)) {
        $rxSide = 2;
    }
    if ($rxSide) {
        $testRaw = ($rxSide === 1) ? $rm[1] : $rm[3];
        $regexTok = ($rxSide === 1) ? $rm[3] : $rm[1];
        $op = $rm[2];
        $wasQuoted = false;
        if (strlen($testRaw) >= 2 &&
            (($testRaw[0] === "'" && substr($testRaw, -1) === "'") ||
             ($testRaw[0] === '"' && substr($testRaw, -1) === '"'))) {
            $testRaw = substr($testRaw, 1, -1);
            $wasQuoted = true;
        }
        $isColumnRef = false;
        if (!$wasQuoted && $testRaw !== '' && !preg_match('/\s/', $testRaw)) {
            $bare = strtoupper(preg_replace('/^\{|\}$/', '', $testRaw));
            foreach ($columns as $c) {
                if (strtoupper($c) === $bare) { $isColumnRef = true; break; }
            }
        }
        if (!$isColumnRef) {
            if (strcasecmp(trim($testRaw), 'empty') === 0) {
                $testRaw = '';
            }
            if (preg_match('/^\/(.*)\/([iI])?$/', $regexTok, $rp)) {
                // Default is case-insensitive when the flag is absent; an
                // UPPERCASE I means case-SENSITIVE, matching the row-condition
                // engines on both sides. (This branch used to ignore the
                // captured flag and always test /i.)
                $rxFlags = (isset($rp[2]) && $rp[2] === 'I') ? '' : 'i';
                $hit = @preg_match('/' . $rp[1] . '/' . $rxFlags, $testRaw);
                if ($hit !== false) {
                    if ($op === '=' || $op === '==') { return ($hit === 1); }
                    if ($op === '!=' || $op === '<>') { return ($hit !== 1); }
                }
            }
            // Malformed/invalid regex or an ordering op (>, <=, ...) on a
            // regex literal is false in the browser too.
            return false;
        }
    }

    // Check if it looks like a comparison expression (contains operator)
    if (preg_match('/[<>=!]/', $cond)) {
        $parsed = parse_format_condition($cond, $columns);
        if ($parsed !== null && $parsed !== false) {
            // Evaluate against first row of data (or empty row)
            $rowData = (!empty($data) && is_array($data)) ? $data[0] : array();
            return evaluate_format_condition($rowData, $parsed);
        }
    }

    // Numeric check: 0 is false, non-zero is true
    $num = _cf_parse_num($cond);
    if ($num !== false) {
        return ($num != 0);
    }

    // Non-empty string is true
    return true;
}

function _snippet_case_literal_value($tok) {
    $tok = trim($tok);
    $lower = strtolower($tok);
    if ($lower === 'true') return true;
    if ($lower === 'false') return false;
    $len = strlen($tok);
    if ($len >= 2) {
        $first = $tok[0];
        $last = $tok[$len - 1];
        // A \' inside a SINGLE-quoted literal is an escaped apostrophe (same rule
        // as parse_format_args); leaving the backslash in made `'O\'Brien'`
        // compare as the literal text O\'Brien and never match. Double-quoted
        // literals keep their \" - load-bearing for nested "raw|…" payloads.
        // Browser twin: stripOperand in safeEvaluate (js/main.js).
        if ($first === "'" && $last === "'") {
            return str_replace("\\'", "'", substr($tok, 1, $len - 2));
        }
        if ($first === '"' && $last === '"') {
            return substr($tok, 1, $len - 2);
        }
    }
    if (is_numeric($tok)) return $tok + 0; // int or float
    return $tok;
}

function _snippet_lookup($args, $data, $columns) {
