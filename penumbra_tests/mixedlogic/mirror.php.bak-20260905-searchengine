    //   15 = even + #,##0     (168)
    //   16 = footer + $#,##0.00 (164)
    //   17 = footer + $#,##0    (165)
    //   18 = footer + #,##0.00  (166)
    //   19 = footer + 0.00      (167)
    //   20 = footer + #,##0     (168)
