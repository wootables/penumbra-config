                    $baseVal = isset($cellValues[$rowKey][$colKey][$baseIdx]) ? $cellValues[$rowKey][$colKey][$baseIdx] : 0;
                    $cellValues[$rowKey][$colKey][$aggIdx] = ($colTotal != 0) ? ($baseVal / $colTotal) * 100 : null;
