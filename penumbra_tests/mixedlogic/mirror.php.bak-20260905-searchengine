        }
    }
    $ssXml .= '</sst>';

    // --- Build per-sheet XML and assemble workbook ---
    $sheetFiles = array(); // 'sheet1.xml' => xml content
    $sheetIndex = 1;
    $sheetNames = array(); // for workbook.xml

    foreach ($sheetData as $sheetName => $sd) {
        $headers    = $sd['headers'];
        $colCount   = $sd['colCount'];
        $colWidths  = $sd['colWidths'];
        $cleanRows  = $sd['cleanRows'];
        $rawRows    = $sd['rawRows'];
        $footerCols = $sd['footerCols'];
        $footerLabel = isset($sd['footerLabel']) ? $sd['footerLabel'] : '';

        $_bands = isset($sd['bands']) ? $sd['bands'] : array();
        $_dataLevel = isset($sd['dataLevel']) ? $sd['dataLevel'] : 0;
        $_bandMerges = array();

        $isFirst = ($sheetIndex === 1);
        $xml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
            . '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">';

        // summaryBelow="0": our band row sits ABOVE its detail. Excel's default
        // assumes the summary is underneath and would put the +/- control on
        // the wrong row. Must precede <sheetViews> to satisfy the schema.
        if (!empty($_bands)) {
            $xml .= '<sheetPr><outlinePr summaryBelow="0" summaryRight="0"/></sheetPr>';
