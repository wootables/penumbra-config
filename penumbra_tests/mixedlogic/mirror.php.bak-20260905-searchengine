function penumbra_find_unquoted_double_colon($str) {
    $inS = false; $inD = false; $len = strlen($str);
    for ($i = 0; $i < $len - 1; $i++) {
        $c = $str[$i];
        if ($c === "'" && !$inD) $inS = !$inS;
        elseif ($c === '"' && !$inS) $inD = !$inD;
        elseif ($c === ':' && $str[$i+1] === ':' && !$inS && !$inD) return $i;
    }
    return false;
}

function penumbra_find_unquoted_colon($str) {
    $inS = false; $inD = false; $len = strlen($str);
    for ($i = 0; $i < $len; $i++) {
        $c = $str[$i];
        if ($c === "'" && !$inD) $inS = !$inS;
        elseif ($c === '"' && !$inS) $inD = !$inD;
        elseif ($c === ':' && !$inS && !$inD) return $i;
    }
    return false;
}

function penumbra_split_options_value($value) {
    $parts = array(); $current = ''; $inS = false; $inD = false; $len = strlen($value);
    for ($i = 0; $i < $len; $i++) {
        $c = $value[$i];
        if ($c === "'" && !$inD) { $inS = !$inS; $current .= $c; }
        elseif ($c === '"' && !$inS) { $inD = !$inD; $current .= $c; }
        elseif ($c === ',' && !$inS && !$inD) { $parts[] = $current; $current = ''; }
        else { $current .= $c; }
    }
    if ($current !== '') $parts[] = $current;
    return $parts;
}

function penumbra_parse_per_option_templates($content) {
    $map = array();
    if (!preg_match_all('/\boptions=([^;]*(?:;(?!\s*[a-zA-Z0-9_-]+=|\s*\bhidden\b|\s*\bnoquote\b|\s*\bnosave\b|\s*\bforcedefault\b)[^;]*)*)/i', $content, $matches)) {
        return $map;
    }
    foreach ($matches[1] as $optionsValue) {
        $parts = penumbra_split_options_value($optionsValue);
        foreach ($parts as $part) {
            $trimmed = trim($part);
            if ($trimmed === '') continue;
            $tplPos = penumbra_find_unquoted_double_colon($trimmed);
            if ($tplPos === false) continue;
            $mainPart = trim(substr($trimmed, 0, $tplPos));
            $template = trim(substr($trimmed, $tplPos + 2));
            if (strlen($template) >= 2) {
                $first = $template[0]; $last = substr($template, -1);
                if (($first === '"' && $last === '"') || ($first === "'" && $last === "'")) {
                    $template = substr($template, 1, -1);
                }
            }
            $colonPos = penumbra_find_unquoted_colon($mainPart);
            $value = ($colonPos !== false) ? trim(substr($mainPart, $colonPos + 1)) : $mainPart;
            if (strlen($value) >= 2) {
                $first = $value[0]; $last = substr($value, -1);
                if (($first === '"' && $last === '"') || ($first === "'" && $last === "'")) {
                    $value = substr($value, 1, -1);
                }
            }
            $map[$value] = $template;
        }
    }
    return $map;
}

function process_scheduler_prompts($sql, $answers, &$resolvedMap = array(), &$resolvedByName = array(), $me_map = array()) {
    $promptTags = extractPromptTags($sql);

    if (empty($promptTags)) return $sql;

    // Plain-text me() substitution for VALUES (prompt answers / defaults used in
    // date-range lookups). Deliberately NOT _sr_substitute_me_map_sql - that
    // engine quotes per SQL context, which corrupts a bare value string.
    $normMeMap = array();
    if (is_array($me_map)) {
        foreach ($me_map as $mk => $mv) { $normMeMap[strtolower(trim((string)$mk))] = $mv; }
    }
    $applyMeToValue = function($v) use ($normMeMap) {
        if (!is_string($v) || $v === '' || empty($normMeMap) || stripos($v, 'me(') === false) return $v;
        return preg_replace_callback('/\bme\(\s*([A-Za-z0-9_]*)\s*\)/i', function($mm) use ($normMeMap) {
            // Bare me() maps to the empty-string key, matching _sr_substitute_me_map_sql.
            $key = strtolower(trim($mm[1]));
            return array_key_exists($key, $normMeMap) ? (string)$normMeMap[$key] : $mm[0];
        }, $v);
    };

    // Process backwards to preserve offsets during substr_replace
    for ($t = count($promptTags) - 1; $t >= 0; $t--) {
        $full_tag = $promptTags[$t]['full_tag'];
        $tagOffset = $promptTags[$t]['offset'];
        $content = $promptTags[$t]['inner_content'];

        $params = [];
        preg_match_all('/([a-zA-Z0-9_-]+)=([^;]*(?:;(?!\s*[a-zA-Z0-9_-]+=|\s*\bhidden\b|\s*\bnoquote\b|\s*\bnosave\b|\s*\bforcedefault\b)[^;]*)*)/', $content, $pairs, PREG_SET_ORDER);
        foreach ($pairs as $pair) {
            $k = strtolower(trim($pair[1]));
            $v = trim($pair[2]);
            // Strip surrounding quotes on template values to match the JS parser.
            // Without this, `template=""` is read as the literal 2-char string `""`
            // instead of an empty "control prompt" template, and ends up injected
            // into the SQL as an empty alias.
            if ($k === 'template' && strlen($v) >= 2) {
                $first = $v[0]; $last = substr($v, -1);
                if (($first === '"' && $last === '"') || ($first === "'" && $last === "'")) {
                    $v = substr($v, 1, -1);
                }
            }
            $params[$k] = $v;
        }
        if (stripos($content, 'noquote') !== false) $params['noquote'] = true;

        $name = isset($params['name']) ? $params['name'] : null;

        // --- RESULTIF LOGIC ---
        // If this prompt has a resultif condition, evaluate it against the parent's answer.
        // When the condition fails, the prompt is removed AND we try to strip a single
        // preceding SQL clause fragment so the query stays valid.
        //
        // INTENTIONALLY NARROW - only handles `AND/OR col OP` and `WHERE col OP` (where OP
        // is one of = != <> < > <= >= LIKE IN BETWEEN IS / IS NOT, with optional NOT). Does
        // NOT handle function-wrapped columns (TRUNC, UPPER), arithmetic, parenthesized
        // expressions, HAVING, subquery contexts, or dialect-specific operators. Authors with
        // those shapes should wrap their entire conditional clause inside template="..." on
        // the prompt - when resultif fails the whole clause then vanishes cleanly. See the
        // decision-tree help (data-tip="resultif") for the recommended pattern.
        //
        // SAME REGEX lives in js/main.js (showPromptDialog flow) and index.php - keep all
        // three in sync if you ever do change them.
        if (isset($params['resultif'])) {
            $rifParts = explode(':', $params['resultif'], 2);
            if (count($rifParts) == 2) {
                $parentName = trim($rifParts[0]);
                $expectedVal = trim($rifParts[1]);

                // Negation support: "resultif=parent:!value" inverts the match
                $negate = false;
                if (strlen($expectedVal) > 0 && $expectedVal[0] === '!') {
                    $negate = true;
                    $expectedVal = substr($expectedVal, 1);
                }

                $actualVal = isset($answers[$parentName]) ? $answers[$parentName] : '';
                // Multi-select parents answer as ARRAYS; the client matches
                // per-element (a (string) cast compares the literal 'Array'
                // and silently strips the child prompt + its SQL clause).
                $actualList = is_array($actualVal) ? array_map('strval', $actualVal) : array((string)$actualVal);

                // Support regex comparison (value wrapped in /.../)
                $isMatch = false;
                if (preg_match('/^\/.*\/[a-z]*$/i', $expectedVal)) {
                    foreach ($actualList as $avItem) {
                        if (@preg_match($expectedVal, $avItem)) { $isMatch = true; break; }
                    }
                } else {
                    // Standard match with pipe-delimited multi-value support (val1|val2)
                    $expectedValues = explode('|', $expectedVal);
                    foreach ($actualList as $avItem) {
                        if (in_array($avItem, $expectedValues, true)) { $isMatch = true; break; }
                    }
                }

                // Apply negation after evaluation
                if ($negate) $isMatch = !$isMatch;

                if (!$isMatch) {
                    // Condition failed - strip the prompt and its preceding SQL clause
                    $precedingSql = substr($sql, 0, $tagOffset);

                    // Pattern 1: Strip trailing AND/OR + column + operator
                    $andOrClause = '/\s+(AND|OR)\s+(?:[\w."]+\s*\.\s*)?[\w."]+\s*(?:NOT\s+)?(?:>=|<=|!=|<>|>|<|=|LIKE|IN|BETWEEN|IS(?:\s+NOT)?)\s*$/i';
                    if (preg_match($andOrClause, $precedingSql, $cm)) {
                        $stripLen = strlen($cm[0]);
                        $sql = substr($sql, 0, $tagOffset - $stripLen) . substr($sql, $tagOffset + strlen($full_tag));
                    } else {
                        // Pattern 2: WHERE as first condition - replace with WHERE 1=1
                        $whereClause = '/\s+(WHERE)\s+(?:[\w."]+\s*\.\s*)?[\w."]+\s*(?:NOT\s+)?(?:>=|<=|!=|<>|>|<|=|LIKE|IN|BETWEEN|IS(?:\s+NOT)?)\s*$/i';
                        if (preg_match($whereClause, $precedingSql, $wm)) {
                            $stripLen = strlen($wm[0]);
                            $sql = substr($sql, 0, $tagOffset - $stripLen) . ' WHERE 1=1' . substr($sql, $tagOffset + strlen($full_tag));
                        } else {
                            // No clause detected - just remove the tag (best effort)
                            $sql = substr_replace($sql, "", $tagOffset, strlen($full_tag));
                        }
                    }
                    $actualDisplay = implode(',', $actualList);
                    log_scheduler("  Prompt '$name' skipped: resultif condition not met (parent '$parentName' = '$actualDisplay', expected '$expectedVal').");
                    continue;
                }
            }
        }
        // --- END RESULTIF ---

        $val = null;

        // Priority: Forced Default > Saved Answer > Default
        // forcedefault MUST take precedence so dynamic phrases like
        // "first day of last month" re-resolve at execution time (via the
        // natural-language date parser below) instead of using a stale
        // saved answer from task-creation time.
        if (isset($params['forcedefault'])) {
            $val = $params['forcedefault'];
        } elseif ($name && isset($answers[$name]) && $answers[$name] !== '') {
            $val = $answers[$name];
        } elseif (isset($params['default'])) {
            $val = $params['default'];
        }

        // Multi-select/checkbox prompts save ARRAY answers. The client joins
        // them with ',' for substitution; PHP 8's trim() below throws a
        // TypeError on an array - which used to kill the task on every cycle -
        // and the SQL substitution needs a scalar anyway. Coerce identically.
        if (is_array($val)) {
            $val = implode(',', array_map('strval', $val));
        }

        // Dynamic date-range prompts: resolve `min`/`max` keywords via the shared
        // MIN/MAX lookup (penumbraApplyDateRangeKeyword, shared_logic.php). {name}
        // tokens in the autofill condition are filled from the task's stored
        // answers, falling back to the named prompt's own forcedefault/default;
        // me() phrases in either source resolve through the task's me-map.
        if ($val !== null && $val !== '') {
            $val = penumbraApplyDateRangeKeyword($params, $val, function($n) use ($answers, $promptTags, $applyMeToValue) {
                $v = (isset($answers[$n]) && $answers[$n] !== '' && !is_array($answers[$n])) ? $answers[$n] : null;
                if ($v === null) {
                    foreach ($promptTags as $ot) {
                        if (!preg_match('/\bname\s*=\s*' . preg_quote($n, '/') . '\s*(;|$)/i', $ot['inner_content'])) continue;
                        if (preg_match('/\bforcedefault\s*=\s*([^;]*)/i', $ot['inner_content'], $dm)
                            || preg_match('/\bdefault\s*=\s*([^;]*)/i', $ot['inner_content'], $dm)) {
                            $v = trim($dm[1]);
                        }
                        break;
                    }
                }
                return ($v === null) ? null : $applyMeToValue($v);
            });
        }

        if ($val === null || $val === '') {
            // Empty prompt - substitute SQL NULL and log a warning (not fatal)
            $promptLabel = isset($params['label']) ? $params['label'] : (isset($params['message']) ? $params['message'] : ($name ? $name : "Unknown Prompt"));
            log_scheduler("  WARNING: Prompt '$promptLabel' has no value - substituting NULL.");
            $logName = $name ? $name : 'Unnamed';
            $displayName = isset($params['label']) ? $params['label'] : (isset($params['message']) ? $params['message'] : $logName);
            $resolvedMap[$displayName] = null;
            $sql = substr_replace($sql, "NULL", $tagOffset, strlen($full_tag));
            continue;
        }

        // Calculate dynamic dates in PHP to generate a valid string literal.
        // The whole grammar lives in _sr_resolve_relative_date() so the search
        // filter resolves prompts' vocabulary identically; it returns null when
        // the value is not a relative date, leaving $val alone.
        $trimVal = trim($val);
        $resolvedRelDate = _sr_resolve_relative_date($trimVal);
        if ($resolvedRelDate !== null) {
            $val = $resolvedRelDate;
        }

        $logName = $name ? $name : 'Unnamed';
        // Priority: Label -> Message -> Name (for the email display)
        $displayName = isset($params['label']) ? $params['label'] : (isset($params['message']) ? $params['message'] : $logName);

        // DISPLAY copy of the answer. $val deliberately KEEPS its me() tokens so
        // the SQL substitution below stays byte-identical - the SQL pass resolves
        // them later via _sr_substitute_me_map_sql(), which quotes per SQL context
        // and a value-shaped substitution here would corrupt. But every consumer
        // that SHOWS the answer reads the maps built below, and those were never
        // me()-resolved: the email header's parameter pills, the PDF cover's
        // parameter line, data(promptN) inside snippets/subtitles, snapshot
        // labels, and the deep link that pre-answers prompts all printed the raw
        // "me(lname), me(fname) (me(emplid4))" while the rows underneath were
        // correctly filtered by the resolved identity.
        //
        // Same $me_map the SQL pass uses, so the header can never disagree with
        // the data it heads. A me()->{LNAME} mapping stays a recipient var here
        // ON PURPOSE - the per-recipient pass downstream ($applyRecipientVars,
        // which also re-registers the pill pairs) resolves it against each
        // recipient, so the pill matches the rows that recipient actually got.
        // Unmapped tokens are left standing, matching _sr_substitute_me_map_sql()'s
        // fail-closed rule and the scheduler form's "unmapped me() sends empty" warning.
        $displayVal = $applyMeToValue($val);

        log_scheduler("  Prompt '$logName' resolved to: " . ($displayVal !== null ? "'$displayVal'" : "NULL"));

        $resolvedMap[$displayName] = $displayVal;
        // Name-keyed twin of $resolvedMap: the client's prompt flow accepts a
        // URL parameter per `name=` attribute (its highest priority), so this
        // is what deep links use to pre-answer prompts. Values are the
        // POST-resolution ones (dynamic dates already concretized) - a link
        // reproduces the run it came from, not a re-resolution at click time.
        if ($name !== null && $name !== '') {
            $resolvedByName[$name] = $displayVal;
        }

        // Derive noQuote flag from parsed prompt parameters
        $noQuote = isset($params['noquote']) && $params['noquote'];

        // --- FIX START: DATE LITERAL SAFETY ---
        // If the value is a date like '01-JAN-25', we MUST quote it, even if noquote is on.
        // Otherwise, SQL Server sees JAN as a column name.
        if ($noQuote && preg_match('/^\d{1,2}-[a-zA-Z]{3}-(\d{2}|\d{4})$/', trim($val))) {
            $noQuote = false;
        }
        // --- FIX END ---

        // --- PER-OPTION TEMPLATE CHECK ---
        // If any resolved value matches an `options=Display:Value::Template` entry,
        // build the replacement using each value's per-option template (falling back
        // to the prompt-level template, then to the bare value). This bypasses the
        // smart-split / standard template paths below because per-value SQL shapes
        // may be heterogeneous (e.g. "All" -> "1=1", "None" -> "col IS NULL").
        $perOptionTemplates = penumbra_parse_per_option_templates($content);
        if (!empty($perOptionTemplates)) {
            $pTypeForLookup = isset($params['type']) ? strtolower($params['type']) : 'text';
            $valueList = ($pTypeForLookup === 'multi-select' && strpos($val, ',') !== false)
                ? array_map('trim', explode(',', $val))
                : array(trim($val));
            $anyPerOption = false;
            foreach ($valueList as $v) {
                if (array_key_exists($v, $perOptionTemplates)) { $anyPerOption = true; break; }
            }
            if ($anyPerOption) {
                $promptTpl = isset($params['template']) ? $params['template'] : null;
                $logic = (isset($params['logic']) && strtolower($params['logic']) === 'and') ? ' AND ' : ' OR ';
                $pieces = array();
                foreach ($valueList as $v) {
                    $hasPerOpt = array_key_exists($v, $perOptionTemplates);
                    $tpl = $hasPerOpt ? $perOptionTemplates[$v] : $promptTpl;
                    // For values that fall back to the prompt-level template, strip any
                    // leading AND/OR - that connector belongs outside the joined group,
                    // not on each per-value fragment (mirrors JS multi-select path).
                    if (!$hasPerOpt && $tpl !== null && $tpl !== '') {
                        $tpl = preg_replace('/^\s*(AND|OR)\s+/i', '', $tpl);
                    }
                    // noquote => raw; otherwise SQL-quoted single literal
                    $valForTemplate = $noQuote ? $v : ("'" . str_replace("'", "''", $v) . "'");
                    if ($tpl === null) {
                        $pieces[] = $valForTemplate;
                    } elseif ($tpl === '') {
                        // Empty per-option template suppresses output for this value.
                        continue;
                    } else {
                        $pieces[] = str_replace(':val', $valForTemplate, $tpl);
                    }
                }
                if (count($pieces) === 0) {
                    $replacement = '';
                } elseif (count($pieces) === 1) {
                    $replacement = $pieces[0];
                } else {
                    $replacement = '(' . implode($logic, $pieces) . ')';
                }
                $sql = substr_replace($sql, $replacement, $tagOffset, strlen($full_tag));
                continue;
            }
        }

        $opRegex = '/((?:[\w."]+\s*\.)?[\w."]+)\s+(LIKE|IN|=|!=|<>)\s*$/i';

        // --- SMART SPLIT DETECTION ---
        $shouldSplit = false;
        $opMatch = null;
        $precedingSql = substr($sql, 0, $tagOffset);

        // Only consider splitting if commas exist, quoting is on, and we can identify the SQL operator
        if (strpos($val, ',') !== false && !$noQuote && preg_match($opRegex, $precedingSql, $matches)) {
            $opMatch = $matches;
            $operator = strtoupper($opMatch[2]);
            $pType = isset($params['type']) ? strtolower($params['type']) : 'text';

            // 1. Always split for Multi-Selects
            if ($pType === 'multi-select') {
                $shouldSplit = true;
            }
            // 2. Always split for IN / NOT IN operators (standard SQL list syntax)
            else if ($operator === 'IN' || $operator === 'NOT IN') {
                $shouldSplit = true;
            }
            // 3. For TEXT inputs with simple operators (=, LIKE), DO NOT split by default.
            //    This protects "Wilson, Alyson" from becoming "Wilson" OR "Alyson".

            // 4. Respect Manual Overrides
            if (isset($params['split'])) $shouldSplit = true;
            if (isset($params['nosplit'])) $shouldSplit = false;
        }

        $replacement = '';
        if ($shouldSplit && $opMatch) {
            $colName = trim($opMatch[1]);
            $operator = strtoupper($opMatch[2]);
            $values = explode(',', $val);
            $cleanValues = array_map(function($v) { return "'" . str_replace("'", "''", trim($v)) . "'"; }, $values);

            // Expand the replacement range to include the preceding operator+column
            $tagOffset -= strlen($opMatch[0]);
            $full_tag = $opMatch[0] . $full_tag;

            if ($operator === 'IN' || $operator === 'NOT IN') {
                $replacement = "$colName $operator (" . implode(', ', $cleanValues) . ")";
            } else {
                $clauses = [];
                foreach ($cleanValues as $cv) { $clauses[] = "$colName $operator $cv"; }
                $joiner = (isset($params['logic']) && strtolower($params['logic']) === 'and') ? ' AND ' : ' OR ';
                $replacement = "(" . implode($joiner, $clauses) . ")";
            }
        } else {
            $pType = isset($params['type']) ? strtolower($params['type']) : 'text';

            // Shared TYPE gate (penumbraNoQuoteTypeIsAllowed, shared_logic.php).
            // The value check below has been here for a while, but nothing ever
            // checked the prompt's TYPE - so a hand-written `type=text;noquote`
            // tag spliced free text into the SQL on this path while the browser
            // engine refused to run the same report at all. A control prompt
            // (template="") emits no SQL, so it is exempt; a date value has
            // already had $noQuote forced off above, so it never reaches here.
            if ($noQuote && !penumbraNoQuoteTypeIsAllowed($pType)
                && !(isset($params['template']) && $params['template'] === '')) {
                throw new Exception(penumbraNoQuoteTypeError(
                    isset($params['message']) ? $params['message']
                        : (isset($params['name']) ? $params['name'] : '?'),
                    $pType));
            }

            if ($noQuote) {
                // SECURITY: a noquote value is spliced into SQL UNQUOTED, so validate it
                // before trusting it - otherwise a report author / task creator could turn
                // a scheduled prompt into SQL injection. Allowed only if it is (a) one of
                // the prompt's own defined option values (author-trusted) or (b)
                // identifier-safe characters with no SQL keyword.
                //
                // This used to be an inline copy of the browser's rule. It now calls the
                // shared helper (shared_logic.php) that ?json=1 uses too, which also fixes
                // two bugs the copy had: it split options= on ';' where the canonical
                // separator is ',' (js/main.js), so a normal comma-separated list never
                // matched and every value fell through to the safe-char check; and it
                // peeled "Display:Value" before "::Template", mangling a template-only
                // entry like "1=1::AND x=1" into ":AND x=1".
                $noQuoteVal = (string)$val;
                if (!penumbraNoQuoteValueIsAllowed($noQuoteVal, isset($params['options']) ? $params['options'] : '')) {
                    throw new Exception(penumbraNoQuoteValueError(
                        isset($params['message']) ? $params['message']
                            : (isset($params['name']) ? $params['name'] : '?')));
                }
                $replacement = $noQuoteVal;
            } else if ($pType === 'multi-select' && strpos($val, ',') !== false) {
                // Multi-select with commas but the operator regex didn't match.
                // Three cases based on what precedes the tag:
                $precedingTrimmed = rtrim(substr($sql, 0, $tagOffset));
                $charBefore = (strlen($precedingTrimmed) > 0) ? substr($precedingTrimmed, -1) : '';

                if ($charBefore === '(') {
                    // Case 1: Explicit parens in SQL - e.g. "IN ([PROMPT])"
                    // Produce bare list; parens already present.
                    $values = explode(',', $val);
                    $quoted = array_map(function($v) { return "'" . str_replace("'", "''", trim($v)) . "'"; }, $values);
                    $replacement = implode(', ', $quoted);
                } else if (preg_match('/\b(?:NOT\s+)?IN\s*$/i', $precedingTrimmed)) {
                    // Case 2: IN/NOT IN without parens - e.g. "UPPER(col) IN [PROMPT]"
                    // Produce parenthesized list.
                    $values = explode(',', $val);
                    $quoted = array_map(function($v) { return "'" . str_replace("'", "''", trim($v)) . "'"; }, $values);
                    $replacement = '(' . implode(', ', $quoted) . ')';
                } else {
                    // Case 3: Tag used as scalar value - e.g. "[PROMPT] IS NULL"
                    // Keep as single quoted string so IS NULL evaluates to FALSE.
                    $replacement = "'" . str_replace("'", "''", $val) . "'";
                }
            } else {
                // Treat as single string (preserves "Wilson, Alyson")
                $replacement = "'" . str_replace("'", "''", $val) . "'";
            }

            // --- TEMPLATE SUPPORT ---
            // If the prompt has a template param (e.g., template="= :val" or template="LIKE '%' || :val || '%'"),
            // wrap the resolved value into the template. Only applies to non-split replacements.
            // template="" means "control prompt" - output nothing to SQL (used for resultif routing).
            if (isset($params['template'])) {
                if ($params['template'] === '') {
                    $replacement = '';
                } else if ($pType === 'multi-select' && strpos($val, ',') !== false && strpos($params['template'], ':val') !== false) {
                    // FIX: Multi-select with template containing :val - apply template
                    // per value to avoid producing invalid SQL.
                    // e.g., template="AND col = :val" with 3 values would produce the
                    // broken "AND col = 'v1', 'v2', 'v3'". Instead we expand to:
                    // "AND (col = 'v1' OR col = 'v2' OR col = 'v3')"
                    $msValues = explode(',', $val);
                    $logic = (isset($params['logic']) && strtolower($params['logic']) === 'and') ? ' AND ' : ' OR ';
                    $condPart = $params['template'];
                    $sqlPrefix = '';
                    if (preg_match('/^\s*(AND|OR)\s+/i', $condPart, $cm)) {
                        $sqlPrefix = $cm[0];
                        $condPart = substr($condPart, strlen($cm[0]));
                    }
                    $perValue = array();
                    foreach ($msValues as $mv) {
                        $quotedV = "'" . str_replace("'", "''", trim($mv)) . "'";
                        $perValue[] = str_replace(':val', $quotedV, $condPart);
                    }
                    if (count($perValue) === 1) {
                        $replacement = str_replace(':val', $replacement, $params['template']);
                    } else {
                        $replacement = $sqlPrefix . '(' . implode($logic, $perValue) . ')';
                    }
                } else {
                    $replacement = str_replace(':val', $replacement, $params['template']);
                }
            }
        }

        $sql = substr_replace($sql, $replacement, $tagOffset, strlen($full_tag));
    }
    // The backward loop populates $resolvedMap in reverse insertion order;
    // flip it back so parameters display in their original SQL order.
    $resolvedMap = array_reverse($resolvedMap, true);
    return $sql;
}

function render_json_as_html($data) {
    if (is_string($data)) {
        $decoded = json_decode($data, true);
        if (json_last_error() === JSON_ERROR_NONE) $data = $decoded;
    }
    if (!is_array($data) && !is_object($data)) return htmlspecialchars((string)$data);
    
    // Workaround using display:table for email clients
    $html = '<div style="display: table; width: 100%; border-collapse: collapse; font-size: 10px; border: 1px solid #eee; background: #fff;">';
    foreach ($data as $k => $v) {
        $html .= '<div style="display: table-row; border-bottom: 1px solid #eee;">';
        $html .= '<div style="display: table-cell; padding: 4px; font-weight: bold; background: #fafafa; width: 30%; border-right: 1px solid #eee; vertical-align: top; color: #555;">' . htmlspecialchars($k) . '</div>';
        $html .= '<div style="display: table-cell; padding: 4px;">';
        if (is_array($v) || is_object($v)) {
            $html .= render_json_as_html($v);
        } else {
            $html .= htmlspecialchars((string)$v);
        }
        $html .= '</div></div>';
    }
    $html .= '</div>';
    return $html;
}

function repair_truncated_json($str) {
    if (!$str || strlen($str) < 5) return null;
    $s = trim($str);
    $maxChop = min(200, strlen($s));
    $closers = array('"}]', '"}', '"}}}', '"}}', '"}}}}}', '}]', '}', '}}', '}}}', '"]', '"]}', '"]}}');
    for ($chopLen = 0; $chopLen < $maxChop; $chopLen++) {
        $candidate = substr($s, 0, strlen($s) - $chopLen);
        foreach ($closers as $closer) {
            $attempt = $candidate . $closer;
            $parsed = json_decode($attempt, true);
            if (json_last_error() === JSON_ERROR_NONE && is_array($parsed) && !empty($parsed)) {
                return $parsed;
            }
        }
    }
    return null;
}

function _sanitize_email_html_cell($html) {
    $html = (string)$html;

    // 1. Remove script-capable / abusable elements INCLUDING their contents.
    $html = preg_replace('#<script\b[^>]*>.*?</script>#is', '', $html);
    $html = preg_replace('#<style\b[^>]*>.*?</style>#is', '', $html);
    $html = preg_replace('#<(iframe|object|embed|applet|form|svg|math|noscript|template|frame|frameset)\b[^>]*>.*?</\1>#is', '', $html);
    // ...and any orphaned / self-closing forms of those, plus other risky tags.
    $html = preg_replace('#<(script|style|iframe|object|embed|applet|form|svg|math|noscript|template|frame|frameset|link|meta|base|input|button|textarea|select|option)\b[^>]*/?>#is', '', $html);

    // 2. Allowlist the tags rich email formatting needs (strip_tags keeps the inner text of the rest).
    $allowed = '<a><b><strong><i><em><u><s><span><div><p><br><hr>'
             . '<table><thead><tbody><tfoot><tr><td><th><caption><colgroup><col>'
             . '<ul><ol><li><dl><dt><dd><h1><h2><h3><h4><h5><h6>'
             . '<img><code><pre><blockquote><font><small><sub><sup>';
    $html = strip_tags($html, $allowed);

    // 3. Drop inline event-handler attributes (onerror=, onload=, onclick=, ...) - quoted + unquoted.
    $html = preg_replace('/\son[a-z]+\s*=\s*"[^"]*"/i', '', $html);
    $html = preg_replace("/\son[a-z]+\s*=\s*'[^']*'/i", '', $html);
    $html = preg_replace('/\son[a-z]+\s*=\s*[^\s>]+/i', '', $html);

    // 4. Neutralize dangerous URI schemes at the START of an attribute value
    //    (javascript:, vbscript:, data:text/html). Mid-value occurrences of the word are left alone.
    $html = preg_replace('/(=\s*["\']?\s*)(?:javascript|vbscript)\s*:/i', '$1#', $html);
    $html = preg_replace('/(=\s*["\']?\s*)data\s*:\s*text\/html/i', '$1#', $html);

    return $html;
}

function formatCellContent($value) {
    global $strip_links;
    if ($value === null) return "";
    // A raw array cell would stringify to the literal "Array"; route it through the
    // JSON renderer instead (which yields '' for an empty array).
    if (is_array($value)) return render_json_table_php($value);
    $content_str = (string)$value;

    // 1. HTML Handling
    $html_prefix = '@@HTML';
    if (strpos($content_str, $html_prefix) === 0) {
        $raw_html = substr($content_str, strlen($html_prefix));
        // Sanitize: allowlist safe tags + drop inline event handlers and script: URIs.
        // Emails are semi-trusted (report data + author-defined rewrite rules), but a
        // report author could otherwise smuggle <img onerror>, <iframe>, javascript:
        // links, etc. into a scheduled email. (Previously only <script> was stripped.)
        $raw_html = _sanitize_email_html_cell($raw_html);
        // Always strip interactive href="#" links (data-search, data-prompt, data-replace).
        // These are non-functional in emails - they only work in the browser UI.
        $raw_html = preg_replace('/<a\b[^>]*href=["\']\s*#\s*["\'][^>]*>(.*?)<\/a>/is', '$1', $raw_html);
        // If strip_links option is on, strip ALL remaining <a> tags (including resolver links)
        if ($strip_links) {
            $raw_html = preg_replace('/<a\b[^>]*>(.*?)<\/a>/is', '$1', $raw_html);
        }
        return $raw_html;
    }

    // 2. JSON Handling (Triggers the new renderer)
    $json_prefix = '@@JSON';
    if (strpos($content_str, $json_prefix) === 0) {
        $json_str = substr($content_str, strlen($json_prefix));
        $data = json_decode($json_str, true);
        if (json_last_error() === JSON_ERROR_NONE) {
            return render_json_table_php($data);
        }
        // JSON parse failed - likely truncated at 4000 bytes by TO_CHAR(SUBSTR).
        // Attempt to repair by extracting complete key-value pairs.
        $repaired = repair_truncated_json($json_str);
        if ($repaired !== null) {
            $html = render_json_table_php($repaired);
            $html .= '<div style="font-size:10px;color:#999;margin-top:2px;font-style:italic;">Showing partial data (truncated)</div>';
            return $html;
        }
        // Final fallback: show raw text cleanly instead of error
        return '<div style="max-width:400px;font-size:10px;color:#555;white-space:pre-wrap;word-break:break-all;font-family:monospace;">'
             . htmlspecialchars($json_str) . '</div>';
    }

    // 3. Default
    // Decode first to prevent double-encoding (fixes &amp; appearing as &amp;amp;)
    return htmlspecialchars(html_entity_decode($content_str, ENT_QUOTES));
}

function formatCellContentPdf($value) {
    if ($value === null) return "";
    // A raw array cell (e.g. an already-decoded JSON column) would stringify to the
    // literal "Array"; route it through the JSON renderer instead (empty array -> '').
    if (is_array($value)) return _renderJsonForPdf($value);
    $content_str = (string)$value;

    // 1. @@HTML - render nested tables if present, otherwise strip to text
    $html_prefix = '@@HTML';
    if (strpos($content_str, $html_prefix) === 0) {
        $raw_html = substr($content_str, strlen($html_prefix));

        // If HTML contains a <table>, preserve it for TCPDF nested table rendering
        if (stripos($raw_html, '<table') !== false) {
            return _renderHtmlTableForPdf($raw_html);
        }

        // No table - strip all tags, keep plain text
        $plain = strip_tags($raw_html);
        return htmlspecialchars(trim($plain), ENT_QUOTES, 'UTF-8');
    }

    // 2. @@JSON - render as TCPDF-compatible nested subtable
    $json_prefix = '@@JSON';
    if (strpos($content_str, $json_prefix) === 0) {
        $json_str = substr($content_str, strlen($json_prefix));
        $data = json_decode($json_str, true);
        if (json_last_error() === JSON_ERROR_NONE) {
            return _renderJsonForPdf($data);
        }
        // Attempt repair of truncated JSON
        $repaired = repair_truncated_json($json_str);
        if ($repaired !== null) {
            return _renderJsonForPdf($repaired);
        }
        return htmlspecialchars(substr($json_str, 0, 200) . '...', ENT_QUOTES, 'UTF-8');
    }

    // 3. Default - plain text
    return htmlspecialchars(html_entity_decode($content_str, ENT_QUOTES), ENT_QUOTES, 'UTF-8');
}

function _renderJsonForPdf($data) {
    // Helper: strip nested @@HTML prefix and HTML tags, then htmlspecialchars
    $cleanScalar = function($v) {
        $s = (string)$v;
        if (strpos($s, '@@HTML') === 0) $s = strip_tags(substr($s, 6));
        return htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
    };

    // Simple array of scalars: join as comma-separated text
    if (is_array($data) && !empty($data) && isset($data[0]) && !is_array($data[0])) {
        $parts = array();
        foreach ($data as $v) {
            $parts[] = $cleanScalar($v);
        }
        return implode(', ', $parts);
    }

    // Array of objects: render as data grid subtable
    if (is_array($data) && !empty($data) && isset($data[0]) && is_array($data[0])) {
        $keys = array_keys($data[0]);
        $numCols = count($keys);
        // Use a compact nested table style with thin borders
        $html = '<table style="font-size:85%;border-collapse:collapse;width:100%;">';
        // Header row
        $html .= '<tr>';
        foreach ($keys as $k) {
            $html .= '<td style="font-weight:bold;padding:1px 3px;border:1px solid #999999;" bgcolor="#E8E8E8">'
                   . htmlspecialchars($k, ENT_QUOTES, 'UTF-8') . '</td>';
        }
        $html .= '</tr>';
        // Data rows
        foreach ($data as $rowIdx => $row) {
            $rowBg = ($rowIdx % 2 === 0) ? '#FFFFFF' : '#F5F5F5';
            $html .= '<tr>';
            foreach ($keys as $k) {
                $val = isset($row[$k]) ? $row[$k] : '';
                if (is_array($val)) {
                    // Recursively render nested arrays/objects
                    $cellContent = _renderJsonForPdf($val);
                } else {
                    $cellContent = $cleanScalar($val);
                }
                $html .= '<td style="padding:1px 3px;border:1px solid #CCCCCC;" bgcolor="' . $rowBg . '">'
                       . $cellContent . '</td>';
            }
            $html .= '</tr>';
        }
        $html .= '</table>';
        return $html;
    }

    // Key-value object: render as two-column table
    if (is_array($data) && !empty($data)) {
        $html = '<table style="font-size:85%;border-collapse:collapse;width:100%;">';
        foreach ($data as $k => $v) {
            if (is_array($v)) {
                $valHtml = _renderJsonForPdf($v);
            } else {
                $valHtml = $cleanScalar($v);
            }
            $html .= '<tr>';
            $html .= '<td style="font-weight:bold;padding:1px 3px;border:1px solid #999999;width:30%;" bgcolor="#E8E8E8">'
                   . htmlspecialchars((string)$k, ENT_QUOTES, 'UTF-8') . '</td>';
            $html .= '<td style="padding:1px 3px;border:1px solid #CCCCCC;">' . $valHtml . '</td>';
            $html .= '</tr>';
        }
        $html .= '</table>';
        return $html;
    }

    // Scalar fallback. An empty array reaches here (the is_array && !empty branch
    // above skips it); on PHP 8 casting it to string emits "Array to string
    // conversion" and renders the literal "Array", so treat an empty array as empty.
    if (is_array($data)) {
        return '';
    }
    $s = (string)$data;
    if (strpos($s, '@@HTML') === 0) $s = strip_tags(substr($s, 6));
    return htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
}

function _renderHtmlTableForPdf($html) {
    // Strip script/style tags entirely
    $html = preg_replace('/<script\b[^>]*>.*?<\/script>/si', '', $html);
    $html = preg_replace('/<style\b[^>]*>.*?<\/style>/si', '', $html);

    // Allow only safe HTML tags (table structure + basic formatting)
    $html = strip_tags($html, '<table><tr><td><th><thead><tbody><tfoot><br><b><strong><i><em><span><div><p>');

    // Add compact base style to <table> tags that lack a style attribute
    $html = preg_replace('/<table(?![^>]*style\s*=)/i',
        '<table style="font-size:85%;border-collapse:collapse;width:100%;"', $html);

    // Add border/padding to <td> and <th> that lack a style attribute
    $html = preg_replace_callback('/<(td|th)(\s[^>]*)?(>)/i', function($m) {
        $tag  = strtolower($m[1]);
        $rest = isset($m[2]) ? $m[2] : '';
        $close = $m[3];
        // Skip if already has inline style
        if (stripos($rest, 'style=') !== false) return $m[0];
        if ($tag === 'th') {
            return '<th style="font-weight:bold;padding:1px 3px;border:1px solid #999999;" bgcolor="#E8E8E8"' . $rest . $close;
        }
        return '<td style="padding:1px 3px;border:1px solid #CCCCCC;"' . $rest . $close;
    }, $html);

    return $html;
}

function render_json_table_php($data) {
    global $total_exemptions;    // Access config whitelist
    global $current_email_theme; // Access active theme set in main loop

    // 1. Theme Colors for nested-JSON tables -- derived from the registry in
    //    themes_config.php (the 'nestedHeader' field). Verified value-identical
    //    to the former inline literal.
    $theme_map = penumbra_build_theme_map();

    // Select active theme or fallback
    $t = isset($current_email_theme) && isset($theme_map[$current_email_theme]) 
         ? $theme_map[$current_email_theme] 
         : $theme_map['theme-default'];

    // --- CASE 1: Array of Objects (Data Grid) ---
    if (is_array($data) && count($data) > 0 && isset($data[0]) && is_array($data[0])) {
        // __PNBDIFF is a sub-row diff marker (comparison emails, see
        // penumbra_annotate_json_subdiff) - consumed as a row tint below,
        // never rendered as a column.
        $keys = array();
        foreach (array_keys($data[0]) as $jk) { if ($jk !== '__PNBDIFF') $keys[] = $jk; }
        $stats = [];

        // Initialize Stats
        foreach ($keys as $key) {
            $upperKey = strtoupper($key);
            $isWhitelisted = false;
            
            // Check whitelist
            if (isset($total_exemptions) && is_array($total_exemptions)) {
                foreach ($total_exemptions as $term) {
                    if (strpos($upperKey, strtoupper($term)) !== false) {
                        $isWhitelisted = true; 
                        break;
                    }
                }
            }
            
            $stats[$key] = array(
                'sum' => 0,
                'hasNumber' => false,
                'isInvalid' => false,
                'isCurrency' => false,
                'isWhitelisted' => $isWhitelisted,
                'hasCommas' => false,
                'maxDecimals' => 0
            );
        }

        $rows_html = '';

        // Sub-row diff marks (comparison emails): tint + glyph per marked row.
        // Self-contained fg/bg pairs so they read on ANY theme, applied to each
        // CELL because many email clients ignore row-level backgrounds. The
        // glyph doubles as the non-color cue (color alone can't carry meaning).
        $diffRowStyles = array(
            'added'   => ' background-color:#e8f5e9; color:#1b5e20;',
            'removed' => ' background-color:#fdecea; color:#b71c1c;',
            'changed' => ' background-color:#fff8e1; color:#7a5c00;'
        );
        $diffRowGlyphs = array('added' => '+ ', 'removed' => '&#8722; ', 'changed' => '&#177; ');

        // Build Data Rows
        foreach ($data as $row) {
            $rowDiff = (isset($row['__PNBDIFF']) && isset($diffRowStyles[$row['__PNBDIFF']])) ? $row['__PNBDIFF'] : '';
            $cellIdx = 0;
            $rows_html .= '<div class="nested-json-row" style="display:table-row;">';
            foreach ($keys as $key) {
                $val = isset($row[$key]) ? $row[$key] : '';
                $cellContent = '';

                if (is_array($val)) {
                    $cellContent = render_json_table_php($val);
                    $stats[$key]['isInvalid'] = true; 
                } elseif (strpos((string)$val, '@@HTML') === 0) {
                    // Nested @@HTML - render as HTML (strip scripts/unsafe tags)
                    $htmlContent = substr((string)$val, 6);
                    // Sanitize (allowlist tags + drop handlers/script: URIs), then strip the
                    // browser-only href="#" links (data-search etc.) down to their text.
                    $htmlContent = _sanitize_email_html_cell($htmlContent);
                    $cellContent = preg_replace('/<a\b[^>]*href=["\']\s*#\s*["\'][^>]*>(.*?)<\/a>/is', '$1', $htmlContent);
                    $stats[$key]['isInvalid'] = true;
                } else {
                    $cellContent = htmlspecialchars((string)$val);

                    // Totals Logic
                    if (!$stats[$key]['isInvalid']) {
                        if ($val !== null && trim((string)$val) !== '') {
                            $strVal = (string)$val;
                            if (strpos($strVal, '$') !== false) {
                                $stats[$key]['isCurrency'] = true;
                            }
                            if (strpos($strVal, ',') !== false) {
                                $stats[$key]['hasCommas'] = true;
                            }
                            if (strpos($strVal, '.') !== false) {
                                $dotParts = explode('.', str_replace(array('$', ',', '(', ')'), '', $strVal));
                                if (count($dotParts) === 2) {
                                    $decLen = strlen(preg_replace('/[^0-9]/', '', $dotParts[1]));
                                    if ($decLen > $stats[$key]['maxDecimals']) {
                                        $stats[$key]['maxDecimals'] = $decLen;
                                    }
                                }
                            }

                            $numVal = parse_accounting_number($strVal);

                            // Check if valid number (parse_accounting_number returns false on failure)
                            if ($numVal !== false) {
                                $stats[$key]['sum'] += $numVal;
                                $stats[$key]['hasNumber'] = true;
                            } else {
                                $stats[$key]['isInvalid'] = true;
                            }
                        }
                    }
                }
                
                // Row Styling (+ sub-row diff tint/glyph when this row is marked)
                $borderColor = ($current_email_theme === 'theme-wolfpack-dark' || $current_email_theme === 'theme-charcoal-gold') ? '#444' : '#ddd';
                $diffStyle = $rowDiff !== '' ? $diffRowStyles[$rowDiff] : '';
                $diffGlyph = ($rowDiff !== '' && $cellIdx === 0) ? '<b>' . $diffRowGlyphs[$rowDiff] . '</b>' : '';
                $rows_html .= '<div class="nested-json-cell" style="display:table-cell; border:1px solid '.$borderColor.'; padding:4px 8px; vertical-align:top;'.$diffStyle.'">' . $diffGlyph . $cellContent . '</div>';
                $cellIdx++;
            }
            $rows_html .= '</div>';
        }

        // Build Header (Dynamic Colors)
        $header_html = '<div class="nested-json-header" style="display:table-row;">';
        foreach ($keys as $key) {
            $header_html .= '<div class="nested-json-cell" style="display:table-cell; border:1px solid #ddd; padding:4px 8px; background-color:'.$t['header_bg'].'; color:'.$t['header_text'].'; font-weight:bold; border-bottom:2px solid #ccc;">' . htmlspecialchars($key) . '</div>';
        }
        $header_html .= '</div>';

        // Build Totals Row
        $total_html = '';
        $hasAnyTotal = false;
        
        foreach ($keys as $key) {
            if (!$stats[$key]['isInvalid'] && $stats[$key]['hasNumber'] && ($stats[$key]['isCurrency'] || $stats[$key]['isWhitelisted'])) {
                $hasAnyTotal = true;
                break;
            }
        }

        if ($hasAnyTotal) {
            $total_html .= '<div class="nested-json-row nested-total-row" style="display:table-row;">';
            $idx = 0;
            foreach ($keys as $key) {
                $s = $stats[$key];
                $show = (!$s['isInvalid'] && $s['hasNumber'] && ($s['isCurrency'] || $s['isWhitelisted']));
                
                // Footer Styles
                $cellStyle = "display:table-cell; padding:4px 8px; vertical-align:top; font-weight:bold; ";
                $cellStyle .= "background-color:{$t['bg']}; color:{$t['text']}; border-top:2px solid {$t['border_top']}; border-bottom:1px solid #ddd; border-right:1px solid #ddd; border-left:1px solid #ddd;";

                if ($idx === 0) {
                    $total_html .= '<div class="nested-json-cell" style="' . $cellStyle . '">TOTAL</div>';
                } elseif ($show) {
                    $prefix = $s['isCurrency'] ? '$' : '';
                    $decimals = $s['maxDecimals'];
                    if ($s['hasCommas']) {
                        $fmt = number_format($s['sum'], $decimals);
                    } else {
                        $fmt = ($decimals > 0) ? number_format($s['sum'], $decimals, '.', '') : (string)(int)round($s['sum']);
                    }
                    $total_html .= '<div class="nested-json-cell" style="' . $cellStyle . '">' . $prefix . $fmt . '</div>';
                } else {
                    $total_html .= '<div class="nested-json-cell" style="' . $cellStyle . '"></div>';
                }
                $idx++;
            }
            $total_html .= '</div>';
        }

        return '<div class="nested-json-container data-grid-table" style="display:table; width:100%; border-collapse:collapse; margin:0;">' . $header_html . $rows_html . $total_html . '</div>';
    }

    // --- CASE 2: Key-Value Object / Simple Array ---
    else if (is_array($data)) {
        $is_list = isset($data[0]) || empty($data);
        
        if ($is_list) {
             return htmlspecialchars(implode(', ', $data));
        } else {
            // Key/Value Styles
            $keyBg = $t['header_bg']; // Use header bg for keys
            $keyText = $t['header_text'];

            $html = '<div class="nested-json-container key-value-table" style="display:table; width:100%; border-collapse:collapse; margin:0;">';
            foreach ($data as $k => $v) {
                $valHtml = is_array($v) ? render_json_table_php($v) : htmlspecialchars((string)$v);
                $html .= '<div class="nested-json-row" style="display:table-row;">';
                $html .= '<div class="nested-json-cell key" style="display:table-cell; border:1px solid #ddd; padding:4px 8px; font-weight:bold; width:30%; background-color:'.$keyBg.'; color:'.$keyText.';">' . htmlspecialchars($k) . '</div>';
                $html .= '<div class="nested-json-cell value" style="display:table-cell; border:1px solid #ddd; padding:4px 8px;">' . $valHtml . '</div>';
                $html .= '</div>';
            }
            $html .= '</div>';
            return $html;
        }
    }

    // --- CASE 3: Simple String/Number ---
    return htmlspecialchars((string)$data);
}

function penumbra_custom_sort_entry($customSortOrders, $columnName) {
    if (empty($customSortOrders) || !is_array($customSortOrders)) return null;
    if ($columnName === null || $columnName === '') return null;
    $key = (string)$columnName;
    if (isset($customSortOrders[$key])) return $customSortOrders[$key];
    $want = strtoupper($key);
    foreach ($customSortOrders as $k => $entry) {
        if (strtoupper((string)$k) === $want) return $entry;
    }
    return null;
}

function get_custom_sort_comparator($customSortOrders, $columnName) {
    $entry = penumbra_custom_sort_entry($customSortOrders, $columnName);
    if (!$entry || !isset($entry['values']) || !is_array($entry['values']) || count($entry['values']) === 0) return null;
    $values = array_values($entry['values']);
    $orderMap = array();
    foreach ($values as $i => $v) {
        $k = strtolower(trim((string)$v));   // (string) cast: trim(null) is deprecated in PHP 8.1+
        // First occurrence wins, so a duplicate entry can't relocate the value.
        if (!isset($orderMap[$k])) $orderMap[$k] = $i;
    }
    $maxIndex = count($values);
    return function($a, $b) use ($orderMap, $maxIndex) {
        $aLower = strtolower(trim((string)$a));
        $bLower = strtolower(trim((string)$b));
        $aIdx = isset($orderMap[$aLower]) ? $orderMap[$aLower] : $maxIndex;
        $bIdx = isset($orderMap[$bLower]) ? $orderMap[$bLower] : $maxIndex;
        if ($aIdx !== $bIdx) return ($aIdx < $bIdx) ? -1 : 1;
        if ($aIdx === $maxIndex) return strnatcasecmp($a, $b);
        return 0;
    };
}

function pivot_split_registry() {
    static $reg = array(
        'year'     => array('kind' => 'period', 'label' => 'Year',                  'minGran' => 0),
        'fy'       => array('kind' => 'period', 'label' => 'Fiscal Year',           'minGran' => 1),
        'yq'       => array('kind' => 'period', 'label' => 'Year › Quarter',        'minGran' => 1),
        'fyq'      => array('kind' => 'period', 'label' => 'Fiscal Year › Quarter', 'minGran' => 1),
        'ym'       => array('kind' => 'period', 'label' => 'Year › Month',          'minGran' => 1),
        'quarter'  => array('kind' => 'cycle',  'label' => 'Quarter',               'minGran' => 1),
        'fquarter' => array('kind' => 'cycle',  'label' => 'Fiscal Quarter',        'minGran' => 1),
        'month'    => array('kind' => 'cycle',  'label' => 'Month',                 'minGran' => 1),
        'monthnum' => array('kind' => 'cycle',  'label' => 'Month #',               'minGran' => 1),
        'dow'      => array('kind' => 'cycle',  'label' => 'Day of Week',           'minGran' => 2),
        'hour'     => array('kind' => 'cycle',  'label' => 'Hour',                  'minGran' => 0),
        // Numeric binning (2026-08-26): 'bin' takes an optional width (:bin50000);
        // no width means auto (~10 nice buckets, resolved per data set).
        'bin'      => array('kind' => 'bin',    'label' => 'Bins',                  'minGran' => -1),
        'binlog'   => array('kind' => 'bin',    'label' => 'Order of Magnitude',    'minGran' => -1),
        // Custom-edge bins (2026-08-27): the bucket list rides in the token
        // (:bins100000_250000), so labels are compact and edge-relative.
        'bins'     => array('kind' => 'bin',    'label' => 'Custom Ranges',         'minGran' => -1),
    );
    return $reg;
}

function pivot_max_bin_edges() { return 40; }

function pivot_period_per_year($split) {
    switch ($split) {
        case 'year': case 'fy':  return 1;
        case 'yq':   case 'fyq': return 4;
        case 'ym':               return 12;
    }
    return 0;   // cycles (quarter/month/dow/hour) and bins carry no year
}

function pivot_period_year_of($split, $label) {
    $s = (string)$label;
    switch ($split) {
        case 'year': return preg_match('/^(\d{4})$/', $s, $m) ? (int)$m[1] : null;
        case 'fy':   return preg_match('/^FY(\d{2})$/i', $s, $m) ? 2000 + (int)$m[1] : null;
        case 'yq':   return preg_match('/^(\d{4}) Q[1-4]$/', $s, $m) ? (int)$m[1] : null;
        case 'fyq':  return preg_match('/^FY(\d{2}) Q[1-4]$/i', $s, $m) ? 2000 + (int)$m[1] : null;
        case 'ym':   return preg_match('/^[A-Za-z]{3} (\d{4})$/', $s, $m) ? (int)$m[1] : null;
    }
    return null;
}

function pivot_period_info($fields) {
    if (!is_array($fields) || !count($fields)) return null;
    $vals = array_values($fields);
    for ($i = count($vals) - 1; $i >= 0; $i--) {
        $spec = pivot_parse_field_token($vals[$i]);
        $sp = isset($spec['split']) && $spec['split'] !== null ? $spec['split'] : '';
        if ($sp !== '' && pivot_period_per_year($sp) > 0) {
            return array('idx' => $i, 'split' => $sp, 'perYear' => pivot_period_per_year($sp));
        }
    }
    return array('idx' => count($vals) - 1, 'split' => '', 'perYear' => 0);
}

function pivot_key_year($key, $info) {
    if (!$info) return null;
    $parts = explode('|||', (string)$key);
    $idx = $info['idx'];
    $seg = isset($parts[$idx]) ? $parts[$idx] : $parts[count($parts) - 1];
    if ($info['split'] !== '') {
        $y = pivot_period_year_of($info['split'], $seg);
        if ($y !== null) return $y;
    }
    return preg_match('/(?:^|[^0-9])((?:19|20)[0-9]{2})(?:[^0-9]|$)/', $seg, $m) ? (int)$m[1] : null;
}

function pivot_is_ytd($t) { return $t === 'ytd' || $t === 'ytd:down'; }

function pivot_is_running_total_like($t) {
    return $t === 'running_total' || $t === 'running_total:down' || pivot_is_ytd($t);
}

function pivot_is_run_total_down($t) { return $t === 'running_total:down' || $t === 'ytd:down'; }

function pivot_is_running_down($t) {
    return $t === 'running_total:down' || $t === 'running_count:down' || $t === 'ytd:down';
}

function pivot_ytd_reset($aggType, $prevKey, $curKey, $info) {
    if (!pivot_is_ytd($aggType)) return false;
    if ($prevKey === null) return true;
    $a = pivot_key_year($prevKey, $info);
    $b = pivot_key_year($curKey, $info);
    if ($a === null || $b === null) return false;
    return $a !== $b;
}

function pivot_ytd_axis_usable($keys, $info) {
    if (!$info) return false;
    foreach ((array)$keys as $k) { if (pivot_key_year($k, $info) !== null) return true; }
    return false;
}

function pivot_is_yoy($t) { return $t === 'yoy' || $t === 'yoy:down'; }

function pivot_roll_spec($aggType) {
    if (preg_match('/^roll(sum)?([2-9]|[1-9][0-9])(?::down)?$/', (string)$aggType, $m)) {
        return array('n' => (int)$m[2], 'sum' => ($m[1] !== ''));
    }
    return null;
}

function pivot_roll_n($aggType) { $s = pivot_roll_spec($aggType); return $s ? $s['n'] : null; }

function pivot_is_roll($t) { return pivot_roll_spec($t) !== null; }

function pivot_is_roll_sum($t) { $s = pivot_roll_spec($t); return $s ? $s['sum'] : false; }

function pivot_is_prior_year($t) { return $t === 'prioryear' || $t === 'prioryear:down'; }

function pivot_index_base_label($aggType) {
    if (preg_match('/^index(?::down)?@(.+)$/i', (string)$aggType, $m)) {
        return trim($m[1]);
    }
    return null;
}

function pivot_is_index_agg($t) {
    $s = (string)$t;
    return $s === 'index' || $s === 'index:down' || pivot_index_base_label($s) !== null;
}

function pivot_is_index_down($t) {
    return (bool)preg_match('/^index:down(?:@|$)/i', (string)$t);
}

function pivot_resolve_baseline_key($keys, $label, $info) {
    if ($label === null || $label === '') return null;
    $want = strtoupper(trim((string)$label));
    foreach ((array)$keys as $k) {
        if (strtoupper((string)$k) === $want) return $k;
    }
    if ($info) {
        foreach ((array)$keys as $k) {
            $parts = explode('|||', (string)$k);
            $idx = $info['idx'];
            $seg = isset($parts[$idx]) ? $parts[$idx] : $parts[count($parts) - 1];
            if (strtoupper(trim($seg)) === $want) return $k;
        }
    }
    foreach ((array)$keys as $k) {
        $parts = explode('|||', (string)$k);
        if (strtoupper(trim($parts[count($parts) - 1])) === $want) return $k;
    }
    return null;
}

function pivot_inherits_base_units($t) {
    return $t === 'running_total' || $t === 'running_total:down'
        || $t === 'diff' || $t === 'diff:down'
        || pivot_is_ytd($t) || pivot_is_roll($t) || pivot_is_prior_year($t);
}

function pivot_zero_is_meaningful($t) {
    if (in_array($t, array('min','max','diff','diff:down','pct_change','pct_change:down',
        'pct_row_total','pct_col_total','pct_grand_total','pct_parent_row','pct_parent_col',
        'pct_cum','pct_cum:down','running_total','running_total:down',
        'running_count','running_count:down'), true)) return true;
    return pivot_is_index_agg($t) || pivot_is_ytd($t) || pivot_is_yoy($t)
        || pivot_is_roll($t) || pivot_is_prior_year($t);
}

function pivot_is_count_like($t) {
    return $t === 'count' || $t === 'distinct' || $t === 'count_filled'
        || $t === 'count_blank' || $t === 'running_count' || $t === 'running_count:down';
}

function pivot_unit_base($aggTypes, $idx) {
    $t = isset($aggTypes[$idx]) ? $aggTypes[$idx] : null;
    return ($t !== null && pivot_inherits_base_units($t))
        ? pivot_find_base_agg_type($aggTypes, $idx) : null;
}

function pivot_total_slot_scalar($slot, $baseAggType) {
    if ($slot === null) return null;
    if (is_numeric($slot)) return (abs($slot) < 1e308) ? (float)$slot : null;
    if (is_array($slot)) {
        if ($baseAggType === 'distinct') return count($slot);
        if (pivot_is_wavg_agg($baseAggType)) {
            return !empty($slot['w']) ? pivot_wavg_of($slot) : null;
        }
        if (pivot_is_pctile_agg($baseAggType)) {
            return count($slot) ? pivot_percentile_of($slot, pivot_percentile_p($baseAggType)) : null;
        }
        if ($baseAggType === 'stddev') {
            return (count($slot) >= 2) ? pivot_sample_stddev($slot) : null;
        }
        if ($baseAggType === 'range') {
            return (isset($slot['min']) && $slot['min'] < 1e308) ? ($slot['max'] - $slot['min']) : null;
        }
    }
    return null;   // mode / antimode are string-valued: no ratio to take
}

function pivot_is_roll_down($t) {
    return pivot_is_roll($t) && substr((string)$t, -5) === ':down';
}

function pivot_roll_mean($win, $n, $isSum = false) {
    if (!is_array($win) || count($win) < $n) return null;
    $s = 0.0;
    $vals = array_slice($win, count($win) - $n);
    foreach ($vals as $v) {
        if (!is_numeric($v) || abs($v) >= 1e308) return null;
        $s += (float)$v;
    }
    return $isSum ? $s : ($s / $n);
}

function pivot_period_key_of($split, $label) {
    $s = (string)$label;
    switch ($split) {
        case 'year': return preg_match('/^\d{4}$/', $s) ? '' : null;
        case 'fy':   return preg_match('/^FY\d{2}$/i', $s) ? '' : null;
        case 'yq':   return preg_match('/^\d{4} (Q[1-4])$/', $s, $m) ? $m[1] : null;
        case 'fyq':  return preg_match('/^FY\d{2} (Q[1-4])$/i', $s, $m) ? strtoupper($m[1]) : null;
        case 'ym':   return preg_match('/^([A-Za-z]{3}) \d{4}$/', $s, $m) ? $m[1] : null;
    }
    return null;
}

function pivot_period_key($key, $info) {
    if (!$info) return null;
    $parts = explode('|||', (string)$key);
    $idx = $info['idx'];
    $seg = isset($parts[$idx]) ? $parts[$idx] : $parts[count($parts) - 1];
    if ($info['split'] !== '') return pivot_period_key_of($info['split'], $seg);
    $y = pivot_key_year($seg, $info);
    if ($y === null) return null;
    return trim(str_replace((string)$y, "\x01", $seg));
}

function pivot_yoy_slot($key, $info, $year, $periodKey) {
    $parts = explode('|||', (string)$key);
    $parts[$info['idx']] = "\x02";
    return implode('|||', $parts) . "\x03" . $year . "\x03" . $periodKey;
}

function pivot_yoy_index($keys, $info) {
    $map = array();
    if (!$info) return $map;
    foreach ((array)$keys as $k) {
        $y = pivot_key_year($k, $info);
        $pk = pivot_period_key($k, $info);
        if ($y === null || $pk === null) continue;
        $map[pivot_yoy_slot($k, $info, $y, $pk)] = $k;
    }
    return $map;
}

function pivot_yoy_prev_key($key, $info, $index) {
    if (!$info || !is_array($index)) return null;
    $y = pivot_key_year($key, $info);
    $pk = pivot_period_key($key, $info);
    if ($y === null || $pk === null) return null;
    $slot = pivot_yoy_slot($key, $info, $y - 1, $pk);
    return isset($index[$slot]) ? $index[$slot] : null;
}

function pivot_compact_num($n) {
    static $U = array(array(1000000000, 'B'), array(1000000, 'M'), array(1000, 'K'));
    foreach ($U as $u) {
        if (abs($n) >= $u[0]) {
            $v = $n / $u[0];
            if ($v == floor($v)) return ((string)(int)$v) . $u[1];
            if (round($v * 10) / 10 == $v) return rtrim(rtrim(number_format($v, 1, '.', ''), '0'), '.') . $u[1];
            break;   // 1,234,567 is not cleanly "1.2M" - print it in full
        }
    }
    return number_format(round($n));
}

function pivot_compact_parse($s) {
    if (!preg_match('/^\$?\s*(-?[\d,]*\.?\d+)\s*([KMB])?$/i', trim((string)$s), $m)) return null;
    $n = (float)str_replace(',', '', $m[1]);
    $u = strtoupper(isset($m[2]) ? $m[2] : '');
    if ($u === 'K') $n *= 1000; else if ($u === 'M') $n *= 1000000; else if ($u === 'B') $n *= 1000000000;
    return $n;
}

function pivot_normalize_bin_edges($list) {
    if (!is_array($list) || !count($list)) return null;
    $out = array();
    foreach ($list as $v) {
        $n = is_numeric($v) ? (float)$v : (float)str_replace(',', '', (string)$v);
        if (!is_numeric($v) && !preg_match('/^-?[\d,]+(\.\d+)?$/', trim((string)$v))) return null;
        if (!is_finite($n) || $n < 0) return null;
        $n = (int)round($n);
        if (!in_array($n, $out, true)) $out[] = $n;
    }
    if (!count($out) || count($out) > pivot_max_bin_edges()) return null;
    sort($out, SORT_NUMERIC);
    return $out;
}

function pivot_bins_labels($edges) {
    $out = array('below ' . pivot_compact_num($edges[0]));
    for ($i = 0; $i < count($edges) - 1; $i++) {
        $out[] = pivot_compact_num($edges[$i]) . ' – ' . pivot_compact_num($edges[$i + 1]);
    }
    $out[] = 'above ' . pivot_compact_num($edges[count($edges) - 1]);
    return $out;
}

function pivot_bins_bucket_label($rawVal, $edges) {
    $s = pivot_clean_field_value((string)$rawVal);
    if ($s === '') return '';
    if (!is_array($edges) || !count($edges)) return $s;
    // NOT parse_accounting_number(): that one is shared with sort and
    // conditional formatting, and it disagrees with the browser on `%`,
    // scientific notation and the \x02 guard (see the note on
    // _penumbra_summary_clean_number). The browser bins with its own
    // parseAccountingNumber, so binning must use the byte-exact mirror or the
    // SAME cell lands in a bucket in the email and keeps its raw text on screen.
    $n = _penumbra_summary_clean_number($s);
    if ($n === false) return $s;
    $last = count($edges) - 1;
    if ($n < $edges[0]) return 'below ' . pivot_compact_num($edges[0]);
    for ($i = $last; $i >= 0; $i--) {
        if ($n >= $edges[$i]) {
            return ($i === $last)
                ? 'above ' . pivot_compact_num($edges[$i])
                : pivot_compact_num($edges[$i]) . ' – ' . pivot_compact_num($edges[$i + 1]);
        }
    }
    return 'below ' . pivot_compact_num($edges[0]);
}

function pivot_parse_field_token($tok) {
    $s = (string)$tok;
    $parts = explode(':', $s);
    $none = array('base' => $s, 'split' => null, 'fill' => false, 'binWidth' => null, 'binEdges' => null);
    if (count($parts) === 1) return $none;
    $reg = pivot_split_registry();
    $split = null; $fill = false; $binWidth = null; $binEdges = null;
    for ($i = 1; $i < count($parts); $i++) {
        $p = strtolower(trim($parts[$i]));
        if ($p === 'fill') { $fill = true; continue; }
        // Custom edges first - "bins..." is not a bin<width> suffix.
        if ($split === null && preg_match('/^bins(\d+(?:_\d+)*)$/', $p, $bsm)) {
            $eds = pivot_normalize_bin_edges(explode('_', $bsm[1]));
            if ($eds === null) return $none;
            $split = 'bins'; $binEdges = $eds; continue;
        }
        if ($split === null && preg_match('/^bin([1-9]\d*)$/', $p, $bm)) { $split = 'bin'; $binWidth = (int)$bm[1]; continue; }
        // 'bins' excluded: it is only valid WITH an edge list (handled above).
        if ($split === null && isset($reg[$p]) && $p !== 'bins') { $split = $p; continue; }
        return $none;
    }
    if ($split === null) return $none;
    return array('base' => $parts[0], 'split' => $split, 'fill' => $fill, 'binWidth' => $binWidth, 'binEdges' => $binEdges);
}

function pivot_field_base($tok) { $sf = pivot_parse_field_token($tok); return $sf['base']; }

function penumbra_group_level0($v) {
    $parts = explode(',', (string)$v);
    return trim($parts[0]);
}

function penumbra_group_levels($v) {
    $out = array();
    foreach (explode(',', (string)$v) as $p) {
        $p = trim($p);
        if ($p !== '') $out[] = $p;
    }
    return $out;
}

function penumbra_group_rows_nested($rows, $levels, $cmps, $idx, $prefix, &$out) {
    if ($idx >= count($levels)) {
        if (!empty($rows)) $out[$prefix] = $rows;
        return;
    }
    $lv = $levels[$idx];
    $buckets = array();
    foreach ($rows as $row) {
        $label = call_user_func($lv['label'], $row);
        if ($label === '' || $label === null) $label = '[Blank]';
        if (!isset($buckets[$label])) $buckets[$label] = array();
        $buckets[$label][] = $row;
    }
    if (isset($cmps[$idx]) && $cmps[$idx]) { uksort($buckets, $cmps[$idx]); } else { ksort($buckets); }
    foreach ($buckets as $label => $sub) {
        $next = ($prefix === '') ? (string)$label : $prefix . PENUMBRA_GROUP_PATH_SEP . $label;
        penumbra_group_rows_nested($sub, $levels, $cmps, $idx + 1, $next, $out);
    }
}

function penumbra_normalize_group_limit($raw) {
    if (!is_array($raw)) return null;
    $n = isset($raw['n']) ? (int)$raw['n'] : 0;
    $minRows = isset($raw['minRows']) ? (int)$raw['minRows'] : 0;
    if ($n < 0) $n = 0;
    if ($minRows < 0) $minRows = 0;
    if ($n === 0 && $minRows === 0) return null;
    return array(
        'n'       => $n,
        'dir'     => (isset($raw['dir']) && strtolower((string)$raw['dir']) === 'bottom') ? 'bottom' : 'top',
        'other'   => !(isset($raw['other']) && $raw['other'] === false),
        'minRows' => $minRows
    );
}

function penumbra_apply_group_limit($grouped, $limit) {
    if (!$limit) return $grouped;

    // Bucket the flat map by level-0 segment, preserving order.
    $order = array();          // level-0 label, in first-seen (sorted) order
    $members = array();        // '#'.label => [compositePath, ...]
    $sizes = array();          // '#'.label => total rows beneath it
    foreach ($grouped as $path => $rows) {
        $segs = explode(PENUMBRA_GROUP_PATH_SEP, (string)$path);
        $k = '#' . $segs[0];
        if (!isset($members[$k])) { $members[$k] = array(); $sizes[$k] = 0; $order[] = $segs[0]; }
        $members[$k][] = $path;
        $sizes[$k] += count(_cf_group_rows($rows));
    }

    $keep = array(); $drop = array();
    foreach ($order as $label) {
        if ($limit['minRows'] > 0 && $sizes['#' . $label] < $limit['minRows']) $drop[] = $label;
        else $keep[] = $label;
    }
    if ($limit['n'] > 0 && $limit['n'] < count($keep)) {
        if ($limit['dir'] === 'bottom') {
            $cut = array_slice($keep, 0, count($keep) - $limit['n']);
            $keep = array_slice($keep, count($keep) - $limit['n']);
        } else {
            $cut = array_slice($keep, $limit['n']);
            $keep = array_slice($keep, 0, $limit['n']);
        }
        $drop = array_merge($drop, $cut);
    }
    if (empty($drop)) return $grouped;

    $out = array();
    foreach ($keep as $label) {
        foreach ($members['#' . $label] as $path) $out[$path] = $grouped[$path];
    }
    if ($limit['other']) {
        $otherRows = array();
        foreach ($drop as $label) {
            foreach ($members['#' . $label] as $path) {
                foreach (_cf_group_rows($grouped[$path]) as $r) $otherRows[] = $r;
            }
        }
        if (!empty($otherRows)) $out[PENUMBRA_GROUP_OTHER_LABEL] = $otherRows;
    }
    return $out;
}

function _xlsx_subtree_count($grouped, $ancestorPath) {
    $n = 0;
    $prefix = $ancestorPath . PENUMBRA_GROUP_PATH_SEP;
    $plen = strlen($prefix);
    foreach ($grouped as $k => $rows) {
        $k = (string)$k;
        if ($k === $ancestorPath || strncmp($k, $prefix, $plen) === 0) $n += count($rows);
    }
    return $n;
}

function penumbra_group_is_nested($grouped) {
    if (!is_array($grouped)) return false;
    foreach (array_keys($grouped) as $k) {
        if (strpos((string)$k, PENUMBRA_GROUP_PATH_SEP) !== false) return true;
    }
    return false;
}

function penumbra_group_ancestor_index($grouped) {
    $out = array();
    foreach ($grouped as $path => $rows) {
        $rows = _cf_group_rows($rows);
        $segs = explode(PENUMBRA_GROUP_PATH_SEP, (string)$path);
        $prefix = '';
        $last = count($segs) - 1;
        for ($d = 0; $d < $last; $d++) {
            $prefix = ($d === 0) ? $segs[0] : $prefix . PENUMBRA_GROUP_PATH_SEP . $segs[$d];
            $k = '#' . $prefix;
            if (!isset($out[$k])) {
                $out[$k] = array('label' => $segs[$d], 'path' => $prefix, 'depth' => $d, 'rows' => array());
            }
            foreach ($rows as $r) $out[$k]['rows'][] = $r;
        }
    }
    return $out;
}

function penumbra_group_tree($grouped) {
    $index = array();
    $roots = array();
    foreach ($grouped as $path => $rows) {
        $rows = _cf_group_rows($rows);
        $segs = explode(PENUMBRA_GROUP_PATH_SEP, (string)$path);
        $prefix = '';
        $parentKey = null;
        foreach ($segs as $d => $seg) {
            $prefix = ($d === 0) ? $seg : $prefix . PENUMBRA_GROUP_PATH_SEP . $seg;
            $k = '#' . $prefix;
            if (!isset($index[$k])) {
                $index[$k] = array('label' => $seg, 'path' => $prefix, 'depth' => $d,
                                   'rows' => array(), 'kids' => array());
                if ($parentKey === null) $roots[] = $k;
                else $index[$parentKey]['kids'][] = $k;
            }
            foreach ($rows as $r) $index[$k]['rows'][] = $r;
            $parentKey = $k;
        }
    }
    return _penumbra_group_tree_build($roots, $index);
}

function _penumbra_group_tree_build($keys, $index) {
    $out = array();
    foreach ($keys as $k) {
        $n = $index[$k];
        $n['children'] = _penumbra_group_tree_build($n['kids'], $index);
        unset($n['kids']);
        $out[] = $n;
    }
    return $out;
}

function penumbra_group_tree_flatten($nodes, &$out) {
    foreach ($nodes as $n) {
        if (empty($n['children'])) $out[$n['path']] = $n['rows'];
        else penumbra_group_tree_flatten($n['children'], $out);
    }
}

function penumbra_group_level_spec($token, $firstRow, $allRows, $customSortOrders) {
    $tok = pivot_parse_field_token($token);
    $split = $tok['split'];
    $base = $tok['base'];
    $key = null;
    foreach (array_keys($firstRow) as $k) {
        if (strtoupper($k) === strtoupper($base)) { $key = $k; break; }
    }
    if ($key === null) return null;
    $width = null;
    if ($split === 'bin') {
        // Auto width over the WHOLE result set, matching the browser.
        $width = ($tok['binWidth'] !== null) ? $tok['binWidth']
            : pivot_resolve_auto_bin_width($key, $allRows);
    }
    $edges = $tok['binEdges'];
    $label = function ($row) use ($key, $split, $width, $edges) {
        $val = isset($row[$key]) ? $row[$key] : '';
        if ($split === null) return $val;
        if ($split === 'bins')  return pivot_bins_bucket_label($val, $edges);
        if ($split === 'bin' || $split === 'binlog') return pivot_bin_bucket_label($split, $val, $width);
        return pivot_split_bucket_label($split, $val);
    };
    $cmp = ($split !== null)
        ? pivot_split_comparator($split, $key, $customSortOrders)
        : get_custom_sort_comparator($customSortOrders, $key);
    return array('key' => $key, 'label' => $label, 'cmp' => $cmp);
}

function pivot_field_display_label($tok) {
    $sf = pivot_parse_field_token($tok);
    if ($sf['split'] === null) return $sf['base'];
    if ($sf['split'] === 'bins') return $sf['base'] . ' (Custom Ranges)';
    if ($sf['split'] === 'bin' && !empty($sf['binWidth'])) {
        return $sf['base'] . ' (Bins of ' . number_format($sf['binWidth']) . ')';
    }
    $reg = pivot_split_registry();
    return $sf['base'] . ' (' . $reg[$sf['split']]['label'] . ')';
}

function pivot_split_bucket_label($splitId, $rawVal) {
    $reg = pivot_split_registry();
    if (!isset($reg[$splitId])) return (string)$rawVal;
    $s = pivot_clean_field_value((string)$rawVal);
    if ($s === '') return '';
    $parsed = _cf_parse_date($s);
    if ($parsed === false) return $s;
    static $granRank = array('year' => 0, 'month' => 1, 'day' => 2, 'second' => 3);
    $rank = isset($granRank[$parsed['gran']]) ? $granRank[$parsed['gran']] : null;
    if ($rank === null || $rank < $reg[$splitId]['minGran']) return $s;
    $ts = $parsed['ts'];
    $y = (int)date('Y', $ts); $m1 = (int)date('n', $ts); $d = (int)date('j', $ts); $h = (int)date('G', $ts);
    static $MO = array('Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec');
    static $DW = array('Mon','Tue','Wed','Thu','Fri','Sat','Sun');
    $fy = ($m1 >= 7) ? $y + 1 : $y;
    $fy2 = 'FY' . substr((string)$fy, -2);
    $fq = intdiv(($m1 + 5) % 12, 3) + 1;   // Jul = FQ1
    $q = intdiv($m1 - 1, 3) + 1;
    switch ($splitId) {
        case 'year':     return (string)$y;
        case 'fy':       return $fy2;
        case 'yq':       return $y . ' Q' . $q;
        case 'fyq':      return $fy2 . ' Q' . $fq;
        case 'ym':       return $MO[$m1 - 1] . ' ' . $y;
        case 'quarter':  return 'Q' . $q;
        case 'fquarter': return 'FQ' . $fq;
        case 'month':    return $MO[$m1 - 1];
        case 'monthnum': return str_pad((string)$m1, 2, '0', STR_PAD_LEFT);
        case 'dow':      return $DW[((int)date('N', $ts)) - 1];
        case 'hour':     return str_pad((string)$h, 2, '0', STR_PAD_LEFT) . ':00';
    }
    return $s;
}

function pivot_bin_fmt($n) { return number_format(round($n)); }

function pivot_auto_bin_width($min, $max) {
    $range = $max - $min;
    if (!($range > 0)) return 1;
    $raw = $range / 10;
    $p = pow(10, floor(log10($raw)));
    $w = 10 * $p;
    if ($raw <= 1 * $p) $w = 1 * $p; else if ($raw <= 2 * $p) $w = 2 * $p; else if ($raw <= 5 * $p) $w = 5 * $p;
    return max(1, (int)round($w));
}

function pivot_resolve_auto_bin_width($dataKey, $flatRows) {
    $min = INF; $max = -INF;
    if (is_array($flatRows)) {
        foreach ($flatRows as $r) {
            if (!is_array($r) || !isset($r[$dataKey])) continue;
            $s = pivot_clean_field_value((string)$r[$dataKey]);
            if ($s === '') continue;
            // Byte-exact JS mirror, not parse_accounting_number - see the note
            // in pivot_bin_bucket_label below. The auto width must be resolved
            // from the same numbers the browser sees or both sides bin at
            // different widths from the very first row.
            $n = _penumbra_summary_clean_number($s);
            if ($n === false) continue;
            if ($n < $min) $min = $n;
            if ($n > $max) $max = $n;
        }
    }
    return ($min <= $max) ? pivot_auto_bin_width($min, $max) : 1;
}

function pivot_bin_bucket_label($splitId, $rawVal, $width) {
    $s = pivot_clean_field_value((string)$rawVal);
    if ($s === '') return '';
    // NOT parse_accounting_number(): that one is shared with sort and
    // conditional formatting, and it disagrees with the browser on `%`,
    // scientific notation and the \x02 guard (see the note on
    // _penumbra_summary_clean_number). The browser bins with its own
    // parseAccountingNumber, so binning must use the byte-exact mirror or the
    // SAME cell lands in a bucket in the email and keeps its raw text on screen.
    $n = _penumbra_summary_clean_number($s);
    if ($n === false) return $s;
    if ($splitId === 'binlog') {
        if (!($n >= 1)) return '< 1';
        // Exact decade walk - float log10 can round DOWN at exact powers of
        // 10 on some platforms, dropping 1000 into "100 - 999".
        $lo = 1;
        while ($n >= $lo * 10 && $lo < 1e15) $lo *= 10;
        return pivot_bin_fmt($lo) . ' – ' . pivot_bin_fmt($lo * 10 - 1);
    }
    $w = ($width && $width > 0) ? $width : 1;
    $lo2 = floor($n / $w) * $w;
    return pivot_bin_fmt($lo2) . ' – ' . pivot_bin_fmt($lo2 + $w - 1);
}

function pivot_split_sort_val($splitId, $label) {
    $s = (string)$label;
    if ($splitId === 'bins') {
        if (preg_match('/^below /u', $s)) return -1e12;              // open-below sorts first
        if (preg_match('/^above (.+)$/u', $s, $m)) return pivot_compact_parse($m[1]);
        if (preg_match('/^(.+?) – (.+)$/u', $s, $m)) return pivot_compact_parse($m[1]);
        return null;
    }
    if ($splitId === 'bin' || $splitId === 'binlog') {
        if (preg_match('/^< /u', $s)) return -1e12;
        if (preg_match('/^(-?[\d,]+)/', $s, $m)) return (float)str_replace(',', '', $m[1]);
        return null;
    }
    static $MO = array('Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec');
    static $DW = array('Mon','Tue','Wed','Thu','Fri','Sat','Sun');
    switch ($splitId) {
        case 'year':     return preg_match('/^\d{4}$/', $s) ? (int)$s : null;
        case 'fy':       return preg_match('/^FY(\d{2})$/i', $s, $m) ? 2000 + (int)$m[1] : null;
        case 'yq':       return preg_match('/^(\d{4}) Q([1-4])$/', $s, $m) ? ((int)$m[1]) * 10 + (int)$m[2] : null;
        case 'fyq':      return preg_match('/^FY(\d{2}) Q([1-4])$/i', $s, $m) ? (2000 + (int)$m[1]) * 10 + (int)$m[2] : null;
        case 'ym':
            if (!preg_match('/^([A-Za-z]{3}) (\d{4})$/', $s, $m)) return null;
            $i = array_search($m[1], $MO, true);
            return $i === false ? null : ((int)$m[2]) * 100 + $i + 1;
        case 'quarter':  return preg_match('/^Q([1-4])$/i', $s, $m) ? (int)$m[1] : null;
        case 'fquarter': return preg_match('/^FQ([1-4])$/i', $s, $m) ? (int)$m[1] : null;
        case 'month':    $i = array_search($s, $MO, true); return $i === false ? null : $i + 1;
        case 'monthnum': return preg_match('/^(0[1-9]|1[0-2])$/', $s) ? (int)$s : null;
        case 'dow':      $i = array_search($s, $DW, true); return $i === false ? null : $i;
        case 'hour':     return preg_match('/^([01]\d|2[0-3]):00$/', $s, $m) ? (int)$m[1] : null;
    }
    return null;
}

function pivot_split_next_label($splitId, $label) {
    static $MO = array('Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec');
    switch ($splitId) {
        case 'bin':
            // The width lives in the label itself (hi - lo + 1): fill needs no state.
            if (preg_match('/^(-?[\d,]+) – (-?[\d,]+)$/u', $label, $m)) {
                $lo = (float)str_replace(',', '', $m[1]);
                $hi = (float)str_replace(',', '', $m[2]);
                $w = $hi - $lo + 1;
                if ($w > 0) return pivot_bin_fmt($hi + 1) . ' – ' . pivot_bin_fmt($hi + $w);
            }
            return $label;
        case 'binlog':
            if (preg_match('/^< /u', $label)) return '1 – 9';
            if (preg_match('/^(-?[\d,]+) – /u', $label, $m)) {
                $lo = (float)str_replace(',', '', $m[1]);
                if ($lo > 0) return pivot_bin_fmt($lo * 10) . ' – ' . pivot_bin_fmt($lo * 100 - 1);
            }
            return $label;
        case 'year': return (string)((int)$label + 1);
        case 'fy':   return 'FY' . str_pad((string)((((int)substr($label, 2)) + 1) % 100), 2, '0', STR_PAD_LEFT);
        case 'yq':
            $p = explode(' Q', $label); $y = (int)$p[0]; $q = (int)$p[1];
            return $q === 4 ? ($y + 1) . ' Q1' : $y . ' Q' . ($q + 1);
        case 'fyq':
            $p = explode(' Q', $label); $q = (int)$p[1];
            if ($q === 4) return 'FY' . str_pad((string)((((int)substr($p[0], 2)) + 1) % 100), 2, '0', STR_PAD_LEFT) . ' Q1';
            return $p[0] . ' Q' . ($q + 1);
        case 'ym':
            $p = explode(' ', $label); $i = array_search($p[0], $MO, true); $y = (int)$p[1];
            if ($i === false) return $label;
            return $i === 11 ? 'Jan ' . ($y + 1) : $MO[$i + 1] . ' ' . $y;
    }
    return $label;
}

function pivot_split_variant_cmp($splitId) {
    return function($a, $b) use ($splitId) {
        $av = pivot_split_sort_val($splitId, $a);
        $bv = pivot_split_sort_val($splitId, $b);
        if ($av !== null && $bv !== null) return $av === $bv ? 0 : ($av < $bv ? -1 : 1);
        if ($av !== null) return -1;
        if ($bv !== null) return 1;
        return strnatcasecmp($a, $b);
    };
}

function pivot_split_comparator($splitId, $baseCol, $customSortOrders) {
    $entry = penumbra_custom_sort_entry($customSortOrders, $baseCol);
    $values = ($entry && isset($entry['values']) && is_array($entry['values']))
        ? array_values($entry['values']) : array();
    if (count($values) === 0) return pivot_split_variant_cmp($splitId);
    $orderMap = array();
    foreach ($values as $i => $v) {
        $k = strtolower(trim((string)$v));
        if (!isset($orderMap[$k])) $orderMap[$k] = $i;   // first occurrence wins
    }
    // Hoisted: this is a sort comparator, so rebuilding the variant closure on
    // every unlisted-vs-unlisted pair would allocate O(n log n) times.
    $variant = pivot_split_variant_cmp($splitId);
    return function($a, $b) use ($orderMap, $variant) {
        $ka = strtolower(trim((string)$a));
        $kb = strtolower(trim((string)$b));
        $ia = isset($orderMap[$ka]) ? $orderMap[$ka] : -1;
        $ib = isset($orderMap[$kb]) ? $orderMap[$kb] : -1;
        if ($ia !== -1 && $ib !== -1) return ($ia === $ib) ? 0 : (($ia < $ib) ? -1 : 1);
        if ($ia !== -1) return -1;
        if ($ib !== -1) return 1;
        return $variant($a, $b);
    };
}

function pivot_cols_fill_spec($colFields) {
    if (!is_array($colFields) || count($colFields) !== 1) return null;
    $sf = pivot_parse_field_token($colFields[0]);
    if ($sf['split'] === null || !$sf['fill']) return null;
    // Custom ranges have no walkable next label - the expander rebuilds their
    // full bucket list from the edges instead.
    if ($sf['split'] === 'bins') return (!empty($sf['binEdges'])) ? $sf : null;
    $reg = pivot_split_registry();
    $kind = $reg[$sf['split']]['kind'];
    return ($kind === 'period' || $kind === 'bin') ? $sf : null;
}

function pivot_expand_colkeys_with_gaps(&$sortedColKeys, $splitId, $spec = null) {
    // Custom ranges: every defined bucket exists, in canonical order; raw
    // (non-numeric) fallback keys keep their place after them.
    if ($splitId === 'bins') {
        $eds = ($spec && !empty($spec['binEdges'])) ? $spec['binEdges'] : null;
        if (!$eds) return;
        $all = pivot_bins_labels($eds);
        $merged = $all;
        foreach ($sortedColKeys as $k) {
            if (!in_array($k, $all, true)) $merged[] = $k;
        }
        $sortedColKeys = $merged;
        return;
    }
    for ($i = 0; $i < count($sortedColKeys) - 1; $i++) {
        $cur = $sortedColKeys[$i]; $nxt = $sortedColKeys[$i + 1];
        if (pivot_split_sort_val($splitId, $cur) === null || pivot_split_sort_val($splitId, $nxt) === null) continue;
        $guard = 0; $k = $cur;
        $nxtVal = pivot_split_sort_val($splitId, $nxt);
        while ($guard++ < 600) {
            $k = pivot_split_next_label($splitId, $k);
            $kv = pivot_split_sort_val($splitId, $k);
            if ($k === $nxt || $kv === null || $kv >= $nxtVal) break;
            array_splice($sortedColKeys, $i + 1, 0, array($k));
            $i++;
        }
    }
}

function pivot_build_field_comparators($fields, $customSortOrders) {
    $out = array();
    if (!is_array($fields)) return $out;
    foreach ($fields as $i => $f) {
        // A split field orders by its own calendar (Jan before Feb, FY24 before
        // FY25) unless a custom sort order covers its labels. Mirrors main.js.
        $sf = pivot_parse_field_token($f);
        if ($sf['split'] !== null) { $out[$i] = pivot_split_comparator($sf['split'], $sf['base'], $customSortOrders); continue; }
        $out[$i] = get_custom_sort_comparator($customSortOrders, $f);
    }
    return $out;
}

function custom_sort_pivot_keys($a, $b, $fields, $fieldCmp, $direction) {
    $aParts = explode('|||', $a);
    $bParts = explode('|||', $b);
    $fieldCount = count($fields);
    $partCount = min(count($aParts), count($bParts));
    for ($i = 0; $i < $fieldCount && $i < $partCount; $i++) {
        $cmpFn = isset($fieldCmp[$i]) ? $fieldCmp[$i] : null;
        if ($cmpFn) {
            $cmp = call_user_func($cmpFn, $aParts[$i], $bParts[$i]);
        } else {
            $cmp = strnatcasecmp($aParts[$i], $bParts[$i]);
        }
        if ($cmp !== 0) return $direction === 'desc' ? -$cmp : $cmp;
    }
    return 0;
}

function apply_state_logic($data, $state, $preserveCols = array()) {
    // Per-column summary config for this report, published for the footer
    // builders (see penumbra_resolve_summaries). ALWAYS reassigned, never
    // conditionally: the runner processes tasks in one long-lived process, so a
    // leftover map from the previous report would summarize this one's columns.
    // Set before the empty-data bail for exactly that reason.
    $GLOBALS['penumbra_column_summaries'] =
        (isset($state['columnSummaries']) && is_array($state['columnSummaries']))
            ? $state['columnSummaries']
            : array();
    // Badge visibility, same always-reassign rule so it cannot leak between
    // reports in the long-lived runner process.
    $GLOBALS['penumbra_summary_badges'] =
        (isset($state['summaryBadges']) && $state['summaryBadges'] === false) ? false : true;
    $GLOBALS['penumbra_summary_formulas'] =
        (isset($state['columnSummaryFormulas']) && is_array($state['columnSummaryFormulas']))
            ? $state['columnSummaryFormulas']
            : array();

    if (empty($data)) return array('data' => $data, 'themeName' => isset($state['theme']) ? $state['theme'] : 'theme-default', 'viewMode' => 'standard');

    // 1. Sorting
    $customSortOrders = isset($state['customSortOrders']) ? $state['customSortOrders'] : array();
    if (isset($state['sortCriteria']) && !empty($state['sortCriteria'])) {
        $criteria = $state['sortCriteria'];
        // Resolve one comparator per criterion ONCE. This used to run inside the
        // usort callback, i.e. once per COMPARISON, rebuilding the order map
        // O(n log n) times per criterion. Mirrors the chainCmp pre-resolve the
        // browser does in js/main.js.
        $critCmp = array();
        foreach ($criteria as $ci => $crit) {
            $critCmp[$ci] = isset($crit['colIdentifier'])
                ? get_custom_sort_comparator($customSortOrders, $crit['colIdentifier'])
                : null;
        }
        usort($data, function($a, $b) use ($criteria, $critCmp) {
            foreach ($criteria as $ci => $crit) {
                $col = $crit['colIdentifier'];
                $valA = isset($a[$col]) ? trim((string)$a[$col]) : '';
                $valB = isset($b[$col]) ? trim((string)$b[$col]) : '';
                $dir = (isset($crit['direction']) && strtolower($crit['direction']) === 'desc') ? -1 : 1;

                if ($valA === '' && $valB === '') { $cmp = 0; }
                else if ($valA === '') { $cmp = -1; }
                else if ($valB === '') { $cmp = 1; }
                else {
                    $customCmp = isset($critCmp[$ci]) ? $critCmp[$ci] : null;
                    if ($customCmp) {
                        $cmp = call_user_func($customCmp, $valA, $valB);
                    } else {
                        $numA = is_strict_number($valA) ? parse_accounting_number($valA) : false;
                        $numB = is_strict_number($valB) ? parse_accounting_number($valB) : false;

                        if ($numA !== false && $numB !== false) {
                            $cmp = ($numA == $numB) ? 0 : (($numA < $numB) ? -1 : 1);
                        } else {
                            $cmp = strnatcasecmp($valA, $valB);
                        }
                    }
                }

                if ($cmp != 0) return $cmp * $dir;
            }
            return 0;
        });
    }

    // 2. Column Visibility & Ordering
    // Use this flag to track if we forced the group column to appear
    $groupColumnWasHidden = false;
    // Declared out here because the block that fills it is conditional, and the
    // grouping step below reads it unconditionally.
    $_gbHiddenKeys = array();

    if ((isset($state['visibleColumns']) || isset($state['columnOrder'])) && !empty($data)) {
        $originalKeys = array_keys($data[0]);

        $visibleIndices = [];
        if (isset($state['visibleColumns'])) {
            foreach ($state['visibleColumns'] as $idx) {
                if ($idx !== '#' && is_numeric($idx) && isset($originalKeys[(int)$idx])) {
                    $visibleIndices[] = (int)$idx;
                }
            }
        } else {
            $visibleIndices = array_keys($originalKeys);
        }

        // --- FIX START: Ensure GroupBy column is present for processing ---
        if (isset($state['groupBy']) && !empty($state['groupBy'])) {
            // EVERY level, not just the outermost: a nested grouping reads a
            // column per level, and a level whose column stayed hidden would
            // group every row into one "[Blank]" band. BASE, not token - a
            // bucket grouping is saved whole (AWARD_DATE:fy) and is never itself
            // a column key.
            $_gbHiddenKeys = array();
            foreach (penumbra_group_levels($state['groupBy']) as $_lvTok) {
                $groupColName = strtoupper(pivot_field_base($_lvTok));
                $groupColIndex = -1;
                foreach ($originalKeys as $idx => $key) {
                    if (strtoupper($key) === $groupColName) { $groupColIndex = $idx; break; }
                }
                // Found but NOT in the visible list: force it in, and remember to
                // strip it back out once the grouping has read it.
                if ($groupColIndex > -1 && !in_array($groupColIndex, $visibleIndices)) {
                    $visibleIndices[] = $groupColIndex;
                    $_gbHiddenKeys[] = $originalKeys[$groupColIndex];
                    $groupColumnWasHidden = true;
                }
            }
        }
        // --- FIX END ---

        $finalOrderNames = [];
        if (isset($state['columnOrder'])) {
            foreach ($state['columnOrder'] as $idx) {
                if (is_numeric($idx) && isset($originalKeys[(int)$idx]) && in_array((int)$idx, $visibleIndices)) {
                    $finalOrderNames[] = $originalKeys[(int)$idx];
                }
            }
            // Append any visible columns NOT in the order list (e.g. the forced group column)
            foreach ($visibleIndices as $idx) {
                $colName = $originalKeys[$idx];
                if (!in_array($colName, $finalOrderNames)) {
                    $finalOrderNames[] = $colName;
                }
            }
        } else {
            sort($visibleIndices);
            foreach ($visibleIndices as $idx) {
                $finalOrderNames[] = $originalKeys[$idx];
            }
        }

        // Preserve caller-specified extra columns (e.g. journal toggle columns
        // injected upstream) at the END. They aren't in the numeric-indexed
        // visibility/order lists, so without this the rebuild below would drop them.
        if (!empty($preserveCols)) {
            foreach ($preserveCols as $pc) {
                if (array_key_exists($pc, $data[0]) && !in_array($pc, $finalOrderNames, true)) {
                    $finalOrderNames[] = $pc;
                }
            }
        }

        $newData = [];
        foreach ($data as $row) {
            $newRow = [];
            foreach ($finalOrderNames as $colName) {
                $newRow[$colName] = isset($row[$colName]) ? $row[$colName] : null;
            }
            $newData[] = $newRow;
        }
        $data = $newData;
    }

    // 3. Row Limiting (Handled by API)

    // 4. Grouping
    $viewMode = 'standard';
    $groupBy = isset($state['groupBy']) ? $state['groupBy'] : null;
    
    if ($groupBy && !empty($data)) {
        $firstRow = reset($data);
        // Bucket grouping (2026-08-29). The browser can group by a variant of a
        // column (AWARD_DATE:fy, AMOUNT:bin50000) and saves that whole token as
        // state['groupBy']. Resolve it on the BASE and label each value through
        // the split engine already ported here for pivots, so a scheduled send
        // of a bucketed grouping matches what the report shows on screen -
        // without this the token matched no column and the mail went out flat.
        // Does the OUTERMOST level name a real column? That is the gate for
        // grouping at all; the per-level resolution (bucket spec, labeller,
        // comparator) happens in penumbra_group_level_spec() below, once per
        // level. BASE, not token: a bucket grouping is saved whole
        // (AWARD_DATE:fy) and is never itself a column key.
        $_gbBase = pivot_field_base(penumbra_group_level0($groupBy));
        $actualKey = null;
        foreach(array_keys($firstRow) as $k) {
            if (strtoupper($k) === strtoupper($_gbBase)) {
                $actualKey = $k;
                break;
            }
        }

        if ($actualKey) {
            // Resolve EVERY level (2026-08-30). The browser nests up to three
            // and saves them comma-joined; taking only level 0 here meant a
            // scheduled send of a three-level grouping arrived with two levels
            // of structure silently missing - every row present, but grouped by
            // department alone. A level whose column is not in the result set
            // truncates the stack there rather than voiding the grouping, which
            // is the same degradation the browser makes.
            $_gbLevels = array();
            $_gbCmps = array();
            foreach (penumbra_group_levels($groupBy) as $_lvTok) {
                $_spec = penumbra_group_level_spec($_lvTok, $firstRow, $data, $customSortOrders);
                if ($_spec === null) break;
                $_gbLevels[] = $_spec;
                $_gbCmps[] = $_spec['cmp'];
            }

            // Strip the columns that were forced visible only so the grouping
            // could read them - one per LEVEL now, not just the outermost.
            if ($groupColumnWasHidden && !empty($_gbHiddenKeys)) {
                $_stripped = array();
                foreach ($data as $_r) {
                    foreach ($_gbHiddenKeys as $_hk) { unset($_r[$_hk]); }
                    $_stripped[] = $_r;
                }
                $data = $_stripped;
            }

            $grouped = array();
            penumbra_group_rows_nested($data, $_gbLevels, $_gbCmps, 0, '', $grouped);
            $data = $grouped;
            $viewMode = 'grouped';
        } else {
            // Virtual column grouping: check @@JSON cells for the column
            $upperGroupBy = strtoupper($groupBy);
            $sampleVirtual = _search_get_virtual_columns($firstRow);
            if (isset($sampleVirtual[$upperGroupBy])) {
                $grouped = array();
                foreach ($data as $row) {
                    $vCols = _search_get_virtual_columns($row);
                    $values = isset($vCols[$upperGroupBy]) ? $vCols[$upperGroupBy] : array();
                    if (empty($values)) {
                        if (!isset($grouped['[Blank]'])) $grouped['[Blank]'] = array();
                        $grouped['[Blank]'][] = $row;
                    } else {
                        // Multi-value: row appears in multiple groups (deduplicated)
                        $seen = array();
                        foreach ($values as $val) {
                            $val = trim((string)$val);
                            if ($val === '' || $val === null) $val = '[Blank]';
                            if (isset($seen[$val])) continue;
                            $seen[$val] = true;
                            if (!isset($grouped[$val])) $grouped[$val] = array();
                            $grouped[$val][] = $row;
                        }
                    }
                }
                $groupCustomCmp = get_custom_sort_comparator($customSortOrders, $groupBy);
                if ($groupCustomCmp) {
                    uksort($grouped, $groupCustomCmp);
                } else {
                    ksort($grouped);
                }
                $data = $grouped;
                $viewMode = 'grouped';
            }
        }
    }

    $groupAgg = (isset($state['groupAgg']) && is_array($state['groupAgg'])) ? $state['groupAgg'] : null;
    // Attach the grouping column name so compute_group_agg_summary can filter virtual columns
    if ($groupAgg && $groupBy) {
        $groupAgg['groupByCol'] = $groupBy;
    }

    // Honor the saved group sort (label / fewest-most items / summary low-high), so a
    // scheduled email orders groups the same way the browser does. Grouping above already
    // produced label-ascending order; this reorders when a non-default sort was saved.
    $groupSort = (isset($state['groupSort']) && is_array($state['groupSort'])) ? $state['groupSort'] : null;
    if ($viewMode === 'grouped' && $groupSort && is_array($data) && !empty($data)) {
        $data = _cf_sort_groups($data, $groupSort, $groupAgg, $groupBy);
    }

    // Group-level filtering, AFTER sorting - "top N" means the first N in the
    // order the reader chose, exactly as in js/main.js's rebuildGroupedView().
    // Without this a scheduled send of a "top 10 departments" grouping emailed
    // all 248. (2026-08-30)
    $groupLimit = penumbra_normalize_group_limit(
        isset($state['groupLimit']) ? $state['groupLimit'] : null);
    if ($viewMode === 'grouped' && $groupLimit && is_array($data) && !empty($data)) {
        $data = penumbra_apply_group_limit($data, $groupLimit);
    }

    return array(
        'data' => $data,
        'themeName' => isset($state['theme']) ? $state['theme'] : 'theme-default',
        'viewMode' => $viewMode,
        'groupAgg' => $groupAgg
    );
}

function _cf_group_rows($group) {
    if (isset($group['rows']) && is_array($group['rows'])) return $group['rows'];
    if (is_array($group)) return $group;
    return array();
}

function _cf_sort_groups($grouped, $groupSort, $groupAgg, $groupBy) {
    $key = isset($groupSort['key']) ? $groupSort['key'] : 'label';
    $dir = (isset($groupSort['dir']) && $groupSort['dir'] === 'desc') ? 'desc' : 'asc';

    if ($key === 'summary' && (!$groupAgg || empty($groupAgg['column']) || empty($groupAgg['type']))) {
        return $grouped; // summary sort needs a configured summary; leave label order
    }

    // NESTED: sort each sibling set on its own terms, then re-flatten to the
    // same {compositePath => rows} map. A flat uksort over composite leaf
    // labels scatters one parent's children across the whole report - "sort by
    // count" is supposed to order siblings WITHIN a parent, and parents among
    // themselves by their own subtree, which is what the browser does per
    // level. Label-asc is still a no-op and label-desc still a reversal, just
    // applied at every level. (2026-08-30)
    if (penumbra_group_is_nested($grouped)) {
        $tree = _cf_sort_group_tree(penumbra_group_tree($grouped), $key, $dir, $groupAgg, $groupBy);
        $out = array();
        penumbra_group_tree_flatten($tree, $out);
        return $out;
    }

    if ($key === 'label') {
        return ($dir === 'desc') ? array_reverse($grouped, true) : $grouped;
    }

    $metric = array();
    foreach ($grouped as $gKey => $group) {
        $rows = _cf_group_rows($group);
        if ($key === 'count') {
            $metric[$gKey] = count($rows);
        } elseif ($key === 'summary') {
            $gbCol = isset($groupAgg['groupByCol']) ? $groupAgg['groupByCol'] : $groupBy;
            $raw = _cf_compute_group_agg_raw($rows, $groupAgg['column'], $groupAgg['type'], $gbCol, $gKey);
            $metric[$gKey] = ($raw['value'] === null) ? 0.0 : (float)$raw['value'];
        } else {
            $metric[$gKey] = 0;
        }
    }
    uksort($grouped, function ($a, $b) use ($metric, $dir) {
        $va = $metric[$a]; $vb = $metric[$b];
        if ($va == $vb) return strcasecmp((string)$a, (string)$b); // deterministic label tiebreak
        $cmp = ($va < $vb) ? -1 : 1;
        return ($dir === 'desc') ? -$cmp : $cmp;
    });
    return $grouped;
}

function _cf_sort_group_tree($nodes, $key, $dir, $groupAgg, $groupBy) {
    if (empty($nodes)) return $nodes;

    if ($key === 'label') {
        // NOT a re-sort. penumbra_group_rows_nested() already emitted each
        // sibling set through that level's own comparator - which for a bucket
        // level is CALENDAR order and may be a custom sort order. Sorting by
        // label text here would throw both away; desc just reverses.
        $ordered = ($dir === 'desc') ? array_reverse($nodes) : $nodes;
    } else {
        $metric = array();
        foreach ($nodes as $i => $n) {
            if ($key === 'count') {
                $metric[$i] = count($n['rows']);
            } elseif ($key === 'summary') {
                $gbCol = isset($groupAgg['groupByCol']) ? $groupAgg['groupByCol'] : $groupBy;
                $raw = _cf_compute_group_agg_raw($n['rows'], $groupAgg['column'], $groupAgg['type'],
                                                 $gbCol, $n['label']);
                $metric[$i] = ($raw['value'] === null) ? 0.0 : (float)$raw['value'];
            } else {
                $metric[$i] = 0;
            }
        }
        $idx = array_keys($nodes);
        usort($idx, function ($a, $b) use ($metric, $nodes, $dir) {
            $va = $metric[$a]; $vb = $metric[$b];
            if ($va == $vb) return strcasecmp((string)$nodes[$a]['label'], (string)$nodes[$b]['label']);
            $cmp = ($va < $vb) ? -1 : 1;
            return ($dir === 'desc') ? -$cmp : $cmp;
        });
        $ordered = array();
        foreach ($idx as $i) $ordered[] = $nodes[$i];
    }

    $out = array();
    foreach ($ordered as $n) {
        if (!empty($n['children'])) {
            $n['children'] = _cf_sort_group_tree($n['children'], $key, $dir, $groupAgg, $groupBy);
        }
        $out[] = $n;
    }
    return $out;
}

function penumbra_summary_types() {
    static $types = null;
    if ($types === null) {
        $types = array(
            'sum'          => array('label' => 'Total',                  'badge' => 'SUM',   'header' => 'TOTALS'),
            'avg'          => array('label' => 'Average',                'badge' => 'AVG',   'header' => 'AVERAGES'),
            'median'       => array('label' => 'Median',                 'badge' => 'MED',   'header' => 'MEDIANS'),
            'min'          => array('label' => 'Minimum',                'badge' => 'MIN',   'header' => 'MINIMUMS',  'dateAware' => true),
            'max'          => array('label' => 'Maximum',                'badge' => 'MAX',   'header' => 'MAXIMUMS',  'dateAware' => true),
            'range'        => array('label' => 'Range (max - min)',      'badge' => 'RANGE', 'header' => 'RANGES'),
            'stddev'       => array('label' => 'Std Deviation',          'badge' => 'STDEV', 'header' => 'STD DEVS'),
            'count'        => array('label' => 'Count (all rows)',       'badge' => 'CNT',   'header' => 'COUNTS'),
            'count_filled' => array('label' => 'Count Non-Blank',        'badge' => 'FILL',  'header' => 'NON-BLANK'),
            'count_blank'  => array('label' => 'Count Blank',            'badge' => 'BLANK', 'header' => 'BLANKS'),
            'count_unique' => array('label' => 'Count Unique',           'badge' => 'UNIQ',  'header' => 'UNIQUE'),
            'mode'         => array('label' => 'Mode (most common)',     'badge' => 'MODE',  'header' => 'MODES'),
            'antimode'     => array('label' => 'Antimode (least common)','badge' => 'ANTI',  'header' => 'ANTIMODES'),
            'formula'      => array('label' => 'Custom Formula',        'badge' => 'FX',    'header' => 'FORMULAS')
        );
    }
    return $types;
}

function penumbra_summary_global_default($header, $isCurrencyCol) {
    global $total_exemptions;
    if ($isCurrencyCol) return 'sum';
    if (!empty($total_exemptions)) {
        $upperH = strtoupper((string)$header);
        foreach ($total_exemptions as $exemption) {
            if (strpos($upperH, strtoupper($exemption)) !== false) return 'sum';
        }
    }
    return null;
}

function penumbra_resolve_summaries($headers, $isCurrencyCol, $summaryConfig) {
    $types = penumbra_summary_types();
    // Fall back to the config apply_state_logic() stashed for this report. The
    // six footer call sites live in deeply nested per-recipient send loops that
    // have no clean access to $state, and this file already reads
    // $total_exemptions the same way - threading a 7th argument through all of
    // them would be far easier to get wrong than to get right.
    if ($summaryConfig === null && isset($GLOBALS['penumbra_column_summaries'])) {
        $summaryConfig = $GLOBALS['penumbra_column_summaries'];
    }
    // The client stores names uppercased; server rows keep the query's own
    // casing, so index the config case-insensitively rather than trusting a
    // match. Same class of bug as _snippet_normalize_case().
    $cfg = array();
    if (is_array($summaryConfig)) {
        foreach ($summaryConfig as $k => $v) $cfg[strtoupper((string)$k)] = $v;
    }
    $out = array();
    foreach ($headers as $h) {
        $key = strtoupper((string)$h);
        if (array_key_exists($key, $cfg)) {
            $eff = $cfg[$key];   // false / null here means "author switched it off"
        } else {
            $eff = penumbra_summary_global_default($h, !empty($isCurrencyCol[$h]));
        }
        if (is_string($eff) && isset($types[$eff])) $out[$h] = $eff;
    }
    return $out;
}

function _penumbra_summary_clean_number($raw) {
    $str = trim((string)$raw);
    if ($str === '') return false;
    $isNegative = (substr($str, 0, 1) === '(' && substr($str, -1) === ')');
    // EXACTLY the JS parseAccountingNumber character class - `[$,()%\x02]` then
    // trim. Note it does NOT include `\s`: inner whitespace must remain and make
    // the value non-numeric, so "1 000" is rejected on both sides. (The decimals
    // sniff below DOES strip \s, because the JS accumulator's decimals line
    // does. The two are inconsistent with each other in the browser; matching
    // the browser is what matters.)
    $clean = trim(preg_replace('/[$,()%\x02]/u', '', $str));
    if ($clean === '' || $clean === null) return false;
    // Same whole-string validation as the JS - no exponent branch, by design.
    if (!preg_match('/^[-+]?(\d+(\.\d*)?|\.\d+)$/', $clean)) return false;
    $num = (float)$clean;
    if (!is_finite($num)) return false;
    return $isNegative ? -$num : $num;
}

function _penumbra_summary_round_like_intl($val, $dec) {
    if (!is_finite($val)) return $val;
    $neg = ($val < 0);
    $s = json_encode(abs($val));
    if (!is_string($s) || preg_match('/[eE]/', $s)) return round($val, $dec);

    $parts = explode('.', $s, 2);
    $int   = $parts[0];
    $frac  = isset($parts[1]) ? $parts[1] : '';
    if (strlen($frac) <= $dec) return $val;   // already shorter than we'd cut

    $roundUp = ((int)$frac[$dec] >= 5);
    $digits  = $int . substr($frac, 0, $dec);
    if ($roundUp) {
        $i = strlen($digits) - 1;
        while ($i >= 0) {
            if ($digits[$i] === '9') { $digits[$i] = '0'; $i--; }
            else { $digits[$i] = (string)((int)$digits[$i] + 1); break; }
        }
        if ($i < 0) $digits = '1' . $digits;
    }
    if ($dec > 0) {
        $cut = strlen($digits) - $dec;
        $out = ($cut > 0 ? substr($digits, 0, $cut) : '0') . '.' . substr($digits, -$dec);
    } else {
        $out = $digits;
    }
    $f = (float)$out;
    return $neg ? -$f : $f;
}

function _penumbra_summary_decimals($raw) {
    $clean = preg_replace('/[$,()%\s\x02]/u', '', (string)$raw);
    $dot = strpos($clean, '.');
    if ($dot === false) return 0;
    return strlen(preg_replace('/[^0-9]/', '', substr($clean, $dot + 1)));
}

function _penumbra_summary_parse_date($str) {
    static $formats = null;
    if ($formats === null) {
        $formats = array(
            'm/d/Y', 'n/j/Y', 'Y-m-d', 'd-M-Y', 'd-M-y',
            'M d, Y', 'F d, Y', 'm/d/Y H:i:s', 'Y-m-d H:i:s',
            'm-d-Y', 'n-j-Y',
            'Y-m-d H:i:s.v', 'Y-m-d\TH:i:s', 'Y-m-d\TH:i:s.v'
        );
    }
    foreach ($formats as $fmt) {
        // '!' zeroes unspecified fields so a date-only format cannot pick up
        // "now" for the time part and make two equal dates compare unequal.
        $dt = DateTime::createFromFormat('!' . $fmt, $str);
        if ($dt === false) continue;
        $err = DateTime::getLastErrors();
        if (!empty($err['warning_count']) || !empty($err['error_count'])) continue;
        // Round-trip check rejects rollovers (2026-02-30 -> Mar 2) that
        // createFromFormat otherwise accepts silently.
        //
        // strcasecmp, NOT !==: PHP's format() always emits "Jan"/"January",
        // while moment's MMM/MMMM matching is case-INSENSITIVE. A case-sensitive
        // compare rejected "15-JAN-26" - which is Oracle's native DD-MON-RR
        // rendering and therefore one of the most likely date shapes in this
        // app - and one rejection drops the WHOLE column off the date track, so
        // the browser showed a date and the email showed a blank cell.
        if (strcasecmp($dt->format($fmt), $str) !== 0) continue;
        // moment pivots 2-digit years 00-68 => 2000s, 69-99 => 1900s; PHP's 'y'
        // pivots at 69/70. Only the year "69" differs - correct it so
        // "15-Jan-69" means 1969 on both sides.
        if (strpos($fmt, 'y') !== false && (int)$dt->format('Y') === 2069) {
            $dt->modify('-100 years');
        }
        return $dt->getTimestamp();
    }
    return false;
}

function penumbra_formula_vars() {
    return array('sum','count','filled','blank','unique','min','max','avg','median','range','stddev');
}

function _penumbra_lower_formula_labels($ast) {
    if (!is_array($ast)) return $ast;
    if (isset($ast['type']) && $ast['type'] === 'label' && isset($ast['name'])) {
        $ast['name'] = strtolower((string)$ast['name']);
    } elseif (isset($ast['type']) && $ast['type'] === 'neg') {
        $ast['operand'] = _penumbra_lower_formula_labels($ast['operand']);
    } elseif (isset($ast['type']) && $ast['type'] === 'binop') {
        $ast['left']  = _penumbra_lower_formula_labels($ast['left']);
        $ast['right'] = _penumbra_lower_formula_labels($ast['right']);
    }
    return $ast;
}

function penumbra_parse_summary_formula($expr) {
    if (!is_string($expr) || trim($expr) === '') return null;
    try {
        $ast = _penumbra_lower_formula_labels(pivot_parse_formula($expr));
    } catch (Exception $e) {
        return null;
    }
    $vars = penumbra_formula_vars();
    $refs = array();
    _penumbra_collect_formula_refs($ast, $refs);
    foreach ($refs as $r) {
        if (!in_array($r, $vars, true)) return null;
    }
    return $ast;
}

function _penumbra_collect_formula_refs($ast, &$out) {
    if (!is_array($ast) || !isset($ast['type'])) return;
    if ($ast['type'] === 'label') { if (!in_array($ast['name'], $out, true)) $out[] = $ast['name']; }
    elseif ($ast['type'] === 'neg') _penumbra_collect_formula_refs($ast['operand'], $out);
    elseif ($ast['type'] === 'binop') {
        _penumbra_collect_formula_refs($ast['left'], $out);
        _penumbra_collect_formula_refs($ast['right'], $out);
    }
}

function penumbra_resolve_summary_formula($colName) {
    if (!isset($GLOBALS['penumbra_summary_formulas']) || !is_array($GLOBALS['penumbra_summary_formulas'])) return '';
    $key = strtoupper((string)$colName);
    foreach ($GLOBALS['penumbra_summary_formulas'] as $k => $v) {
        if (strtoupper((string)$k) === $key) return (string)$v;
    }
    return '';
}

function _penumbra_formula_var_type($var) {
    switch ($var) {
        case 'count':  return 'count';
        case 'filled': return 'count_filled';
        case 'blank':  return 'count_blank';
        case 'unique': return 'count_unique';
        default:       return $var;   // sum avg median min max range stddev
    }
}

function penumbra_group_agg_registry_type($t) {
    if ($t === 'count') return 'count_filled';
    if ($t === 'count_distinct') return 'count_unique';
    return $t;
}

function penumbra_is_toggle_column($name) {
    return strpos(strtoupper((string)$name), '__JOURNAL_TOGGLE__') === 0;
}

function penumbra_compute_summary($values, $type, $isToggle = false, $formulaExpr = '') {
    $types = penumbra_summary_types();
    if (!isset($types[$type])) return null;
    $def = $types[$type];

    // A custom formula is computed from this column's own aggregates, so it is
    // just another summary type - no ordering, no second pass, no cross-column
    // context. Mirrors the 'formula' branch of penumbraSummaryAccumulator().
    if ($type === 'formula') {
        $ast = penumbra_parse_summary_formula($formulaExpr);
        if ($ast === null) return null;   // empty or invalid expression
        $agg = array();
        foreach (array('sum','count','filled','blank','unique','min','max','avg','median','range','stddev') as $k) {
            $r = penumbra_compute_summary($values, _penumbra_formula_var_type($k), $isToggle);
            $agg[$k] = ($r === null) ? 0 : (is_numeric($r['value']) ? (float)$r['value'] : 0);
        }
        $v = pivot_eval_formula($ast, $agg);
        if ($v === null || !is_finite((float)$v)) return null;
        // Precision/currency come from the column's own cells, same as any
        // other numeric summary.
        $probe = penumbra_compute_summary($values, 'sum', $isToggle);
        return array(
            'kind' => 'num', 'value' => (float)$v,
            'decimals'   => ($probe === null) ? 0 : $probe['decimals'],
            'isCurrency' => ($probe === null) ? false : $probe['isCurrency'],
            'isPercent'  => ($probe === null) ? false : $probe['isPercent']
        );
    }

    // A journal toggle column holds the strings '1'/'0'. For the two counting
    // types an unticked box must read as BLANK, so that "Count Non-Blank" means
    // CHECKED and "Count Blank" means UNCHECKED - what those labels obviously
    // promise on a checkbox column. Left alone, '0' is a perfectly non-blank
    // string and both counts degenerate (every row, and none).
    //
    // Scoped to those two types only: the value stays '1'/'0' everywhere else,
    // so Total is still the checked count and Average the proportion. Mirrors
    // penumbraSummaryAccumulator()'s toggleBlankZero in js/main.js.
    $toggleBlankZero = ($isToggle && ($type === 'count_filled' || $type === 'count_blank'));

    $n = count($values);
    $filled = array();
    foreach ($values as $v) {
        $sv = trim((string)$v);
        if ($sv === '') continue;
        if ($toggleBlankZero && $sv === '0') continue;
        $filled[] = (string)$v;
    }

    if ($type === 'count')        return array('kind' => 'int', 'value' => $n);
    if ($type === 'count_filled') return array('kind' => 'int', 'value' => count($filled));
    if ($type === 'count_blank')  return array('kind' => 'int', 'value' => $n - count($filled));
    if ($type === 'count_unique') {
        $seen = array();
        foreach ($filled as $v) $seen[trim($v)] = 1;
        return array('kind' => 'int', 'value' => count($seen));
    }

    if ($type === 'mode' || $type === 'antimode') {
        if (empty($filled)) return null;
        $freq = array();
        $order = array();
        foreach ($filled as $v) {
            $t = trim($v);
            if (!isset($freq[$t])) { $freq[$t] = 0; $order[] = $t; }
            $freq[$t]++;
        }
        $best = $order[0];
        for ($i = 1; $i < count($order); $i++) {
            // Ties keep the FIRST value seen - same rule as the browser, which
            // walks the rows in this same order, so the two agree.
            if ($type === 'mode' ? ($freq[$order[$i]] > $freq[$best]) : ($freq[$order[$i]] < $freq[$best])) {
                $best = $order[$i];
            }
        }
        return array('kind' => 'text', 'value' => $best);
    }

    // Date-aware min/max: compare by timestamp, display the original text.
    // Strict parse against the browser's own format list - see
    // _penumbra_summary_parse_date() for what this replaced and why.
    if (!empty($def['dateAware']) && !empty($filled)) {
        // The FIRST non-blank value decides whether this is a date column;
        // after that, unparseable values are SKIPPED. Requiring EVERY value to
        // parse meant a single "N/A" or "TBD" anywhere in the column produced no
        // date result at all, and the remaining date strings then failed the
        // numeric parse too - a blank footer cell. Mirrors the browser
        // accumulator's rule exactly.
        $bestTs = null;
        $bestText = null;
        $seen = 0;
        foreach ($filled as $v) {
            $s = trim($v);
            $ts = _penumbra_summary_parse_date($s);
            if ($ts === false) {
                if ($seen > 0) continue;   // established date column: ignore the stray
                break;                      // first value isn't a date -> not a date column
            }
            $seen++;
            if ($bestTs === null || ($type === 'min' ? $ts < $bestTs : $ts > $bestTs)) {
                $bestTs = $ts;
                $bestText = $s;
            }
        }
        if ($seen > 0 && $bestTs !== null) {
            return array('kind' => 'date', 'value' => $bestTs, 'text' => $bestText);
        }
    }

    $nums = array();
    $decimals = 0;
    $isCurrency = false;
    $isPercent = false;
    foreach ($filled as $raw) {
        $num = _penumbra_summary_clean_number($raw);
        if ($num === false) continue;
        $nums[] = $num;
        if (strpos($raw, '$') !== false) $isCurrency = true;
        if (strpos($raw, '%') !== false) $isPercent = true;
        // Decimals from cells that actually PARSED, matching the browser. The
        // caller's column-wide '.' sniff counted dots in non-numeric cells too,
        // so a stray "note.99" or a millisecond timestamp inflated a money
        // column's precision.
        $dLen = _penumbra_summary_decimals($raw);
        if ($dLen > $decimals) $decimals = $dLen;
    }
    if (empty($nums)) return null;

    $cnt = count($nums);
    switch ($type) {
        case 'sum':    $val = array_sum($nums); break;
        case 'avg':    $val = array_sum($nums) / $cnt; break;
        case 'min':    $val = min($nums); break;
        case 'max':    $val = max($nums); break;
        case 'range':  $val = max($nums) - min($nums); break;
        case 'median':
            $s = $nums;
            sort($s);
            $mid = (int)floor($cnt / 2);
            $val = ($cnt % 2 === 0) ? (($s[$mid - 1] + $s[$mid]) / 2) : $s[$mid];
            break;
        case 'stddev':
            if ($cnt < 2) return null;   // one row has no spread to report
            $mean = array_sum($nums) / $cnt;
            $ss = 0.0;
            foreach ($nums as $x) $ss += ($x - $mean) * ($x - $mean);
            $val = sqrt($ss / ($cnt - 1));   // sample stddev, matching the browser
            break;
        default: return null;
    }
    return array(
        'kind' => 'num', 'value' => $val, 'decimals' => $decimals,
        'isCurrency' => $isCurrency, 'isPercent' => $isPercent
    );
}

function penumbra_format_summary($result, $type, $isCurrencyCol, $maxDec) {
    if ($result === null) return '';
    if ($result['kind'] === 'date') return $result['text'];
    if ($result['kind'] === 'text') return $result['value'];
    if ($result['kind'] === 'int')  return number_format($result['value']);

    $val = $result['value'];
    if (!is_finite($val)) return '';   // never emit "inf"/"nan" into an email
    $isCurrency = $isCurrencyCol || !empty($result['isCurrency']);

    // Precision comes from the RESULT (cells that parsed), not the caller's
    // column-wide sniff - see the note in penumbra_compute_summary(). $maxDec is
    // kept only as a fallback for a caller that has no result-level figure.
    $srcDec = isset($result['decimals']) ? $result['decimals'] : $maxDec;
    $dec = min($srcDec, 2);
    // Currency shows CENTS - but only when the column actually HAS cents.
    // Browser twin: penumbraFormatSummary() in js/main.js. Forcing 2dp
    // unconditionally invented a precision the source never had, so a column
    // formatted as whole dollars mailed a footer of "$10.00" under cells and a
    // group header both reading "$10".
    if ($isCurrency && $srcDec > 0) $dec = 2;
    // 'formula' included for the same reason as the others: the result is
    // DERIVED, not a member of the column, so it needs decimals even when the
    // source cells have none (a ratio like {blank}/{count} is otherwise "0").
    if ($type === 'avg' || $type === 'median' || $type === 'stddev' || $type === 'formula') $dec = max($dec, 2);

    // Round like the browser BEFORE formatting - see the function's notes.
    $val = _penumbra_summary_round_like_intl($val, $dec);
    if ($isCurrency) {
        // abs() first: number_format(-300.25) is "-300.25", we want "($300.25)"
        $body = number_format(abs($val), $dec);
        return ($val < 0) ? '($' . $body . ')' : '$' . $body;
    }
    $fmt = number_format($val, $dec);
    if (!empty($result['isPercent']) && $type !== 'sum') $fmt .= '%';
    return $fmt;
}

function penumbra_summary_header_label($typesUsed) {
    $types = penumbra_summary_types();
    $uniq = array_values(array_unique(array_filter($typesUsed, 'strlen')));
    if (count($uniq) === 1 && isset($types[$uniq[0]])) return $types[$uniq[0]]['header'];
    return 'SUMMARY';
}

function penumbra_summary_badge_html($type, $colName = '') {
    // The report's SHOW toggle (STATE_DATA.summaryBadges). Absent = on, so a
    // report that never touched it keeps its badges. A viewer's own browser-side
    // toggle cannot reach here - same boundary as the summaries themselves.
    if (isset($GLOBALS['penumbra_summary_badges']) && $GLOBALS['penumbra_summary_badges'] === false) return '';
    $types = penumbra_summary_types();
    if (!isset($types[$type])) return '';
    $def = $types[$type];
    // Surface a custom formula's actual expression on hover, matching the
    // browser - "Custom Formula" alone says nothing about what was computed.
    $tip = $def['label'];
    if ($type === 'formula') {
        $fx = penumbra_resolve_summary_formula($colName);
        if ($fx !== '') $tip .= ': ' . $fx;
    }
    return ' <span style="font-size:8px;font-weight:bold;letter-spacing:0.4px;opacity:0.7;'
         . 'padding:0 3px;border-radius:2px;background-color:rgba(0,0,0,0.08);white-space:nowrap;" title="'
         . htmlspecialchars($tip, ENT_QUOTES) . '">'
         . htmlspecialchars($def['badge'], ENT_QUOTES) . '</span>';
}

function penumbra_summary_column_stats($rows, $headers = null) {
    $stats = array('currency' => array(), 'commas' => array(), 'decimals' => array(), 'values' => array());
    foreach ($rows as $r) {
        // Iterate the HEADER list, not the row's own keys. Keyed off the row, a
        // row missing a column contributed NO entry, so that column's value
        // array was shorter than the row count and `count` / `count blank`
        // under-reported - two columns in one footer could even disagree about
        // how many rows there were. (The XLSX builder is positional and was
        // never affected, so the two would also have disagreed with each other.)
        $keys = ($headers !== null) ? $headers : array_keys($r);
        foreach ($keys as $k) {
            $v = isset($r[$k]) ? $r[$k] : '';
            // Arrays would raise "Array to string conversion" per cell and store
            // the literal "Array"; the runner logs at E_ALL so that is a flood.
            $valStr = is_array($v) ? '' : (string)$v;
            // Strip the @@HTML / @@JSON sentinels and markup the same way every
            // other cell in the output is cleaned. Without this, mode/antimode
            // printed the raw '@@HTML<a href="#">Alpha</a>' and a date column
            // stored as @@HTML failed to parse at all, blanking min/max.
            if ($valStr !== '' && (substr($valStr, 0, 6) === '@@HTML' || substr($valStr, 0, 6) === '@@JSON'
                                   || strpos($valStr, '<') !== false)) {
                $valStr = pivot_clean_field_value($valStr);
            }
            $stats['values'][$k][] = $valStr;
            if (strpos($valStr, '$') !== false) $stats['currency'][$k] = true;
            if (strpos($valStr, ',') !== false) $stats['commas'][$k] = true;
            if (strpos($valStr, '.') !== false) {
                $dotParts = explode('.', str_replace(array('$', ',', '(', ')'), '', $valStr));
                if (count($dotParts) === 2) {
                    $decLen = strlen(preg_replace('/[^0-9]/', '', $dotParts[1]));
                    if (!isset($stats['decimals'][$k]) || $decLen > $stats['decimals'][$k]) {
                        $stats['decimals'][$k] = $decLen;
                    }
                }
            }
        }
    }
    return $stats;
}

function renderTotalRow($rows, $headers, $style, $summaryConfig = null) {
    global $total_exemptions;
    if (empty($rows)) return '';

    $stats = penumbra_summary_column_stats($rows, $headers);
    $is_currency_col = $stats['currency'];
    $summaryTypes = penumbra_resolve_summaries($headers, $is_currency_col, $summaryConfig);

    // Compute first: a column can be configured yet still produce nothing (all
    // blank, no numbers, stddev over one row), and an empty footer should not be
    // emitted at all - matching the old "no totals to show" bail.
    $results = array();
    $typesShown = array();
    foreach ($summaryTypes as $h => $type) {
        $vals = isset($stats['values'][$h]) ? $stats['values'][$h] : array();
        $res = penumbra_compute_summary($vals, $type, penumbra_is_toggle_column($h), penumbra_resolve_summary_formula($h));
        if ($res === null) continue;
        $results[$h] = $res;
        $typesShown[] = $type;
    }
    if (empty($typesShown)) return '';

    $label = penumbra_summary_header_label($typesShown);

    // Where the keyword goes: the first column that has NO summary of its own.
    //
    // This used to be hard-coded to the first column, whatever it was. Unlike
    // the browser - which owns a dedicated '#' row-number cell to put it in -
    // the server's $headers starts at the first DATA column, so a summary on
    // that column was silently overwritten by the word "TOTALS" and never
    // reached the email. Harmless while only whitelisted columns could total;
    // now that any column can carry a summary it is a live browser/email
    // divergence. Matches generateTotalRow()'s relocation rule.
    $labelCol = null;
    foreach ($headers as $h) {
        if (!isset($results[$h])) { $labelCol = $h; break; }
    }
    // No free column - EVERY visible column carries a summary. The browser
    // always has its dedicated '#' row-number cell to put the keyword in; the
    // server's $headers starts at the first data column, so without this the
    // email footer came out completely unlabelled while the browser showed
    // TOTALS/SUMMARY. Prefix it onto the first cell instead of dropping it: on a
    // mixed-type footer the keyword is the only thing identifying the row.
    $labelPrefix = '';
    if ($labelCol === null) {
        $labelPrefix = '<span style="opacity:0.75;padding-right:6px;white-space:nowrap;">'
                     . htmlspecialchars($label, ENT_QUOTES) . '</span>';
    }

    $html = '<tfoot><tr>';
    foreach ($headers as $h) {
        if ($labelCol !== null && $h === $labelCol) {
            // nowrap: the keyword can now be a longer word than "TOTALS"
            // (STD DEVS, NON-BLANK), and wrapping doubles the footer height.
            $html .= '<td style="' . $style . 'white-space:nowrap;">' . htmlspecialchars($label, ENT_QUOTES) . '</td>';
            $labelCol = null;   // place it once
            continue;
        }

        if (isset($results[$h])) {
            $type = $summaryTypes[$h];
            $fmt = penumbra_format_summary(
                $results[$h],
                $type,
                !empty($is_currency_col[$h]),
                isset($stats['decimals'][$h]) ? $stats['decimals'][$h] : 0
            );
            $html .= '<td style="' . $style . '">' . $labelPrefix . htmlspecialchars($fmt, ENT_QUOTES)
                   . penumbra_summary_badge_html($type, $h) . '</td>';
            $labelPrefix = '';   // first summarized cell only
        } else {
            $html .= '<td style="' . $style . '"></td>';
        }
    }
    $html .= '</tr></tfoot>';
    return $html;
}

function _renderPdfTotalRow($rows, $headers, $style, $bgColor, $colWidths = null, $summaryConfig = null) {
    global $total_exemptions;
    if (empty($rows)) return '';

    // Same engine as renderTotalRow() - this builder differs only in markup
    // (bgcolor attribute + explicit widths for TCPDF), never in the numbers.
    $stats = penumbra_summary_column_stats($rows, $headers);
    $is_currency_col = $stats['currency'];
    $summaryTypes = penumbra_resolve_summaries($headers, $is_currency_col, $summaryConfig);

    $results = array();
    $typesShown = array();
    foreach ($summaryTypes as $h => $type) {
        $vals = isset($stats['values'][$h]) ? $stats['values'][$h] : array();
        $res = penumbra_compute_summary($vals, $type, penumbra_is_toggle_column($h), penumbra_resolve_summary_formula($h));
        if ($res === null) continue;
        $results[$h] = $res;
        $typesShown[] = $type;
    }
    if (empty($typesShown)) return '';

    $label = penumbra_summary_header_label($typesShown);

    // First column with no summary of its own - see renderTotalRow() for why
    // this is not simply the first column.
    $labelCol = null;
    foreach ($headers as $h) {
        if (!isset($results[$h])) { $labelCol = $h; break; }
    }

    $html = '<tfoot><tr>';
    $ci = 0;
    // Add background-color CSS alongside bgcolor attribute for TCPDF reliability
    $bgStyle = " background-color: {$bgColor};";
    foreach ($headers as $h) {
        $wAttr = ($colWidths && isset($colWidths[$ci])) ? " width=\"{$colWidths[$ci]}%\"" : "";
        if ($labelCol !== null && $h === $labelCol) {
            $lbl = htmlspecialchars($label, ENT_QUOTES);
            $html .= "<td style=\"{$style}{$bgStyle} white-space:nowrap;\" bgcolor=\"{$bgColor}\"{$wAttr}>{$lbl}</td>";
            $labelCol = null;   // place it once
            $ci++;
            continue;
        }

        if (isset($results[$h])) {
            $type = $summaryTypes[$h];
            $fmt = htmlspecialchars(penumbra_format_summary(
                $results[$h],
                $type,
                !empty($is_currency_col[$h]),
                isset($stats['decimals'][$h]) ? $stats['decimals'][$h] : 0
            ), ENT_QUOTES);
            $badge = penumbra_summary_badge_html($type, $h);
            $html .= "<td style=\"{$style}{$bgStyle}\" bgcolor=\"{$bgColor}\"{$wAttr}>{$fmt}{$badge}</td>";
        } else {
            $html .= "<td style=\"{$style}{$bgStyle}\" bgcolor=\"{$bgColor}\"{$wAttr}></td>";
        }
        $ci++;
    }
    $html .= '</tr></tfoot>';
    return $html;
}

function pivot_clean_field_value($val) {
    if ($val === null) return '';
    $str = (string)$val;
    if (strpos($str, '@@HTML') === 0) {
        $str = substr($str, 6);
        $str = strip_tags($str);
    } elseif (strpos($str, '@@JSON') === 0) {
        $str = substr($str, 6);
        // Try to decode JSON into a readable string
        $decoded = json_decode($str, true);
        if ($decoded !== null) {
            if (is_array($decoded)) {
                // Flatten JSON to a comma-separated key=value string
                $parts = array();
                foreach ($decoded as $k => $v) {
                    $parts[] = $k . '=' . (is_array($v) ? json_encode($v) : (string)$v);
                }
                $str = implode(', ', $parts);
            } else {
                $str = (string)$decoded;
            }
        }
    }
    // Decode HTML entities (e.g. &amp; → &)
    $str = html_entity_decode($str, ENT_QUOTES, 'UTF-8');
    return trim($str);
}

function pivot_parse_value($rawVal) {
    if ($rawVal === null || $rawVal === '') return false;
    $str = trim((string)$rawVal);
    if ($str === '') return false;

    // Strip @@HTML prefix and HTML tags
    if (strpos($str, '@@HTML') === 0) {
        $str = substr($str, 6);
        $str = strip_tags($str);
        $str = trim($str);
    }
    // Strip @@JSON prefix
    if (strpos($str, '@@JSON') === 0) {
        $str = substr($str, 6);
        $str = trim($str);
    }

    // Delegate the numeric parse to the byte-exact mirror of the browser's
    // parseAccountingNumber rather than keeping a fourth copy of the rules.
    //
    // This used to be is_numeric(), which differs from the browser in ways a
    // pivot silently depends on: is_numeric() accepts SCIENTIFIC NOTATION, so
    // '1e3' summed as 1000 in a scheduled email and was skipped as non-numeric
    // on screen; and it left '%' in place, so a percent cell aggregated in the
    // browser and dropped out of the emailed total. _penumbra_summary_clean_number
    // strips `[$,()%\x02]` and validates the whole string against the browser's
    // own regex - accounting-paren negatives included, so the $isNegative sniff
    // above is handled there too.
    //
    // Deliberately NOT parse_accounting_number(): that one is shared with sort
    // and conditional formatting, and changing it would move sort order and
    // format thresholds across the whole app.
    return _penumbra_summary_clean_number($str);
}

