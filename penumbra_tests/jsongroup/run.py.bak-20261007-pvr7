def run_page(scn):
    t = jget('/json/new?about:blank', 'PUT')
    ws = websocket.create_connection(t['webSocketDebuggerUrl'], timeout=300, suppress_origin=True)
    n = [0]
    def call(method, params=None):
        n[0] += 1; mid = n[0]
        ws.send(json.dumps({'id': mid, 'method': method, 'params': params or {}}))
        while True:
            m = json.loads(ws.recv())
            if m.get('id') == mid: return m.get('result', {})
    try:
        call('Page.enable')
        # Every build is written to the same c/main_jg.js: never let the browser serve a
        # cached copy (heuristic freshness once handed a mutant the previous build).
        call('Network.enable')
        call('Network.setCacheDisabled', {'cacheDisabled': True})
        call('Page.navigate', {'url': 'http://127.0.0.1:%d/c/harness.html?scn=%s' % (hp, scn)})
        t0 = time.time()
        while time.time() - t0 < 180:
            time.sleep(0.25)
            try:
                r = call('Runtime.evaluate', {'expression': 'window.__JGDONE ? JSON.stringify(window.__JGRESULT) : null', 'returnByValue': True})
                v = r.get('result', {}).get('value')
                if v: return json.loads(v)
            except Exception:
                pass
        return {'fatal': 'timeout waiting for the scenario (180 s)'}
    finally:
        try: ws.close()
        except Exception: pass
        try: urllib.request.urlopen('http://127.0.0.1:%d/json/close/%s' % (dp, t['id']), timeout=10).read()
        except Exception: pass

def run_suite(text, scns):
    write_build(text)
    res, obs = [], {}
    for s in scns:
        r = run_page(s)
        if r.get('fatal'):
            res.append(('F-' + s, False, 'fatal: ' + str(r['fatal'])[:400])); continue
        if r.get('missing') or r.get('hookErr'):
            res.append(('H-' + s, False, 'hook: missing %s %s' % (r.get('missing'), r.get('hookErr'))))
        for a in r.get('asserts', []):
            res.append((a['id'], a['ok'], a['detail']))
        res.append(('E-' + s, not r.get('errors'), 'page errors: %s' % (r.get('errors') or 'none')))
        obs[s] = r.get('obs', {})
    return res, obs

try:
    scns = scn_arg.split(',') if scn_arg else ALL_SCN
