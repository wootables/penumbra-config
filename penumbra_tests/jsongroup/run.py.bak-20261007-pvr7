                good = not red
                msg = 'equivalent layer: all GREEN, as documented' if good else 'NOT equivalent - red: %s' % ' '.join(red)
            ok_n += good; bad_n += (not good)
            print('  %s  mutant %-13s %s' % ('PASS' if good else 'FAIL', name, msg), flush=True)
        print('SUMMARY mutants ok=%d bad=%d' % (ok_n, bad_n))
        print('RESULT: GREEN' if bad_n == 0 else 'RESULT: RED')
    else:
        res, obs = run_suite(hook(cand_src), scns)
        p = f = 0; failed = []
        for aid, ok, detail in res:
            print('  %s  %-24s %s' % ('PASS' if ok else 'FAIL', aid, detail[:300]), flush=True)
            if ok: p += 1
            else: f += 1; failed.append(aid)
        for s in scns:
            o = obs.get(s) or {}
            keep_keys = [k for k in ('flatHead', 'groups', 'orderShown', 'orderMonotonic', 'orderByLoose', 'looseTotals') if k in o]
