def run_page(scn):
    t = jget('/json/new?about:blank', 'PUT')
    ws = websocket.create_connection(t['webSocketDebuggerUrl'], timeout=300, suppress_origin=True)
    n = [0]
    def call(m, p=None):
        n[0] += 1; mid = n[0]
        ws.send(json.dumps({'id': mid, 'method': m, 'params': p or {}}))
        while True:
            r = json.loads(ws.recv())
            if r.get('id') == mid: return r.get('result', {})
    try:
        # Every build is written to the same main_hc.js: never let the browser
        # serve a cached copy (heuristic freshness once handed a mutant the
        # previous build - the lazyrows trap, 2026-09-30).
        call('Network.enable')
        call('Network.setCacheDisabled', {'cacheDisabled': True})
        call('Page.navigate', {'url': 'http://127.0.0.1:%d/harness.html?scn=%s' % (hp, scn)})
        t0 = time.time()
        while time.time() - t0 < 300:
            time.sleep(0.25)
            v = call('Runtime.evaluate', {'expression': 'window.__HCDONE ? JSON.stringify(window.__HCRESULT) : null', 'returnByValue': True}).get('result', {}).get('value')
            if v: return json.loads(v)
        return {'fatal': 'timeout (300 s)'}
    finally:
        try: ws.close()
        except Exception: pass
        try: urllib.request.urlopen('http://127.0.0.1:%d/json/close/%s' % (dp, t['id']), timeout=10).read()
        except Exception: pass

def run_build(text, scns):
    open(os.path.join(stage, 'main_hc.js'), 'wb').write(hook(text).encode('utf-8', 'surrogateescape'))
    out = {}
    for s in scns:
        r = run_page(s)
        if r.get('fatal') and 'never finished loading' in r['fatal']:
            r = run_page(s); r['retried'] = True
        out[s] = r
    return out

def first_diff(a, b):
    a = json.dumps(a, sort_keys=True); b = json.dumps(b, sort_keys=True)
    n = min(len(a), len(b)); i = 0
    while i < n and a[i] == b[i]: i += 1
    return 'at %d: base %r / cand %r' % (i, a[max(0, i - 60):i + 120], b[max(0, i - 60):i + 120])

def evaluate(base, cand, scns):
    out = []
    add = lambda aid, ok, d: out.append((aid, bool(ok), d))
    for s in scns:
        r, b = cand.get(s, {}), base.get(s, {})
        if r.get('fatal') or b.get('fatal'):
            add('F-' + s, False, 'cand: %s | base: %s' % ((r.get('fatal') or '')[:300], (b.get('fatal') or '')[:300])); continue
        fr, fb = r.get('same', {}), b.get('same', {})
        bad = [k for k in sorted(set(fr) | set(fb)) if fr.get(k) != fb.get(k)]
        add('D-' + s, bool(fr) and not bad, ('identical (%s)' % ','.join(sorted(fr))) if not bad else ('DIFFER in %s: %s' % (','.join(bad), first_diff(fb.get(bad[0]), fr.get(bad[0])))))
        add('E-' + s, not r.get('errors') and not b.get('errors') and not r.get('hookErr') and not r.get('missing'),
            'cand %s %s %s | base %s' % (r.get('errors'), r.get('hookErr'), r.get('missing'), b.get('errors')))
        for c in CHK.get(s, []):
            v = (r.get('chk') or {}).get(c)
            add('L-%s-%s' % (s, c), v is True, 'cand %s (base %s)%s' % (v, (b.get('chk') or {}).get(c),
                ('; info cand %s | base %s' % (json.dumps(r.get('info'))[:300], json.dumps(b.get('info'))[:300])) if v is not True else ''))
        info = r.get('info') or {}
        if s in ('npdf', 'pdflist', 'nlist', 'countlist'):
            add('I-' + s, True, 'cand %s | base %s' % (json.dumps(info)[:260], json.dumps(b.get('info') or {})[:260]))
    return out

try:
    base_text, cand_text = read_b(base_path), read_b(cand_path)
