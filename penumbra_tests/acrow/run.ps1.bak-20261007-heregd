# =============================================================================
# acrow (2026-10-01) - the Visual Search Builder's value list: the whole row is
# ONE checkbox, the selection settles when the list closes. The suite itself is
# run.py (headless Edge over CDP, trusted mouse / key events); see its header
# for the asserts and mutants. This wrapper only forwards the parameters.
#
# UNC .ps1 files are blocked by policy: run the BODY as a scriptblock, one run
# per PowerShell call, output to a file:
#   $d='\\oitras.oit.ncsu.edu\d$\Utilities\PHP_8.2-p\penumbra_tests\acrow'
#   & ([scriptblock]::Create([IO.File]::ReadAllText("$d\run.ps1"))) -Js <stage>\search_builder.js -Css <stage>\search_builder.css -Help <stage>\help_content.php *>&1 | Out-File "$d\run.log"
#   ... -Control          the build before the change (live, or the .bak-*-acrow files after the deploy)
#   ... -Control5         the build before round 5 (-Js/-Css/-Help if given, else live, else the .bak-*-acrow5 files)
#   ... -Only a,b         just those scenarios, raw observations, no asserts (development)
#   ... -Mutants          every mutant of the candidate (66, ~5.5 h)   ... -Mutant <name>   one of them (~5 min)
# No parameters = the LIVE files. Prints "RESULT: GREEN" / "RESULT: RED"; the
# summary also lands in summary*.txt in this folder.
# =============================================================================
param([string]$Js = '', [string]$Css = '', [string]$Help = '', [string]$Mutant = '', [switch]$Mutants, [switch]$Control, [switch]$Explore,
      [switch]$Control5, [string]$Only = '')
$here = $PSScriptRoot
if (-not $here) { $here = '\\oitras.oit.ncsu.edu\d$\Utilities\PHP_8.2-p\penumbra_tests\acrow' }
$pyArgs = @('-3', "$here\run.py")
if ($Js)      { $pyArgs += @('--js', $Js) }
if ($Css)     { $pyArgs += @('--css', $Css) }
if ($Help)    { $pyArgs += @('--help-php', $Help) }
if ($Control) { $pyArgs += '--control' }
if ($Control5) { $pyArgs += '--control5' }
if ($Only)    { $pyArgs += @('--only', $Only) }
if ($Mutants) { $pyArgs += '--mutants' }
if ($Mutant)  { $pyArgs += @('--mutant', $Mutant) }
if ($Explore) { $pyArgs += '--explore' }
# A local working directory: run.py stages into %TEMP% and needs no UNC cwd.
Push-Location $env:TEMP
try { & py @pyArgs } finally { Pop-Location }
