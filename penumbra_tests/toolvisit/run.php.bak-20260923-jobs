class FakeDb {
    static $reports = array();   // id => row (SHORT_ID space-padded, like the CHAR column)
    static $audit = array();
    static $inserts = array();
    static $queries = array();
    static $nextReportId = 500;
    static $nextAuditId = 9000;
    static $failSelect = false;
    static $failInsert = false;
    static $raceOnInsert = false;
    static $failAudit = false;
    static function reset() {
        self::$reports = array(10 => array('SHORT_ID' => str_pad('budget_summary', 20), 'TITLE' => 'Budget'));
        self::$audit = array(); self::$inserts = array(); self::$queries = array();
        self::$nextReportId = 500; self::$nextAuditId = 9000;
        self::$failSelect = self::$failInsert = self::$raceOnInsert = self::$failAudit = false;
    }
    static function idsFor($sid) {
        $out = array();
        foreach (self::$reports as $id => $r) { if (trim($r['SHORT_ID']) === $sid) $out[] = $id; }
        return $out;
    }
}
function queryViaOci8($sql, $binds = array(), $callTimeoutMs = 0, $memBudgetBytes = 0) {
    FakeDb::$queries[] = $sql;
    if (FakeDb::$failSelect) throw new Exception('fake: ORA-03113 end-of-file on communication channel');
    if (preg_match('/^SELECT MIN\(ID\) AS ID FROM PENUMBRA_REPORTS WHERE TRIM\(SHORT_ID\) = :sid$/', $sql)) {
        $ids = FakeDb::idsFor($binds[':sid']);
        return array(array('ID' => empty($ids) ? null : (string)min($ids)));
    }
    if (preg_match('/^SELECT ID FROM PENUMBRA_REPORTS WHERE TRIM\(SHORT_ID\) IN \((.*)\)$/', $sql, $m)) {
        preg_match_all("/'([^']*)'/", $m[1], $mm);
        $out = array();
        foreach (FakeDb::$reports as $id => $r) { if (in_array(trim($r['SHORT_ID']), $mm[1], true)) $out[] = array('ID' => (string)$id); }
        return $out;
    }
    throw new Exception('FakeDb: unexpected SQL: ' . $sql);
}
function execClobInsert($pdoConn, $table, $cols, $clobCols, $rawCols = array(), $returnIdCol = null) {
    FakeDb::$inserts[] = array('table' => $table, 'cols' => $cols, 'clob' => $clobCols, 'raw' => $rawCols, 'ret' => $returnIdCol);
    if ($table !== 'PENUMBRA_REPORTS') throw new Exception('FakeDb: unexpected insert into ' . $table);
    if (FakeDb::$raceOnInsert) {
        // Another first visitor committed the row between our lookup and our insert.
        FakeDb::$reports[FakeDb::$nextReportId++] = array('SHORT_ID' => str_pad($cols['SHORT_ID'], 20), 'TITLE' => $cols['TITLE']);
        throw new Exception('fake: ORA-00001 unique constraint violated');
    }
    if (FakeDb::$failInsert) throw new Exception('fake: ORA-01031 insufficient privileges');
    $id = FakeDb::$nextReportId++;
    FakeDb::$reports[$id] = array('SHORT_ID' => str_pad($cols['SHORT_ID'], 20), 'TITLE' => $cols['TITLE']);
    return $returnIdCol !== null ? $id : null;
}
function logPenumbraAudit($report_id, $action, $before_json, $after_json, $message = null, $extra_source = null) {
    if (FakeDb::$failAudit) throw new Exception('fake: audit insert failed');
    $id = FakeDb::$nextAuditId++;
    FakeDb::$audit[] = array('id' => $id, 'report_id' => $report_id, 'action' => $action, 'before' => $before_json,
                             'after' => $after_json, 'message' => $message, 'user' => $GLOBALS['currentUserKey']);
    return $id;
}

