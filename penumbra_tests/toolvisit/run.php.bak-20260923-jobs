section('7. page emitter');
// ---------------------------------------------------------------------------
$emit = function ($method, $tool, $sid = '') {
    if ($method === null) { unset($_SERVER['REQUEST_METHOD']); } else { $_SERVER['REQUEST_METHOD'] = $method; }
    ob_start(); penumbra_tool_visit_beacon($tool, $sid); return ob_get_clean();
};
$html = $emit('GET', 'health');
t_ok(strpos($html, '<script>') === 0 && substr_count($html, '</script>') === 1, 'GET render emits one script block');
t_ok(strpos($html, "navigator.sendBeacon('log_tool_visit.php'") !== false, 'posts with sendBeacon to log_tool_visit.php');
t_ok(strpos($html, "x.open('POST', 'log_tool_visit.php', true)") !== false, 'XHR fallback posts to the same endpoint');
t_ok(strpos($html, 'window.__pnbToolVisitSent') !== false, 'once-per-page guard present');
t_ok(preg_match('/encodeURIComponent\("([A-Za-z0-9_\-]+\.[0-9a-f]{64})"\)/', $html, $em) === 1, 'token embedded as a JSON string');
t_eq(isset($em[1]) ? penumbraToolVisitVerify($em[1]) : null, array('tool' => 'health', 'short_id' => ''), 'embedded token verifies for this user');
t_ok(preg_match('/=>|`|\blet\s|\bconst\s/', $html) === 0, 'emitted JS is ES5 (no arrows, template literals, let, const)');
t_eq($emit('POST', 'health'), '', 'POST re-render emits nothing');
t_eq($emit('HEAD', 'health'), '', 'HEAD emits nothing');
t_eq($emit(null, 'health'), '', 'no request method (CLI) emits nothing');
t_eq($emit('GET', 'nope'), '', 'unknown tool emits nothing');
t_eq($emit('GET', 'report_metrics', ''), '', 'report metrics without a report id emits nothing');
$currentUserKey = '';
t_eq($emit('GET', 'health'), '', 'no identity (health-key monitor) emits nothing');
$currentUserKey = 'bplimon';
$htmlRm = $emit('GET', 'report_metrics', 'budget_summary');
t_ok(preg_match('/encodeURIComponent\("([^"]+)"\)/', $htmlRm, $em2) === 1 && penumbraToolVisitVerify($em2[1]) === array('tool' => 'report_metrics', 'short_id' => 'budget_summary'), 'report metrics page embeds its report id');

