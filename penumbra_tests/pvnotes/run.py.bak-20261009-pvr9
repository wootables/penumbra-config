# A TRUSTED key press, asked for by the page (window.__wantKeys = ['Escape']).
KEYS = {' ': ('Space', 32, ' '), 'Tab': ('Tab', 9, None), 'Enter': ('Enter', 13, '\r'), 'Escape': ('Escape', 27, None)}
def press(call, key):
    code, vk, text = KEYS[key]
    down = {'type': 'keyDown', 'key': key, 'code': code, 'windowsVirtualKeyCode': vk, 'nativeVirtualKeyCode': vk}
    if text: down['text'] = text
    call('Input.dispatchKeyEvent', down)
    call('Input.dispatchKeyEvent', {'type': 'keyUp', 'key': key, 'code': code, 'windowsVirtualKeyCode': vk, 'nativeVirtualKeyCode': vk})

def run_page(scn):
    t = jget('/json/new?about:blank', 'PUT')
    ws = websocket.create_connection(t['webSocketDebuggerUrl'], timeout=300, suppress_origin=True)
    n = [0]
    def call(m, p=None):
        n[0] += 1; mid = n[0]
        ws.send(json.dumps({'id': mid, 'method': m, 'params': p or {}}))
        while True:
            r = json.loads(ws.recv())
            if r.get('id') == mid: return r.get('result', {})
    try:
        call('Network.enable')
        call('Network.setCacheDisabled', {'cacheDisabled': True})   # every build is written to the same file names
        call('Emulation.setFocusEmulationEnabled', {'enabled': True})
        call('Page.navigate', {'url': 'http://127.0.0.1:%d/harness.html?id=pvfix&scn=%s' % (hp, scn)})
        t0 = time.time()
        while time.time() - t0 < 180:
            time.sleep(0.25)
            k = call('Runtime.evaluate', {'expression': '(window.__wantKeys && !window.__keysSent) ? JSON.stringify(window.__wantKeys) : null', 'returnByValue': True}).get('result', {}).get('value')
            if k:
                for key in json.loads(k): press(call, key)
                call('Runtime.evaluate', {'expression': 'window.__keysSent = true'})
            hv = call('Runtime.evaluate', {'expression': '(window.__wantHover && !window.__hoverSent) ? JSON.stringify(window.__wantHover) : null', 'returnByValue': True}).get('result', {}).get('value')
            if hv:   # a REAL pointer move: CSS :hover follows it (a dispatched mouseover does not)
                pt = json.loads(hv)
                call('Input.dispatchMouseEvent', {'type': 'mouseMoved', 'x': pt['x'], 'y': pt['y'], 'button': 'none'})
                call('Runtime.evaluate', {'expression': 'window.__hoverSent = true'})
            v = call('Runtime.evaluate', {'expression': 'window.__PVDONE ? JSON.stringify(window.__PVRESULT) : null', 'returnByValue': True}).get('result', {}).get('value')
            if v: return json.loads(v)
        return {'fatal': 'timeout (180 s)'}
    finally:
        try: ws.close()
        except Exception: pass
        try: urllib.request.urlopen('http://127.0.0.1:%d/json/close/%s' % (dp, t['id']), timeout=10).read()
        except Exception: pass

def run_server(manage_text, mode=''):
    p = os.path.join(stage, 'manage_journal_under_test.php')
    open(p, 'wb').write(manage_text.encode('utf-8', 'surrogateescape'))
    # -n (no php.ini) + mbstring by hand: the live server loads it (manage_journal.php uses mb_*).
    # (forward slashes: PHP will not load an extension from a backslash UNC path given with -d)
    ext = ['-d', 'extension_dir=' + os.path.join(os.path.dirname(PHP), 'ext').replace(chr(92), '/'), '-d', 'extension=mbstring']
    r = subprocess.run([PHP, '-n'] + ext + [os.path.join(HERE, 'server_check.php'), p] + ([mode] if mode else []), capture_output=True, timeout=60)
    try: return json.loads(r.stdout.decode('utf-8', 'replace'))
    except Exception: return {'fatal': 'server_check: ' + (r.stdout + r.stderr).decode('utf-8', 'replace')[:400]}

def run_build(texts, scns):
    open(os.path.join(stage, 'main_pv.js'), 'wb').write(hook(texts['main']).encode('utf-8', 'surrogateescape'))
    open(os.path.join(stage, 'penumbra_journal_pv.js'), 'wb').write(texts['journal'].encode('utf-8', 'surrogateescape'))
    open(os.path.join(stage, 'main.css'), 'wb').write(texts['css'].encode('utf-8', 'surrogateescape'))
    open(os.path.join(stage, 'penumbra_journal.css'), 'wb').write(texts['jcss'].encode('utf-8', 'surrogateescape'))
    page = harness.replace('<!--PV_VIEW_OPTIONS-->', lift(texts['index'], 'journalRowConfig')) \
                  .replace('<!--PV_JOURNAL_LIGHTBOX-->', lift(texts['index'], 'journalLightbox'))
    open(os.path.join(stage, 'harness.html'), 'w', encoding='utf-8').write(page)
    out = {}
    for s in scns:
        if s == 'static7':   # a read of main.js itself: no panel-row handling left
            import re as _re
            hits = [l.strip()[:90] for l in texts['main'].splitlines() if _re.search(r'journal-note-child|isNoteChild', l)]
            out[s] = {'asserts': [{'id': 'S-sweep-clean', 'ok': not hits, 'detail': ('%d line(s) still handle the panel row: %s' % (len(hits), ' | '.join(hits[:3]))) if hits else 'main.js has no tr.journal-note-child handling left'}]}
            continue
        out[s] = (run_server(texts['manage']) if s == 'server' else (run_server(texts['manage'], 'r3') if s == 'server3'
                  else (run_server(texts['manage'], 'r4') if s == 'server4'
                  else (run_server(texts['manage'], 'r6') if s == 'server6' else run_page(s)))))
    return out

def evaluate(res, scns):
    out = []
    for s in scns:
        r = res.get(s, {})
        got = {a['id']: a for a in (r.get('asserts') or [])}
        for aid in EXPECT[s]:
            if aid in got: out.append((aid, got[aid]['ok'], got[aid]['detail']))
            else: out.append((aid, False, 'NOT RECORDED' + (' | fatal: ' + (r.get('fatal') or '')[:300] if r.get('fatal') else '')))
        for aid, a in got.items():
            if aid not in EXPECT[s]: out.append((aid, a['ok'], 'UNEXPECTED ID ' + a['detail']))
        if s not in ('server', 'server3', 'server4', 'server6', 'static7'):
            out.append(('E-' + s, not r.get('errors') and not r.get('hookErr') and not r.get('missing') and not r.get('fatal'),
                        'errors %s hook %s missing %s fatal %s' % (r.get('errors'), r.get('hookErr'), r.get('missing'), (r.get('fatal') or '')[:200])))
    return out

