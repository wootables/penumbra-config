def read_b(p): return open(p, 'rb').read().decode('utf-8', 'surrogateescape')

def lift(index_text, marker):
    """A <div id="..."> block from index.php, verbatim, to its close."""
    a = index_text.find('<div id="%s"' % marker)
    if a < 0: raise SystemExit('index.php: no #' + marker)
    depth, i = 0, a
    while True:
        o = index_text.find('<div', i); c = index_text.find('</div>', i)
        if c < 0: raise SystemExit('index.php: #%s never closes' % marker)
        if o != -1 and o < c: depth += 1; i = o + 4
        else:
            depth -= 1; i = c + 6
            if depth == 0: break
    block = index_text[a:i]
    if '<?' in block: raise SystemExit('index.php: PHP inside #%s - the lift needs updating' % marker)
    return block

def hook(src):
    """The ready closure becomes an IIFE with a name-by-name export hook; hideLoading
    counts its calls; the end of init applies the harness's on-demand row threshold."""
    anchor = '$(document).ready(function () {'
    i = src.find(anchor)
    if i < 0 or i > 400: raise SystemExit('closure anchor not found')
    names = ['buildStateObject', 'getPivotDataAsArray', 'getPivotCsvForCopy', 'generateWysiwygHtml', 'togglePivotGroup',
             'rebuildGroupedView', 'removeGrouping', 'runTableSearch']
    # setPivot(s): draws a pivot the way a report load does (pivotsortkeep's hook), on the loaded rows.
    set_pivot = ('(function (s) { currentPivotSettings = s; var rows = currentPivotSourceData;'
                 ' var cur = penumbraPivotCurrencyFlags(s.vals, s.aggColOverrides, s.agg);'
                 ' var pd = processPivotData(rows, s.rows, s.cols, s.vals, s.agg, getExtraValFields(s.aggColOverrides, s.vals), s.aggFilters);'
                 ' var res = generatePivotTable(pd, s.rows, s.cols, s.vals, s.rowLayout, s.colLayout, s.agg, s.sortOrder, null, cur, s.totalColAggs,'
                 ' s.totalRowAggs, s.colSortOrder, s.stickyColCount, buildRankConfig(s), s.totalRowAggLabels, s.aggColOverrides, s.totalRowAggBaseIdx, false);'
                 ' $("#pivot-output-container").html(res.html).show(); penumbraPivotLazyBind(); return true; })')
    h = ('\r\n;try { window.__PV = { setPivot: eval(' + json.dumps(set_pivot) + ') }; } catch (e) { window.__PV_ERR = String(e); }\r\n'
         'try { [' + ','.join('"%s"' % n for n in names) + '].forEach(function (k) { try { window.__PV[k] = eval(k); } catch (e) { (window.__PV_MISSING = window.__PV_MISSING || []).push(k); } }); } catch (e) { window.__PV_ERR2 = String(e); }\r\n')
    out = src[:i] + ';(function () {' + h + src[i + len(anchor):]
    j = out.rfind('});')
    tail = '\r\n;try { if (window.__PV_LAZY_MIN) _pivotLazyMinRows = window.__PV_LAZY_MIN; } catch (e) { window.__PV_LAZY_ERR = String(e); }\r\n'
    out = out[:j] + tail + '})();' + out[j + 3:]
    hl = '    function hideLoading() {\r\n'
    if out.count(hl) != 1: raise SystemExit('hideLoading anchor count %d' % out.count(hl))
    return out.replace(hl, hl + '        window.__PV_HIDES = (window.__PV_HIDES || 0) + 1;\r\n')

def mutate(texts, name):
    m = MUTANTS[name]
    f = m.get('file', 'main')
    src = texts[f]
    for old, new in m['edits']:
        if src.count(old) != 1: raise SystemExit("mutant '%s': anchor found %d times in %s (needs the FEATURE build): %r" % (name, src.count(old), f, old[:90]))
        src = src.replace(old, new)
    out = dict(texts); out[f] = src
    return out

