<script>
  (function () { try { localStorage.clear(); } catch (e) {} })();
  window.PENUMBRA_THEMES = { 'theme-default': { label: 'Default' } };
  window.PENUMBRA_THEME_IDS = ['theme-default'];
  window.PENUMBRA_THEME_ALIASES = {};
  window.PENUMBRA_LANDING_DEFAULT_THEME = 'theme-default';
  (function () {
    var P = new URLSearchParams(location.search);
    window.__SCN = P.get('scn') || 'nested';
    var S = window.__SCN;
    // The pivot row key, as main.js pivotKeyFor builds it: [field, value] pairs
    // sorted by field, as JSON. Ground truth for every assert.
    window.__pk = function (pairs) {
      return JSON.stringify(pairs.slice().sort(function (a, b) { return a[0] < b[0] ? -1 : (a[0] > b[0] ? 1 : 0); }));
    };
    // --- the fixture: 3 departments x 3 fiscal years x 3 PIs ---------------
    var DEPTS = ['Engineering', 'Sciences', 'Humanities'], FYS = ['FY2024', 'FY2025', 'FY2026'], PIS = ['Ada', 'Bo', 'Cy'];
    var rows = [], n = 0;
    DEPTS.forEach(function (d, di) {
      FYS.forEach(function (y, yi) {
        PIS.forEach(function (p, pi) {
          n++;
          // PI 'Cy' only under Engineering keeps the rank scenario's (Other) honest.
          rows.push({ ID: String(1000 + n), DEPT: d, FY: y, PI: (d === 'Engineering' ? p : p + di), AMOUNT: String(100 * (di + 1) + 10 * (yi + 1) + pi) });
        });
      });
    });
    // Round 5 (bands): one row with NO department - its band is "[Blank]".
    if (window.__SCN === 'bands') rows.push({ ID: '1999', DEPT: '', FY: 'FY2026', PI: 'Zed', AMOUNT: '5' });
    window.__rowsFixture = rows;
    window.__DEPTS = DEPTS; window.__FYS = FYS;
    var pk = window.__pk;
    var K_LEAF = pk([['DEPT', 'Engineering'], ['FY', 'FY2026']]);   // 2 notes
    var K_GRP = pk([['DEPT', 'Sciences']]);                         // 1 note (a group; a DEPT-only pivot's row)
    window.__K = { leaf: K_LEAF, grp: K_GRP };
    // --- the journal "server" --------------------------------------------
    function note(id, key, text, by, at) { return { ID: id, REPORT_ID: 7, SCOPE: 'pivot', ROW_KEY: key, NOTE_TEXT: text, CREATED_BY: by, CREATED_AT: at, PARENT_ID: null }; }
    window.__J = {
      counts: {}, notes: {},           // table-row notes (none: no key column)
      pcounts: {}, pnotes: {},         // pivot-row notes
      posts: [], fetches: 0
    };
    window.__J.pnotes[K_LEAF] = [note(901, K_LEAF, 'FY2026 looks high.', 'pat', '2026-10-01 09:05:00'),
                                 note(902, K_LEAF, 'Two late awards.', 'lee', '2026-10-01 11:00:00')];
    window.__J.pcounts[K_LEAF] = 2;
    window.__J.pnotes[K_GRP] = [note(903, K_GRP, 'Sciences reorganised in 2025.', 'pat', '2026-10-02 08:00:00')];
    window.__J.pcounts[K_GRP] = 1;
    // The J panel's list: one pivot-row note (with the snapshot its card took)
    // and one table-row note, for the chip asserts.
    window.__J.list = [
      { ID: 901, SCOPE: 'pivot', ROW_KEY: K_LEAF, NOTE_TEXT: 'FY2026 looks high.', ROW_SNAPSHOT: JSON.stringify({ DEPT: 'Engineering', FY: 'FY2026' }),
        MENTIONS: null, RESOLVED: null, CREATED_BY: 'pat', AUTHOR_NAME: 'Pat Doe', CREATED_AT: '2026-10-01 09:05:00', PARENT_ID: null },
      { ID: 950, SCOPE: 'row', ROW_KEY: '1001', NOTE_TEXT: 'A table row note.', ROW_SNAPSHOT: JSON.stringify({ ID: '1001', DEPT: 'Engineering' }),
        MENTIONS: null, RESOLVED: null, CREATED_BY: 'lee', AUTHOR_NAME: 'Lee Roe', CREATED_AT: '2026-10-01 08:00:00', PARENT_ID: null }
    ];
    // --- the scenario's stored report ------------------------------------
    var COLS = ['ID', 'DEPT', 'FY', 'PI', 'AMOUNT'];
    var order = []; for (var c = 0; c < COLS.length; c++) order.push(c);
    function pivot(rowsF, layout, extra) {
      var s = { v: 2, rows: rowsF, cols: [], vals: 'AMOUNT', agg: ['sum'], aggLabels: ['Amount'], aggColOverrides: ['AMOUNT'],
        aggFilters: null, aggFormulas: null, rowLayout: layout, colLayout: 'nested', sortOrder: 'asc', colSortOrder: 'asc',
        stickyColCount: 2, totalColAggs: null, totalRowAggs: null, totalRowAggLabels: null, totalRowAggBaseIdx: null,
        rankN: null, rankDir: null, rankAgg: null, rankOther: true, rankScope: null, noBreakdown: false, startExpanded: true, hideEmpty: false };
      for (var k in extra) s[k] = extra[k];
      return s;
    }
    var vo = { journalEnabled: true, journalRowNotes: true };
    var st = {
      name: 'pvfix', query: 'SELECT * FROM PV_FIXTURE', reportTitle: 'Pivot notes fixture',
      theme: 'theme-default', density: 'standard',
      visibleColumns: ['#', 0, 1, 2, 3, 4], columnOrder: order,
      sortCriteria: [], noLimit: true, rowExpandDefault: false, resolverLinksDefault: true,
      rowsPerPage: '200', reportSnippet: '', viewOptions: vo,
      pivot: pivot(['DEPT', 'FY'], 'nested', {})
    };
    if (S === 'static') st.pivot = pivot(['DEPT', 'FY'], 'nested-static', {});
    if (S === 'flat') st.pivot = pivot(['DEPT', 'FY'], 'flat', {});
    if (S === 'single') st.pivot = pivot(['DEPT'], 'nested', {});
    if (S === 'reorder') st.pivot = pivot(['FY', 'DEPT'], 'nested', {});
    if (S === 'rank') st.pivot = pivot(['PI'], 'nested', { rankN: 3, rankDir: 'top', rankAgg: 0, rankOther: true });
    // collapsed + reveal: groups start collapsed; the rows under them are built
    // on demand (driver forces the lazy threshold down to 1 before the render).
    if (S === 'collapsed' || S === 'reveal') st.pivot = pivot(['DEPT', 'FY'], 'nested', { startExpanded: false });
    // run.py's hook sets the pivot's on-demand row threshold from this at the end
    // of main.js's init, before the query answers (default 3,000 rows).
    if (S === 'collapsed' || S === 'reveal') window.__PV_LAZY_MIN = 1;
    // off: row notes OFF when saved, and no key column at all.
    if (S === 'off') st.viewOptions = { journalEnabled: true };
    // Round 4 (2026-10-07): note 901 (on the Engineering / FY2026 row) gets a reply by
    // lee - deleting 901 now deletes the thread, and the question says so.
    // Round 5 (2026-10-07): the grouped view's band headers carry the same threads.
    // Grouped DEPT then FY, every level open, no pivot; the blank department's
    // band shares the thread of the pivot's blank DEPT group (key value '').
    if (S === 'bands') {
      delete st.pivot;
      st.groupBy = 'DEPT,FY';
      st.groupStartDepth = 3;
      var K_BLANK = pk([['DEPT', '']]);
      window.__K.blank = K_BLANK;
      window.__J.pnotes[K_BLANK] = [note(905, K_BLANK, 'No department on this one.', 'pat', '2026-10-03 08:00:00')];
      window.__J.pcounts[K_BLANK] = 1;
    }
    // Round 6 (2026-10-07): a TABLE row's notes open in the same card. No pivot, key
    // column ID, 25 rows a page (27 rows: a second page). Row 1001 has a note by lee;
    // row 1002 a thread: 960 by us (so we may delete it) + a reply 961 by lee.
    // rowgrp: the same, grouped by DEPT.
    window.__TABLE_SCN = (S === 'rowcard' || S === 'rowgrp');
    if (window.__TABLE_SCN) {
      delete st.pivot;
      st.viewOptions = { journalEnabled: true, journalRowNotes: true, journalKeyColumns: ['ID'] };
      st.rowsPerPage = '25';
      var rn = function (id, key, text, by, at, parent) {
        return { ID: id, REPORT_ID: 7, SCOPE: 'row', ROW_KEY: key, NOTE_TEXT: text, CREATED_BY: by, AUTHOR_NAME: by, CREATED_AT: at, PARENT_ID: parent || null };
      };
      window.__J.notes['1001'] = [rn(950, '1001', 'A table row note.', 'lee', '2026-10-01 08:00:00')];
      window.__J.counts['1001'] = 1;
      window.__J.notes['1002'] = [rn(960, '1002', 'A thread on 1002.', 'harness', '2026-10-02 08:00:00'),
                                  rn(961, '1002', 'Its reply.', 'lee', '2026-10-02 09:00:00', 960)];
      window.__J.counts['1002'] = 2;
      if (S === 'rowgrp') st.groupBy = 'DEPT';
    }
    if (S === 'delthread') {
      var rep = { ID: 904, REPORT_ID: 7, SCOPE: 'pivot', ROW_KEY: K_LEAF, NOTE_TEXT: 'Agreed, checking.', CREATED_BY: 'lee', CREATED_AT: '2026-10-01 12:00:00', PARENT_ID: 901 };
      window.__J.pnotes[K_LEAF].push(rep);
      window.__J.pcounts[K_LEAF] = 3;
      window.__J.list.push({ ID: 904, SCOPE: 'pivot', ROW_KEY: K_LEAF, NOTE_TEXT: 'Agreed, checking.', ROW_SNAPSHOT: null, MENTIONS: null, RESOLVED: null,
                             CREATED_BY: 'lee', AUTHOR_NAME: 'Lee Roe', CREATED_AT: '2026-10-01 12:00:00', PARENT_ID: 901 });
      window.__J.list[0].CREATED_BY = 'harness';   // 901 is ours, so the panel offers its delete
      window.__J.pnotes[K_LEAF][0].CREATED_BY = 'harness';
    }
    // Round 2 (2026-10-07): the card on Wolfpack Red, whose blanket
    // `.theme-wolfpack button:hover:not(:disabled)` (0,3,1) painted the band red.
    if (S === 'wolfpack') {
      window.PENUMBRA_THEMES['theme-wolfpack'] = { label: 'Wolfpack Red' };
      window.PENUMBRA_THEME_IDS.push('theme-wolfpack');
      st.theme = 'theme-wolfpack';
    }
    // Round 8 (2026-10-09): chart point notes. A real vis() chart in the report's snippet
    // area (no pivot): a chart's point is the pivot row with its labels, so K_LEAF
    // (Engineering / FY2026, 2 notes) is a segment of the DEPT x FY bars and K_GRP
    // (Sciences, 1 note) a bar or slice of a DEPT-only chart.
    window.__CHART_SCN = /^ch/.test(S);
    if (window.__CHART_SCN) {
      delete st.pivot;
      var V = function (type, x, y, gb, agg, limit, title) {
        return "vis('" + type + "', '" + x + "', '" + y + "', '" + gb + "', '" + agg + "', " + limit + ", '" + title + "', true, false, 640, 300)";
      };
      if (S === 'chbar' || S === 'choff') st.reportSnippet = V('bar', 'DEPT', 'AMOUNT', 'FY', 'sum', 10, 'By department and year');
      if (S === 'chdrill') st.reportSnippet = V('bar', 'DEPT', 'AMOUNT', 'none', 'sum', 10, 'By department');
      // lower case on purpose: the key's field is the column as the pivot writes it (upper case)
      if (S === 'chpie') st.reportSnippet = V('pie', 'dept', 'AMOUNT', 'none', 'sum', 10, 'Share by department');
      // Top 3 PIs (Humanities' Cy2 / Bo2 / Ada2) + Other; Cy2 has a note
      if (S === 'chother') {
        // vis() argument 25 (otherBucket): a Top-N chart folds the rest into "Other" only when asked
        st.reportSnippet = "vis('bar', 'PI', 'AMOUNT', 'none', 'sum', 3, 'Top PIs', true, false, 640, 300, 'top', 'end', false, false, false, 'top', 'value', 'desc', 'default', false, '', '', '', true)";
        var K_CY2 = pk([['PI', 'Cy2']]);
        window.__K.cy2 = K_CY2;
        window.__J.pnotes[K_CY2] = [note(906, K_CY2, 'Cy2 leads.', 'pat', '2026-10-03 09:00:00')];
        window.__J.pcounts[K_CY2] = 1;
      }
      // A blank department (the pivot keys it '') and a PI that is blank on one row and
      // READS "Unknown" on another: a chart puts both in its "Unknown" bar.
      if (S === 'chblank') {
        rows.push({ ID: '1998', DEPT: '', FY: 'FY2026', PI: '', AMOUNT: '5' });
        rows.push({ ID: '1997', DEPT: 'Sciences', FY: 'FY2025', PI: 'Unknown', AMOUNT: '7' });
        st.reportSnippet = V('bar', 'DEPT', 'AMOUNT', 'none', 'sum', 10, 'By department') + "\n" + V('bar', 'PI', 'AMOUNT', 'none', 'sum', 10, 'By PI');
        window.__CHART_N = 2;
        var K_BL = pk([['DEPT', '']]);
        window.__K.blank = K_BL;
        window.__J.pnotes[K_BL] = [note(907, K_BL, 'No department on this one.', 'pat', '2026-10-03 10:00:00')];
        window.__J.pcounts[K_BL] = 1;
      }
      // Row notes off: no markers, no Notes
      if (S === 'choff') st.viewOptions = { journalEnabled: true };
    }
    window.__STORED = st;
    window.penumbra_vars = {
      isAdmin: true, isGlobalAdmin: true, canEditReport: true, currentUserKey: 'harness', shibboleth: { ouc: '', dept: '' },
      tables: { oracle: [], pins: [], infoed: [], hr: [], fin: [] },
      imports: [], reports: [], themes: {}, prompts: {}, grants: [],
      totalExemptions: [],
      journal: { installed: true, enabled: true, total: 0, unseen: 0 },
      journalAccess: true,
      preloadedState: st
    };
    window.__queryResponse = { data: rows };
  })();
  window.__queryDone = 0;
  window.__ajaxLog = [];
</script>
