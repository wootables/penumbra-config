<script>
  // Fake server. query.php -> the fixture; manage_journal.php -> window.__J.
  function __pvJournal(url, opts) {
    var m = /[?&]action=([a-z_]+)/.exec(url);
    var action = m ? m[1] : null, body = null;
    if (!action && opts.data && typeof opts.data === 'string') { try { body = JSON.parse(opts.data); action = body.action; } catch (e) { } }
    var J = window.__J;
    var copy = function (o) { return JSON.parse(JSON.stringify(o)); };
    if (action === 'row_notes') {
      J.fetches++;
      return { status: 'success', counts: copy(J.counts), notes: copy(J.notes), pivot_counts: copy(J.pcounts), pivot_notes: copy(J.pnotes) };
    }
    if (action === 'toggles') return { status: 'success', installed: true, toggles: {} };
    if (action === 'summary') return { status: 'success', installed: true, total: 0, unseen: 0 };
    if (action === 'list') return { status: 'success', installed: true, data: copy(J.list), report: { id: 7, short_id: 'pvfix', title: 'Pivot notes fixture' } };
    if (action === 'delete' && body) {
      J.posts.push(body);
      var nrep = (J.list || []).filter(function (n) { return String(n.PARENT_ID) === String(body.note_id); }).length;
      // Round 6: a TABLE row's note goes from the row maps, its replies with it.
      var gone = 0;
      Object.keys(J.notes).forEach(function (k) {
        var before = J.notes[k].length;
        J.notes[k] = J.notes[k].filter(function (n) { return String(n.ID) !== String(body.note_id) && String(n.PARENT_ID) !== String(body.note_id); });
        gone += before - J.notes[k].length;
        if (J.notes[k].length) J.counts[k] = J.notes[k].length; else delete J.counts[k];
      });
      if (gone) nrep = gone - 1;
      return { status: 'success', message: nrep ? 'Deleted the note and its ' + nrep + ' repl' + (nrep === 1 ? 'y' : 'ies') + '.' : 'Note deleted.', deleted: 1 + nrep, replies: nrep };
    }
    if (action === 'add' && body) {
      J.posts.push(body);
      if (body.scope === 'row') {   // round 6: a table row's note
        var rk = body.row_key;
        J.notes[rk] = (J.notes[rk] || []).concat([{ ID: 3000 + J.posts.length, REPORT_ID: 7, SCOPE: 'row', ROW_KEY: rk, NOTE_TEXT: body.note_text,
          CREATED_BY: 'harness', AUTHOR_NAME: 'harness', CREATED_AT: '2026-10-07 12:00:00', PARENT_ID: body.parent_id || null }]);
        J.counts[rk] = J.notes[rk].length;
      }
      if (body.scope === 'pivot') {
        var k = body.row_key;
        J.pnotes[k] = (J.pnotes[k] || []).concat([{ ID: 2000 + J.posts.length, REPORT_ID: 7, SCOPE: 'pivot', ROW_KEY: k, NOTE_TEXT: body.note_text,
          CREATED_BY: 'harness', CREATED_AT: '2026-10-06 12:00:00', PARENT_ID: body.parent_id || null }]);
        J.pcounts[k] = J.pnotes[k].length;
      }
      return { status: 'success', scope: body.scope, mention_results: [], reply_results: [] };
    }
    if (body) J.posts.push(body);
    return { status: 'success' };
  }
  jQuery.ajax = function (a, b) {
    var opts = (typeof a === 'string') ? jQuery.extend({ url: a }, b || {}) : (a || {});
    var url = String(opts.url || '');
    window.__ajaxLog.push(url);
    var d = jQuery.Deferred();
    var isQuery = /query\.php/.test(url);
    var isJournal = /manage_journal\.php/.test(url);
    var jState = isJournal && /[?&]action=(toggles|row_notes)/.test(url);
    if (jState) window.__jPending = (window.__jPending || 0) + 1;
    var isPeople = /get_email_recipients\.php/.test(url);
    var resp = isQuery ? window.__queryResponse : (isJournal ? __pvJournal(url, opts) : (isPeople ? [{ username: 'pat', name: 'Pat Doe' }] : {}));
    setTimeout(function () {
      try { if (opts.success) opts.success(resp, 'success', { status: 200 }); } catch (e) { window.__errors.push('ajax success threw: ' + String(e)); }
      try { if (opts.complete) opts.complete({ status: 200 }, 'success'); } catch (e) { window.__errors.push('ajax complete threw: ' + String(e)); }
      d.resolve(resp, 'success', { status: 200 });
      if (isQuery) window.__queryDone++;
      if (jState) window.__jPending--;
    }, isJournal ? 30 : 0);
    var p = d.promise(); p.abort = function () {}; return p;
  };
  jQuery.getJSON = function (u, x, cb) { return jQuery.ajax({ url: u, success: (typeof x === 'function') ? x : cb }); };
  jQuery.post = function (u, x, cb) { return jQuery.ajax({ url: u, success: (typeof x === 'function') ? x : cb }); };
  jQuery.get = jQuery.post;
  jQuery.fx.off = true;
  window.__errors = [];
  window.__rejections = [];
  window.onerror = function (m, src, line) { window.__errors.push(String(m) + ' @' + String(src).split('/').pop() + ':' + line); return true; };
  window.addEventListener('unhandledrejection', function (e) {
    var r = e.reason;
    window.__rejections.push(String((r && r.message) || r) + ' @' + String((r && r.stack) || '').split('\n').slice(1, 2).join('').trim());
    e.preventDefault();
  });
  window.__confirms = [];
