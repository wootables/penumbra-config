# Builds mutants.json for the pvnotes suite and checks every anchor against the
# FEATURE build it was made for (each must occur exactly once in its file).
#   py -3 mk_mutants.py <stage or app dir>
# A mutant keeps its frozen "must" list across rebuilds (read back from the old
# mutants.json); a new one starts at null = EXPLORE (run.py prints its red set).
import json, os, sys
HERE = os.path.dirname(os.path.abspath(__file__))
base = sys.argv[1] if len(sys.argv) > 1 else r'\\oitras.oit.ncsu.edu\c$\inetpub\wwwroot\sponsor_migration\penumbra'
FILES = {'main': 'js\\main.js', 'journal': 'js\\penumbra_journal.js', 'manage': 'manage_journal.php'}
CR = '\r\n'   # main.js is CRLF; penumbra_journal.js and manage_journal.php are LF

M = {
    # the paint pass never runs: no icon anywhere
    'nopaint': ('main', [('            var on = !hold && pivotNotesActive();' + CR + '            var toks = on ? pivotRowTokens() : [];',
                          '            var on = false;' + CR + '            var toks = [];')], None),
    # no observer: a pivot rendered (or rows built) after the notes landed stays bare
    'noobserver': ('main', [('            _pvMo.observe(pc, { childList: true, subtree: true });', '            void pc;')], None),
    # keys follow the pivot's field ORDER: FY x DEPT misses the DEPT x FY notes
    'nosort': ('main', [('                pairs.sort(function (a, b) { return a[0] < b[0] ? -1 : (a[0] > b[0] ? 1 : 0); });', '                void 0;')], None),
    # a collapsed group's summary row gets no icon
    'nosummary': ('main', [('                if (sumKey !== null) {' + CR + '                    parts = sumKey.split(PV_SEP);',
                            '                if (sumKey !== null) { continue;' + CR + '                    parts = sumKey.split(PV_SEP);')], None),
    # a Top-N (Other) row takes a note
    'noother': ('main', [('                if (parts[i] === PV_OTHER) { pairs = null; break; }', '                if (false) { pairs = null; break; }')], None),
    # side-by-side: every label cell gets an icon, not just the row's first
    'flatall': ('main', [('                    } else if (lvl === 0) {' + CR + '                        stampPivotCell(td, parts, toks, false, counts);',
                          '                    } else if (true) {' + CR + '                        stampPivotCell(td, parts, toks, false, counts);')], None),
    # the count as TEXT in the button: it lands in the label cell's text
    'counttext': ('main', [("                + '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg>'" + CR + "                + '</button>';" + CR + "        }" + CR + "        // The icon goes FIRST",
                            "                + '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg>'" + CR + "                + (n ? n : '') + '</button>';" + CR + "        }" + CR + "        // The icon goes FIRST")], None),
    # Copy as HTML / the email embed / print keep the icon
    'nostriphtml': ('main', [("                    $tdClone.find('.pivot-collapse-toggle, .journal-pvnote-btn').remove();", "                    $tdClone.find('.pivot-collapse-toggle').remove();")], None),
    # EQUIVALENT by design: the count is CSS content and the svg has no text, so the
    # XLSX/array text reader would read the same without its strip
    'eq-nostriparray': ('main', [(".find('.sort-icon, .col-sort-icon, .pivot-collapse-toggle, .journal-pvnote-btn').remove()", ".find('.sort-icon, .col-sort-icon, .pivot-collapse-toggle').remove()")], []),
    # the card stays up when the pivot is put away
    'noaway': ('main', [("            if (!$('#pivot-output-container').is(':visible') || !document.getElementById('pivotResultTable') || !pivotNotesActive()) {",
                         "            if (!document.getElementById('pivotResultTable') || !pivotNotesActive()) {")], None),
    # the card stays put when the page scrolls
    'nofollow': ('main', [('            queuePlacePivotNoteCard();' + CR + '        }, true);', '            void 0;' + CR + '        }, true);')], None),
    # the card never re-finds its icon (a collapse moves a group's icon to its summary row)
    'noreanchor': ('main', [('            if (refind || !c.anchor || !c.anchor.isConnected || !c.anchor.getClientRects().length) {', '            if (false) {')], None),
    # the Row notes switch still waits for a key
    'nokeyunlock': ('main', [("            $('#journalRowNotesEnable').prop('disabled', false);", "            $('#journalRowNotesEnable').prop('disabled', !ok);")], None),
    # saved only with a key
    'nosavenokey': ('main', [('            if (window._penumbraJournalRowNotes) {' + CR + '                viewOptions.journalRowNotes = true;',
                              '            if (window._penumbraJournalRowNotes && window._penumbraJournalKeyColumns && window._penumbraJournalKeyColumns.length) {' + CR + '                viewOptions.journalRowNotes = true;')], None),
    # fetched only with a key: the pivot's counts never land
    'nofetchnokey': ('main', [('            if (!rid || window._penumbraJournalHidden || !window._penumbraJournalRowNotes) {' + CR + '                window._penumbraRowNotes = {}; window._penumbraRowNoteCounts = {};' + CR + '                window._penumbraPivotNotes',
                               '            if (!rid || window._penumbraJournalHidden || !window._penumbraJournalRowNotes || !keyCols()) {' + CR + '                window._penumbraRowNotes = {}; window._penumbraRowNoteCounts = {};' + CR + '                window._penumbraPivotNotes')], None),
    # a pivot row's note is posted as a TABLE row's
    'pvscope': ('main', [("            var scope = isPivot ? 'pivot' : 'row';", "            var scope = 'row';")], None),
    # the journal panel gives a pivot note a TABLE row's tag (it jumps to the table)
    'nopvchip': ('journal', [("        if (String(n.SCOPE || '') === 'pivot') return renderPivotRef(n);\n", '')], None),
    # the pivot tag does nothing when clicked
    'nopvjump': ('journal', [("        $(document).on('click', '.journal-note-rowref-btn[data-pv-key]', function (e) {", "        $(document).on('click', '.journal-note-rowref-btn[data-pv-key-off]', function (e) {")], None),
    # the server takes any JSON array as a pivot key
    'nokeyshape': ('manage', [('    if (!is_array($pairs) || count($pairs) < 1 || count($pairs) > 8) return false;', '    if (!is_array($pairs)) return false;')], None),
    # a reply to a pivot note lands as a report note
    'noreplyscope': ('manage', [("                $scope        = ($prow['SCOPE'] === 'row' || $prow['SCOPE'] === 'pivot') ? $prow['SCOPE'] : 'report';",
                                 "                $scope        = ($prow['SCOPE'] === 'row') ? 'row' : 'report';")], None),
}
SCN = {'nostriphtml': ['exports'], 'eq-nostriparray': ['exports'], 'nokeyshape': ['server'], 'noreplyscope': ['server'],
       'nopvchip': ['jpanel'], 'nopvjump': ['jpanel'], 'nokeyunlock': ['off'], 'nosavenokey': ['off'], 'counttext': ['nested', 'exports'],
       'noaway': ['nested'], 'nofollow': ['nested'], 'noreanchor': ['nested', 'jpanel'], 'pvscope': ['nested'],
       'nosort': ['reorder', 'nested', 'single'], 'noother': ['rank'], 'flatall': ['flat'], 'nosummary': ['collapsed', 'nested', 'reveal']}

old = {}
p = os.path.join(HERE, 'mutants.json')
if os.path.exists(p): old = json.load(open(p, encoding='utf-8'))
texts = {k: open(os.path.join(base, rel), 'rb').read().decode('utf-8', 'surrogateescape') for k, rel in FILES.items()}
out, bad = {}, 0
for name, (f, edits, must) in M.items():
    for a, b in edits:
        n = texts[f].count(a)
        if n != 1: print('ANCHOR %s: found %d times in %s: %r' % (name, n, f, a[:80])); bad += 1
    keep = old.get(name, {}).get('must') if name in old else None
    out[name] = {'file': f, 'edits': [list(e) for e in edits], 'must': must if must is not None else keep, 'scn': SCN.get(name)}
json.dump(out, open(p, 'w', encoding='utf-8', newline='\n'), indent=1, ensure_ascii=False)
print('%d mutants, %d bad anchors' % (len(out), bad))
sys.exit(1 if bad else 0)
