// pvnotes suite - browser half (2026-10-06). Runs ONE scenario (?scn=) against
// whichever main.js / penumbra_journal.js the page loaded and publishes
//   window.__PVRESULT = { scn, asserts: [{id, ok, detail}], errors: [...] }
// and window.__PVDONE = true. run.py collects and prints the asserts.
//
// GROUND TRUTH is the fixture (window.__rowsFixture), the key rule (window.__pk:
// [row field, value] pairs sorted by field, as JSON) and the fake journal server
// (window.__J). A pivot row is read from the page by its data-pivot-row (its raw
// labels joined by |||) or, for a collapsed group, its summary row's key.
(function () {
  var JR = window.__PV || {};
  var SCN = window.__SCN;
  var pk = window.__pk;
  var K = window.__K;
  var DEPTS = window.__DEPTS, FYS = window.__FYS;
  var R = { scn: SCN, asserts: [] };
  function rec(id, ok, detail) { R.asserts.push({ id: id, ok: !!ok, detail: String(detail == null ? '' : detail) }); }
  function sleep(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function hides() { return window.__PV_HIDES || 0; }
  async function until(fn, ms) { var t = Date.now(); while (!fn() && Date.now() - t < ms) await sleep(20); return fn(); }
  function clickEl(el) { el.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window })); }
  function fail(ids, why) { ids.forEach(function (id) { rec(id, false, why); }); }

  // ---- reading the pivot -------------------------------------------------
  function tbl() { return document.getElementById('pivotResultTable'); }
  function drawn(el) { return !!el && el.getClientRects().length > 0; }
  function arr(nl) { return Array.prototype.slice.call(nl || []); }
  function btns() { return tbl() ? arr(tbl().querySelectorAll('.journal-pvnote-btn')) : []; }
  function btnsFor(key) { return btns().filter(function (b) { return b.getAttribute('data-pvn-key') === key; }); }
  function findBtn(key) { var d = btnsFor(key).filter(drawn); return d.length ? d[0] : null; }
  function leafRows() { return tbl() ? arr(tbl().querySelectorAll(':scope > tbody > tr[data-pivot-row]')) : []; }
  function partsOf(tr) { return tr.getAttribute('data-pivot-row').split('|||'); }
  function cellOf(tr, lvl) { return tr.querySelector(':scope > td[data-row-field="' + lvl + '"]'); }
  // Body rows that are not a collapsed group's summary row - readable on ANY build
  // (data-pivot-row is new with the feature), for the P-* preconditions.
  function bodyRows() { return tbl() ? arr(tbl().querySelectorAll(':scope > tbody > tr')).filter(function (tr) { return !tr.classList.contains('pivot-group-summary-row'); }) : []; }
  function cards() { return arr(document.querySelectorAll('.journal-pvnote-card')); }
  function after(b) { return getComputedStyle(b, '::after').content; }
  function cnt(b) { return b ? b.getAttribute('data-count') : null; }
  function drawnLeafCount(dept) { return leafRows().filter(function (tr) { return drawn(tr) && partsOf(tr)[0] === dept; }).length; }
  function chevron(groupKey) {
    var t = tbl() ? arr(tbl().querySelectorAll('.pivot-collapse-toggle-right')) : [];
    for (var i = 0; i < t.length; i++) if (t[i].getAttribute('data-group-key') === groupKey && drawn(t[i])) return t[i];
    return null;
  }
  function near(card, b) {
    if (!card || !b) return false;
    var br = b.getBoundingClientRect(), cr = card.getBoundingClientRect();
    return Math.abs(cr.top - (br.bottom + 6)) <= 2 || Math.abs(cr.bottom - (br.top - 6)) <= 2;
  }
  function brief(b) { return b ? ('count "' + cnt(b) + '" open ' + b.classList.contains('is-open') + ' group ' + b.classList.contains('is-group')) : 'no icon'; }

  // The leaf rows' icons in the leaf cell (nested layouts) or the first cell
  // (side-by-side): exactly one, FIRST in the cell, keyed by the row's labels.
  function checkLeafIcons(lvl, fields) {
    var bad = [];
    leafRows().forEach(function (tr) {
      var parts = partsOf(tr), td = cellOf(tr, lvl);
      var bs = td ? td.querySelectorAll('.journal-pvnote-btn') : [];
      var want = pk(fields.map(function (f, i) { return [f, parts[i]]; }));
      var tag = parts.join('/');
      if (!td || bs.length !== 1) { bad.push(tag + ': ' + bs.length + ' icons'); return; }
      if (td.firstChild !== bs[0]) bad.push(tag + ': icon not first in its cell');
      if (bs[0].getAttribute('data-pvn-key') !== want) bad.push(tag + ': key ' + bs[0].getAttribute('data-pvn-key') + ' want ' + want);
      if (bs[0].classList.contains('is-group')) bad.push(tag + ': marked as a group');
    });
    return bad;
  }
  // Each group: exactly one DRAWN icon, keyed by its label, first in the cell's
  // sticky-text wrapper, in the level-0 cell, marked as a group.
  function checkGroupIcons(field, values) {
    var bad = [];
    values.forEach(function (v) {
      var k = pk([[field, v]]), shown = btnsFor(k).filter(drawn);
      if (shown.length !== 1) { bad.push(v + ': drawn ' + shown.length); return; }
      var b = shown[0], host = b.parentNode, td = b.closest('td');
      if (!b.classList.contains('is-group')) bad.push(v + ': not is-group');
      if (!host.classList.contains('pivot-row-sticky-text') || host.firstChild !== b) bad.push(v + ': not first in the sticky text');
      if (!td || td.getAttribute('data-row-field') !== '0') bad.push(v + ': not in the level-0 cell');
    });
    return bad;
  }

  async function boot() {
    await until(function () { return window.__queryDone >= 1 && hides() >= 1; }, 60000);
    if (window.__CHART_SCN) {   // round 8: a vis() chart in the snippet area, no pivot
      await until(function () { return charts().length >= (window.__CHART_N || 1); }, 20000);
    } else if (window.__TABLE_SCN) {   // round 6: a table scenario - its Notes column, no pivot
      await until(function () { return !!document.querySelector('td[data-column="__JOURNAL_NOTES"] .journal-notes-btn'); }, 15000);
    } else {
      await until(function () { return !!tbl() && $('#pivot-output-container').is(':visible'); }, 15000);
    }
    await sleep(300);
    await until(function () { return !window.__jPending; }, 15000);
    await sleep(700);   // the coalesced paint (rAF / 120 ms) and the sticky re-measure
    // The pivot on screen, as when a user clicks an icon (the page above it is long).
    var w = document.getElementById(window.__CHART_SCN ? 'reportSnippetOutput' : 'results-wrapper');
    if (w) w.scrollIntoView({ block: 'start' });
    await sleep(100);
  }

  var S = {};

  // ---- nested (collapsible, expanded): icons, counts, text, the card ------
  S.nested = async function () {
    rec('P-nested-render', !!tbl() && bodyRows().length === 9 && bodyRows().every(drawn), 'pivot ' + !!tbl() + ', body rows ' + bodyRows().length);
    var bl = checkLeafIcons(1, ['DEPT', 'FY']);
    rec('V-nested-leaf', leafRows().length === 9 && !bl.length, bl.slice(0, 4).join(' | ') || 'all 9 leaf cells');
    var bg = checkGroupIcons('DEPT', DEPTS);
    rec('V-nested-group', !bg.length, bg.slice(0, 4).join(' | ') || 'all 3 group cells');
    var bLeaf = findBtn(K.leaf), bGrp = findBtn(K.grp), bNone = findBtn(pk([['DEPT', 'Humanities'], ['FY', 'FY2024']]));
    rec('V-nested-count', !!bLeaf && bLeaf.classList.contains('has-notes') && cnt(bLeaf) === '2' && after(bLeaf) === '"2"'
        && !!bGrp && cnt(bGrp) === '1' && !!bNone && !bNone.classList.contains('has-notes') && cnt(bNone) === '' && after(bNone) === 'none',
        'leaf ' + brief(bLeaf) + ' after ' + (bLeaf && after(bLeaf)) + ' | group ' + brief(bGrp) + ' | none ' + brief(bNone) + ' after ' + (bNone && after(bNone)));
    // The icon adds no TEXT to its cell: the count is CSS content.
    var badTxt = [];
    btns().forEach(function (b) { if (b.textContent !== '') badTxt.push('icon text "' + b.textContent + '"'); });
    leafRows().forEach(function (tr) { var p = partsOf(tr), td = cellOf(tr, 1); if (td && td.textContent.trim() !== p[1]) badTxt.push(p.join('/') + ' leaf text "' + td.textContent.trim() + '"'); });
    rec('V-nested-notext', btns().length > 0 && !badTxt.length, badTxt.slice(0, 3).join(' | ') || (btns().length + ' icons, no text'));
    rec('V-nested-faint', !!bNone && !!bLeaf && parseFloat(getComputedStyle(bNone).opacity) < 0.5 && getComputedStyle(bLeaf).opacity === '1',
        'empty ' + (bNone && getComputedStyle(bNone).opacity) + ' noted ' + (bLeaf && getComputedStyle(bLeaf).opacity));
    // The icons never shift the sticky columns: #pivotResultTable is table-layout:
    // fixed (header cells set the widths), so the second sticky column's left
    // still meets the first column's edge. A regression guard - it holds on the
    // build before the feature too, and nothing in the feature re-measures.
    var th1 = tbl() && tbl().querySelector('thead th.pivot-sticky-col'), td2 = tbl() && tbl().querySelector('tbody td.pivot-sticky-col-2');
    var left = td2 ? parseFloat(td2.style.left) : NaN;
    rec('V-nested-sticky', !!th1 && !!td2 && Math.abs(left - (th1.offsetWidth - 1)) <= 1,
        'col-2 left ' + left + ', col-1 width ' + (th1 && th1.offsetWidth) + ', table-layout ' + (tbl() && getComputedStyle(tbl()).tableLayout));

    var C = ['C-nested-open', 'C-nested-nofold', 'C-nested-place', 'C-nested-focus', 'C-nested-post', 'C-nested-again', 'C-nested-one',
             'C-nested-band', 'C-nested-esc', 'C-nested-follow', 'C-nested-collapse', 'C-nested-away'];
    if (!bLeaf || !bGrp) { fail(C, 'no icons to click'); return; }
    var engBefore = drawnLeafCount('Engineering');
    clickEl(bLeaf);
    await until(function () { return cards().length === 1; }, 2000);
    await sleep(150);
    var c = cards()[0];
    var ref = c ? (c.querySelector('.journal-rownote-ref') || {}).textContent : '';
    var items = c ? c.querySelectorAll('.journal-rownote-item').length : -1;
    rec('C-nested-open', cards().length === 1 && !!c && c.getAttribute('role') === 'dialog' && c.getAttribute('data-pvn-key') === K.leaf && drawn(c)
        && items === 2 && ref === 'Engineering · FY2026' && bLeaf.classList.contains('is-open') && bLeaf.getAttribute('aria-expanded') === 'true',
        'cards ' + cards().length + ' items ' + items + ' ref "' + ref + '" ' + brief(bLeaf));
    rec('C-nested-nofold', engBefore === 3 && drawnLeafCount('Engineering') === 3, 'Engineering rows drawn ' + engBefore + ' -> ' + drawnLeafCount('Engineering'));
    rec('C-nested-place', near(c, bLeaf), c ? ('card top ' + Math.round(c.getBoundingClientRect().top) + ' icon bottom ' + Math.round(bLeaf.getBoundingClientRect().bottom)) : 'no card');
    rec('C-nested-focus', !!c && document.activeElement === c.querySelector('.journal-rownote-input'), 'active ' + (document.activeElement && document.activeElement.className));
    if (!c) { fail(C.slice(4), 'no card'); return; }

    // Post: scope 'pivot', the row's key, the labels as the snapshot; the count follows.
    var inEl = c.querySelector('.journal-rownote-input');
    inEl.focus();
    inEl.textContent = 'Pivot check';
    var nPosts = window.__J.posts.length;
    clickEl(c.querySelector('.journal-rownote-post'));
    await until(function () { return window.__J.posts.length > nPosts; }, 3000);
    await until(function () { var b = findBtn(K.leaf); return !!b && cnt(b) === '3'; }, 3000);
    var p = window.__J.posts[window.__J.posts.length - 1] || {};
    var snap = p.row_snapshot || {};
    var b3 = findBtn(K.leaf);
    rec('C-nested-post', p.action === 'add' && p.scope === 'pivot' && p.row_key === K.leaf && p.note_text === 'Pivot check'
        && snap.DEPT === 'Engineering' && snap.FY === 'FY2026' && cnt(b3) === '3' && c.querySelectorAll('.journal-rownote-item').length === 3
        && !!b3 && b3.classList.contains('is-open'),
        'post ' + JSON.stringify({ a: p.action, s: p.scope, k: p.row_key === K.leaf, t: p.note_text, snap: snap }) + ' | ' + brief(b3)
        + ' items ' + c.querySelectorAll('.journal-rownote-item').length);

    // The icon again closes it.
    clickEl(findBtn(K.leaf));
    await sleep(150);
    rec('C-nested-again', cards().length === 0 && findBtn(K.leaf).getAttribute('aria-expanded') === 'false', 'cards ' + cards().length + ' ' + brief(findBtn(K.leaf)));

    // One card at a time.
    clickEl(findBtn(K.leaf)); await sleep(120);
    clickEl(findBtn(K.grp)); await sleep(150);
    rec('C-nested-one', cards().length === 1 && cards()[0].getAttribute('data-pvn-key') === K.grp
        && !findBtn(K.leaf).classList.contains('is-open') && findBtn(K.grp).classList.contains('is-open'),
        'cards ' + cards().length + ' key ' + (cards()[0] && cards()[0].getAttribute('data-pvn-key')));

    // Its head band closes it and hands focus back to the icon.
    var band = cards()[0] && cards()[0].querySelector('.journal-rownote-close');
    if (band) clickEl(band);
    await sleep(150);
    rec('C-nested-band', cards().length === 0 && document.activeElement === findBtn(K.grp), 'cards ' + cards().length + ' focus on icon ' + (document.activeElement === findBtn(K.grp)));

    // Escape is the editors' console key: it never closes a note (user, 2026-10-02).
    clickEl(findBtn(K.leaf));
    await until(function () { return cards().length === 1; }, 2000);
    await sleep(150);
    window.__wantKeys = ['Escape'];
    await until(function () { return window.__keysSent; }, 5000);
    await sleep(300);
    rec('C-nested-esc', !!window.__keysSent && cards().length === 1, 'keys sent ' + !!window.__keysSent + ', cards ' + cards().length);

    // It follows its icon when the page scrolls. The focus handed back to the group's
    // icon above scrolled #results-wrapper (it scrolls here: 412px of pivot in 250), so
    // the leaf's icon is brought back into the box first - a card whose icon is out of
    // the box hides (round 6, 2026-10-07).
    var iv = findBtn(K.leaf);
    if (iv) iv.scrollIntoView({ block: 'center' });
    await sleep(300);
    var c0 = cards()[0], i0 = findBtn(K.leaf);
    var ct0 = c0 ? c0.getBoundingClientRect().top : NaN, it0 = i0 ? i0.getBoundingClientRect().top : NaN;
    window.scrollBy(0, 40);
    await sleep(300);
    var c1 = cards()[0], i1 = findBtn(K.leaf);
    var dc = (c1 ? c1.getBoundingClientRect().top : NaN) - ct0, di = (i1 ? i1.getBoundingClientRect().top : NaN) - it0;
    rec('C-nested-follow', di <= -30 && Math.abs(dc - di) <= 2, 'icon moved ' + Math.round(di) + ', card moved ' + Math.round(dc));
    window.scrollBy(0, -40);
    await sleep(200);

    // A group's card stays with the group when it collapses: the group's icon is
    // on its summary row then. (In view first: a card whose icon is out of
    // #results-wrapper's box hides - round 6, 2026-10-07.)
    var gv = findBtn(K.grp);
    if (gv) gv.scrollIntoView({ block: 'center' });
    await sleep(300);
    clickEl(findBtn(K.grp));
    await until(function () { return cards().length === 1 && cards()[0].getAttribute('data-pvn-key') === K.grp; }, 2000);
    var chev = chevron('Sciences');
    if (chev) clickEl(chev);
    await sleep(700);
    var gNow = findBtn(K.grp), gTr = gNow && gNow.closest('tr');
    rec('C-nested-collapse', !!chev && drawnLeafCount('Sciences') === 0 && cards().length === 1 && !!gNow && !!gTr
        && gTr.classList.contains('pivot-group-summary-row') && gNow.classList.contains('is-open') && near(cards()[0], gNow),
        'chevron ' + !!chev + ' Sciences rows ' + drawnLeafCount('Sciences') + ' cards ' + cards().length + ' icon on summary row '
        + !!(gTr && gTr.classList.contains('pivot-group-summary-row')) + ' ' + brief(gNow) + ' near ' + near(cards()[0], gNow));

    // Put the pivot away: the card goes with it.
    $('#pivot-output-container').hide();
    await sleep(700);
    rec('C-nested-away', cards().length === 0, 'cards ' + cards().length);
    $('#pivot-output-container').show();
  };

  // ---- the other layouts and row-field shapes ------------------------------
  S.static = async function () {
    var bl = checkLeafIcons(1, ['DEPT', 'FY']), bg = checkGroupIcons('DEPT', DEPTS);
    var sums = tbl() ? tbl().querySelectorAll('tr.pivot-group-summary-row').length : -1;
    rec('V-static', !!tbl() && leafRows().length === 9 && !bl.length && !bg.length && sums === 0 && btns().length === 12,
        'leaf: ' + (bl.slice(0, 2).join(' | ') || 'ok') + ' group: ' + (bg.slice(0, 2).join(' | ') || 'ok') + ' summary rows ' + sums + ' icons ' + btns().length);
  };
  S.flat = async function () {
    var bl = checkLeafIcons(0, ['DEPT', 'FY']);
    var second = leafRows().filter(function (tr) { var td = cellOf(tr, 1); return td && td.querySelector('.journal-pvnote-btn'); }).length;
    var groups = btns().filter(function (b) { return b.classList.contains('is-group'); }).length;
    rec('V-flat', !!tbl() && leafRows().length === 9 && !bl.length && second === 0 && groups === 0 && btns().length === 9 && cnt(findBtn(K.leaf)) === '2',
        (bl.slice(0, 3).join(' | ') || 'first cells ok') + ' | icons in 2nd cells ' + second + ', group icons ' + groups + ', total ' + btns().length + ', leaf ' + brief(findBtn(K.leaf)));
  };
  // A DEPT-only pivot's row shares the thread of the DEPT group in a DEPT x FY pivot.
  S.single = async function () {
    var bl = checkLeafIcons(0, ['DEPT']);
    rec('V-single', !!tbl() && leafRows().length === 3 && !bl.length && cnt(findBtn(K.grp)) === '1',
        (bl.slice(0, 3).join(' | ') || 'rows ok') + ' | Sciences ' + brief(findBtn(K.grp)));
  };
  // The order of the row fields does not matter: FY x DEPT finds the DEPT x FY notes.
  S.reorder = async function () {
    var bl = checkLeafIcons(1, ['FY', 'DEPT']), bg = checkGroupIcons('FY', FYS);
    var tr = findBtn(K.leaf) && findBtn(K.leaf).closest('tr');
    rec('V-reorder', !!tbl() && !bl.length && !bg.length && cnt(findBtn(K.leaf)) === '2' && !!tr && tr.getAttribute('data-pivot-row') === 'FY2026|||Engineering',
        (bl.concat(bg).slice(0, 3).join(' | ') || 'icons ok') + ' | leaf ' + brief(findBtn(K.leaf)) + ' on row ' + (tr && tr.getAttribute('data-pivot-row')));
  };
  // A Top-N "(Other)" row takes no note.
  S.rank = async function () {
    var isOther = function (tr) { var td = tr.querySelector(':scope > td'); return !!td && td.textContent.trim().indexOf('(Other)') === 0; };
    var other = bodyRows().filter(isOther)[0] || null;
    var named = bodyRows().filter(function (tr) { return !isOther(tr); });
    var bad = named.filter(function (tr) { var td = cellOf(tr, 0); return !td || td.querySelectorAll('.journal-pvnote-btn').length !== 1; }).length;
    rec('P-rank-other', !!other && named.length === 3, 'other row ' + !!other + ', named rows ' + named.length);
    rec('V-rank', !!other && !other.querySelector('.journal-pvnote-btn') && named.length === 3 && bad === 0,
        'other has icon ' + !!(other && other.querySelector('.journal-pvnote-btn')) + ', named without exactly one ' + bad);
  };

  // ---- collapsed groups, rows built on demand -----------------------------
  S.collapsed = async function () {
    var lazy = !!(tbl() && tbl().hasAttribute('data-pnb-lazy'));
    rec('P-collapsed-lazy', lazy && drawnLeafCount('Engineering') === 0, 'lazy ' + lazy + ', leaf rows built ' + leafRows().length);
    var bad = DEPTS.filter(function (d) {
      var b = findBtn(pk([['DEPT', d]])), tr = b && b.closest('tr');
      return !b || !tr.classList.contains('pivot-group-summary-row') || !b.classList.contains('is-group');
    });
    rec('V-collapsed-sum', !bad.length && cnt(findBtn(K.grp)) === '1', 'groups without a drawn summary-row icon: ' + (bad.join(', ') || 'none') + ' | Sciences ' + brief(findBtn(K.grp)));
    var chev = chevron('Engineering');
    if (chev) clickEl(chev);
    await until(function () { return drawnLeafCount('Engineering') === 3; }, 3000);
    await sleep(500);   // the observer's paint (rAF / 120 ms)
    var eng = leafRows().filter(function (tr) { return drawn(tr) && partsOf(tr)[0] === 'Engineering'; });
    var badLeaf = eng.filter(function (tr) {
      var td = cellOf(tr, 1), b = td && td.querySelector('.journal-pvnote-btn');
      return !b || b.getAttribute('data-pvn-key') !== pk([['DEPT', 'Engineering'], ['FY', partsOf(tr)[1]]]);
    }).length;
    rec('V-collapsed-built', !!chev && eng.length === 3 && badLeaf === 0 && cnt(findBtn(K.leaf)) === '2',
        'chevron ' + !!chev + ', Engineering rows drawn ' + eng.length + ', without the right icon ' + badLeaf + ', leaf ' + brief(findBtn(K.leaf)));
  };

  // ---- the jump from the journal panel ------------------------------------
  S.reveal = async function () {
    rec('P-reveal-closed', drawnLeafCount('Engineering') === 0, 'Engineering rows drawn ' + drawnLeafCount('Engineering'));
    var ok = window.Penumbra && window.Penumbra.revealPivotNote ? window.Penumbra.revealPivotNote(K.leaf) : 'none';
    await sleep(400);
    var b = findBtn(K.leaf), td = b && b.closest('td');
    rec('R-reveal', ok === true && drawnLeafCount('Engineering') === 3 && cards().length === 1 && cards()[0].getAttribute('data-pvn-key') === K.leaf
        && !!td && td.classList.contains('journal-pvnote-flash'),
        'returned ' + ok + ', Engineering rows ' + drawnLeafCount('Engineering') + ', cards ' + cards().length + ', flash ' + !!(td && td.classList.contains('journal-pvnote-flash')));
    var ok2 = window.Penumbra && window.Penumbra.revealPivotNote ? window.Penumbra.revealPivotNote(pk([['PI', 'Ada']])) : 'none';
    await sleep(200);
    var txt = document.body.textContent;
    rec('R-reveal-other', ok2 === false && /Set this pivot/.test(txt) && /rows are PI/.test(txt), 'returned ' + ok2 + ', toast ' + /Set this pivot/.test(txt));
  };

  // ---- the switch: on without a key, saved without one --------------------
  S.off = async function () {
    rec('V-off-none', !!tbl() && btns().length === 0, 'icons ' + btns().length);
    if (window.Penumbra && window.Penumbra.syncJournalRowConfigUI) window.Penumbra.syncJournalRowConfigUI();
    await sleep(150);
    var rn = document.getElementById('journalRowNotesEnable');
    var lock = $('#journalRowCfgLock').text();
    var notesBlk = document.querySelector('#journalRowCfgStep2 .journal-rowcfg-notes');
    rec('K-off-panel', !!rn && !rn.disabled && /Toggle columns/.test(lock) && /step 1/i.test(lock) && $('#journalAddToggleBtn').prop('disabled')
        && !!notesBlk && getComputedStyle(notesBlk).opacity === '1',
        'switch disabled ' + (rn && rn.disabled) + ', lock "' + lock + '", notes block opacity ' + (notesBlk && getComputedStyle(notesBlk).opacity));
    if (!rn) { fail(['K-off-on', 'K-off-counts', 'K-off-status', 'K-off-noflat', 'K-off-saved', 'K-off-off'], 'no switch'); return; }
    rn.click();   // a real click: a disabled box ignores it
    await until(function () { return btns().length > 0; }, 3000);
    await sleep(500);
    rec('K-off-on', rn.checked && btns().filter(drawn).length === 12, 'checked ' + rn.checked + ', icons drawn ' + btns().filter(drawn).length);
    rec('K-off-counts', cnt(findBtn(K.leaf)) === '2' && cnt(findBtn(K.grp)) === '1', 'leaf ' + brief(findBtn(K.leaf)) + ' | group ' + brief(findBtn(K.grp)));
    var st = ($('#journalToggleStatus').text() || '').replace(/\s+/g, ' ');
    rec('K-off-status', /pivot/i.test(st) && /step 1/i.test(st), 'status "' + st + '"');
