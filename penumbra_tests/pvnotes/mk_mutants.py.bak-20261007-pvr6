if os.path.exists(p): old = json.load(open(p, encoding='utf-8'))
texts = {k: open(os.path.join(base, rel), 'rb').read().decode('utf-8', 'surrogateescape') for k, rel in FILES.items()}
out, bad = {}, 0
for name, (f, edits, must) in M.items():
    for a, b in edits:
        n = texts[f].count(a)
        if n != 1: print('ANCHOR %s: found %d times in %s: %r' % (name, n, f, a[:80])); bad += 1
    keep = old.get(name, {}).get('must') if name in old else None
    out[name] = {'file': f, 'edits': [list(e) for e in edits], 'must': must if must is not None else keep, 'scn': SCN.get(name)}
json.dump(out, open(p, 'w', encoding='utf-8', newline='\n'), indent=1, ensure_ascii=False)
print('%d mutants, %d bad anchors' % (len(out), bad))
sys.exit(1 if bad else 0)
