    $ownerPill = $own && !$na;
    $pills = ($isAdm ? 'Administrator' : ($edit ? 'Report Editor' : 'Explorer')) . ($ownerPill ? '+Owner' : '');
    T('P1', "editor flag: $lab", $r['edit'] === $edit, 'got ' . var_export($r['edit'], true) . ' want ' . var_export($edit, true));
    T('P2', "scheduler flag: $lab", $r['sched'] === $sched, 'got ' . var_export($r['sched'], true) . ' want ' . var_export($sched, true));
