// ---- stubs: the same semantics as db_connection.php / report_auth.php -------
function penumbraWildcardMatch($pattern, $sid) { return fnmatch(strtoupper(trim($pattern)), strtoupper(trim($sid))); }
function penumbraReportGrantMatches($grants, $shortId) {
    if (empty($grants['reports']) || $shortId === '' || $shortId === null) return false;
    foreach ($grants['reports'] as $rg) { if (penumbraWildcardMatch($rg['pattern'], (string)$shortId)) return true; }
    return false;
}
function penumbraReportGrantAllowsScheduler($grants, $shortId) {
    if (empty($grants['reports']) || $shortId === '' || $shortId === null) return false;
    foreach ($grants['reports'] as $rg) { if (!empty($rg['scheduler']) && penumbraWildcardMatch($rg['pattern'], (string)$shortId)) return true; }
    return false;
}
function penumbraIsReportOwner($ownerId, $userKey) {
    $u = strtoupper(trim((string)$userKey));
    if ($u === '') return false;
    return strtoupper(trim((string)$ownerId)) === $u;
}
// report_auth.php's: the admin bypass reads the GLOBAL $isAdmin (cleared by &noadm).
function checkAuthorization($authorized_list, $user_id, $user_ouc) {
    global $isAdmin;
    $authorized_list = trim((string)$authorized_list);
    if ($isAdmin) return true;
    if (strtolower($authorized_list) === 'public') return true;
    foreach (explode(',', $authorized_list) as $it) { if (strcasecmp(trim($it), $user_id) === 0) return true; }
    return false;
}

// ---- lifts ------------------------------------------------------------------
function cut($src, $a, $b, $what) {
    $i = strpos($src, $a);
    if ($i === false) fatal("$what: start anchor missing: $a");
    $j = strpos($src, $b, $i + strlen($a));
    if ($j === false) fatal("$what: end anchor missing: $b");
    if (strpos($src, $a, $i + 1) !== false) fatal("$what: start anchor is not unique: $a");
    return substr($src, $i, $j - $i);
}
function once($src, $re, $what) {
    $n = preg_match_all($re, $src, $m);
    if ($n !== 1) fatal("$what: expected exactly one match of $re, found $n");
    return $m[0][0];
}

