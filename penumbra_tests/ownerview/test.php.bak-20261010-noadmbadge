function fatal($m) { echo 'FATAL|' . str_replace(array("\r", "\n"), ' ', $m) . "\n"; exit(2); }
function rd($dir, $f) {
    $p = $dir . DIRECTORY_SEPARATOR . $f;
    if (!is_file($p)) fatal("missing $p");
    return str_replace("\r\n", "\n", file_get_contents($p));
}
set_error_handler(function ($no, $str, $file, $line) {
    // An undefined variable inside a lifted block means the block reads state
    // this harness does not model: that is a harness gap, never a pass.
    fatal("PHP error $no: $str (line $line of an eval'd block)");
});

