// ---- the index.php matrix -------------------------------------------------------
function idx_run($code, $sc) {
    global $isAdmin;
    // What index.php holds at those points. $isAdmin is db_connection.php's, which
    // &noadm has already cleared; the global copy is checkAuthorization's.
    $isAdmin = $sc['adm'] && !$sc['noadm'];
    $GLOBALS['isAdmin'] = $isAdmin;
    $noadm = $sc['noadm'] ? 1 : 0;
    $userGrants = array('reports' => array(), 'sql' => array());
    if ($sc['grant'] > 0) $userGrants['reports'][] = array('pattern' => 'R*', 'scheduler' => $sc['grant'] > 1);
    $currentUserKey = 'ada';
    $user_ouc = '140101';
    $_GET = array('id' => 'R1');
    $owner_id = $sc['owner'] ? 'ADA ' : 'zed';
    $authorized_list = $sc['auth'] ? 'bob, ada' : 'adminonly';
    $preloaded_state_json = $sc['jrn'] ? '{"viewOptions":{"journalEnabled":true}}' : '{"viewOptions":{}}';
    eval($code['role']);
    eval($code['promo']);
    $view = (bool)eval('return (' . $code['cond'] . ');');
    eval($code['jrn']);
    eval($code['sb']);
    ob_start();
    eval('?>' . $code['pills']);
    $html = ob_get_clean();
    preg_match_all('/<span class="sb-urole [^"]*">([^<]+)<\/span>/', $html, $pm);
    return array('edit' => (bool)$canEditLoadedReport, 'sched' => (bool)$canScheduleLoadedReport, 'view' => $view,
                 'cls' => trim($admin_class), 'jrn' => (bool)$pnbJrnWanted, 'owner' => (bool)$sb_is_owner,
                 'pills' => implode('+', $pm[1]),
                 // null = the build has no such flag (before 2026-10-01's fix)
                 'acc' => isset($pnbJrnAccess) ? (bool)$pnbJrnAccess : null);
}

$n = 0;
