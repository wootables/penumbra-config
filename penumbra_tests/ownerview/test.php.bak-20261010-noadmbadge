    T('P7', "role pills rendered: $lab", $r['pills'] === $pills, "got '{$r['pills']}' want '$pills'");
    T('P8', "journal API access (penumbra_vars.journalAccess): $lab", $r['acc'] === $acc, 'got ' . var_export($r['acc'], true) . ' want ' . var_export($acc, true));
    $n++;
}

