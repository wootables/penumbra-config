foreach (array(0, 1) as $na) foreach (array(0, 1) as $au) foreach (array(false, true) as $jr) {
    $sc = array('adm' => $adm, 'owner' => $own, 'grant' => $gr, 'noadm' => $na, 'auth' => $au, 'jrn' => $jr);
    $lab = ($adm ? 'admin' : 'user') . ($own ? '+owner' : '') . ($gr === 2 ? '+grant(sched)' : ($gr ? '+grant' : ''))
         . ($na ? ' &noadm' : '') . ($au ? ' authorized' : '') . ($jr ? ' journal-on' : '');
    $r = idx_run($code, $sc);
    $isAdm = $adm && !$na;
    $edit = $isAdm || (!$na && ($gr > 0 || $own));
    $sched = $isAdm || (!$na && $gr === 2);
    $view = $isAdm || $own || $gr > 0 || $au;
    $cls = $edit ? ($isAdm ? 'admin-view' : 'admin-view scoped-editor') : '';
    // manage_journal.php's journalCallerCanView: admin, owner, a report grant (since
    // 2026-10-02, noadm5 - a VIEW term, so on under &noadm too) or the access list.
    // The peek, and so the preload, needs it on top of edit.
    $acc = $isAdm || $own || $gr > 0 || $au;
