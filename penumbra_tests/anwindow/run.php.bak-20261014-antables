section('3b. bars sum to the window (synthetic rows every 7 min over 3 days)');
// Emulates the SQL exactly: window = TIMESTAMP >= (now - 1 day, wall clock);
// prior = [now - 2 days, now - 1 day); bucket = the row's local 'Y-m-d H'.
$simulate = function ($nowStr) use ($mk) {
    $now = $mk($nowStr);
    $lo = strtotime('-1 day', $now); $plo = strtotime('-2 days', $now);
    $by = array(); $byP = array(); $nWin = 0; $nPrior = 0;
    for ($ts = strtotime('-3 days', $now); $ts <= $now; $ts += 420) {
        $k = date('Y-m-d H', $ts);
        if ($ts >= $lo) { $nWin++; $by[$k] = ($by[$k] ?? 0) + 1; }
        elseif ($ts >= $plo) { $nPrior++; $byP[$k] = ($byP[$k] ?? 0) + 1; }
    }
    $ax = stg_penumbra_an_hour_axis($now);
    $sum = 0; $sumP = 0;
    foreach ($ax as $b) {
        $sum += $by[$b['key']] ?? 0;
        if ($b['prior'] !== null) $sumP += $byP[$b['prior']] ?? 0;
    }
    return array($nWin, $sum, $nPrior, $sumP, $byP);
};
foreach (array('2026-09-23 14:37:12', '2026-09-23 00:05:00', '2026-11-01 14:30:00', '2026-11-02 14:30:00', '2027-03-15 14:30:00') as $clock) {
    list($nWin, $sum, $nPrior, $sumP) = $simulate($clock);
    t_eq($sum, $nWin, "$clock: bars sum to the window count ($nWin)");
    t_eq($sumP, $nPrior, "$clock: dashed line sums to the prior count ($nPrior)");
}
