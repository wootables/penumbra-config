# =============================================================================
# PVSHADE SUITE (2026-10-10) - pivot shading: the pivot builder values table's options
# cog (None / Color scale / Data bars per value), saved as settings.aggShade.
#   page half   harness.html (mk_harness.py, from shade's; a pv* scenario = a saved
#               pivot with two values, Amt and N) + driver.js: the REAL main.js - the
#               rendered cells per value, the cog cell / menu / getter     L-*, E-*
#   php half    generate_pivot_html() from a side-effect-free mirror of the candidate
#               schedule_runner.php (pivotparity/extract_mirror.php) - test_pvshade.php  P-*
#
#   py -3 run.py [--stage DIR] [--control] [--mutants | --mutant NAME]
# =============================================================================
import json, os, re, shutil, socket, subprocess, sys, tempfile, time, urllib.request
import websocket

HERE = os.path.dirname(os.path.abspath(__file__))
APP = r'\\oitras.oit.ncsu.edu\c$\inetpub\wwwroot\sponsor_migration\penumbra'
PHP = r'\\oitras.oit.ncsu.edu\d$\Utilities\PHP_8.2-p\php.exe'
EDGE = r'C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe'
LIBS = ['jquery-3.7.1.min.js', 'jquery-ui.min.js', 'moment.min.js', 'pako.min.js', 'codemirror.min.js', 'sql.min.js',
        'show-hint.js', 'foldcode.js', 'foldgutter.js', 'brace-fold.js', 'comment-fold.js', 'placeholder.js',
        'penumbra_snippet_help.js', 'purify.min.js', 'penumbra_template.js', 'penumbra_userseg.js']
SCN = ['pvbar', 'pvscale', 'pvnone']
SCN_Q = {}
CHK = {
    'pvbar': ['amtBars', 'countPlain', 'saved'],
    'pvscale': ['amtFills', 'countPlain', 'spread'],
    'pvnone': ['nothing', 'cogShows', 'getter', 'menu', 'pickSets', 'noneClears', 'allNoneIsNull'],
}
MUTANTS = {
    # main.js (CRLF)
    'j-ruleidx': ([('main', "                        if (aggIdx !== rule.pivotAggIdx) return;          // a \u2699 rule: its own row only\r\n", "")],
                  ['L-pvbar-countPlain'], ['pvbar']),
    'j-mode': ([('main', "                    mode: mode === 'bar' ? 'bar' : 'fill', pivotAggIdx: aggIdx\r\n", "                    mode: 'fill', pivotAggIdx: aggIdx\r\n")],
               ['L-pvbar-amtBars'], ['pvbar']),
    'j-getter': ([('main', "        return any ? out : null;\r\n    }\r\n    var PV_SHADE_LABEL", "        return null;\r\n    }\r\n    var PV_SHADE_LABEL")],
                 ['L-pvnone-getter'], ['pvnone']),
    'j-attr': ([('main', "        if (shade === 'scale' || shade === 'bar') $tr.attr('data-agg-shade', shade);\r\n", "")], ['L-pvnone-cogShows'], ['pvnone']),
    'j-pick': ([('main', "        if (mode) $tr.attr('data-agg-shade', mode); else $tr.removeAttr('data-agg-shade');\r\n", "")], ['L-pvnone-pickSets'], ['pvnone']),
    # schedule_runner.php (CRLF)
    # pvscale 2026-10-11: a colour scale = the column's own min..max, linear - each engine alone
    'j-scale': ([('main', "                    range: two ? null : (mode === 'bar' ? '0:p99' : null),\r\n", "                    range: two ? null : (mode === 'bar' ? '0:p99' : '0:'),\r\n"),
                 ('main', "                    curve: 'linear',\r\n                    range: two", "                    curve: (!two && mode === 'scale') ? 'log' : 'linear',\r\n                    range: two")],
                ['L-pvscale-spread'], ['pvscale']),
    'p-scale': ([('sr', "            'range' => $_two ? null : ($_mode === 'bar' ? '0:p99' : null),\r\n", "            'range' => $_two ? null : ($_mode === 'bar' ? '0:p99' : '0:'),\r\n"),
                 ('sr', "            'curve' => 'linear',\r\n            'range' => $_two", "            'curve' => (!$_two && $_mode === 'scale') ? 'log' : 'linear',\r\n            'range' => $_two")],
                ['P-E7'], []),
    'p-idx': ([('sr', "                    if ($_aggIdx !== $_hrule['pivotAggIdx']) continue;   // a builder rule: its own row only\r\n", "")], ['P-E6'], []),
    'p-outrank': ([('sr', "                    continue;                                            // ...which outranks the snippet's\r\n", "")], ['P-E5'], []),
    'p-mode': ([('sr', "            'mode' => $_mode === 'bar' ? 'bar' : 'fill', 'pivotAggIdx' => $_aggIdx,\r\n", "            'mode' => 'fill', 'pivotAggIdx' => $_aggIdx,\r\n")], ['P-E1'], []),
}

args = sys.argv[1:]
def opt(name, default=None):
    if name in args:
        i = args.index(name); v = args[i + 1]; del args[i:i + 2]; return v
    return default
def flag(name):
    if name in args: args.remove(name); return True
    return False
stage_dir = opt('--stage', None)
one_mutant = opt('--mutant', None)
all_mutants = flag('--mutants')
control = flag('--control')
scn_only = opt('--scn', None)
if scn_only: SCN = [scn_only]
if args: raise SystemExit('unknown arguments: %s' % ' '.join(args))
src_root = stage_dir or APP
def pick(rel):
    p = os.path.join(src_root, rel)
    return p if os.path.exists(p) else os.path.join(APP, rel)
RELS = {'main': os.path.join('js', 'main.js'), 'sr': 'schedule_runner.php', 'css': os.path.join('css', 'main.css')}
cand = {k: pick(v) for k, v in RELS.items()}
if control: cand = {k: os.path.join(APP, v) for k, v in RELS.items()}
def read_b(p): return open(p, 'rb').read().decode('utf-8', 'surrogateescape')

def hook(src):
    anchor = '$(document).ready(function () {'
    i = src.find(anchor)
    if i < 0 or i > 400: raise SystemExit('closure anchor not found')
    h = '\r\n;try { window.__HC = { addAgg: addAggregationRow, shades: getAggregationShades }; } catch (e) { window.__HC_ERR = String(e); }\r\n'
    out = src[:i] + ';(function () {' + h + src[i + len(anchor):]
    j = out.rfind('});')
    out = out[:j] + '})();' + out[j + 3:]
    hl = '    function hideLoading() {\r\n'
    if out.count(hl) != 1: raise SystemExit('hideLoading anchor count %d' % out.count(hl))
    return out.replace(hl, hl + '        window.__HC_HIDES = (window.__HC_HIDES || 0) + 1;\r\n')
def mutate(texts, name):
    t = dict(texts)
    for f, old, new in MUTANTS[name][0]:
        if t[f].count(old) != 1: raise SystemExit("mutant '%s': %s anchor found %d times: %r" % (name, f, t[f].count(old), old[:90]))
        t[f] = t[f].replace(old, new)
    return t

stage = tempfile.mkdtemp(prefix='pnb_pv_')
for f in LIBS: shutil.copyfile(os.path.join(APP, 'js', f), os.path.join(stage, f))
for f in ('density.css', 'penumbra_colwidths.css'): shutil.copyfile(os.path.join(APP, 'css', f), os.path.join(stage, f))
shutil.copyfile(os.path.join(APP, 'js', 'penumbra_colwidths.js'), os.path.join(stage, 'penumbra_colwidths.js'))
open(os.path.join(stage, 'help_stub.js'), 'wb').write(b'window.__HELP_STUB = "";\n')
for f in ('harness.html', 'driver.js'): shutil.copyfile(os.path.join(HERE, f), os.path.join(stage, f))
def free_port():
    s = socket.socket(); s.bind(('127.0.0.1', 0)); p = s.getsockname()[1]; s.close(); return p
hp, dp = free_port(), free_port()
srv = subprocess.Popen([sys.executable, '-m', 'http.server', str(hp), '--bind', '127.0.0.1', '--directory', stage], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
edge = subprocess.Popen([EDGE, '--headless=new', '--disable-gpu', '--no-sandbox', '--no-first-run', '--no-default-browser-check', '--disable-sync',
                         '--disable-extensions', '--user-data-dir=' + os.path.join(stage, 'p'), '--window-size=1500,900',
                         '--remote-debugging-port=%d' % dp, '--remote-allow-origins=*', 'about:blank'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
def jget(p, m='GET'):
    return json.loads(urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:%d%s' % (dp, p), method=m), timeout=15).read().decode())
for _ in range(150):
    try: jget('/json/version'); break
    except Exception: time.sleep(0.2)

def run_page(path):
    t = jget('/json/new?about:blank', 'PUT')
    ws = websocket.create_connection(t['webSocketDebuggerUrl'], timeout=300, suppress_origin=True)
    n = [0]
    def call(m, p=None):
        n[0] += 1; mid = n[0]
        ws.send(json.dumps({'id': mid, 'method': m, 'params': p or {}}))
        while True:
            r = json.loads(ws.recv())
            if r.get('id') == mid: return r.get('result', {})
    try:
        call('Network.enable'); call('Network.setCacheDisabled', {'cacheDisabled': True})
        call('Emulation.setFocusEmulationEnabled', {'enabled': True})
        call('Page.navigate', {'url': 'http://127.0.0.1:%d/%s' % (hp, path)})
        t0 = time.time()
        while time.time() - t0 < 300:
            time.sleep(0.25)
            v = call('Runtime.evaluate', {'expression': 'window.__HCDONE ? JSON.stringify(window.__HCRESULT) : null', 'returnByValue': True}).get('result', {}).get('value')
            if v: return json.loads(v)
        return {'fatal': 'timeout (300 s)'}
    finally:
        try: ws.close()
        except Exception: pass
        try: urllib.request.urlopen('http://127.0.0.1:%d/json/close/%s' % (dp, t['id']), timeout=10).read()
        except Exception: pass

def write_stage(texts):
    open(os.path.join(stage, 'main_hc.js'), 'wb').write(hook(texts['main']).encode('utf-8', 'surrogateescape'))
    open(os.path.join(stage, 'main.css'), 'wb').write(texts['css'].encode('utf-8', 'surrogateescape'))

def run_php(texts):
    d = tempfile.mkdtemp(prefix='pnb_pvp_')
    try:
        srp = os.path.join(d, 'sr.php'); mir = os.path.join(d, 'mirror.php')
        open(srp, 'wb').write(texts['sr'].encode('utf-8', 'surrogateescape'))
        out = []
        l = subprocess.run([PHP, '-n', '-l', srp], capture_output=True, text=True).stdout
        out.append(('P-lint-sr', 'No syntax errors' in l, l.strip()[:200]))
        subprocess.run([PHP, '-n', os.path.join(HERE, '..', 'pivotparity', 'extract_mirror.php'), srp, mir], capture_output=True, text=True)
        res = subprocess.run([PHP, '-n', os.path.join(HERE, 'test_pvshade.php'), mir, os.path.join(APP, 'themes_config.php')], capture_output=True, text=True)
        for line in res.stdout.splitlines():
            m = re.match(r'\s+(PASS|FAIL)\s+(\S+)\s+(.*)', line)
            if m: out.append(('P-' + m.group(2), m.group(1) == 'PASS', m.group(3)))
        if 'TOTAL' not in res.stdout: out.append(('P-ran', False, (res.stdout + res.stderr)[-400:]))
        return out
    finally:
        shutil.rmtree(d, ignore_errors=True)

def run_browser(scns):
    out = []
    for s in scns:
        r = run_page('harness.html?scn=%s%s' % (s, SCN_Q.get(s, '')))
        if r.get('fatal'):
            out.append(('F-' + s, False, (r.get('fatal') or '')[:400])); continue
        out.append(('E-' + s, not r.get('errors') and not r.get('hookErr'), 'errors %s %s' % (r.get('errors'), r.get('hookErr'))))
        chk = r.get('chk') or {}
        for c in CHK[s]:
            v = chk.get(c)
            out.append(('L-%s-%s' % (s, c), v is True, '%s%s' % (v, ('   info %s' % json.dumps(r.get('info'))[:400]) if v is not True else '')))
    return out

try:
    texts = {k: read_b(v) for k, v in cand.items()}
    print('under test: %s' % json.dumps(cand))
    if all_mutants or one_mutant:
        okc = bad = 0
        for m in ([one_mutant] if one_mutant else list(MUTANTS)):
            edits, must, scns = MUTANTS[m]
            t = mutate(texts, m)
            write_stage(t)
            res = run_php(t) + (run_browser(scns) if scns else [])
            red = [a for a, p, _ in res if not p]
            good = not [x for x in must if x not in red]
            okc += good; bad += (not good)
            print('  %s  mutant %-15s turns %s red   [red: %s]' % ('PASS' if good else 'FAIL', m, ' '.join(must), ' '.join(red)))
        print('SUMMARY mutants ok=%d bad=%d' % (okc, bad))
        print('RESULT: GREEN' if bad == 0 else 'RESULT: RED')
    else:
        write_stage(texts)
        res = run_php(texts) + run_browser(SCN)
        p = f = 0; failed = []
        for a, passed, d in res:
            print('  %s  %-30s %s' % ('PASS' if passed else 'FAIL', a, d[:400]))
            if passed: p += 1
            else: f += 1; failed.append(a)
        print('TOTAL pass=%d fail=%d   failed: %s' % (p, f, ' '.join(failed)))
        if control:
            # hold before the change: the fill case (both engines already agree on fills),
            # the page booting, the lint, the file reads, a text column with no chip
            absent = {'L-pvnone-nothing', 'P-E0', 'P-lint-sr', 'L-pvbar-countPlain', 'L-pvscale-countPlain', 'L-pvbar-saved'}   # absence checks hold before as after; 'saved' is the fixture
            sane = [a for a, passed, _ in res if passed and not a.startswith('E-') and a not in absent]
            print('CONTROL: %d checks red (expected); checks that hold WITHOUT the change: %s' % (f, ' '.join(sane) or 'none'))
            print('RESULT: GREEN' if not sane and f > 0 else 'RESULT: RED')
        else:
            print('RESULT: GREEN' if f == 0 and p > 0 else 'RESULT: RED')
finally:
    try: edge.kill()
    except Exception: pass
    try: srv.kill()
    except Exception: pass
    time.sleep(1)
    shutil.rmtree(stage, ignore_errors=True)
