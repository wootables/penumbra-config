<script>
  (function () { try { localStorage.clear(); } catch (e) {} })();
  window.PENUMBRA_THEMES = { 'theme-default': { label: 'Default' } };
  window.PENUMBRA_THEME_IDS = ['theme-default'];
  window.PENUMBRA_THEME_ALIASES = {};
  window.PENUMBRA_LANDING_DEFAULT_THEME = 'theme-default';
  (function () {
    var P = new URLSearchParams(location.search);
    var S = window.__SCN = P.get('scn') || 'flat';
    // ID is the comparison key; DEPT groups the rows 3 + 3. AMOUNT (currency) and
    // QTY are totalled by default through the name whitelist below.
    window.__COLS = ['ID', 'DEPT', 'NAME', 'AMOUNT', 'QTY', 'NOTE'];
    window.__LIVE = [
      { ID: '1', DEPT: 'A', NAME: 'Alpha',   AMOUNT: '$100.00', QTY: '1', NOTE: 'x' },
      { ID: '2', DEPT: 'A', NAME: 'Bravo',   AMOUNT: '$200.00', QTY: '2', NOTE: 'y' },
      { ID: '3', DEPT: 'A', NAME: 'Charlie', AMOUNT: '$300.00', QTY: '3', NOTE: 'z' },
      { ID: '4', DEPT: 'B', NAME: 'Delta',   AMOUNT: '$400.00', QTY: '4', NOTE: 'w' },
      { ID: '5', DEPT: 'B', NAME: 'Echo',    AMOUNT: '$500.00', QTY: '5', NOTE: 'v' },
      { ID: '6', DEPT: 'B', NAME: 'Foxtrot', AMOUNT: '$600.00', QTY: '6', NOTE: 'u' }
    ];
    // cmp: 1-2 Unchanged, 3 (AMOUNT) and 4 (QTY) Modified, 5-6 New, 7-8 Removed.
    window.__SNAP = [
      { ID: '1', DEPT: 'A', NAME: 'Alpha',   AMOUNT: '$100.00', QTY: '1',  NOTE: 'x' },
      { ID: '2', DEPT: 'A', NAME: 'Bravo',   AMOUNT: '$200.00', QTY: '2',  NOTE: 'y' },
      { ID: '3', DEPT: 'A', NAME: 'Charlie', AMOUNT: '$150.00', QTY: '3',  NOTE: 'z' },
      { ID: '4', DEPT: 'B', NAME: 'Delta',   AMOUNT: '$400.00', QTY: '40', NOTE: 'w' },
      { ID: '7', DEPT: 'C', NAME: 'Golf',    AMOUNT: '$700.00', QTY: '7',  NOTE: 't' },
      { ID: '8', DEPT: 'C', NAME: 'Hotel',   AMOUNT: '$800.00', QTY: '8',  NOTE: 's' }
    ];
    var st = {
      name: 'sumfx', query: 'SELECT ID, DEPT, NAME, AMOUNT, QTY, NOTE FROM SUMFX_FIXTURE', reportTitle: 'Badge formula fixture',
      theme: 'theme-default', density: 'standard', sortCriteria: [], noLimit: true,
      rowExpandDefault: false, resolverLinksDefault: false, rowsPerPage: '200', reportSnippet: ''
    };
    // Saved by its author with AMOUNT summarized by a Custom Formula.
    if (S === 'saved') {
      st.columnSummaries = { AMOUNT: 'formula' };
      st.columnSummaryFormulas = { AMOUNT: '{sum}/{count}' };
    }
    if (S === 'grouped') st.groupBy = 'DEPT';
    window.__STORED = st;
    window.penumbra_vars = {
      isAdmin: true, isGlobalAdmin: true, canEditReport: true, currentUserKey: 'harness', shibboleth: { ouc: '', dept: '' },
      tables: { oracle: [], pins: [], infoed: [], hr: [], fin: [] },
      imports: [], reports: [], themes: {}, prompts: {}, grants: [],
      totalExemptions: ['AMOUNT', 'QTY'],
      preloadedState: st
    };
  })();
  window.__queryDone = 0;
  window.__ajaxLog = [];
</script>
