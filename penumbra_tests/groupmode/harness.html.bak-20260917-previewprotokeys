<!doctype html>
<html><head><meta charset="utf-8"><title>group mode</title></head>
<body>
<!-- Minimal report DOM. rebuildGroupedView() reads the group column off
     #resultsTable > thead > tr#tableHeader th[data-colname] and the cell values
     off each row's td[data-column], so those two attributes must agree. The
     grouping picker is deliberately EMPTY: getCustomSelectValue() then returns
     '' and the rebuild falls back to currentGroupingColumn, which is what
     __GM.setLevels() drives. -->
<table id="resultsTable"><thead><tr id="tableHeader">
  <th data-colname="#" data-column="c0">#</th>
  <th data-colname="COLLEGE" data-column="c1">COLLEGE</th>
  <th data-colname="DEPT" data-column="c2">DEPT</th>
  <th data-colname="AWARD_DATE" data-column="c3">AWARD_DATE</th>
  <th data-colname="AMOUNT" data-column="c4">AMOUNT</th>
  <th data-colname="ACTIVE" data-column="c5">ACTIVE</th>
</tr></thead><tbody></tbody></table>
<div id="groupedResultsContainer" style="display:none"></div>
<div id="pnbNoSearchMatches" style="display:none"></div>
<input id="tableSearch" value="">
<div id="pivot-output-container" style="display:none"></div>
<div id="snapshotComparisonContainer" style="display:none"></div>
<div id="errorBox"></div>
<div id="undo_text_container"></div>
<!-- main.js initialises the CodeMirror editors during ready, unconditionally,
     so these must exist even though group mode never uses them. Without them
     init throws and the closure never assigns PENUMBRA_PIVOT_SPLITS. -->
<div id="editorTabs"></div><div id="reportSnippetOutput"></div><div id="mainReportSubtitle"></div>
<textarea id="sqlQuery"></textarea><textarea id="reportSnippet"></textarea><textarea id="subquerySql"></textarea>
<select id="rowsPerPageSelector"><option value="100">100</option></select>
<a href="#" id="expandAllGroups">Expand all</a><a href="#" id="collapseAllGroups">Collapse all</a>
<!-- Copy Snippet writer surface. main.js binds #copyGroupSnippetBtn directly at
     ready time, so it and the fields it reads must exist BEFORE main.js loads. -->
<div id="groupingLightbox" style="display:none"></div>
<input type="checkbox" id="groupAggCheckbox">
<div id="groupAggOptions" style="display:none"></div>
<select id="groupAggType"><option value="sum">sum</option><option value="avg">avg</option></select>
<select id="groupSortSelect">
  <option value="label|asc">label asc</option><option value="label|desc">label desc</option>
  <option value="count|asc">count asc</option><option value="count|desc">count desc</option>
</select>
<button id="copyGroupSnippetBtn" type="button">Snippet</button>
<div id="groupingColumnSelector" class="penumbra-custom-select">
  <div class="pcs-selected" data-value=""></div><div class="pcs-dropdown"></div>
</div>
<div id="groupLevel2Row" style="display:none">
  <div id="groupingColumnSelector2" class="penumbra-custom-select">
    <div class="pcs-selected" data-value=""></div><div class="pcs-dropdown"></div>
  </div>
</div>
<div id="groupLevel3Row" style="display:none">
  <div id="groupingColumnSelector3" class="penumbra-custom-select">
    <div class="pcs-selected" data-value=""></div><div class="pcs-dropdown"></div>
  </div>
</div>
<div id="groupAggColumn" class="penumbra-custom-select">
  <div class="pcs-selected" data-value=""></div><div class="pcs-dropdown"></div>
</div>
<!-- The rest of the grouping dialog's controls, and the Reset button that
     clears them. main.js binds #resetGroupingBtn at ready time, so the button
     has to exist BEFORE main.js loads or the handler is never wired and the
     reset phase would silently assert against an inert click. -->
<select id="groupStartDepth">
  <option value="0">Collapsed</option><option value="1">Level 1</option>
  <option value="2">Level 2</option><option value="3">All levels</option>
</select>
<select id="groupLimitDir"><option value="top">top</option><option value="bottom">bottom</option></select>
<input type="text" id="groupLimitN"><input type="text" id="groupLimitMinRows">
<input type="checkbox" id="groupLimitOther" checked>
<div id="groupSummaryFilterHint" style="display:none"></div>
<button id="resetGroupingBtn" type="button">Reset</button>
<!-- The shared preset engine mounts its chip here. Must exist before main.js
     runs _groupMountPresetChip() at ready, or the control is never created,
     _groupPresetCtl stays null, and the reset handler's guarded call to
     setLoaded(null) becomes a no-op that asserts nothing. -->
<div id="groupPresetMount"></div>
<pre id="out">running</pre>

<script src="jquery-3.7.1.min.js"></script>
<script src="jquery-ui.min.js"></script>
<script src="moment.min.js"></script>
<script src="pako.min.js"></script>
<script src="codemirror.min.js"></script>
<script src="sql.min.js"></script>
<script src="show-hint.js"></script>
<script src="foldcode.js"></script>
<script src="foldgutter.js"></script>
<script src="brace-fold.js"></script>
<script src="comment-fold.js"></script>
<script src="placeholder.js"></script>
<script src="penumbra_snippet_help.js"></script>
<script src="purify.min.js"></script>
<script src="penumbra_template.js"></script>
<!-- Before main.js, matching index.php's own order: main.js's ready handler
     calls _groupMountPresetChip(), which needs window.PenumbraPresets to exist. -->
<script src="penumbra_presets.js"></script>
<script>
  // Same boot stubs as the pivot_trigger / parity harnesses.
  window.penumbra_vars = {
    isAdmin: true, isGlobalAdmin: true, currentUserKey: 'harness', shibboleth: { ouc: '', dept: '' },
    tables: { oracle: [], pins: [], infoed: [], hr: [], fin: [] },
    imports: [], reports: [], themes: {}, prompts: {}, grants: []
  };
  jQuery.ajax = function () { var d = jQuery.Deferred(); d.resolve({}); return d.promise(); };
  jQuery.getJSON = jQuery.ajax; jQuery.post = jQuery.ajax; jQuery.get = jQuery.ajax;
  // Synchronous show/hide AND slide: the fx ticker's rAF never fires under
  // --dump-dom, so an animated slideDown would leave .group-content at
  // display:none and every :visible assertion below would read wrong.
  // (Do NOT null requestAnimationFrame instead - main.js calls it during init
  // and the ready closure would die before binding anything.)
  jQuery.fx.off = true;
  window.ResizeObserver = function () {
    this.observe = function () {}; this.unobserve = function () {}; this.disconnect = function () {};
  };
  window.IntersectionObserver = window.ResizeObserver;
  if (!window.matchMedia) {
    window.matchMedia = function () { return { matches: false, addListener: function () {}, removeListener: function () {}, addEventListener: function () {}, removeEventListener: function () {} }; };
  }
  // Clipboard capture for the Copy Snippet handler (same stub the pivot_trigger
  // harness uses) - the writer's only observable output is what it writes here.
  window.__clip = null;
  if (!navigator.clipboard) { try { Object.defineProperty(navigator, 'clipboard', { value: {}, configurable: true }); } catch (e) {} }
  try { navigator.clipboard.writeText = function (s) { window.__clip = s; return Promise.resolve(); }; } catch (e) {}
  window.__errors = [];
  window.onerror = function (m, src, line) {
    window.__errors.push(String(m) + ' @' + String(src).split('/').pop() + ':' + line);
    try { var o = document.getElementById('out'); if (o && o.textContent === 'running') o.textContent = 'PAGE_ERROR: ' + window.__errors[0]; } catch (x) {}
    return true;
  };
</script>
<script src="main_patched.js"></script>
<script>
(function () {
  function report(txt) { document.getElementById('out').textContent = txt; }
  var results = [];
  function assert(name, cond, detail) { results.push({ name: name, pass: !!cond, detail: detail === undefined ? '' : String(detail) }); }
  function eq(name, got, want) { assert(name, got === want, 'got ' + JSON.stringify(got) + ' want ' + JSON.stringify(want)); }

  // --- Fixture -----------------------------------------------------------
  // Chosen so every level has an uneven fan-out (2/1 and 2/1), which is what
  // catches an off-by-one that a symmetric tree would hide. Fiscal years run
  // Jul-Jun named by the ENDING year, so the AWARD_DATE column spans FY24-FY26.
  var COLS = ['#', 'COLLEGE', 'DEPT', 'AWARD_DATE', 'AMOUNT', 'ACTIVE'];
  var DATA = [
    ['1', 'Eng', 'ECE',  '2024-03-15', '100000', '1'],
    ['2', 'Eng', 'ECE',  '2024-08-20', '250000', '0'],
    ['3', 'Eng', 'ME',   '2024-03-01', '50000',  '1'],
    ['4', 'Sci', 'BIO',  '2025-01-10', '75000',  '0'],
    ['5', 'Sci', 'BIO',  '2025-09-05', '300000', '1'],
    ['6', 'Sci', 'CHEM', '2024-11-11', '125000', '1']
  ];
  // FY per row (Jul 1 - Jun 30, named by ending year):
  //   r1 2024-03 -> FY24   r2 2024-08 -> FY25   r3 2024-03 -> FY24
  //   r4 2025-01 -> FY25   r5 2025-09 -> FY26   r6 2024-11 -> FY25

  function buildTable(rows) {
    rows = rows || DATA;
    var tb = document.querySelector('#resultsTable tbody');
    tb.innerHTML = '';
    for (var i = 0; i < rows.length; i++) {
      var tr = document.createElement('tr');
      for (var c = 0; c < COLS.length; c++) {
        var td = document.createElement('td');
        td.setAttribute('data-column', 'c' + c);
        td.textContent = rows[i][c];
        tr.appendChild(td);
      }
      tb.appendChild(tr);
    }
    var maps = rows.map(function (row) {
      var m = new Map();
      for (var c = 0; c < COLS.length; c++) m.set(COLS[c], row[c]);
      return m;
    });
    window.__GM.setRows(maps);
  }

  // Group values that collide with Object.prototype. The app reports over
  // arbitrary SQL, so a column holding the literal text "constructor" is not
  // exotic - and on a plain {} it CRASHES the grouping walk outright
  // (`if (!groups[v]) groups[v] = []` never fires, so the next .push runs
  // against the Object constructor). A plain-value fixture passes either way,
  // so only these names discriminate.
  var PROTO_DATA = [
    ['1', 'constructor',    'ECE', '2024-03-15', '100000', '1'],
    ['2', 'constructor',    'ME',  '2024-08-20', '250000', '0'],
    ['3', 'toString',       'ECE', '2024-03-01', '50000',  '1'],
    ['4', '__proto__',      'BIO', '2025-01-10', '75000',  '0'],
    ['5', '__proto__',      'BIO', '2025-09-05', '300000', '1'],
    ['6', 'hasOwnProperty', 'CHEM','2024-11-11', '125000', '1'],
    ['7', 'Eng',            'ECE', '2024-04-04', '10000',  '1']
  ];

  // Read the rendered tree back as plain nested objects, so assertions talk
  // about shape rather than about jQuery.
  function readTree($parent) {
    return $parent.children('.group-wrapper').map(function () {
      var $w = $(this);
      var $content = $w.children('.group-content');
      var kids = readTree($content);
      return {
        key: $w.attr('data-group-key'),
        path: $w.attr('data-group-path'),
        depth: $w.attr('data-group-depth'),
        col: $w.attr('data-group-col'),
        leaf: $w.hasClass('group-leaf'),
        branch: $w.hasClass('group-branch'),
        count: $w.children('.group-header').children('.group-count').text(),
        rows: $content.children('table').children('tbody').children('tr').length,
        kids: kids
      };
    }).get();
  }
  function tree() { return readTree($('#groupedResultsContainer')); }
  // Every data row must appear exactly once across the LEAVES - the single
  // cheapest guard against a recursion that duplicates or drops rows.
  function leafRowTotal(nodes) {
    var t = 0;
    for (var i = 0; i < nodes.length; i++) {
      t += nodes[i].leaf ? nodes[i].rows : leafRowTotal(nodes[i].kids);
    }
    return t;
  }
  // A miss returns a SENTINEL, never null: on a positive-control run half these
  // nodes legitimately do not exist, and a null here would throw on the first
  // .rows/.kids and abort the whole run as one opaque fatal instead of letting
  // each assertion fail on its own with a readable value.
  var MISSING = { key: null, path: null, depth: null, col: null,
                  leaf: false, branch: false, count: null, rows: -1, kids: [] };
  function group(nodes, key) {
    for (var i = 0; i < (nodes || []).length; i++) if (String(nodes[i].key) === key) return nodes[i];
    return MISSING;
  }

  // __GM2 is the nested-grouping API. When it is absent (a pre-nesting main.js -
  // the positive control) the harness still drives level 0 through the scalar,
  // so the single-level and bucket phases run and only the nesting assertions
  // fail. NESTED is the gate the nesting phases check.
  //
  // Assigned inside run(), NEVER here: main.js's body sits in $(document).ready,
  // which jQuery defers, so at the time THIS script executes neither hook set
  // exists yet. Reading it eagerly latched false on a perfectly good build and
  // produced 31 phantom failures.
  var NESTED = false;
  function regroup(levels) {
    if (NESTED) { window.__GM2.setLevels(levels); }
    else { window.__GM.setLevel0(levels[0] || null); }
    // CLEAR THE DIALOG PICKER FIRST. rebuildGroupedView() opens with
    //   getCustomSelectValue('groupingColumnSelector') || currentGroupingColumn
    // so the DIALOG wins over the level stack this helper just set. Phase I
    // drives that picker and leaves it on COLLEGE, and every phase after it
    // happened to use COLLEGE as level 0 - so a stale picker went unnoticed
    // until a phase asked for a different level 0 and silently got COLLEGE
    // back, complete with plausible-looking assertions failing for the wrong
    // reason. Blanking it makes the level stack authoritative, which is what
    // every caller here means.
    $('#groupingColumnSelector .pcs-selected').attr('data-value', '').text('-- None --');
    window.__GM.rebuild();
  }

  function run() {
    if (!window.__GM) {
      report('RESULTS_JSON:' + JSON.stringify({
        fatal: 'window.__GM missing - hook injection failed. __GM_ERR=' + String(window.__GM_ERR),
        pageErrors: window.__errors.slice(0, 6), results: []
      }));
      return;
    }
    NESTED = !!window.__GM2;
    try {
      buildTable();
      window.__GM.setAgg(null);
      window.__GM.setSort({ key: 'label', dir: 'asc' });
      window.__GM.setCustomSort({});

      // ================= A. SINGLE LEVEL = the invariant =================
      // Nesting must be strictly opt-in: with one level the renderer has to
      // produce exactly the flat shape it produced before the tree existed.
      regroup(['COLLEGE']);
      var t1 = tree();
      eq('1 level: two top-level groups', t1.length, 2);
      eq('1 level: every wrapper is a leaf', t1.filter(function (n) { return n.leaf; }).length, 2);
      eq('1 level: no branch wrappers', $('#groupedResultsContainer .group-branch').length, 0);
      eq('1 level: no nested wrappers at all', $('#groupedResultsContainer .group-wrapper .group-wrapper').length, 0);
      eq('1 level: Eng holds 3 rows', group(t1, 'Eng').rows, 3);
      eq('1 level: Sci holds 3 rows', group(t1, 'Sci').rows, 3);
      eq('1 level: every source row appears exactly once', leafRowTotal(t1), DATA.length);
      eq('1 level: depth is 0', group(t1, 'Eng').depth, '0');
      eq('1 level: path is the bare label', group(t1, 'Eng').path, 'Eng');
      eq('1 level: count pill is the row count', group(t1, 'Eng').count, '3');
      eq('1 level: data-group-col names the level column', group(t1, 'Eng').col, 'COLLEGE');
      eq('1 level: label sort puts Eng before Sci', t1[0].key, 'Eng');

      // ================= B. TWO LEVELS =================
      regroup(['COLLEGE', 'DEPT']);
      var t2 = tree();
      eq('2 levels: still two top-level groups', t2.length, 2);
      eq('2 levels: top level is a BRANCH', group(t2, 'Eng').branch, true);
      eq('2 levels: a branch owns no table of its own', group(t2, 'Eng').rows, 0);
      eq('2 levels: Eng splits into 2 departments', group(t2, 'Eng').kids.length, 2);
      eq('2 levels: Sci splits into 2 departments', group(t2, 'Sci').kids.length, 2);
      eq('2 levels: ECE holds 2 rows', group(group(t2, 'Eng').kids, 'ECE').rows, 2);
      eq('2 levels: ME holds 1 row', group(group(t2, 'Eng').kids, 'ME').rows, 1);
      eq('2 levels: CHEM holds 1 row', group(group(t2, 'Sci').kids, 'CHEM').rows, 1);
      eq('2 levels: no row duplicated or dropped', leafRowTotal(t2), DATA.length);
      eq('2 levels: child is a leaf', group(group(t2, 'Eng').kids, 'ECE').leaf, true);
      eq('2 levels: child depth is 1', group(group(t2, 'Eng').kids, 'ECE').depth, '1');
      eq('2 levels: child path carries its ancestor', group(group(t2, 'Eng').kids, 'ECE').path, 'Eng|||ECE');
      eq('2 levels: child data-group-col is the CHILD column', group(group(t2, 'Eng').kids, 'ECE').col, 'DEPT');
      eq('2 levels: branch count pill totals its children', group(t2, 'Eng').count, '3');
      eq('2 levels: sub-groups sort by label', (group(t2, 'Sci').kids[0] || MISSING).key, 'BIO');
      // A repeated label under two different parents must stay two distinct
      // nodes with distinct paths - this is what collapse state keys on.
      assert('2 levels: same label under different parents gets distinct paths',
        group(group(t2, 'Eng').kids, 'ECE').path !== group(group(t2, 'Sci').kids, 'BIO').path,
        'Eng|||ECE vs Sci|||BIO');

      // ================= C. THREE LEVELS, MIDDLE ONE BUCKETED =============
      regroup(['COLLEGE', 'AWARD_DATE:fy', 'DEPT']);
      var t3 = tree();
      eq('3 levels: two top-level groups', t3.length, 2);
      var eng = group(t3, 'Eng');
      eq('3 levels: Eng spans FY24 and FY25', eng.kids.length, 2);
      eq('3 levels: fiscal years are chronological', (eng.kids[0] || MISSING).key, 'FY24');
      eq('3 levels: FY24 under Eng holds 2 rows across its leaves', leafRowTotal([eng.kids[0] || MISSING]), 2);
      eq('3 levels: FY25 under Eng holds 1 row', leafRowTotal([eng.kids[1] || MISSING]), 1);
      var sci = group(t3, 'Sci');
      var engFy0 = eng.kids[0] || MISSING, engFy1 = eng.kids[1] || MISSING;
      var sciFy0 = sci.kids[0] || MISSING, sciFy1 = sci.kids[1] || MISSING;
      var deepest = (engFy0.kids && engFy0.kids[0]) || MISSING;
      eq('3 levels: Sci spans FY25 and FY26', sci.kids.length, 2);
      eq('3 levels: Sci fiscal years are chronological', sciFy0.key + '/' + sciFy1.key, 'FY25/FY26');
      eq('3 levels: bucketed level names its TOKEN as the column', engFy0.col, 'AWARD_DATE:fy');
      eq('3 levels: deepest node is a leaf', deepest.leaf, true);
      eq('3 levels: deepest depth is 2', deepest.depth, '2');
      eq('3 levels: deepest path has three segments', String(deepest.path).split('|||').length, 3);
      eq('3 levels: no row duplicated or dropped', leafRowTotal(t3), DATA.length);
      // FY24 under Eng is ECE(3/15) + ME(3/1) -> two separate departments.
      eq('3 levels: FY24 under Eng splits into 2 departments', engFy0.kids.length, 2);

      // ================= D. LEVEL CAP + MIRROR =================
      assert('nesting API is present (__GM2)', NESTED, 'GM2_ERR=' + String(window.__GM2_ERR));
      if (NESTED) {
        eq('cap: the ceiling is 3', window.__GM2.maxLevels(), 3);
        window.__GM2.setLevels(['COLLEGE', 'DEPT', 'AWARD_DATE', 'AMOUNT']);
        eq('cap: a fourth level is clamped away', window.__GM2.getLevels().length, 3);
        window.__GM2.setLevels(['COLLEGE', 'DEPT']);
        eq('mirror: currentGroupingColumn is level 0', window.__GM2.getLevel0(), 'COLLEGE');
        window.__GM2.setLevels([]);
        eq('mirror: an empty stack nulls the mirror', window.__GM2.getLevel0(), null);
        window.__GM2.setLevels('COLLEGE');
        eq('setter: a bare string is accepted as one level', window.__GM2.getLevels().length, 1);
        window.__GM2.setLevels(['COLLEGE', '', null]);
        eq('setter: blank levels are dropped', window.__GM2.getLevels().length, 1);
      }

      // ================= E. A MISSING LEVEL DEGRADES, NEVER THROWS ========
      regroup(['COLLEGE', 'NO_SUCH_COLUMN']);
      var tMissing = tree();
      eq('missing level: falls back to one level rather than failing', tMissing.length, 2);
      eq('missing level: outer level still renders leaves', tMissing.filter(function (n) { return n.leaf; }).length, 2);
      eq('missing level: rows are intact', leafRowTotal(tMissing), DATA.length);

      // ================= F. BUCKET HELPERS (reused by later work) =========
      var spec = window.__GM.bucketSpec('AWARD_DATE:fy');
      assert('bucketSpec: a token resolves', !!spec, String(spec));
      eq('bucketSpec: base is the column', spec ? spec.base : null, 'AWARD_DATE');
      eq('bucketSpec: fiscal year of a March date', spec ? spec.label('2024-03-15') : null, 'FY24');
      eq('bucketSpec: fiscal year of an August date', spec ? spec.label('2024-08-20') : null, 'FY25');
      eq('bucketSpec: blank in, blank out', spec ? spec.label('') : null, '');
      assert('bucketSpec: a plain column is not a bucket', window.__GM.bucketSpec('COLLEGE') === null, '');

      var lab = NESTED ? window.__GM2.labeler('AWARD_DATE:fy') : null;
      assert('labeler: resolves for a real column', typeof lab === 'function', typeof lab);
      var firstRow = document.querySelector('#resultsTable tbody tr');
      eq('labeler: reads the row and buckets it', lab ? lab(firstRow) : null, 'FY24');
      assert('labeler: a missing column returns null', NESTED && window.__GM2.labeler('NOPE') === null, '');

      // ACTIVE is 0/1 - it parses as numeric but has nothing to bin.
      eq('binWorthwhile: a 0/1 flag is not worth binning', window.__GM.binWorth('ACTIVE'), false);
      eq('variants: a boolean-ish numeric offers no buckets', window.__GM.variants('ACTIVE').length, 0);
      eq('variants: a text column offers no buckets', window.__GM.variants('COLLEGE').length, 0);
      assert('variants: a date column offers period buckets', window.__GM.variants('AWARD_DATE').length > 0,
        window.__GM.variants('AWARD_DATE').length);
      assert('variants: fiscal year is among them',
        window.__GM.variants('AWARD_DATE').some(function (v) { return v.token === 'AWARD_DATE:fy'; }), '');
      eq('variants: bucket tokens display as a friendly label',
        window.__GM.dispLabel('AWARD_DATE:fy'), 'AWARD_DATE (Fiscal Year)');

      // ================= G. CUSTOM SORT ORDER vs VARIANT ORDER ============
      // The variant's own calendar order applies when nothing overrides it...
      window.__GM.setCustomSort({});
      var cmpPlain = window.__GM.sortCmp('AWARD_DATE:fy');
      assert('sort: with no custom order, FY24 precedes FY25', cmpPlain('FY24', 'FY25') < 0, cmpPlain('FY24', 'FY25'));
      // ...and a custom order covering the labels outranks it.
      window.__GM.setCustomSort({ AWARD_DATE: { values: ['FY26', 'FY25', 'FY24'] } });
      var cmpCustom = window.__GM.sortCmp('AWARD_DATE:fy');
      assert('sort: a custom order flips the variant order', cmpCustom('FY24', 'FY25') > 0, cmpCustom('FY24', 'FY25'));
      assert('sort: and orders the whole list by it', cmpCustom('FY26', 'FY24') < 0, cmpCustom('FY26', 'FY24'));
      // A custom order for the column's RAW values matches no bucket label, so
      // it must degrade to the variant order rather than scrambling it.
      window.__GM.setCustomSort({ AWARD_DATE: { values: ['2025-09-05', '2024-03-15'] } });
      var cmpIrrel = window.__GM.sortCmp('AWARD_DATE:fy');
      assert('sort: an unrelated custom order degrades to the calendar',
        cmpIrrel('FY24', 'FY25') < 0, cmpIrrel('FY24', 'FY25'));
      // ...and the rendered tree agrees with the comparator.
      window.__GM.setCustomSort({ AWARD_DATE: { values: ['FY26', 'FY25', 'FY24'] } });
      regroup(['COLLEGE', 'AWARD_DATE:fy']);
      var tCustom = tree();
      eq('sort: the rendered fiscal bands follow the custom order',
        (group(tCustom, 'Eng').kids[0] || MISSING).key, 'FY25');
      window.__GM.setCustomSort({});

      // ================= H. COLLAPSE STILL WORKS AT DEPTH =================
      regroup(['COLLEGE', 'DEPT']);
      var $engHeader = $('#groupedResultsContainer .group-wrapper[data-group-path="Eng"]').children('.group-header');
      eq('collapse: the branch header exists', $engHeader.length, 1);
      $engHeader.trigger('click');
      assert('collapse: clicking a branch header opens it',
        $('#groupedResultsContainer .group-wrapper[data-group-path="Eng"]').hasClass('open'), '');
      var $eceHeader = $('#groupedResultsContainer .group-wrapper[data-group-path="Eng|||ECE"]').children('.group-header');
      eq('collapse: the nested leaf header exists', $eceHeader.length, 1);
      $eceHeader.trigger('click');
      assert('collapse: a nested leaf toggles independently of its parent',
        $('#groupedResultsContainer .group-wrapper[data-group-path="Eng|||ECE"]').hasClass('open'), '');
