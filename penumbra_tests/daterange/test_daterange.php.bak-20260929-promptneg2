/** Runs the ?json=1 branch; returns the SQL, or "REFUSED: <json error text>". */
function json_run($sql, $get = array()) {
    $level = ob_get_level();
    try {
        $out = dr_json_engine($sql, $get);
        while (ob_get_level() > $level) { ob_end_clean(); }
        return $out;
    } catch (DrExit $e) {
        while (ob_get_level() > $level) { ob_end_clean(); }
        $j = json_decode($e->getMessage(), true);
        return 'REFUSED: ' . (is_array($j) && isset($j['error']) ? $j['error'] : $e->getMessage());
    }
}
/** Runs the scheduler engine; returns the SQL, or "REFUSED: <exception text>". */
function runner_run($sql, $answers = array(), &$shown = null, &$byName = null, &$list = null) {
    $shown = array(); $byName = array(); $list = array();
    // 6th argument (2026-09-24): the positional data(promptN) list. An older
    // engine without the parameter simply ignores the extra argument.
    try { return process_scheduler_prompts($sql, $answers, $shown, $byName, array(), $list); }
    catch (Exception $e) { return 'REFUSED: ' . $e->getMessage(); }
}

