echo "\n=== 8. PARITY: same tag + same answer => the same SQL from both engines ===\n";
$parity = array(
    array('bare',               "WHERE d BETWEEN $T", '01-JUL-25..30-JUN-26'),
    array('quoted tag',         "WHERE d BETWEEN '$T' AND x = 1", '01-JUL-25..30-JUN-26'),
    array('rolling phrases',    "WHERE d BETWEEN $T", 'first day of last month..last day of last month'),
    array('keyword dates',      "WHERE d BETWEEN $T", 'TODAY-30..TODAY'),
    array('fiscal year',        "WHERE d BETWEEN $T", 'first day of last fiscal year..last day of last fiscal year'),
    array('quarter',            "WHERE d BETWEEN $T", 'first day of last quarter..last day of last quarter'),
    array('calendar year',      "WHERE d BETWEEN $T", 'first day of this year..last day of this year'),
    array('ISO + slash input',  "WHERE d BETWEEN $T", '2025-07-01..6/30/2026'),
    array('out-of-window year', "WHERE d BETWEEN $T", '01-JAN-1940..01-JAN-2055'),
    array('template from/to',   'WHERE 1=1 [PROMPT;type=date-range;name=awd;message=Award date;template="AND d >= :from AND d <= :to"]', '01-JUL-25..30-JUN-26'),
    array('template val',       'WHERE 1=1 [PROMPT;type=date-range;name=awd;message=Award date;template="AND d BETWEEN :val"]', '01-JUL-25..30-JUN-26'),
    array('control prompt',     'WHERE 1=1 [PROMPT;type=date-range;name=awd;message=Award date;template=""]', '01-JUL-25..30-JUN-26'),
    array('REFUSED: reversed',  "WHERE d BETWEEN $T", '30-JUN-26..01-JUL-25'),
    array('REFUSED: one date',  "WHERE d BETWEEN $T", '01-JUL-25'),
    array('REFUSED: not a date', "WHERE d BETWEEN $T", '01-JUL-25..whenever'),
);
// The grounds a refusal is made on. Each engine words a refusal its own way (an
// exception, a JSON body, a browser error); this substring is in all of them.
$refusalReason = array(
    'REFUSED: reversed'   => 'The From date must be on or before the To date.',
    'REFUSED: one date'   => 'A date range needs both a From and a To date',
    'REFUSED: not a date' => "'whenever' is not a date",
);
$fixture = array('today' => lit(time()), 'cases' => array());
foreach ($parity as $c) {
    $a = runner_run($c[1], array('awd' => $c[2]));
    $b = json_run($c[1], array('awd' => $c[2]));
    $isRefusal = isset($refusalReason[$c[0]]);
    // What the BROWSER engine must reproduce (daterange_browser_tests.js, part 4).
    $fixture['cases'][] = array(
        'label'   => $c[0],
        'sql'     => $c[1],
        'answer'  => $c[2],
        'refused' => $isRefusal,
        'reason'  => $isRefusal ? $refusalReason[$c[0]] : null,
        'php_sql' => $isRefusal ? null : $a,
    );
    if ($isRefusal) {
        check_contains('the scheduler refuses on the stated grounds: ' . $c[0], $a, $refusalReason[$c[0]]);
    }
    // A refusal is worded per engine (one is an exception, one a JSON body with a
    // URL hint); what must agree is THAT both refused, and on what grounds.
    if (strpos($a, 'REFUSED: ') === 0 || strpos($b, 'REFUSED: ') === 0) {
        $norm = function ($s) { return preg_replace('/ Supply it in the URL as .*$/', '', $s); };
        check('parity (refusal): ' . $c[0], $norm($b), $norm($a));
    } else {
        check('parity: ' . $c[0], $b, $a);
    }
}
