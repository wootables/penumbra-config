<script>
  // Fake server. query.php -> the fixture; manage_journal.php -> one store per report.
  function __tfRid(url, body) {
    var m = /[?&]report_id=([^&]*)/.exec(url);
    if (m) return decodeURIComponent(m[1]);
    return (body && body.report_id != null) ? String(body.report_id) : '';
  }
  function __tfJournal(url, opts) {
    var m = /[?&]action=([a-z_]+)/.exec(url);
    var action = m ? m[1] : null, body = null;
    if (opts.data) { try { body = JSON.parse(opts.data); if (!action) action = body.action; } catch (e) { } }
    var rid = __tfRid(url, body);
    var J = (rid === 'jrfix' || rid === '') ? window.__J : window.__J2;
    if (action === 'toggles') {
      if (window.__failToggles) return { status: 'error', message: 'Simulated outage.' };
      return { status: 'success', installed: true, toggles: JSON.parse(JSON.stringify(J.toggles)) };
    }
    if (action === 'row_notes') return { status: 'success', counts: JSON.parse(JSON.stringify(J.counts)), notes: JSON.parse(JSON.stringify(J.notes)) };
    if (action === 'summary') return { status: 'success', installed: true, total: 0, unseen: 0 };
    if (action === 'toggle_history') return { status: 'success', events: [] };
    if (action === 'toggle_history_search') {
      // The server's contract (Round D, 2026-10-08): user = case-insensitive CONTAINS,
      // toggle_key / state / from / to filters, mode=latest (one per row), a summary over
      // every change kept, and each event's row state NOW from the marks.
      var qs = function (k) { var m = new RegExp('[?&]' + k + '=([^&]*)').exec(url); return m ? decodeURIComponent(m[1]) : ''; };
      var u = qs('user').toLowerCase(), tkf = qs('toggle_key'), stf = qs('state'), latest = qs('mode') === 'latest', df = qs('from'), dt = qs('to');
      var evs = (window.__histEvents || []).filter(function (e) {
        var d = String(e.at || '').slice(0, 10);
        return (!u || String(e.by).toLowerCase().indexOf(u) >= 0) && (!tkf || e.toggle === tkf)
          && (stf === '' || String(e.state) === stf) && (!df || d >= df) && (!dt || d <= dt);
      });
      var sum = { changes: 0, marked: 0, unmarked: 0, rows: 0, people: [] }, rowsSeen = {}, ppl = {}, seen = {}, out = [];
      evs.forEach(function (e) {
        var rk = e.rowKey != null ? e.rowKey : (e.parts || []).join(window.__SEP);
        sum.changes++; sum[e.state === 1 ? 'marked' : 'unmarked']++; rowsSeen[e.toggle + '|' + rk] = 1;
        var p = ppl[e.by] || (ppl[e.by] = { user: e.by, marked: 0, unmarked: 0 });
        p[e.state === 1 ? 'marked' : 'unmarked']++;
        if (latest) { if (seen[e.toggle + '|' + rk]) return; seen[e.toggle + '|' + rk] = 1; }
        var mk = (J.toggles[e.toggle] || {})[rk], o = JSON.parse(JSON.stringify(e));
        o.rowKey = rk;
        o.now = mk ? { on: true, by: mk.by, at: mk.at } : { on: false };
        out.push(o);
      });
      sum.rows = Object.keys(rowsSeen).length;
      sum.people = Object.keys(ppl).map(function (k) { return ppl[k]; }).sort(function (a, b) {
        return ((b.marked + b.unmarked) - (a.marked + a.unmarked)) || (a.user < b.user ? -1 : (a.user > b.user ? 1 : 0));
      });
      return { status: 'success', truncated: false, events: out, summary: sum, partial: false, mode: latest ? 'latest' : 'all' };
    }
    if (action === 'list') return { status: 'success', installed: true, data: [], report: { title: 'Toggle fixes fixture' } };
    // The writes follow the server's contract (Round B, 2026-10-07): a row already in
    // the requested state is not written (no new maker, no new time) and the answer
    // says what the row holds now; a bulk answers with the keys it changed. (The
    // pre-Round-B server always wrote, and its answer had no unchanged / at - the
    // control build ignores those fields, so it reads both answers alike.)
    var NOW = '2026-10-07 12:00:00';
    function rowNow(tk, rk) {
      var m = J.toggles[tk] || {};
      if (Object.prototype.hasOwnProperty.call(m, rk)) return { state: 1, by: m[rk].by, at: m[rk].at };
      var z = window.__ZERO[tk + '|' + rk];
      return z ? { state: 0, by: z.by, at: z.at } : null;
    }
    function writeRow(tk, rk, on) {
      var cur = rowNow(tk, rk);
      if ((cur ? cur.state : 0) === (on ? 1 : 0)) return false;
      J.toggles[tk] = J.toggles[tk] || {};
      if (on) { J.toggles[tk][rk] = { by: 'harness', at: NOW }; delete window.__ZERO[tk + '|' + rk]; }
      else { delete J.toggles[tk][rk]; window.__ZERO[tk + '|' + rk] = { by: 'harness', at: NOW }; }
      return true;
    }
    if (action === 'set_toggle' && body) {
      J.posts.push(body);
      var changed = writeRow(body.toggle_key, body.row_key, !!body.state);
      var now = rowNow(body.toggle_key, body.row_key) || { state: 0, by: 'harness', at: null };
      return { status: 'success', state: now.state, unchanged: !changed, by: now.by, at: now.at };
    }
    if (action === 'set_toggles_bulk' && body) {
      J.posts.push(body);
      var ch = [];
      (body.row_keys || []).forEach(function (rk) { if (writeRow(body.toggle_key, rk, !!body.state)) ch.push(rk); });
      return { status: 'success', state: body.state ? 1 : 0, count: ch.length, skipped: (body.row_keys || []).length - ch.length, changed: ch, by: 'harness' };
    }
    if (body) J.posts.push(body);
    return { status: 'success' };
  }
  // ?jslow=<rid>:<ms> - that report's journal STATE answers <ms> late (the others 30 ms).
  var __tfSlow = (function () { var v = new URLSearchParams(location.search).get('jslow') || ''; var p = v.split(':'); return p.length === 2 ? { rid: p[0], ms: parseInt(p[1], 10) || 0 } : null; })();
  jQuery.ajax = function (a, b) {
    var opts = (typeof a === 'string') ? jQuery.extend({ url: a }, b || {}) : (a || {});
    var url = String(opts.url || '');
    window.__ajaxLog.push(url + (opts.data && typeof opts.data === 'string' ? ' ' + opts.data : ''));
    var d = jQuery.Deferred();
    var isQuery = /query\.php/.test(url);
    var isJournal = /manage_journal\.php/.test(url);
    var jState = isJournal && /[?&]action=(toggles|row_notes)/.test(url);
    if (jState) window.__jPending = (window.__jPending || 0) + 1;
    var delay = isJournal ? 30 : 0;
    if (jState && __tfSlow && __tfRid(url, null) === __tfSlow.rid) delay = __tfSlow.ms;
    // window.__tslow = N: the next toggle WRITE is applied and answered N ms later, as a
    // slow server would (a read made meanwhile does not see it yet).
    var isWrite = isJournal && opts.data && /"action":"set_toggle"/.test(String(opts.data));
    if (isWrite && window.__tslow) { delay = window.__tslow; window.__tslow = 0; }
    var resp = null;
    setTimeout(function () {
      resp = isQuery ? window.__queryResponse : (isJournal ? __tfJournal(url, opts) : {});
      try { if (opts.success) opts.success(resp, 'success', { status: 200 }); } catch (e) { window.__errors.push('ajax success threw: ' + String(e)); }
      try { if (opts.complete) opts.complete({ status: 200 }, 'success'); } catch (e) { window.__errors.push('ajax complete threw: ' + String(e)); }
      d.resolve(resp, 'success', { status: 200 });
      if (isQuery) window.__queryDone++;
      if (jState) window.__jPending--;
    }, delay);
    var p = d.promise(); p.abort = function () {}; return p;
  };
  jQuery.getJSON = function (u, x, cb) { return jQuery.ajax({ url: u, success: (typeof x === 'function') ? x : cb }); };
