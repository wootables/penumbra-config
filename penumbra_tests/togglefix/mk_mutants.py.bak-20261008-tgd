cache = {}
def text(rel):
    # A file the build directory does not carry is the live one (run.py does the same).
    if rel not in cache:
        p = os.path.join(D, *rel.split('/'))
        if not os.path.exists(p): p = os.path.join(APP, *rel.split('/'))
        cache[rel] = open(p, 'rb').read().decode('utf-8', 'surrogateescape').replace('\r\n', '\n')
    return cache[rel]
bad = 0
for name, (edits, must, scn) in M.items():
    for rel, old, new in edits:
        n = text(rel).count(old)
        if n != 1:
            print('ANCHOR %-16s %s: found %d times: %r' % (name, rel, n, old[:80])); bad += 1
if bad: raise SystemExit('%d anchor(s) wrong - mutants.json NOT written' % bad)
out = {k: {'edits': [list(e) for e in v[0]], 'must': v[1], 'scn': v[2]} for k, v in M.items()}
open(os.path.join(HERE, 'mutants.json'), 'w', encoding='utf-8', newline='\n').write(json.dumps(out, indent=1, ensure_ascii=False))
