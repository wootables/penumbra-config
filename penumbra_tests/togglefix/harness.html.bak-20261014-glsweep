<script>
  (function () { try { localStorage.clear(); } catch (e) {} })();
  // The registry rows the scenarios use: a dark theme (body.is-dark) and Wolfpack Red
  // (its blanket `button:hover:not(:disabled)` fill lives in main.css).
  window.PENUMBRA_THEMES = { 'theme-default': { label: 'Default' }, 'theme-dark-blue': { label: 'Dark Blue', isDark: true },
                             'theme-wolfpack': { label: 'Wolfpack Red' } };
  window.PENUMBRA_THEME_IDS = ['theme-default', 'theme-dark-blue', 'theme-wolfpack'];
  window.PENUMBRA_THEME_ALIASES = {};
  window.PENUMBRA_LANDING_DEFAULT_THEME = 'theme-default';
  window.PENUMBRA_JOURNAL_ASSETS = { js: 'penumbra_journal.js', css: 'penumbra_journal.css' };
  (function () {
    var P = new URLSearchParams(location.search);
    window.__SCN = P.get('scn') || 'dark';
    var S = window.__SCN;
    var SEP = '␟';
    window.__SEP = SEP;
    var COLS = ['PROTOCOL NO.', 'PROTOCOL TYPE', 'TITLE', 'APPROVAL DATE', 'STATUS', 'AMOUNT'];
    window.__COLS = COLS;
    var W = ['Alpha', 'Bravo', 'Charlie', 'Delta', 'Echo', 'Foxtrot', 'Golf', 'Hotel', 'India'];
    var rows = [];
    for (var i = 1; i <= 36; i++) {
      var r = {};
      r['PROTOCOL NO.'] = String(25400 + (i % 18));
      r['PROTOCOL TYPE'] = i <= 18 ? 'Exempt' : (i <= 30 ? 'Expedited' : 'Amendment/Renewal');
      r['TITLE'] = W[i % W.length] + ' study ' + i;
      r['APPROVAL DATE'] = (1 + (i % 12)) + '/' + (1 + (i % 27)) + '/2026';
      r['STATUS'] = (i % 4 === 0) ? 'Closed' : 'Approved';
      r['AMOUNT'] = '$' + (1000 + i * 37) + '.00';
      rows.push(r);
    }
    // Round B: a toggle row stored with STATE 0 (someone cleared it): { rowKey: {by, at} }.
    window.__ZERO = {};
    // longkey: one row whose TITLE (a key column there) pushes its key past 1,000 bytes.
    window.__LONGIDX = 5;
    if (S === 'longkey' || S === 'rlongbulk') rows[5]['TITLE'] = 'Long title ' + new Array(1101).join('x');
    window.__rowsFixture = rows;
    window.__keyOf = function (r) { return r['PROTOCOL NO.'] + SEP + r['PROTOCOL TYPE']; };
    var K3 = window.__keyOf(rows[2]), K5 = window.__keyOf(rows[22]);
    window.__J = { toggles: { toggle1: {} }, counts: {}, notes: {}, posts: [] };
    window.__J.toggles.toggle1[K3] = { by: 'pat', at: '2026-10-01 09:00:00' };
    window.__J.toggles.toggle1[K5] = { by: 'lee', at: '2026-10-01 10:30:00' };
    window.__J.counts[K3] = 2;
    window.__J.notes[K3] = [
      { ID: 901, REPORT_ID: 7, SCOPE: 'row', ROW_KEY: K3, NOTE_TEXT: 'First look done.', CREATED_BY: 'pat', CREATED_AT: '2026-10-01 09:05:00', PARENT_ID: null },
      { ID: 902, REPORT_ID: 7, SCOPE: 'row', ROW_KEY: K3, NOTE_TEXT: 'Follow up next week.', CREATED_BY: 'lee', CREATED_AT: '2026-10-01 11:00:00', PARENT_ID: null }
    ];
    // Any other report id (a copy): nothing marked, no notes.
    window.__J2 = { toggles: {}, counts: {}, notes: {}, posts: [] };
    window.__MARKED = [K3, K5];
    var order = []; for (var c = 0; c < COLS.length; c++) order.push(c);
    var vo = { journalEnabled: true, journalKeyColumns: ['PROTOCOL NO.', 'PROTOCOL TYPE'],
               journalToggles: [{ key: 'toggle1', label: 'Reviewed' }], journalRowNotes: true };
    var st = {
      name: 'jrfix', query: 'SELECT * FROM JR_FIXTURE', reportTitle: 'Toggle fixes fixture',
      theme: 'theme-default', density: 'standard',
      visibleColumns: ['#', 0, 1, 2, 3, 4], columnOrder: order,
      sortCriteria: [], noLimit: true, rowExpandDefault: false, resolverLinksDefault: true,
      rowsPerPage: '200', reportSnippet: '', viewOptions: vo
    };
    var journalOn = true;
    if (S === 'dark' || S === 'darkgrp') st.theme = 'theme-dark-blue';
    if (S === 'darkgrp') { st.groupBy = 'PROTOCOL TYPE'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3; }
    if (S === 'wolf') st.theme = 'theme-wolfpack';
    // Saved with the journal OFF but its key, toggle column and row notes kept.
    if (S === 'offsave') { delete vo.journalEnabled; journalOn = false; }
    // A saved key column the query no longer returns.
    if (S === 'missing' || S === 'missnotice') vo.journalKeyColumns = ['PROTOCOL NO.', 'PROTOCOL TYPE', 'GONE'];
    if (S === 'longkey' || S === 'rlongbulk') vo.journalKeyColumns = ['PROTOCOL NO.', 'PROTOCOL TYPE', 'TITLE'];
    // Round B: saved grouped BY the toggle (its bands name the column).
    if (S === 'bandlabel') { st.groupBy = 'Reviewed'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3; }
    // Round E (2026-10-08).
    // The marks cannot be loaded (until the scenario lets them).
    if (S === 'loadfail') window.__failToggles = true;
    // Grouped by type, the toggle column summed (the browser's key: the upper-cased
    // internal column name).
    if (S === 'grpfoot') { st.groupBy = 'PROTOCOL TYPE'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3; st.columnSummaries = { '__JOURNAL_TOGGLE__TOGGLE1': 'sum' }; }
    // Sorted by the toggle, two pages.
    // Sorted by the toggle, two pages; the marks land well after the note counts (the
    // replay must wait for the marks, not run on the first journal data).
    if (S === 'noteresort') { st.rowsPerPage = '25'; st.sortCriteria = [{ colIdentifier: '__JOURNAL_TOGGLE__toggle1', colIndex: '__JOURNAL_TOGGLE__toggle1', direction: 'desc' }]; window.__toggleDelay = 500; }
    // The key's PROTOCOL NO. hidden, rows coloured by the toggle.
    if (S === 'cfhidden') { st.visibleColumns = ['#', 1, 2, 3, 4]; st.reportSnippet = "format(row, Reviewed = ☑, 'background-color: rgb(230, 255, 230)')"; }
    // Grouped BY the toggle, for a regroup with a search typed.
    if (S === 'regroupsearch') { st.groupBy = 'Reviewed'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3; }
    // Snippets that do / do not name the toggle.
    if (S === 'snipguard') st.reportSnippet = 'Rows in all: count()';
    if (S === 'snipjournal') st.reportSnippet = 'Reviewed so far: count(Reviewed = ☑)';
    // The server lists toggle keys with rows in any state: toggle2's marks were all cleared.
    if (S === 'usedkeys') window.__usedKeys = ['toggle1', 'toggle2'];
    // Round G (2026-10-08, the smaller leftovers). (stateonly: run.py loads the page with no ?id=.)
    // A one-column key (TITLE) that two rows lack.
    if (S === 'blankkey') { vo.journalKeyColumns = ['TITLE']; rows[4]['TITLE'] = ''; rows[9]['TITLE'] = ''; }
    // Grouped, sorted by the toggle, the marks landing after the bands are built.
    if (S === 'grpsort') { st.groupBy = 'PROTOCOL TYPE'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3;
      st.sortCriteria = [{ colIdentifier: '__JOURNAL_TOGGLE__toggle1', colIndex: '__JOURNAL_TOGGLE__toggle1', direction: 'desc' }]; window.__toggleDelay = 500; }
    // A key that repeats: PROTOCOL NO. alone (18 rows share one).
    if (S === 'dupkey') vo.journalKeyColumns = ['PROTOCOL NO.'];
    // Two toggle columns ticked on the same two rows, and a removed column's mark.
    if (S === 'keywarn') {
      vo.journalToggles = [{ key: 'toggle1', label: 'Reviewed' }, { key: 'toggle2', label: 'Sent' }];
      window.__J.toggles.toggle2 = {};
      window.__J.toggles.toggle2[K3] = { by: 'pat', at: '2026-10-02 09:00:00' };
      window.__J.toggles.toggle2[K5] = { by: 'lee', at: '2026-10-02 10:00:00' };
      window.__J.toggles.toggle9 = {};
      window.__J.toggles.toggle9[window.__keyOf(rows[6])] = { by: 'kim', at: '2026-09-01 09:00:00' };
    }
    // Saved with the journal off, three notes written while it was.
    if (S === 'pubcancel') { delete vo.journalEnabled; journalOn = false; window.__summaryTotal = 3; }
    // Grouped by type, a band summary on the toggle, the bands ranked by it; two more marks
    // (Amendment/Renewal), all of them landing after the bands are built.
    if (S === 'bandsum') { st.groupBy = 'PROTOCOL TYPE'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3;
      st.groupAgg = { column: 'Reviewed', type: 'sum' }; st.groupSort = { key: 'summary', dir: 'desc' };
      window.__J.toggles.toggle1[window.__keyOf(rows[30])] = { by: 'kim', at: '2026-10-02 09:00:00' };
      window.__J.toggles.toggle1[window.__keyOf(rows[31])] = { by: 'kim', at: '2026-10-02 09:05:00' };
      window.__toggleDelay = 500; }
    // format() rules naming the toggle by its label.
    if (S === 'cfcell') st.reportSnippet = "format(cell, Reviewed, Reviewed = ☑, 'background-color: rgb(255, 230, 230)')\nformat(header, Reviewed, 'color: rgb(200, 0, 0)')";
    // A key (TITLE) whose value is "constructor"; the third row marked under its TITLE.
    if (S === 'ctorkey') { vo.journalKeyColumns = ['TITLE']; rows[6]['TITLE'] = 'constructor';
      window.__J.toggles.toggle1 = {}; window.__J.toggles.toggle1[rows[2]['TITLE']] = { by: 'pat', at: '2026-10-01 09:00:00' }; }
    // A REAL column named like the toggle: REVIEWED = R1, R2, ...
    if (S === 'tpl') { rows.forEach(function (r, i) { r['REVIEWED'] = 'R' + (i + 1); }); st.visibleColumns = ['#', 0, 1, 2, 3, 4, 6]; order.push(6); }
    // Round H (2026-10-08, item 8): grouped by type, for the groups' own header boxes; two pages.
    if (S === 'hdrgroup') { st.groupBy = 'PROTOCOL TYPE'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3; }
    if (S === 'hdrpage') st.rowsPerPage = '25';
    // The marks cannot be loaded: the header's box refuses, as the row boxes do.
    if (S === 'hdrfail') window.__failToggles = true;
    // Round I (2026-10-08, item 9): the who and when columns - shown, grouped by, sorted by on load.
    if (S === 'whocols' || S === 'whooff') vo.journalToggleWho = true;
    if (S === 'whogroup') { vo.journalToggleWho = true; st.groupBy = 'Reviewed by'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3; }
    if (S === 'whosortload') { vo.journalToggleWho = true; window.__toggleDelay = 500;
      st.sortCriteria = [{ colIdentifier: '__JOURNAL_BY__toggle1', colIndex: '__JOURNAL_BY__toggle1', direction: 'desc' }]; }
    // Round M (2026-10-08, item 10 - safe renames): the toggle was saved as "Reviewed" and is "Complete"
    // now - everything below still names it "Reviewed". (renamelive renames it in the scenario.)
    var renamedDef = { key: 'toggle1', label: 'Complete', oldLabels: ['Reviewed'] };
    if (S === 'renamed') { vo.journalToggles = [renamedDef]; vo.journalToggleWho = true;
      st.reportSnippet = "Marked so far: count(Reviewed = ☑)\nformat(row, Reviewed = ☑, 'background-color: rgb(230, 255, 230)')"; }
    if (S === 'renamegrp') { vo.journalToggles = [renamedDef]; st.groupBy = 'Reviewed'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3; }
    if (S === 'renamesum') { vo.journalToggles = [renamedDef]; st.groupBy = 'PROTOCOL TYPE'; st.visibleColumns = ['#', 1, 0, 2, 3, 4]; st.groupStartDepth = 3;
      st.groupAgg = { column: 'Reviewed', type: 'sum' }; }
    if (S === 'renamesb' || S === 'renameundo') { vo.journalToggles = [renamedDef]; vo.journalToggleWho = (S === 'renamesb'); }
    // Old names a current name holds: the data's (Status), the row notes column's, another toggle's (Sent,
    // which marks row 7).
    if (S === 'renameprec') {
      vo.journalToggles = [{ key: 'toggle1', label: 'Complete', oldLabels: ['Reviewed', 'Status', 'Notes', 'Sent'] }, { key: 'toggle2', label: 'Sent' }];
      window.__J.toggles.toggle2 = {}; window.__J.toggles.toggle2[window.__keyOf(rows[6])] = { by: 'kim', at: '2026-10-02 09:00:00' };
    }
    // Round N (2026-10-08, item 11 - key changes): marks and notes filed under keys this report used
    // before - TITLE (two marks, one note; "Delta study 3" is row 3, which pat has marked under the key
    // now) and GONE (a column this data does not have).
    // Round R (2026-10-09, the toggle client): 25 rows a page (rows 26-36 on page 2); the toggle summed in the flat footer; a mark and a
    // note stored under a TITLE value (row 3's under the key TITLE); saved with no key; a move's second step failing;
    // the first marks read dropped (status 0).
    if (S === 'rrange' || S === 'rjump') st.rowsPerPage = '25';
    if (S === 'rfoot') st.columnSummaries = { '__JOURNAL_TOGGLE__TOGGLE1': 'sum' };
    if (S === 'rsaveclear') window.__rekeyDelay = 800;
    if (S === 'rkeydirty' || S === 'rsaveclear') {
      window.__J.toggles.toggle1['Delta study 3'] = { by: 'kim', at: '2026-09-01 09:00:00' };
      window.__J.counts['Delta study 3'] = 1;
      window.__J.notes['Delta study 3'] = [{ ID: 960, REPORT_ID: 7, SCOPE: 'row', ROW_KEY: 'Delta study 3', NOTE_TEXT: 'Under the title.', CREATED_BY: 'kim', CREATED_AT: '2026-09-01 09:01:00', PARENT_ID: null }];
    }
    if (S === 'rnokey') vo.journalKeyColumns = [];
    if (S === 'rstatus0') window.__toggleStatus0 = 1;
    window.__REKEY_FAIL_STEP2 = (S === 'rmovefail');
    if (S === 'rsame') {
      var rs0 = window.__keyOf(rows[0]), rs1 = window.__keyOf(rows[1]), rsT = {};
      rsT[rs0] = { by: 'kim', at: '2026-09-01 09:00:00' }; rsT[rs1] = { by: 'kim', at: '2026-09-01 09:05:00' };
