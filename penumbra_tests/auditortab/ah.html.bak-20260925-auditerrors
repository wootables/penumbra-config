  var kpis = errors ? { attention: { badpass: 0, denied: 0, email_fail: 1, sched_fail: 0, last: '20260925090200' }, ack_last: '' } : { attention: { badpass: 0, denied: 0, email_fail: 0, sched_fail: 0, last: '20260624191300' }, ack_last: '' };

  var bar = document.getElementById('auditSegBar');
  var segs = [['pulse', 'Pulse', ''], ['events', 'Events', '1,121'], ['changes', 'Changes', '102'], ['health', 'Health', '']];
  var seg = q.get('seg') || 'health';
  var variant = q.get('variant') || '';
