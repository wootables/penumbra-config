  }).join('') + '<span class="audit-seg-note">view is remembered per report &middot; <a href="#">' + (variant === 'd' ? ico('metrics') + 'Report metrics &rarr;' : 'View report metrics &rarr;') + '</a></span>';
  bar.style.display = '';
  document.getElementById('auditSeg' + seg.charAt(0).toUpperCase() + seg.slice(1)).classList.add('on');
  if (q.get('realbar') === '1') {
    // The bar exactly as the main.js under test builds it (it also syncs the panels).
    bar.innerHTML = '';
    fns($, moment, { seg: seg, kpis: kpis }).bar({ total: 1121, change: 102 }, kpis, 'grantprofiles');
  }

  var sheets = ['css/jquery-ui.css', q.get('css') || ('../' + src + '/css/main.css'), 'css/penumbra_tiles.css', 'css/density.css', 'css/search_builder.css', 'css/penumbra_presets.css', 'css/penumbra_colwidths.css', 'themevars.css'];
  if (variant) { sheets.push('variants/common.css'); sheets.push('variants/' + variant + '.css'); }
  var pending = sheets.length;
  sheets.forEach(function (href) {
    var l = document.createElement('link'); l.rel = 'stylesheet'; l.href = href;
    l.onload = l.onerror = function () { if (--pending === 0) go(); };
    document.head.appendChild(l);
  });

  function r(el) { var b = el.getBoundingClientRect(); return { x: +b.left.toFixed(1), y: +b.top.toFixed(1), w: +b.width.toFixed(1), h: +b.height.toFixed(1) }; }
  function go() {
    try {
      if (seg === 'health') fns($, moment, { health: { bad: bad, sched: sched, app: app }, kpis: kpis }).paint();
      else if (seg === 'pulse') {
        // A busy report's metrics: 8 action-mix rows = the server's cap, the
        // tallest card Pulse can have.
        var tr = [], tlab = [], hrs = [];
        for (var d = 0; d < 30; d++) { tr.push(20 + ((d * 37) % 45)); tlab.push(moment('2026-08-27').add(d, 'days').format('MMM D')); }
        for (var hh = 0; hh < 24; hh++) hrs.push(hh < 7 || hh > 19 ? (hh % 3) : 20 + ((hh * 13) % 40));
        var pk = { total_views: 1121, total_views_today: 4, unique_viewers: 38, unique_viewers_today: 2, depts: 12,
          exports: 57, exports_today: 0, exp_last: 'Sep 18', updates: 102, updates_today: 1, upd_last: 'Sep 25',
          errors: 3, errors_today: 0, trend: tr, trend_labels: tlab, hours: hrs,
          top_viewers: [{ u: 'bplimon', n: 560 }, { u: 'jsmith4', n: 122 }, { u: 'akpatel', n: 97 }, { u: 'mrgarcia', n: 64 }, { u: 'lwong2', n: 41 }, { u: 'tbrown', n: 18 }],
          action_mix: [{ a: 'OPEN', n: 1121 }, { a: 'SCHEDULE_RUN_OK', n: 240 }, { a: 'UPDATE', n: 102 }, { a: 'EXPORT', n: 57 }, { a: 'EMAIL', n: 31 }, { a: 'SNAPSHOT_CREATE', n: 12 }, { a: 'DENIED_SCOPE', n: 3 }, { a: 'AUDIT_ACK', n: 1 }] };
        fns($, moment, { health: null, kpis: pk }).pulse(pk);
      }
      var wrap = document.getElementById('admWrapper');
      wrap.style.width = (W + 40) + 'px';
      var off = wrap.getBoundingClientRect().width - document.getElementById('auditor-tab').getBoundingClientRect().width;
      wrap.style.width = (W + off) + 'px';
    } catch (e) { fail('paint: ' + e.message); return; }
    requestAnimationFrame(function () { requestAnimationFrame(measure); });
  }
  // --- WCAG contrast of the banner's text over what is really behind it ------
  function rgba(s) {
    var m = String(s).match(/rgba?\(([^)]+)\)/), c;
    if (m) { c = m[1].split(/[\s,\/]+/).filter(Boolean).map(parseFloat); return [c[0], c[1], c[2], c.length > 3 ? c[3] : 1]; }
    m = String(s).match(/color\(srgb ([^)]+)\)/);
    if (m) { c = m[1].split(/[\s\/]+/).filter(Boolean).map(parseFloat); return [c[0] * 255, c[1] * 255, c[2] * 255, c.length > 3 ? c[3] : 1]; }
    return null;
  }
  function over(fg, bg) { var a = fg[3]; return [fg[0] * a + bg[0] * (1 - a), fg[1] * a + bg[1] * (1 - a), fg[2] * a + bg[2] * (1 - a), 1]; }
  function lum(c) { var v = c.slice(0, 3).map(function (x) { x /= 255; return x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4); }); return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2]; }
  function ratio(a, b) { var l1 = lum(a), l2 = lum(b); return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05); }
  // Resolve a CSS <color> expression (color-mix and all) in the page's context.
  function resolve(expr, host) { var p = document.createElement('span'); p.style.color = expr; (host || bar).appendChild(p); var c = rgba(getComputedStyle(p).color); p.remove(); return c; }
  function opaqueBg(el) {
    var stack = [], n = el;
    while (n && n.nodeType === 1) { var c = rgba(getComputedStyle(n).backgroundColor); if (c && c[3] > 0) stack.push(c); if (c && c[3] >= 1) break; n = n.parentElement; }
    var base = [255, 255, 255, 1]; for (var i = stack.length - 1; i >= 0; i--) base = over(stack[i], base); return base;
  }
  function contrastReport() {
    var out = {};
    // The band is a gradient: its left end (13% brand) sits behind the title,
    // its right end (3% brand) behind the hint + the metrics button.
    var bandL = over(resolve('color-mix(in srgb, var(--brand-primary, #336699) 13%, var(--bg-surface, #fff))'), opaqueBg(bar.parentElement));
    var bandR = over(resolve('color-mix(in srgb, var(--brand-primary, #336699) 3%, var(--bg-surface, #fff))'), opaqueBg(bar.parentElement));
    var t = bar.querySelector('.audit-seg-title');
    if (t) out.title = ratio(rgba(getComputedStyle(t).color), bandL);
    var pills = bar.querySelectorAll('.audit-seg');
    var sel = bar.querySelector('.audit-seg[aria-selected="true"]'), un = bar.querySelector('.audit-seg[aria-selected="false"]');
    if (un) out.pill = ratio(over(rgba(getComputedStyle(un).color), opaqueBg(un)), opaqueBg(un));
    if (sel) out.pillSel = ratio(over(rgba(getComputedStyle(sel).color), opaqueBg(sel)), opaqueBg(sel));
    var bn = bar.querySelector('.audit-seg[aria-selected="false"] .seg-n:not(:empty)');
    if (bn) out.badge = ratio(over(rgba(getComputedStyle(bn).color), opaqueBg(bn)), opaqueBg(bn));
    var bs = bar.querySelector('.audit-seg[aria-selected="true"] .seg-n:not(:empty)');
    if (bs) out.badgeSel = ratio(over(rgba(getComputedStyle(bs).color), opaqueBg(bs)), opaqueBg(bs));
    var a = bar.querySelector('.audit-seg-note a');
    if (a) out.button = ratio(over(rgba(getComputedStyle(a).color), opaqueBg(a)), opaqueBg(a));
    var h = bar.querySelector('.audit-seg-hint');
    if (h && h.getBoundingClientRect().width > 0) out.hint = ratio(rgba(getComputedStyle(h).color), bandR);
    Object.keys(out).forEach(function (k) { out[k] = +out[k].toFixed(2); });
    return out;
  }
  function measure() {
    var tab = document.getElementById('auditor-tab'), rowEl = document.getElementById('auditMainRow');
    var pnl = document.getElementById('auditSeg' + seg.charAt(0).toUpperCase() + seg.slice(1));
    var cs = getComputedStyle(rowEl);
    var res = {
      src: src, w: W, admin: admin, errors: errors, seg: seg,
      editorTabs: r(document.getElementById('editorTabs')), tab: r(tab), row: r(rowEl), bar: r(bar), panel: r(pnl),
      rowMinH: cs.minHeight, rowBox: cs.boxSizing, rowPad: cs.paddingTop + '/' + cs.paddingBottom,
