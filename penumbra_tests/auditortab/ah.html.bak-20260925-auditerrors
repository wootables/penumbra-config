      firstKidRoom: pnl.firstElementChild ? +(pnl.getBoundingClientRect().top + pnl.clientHeight - pnl.firstElementChild.getBoundingClientRect().bottom).toFixed(1) : null,
      kids: Array.prototype.slice.call(pnl.children).map(function (c) { return c.className + '=' + c.getBoundingClientRect().height.toFixed(1); }),
      contrast: contrastReport(),
      barInfo: (function () {
        var cs = getComputedStyle(bar), p = bar.querySelector('.audit-seg'), ps = p ? getComputedStyle(p) : null;
        var a = bar.querySelector('.audit-seg-note a'), t = bar.querySelector('.audit-seg-title');
        var lb = a ? rgba(getComputedStyle(a).backgroundColor) : null, br = resolve('var(--brand-primary, #336699)');
        return {
          bgImage: cs.backgroundImage.slice(0, 30), borderLeft: cs.borderLeftWidth,
          pillFont: ps ? parseFloat(ps.fontSize) : 0, pillWeight: ps ? parseInt(ps.fontWeight, 10) : 0,
          tabs: bar.querySelectorAll('[role="tab"]').length,
          tabIcons: bar.querySelectorAll('[role="tab"] > svg[aria-hidden="true"]').length,
          selected: bar.querySelectorAll('[role="tab"][aria-selected="true"]').length,
          titleHidden: !!(t && t.getAttribute('aria-hidden') === 'true'), titleText: t ? t.textContent.trim() : '',
          linkText: a ? a.textContent.trim() : '', linkIcon: !!(a && a.querySelector('svg[aria-hidden="true"]')),
          linkIsBrand: !!(lb && br && lb[3] >= 1 && Math.abs(lb[0] - br[0]) < 1.5 && Math.abs(lb[1] - br[1]) < 1.5 && Math.abs(lb[2] - br[2]) < 1.5)
        };
