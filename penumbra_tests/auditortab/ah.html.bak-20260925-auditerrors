      barLines: (function () { var t = {}; Array.prototype.slice.call(bar.children).forEach(function (c) { var b = c.getBoundingClientRect(); if (b.width > 0) t[Math.round(b.top + b.height / 2)] = 1; }); return Object.keys(t).length; })(),
      barOverflow: bar.scrollWidth > bar.clientWidth + 1,
      hintShown: !!(bar.querySelector('.audit-seg-hint') && bar.querySelector('.audit-seg-hint').getBoundingClientRect().width > 0),
      titleWordShown: !!(bar.querySelector('.audit-seg-title-t') && bar.querySelector('.audit-seg-title-t').getBoundingClientRect().width > 0),
      barKids: Array.prototype.slice.call(bar.children).map(function (c) { var b = c.getBoundingClientRect(); return (c.className || c.tagName) + '@' + Math.round(b.left) + '..' + Math.round(b.right); })
    };
    window.__vo = res; out.textContent = JSON.stringify(res); window.__voDone = true;
  }
})();
</script>
