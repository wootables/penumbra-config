def read_b(p): return open(p, 'rb').read().decode('utf-8', 'surrogateescape')

def hook(src):
    anchor = '$(document).ready(function () {'
    i = src.find(anchor)
    if i < 0 or i > 400: raise SystemExit('closure anchor not found')
    h = '\r\n;try { window.__HC = {}; } catch (e) { window.__HC_ERR = String(e); }\r\n'
    out = src[:i] + ';(function () {' + h + src[i + len(anchor):]
    j = out.rfind('});')
    out = out[:j] + '})();' + out[j + 3:]
    lz = '    let _pivotLazyMinRows = _PIVOT_LAZY_MIN_ROWS_DEFAULT;\r\n'
    if out.count(lz) != 1: raise SystemExit('lazy anchor count %d' % out.count(lz))
    out = out.replace(lz, '    let _pivotLazyMinRows = (window.__LAZYMIN || _PIVOT_LAZY_MIN_ROWS_DEFAULT);\r\n')
    # count pivot builds (window.__GEN): a theme switch must recolour, not rebuild
    gp = '    function generatePivotTable(pivotData, '
    gi = out.find(gp)
    if gi < 0 or out.count(gp) != 1: raise SystemExit('generatePivotTable anchor count %d' % out.count(gp))
    gb = out.find('{', gi) + 1
    out = out[:gb] + ' window.__GEN = (window.__GEN || 0) + 1;' + out[gb:]
    # count formatting passes (window.__CF): a theme switch must not pay for two
    cp = '    function applyConditionalFormatting('
    ci = out.find(cp)
    if ci < 0 or out.count(cp) != 1: raise SystemExit('applyConditionalFormatting anchor count %d' % out.count(cp))
    cb = out.find('{', ci) + 1
    out = out[:cb] + ' window.__CF = (window.__CF || 0) + 1;' + out[cb:]
    hl = '    function hideLoading() {\r\n'
    if out.count(hl) != 1: raise SystemExit('hideLoading anchor count %d' % out.count(hl))
    return out.replace(hl, hl + '        window.__HC_HIDES = (window.__HC_HIDES || 0) + 1;\r\n')
def mutate(texts, name):
    t = dict(texts)
    for f, old, new in MUTANTS[name][0]:
        if t[f].count(old) != 1: raise SystemExit("mutant '%s': %s anchor found %d times: %r" % (name, f, t[f].count(old), old[:90]))
        t[f] = t[f].replace(old, new)
    return t

