        var tb0 = eager.indexOf('<tbody>'), tb1 = eager.indexOf('</tbody>');
        var full = lz.render(lz.entries);
        assert('on demand build: ' + t.name + ' - every row built in order == eager rows', full === eager.substring(tb0 + 7, tb1),
          lz.entries.length + ' entries, ' + full.length + ' vs ' + (tb1 - tb0 - 7) + ' chars');
        var initialBody = lz.render(lz.initial.map(function (i) { return lz.entries[i]; }));
        var expectLazy = eager.substring(0, tb0 + 7) + initialBody + eager.substring(tb1);
        assert('on demand build: ' + t.name + ' - first render == eager minus hidden rows',
          lazyB.res.html.replace(' data-pnb-lazy="' + lz.id + '"', '') === expectLazy && lz.initial.length < lz.entries.length,
          lz.initial.length + ' of ' + lz.entries.length + ' rows built up front');
      });
    });

    // 6. Same clicks, eager vs on demand, one page: visible rows after every step,
    //    the exports, and the whole DOM once every row is built.
    [
      { name: 'collapsed start, 5 fields, blanks + rules', cfg: { n: 700, fields: 5, layout: 'nested', blanks: 0.15, rules: 'row+fieldcell' } },
      { name: 'expanded start, 4 fields, real-shaped', cfg: { n: 700, fields: 4, layout: 'nested', shape: 'real', expanded: true, rules: 'report' } }
    ].forEach(function (t) {
      guarded('interaction: ' + t.name, function () {
        var a = runScript(t.cfg, 1000000000);
        var b = runScript(t.cfg, 0);
        var firstBad = -1;
        for (var i = 0; i < a.trace.length; i++) { if (a.trace[i] !== b.trace[i]) { firstBad = i; break; } }
        assert('interaction: ' + t.name + ' - rows were built on demand', b.lazyAtMount && b.builtAtMount < a.builtAtMount,
          'built at mount: on demand ' + b.builtAtMount + ' vs eager ' + a.builtAtMount);
        assert('interaction: ' + t.name + ' - visible rows identical after all ' + (a.trace.length - 1) + ' steps', firstBad === -1,
          firstBad === -1 ? '' : 'first difference after step ' + firstBad);
        assert('interaction: ' + t.name + ' - copy CSV + export array identical', a.exports === b.exports, a.exports + ' vs ' + b.exports);
        assert('interaction: ' + t.name + ' - whole table identical once every row is built', a.full === b.full, a.full + ' vs ' + b.full);
      });
    });

    // 7. Load of the reported pivot: 10 row fields x 3,242 real-shaped rows,
    //    collapsed. Only the 1,793 top-level rows are built.
    guarded('load', function () {
      if (!(P.lazy && P.setLazyMin)) {
        assert('load: 10 fields x 3,242 rows builds only the top-level rows', false, 'no on-demand row support in this main.js (not run)');
        assert('load: build + insert + collapse setup + layout in < 4,000 ms', false, 'not run');
        return;
      }
      var t0 = performance.now();
      var b = mount({ n: 3242, fields: 10, layout: 'nested', shape: 'real', rules: 'report', lazyMin: null });
      void document.body.offsetHeight;
      var ms = Math.round(performance.now() - t0);
      var built = table().tBodies[0].rows.length;
      assert('load: 10 fields x 3,242 rows builds only the top-level rows', built === 1793, built + ' rows built (eager: 22,587)');
      assert('load: build + insert + collapse setup + layout in < 4,000 ms', ms < 4000, ms + ' ms');
      $('#pivot-output-container').hide().empty();
    });
    return results;
  }

  var m = /[?&]perf=([^&]+)/.exec(location.search);
  var s = /[?&]suite=1/.test(location.search);
  if (m || s) {
    var results = [];
    try {
      if (!window.__PP) throw new Error('hooks unavailable: ' + (window.__PP_ERR || 'n/a') + ' / ' + (window.__errors || []).slice(0, 3).join(' | '));
      if (s) {
        results = runSuite();
      } else {
        JSON.parse(decodeURIComponent(m[1])).forEach(function (cfg) { results.push(window.__runPivot(cfg)); });
      }
      report('RESULTS_JSON:' + JSON.stringify({ results: results, pageErrors: (window.__errors || []).slice(0, 6) }));
    } catch (e) {
      report('RESULTS_JSON:' + JSON.stringify({ fatal: String(e && e.stack || e), results: results, pageErrors: (window.__errors || []).slice(0, 6) }));
    }
  }
})();
