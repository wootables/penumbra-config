  $new5 = '                        if (false) (byKey[s] || (byKey[s] = [])).push(rows[r]);'
  if (([regex]::Matches($src, [regex]::Escape($old5))).Count -ne 1) { throw 'mutant5 anchor not found exactly once (needs togglePivotLevel) - update run.ps1' }
