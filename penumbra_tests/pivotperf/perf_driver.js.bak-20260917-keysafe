        var bad = labels.filter(function (l) { return exp[l.key] !== l.n; });
        var gt1 = labels.filter(function (l) { return l.n > 1; }).length;
        var groups = Object.keys(exp).length;
        assert('labels: ' + t.name + ' - one summary row per group', labels.length === groups, labels.length + ' rows vs ' + groups + ' groups');
        assert('labels: ' + t.name + ' - every "(N items)" matches the independent count', labels.length > 0 && bad.length === 0,
          bad.length + ' wrong of ' + labels.length + (bad.length ? '; first: ' + JSON.stringify({ key: bad[0].key, shown: bad[0].n, expected: exp[bad[0].key] }) : ''));
        assert('labels: ' + t.name + ' - non-vacuous (some counts > 1)', gt1 > 0, gt1 + ' labels > 1');
      });
    });

    // 2. Timing of the eager build (pre-fix: ~22 s here via the O(groups^2) scan).
    guarded('timing', function () {
      var big = { n: 1600, fields: 8, lazyMin: 1000000000 };
      var tn = window.__runPivot(Object.assign({ layout: 'nested' }, big));
      var ts = window.__runPivot(Object.assign({ layout: 'nested-static' }, big));
      assert('timing: 8 fields x 1,600 rows collapsible nested builds in < 5,000 ms', tn.genMs < 5000, tn.genMs + ' ms (' + tn.trs + ' rows)');
      assert('timing: nested / nested-static build ratio < 25', tn.genMs / Math.max(ts.genMs, 20) < 25,
        tn.genMs + ' ms / ' + ts.genMs + ' ms = ' + (tn.genMs / Math.max(ts.genMs, 20)).toFixed(1));
    });

    // 3. Build-speed caches: DOMPurify once per distinct label value, and no
    //    per-cell toLocaleString (each call constructs an Intl.NumberFormat).
    guarded('build caches', function () {
      var sanitize = DOMPurify.sanitize, calls = 0;
      var tls = Number.prototype.toLocaleString, tlsCalls = 0;
      DOMPurify.sanitize = function () { calls++; return sanitize.apply(this, arguments); };
      Number.prototype.toLocaleString = function () { tlsCalls++; return tls.apply(this, arguments); };
      try {
        window.__buildPivot({ n: 3242, fields: 10, layout: 'flat', shape: 'real', lazyMin: 1000000000 });
      } finally {
        DOMPurify.sanitize = sanitize;
        Number.prototype.toLocaleString = tls;
      }
      assert('build caches: DOMPurify runs once per distinct link value, not per cell (< 2,500 calls)', calls > 0 && calls < 2500, calls + ' sanitize calls');
      assert('build caches: no per-cell Number.toLocaleString during the build', tlsCalls === 0, tlsCalls + ' toLocaleString calls');
    });

    // 4. Hidden flat table is not restyled while a pivot is on screen.
    guarded('hidden pass', function () {
      var $tb = $('#resultsTable tbody').empty();
      $('#resultsTable thead th').each(function (i) { $(this).attr('data-column', i === 0 ? '#' : String(i - 1)); });
      var body = '';
      for (var ri = 0; ri < 40; ri++) {
        body += '<tr><td>' + (ri + 1) + '</td><td>COL' + (ri % 3) + '</td><td>FY2' + (ri % 4) + '</td><td>' + (1000 + ri) +
          '</td><td>' + (ri % 2 ? 'Active' : 'Closed') + '</td><td>R' + ri + '</td></tr>';
      }
      $tb.html(body);
      var cond = "STATUS = 'Active'";
      P.setRules([{ type: 'cell', targetColumn: 'AMOUNT', condition: cond, style: 'background-color: rgb(255, 0, 0)',
        parsedCondition: P.parseQuery(cond, ['#', 'COLLEGE', 'FY', 'AMOUNT', 'STATUS', 'RECORD_ID']) }]);
      function styledRows() { return $('#resultsTable tbody tr').filter(function () { return this.cells[3].style.backgroundColor !== ''; }).length; }
      function clearStyles() { $('#resultsTable tbody td').css('background-color', ''); }
      $('#groupedResultsContainer').hide();
      $('#pivot-output-container').hide().empty();
      clearStyles(); P.cf();
      var flat1 = styledRows();
      assert('hidden pass: flat table showing - format(cell) still applied', flat1 === 20, flat1 + ' of 40 rows styled (expected 20)');
      clearStyles();
      $('#pivot-output-container').html('<table id="pivotResultTable"><tbody><tr><td>pivot</td></tr></tbody></table>').show();
      P.cf();
      var hidden = styledRows();
      assert('hidden pass: pivot on screen - hidden flat table NOT restyled', $('#pivot-output-container').is(':visible') && hidden === 0,
        hidden + ' hidden rows restyled while the pivot was showing (expected 0)');
      $('#pivot-output-container').hide().empty();
      P.cf();
      var flat2 = styledRows();
      assert('hidden pass: back to the flat table - formatting catches up', flat2 === 20, flat2 + ' of 40 rows styled (expected 20)');
      P.setRules([]);
      $tb.empty();
    });

    // 5. Rows built on demand: every plan entry built in order reproduces the
    //    eager tbody, and the first render holds only the start-visible rows.
    [
      { name: '5 fields, collapsed, blanks + rules', cfg: { n: 900, fields: 5, layout: 'nested', blanks: 0.15, rules: 'row+fieldcell' } },
      { name: '6 fields, real-shaped links, start expanded', cfg: { n: 900, fields: 6, layout: 'nested', shape: 'real', expanded: true, rules: 'report' } },
      { name: 'per-group Top 3 with (Other) rows', cfg: { n: 900, order: [8, 7, 4], layout: 'nested', rankN: 3, rankScope: 'LEAD_COLLEGE' } }
    ].forEach(function (t) {
      guarded('on demand build: ' + t.name, function () {
        var eager = window.__buildPivot(Object.assign({}, t.cfg, { lazyMin: 1000000000 })).res.html;
        var lazyB = window.__buildPivot(Object.assign({}, t.cfg, { lazyMin: 0 }));
        var lz = P.lazy && P.lazy.get();
        if (!lz) { assert('on demand build: ' + t.name + ' - plan created', false, 'no _pivotLazy store'); return; }
        var tb0 = eager.indexOf('<tbody>'), tb1 = eager.indexOf('</tbody>');
        var full = lz.render(lz.entries);
        assert('on demand build: ' + t.name + ' - every row built in order == eager rows', full === eager.substring(tb0 + 7, tb1),
          lz.entries.length + ' entries, ' + full.length + ' vs ' + (tb1 - tb0 - 7) + ' chars');
        var initialBody = lz.render(lz.initial.map(function (i) { return lz.entries[i]; }));
        var expectLazy = eager.substring(0, tb0 + 7) + initialBody + eager.substring(tb1);
        assert('on demand build: ' + t.name + ' - first render == eager minus hidden rows',
          lazyB.res.html.replace(' data-pnb-lazy="' + lz.id + '"', '') === expectLazy && lz.initial.length < lz.entries.length,
          lz.initial.length + ' of ' + lz.entries.length + ' rows built up front');
      });
    });

    // 6. Same clicks, eager vs on demand, one page: visible rows after every step,
    //    the exports, and the whole DOM once every row is built.
    [
      { name: 'collapsed start, 5 fields, blanks + rules', cfg: { n: 700, fields: 5, layout: 'nested', blanks: 0.15, rules: 'row+fieldcell' } },
      { name: 'expanded start, 4 fields, real-shaped', cfg: { n: 700, fields: 4, layout: 'nested', shape: 'real', expanded: true, rules: 'report' } }
    ].forEach(function (t) {
      guarded('interaction: ' + t.name, function () {
        var a = runScript(t.cfg, 1000000000);
        var b = runScript(t.cfg, 0);
        var firstBad = -1;
        for (var i = 0; i < a.trace.length; i++) { if (a.trace[i] !== b.trace[i]) { firstBad = i; break; } }
        assert('interaction: ' + t.name + ' - rows were built on demand', b.lazyAtMount && b.builtAtMount < a.builtAtMount,
          'built at mount: on demand ' + b.builtAtMount + ' vs eager ' + a.builtAtMount);
        assert('interaction: ' + t.name + ' - visible rows identical after all ' + (a.trace.length - 1) + ' steps', firstBad === -1,
          firstBad === -1 ? '' : 'first difference after step ' + firstBad);
        assert('interaction: ' + t.name + ' - copy CSV + export array identical', a.exports === b.exports, a.exports + ' vs ' + b.exports);
        assert('interaction: ' + t.name + ' - whole table identical once every row is built', a.full === b.full, a.full + ' vs ' + b.full);
      });
    });

    // 7. Load of the reported pivot: 10 row fields x 3,242 real-shaped rows,
    //    collapsed. Only the 1,793 top-level rows are built.
    guarded('load', function () {
      if (!(P.lazy && P.setLazyMin)) {
        assert('load: 10 fields x 3,242 rows builds only the top-level rows', false, 'no on-demand row support in this main.js (not run)');
        assert('load: build + insert + collapse setup + layout in < 4,000 ms', false, 'not run');
        return;
      }
      var t0 = performance.now();
      var b = mount({ n: 3242, fields: 10, layout: 'nested', shape: 'real', rules: 'report', lazyMin: null });
      void document.body.offsetHeight;
      var ms = Math.round(performance.now() - t0);
      var built = table().tBodies[0].rows.length;
      assert('load: 10 fields x 3,242 rows builds only the top-level rows', built === 1793, built + ' rows built (eager: 22,587)');
      assert('load: build + insert + collapse setup + layout in < 4,000 ms', ms < 4000, ms + ' ms');
      $('#pivot-output-container').hide().empty();
    });

    // 8. Level-wide toggles (chevron double-click, .pivot-batch-toggle): the same
    //    script run with the handlers and with the old click-per-chevron loop leaves
    //    identical rows after every step, identical exports and table; and the
    //    double-click that took ~16 s headless (474 groups) now takes well under 2 s.
    [
      { name: '5 fields, blanks + rules', cfg: { n: 300, fields: 5, layout: 'nested', blanks: 0.15, rules: 'row+fieldcell' } },
      { name: '6 fields, real-shaped, start expanded', cfg: { n: 300, fields: 6, layout: 'nested', shape: 'real', expanded: true, rules: 'report' } }
    ].forEach(function (t) {
      [['on demand', 0], ['eager', 1000000000]].forEach(function (mode) {
        var label = 'level toggles: ' + t.name + ' (' + mode[0] + ')';
        guarded(label, function () {
          var a = runLevelScript(t.cfg, mode[1], true);
          var b = runLevelScript(t.cfg, mode[1], false);
          var firstBad = -1;
          for (var i = 0; i < a.trace.length; i++) { if (a.trace[i] !== b.trace[i]) { firstBad = i; break; } }
          assert(label + ' - visible rows identical to one click per chevron after every step', firstBad === -1 && a.counts === b.counts,
            firstBad === -1 ? (a.trace.length - 1) + ' steps, ran ' + b.counts : 'first difference after step ' + firstBad);
          assert(label + ' - copy CSV + export array + whole table identical', a.exports === b.exports && a.full === b.full,
            b.exports + ' ' + b.full + (a.exports === b.exports && a.full === b.full ? '' : ' vs old loop ' + a.exports + ' ' + a.full));
          assert(label + ' - batch flag cleared after every step', b.flags.indexOf('true') === -1, b.flags);
        });
      });
    });
    guarded('level toggles: timing', function () {
      mount({ n: 800, fields: 7, layout: 'nested', shape: 'real', seed: 4242, lazyMin: 0 });
      P.viewLevel(1);
      var level1 = '#pivotResultTable .pivot-collapse-toggle.pivot-collapse-toggle-right[data-group-level="1"]';
      var closed = $(level1 + '.pivot-group-collapsed:visible').length;
      var rows = table().tBodies[0].rows.length;
      var t0 = performance.now();
      levelChevron(1, true).dispatchEvent(new MouseEvent('dblclick', { bubbles: true, cancelable: true, view: window }));
      var ms = Math.round(performance.now() - t0);
      var opened = $(level1 + '.pivot-group-expanded:visible').length;
      assert('level toggles: timing - double-click expands all 400+ level-1 groups of a 7-field pivot in < 2,000 ms',
        ms < 2000 && closed > 400 && opened === closed, ms + ' ms, ' + opened + ' of ' + closed + ' groups open, ' + rows + ' rows before');
      $('#pivot-output-container').hide().empty();
    });

    // 9. Tables where one cleanup at the end is NOT the same as one per click, so the
    //    handlers must click chevron by chevron (pivotLevelToggleNeedsClicks). Both
    //    op lists were found by the differential fuzzer (2026-09-17):
    //    - after a column sort a group's summary row sits away from its rows, and a
    //      per-click cleanup leaves a chevron in a row the final cleanup never picks;
    //    - keys ending in / containing a backslash: the existing-chevron check never
    //      matches, so every cleanup adds another chevron.
    [
      { name: 'column-sorted table', cfg: { n: 220, fields: 5, layout: 'nested', blanks: 0.15, seed: 3467, lazyMin: 1000000000 },
        ops: [['dbl', 'R000031', '0', 0], ['click', 'R000116', '0', 0], ['click', 'R000116', '0', 0], ['dbl', 'R000116', '0', 0],
          ['dbl', 'R000046', '0', 0], ['batch', NaN, 'expand'], ['click', 'R000046', '0', 0], ['dbl', 'R000052', '0', 0], ['expandAll'],
          ['click', 'R000072|||[Blank]|||A000072|||TYPE_3', '3', 0], ['click', 'R000072|||[Blank]|||A000072|||TYPE_3', '3', 0],
          ['dbl', 'R000072|||[Blank]|||A000072|||TYPE_3', '3', 0], ['collapseAll'], ['sort', 0], ['click', 'R000111', '0', 0],
          ['dbl', 'R000051', '0', 0], ['view', 4], ['batch', 4, 'expand'], ['click', 'R000120|||[Blank]', '1', 0],
          ['dbl', 'R000066|||[Blank]|||A000066|||TYPE_1', '3', 0]] },
      { name: 'backslash keys', cfg: { n: 240, order: [8, 4, 5, 3], layout: 'nested', bs: true, seed: 7298, lazyMin: 0 },
        ops: [['batch', 0, 'collapse'], ['expandAll'], ['click', 'LEAD_0|||DEPT\\114|||PI_272', '2', 0], ['dbl', 'LEAD_2|||DEPT"106', '1', 0],
          ['click', 'LEAD_10|||DEPT"91', '1', 0], ['expandAll'], ['click', 'LEAD_14|||DEPT"143', '1', 0], ['view', 2],
          ['dbl', 'LEAD_12|||DEPT_63\\|||PI_1199', '2', 0]] }
    ].forEach(function (t) {
      var label = 'level toggles, clicked one by one: ' + t.name;
      guarded(label, function () {
        // Backslash keys make jQuery throw inside the chevron handlers (old and new
        // alike); those reach window.onerror and are not init errors of this run.
        var errorsBefore = (window.__errors || []).length;
        var a = runOpScript(t.cfg, t.ops, true);
        var b = runOpScript(t.cfg, t.ops, false);
        if (window.__errors) window.__errors.length = errorsBefore;
        var firstBad = -1;
        for (var i = 0; i < a.trace.length; i++) { if (a.trace[i] !== b.trace[i]) { firstBad = i; break; } }
        assert(label + ' - every recorded chevron found', a.missing === 0 && b.missing === 0, a.missing + ' / ' + b.missing + ' missing');
        assert(label + ' - visible rows + whole table identical to one click per chevron', firstBad === -1 && a.full === b.full,
          firstBad === -1 ? b.full + (a.full === b.full ? '' : ' vs old loop ' + a.full) : 'first difference after step ' + firstBad);
      });
    });
    $('#pivot-output-container').hide().empty();
    return results;
  }

  var m = /[?&]perf=([^&]+)/.exec(location.search);
  var s = /[?&]suite=1/.test(location.search);
  if (m || s) {
    var results = [];
    try {
      if (!window.__PP) throw new Error('hooks unavailable: ' + (window.__PP_ERR || 'n/a') + ' / ' + (window.__errors || []).slice(0, 3).join(' | '));
      if (s) {
        results = runSuite();
      } else {
        JSON.parse(decodeURIComponent(m[1])).forEach(function (cfg) { results.push(window.__runPivot(cfg)); });
      }
      report('RESULTS_JSON:' + JSON.stringify({ results: results, pageErrors: (window.__errors || []).slice(0, 6) }));
    } catch (e) {
      report('RESULTS_JSON:' + JSON.stringify({ fatal: String(e && e.stack || e), results: results, pageErrors: (window.__errors || []).slice(0, 6) }));
    }
  }
})();
