      var tds = tr.querySelectorAll('td[data-row-field]');
      for (var c = 0; c < tds.length; c++) {
        var td = tds[c], tg = [], ts = td.querySelectorAll('.pivot-collapse-toggle');
        for (var k = 0; k < ts.length; k++) {
