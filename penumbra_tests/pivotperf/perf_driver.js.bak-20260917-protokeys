  // Replays a recorded op list (chevrons picked by key among visible ones). Steps:
  // ['click'|'dbl', key, level, nth] | ['batch', level, action] | ['view', level] |
  // ['expandAll'] | ['collapseAll'] | ['sort', thIndex]
  function findVisibleToggle(key, level, nth) {
