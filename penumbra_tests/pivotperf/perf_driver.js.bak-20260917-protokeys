  // The nth visible right chevron at `level` in state `collapsed` whose own value
  // (its key's part at that level, id removed, safe-twin spelling) is `suffix`;
  // null = any. Both twins pick the same chevron.
  function ksToggle(level, collapsed, suffix, nth) {
    var list = table().querySelectorAll('tbody .pivot-collapse-toggle-right'), n = 0;
    for (var i = 0; i < list.length; i++) {
