    guarded('level toggles: timing', function () {
      mount({ n: 800, fields: 7, layout: 'nested', shape: 'real', seed: 4242, lazyMin: 0 });
      P.viewLevel(1);
      var level1 = '#pivotResultTable .pivot-collapse-toggle.pivot-collapse-toggle-right[data-group-level="1"]';
      var closed = $(level1 + '.pivot-group-collapsed:visible').length;
      var rows = table().tBodies[0].rows.length;
      var t0 = performance.now();
      levelChevron(1, true).dispatchEvent(new MouseEvent('dblclick', { bubbles: true, cancelable: true, view: window }));
      var ms = Math.round(performance.now() - t0);
      var opened = $(level1 + '.pivot-group-expanded:visible').length;
      assert('level toggles: timing - double-click expands all 400+ level-1 groups of a 7-field pivot in < 2,000 ms',
        ms < 2000 && closed > 400 && opened === closed, ms + ' ms, ' + opened + ' of ' + closed + ' groups open, ' + rows + ' rows before');
      $('#pivot-output-container').hide().empty();
    });

    // 9. Tables where one cleanup at the end could differ from one per click. Both
    //    op lists were found by the differential fuzzer (2026-09-17):
    //    - after a column sort a group's summary row sits away from its rows, and a
    //      per-click cleanup leaves a chevron in a row the final cleanup never picks,
    //      so the handlers must click chevron by chevron (pivotLevelToggleNeedsClicks);
    //    - keys ending in / containing a backslash: until the chevron lookups used
    //      CSS.escape (same day) the existing-chevron check never matched, every
    //      cleanup added another chevron, and these tables had to be clicked too.
    //      Now they take the one-cleanup path and must still match a click per
    //      chevron (section 10 checks such keys against plain ones);
    //    - rows built on demand with keys the HTML parser changes (&#92;, &amp;,
    //      &lt;, &quot;): while the plan was keyed by the text as written, such a
    //      group's rows were never built, its parent's first visible row moved again,
    //      and the handlers had to click (the first list, &# &bsol; &NewLine;, also
    //      missed the named references). Since the plan is keyed the way attributes
    //      read (same day) these take the one-cleanup path too.
    [
      { name: 'column-sorted table', cfg: { n: 220, fields: 5, layout: 'nested', blanks: 0.15, seed: 3467, lazyMin: 1000000000 },
        ops: [['dbl', 'R000031', '0', 0], ['click', 'R000116', '0', 0], ['click', 'R000116', '0', 0], ['dbl', 'R000116', '0', 0],
          ['dbl', 'R000046', '0', 0], ['batch', NaN, 'expand'], ['click', 'R000046', '0', 0], ['dbl', 'R000052', '0', 0], ['expandAll'],
          ['click', 'R000072|||[Blank]|||A000072|||TYPE_3', '3', 0], ['click', 'R000072|||[Blank]|||A000072|||TYPE_3', '3', 0],
          ['dbl', 'R000072|||[Blank]|||A000072|||TYPE_3', '3', 0], ['collapseAll'], ['sort', 0], ['click', 'R000111', '0', 0],
          ['dbl', 'R000051', '0', 0], ['view', 4], ['batch', 4, 'expand'], ['click', 'R000120|||[Blank]', '1', 0],
          ['dbl', 'R000066|||[Blank]|||A000066|||TYPE_1', '3', 0]] },
      { name: 'backslash keys', cfg: { n: 240, order: [8, 4, 5, 3], layout: 'nested', bs: true, seed: 7298, lazyMin: 0 },
        ops: [['batch', 0, 'collapse'], ['expandAll'], ['click', 'LEAD_0|||DEPT\\114|||PI_272', '2', 0], ['dbl', 'LEAD_2|||DEPT"106', '1', 0],
          ['click', 'LEAD_10|||DEPT"91', '1', 0], ['expandAll'], ['click', 'LEAD_14|||DEPT"143', '1', 0], ['view', 2],
          ['dbl', 'LEAD_12|||DEPT_63\\|||PI_1199', '2', 0]] },
      { name: 'character-reference keys (&#92;), built on demand', cfg: { n: 200, order: [8, 5, 3], layout: 'nested', ent: true, seed: 6601, lazyMin: 0 },
        ops: [['dbl', 'LEAD_5', '0', 0], ['dbl', 'LEAD_1|||PI_664\\x', '1', 0], ['click', 'LEAD_13|||PI_717', '1', 0], ['click', 'LEAD_9|||PI_1046', '1', 0],
          ['batch', 1, 'expand'], ['click', 'LEAD_4|||PI_803', '1', 0], ['click', 'LEAD_12|||PI_285', '1', 0], ['dbl', 'LEAD_9|||PI_2', '1', 0], ['expandAll'],
          ['dbl', 'LEAD_6|||PI_231\\x', '1', 0]] },
      { name: 'named-reference keys (&amp; &lt; &quot;), built on demand', cfg: { n: 200, order: [8, 5, 3], layout: 'nested', ent2: true, seed: 2948, lazyMin: 0 },
        ops: [['dbl', 'LEAD_9', '0', 0], ['dbl', 'LEAD_5|||PI_823&x', '1', 0], ['view', 1]] }
    ].forEach(function (t) {
      var label = 'level toggles vs one click per chevron: ' + t.name;
      guarded(label, function () {
        // Builds without the key-safe lookups throw inside the chevron handlers on
        // backslash keys; those reach window.onerror and are not init errors of this run.
        var errorsBefore = (window.__errors || []).length;
        var a = runOpScript(t.cfg, t.ops, true);
        var b = runOpScript(t.cfg, t.ops, false);
        if (window.__errors) window.__errors.length = errorsBefore;
        var firstBad = -1;
        for (var i = 0; i < a.trace.length; i++) { if (a.trace[i] !== b.trace[i]) { firstBad = i; break; } }
        assert(label + ' - every recorded chevron found', a.missing === 0 && b.missing === 0, a.missing + ' / ' + b.missing + ' missing');
        assert(label + ' - visible rows + whole table identical to one click per chevron', firstBad === -1 && a.full === b.full,
          firstBad === -1 ? b.full + (a.full === b.full ? '' : ' vs old loop ' + a.full) : 'first difference after step ' + firstBad);
      });
    });

    // 10. Key-safe chevrons (2026-09-17). Every chevron lookup (click handler,
    //     reapplyChildSummaryRowspan, restoreExpandedState, restoreCollapseState,
    //     the column-order sort's restore, the nested sort's summary re-insertion)
    //     built its selector escaping only `"`: a backslash in a key started a CSS
    //     escape (no match - and reapply added another chevron on every pass), a
    //     trailing one or a line break made the selector throw. Each script runs on
    //     the special-key twin and the plain-key twin; the tables must match after
    //     every step, with no errors and no chevron piled up.
    [
      { name: 'eager, 4 fields + a column field, CR and &#92; keys',
        cfg: { n: 240, order: [4, 8, 5, 3], cols: ['COLLAB_TYPE'], layout: 'nested', ksExtra: true, seed: 5150, lazyMin: 1000000000 },
        steps: [['click', 0, true, '_'], ['click', 0, true, '_12'], ['click', 1, true, null], ['click', 0, true, "'_"], ['click', 0, true, "_'x"],
          ['click', 0, true, '~L'], ['click', 0, true, '^F'], ['click', 0, true, '__ a]'], ['click', 0, true, '-_x'], ['click', 0, true, '__C'],
          ['click', 0, true, '_E'], ['dbl', 1, true, null], ['click', 2, true, '_'], ['click', 2, true, '~'], ['click', 2, true, "'"], ['click', 2, true, '_x'],
          ['click', 1, false, null], ['click', 0, false, '_12'], ['sortField', 0], ['click', 0, true, '_12'], ['colSort'], ['collapseRestore'],
          ['click', 0, true, '_'], ['remountRestore'], ['dbl', 1, true, null], ['batch', 2, 'expand'], ['click', 2, false, null], ['view', 2],
          ['expandAll'], ['click', 0, false, '_'], ['collapseAll']] },
      { name: 'on demand, 3 fields, department keys at level 1',
        cfg: { n: 260, order: [8, 4, 5], layout: 'nested', seed: 6262, lazyMin: 0 },
        steps: [['click', 0, true, null], ['click', 0, true, null], ['click', 0, true, null], ['click', 1, true, '_'], ['click', 1, true, '_12'],
          ['click', 1, true, "'_"], ['click', 1, true, '~L'], ['click', 1, false, '_'], ['dbl', 1, true, null], ['click', 1, false, '^F'],
          ['sortField', 1], ['click', 1, true, '^F'], ['collapseRestore'], ['remountRestore'], ['batch', 1, 'collapse'], ['view', 1],
          ['click', 1, true, '-_x'], ['expandAll'], ['click', 1, false, '__ a]'], ['collapseAll']] },
      { name: 'on demand, Top 3 per group + (Other), value-column sorts (no line breaks)',
        cfg: { n: 300, order: [8, 4, 5], layout: 'nested', rankN: 3, rankScope: 'LEAD_COLLEGE', ksNoLF: true, seed: 233, lazyMin: 0 },
        steps: [['click', 0, true, null], ['click', 0, true, null], ['click', 0, true, null], ['click', 0, true, null], ['click', 1, true, null],
          ['click', 1, true, null, 1], ['sortData'], ['click', 1, false, null], ['sortField', 1], ['dbl', 1, true, null], ['sortData'],
          ['collapseRestore'], ['expandAll'], ['sortData'], ['collapseAll']] }
    ].forEach(function (t) {
      var label = 'key-safe chevrons: ' + t.name;
      guarded(label, function () {
        var safe = runKsScript(t.cfg, 'safe', t.steps);
        var special = runKsScript(t.cfg, 'special', t.steps);
        var firstBad = -1, states = Object.create(null), distinct = 0;
        for (var i = 0; i < safe.trace.length; i++) {
          if (firstBad === -1 && safe.trace[i] !== special.trace[i]) firstBad = i;
          if (!states[safe.trace[i]]) { states[safe.trace[i]] = true; distinct++; }
        }
        assert(label + ' - same table as the plain-key twin after every step', firstBad === -1 && safe.full === special.full,
          firstBad === -1 ? (safe.full === special.full ? t.steps.length + ' steps, ' + distinct + ' distinct states' : 'whole table differs once every row is built')
            : 'first difference after step ' + firstBad + ' ' + JSON.stringify(t.steps[firstBad - 1] || 'mount'));
        assert(label + ' - no errors and no chevron twice in a cell', special.errors.length === 0 && special.dups === 0 && safe.errors.length === 0,
          special.errors.length + ' errors, ' + special.dups + ' duplicate chevrons' + (special.errors.length ? '; first: ' + special.errors[0] : '') +
          (safe.errors.length ? '; plain twin: ' + safe.errors[0] : ''));
        var kinds = safe.picked.filter(function (p, i) { return safe.picked.indexOf(p) === i; });
        assert(label + ' - every step found its chevron (non-vacuous)', safe.missing.length === 0 && special.missing.length === 0 && distinct > t.steps.length / 2,
          'missing steps ' + JSON.stringify(safe.missing) + ' / ' + JSON.stringify(special.missing) + ', ' + distinct + ' distinct states; clicked ' +
          safe.picked.length + ' chevrons, level:suffix ' + kinds.join(' '));
      });
    });
    // 11. Placeholder label cells (2026-09-17). Expanding a deepest-level group in a
    //     pivot with 4+ row fields injects hidden label cells into the detail rows the
    //     rowspan render left without one. They were built by pasting the key part -
    //     which the HTML parser has already decoded - straight into HTML: markup in the
    //     data ran (query.php escapes every plain cell, so it comes back as markup once
    //     decoded), and an @@HTML value showed its literal @@HTML prefix instead of the
    //     link its own cell shows. Both go through the sanitizing renderer now.
    [
      { name: 'markup in a parent-level value', focus: '<img', cfg: { n: 900, order: [8, 9, 6, 3], layout: 'nested', xss: true, lazyMin: 1000000000 } },
      { name: '@@HTML parents, rows built on demand', focus: '@@HTML', cfg: { n: 900, order: [7, 8, 3, 9], layout: 'nested', shape: 'real', lazyMin: 0 } }
    ].forEach(function (t) {
      var label = 'placeholder labels: ' + t.name;
      guarded(label, function () {
        window.__pnbXss = 0;
        mount(t.cfg);
        var nf = table().tHead.querySelectorAll('th[data-row-field]').length;
        // Expanding down to the deepest group level is what injects the placeholders.
        for (var lvl = 0; lvl <= nf - 2; lvl++) {
          var all = table().querySelectorAll('tbody .pivot-collapse-toggle-right.pivot-group-collapsed[data-group-level="' + lvl + '"]'), open = [];
          for (var i = 0; i < all.length; i++) { if (visibleRow(all[i].closest('tr'))) open.push(all[i]); }
          // Expand the branch carrying the interesting value FIRST - a placeholder for it
          // is the whole point, and 25 arbitrary groups may never reach it.
          if (t.focus) {
            open.sort(function (x, y) {
              return ((y.getAttribute('data-group-key') || '').indexOf(t.focus) > -1 ? 1 : 0) - ((x.getAttribute('data-group-key') || '').indexOf(t.focus) > -1 ? 1 : 0);
            });
          }
          open.slice(0, 25).forEach(function (el) { el.click(); });
        }
        var rows = table().tBodies[0].rows, byGroup = Object.create(null), rowsPerGroup = Object.create(null), cells = 0, detailRows = 0, detailRowsWithAll = 0;
        for (var r = 0; r < rows.length; r++) {
          var tr = rows[r];
          if (!visibleRow(tr)) continue;
          if (!tr.classList.contains('pivot-group-summary-row')) {
            detailRows++;
            var have = 0;
            for (var l = 0; l < nf - 1; l++) if (tr.querySelector('td[data-row-field="' + l + '"]')) have++;
            if (have === nf - 1) detailRowsWithAll++;
          }
          var tds = tr.querySelectorAll('td[data-row-field]');
          for (var c = 0; c < tds.length; c++) {
            var td = tds[c], lv = td.getAttribute('data-row-field');
            var key = tr.getAttribute('data-pivot-group-' + lv) || tr.getAttribute('data-pivot-group-summary');
            if (key === null) continue;
            var clone = td.cloneNode(true), tog = clone.querySelectorAll('.pivot-collapse-toggle');
            for (var q = 0; q < tog.length; q++) tog[q].remove();
            var shape = JSON.stringify({ text: clone.textContent.trim(), a: clone.querySelectorAll('a').length, img: clone.querySelectorAll('img').length });
            var id = lv + '' + key;
            if (!byGroup[id]) byGroup[id] = Object.create(null);
            byGroup[id][shape] = true;
            rowsPerGroup[id] = (rowsPerGroup[id] || 0) + 1;
            cells++;
          }
        }
        var bad = Object.keys(byGroup).filter(function (id) { return Object.keys(byGroup[id]).length > 1; });
        var loose = table().querySelectorAll('tbody img, tbody script, tbody iframe').length;
        assert(label + ' - markup in the data stays data', loose === 0 && !window.__pnbXss,
          loose + ' img/script/iframe elements in the body, onerror ran ' + (window.__pnbXss || 0) + ' times');
        assert(label + ' - every label cell of a group shows the same thing', bad.length === 0,
          bad.length + ' of ' + Object.keys(byGroup).length + ' (level, group) pairs differ' +
          (bad.length ? '; first: ' + Object.keys(byGroup[bad[0]]).join(' VS ').slice(0, 220) : ''));
        // Groups whose label sits on more than one row are the ones a placeholder was
        // injected for, so they are what makes the two asserts above non-vacuous.
        var spread = Object.keys(rowsPerGroup).filter(function (id) { return rowsPerGroup[id] > 1; }).length;
        assert(label + ' - non-vacuous: detail rows carry every parent label cell', detailRows >= 20 && detailRowsWithAll === detailRows && spread >= 5,
          detailRowsWithAll + ' of ' + detailRows + ' detail rows, ' + cells + ' label cells over ' + Object.keys(byGroup).length +
          ' groups, ' + spread + ' of them labelled on several rows');
      });
    });
    $('#pivot-output-container').hide().empty();
    return results;
  }

  var m = /[?&]perf=([^&]+)/.exec(location.search);
  var s = /[?&]suite=1/.test(location.search);
  if (m || s) {
    var results = [];
    try {
      if (!window.__PP) throw new Error('hooks unavailable: ' + (window.__PP_ERR || 'n/a') + ' / ' + (window.__errors || []).slice(0, 3).join(' | '));
      if (s) {
        results = runSuite();
      } else {
        JSON.parse(decodeURIComponent(m[1])).forEach(function (cfg) { results.push(window.__runPivot(cfg)); });
      }
      report('RESULTS_JSON:' + JSON.stringify({ results: results, pageErrors: (window.__errors || []).slice(0, 6) }));
    } catch (e) {
      report('RESULTS_JSON:' + JSON.stringify({ fatal: String(e && e.stack || e), results: results, pageErrors: (window.__errors || []).slice(0, 6) }));
    }
  }
