    for (var h = 0; h < ths.length; h++) head.push(ksClasses(ths[h]));
    var rows = t.tBodies[0].rows, out = [head.join(',')];
    for (var i = 0; i < rows.length; i++) {
      var tr = rows[i], parts = [visibleRow(tr) ? 'V' : 'H', ksClasses(tr)];
      var sk = tr.getAttribute('data-pivot-group-summary');
      if (sk !== null) parts.push('S' + tr.getAttribute('data-pivot-group-summary-level') + '=' + canon(sk));
      for (var l = 0; l < ths.length; l++) {
        var g = tr.getAttribute('data-pivot-group-' + l);
        if (g !== null) parts.push('g' + l + '=' + canon(g));
