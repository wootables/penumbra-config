# =============================================================================
# Run the people-directory resolver tests (penumbra_directory.php).
#
#   powershell -File run.ps1
#   powershell -File run.ps1 -App <path>    # run against a stage instead of live
#   powershell -File run.ps1 -Mutant        # three targeted mutants; each MUST
#                                           # go RED with the exact fail count
#                                           # named below
#
# WHAT IS UNDER TEST. On 2026-09-23 the six places Penumbra looks a person up
# (scheduler recipient variables and OUC authorization, the recipient picker,
# owner-by-name search, OUC info, journal mentions and access lists, analytics
# departments) moved from scraping COI_CHECK_COMPLIANCE to one resolver family
# over NC_REPORTING.PENUMBRA_PEOPLE. This suite drives those resolvers against a
# hand-written fake connection: the SQL each one sends, the binds, the row
# shaping, the batching, and the rule that SUPERVISOR_EMAIL (HR's EMAIL_ADDR,
# which is the supervisor's address) is never matched as the person's own.
#
# -n (skip php.ini): nothing here needs an extension or a database.
#
# EXPECTED TAIL: "PASS: 57   FAIL: 0" then "RESULT: GREEN"  (count as of 2026-09-23)
#
# UNC .ps1 files are GPO-blocked here ("not digitally signed") - run the body as
# a scriptblock rather than with -File. Never add a bare `exit` for the same
# reason: it would kill the caller.
# =============================================================================
param(
    [string]$App = '\\oitras\c$\inetpub\wwwroot\sponsor_migration\penumbra',
    [switch]$Mutant
)

$ErrorActionPreference = 'Stop'
$here = $PSScriptRoot
if (-not $here -and $MyInvocation.MyCommand.Path) { $here = Split-Path -Parent $MyInvocation.MyCommand.Path }
# Invoked as a scriptblock (the UNC workaround) neither of the above exists.
if (-not $here) { $here = '\\oitras\d$\Utilities\PHP_8.2-p\penumbra_tests\peopledir' }
$php  = '\\oitras\d$\Utilities\PHP_8.2-p\php.exe'
$test = Join-Path $here 'test_peopledir.php'
$src  = Join-Path $App 'penumbra_directory.php'

if (-not $Mutant) {
    & $php -n $test $src
    return
}

# --- targeted mutants -------------------------------------------------------
# Each reverts ONE decision the resolvers make. The expected fail count is
# exact: a mutant that stays GREEN, or that goes red in more places than named,
# means the suite is no longer pinning what it claims to pin.
$text = [IO.File]::ReadAllText($src)
$tmp  = Join-Path $env:TEMP ('pnb_peopledir_mut_' + $PID)
New-Item -ItemType Directory -Force $tmp | Out-Null

$mutants = @(
    @{ Name = 'email lookup loses the Unity-ID fallback (COI-era addresses whose HR EMAILID differs stop resolving)';
       From = "' WHERE EMAIL = :e1 OR UNITY_ID = :u'";   To = "' WHERE EMAIL = :e1'";   Expect = 1 },
    @{ Name = 'OUC people list no longer restricted to active people';
       From = "' WHERE ACTIVE = 1 AND UNITY_ID IS NOT NULL AND ('";   To = "' WHERE UNITY_ID IS NOT NULL AND ('";   Expect = 1 },
    @{ Name = 'unity batches lose the unity@ncsu.edu EMAIL fallback (people HR gives no Unity ID vanish)';
       From = "') OR EMAIL IN (' . implode(',', `$phE) . ')'";   To = "')'";   Expect = 1 }
)

$allGood = $true
foreach ($m in $mutants) {
    if ($text.IndexOf($m.From) -lt 0) { Write-Host ("MUTANT NOT APPLICABLE (anchor missing): " + $m.Name); $allGood = $false; continue }
    $mutated = $text.Replace($m.From, $m.To)
    $file = Join-Path $tmp 'penumbra_directory.php'
    [IO.File]::WriteAllText($file, $mutated)
    $out  = & $php -n $test $file 2>&1 | Out-String
    $fail = 0
    if ($out -match 'FAIL:\s+(\d+)') { $fail = [int]$Matches[1] }
    $verdict = if ($fail -eq $m.Expect) { 'OK  ' } else { 'BAD ' }
    if ($fail -ne $m.Expect) { $allGood = $false }
    Write-Host ("{0} mutant '{1}' -> FAIL: {2} (expected {3})" -f $verdict, $m.Name, $fail, $m.Expect)
}
Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue
Write-Host ('MUTANTS: ' + $(if ($allGood) { 'ALL BITE' } else { 'PROBLEM' }))
