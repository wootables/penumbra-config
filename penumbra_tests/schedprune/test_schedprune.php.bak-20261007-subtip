// ------------------------------------------------------------ assertion core
$PASS = 0; $FAIL = 0; $FAILED = array(); $QUIET = false;
function ok($cond, $label, $detail = '') {
    global $PASS, $FAIL, $FAILED, $QUIET;
    if ($cond) { $PASS++; return true; }
    $FAIL++; $FAILED[] = $label;
    if (!$QUIET) { echo "    FAIL  $label\n"; if ($detail !== '') echo "            $detail\n"; }
    return false;
}
function eq($actual, $expected, $label) {
    return ok($actual === $expected, $label,
        'expected ' . json_encode($expected) . '  actual ' . json_encode($actual));
}
function section($t) { global $QUIET; if (!$QUIET) echo "$t\n"; }

// ============================================================== PART A
// Drift guard over schedule_runner.php (+ the form literal in main.js).
// ======================================================================

/** Token list with byte offsets; T_* ids for array tokens, null for 1-char ones. */
function pnb_tokens($src) {
    $out = array(); $off = 0;
    foreach (token_get_all($src) as $t) {
        $txt = is_array($t) ? $t[1] : $t;
        $out[] = array(is_array($t) ? $t[0] : null, $txt, $off);
        $off += strlen($txt);
    }
    return $out;
}
function pnb_is_open($tok)  { return $tok[1] === '{' || $tok[0] === T_CURLY_OPEN || $tok[0] === T_DOLLAR_OPEN_CURLY_BRACES; }
function pnb_match_brace($toks, $i) {
    $depth = 0; $n = count($toks);
    for ($k = $i; $k < $n; $k++) {
        if (pnb_is_open($toks[$k])) { $depth++; }
        elseif ($toks[$k][1] === '}') { $depth--; if ($depth === 0) return $k; }
    }
    return -1;
}
function pnb_next_sig($toks, $i, $dir) {
    $n = count($toks);
    for ($k = $i + $dir; $k >= 0 && $k < $n; $k += $dir) {
        if (!in_array($toks[$k][0], array(T_WHITESPACE, T_COMMENT, T_DOC_COMMENT), true)) return $k;
    }
    return -1;
}
function pnb_line($src, $off) { return substr_count($src, "\n", 0, $off) + 1; }

/**
 * Scan $src for string literals naming any of $keys and classify each one.
 * Returns array('anchors' => [name => count], 'occ' => [ [key, line, class] ... ]).
 * class: 'EMAIL' | 'EMAIL via f>g' | 'NON_EMAIL:<region>[ via f>g]'
 */
function pnb_scan_runner($src, array $keys) {
    $toks = pnb_tokens($src);
    $n = count($toks);
    $offToIdx = array();
    for ($i = 0; $i < $n; $i++) { if ($toks[$i][1] === '{') $offToIdx[$toks[$i][2]] = $i; }

    $anchors = array(
        'EMAIL'     => "if (\$task['TASK_TYPE'] === 'EMAIL') {",
        'SNAPSHOT'  => "} else if (\$task['TASK_TYPE'] === 'SNAPSHOT') {",
        'DROP_FILE' => "} else if (\$task['TASK_TYPE'] === 'DROP_FILE') {",
        'DB_DUMP'   => "} else if (\$task['TASK_TYPE'] === 'DB_DUMP') {",
    );
    $spans = array(); $counts = array();
    foreach ($anchors as $name => $a) {
        $counts[$name] = substr_count($src, $a);
        if ($counts[$name] !== 1) continue;
        $bo = strpos($src, $a) + strlen($a) - 1;
        if (!isset($offToIdx[$bo])) { $counts[$name] = -1; continue; }
        $oi = $offToIdx[$bo]; $ci = pnb_match_brace($toks, $oi);
        $spans[$name] = array($toks[$oi][2], $ci >= 0 ? $toks[$ci][2] : PHP_INT_MAX);
    }

    // Named functions: [name, bodyStartOff, bodyEndOff]
    $funcs = array();
    for ($i = 0; $i < $n; $i++) {
        if ($toks[$i][0] !== T_FUNCTION) continue;
        $j = pnb_next_sig($toks, $i, 1);
        if ($j >= 0 && $toks[$j][1] === '&') $j = pnb_next_sig($toks, $j, 1);
        if ($j < 0 || $toks[$j][0] !== T_STRING) continue;
        $name = $toks[$j][1];
        $k = $j; while ($k < $n && $toks[$k][1] !== '(') $k++;
        $pd = 0;
        for (; $k < $n; $k++) { if ($toks[$k][1] === '(') $pd++; elseif ($toks[$k][1] === ')') { $pd--; if ($pd === 0) break; } }
        while ($k < $n && !pnb_is_open($toks[$k]) && $toks[$k][1] !== ';') $k++;
        if ($k >= $n || $toks[$k][1] === ';') continue;
        $e = pnb_match_brace($toks, $k);
        $funcs[] = array($name, $toks[$k][2], $e >= 0 ? $toks[$e][2] : PHP_INT_MAX);
    }
    // Call sites by name (name( not preceded by function/->/::/new), plus 'name' string callbacks.
    $sites = array();
    $skipPrev = array(T_FUNCTION, T_OBJECT_OPERATOR, T_DOUBLE_COLON, T_NEW);
    if (defined('T_NULLSAFE_OBJECT_OPERATOR')) $skipPrev[] = T_NULLSAFE_OBJECT_OPERATOR;
    $fnNames = array();
    foreach ($funcs as $f) $fnNames[$f[0]] = true;
    for ($i = 0; $i < $n; $i++) {
        $id = $toks[$i][0];
        if ($id === T_STRING || (defined('T_NAME_FULLY_QUALIFIED') && $id === T_NAME_FULLY_QUALIFIED)) {
            $nm = ltrim($toks[$i][1], '\\');
            if (!isset($fnNames[$nm])) continue;
            $nx = pnb_next_sig($toks, $i, 1); $pv = pnb_next_sig($toks, $i, -1);
            if ($nx < 0 || $toks[$nx][1] !== '(') continue;
            if ($pv >= 0 && in_array($toks[$pv][0], $skipPrev, true)) continue;
            $sites[$nm][] = $toks[$i][2];
        } elseif ($id === T_CONSTANT_ENCAPSED_STRING) {
            $nm = substr($toks[$i][1], 1, -1);
            if (isset($fnNames[$nm])) $sites[$nm][] = $toks[$i][2];
        }
    }

    $inSpan = function ($off, $name) use ($spans) {
        return isset($spans[$name]) && $off > $spans[$name][0] && $off < $spans[$name][1];
    };
    $fnAt = function ($off) use ($funcs) {
        $best = null;
        foreach ($funcs as $f) {
            if ($off > $f[1] && $off < $f[2] && ($best === null || $f[1] > $best[1])) $best = $f;
        }
        return $best;
    };
    $classify = function ($off, $seen) use (&$classify, $inSpan, $fnAt, &$sites) {
        // Branch spans first: the task loop may itself sit inside a function,
        // and a read in a type branch belongs to that TYPE, not to the loop's caller.
        if ($inSpan($off, 'EMAIL')) return 'EMAIL';
        foreach (array('SNAPSHOT', 'DROP_FILE', 'DB_DUMP') as $b) { if ($inSpan($off, $b)) return "NON_EMAIL:$b"; }
        $f = $fnAt($off);
        if ($f === null) return 'NON_EMAIL:SHARED';
        $nm = $f[0];
        if (isset($seen[$nm])) return 'EMAIL';           // a cycle adds no new entry point
        if (empty($sites[$nm])) return "NON_EMAIL:uncalled $nm";
        $seen[$nm] = true;
        foreach ($sites[$nm] as $so) {
            $c = $classify($so, $seen);
            if (strpos($c, 'NON_EMAIL') === 0) return $c . " via $nm";
        }
        return "EMAIL via $nm";
    };

    $want = array_flip($keys);
    $occ = array();
    for ($i = 0; $i < $n; $i++) {
        if ($toks[$i][0] !== T_CONSTANT_ENCAPSED_STRING) continue;
        $v = substr($toks[$i][1], 1, -1);
        if (!isset($want[$v])) continue;
        $occ[] = array($v, pnb_line($src, $toks[$i][2]), $classify($toks[$i][2], array()));
    }
    return array('anchors' => $counts, 'occ' => $occ);
}

/** Keys of main.js's `var optionsObj = { ... };` - what the form writes for EVERY type. */
function pnb_form_literal_keys($js, &$err) {
    $a = 'var optionsObj = {';
    if (substr_count($js, $a) !== 1) { $err = 'optionsObj literal anchor found ' . substr_count($js, $a) . 'x'; return array(); }
    $p = strpos($js, $a) + strlen($a) - 1; $depth = 0; $q = null; $n = strlen($js);
    for ($i = $p; $i < $n; $i++) {
        $c = $js[$i];
        if ($q !== null) { if ($c === '\\') { $i++; continue; } if ($c === $q) $q = null; continue; }
        if ($c === "'" || $c === '"' || $c === '`') { $q = $c; continue; }
        if ($c === '/' && $i + 1 < $n && $js[$i + 1] === '/') { $e = strpos($js, "\n", $i); $i = ($e === false) ? $n : $e; continue; }
        if ($c === '{') $depth++;
        elseif ($c === '}') { $depth--; if ($depth === 0) break; }
    }
    $body = preg_replace('~//[^\n]*~', '', substr($js, $p + 1, $i - $p - 1));
    preg_match_all('/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*:/m', $body, $m);
    $err = null;
    return array_values(array_unique($m[1]));
}

function pnb_part_a($RUNNER, $MAINJS, $EMAIL_ONLY) {
    section('PART A - schedule_runner.php reads the pruned keys on EMAIL paths only');
    $src = file_get_contents($RUNNER);
    $js  = file_get_contents($MAINJS);
    $jsErr = null;
    $formKeys = pnb_form_literal_keys($js, $jsErr);
    ok($jsErr === null, 'main.js: the optionsObj literal is found exactly once', (string)$jsErr);
    ok(count($formKeys) >= 15 && in_array('attach_csv', $formKeys, true) && in_array('prompt_answers', $formKeys, true),
        'main.js: optionsObj literal keys extracted (' . count($formKeys) . ')', implode(',', $formKeys));
    // changes_only is assigned outside the literal but unconditionally (every type).
    $formAll = $formKeys;
    if (strpos($js, 'optionsObj.changes_only = ') !== false) $formAll[] = 'changes_only';
    ok(in_array('changes_only', $formAll, true), 'main.js: the unconditional optionsObj.changes_only assignment is found');

    $scanKeys = array_values(array_unique(array_merge($EMAIL_ONLY, $formAll)));
    $r = pnb_scan_runner($src, $scanKeys);
    foreach ($r['anchors'] as $nm => $c) eq($c, 1, "runner: the $nm branch anchor is found exactly once");

    $byKey = array();
    foreach ($r['occ'] as $o) $byKey[$o[0]][] = $o;
    global $DUMP;
    if ($DUMP) {
        foreach ($r['occ'] as $o) printf("      %-24s line %-6d %s\n", $o[0], $o[1], $o[2]);
        echo '      form literal keys: ' . implode(', ', $formAll) . "\n";
    }

    // 1. Every pruned key: no non-EMAIL reader (theme_override may sit in DROP_FILE).
    foreach ($EMAIL_ONLY as $k) {
        $bad = array();
        foreach (isset($byKey[$k]) ? $byKey[$k] : array() as $o) {
            if (strpos($o[2], 'NON_EMAIL') !== 0) continue;
            if ($k === 'theme_override' && strpos($o[2], 'NON_EMAIL:DROP_FILE') === 0) continue;
            $bad[] = 'line ' . $o[1] . ' ' . $o[2];
        }
        ok(empty($bad), "runner: '$k' is read on EMAIL paths only" . ($k === 'theme_override' ? ' (+ DROP_FILE)' : ''),
            'non-EMAIL reader(s): ' . implode('; ', $bad) . ' - keep the key for that type in penumbra_sched_prune_email_only()');
    }
    // 2. The scan actually sees things (a scanner that finds nothing passes vacuously).
    foreach (array('attach_csv', 'include_link', 'body_preamble', 'theme_override', 'subscriptions_enabled') as $k) {
        $hit = false;
        foreach (isset($byKey[$k]) ? $byKey[$k] : array() as $o) if ($o[2] === 'EMAIL') $hit = true;
        ok($hit, "scanner sanity: the EMAIL branch reads '$k'");
    }
    $dropTheme = false;
    foreach (isset($byKey['theme_override']) ? $byKey['theme_override'] : array() as $o) {
        if ($o[2] === 'NON_EMAIL:DROP_FILE') $dropTheme = true;
    }
    ok($dropTheme, "runner: the DROP_FILE branch reads 'theme_override' (the reason DROP_FILE keeps it)");
    $via = false;
    foreach (isset($byKey['changes_only']) ? $byKey['changes_only'] : array() as $o) {
        if (strpos($o[2], 'EMAIL via ') === 0) $via = true;
    }
    ok($via, "scanner sanity: 'changes_only' is resolved through a helper's call sites to EMAIL");

    // 3. Reverse check: a key the form writes for EVERY type is read off-EMAIL, or pruned.
    foreach ($formAll as $k) {
        if (in_array($k, $EMAIL_ONLY, true)) continue;
        $shared = false;
        foreach (isset($byKey[$k]) ? $byKey[$k] : array() as $o) if (strpos($o[2], 'NON_EMAIL') === 0) $shared = true;
        ok($shared, "form key '$k' (written for every type) is read by a non-EMAIL path",
            'only EMAIL reads it - add it to penumbra_sched_prune_email_only(), or it leaks onto every other type');
    }

    // 4. The guard can fail: a reader injected into the DB_DUMP branch must be caught.
    $a = "} else if (\$task['TASK_TYPE'] === 'DB_DUMP') {";
    $inj = str_replace($a, $a . "\n\$__pnb_probe = \$options['attach_csv'];", $src);
    unset($src);
    $r2 = pnb_scan_runner($inj, array('attach_csv'));
    $caught = false;
    foreach ($r2['occ'] as $o) if ($o[2] === 'NON_EMAIL:DB_DUMP') $caught = true;
    ok($caught, 'negative control: an attach_csv reader injected into the DB_DUMP branch is flagged');
}

// ============================================================== PART B
// The helper, lifted from the manage_schedule.php under test.
// ======================================================================
function pnb_lift_function($src, $name) {
    $toks = pnb_tokens($src); $n = count($toks);
    for ($i = 0; $i < $n; $i++) {
        if ($toks[$i][0] !== T_FUNCTION) continue;
        $j = pnb_next_sig($toks, $i, 1);
        if ($j < 0 || $toks[$j][0] !== T_STRING || $toks[$j][1] !== $name) continue;
        $k = $j; while ($k < $n && $toks[$k][1] !== '{') $k++;
        $e = pnb_match_brace($toks, $k);
        if ($e < 0) return null;
        return substr($src, $toks[$i][2], $toks[$e][2] + 1 - $toks[$i][2]);
    }
    return null;
}
