function pnb_part_b($MANAGE, $EMAIL_ONLY) {
    section('PART B - penumbra_sched_prune_email_only()');
    static $seq = 0;
    $code = pnb_lift_function(file_get_contents($MANAGE), 'penumbra_sched_prune_email_only');
    if (!ok($code !== null, 'helper: penumbra_sched_prune_email_only() is defined in manage_schedule.php')) return;
    $fn = 'pnb_prune_under_test_' . (++$seq);
    eval(preg_replace('/function\s+penumbra_sched_prune_email_only\s*\(/', "function $fn(", $code, 1));
    $full = pnb_full_options();
    $removed = function ($type) use ($fn, $full) { $o = $fn($type, $full); $d = array_keys(array_diff_key($full, $o)); sort($d); return $d; };

    eq($fn('EMAIL', $full), $full, 'helper: EMAIL options come back unchanged');
    eq($removed('DB_DUMP'), $EMAIL_ONLY, 'helper: DB_DUMP drops exactly the 13 email-only keys');
    eq($removed('SNAPSHOT'), $EMAIL_ONLY, 'helper: SNAPSHOT drops exactly the 13 email-only keys');
    $noTheme = array_values(array_diff($EMAIL_ONLY, array('theme_override')));
    eq($removed('DROP_FILE'), $noTheme, 'helper: DROP_FILE drops the 12 and KEEPS theme_override');
    eq($removed('WEBHOOK'), $EMAIL_ONLY, 'helper: any other type is treated like DB_DUMP');
    $kept = $fn('DB_DUMP', $full);
    $keptShould = array_diff_key($full, array_flip($EMAIL_ONLY));
    eq($kept, $keptShould, 'helper: every other key (shared, type-specific, subscribers/suppressed, _test_run_*) survives untouched');
    eq($fn('DB_DUMP', $kept), $kept, 'helper: idempotent');
    eq($fn('DB_DUMP', null), null, 'helper: a non-array (undecodable options) passes through');
    eq($fn('DB_DUMP', array()), array(), 'helper: an empty options array stays empty');
}

// ============================================================== PART C
// The shipped endpoint under a fake database, one process per request.
// ======================================================================
function pnb_build_core($srcFile, $destFile) {
    $out = array(); $hit = array('require' => 0, 'csrf' => 0, 'header' => 0, 'exit' => 0);
    foreach (file($srcFile) as $ln) {
        $t = trim($ln);
        if (preg_match("/^require_once '(db_connection|penumbra_health|cron_describe|penumbra_template|penumbra_subscribe_condition)\\.php';/", $t)) { $hit['require']++; $out[] = "// [harness] require stripped\n"; continue; }
        if (strpos($t, 'penumbraCsrfGuard(') === 0) { $hit['csrf']++; $out[] = "// [harness] csrf guard stripped\n"; continue; }
        if ($t === "header('Content-Type: application/json');") { $hit['header']++; $out[] = "// [harness] header stripped\n"; continue; }
        if ($t === 'exit;') {
            $hit['exit']++;
            $out[] = substr($ln, 0, strlen($ln) - strlen(ltrim($ln))) . "throw new PnbHarnessExit();\n";
            continue;
        }
        $out[] = $ln;
    }
    file_put_contents($destFile, implode('', $out));
    return $hit;
}
function pnb_proc(array $cmd) {
    $p = proc_open($cmd, array(1 => array('pipe', 'w'), 2 => array('pipe', 'w')), $pipes, sys_get_temp_dir());
    if (!is_resource($p)) return array(-1, '', 'proc_open failed');
    $so = stream_get_contents($pipes[1]); $se = stream_get_contents($pipes[2]);
    fclose($pipes[1]); fclose($pipes[2]);
    return array(proc_close($p), $so, $se);
}
function pnb_run($core, array $scn) {
    global $CHILD, $TEMPLATE, $SUBCOND;
    $sf = tempnam(sys_get_temp_dir(), 'pnbs'); $of = tempnam(sys_get_temp_dir(), 'pnbo');
    file_put_contents($sf, json_encode($scn));
    list($rc, $so, $se) = pnb_proc(array(PHP_BINARY, '-n', '-d', 'date.timezone=America/New_York', $CHILD, $core, $sf, $of, $TEMPLATE, $SUBCOND));
    $res = json_decode((string)@file_get_contents($of), true);
    @unlink($sf); @unlink($of);
    if (!is_array($res)) {
        $res = array('response' => '', 'error' => "child wrote no result (rc=$rc) " . trim($so . ' ' . $se),
                     'rec' => array('stmts' => array(), 'audits' => array(), 'unknown' => array(), 'warnings' => array()));
    }
    $res['stderr'] = trim($se);
    return $res;
}
function pnb_stmts($res, $kind) { $o = array(); foreach ($res['rec']['stmts'] as $s) if ($s['kind'] === $kind) $o[] = $s; return $o; }
function pnb_audits($res, $action) { $o = array(); foreach ($res['rec']['audits'] as $a) if ($a['action'] === $action) $o[] = $a; return $o; }
function pnb_has_any(array $opts, array $keys) { return array_values(array_intersect($keys, array_keys($opts))); }

