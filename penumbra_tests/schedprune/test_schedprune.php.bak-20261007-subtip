echo "test_schedprune.php  (PHP " . PHP_VERSION . ", tz " . date_default_timezone_get() . ")\n";
echo "  manage : $MANAGE\n  runner : $RUNNER\n  main.js: $MAINJS\n";
pnb_part_a($RUNNER, $MAINJS, $EMAIL_ONLY);
