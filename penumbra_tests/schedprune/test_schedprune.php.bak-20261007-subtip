/** Common per-request health: success, no crash, nothing unrecognised, no PHP warnings. */
function pnb_healthy($tag, $res) {
    $resp = json_decode(trim($res['response']), true);
    ok($res['error'] === null, "$tag: request ran to its exit", (string)$res['error']);
    ok(is_array($resp) && isset($resp['status']) && $resp['status'] === 'success', "$tag: status success", substr($res['response'], 0, 300));
    ok(empty($res['rec']['unknown']), "$tag: every statement recognised by the fake", implode(' | ', $res['rec']['unknown']));
    ok(empty($res['rec']['warnings']), "$tag: no PHP warnings/notices", implode(' | ', $res['rec']['warnings']));
    return $resp;
}
/** The single task write + the matching lifecycle audit, decoded. */
function pnb_write($tag, $res, $kind, $action) {
    $w = pnb_stmts($res, $kind);
    ok(count($w) === 1, "$tag: exactly one $kind", 'got ' . count($w));
    $a = pnb_audits($res, $action);
    ok(count($a) === 1, "$tag: exactly one $action audit", 'got ' . count($a));
    $opts = $w ? json_decode((string)$w[0]['binds'][':opts'], true) : null;
    $rec  = $w ? $w[0]['binds'][':rec'] : null;
    $after = $a ? json_decode((string)$a[0]['after'], true) : null;
    return array(is_array($opts) ? $opts : array(), $rec, is_array($after) ? $after : array(), $a ? $a[0] : null);
}

function pnb_part_c($MANAGE, $EMAIL_ONLY, $only = null) {
    section('PART C - the shipped endpoint (save + restore_from_audit)');
    $core = sys_get_temp_dir() . '/pnb_schedprune_core_' . getmypid() . '_' . mt_rand() . '.php';
    $hit = pnb_build_core($MANAGE, $core);
    eq($hit['require'], 5, 'harness: five requires stripped (db_connection, penumbra_health, cron_describe, penumbra_template, penumbra_subscribe_condition)');
    eq($hit['csrf'], 1, 'harness: penumbraCsrfGuard() stripped exactly once');
    eq($hit['header'], 1, 'harness: Content-Type header stripped exactly once');
    ok($hit['exit'] >= 40, 'harness: every bare exit; became a throw (>= 40)', 'got ' . $hit['exit']);
    list($lrc, $lso, $lse) = pnb_proc(array(PHP_BINARY, '-n', '-l', $core));
    eq($lrc, 0, 'harness: patched core parses (' . trim($lso . $lse) . ')');

    $noTheme = array_values(array_diff($EMAIL_ONLY, array('theme_override')));
    foreach (pnb_scenarios() as $tag => $scn) {
        if ($only !== null && !in_array($tag, $only, true)) continue;
        $res = pnb_run($core, $scn);
        // A REFUSED save: an error envelope, and nothing written or audited.
        if (in_array($tag, array('df_custom_empty', 'df_custom_clash', 'df_custom_badext'), true)) {
            $r = json_decode(trim($res['response']), true);
            $want = array('df_custom_empty' => 'row template is empty', 'df_custom_clash' => 'collides with the CSV format',
                          'df_custom_badext' => 'file type must be one of');
            ok($res['error'] === null, "$tag: request ran to its exit", (string)$res['error']);
            ok(is_array($r) && isset($r['status']) && $r['status'] === 'error' && strpos((string)$r['message'], $want[$tag]) !== false,
               "$tag: refused with the reason", substr($res['response'], 0, 300));
            eq(count(pnb_stmts($res, 'INSERT_TASK')) + count(pnb_stmts($res, 'UPDATE_TASK')), 0, "$tag: nothing written");
            eq(count($res['rec']['audits']), 0, "$tag: nothing audited");
            ok(empty($res['rec']['warnings']), "$tag: no PHP warnings/notices", implode(' | ', $res['rec']['warnings']));
            continue;
        }
        $resp = pnb_healthy($tag, $res);
        $sent = json_decode($scn['post']['options'] ?? 'null', true);
        if ($tag === 'df_custom_ok') {
            list($opts, $rec, $after) = pnb_write($tag, $res, 'INSERT_TASK', 'SCHEDULE_NEW');
            foreach (array('drop_format_custom', 'drop_custom_header', 'drop_custom_template', 'drop_custom_newline') as $k) {
                ok(array_key_exists($k, $opts) && $opts[$k] === $sent[$k], "df_custom_ok: '$k' stored VERBATIM (leading/trailing spaces are content)");
            }
            eq(isset($opts['drop_custom_ext']) ? $opts['drop_custom_ext'] : null, 'tsv', 'df_custom_ok: the file type is normalised to lower case');
            ok(isset($after['OPTIONS']) && $after['OPTIONS'] == $opts, 'df_custom_ok: the audit AFTER records exactly what was stored');
        }

        if ($tag === 'dd_update' || $tag === 'dd_insert') {
            list($opts, $rec, $after, $arow) = pnb_write($tag, $res, $tag === 'dd_update' ? 'UPDATE_TASK' : 'INSERT_TASK',
                                                         $tag === 'dd_update' ? 'SCHEDULE_UPDATE' : 'SCHEDULE_NEW');
            eq(pnb_has_any($opts, $EMAIL_ONLY), array(), "$tag: stored OPTIONS carry no email-only key");
            eq($rec, '', "$tag: stored RECIPIENTS blank (not the hidden creator capsule)");
            eq(pnb_has_any(isset($after['OPTIONS']) ? $after['OPTIONS'] : array(), $EMAIL_ONLY), array(), "$tag: audit AFTER.OPTIONS carry no email-only key");
            eq(isset($after['RECIPIENTS']) ? $after['RECIPIENTS'] : null, '', "$tag: audit AFTER.RECIPIENTS blank");
            ok(isset($after['OPTIONS']) && $after['OPTIONS'] == $opts, "$tag: the audit AFTER records exactly what was stored");
            foreach (array('prompt_answers', 'me_map', 'search_filter', 'skip_if_missed_min', 'skip_empty', 'change_mode',
                           'notify_success', 'notify_success_recipients', 'notify_failure', 'notify_failure_recipients',
                           'dbdump_columns_custom', 'dbdump_row_mode', 'dbdump_reload_mode', 'dbdump_strip_html') as $k) {
                ok(array_key_exists($k, $opts) && $opts[$k] === $sent[$k], "$tag: '$k' stored as sent");
            }
            eq(isset($opts['destination_schema']) ? $opts['destination_schema'] : null, 'PENUMBRA_RW', "$tag: destination_schema still server-resolved");
            eq(isset($opts['reader_role']) ? $opts['reader_role'] : null, 'ORIED_RO', "$tag: reader_role default still applied");
            if ($tag === 'dd_update') {
                $before = json_decode((string)$arow['before'], true);
                ok(isset($before['OPTIONS']['recipient_vars']) && $before['RECIPIENTS'] === 'Pat Owner <powner@ncsu.edu>;',
                   'dd_update: audit BEFORE is the row as it was (evidence untouched)');
            }
        }
        if ($tag === 'em_update') {
            list($opts, $rec, $after) = pnb_write($tag, $res, 'UPDATE_TASK', 'SCHEDULE_UPDATE');
            $miss = array_values(array_diff($EMAIL_ONLY, array_keys($opts)));
            eq($miss, array(), 'em_update: EMAIL keeps every email-only key');
            ok(isset($opts['recipient_vars']) && $opts['recipient_vars'] === $sent['recipient_vars'], 'em_update: recipient_vars stored as sent');
            eq($rec, 'Pat Owner <powner@ncsu.edu>;', 'em_update: RECIPIENTS stored as sent');
            eq(pnb_has_any(isset($after['OPTIONS']) ? $after['OPTIONS'] : array(), $EMAIL_ONLY), $EMAIL_ONLY, 'em_update: audit AFTER keeps them too');
        }
        if ($tag === 'df_insert') {
            list($opts, $rec, $after) = pnb_write($tag, $res, 'INSERT_TASK', 'SCHEDULE_NEW');
            eq(isset($opts['theme_override']) ? $opts['theme_override'] : null, 'theme-wolfpack', 'df_insert: DROP_FILE keeps theme_override (its PDF theme)');
            eq(pnb_has_any($opts, $noTheme), array(), 'df_insert: DROP_FILE drops the other 12');
            eq($rec, '', 'df_insert: RECIPIENTS blank');
            ok(isset($opts['drop_path']) && $opts['drop_format_pdf'] === true, 'df_insert: drop_* keys stored as sent');
        }
        if ($tag === 'sn_insert') {
            list($opts, $rec) = pnb_write($tag, $res, 'INSERT_TASK', 'SCHEDULE_NEW');
            eq(pnb_has_any($opts, $EMAIL_ONLY), array(), 'sn_insert: SNAPSHOT drops all 13 (theme_override included)');
            eq(isset($opts['snap_max_keep']) ? $opts['snap_max_keep'] : null, 50, 'sn_insert: snap_max_keep stored as sent');
            eq($rec, '', 'sn_insert: RECIPIENTS blank');
        }
        if ($tag === 'dd_test') {
            $w = pnb_stmts($res, 'INSERT_TASK');
            ok(count($w) === 1, 'dd_test: exactly one INSERT_TASK (the transient row)');
            $opts = $w ? json_decode((string)$w[0]['binds'][':opts'], true) : array();
            eq(pnb_has_any((array)$opts, $EMAIL_ONLY), array(), 'dd_test: the transient row carries no email-only key');
            eq(isset($opts['_test_run_transient']) ? $opts['_test_run_transient'] : null, true, 'dd_test: _test_run_transient still set');
            eq($w ? $w[0]['binds'][':rec'] : null, '', 'dd_test: transient RECIPIENTS blank');
            $a = pnb_audits($res, 'SCHEDULE_TEST_RUN');
            $ad = $a ? json_decode((string)$a[0]['after'], true) : array();
            ok(count($a) === 1, 'dd_test: exactly one SCHEDULE_TEST_RUN audit');
            eq(pnb_has_any(isset($ad['options']) ? $ad['options'] : array(), $EMAIL_ONLY), array(), 'dd_test: the test-run audit options carry no email-only key');
            eq(isset($ad['recipients']) ? $ad['recipients'] : null, '', 'dd_test: the test-run audit recipients blank');
            ok(is_array($resp) && !empty($resp['test_once']), 'dd_test: answered as a one-time test');
        }
        if ($tag === 'rs_update' || $tag === 'rs_recreate') {
            list($opts, $rec, $after) = pnb_write($tag, $res, $tag === 'rs_update' ? 'UPDATE_TASK' : 'INSERT_TASK', 'SCHEDULE_RESTORE');
            eq(pnb_has_any($opts, $EMAIL_ONLY), array(), "$tag: restored OPTIONS carry no email-only key");
            eq($rec, '', "$tag: restored RECIPIENTS blank");
            eq(pnb_has_any(isset($after['OPTIONS']) ? $after['OPTIONS'] : array(), $EMAIL_ONLY), array(), "$tag: SCHEDULE_RESTORE AFTER carries no email-only key");
            ok(isset($opts['destination_table']) && $opts['destination_table'] === 'PNB_DUMP_T' && isset($opts['prompt_answers']),
               "$tag: the snapshot's own settings come back");
        }
        if ($tag === 'rs_email') {
            list($opts, $rec) = pnb_write($tag, $res, 'UPDATE_TASK', 'SCHEDULE_RESTORE');
            eq(array_values(array_diff($EMAIL_ONLY, array_keys($opts))), array(), 'rs_email: an EMAIL restore keeps every email-only key');
            eq($rec, 'Pat Owner <powner@ncsu.edu>;Sam Two <stwo@ncsu.edu>;', 'rs_email: an EMAIL restore keeps its RECIPIENTS');
        }
    }
    @unlink($core);
}

