    if (strpos($a, '--template=') === 0) { $TEMPLATE = substr($a, 11); }
    if ($a === '--control')            { $CONTROL = true; }
    if ($a === '--dump')               { $DUMP = true; }   // print Part A's classification table
}
if ($APP === null) { fwrite(STDERR, "test_schedprune.php: --app=<webroot> is required\n"); exit(2); }
if ($MANAGE === null) { $MANAGE = $APP . '/manage_schedule.php'; }
if ($TEMPLATE === null) { $TEMPLATE = $APP . '/penumbra_template.php'; }
// The subscription-condition library (2026-09-23): pure, loaded by the child like the template
// when the app has it (a pre-feature app does not - the child then stubs the one call).
$SUBCOND = $APP . '/penumbra_subscribe_condition.php';
$RUNNER = $APP . '/schedule_runner.php';
$MAINJS = $APP . '/js/main.js';
$CHILD  = __DIR__ . '/schedprune_child.php';
foreach (array($MANAGE, $RUNNER, $MAINJS, $CHILD, $TEMPLATE) as $f) {
    if (!is_file($f)) { fwrite(STDERR, "test_schedprune.php: cannot read $f\n"); exit(2); }
}

// The keys the fix drops from every non-EMAIL task (theme_override: all but DROP_FILE).
$EMAIL_ONLY = array('attach_csv', 'attach_xlsx', 'attach_pdf', 'no_body', 'include_link', 'no_links',
