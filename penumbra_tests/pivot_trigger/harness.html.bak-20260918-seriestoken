        assert('roll: roll12 parses to 12', TI.rollN('roll12') === 12);
        assert('roll: roll99 is the ceiling', TI.rollN('roll99') === 99);
        assert('roll: the :down variant keeps its N', TI.rollN('roll3:down') === 3);
        assert('roll: roll1 is refused (it IS the base value)', TI.rollN('roll1') === null);
        assert('roll: roll0 refused', TI.rollN('roll0') === null);
        assert('roll: roll100 refused', TI.rollN('roll100') === null);
        assert('roll: bare "roll" refused', TI.rollN('roll') === null);
        assert('roll: "rolling" is not a roll token', TI.rollN('rolling') === null);
        assert('roll: a base agg is not a roll token', TI.rollN('sum') === null && TI.rollN('running_total') === null);
        assert('roll: isRollDown separates the directions', TI.isRollDown('roll6:down') && !TI.isRollDown('roll6'));
        assert('roll: registered as a derived type', TI.isDerived('roll3') && TI.isDerived('roll3:down'));
        assert('roll: label names the window and direction',
