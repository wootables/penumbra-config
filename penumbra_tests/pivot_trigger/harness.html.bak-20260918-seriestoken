        assert('roll: mean of a full window', TI.rollMean([1, 2, 3], 3) === 2);
        assert('roll: uses the LAST n, not the whole history', TI.rollMean([9, 9, 1, 2, 3], 3) === 2);
        assert('roll: a filling window reads N/A, never a partial mean', TI.rollMean([1, 2], 3) === null);
        assert('roll: an empty window is null', TI.rollMean([], 3) === null);
        assert('roll: a gap INSIDE the window voids it', TI.rollMean([1, null, 3], 3) === null);
        assert('roll: a gap that has scrolled OUT does not', TI.rollMean([null, 1, 2, 3], 3) === 2);
        assert('roll: a genuine zero mean is a value, not a blank', TI.rollMean([0, 0, 0], 3) === 0);
        assert('roll: negatives average correctly', TI.rollMean([-3, 0, 3], 3) === 0);
        assert('roll: window longer than n still uses n', TI.rollMean([2, 4, 6, 8], 2) === 7);

