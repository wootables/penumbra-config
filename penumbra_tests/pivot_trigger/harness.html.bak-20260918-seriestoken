<script>
  // Same boot stubs as the parity harness (see ..\parity\harness_b.html for why).
  window.penumbra_vars = {
    isAdmin: true, isGlobalAdmin: true, currentUserKey: 'harness', shibboleth: { ouc: '', dept: '' },
    tables: { oracle: [], pins: [], infoed: [], hr: [], fin: [] },
    imports: [], reports: [], themes: {}, prompts: {}, grants: []
  };
  jQuery.ajax = function () { var d = jQuery.Deferred(); d.resolve({}); return d.promise(); };
  jQuery.getJSON = jQuery.ajax; jQuery.post = jQuery.ajax; jQuery.get = jQuery.ajax;
  // Synchronous show/hide: the fx ticker's rAF never fires under --dump-dom,
  // so animated fadeIn would otherwise leave display:none and break :visible.
  jQuery.fx.off = true;
  window.ResizeObserver = function () {
    this.observe = function () {}; this.unobserve = function () {}; this.disconnect = function () {};
  };
  window.IntersectionObserver = window.ResizeObserver;
  if (!window.matchMedia) {
    window.matchMedia = function () { return { matches: false, addListener: function () {}, removeListener: function () {}, addEventListener: function () {}, removeEventListener: function () {} }; };
  }
  // NOTE: do NOT null window.requestAnimationFrame here - main.js calls it during
  // init and the ready-closure then dies before any handler is bound. Instead,
  // jQuery.fx.off (set after jQuery loads, below the vendor scripts) makes
  // fadeIn/fadeOut synchronous so :visible assertions work headless.
  window.__errors = [];
  window.onerror = function (m, src, line) { window.__errors.push(String(m) + ' @' + String(src).split('/').pop() + ':' + line); try { var o = document.getElementById('out'); if (o && o.textContent === 'running') o.textContent = 'PAGE_ERROR: ' + window.__errors[0]; } catch (x) {} return true; };
  // Clipboard capture for the Copy Snippet handler.
  window.__clip = null;
  if (!navigator.clipboard) { try { Object.defineProperty(navigator, 'clipboard', { value: {}, configurable: true }); } catch (e) {} }
  try { navigator.clipboard.writeText = function (s) { window.__clip = s; return Promise.resolve(); }; } catch (e) {}
</script>
<script src="main_patched.js"></script>
<script>
(function () {
  function report(txt) { document.getElementById('out').textContent = txt; }
  var results = [];
  function assert(name, cond, detail) { results.push({ name: name, pass: !!cond, detail: detail === undefined ? '' : String(detail) }); }

  function rowsSnapshot() {
    return $('#pivot-agg-table-body tr').map(function () {
      var $tr = $(this);
      return {
        type: $tr.attr('data-agg-type'),
        col: $tr.attr('data-agg-col') || null,
        label: $tr.data('custom-label') || null,
        filter: $tr.attr('data-agg-filter') || null,
        formula: ($tr.attr('data-agg-type') === 'formula') ? ($tr.attr('data-agg-formula') || '') : null,
        shownLabel: $tr.find('.pat-cell-lbl .pat-cell-text').text()
      };
    }).get();
  }
  // Fire a trigger exactly the way executeChainStep / the infobox path do: a
  // temp .snippet-action link inside #reportSnippetOutput. The parser's
  // runSilent() setup runs SYNCHRONOUSLY in the click; only the Generate click
  // is deferred 10ms (and Generate is unbound below - no data in the harness).
  function fireTrigger(cmd) {
    var a = $('<a class="snippet-action" data-action-name="trigger"></a>').attr('data-action-value', cmd);
    $('#reportSnippetOutput').append(a);
    a.trigger('click');
    a.remove();
    return rowsSnapshot();
  }

  function run() {
    var T = window.__PT;
    if (!T || typeof T.addAggregationRow !== 'function') {
      report('RESULTS_JSON:' + JSON.stringify({ fatal: 'hooks unavailable: ' + (window.__PT_ERR || 'n/a'), pageErrors: window.__errors.slice(0, 6) }));
      return;
    }
    $('#generatePivotBtn').off('click');   // no data in the harness; keep the run deterministic

    // ---- 1. Parser: full snippet with filters, formula AND custom labels (position 17)
    var full = "pivot|COLLEGE|FY|AMOUNT|sum:AMOUNT,sum:AMOUNT,formula|nested|nested|asc|3|none|none|none|none|none|none|STATUS=Active;;STATUS=Closed;;|;;;;{Active Sum} - {Closed Sum}|Active Sum;;Closed Sum;;Variance";
    var r1 = fireTrigger(full);
    assert('parser: 3 rows (two filtered Sums survive the dedupe + formula)', r1.length === 3, JSON.stringify(r1));
    assert('parser: row1 = sum/AMOUNT/"Active Sum"/STATUS=Active', r1[0] && r1[0].type === 'sum' && r1[0].col === 'AMOUNT' && r1[0].label === 'Active Sum' && r1[0].filter === 'STATUS=Active', JSON.stringify(r1[0]));
    assert('parser: row2 = sum/AMOUNT/"Closed Sum"/STATUS=Closed', r1[1] && r1[1].type === 'sum' && r1[1].col === 'AMOUNT' && r1[1].label === 'Closed Sum' && r1[1].filter === 'STATUS=Closed', JSON.stringify(r1[1]));
    assert('parser: row3 = formula "Variance" {Active Sum} - {Closed Sum}', r1[2] && r1[2].type === 'formula' && r1[2].label === 'Variance' && r1[2].formula === '{Active Sum} - {Closed Sum}', JSON.stringify(r1[2]));
    assert('parser: label cells SHOW the custom labels', r1.length === 3 && r1[0].shownLabel === 'Active Sum' && r1[1].shownLabel === 'Closed Sum' && r1[2].shownLabel === 'Variance', JSON.stringify(r1.map(function (r) { return r.shownLabel; })));
    var v1 = T.validatePivotFormulas();
    assert('parser: formula validates against the restored labels (no "unknown/ambiguous label")', v1 && v1.error === null, JSON.stringify(v1 && v1.error));
    assert('parser: row/col chips keep their case', $('#pivot-rows .pivot-column-item').attr('data-field') === 'COLLEGE' && $('#pivot-cols .pivot-column-item').attr('data-field') === 'FY', $('#pivot-rows').text() + '/' + $('#pivot-cols').text());

    // ---- 2. Writer: Copy Snippet must reproduce the SAME trigger (round trip)
    window.__clip = null;
    $('#copyPivotSnippetBtn').trigger('click');
    var expected = "action(trigger, 'View Pivot', '" + full + "')";
    assert('writer: Copy Snippet emits the labels and round-trips byte-for-byte', window.__clip === expected, 'got: ' + window.__clip);

    // ---- 3. Legacy snippets (no label position) still work, labels default
    var r3 = fireTrigger('pivot|COLLEGE|FY|AMOUNT|sum,count');
    assert('legacy: sum,count -> 2 rows, default labels', r3.length === 2 && r3[0].type === 'sum' && r3[1].type === 'count' && r3[0].label === null && r3[1].label === null, JSON.stringify(r3));
    // Writer on a default-label pivot must NOT emit the labels field (trailing default trimmed)
    window.__clip = null; $('#copyPivotSnippetBtn').trigger('click');
    assert('writer: no custom labels -> AggLabels field omitted', window.__clip === "action(trigger, 'View Pivot', 'pivot|COLLEGE|FY|AMOUNT|sum:AMOUNT,count:AMOUNT')", 'got: ' + window.__clip);

    // ---- 4. Dedupe: exact duplicates still collapse; differentiated ones survive
    var r4a = fireTrigger('pivot|COLLEGE|FY|AMOUNT|sum,sum');
    assert('dedupe: sum,sum (identical) -> 1 row', r4a.length === 1, JSON.stringify(r4a));
    var r4b = fireTrigger('pivot|COLLEGE|FY|AMOUNT|sum,sum:AMOUNT');
    assert('dedupe: sum,sum:AMOUNT with Value=AMOUNT -> still 1 row', r4b.length === 1, JSON.stringify(r4b));
    var r4c = fireTrigger('pivot|COLLEGE|FY|AMOUNT|sum:AMOUNT,sum:AMOUNT|nested|nested|asc|3|none|none|none|none|none|none|none|none|Gross;;Net');
    assert('dedupe: same type+col, different LABELS -> 2 rows', r4c.length === 2 && r4c[0].label === 'Gross' && r4c[1].label === 'Net', JSON.stringify(r4c));
    var r4d = fireTrigger('pivot|COLLEGE|FY|AMOUNT|sum:AMOUNT,sum:AMOUNT|nested|nested|asc|3|none|none|none|none|none|none|STATUS=Active;;STATUS=Closed');
    assert('dedupe: same type+col, different FILTERS (the help example shape) -> 2 rows', r4d.length === 2 && r4d[0].filter === 'STATUS=Active' && r4d[1].filter === 'STATUS=Closed', JSON.stringify(r4d));
    var r4e = fireTrigger('pivot|COLLEGE|FY|AMOUNT|sum:AMOUNT,distinct:RECORD_ID,sum:AMOUNT');
    assert('dedupe: sum:AMOUNT,distinct:RECORD_ID,sum:AMOUNT -> 2 rows', r4e.length === 2 && r4e[0].type === 'sum' && r4e[1].type === 'distinct' && r4e[1].col === 'RECORD_ID', JSON.stringify(r4e));

    // ---- 5. sum_count alias: labels can't name two columns -> both default
    var r5 = fireTrigger('pivot|COLLEGE|FY|AMOUNT|sum_count|nested|nested|asc|3|none|none|none|none|none|none|none|none|Both');
    assert('sum_count: expands to sum+count, label ignored', r5.length === 2 && r5[0].type === 'sum' && r5[1].type === 'count' && r5[0].label === null && r5[1].label === null, JSON.stringify(r5));

    // ---- 5b. Expand arg (2026-08-25): the "Start groups expanded" inversion.
    // Position 13 is now Expand: only the 'expanded' keyword checks the box;
    // legacy 'collapsed', 'none' and absent all mean the collapsed default.
    var fullExp = 'pivot|COLLEGE,DEPT|FY|AMOUNT|sum:AMOUNT|nested|nested|asc|3|none|none|none|none|expanded';
    fireTrigger(fullExp);
    assert("expand: parser checks the box on 'expanded'", $('#pivot-start-expanded').is(':checked'), 'box unchecked after |expanded');
    window.__clip = null; $('#copyPivotSnippetBtn').trigger('click');
    assert('expand: writer round-trips |expanded byte-for-byte', window.__clip === "action(trigger, 'View Pivot', '" + fullExp + "')", 'got: ' + window.__clip);
    fireTrigger('pivot|COLLEGE,DEPT|FY|AMOUNT|sum:AMOUNT|nested|nested|asc|3|none|none|none|none|collapsed');
    assert("expand: legacy 'collapsed' keyword leaves the box unchecked (= the default)", !$('#pivot-start-expanded').is(':checked'), 'box checked after |collapsed');
    window.__clip = null; $('#copyPivotSnippetBtn').trigger('click');
    assert('expand: unchecked box emits no Expand arg (trailing default trimmed)', window.__clip === "action(trigger, 'View Pivot', 'pivot|COLLEGE,DEPT|FY|AMOUNT|sum:AMOUNT')", 'got: ' + window.__clip);

    // ---- 5c. New aggregate types (2026-08-25): stddev/range/count_filled/count_blank/antimode
    var r5c = fireTrigger('pivot|COLLEGE|FY|AMOUNT|stddev:AMOUNT,range:AMOUNT,count_filled:AMOUNT,count_blank:AMOUNT,antimode:AMOUNT');
    assert('newaggs: parser accepts all five types', r5c.length === 5 && r5c[0].type === 'stddev' && r5c[1].type === 'range' && r5c[2].type === 'count_filled' && r5c[3].type === 'count_blank' && r5c[4].type === 'antimode', JSON.stringify(r5c));
    window.__clip = null; $('#copyPivotSnippetBtn').trigger('click');
    assert('newaggs: writer round-trips all five byte-for-byte', window.__clip === "action(trigger, 'View Pivot', 'pivot|COLLEGE|FY|AMOUNT|stddev:AMOUNT,range:AMOUNT,count_filled:AMOUNT,count_blank:AMOUNT,antimode:AMOUNT')", 'got: ' + window.__clip);
    var r5d = fireTrigger('pivot|COLLEGE|FY|AMOUNT|stdev');
    assert("newaggs: 'stdev' alias normalizes to stddev", r5d.length === 1 && r5d[0].type === 'stddev', JSON.stringify(r5d));
    // ---- 5d. Derived additions (2026-08-25 pt2): diff + the :down twins of
    // pct_change / diff / index. All are colon-suffix VARIANTS, not column
    // overrides - the parser's _knownColonSuffixes list must keep them whole.
    var r5e = fireTrigger('pivot|COLLEGE|FY|AMOUNT|sum:AMOUNT,diff,pct_change:down,diff:down,index:down');
    assert('derived: parser accepts diff + the three :down twins', r5e.length === 5 && r5e[1].type === 'diff' && r5e[2].type === 'pct_change:down' && r5e[3].type === 'diff:down' && r5e[4].type === 'index:down', JSON.stringify(r5e));
    // ---- % of Parent + Cumulative % (2026-08-26): pct_cum:down is a colon
    // VARIANT (must survive _knownColonSuffixes), the other three plain tokens.
    window.__clip = null; $('#copyPivotSnippetBtn').trigger('click');
    assert('derived: writer round-trips them byte-for-byte', window.__clip === "action(trigger, 'View Pivot', 'pivot|COLLEGE|FY|AMOUNT|sum:AMOUNT,diff,pct_change:down,diff:down,index:down')", 'got: ' + window.__clip);
    var r5p = fireTrigger('pivot|COLLEGE,DEPT|FY|AMOUNT|sum:AMOUNT,pct_parent_row,pct_parent_col,pct_cum,pct_cum:down');
    assert('pctparent: parser accepts all four new derived types', r5p.length === 5 && r5p[1].type === 'pct_parent_row' && r5p[2].type === 'pct_parent_col' && r5p[3].type === 'pct_cum' && r5p[4].type === 'pct_cum:down', JSON.stringify(r5p));
    window.__clip = null; $('#copyPivotSnippetBtn').trigger('click');
    assert('pctparent: writer round-trips them byte-for-byte',
      String(window.__clip || '').indexOf('sum:AMOUNT,pct_parent_row,pct_parent_col,pct_cum,pct_cum:down') !== -1, 'got: ' + window.__clip);

    var M5 = window.__PT5;
    if (M5) {
        assert('newaggs math: sample stddev of [10,20,30] = 10', Math.abs(M5.stddev([10, 20, 30]) - 10) < 1e-9, String(M5.stddev([10, 20, 30])));
        assert('newaggs math: stddev of a single value = 0', M5.stddev([5]) === 0, String(M5.stddev([5])));
        assert('newaggs math: antimode least-common', M5.antimode(['a', 'a', 'b']) === 'b', M5.antimode(['a', 'a', 'b']));
        assert('newaggs math: antimode tie keeps first seen', M5.antimode(['x', 'y']) === 'x', M5.antimode(['x', 'y']));
        var cell5 = { count: 3, sum: 30, numericCount: 2, min: 10, max: 20, distinct: new Set(['10', '20']), values: ['10', '20'] };
        assert('newaggs extract: stddev ~7.0710678', Math.abs(M5.extract(cell5, 'stddev') - 7.0710678) < 1e-6, String(M5.extract(cell5, 'stddev')));
        assert('newaggs extract: range 10', M5.extract(cell5, 'range') === 10, String(M5.extract(cell5, 'range')));
        assert('newaggs extract: count_filled 2 / count_blank 1', M5.extract(cell5, 'count_filled') === 2 && M5.extract(cell5, 'count_blank') === 1, M5.extract(cell5, 'count_filled') + '/' + M5.extract(cell5, 'count_blank'));
        assert('newaggs extract: antimode tie -> first seen', M5.extract(cell5, 'antimode') === '10', String(M5.extract(cell5, 'antimode')));
    } else {
        assert('newaggs: __PT5 hooks available', false, window.__PT5_ERR || 'n/a');
    }

    // ---- 5e. Date splits (2026-08-25): FIELD:variant[:fill] tokens ----
    var M6 = window.__PT6;
    if (M6) {
        var tk = M6.parseTok('AWARD_DATE:fy');
        assert('datesplit parse: base/split', tk.base === 'AWARD_DATE' && tk.split === 'fy' && tk.fill === false, JSON.stringify(tk));
        tk = M6.parseTok('AWARD_DATE:YM:FILL');
        assert('datesplit parse: case-insensitive + fill', tk.split === 'ym' && tk.fill === true, JSON.stringify(tk));
        tk = M6.parseTok('WEIRD:COLUMN');
        assert('datesplit parse: unknown suffix stays plain', tk.base === 'WEIRD:COLUMN' && tk.split === null, JSON.stringify(tk));
        assert('datesplit compose: canonical form', M6.composeTok('award_date', 'fy', true) === 'AWARD_DATE:fy:fill', M6.composeTok('award_date', 'fy', true));
        assert('datesplit compose: cycle drops fill', M6.composeTok('X', 'month', true) === 'X:month', M6.composeTok('X', 'month', true));
        assert('datesplit display label', M6.dispLabel('AWARD_DATE:fy') === 'AWARD_DATE (Fiscal Year)', M6.dispLabel('AWARD_DATE:fy'));
        // Pill round-trip: token -> DOM pill (base + data-split/-fill) -> token
        var $pill = M6.buildPill('award_date:FY:FILL');
        assert('datesplit pill: data-field is base', $pill.attr('data-field') === 'award_date' && $pill.attr('data-split') === 'fy' && $pill.attr('data-fill') === '1', $pill.attr('data-field') + '/' + $pill.attr('data-split'));
        assert('datesplit pill round-trip canonical', M6.tokFromPill($pill[0]) === 'AWARD_DATE:fy:fill', M6.tokFromPill($pill[0]));
        // Bucket labels (2025-03-14 is a Friday; FY named by ENDING year, Jul-Jun)
        assert('datesplit bucket fy Mar', M6.bucket('fy', '2025-03-14') === 'FY25', M6.bucket('fy', '2025-03-14'));
        assert('datesplit bucket fy Jul', M6.bucket('fy', '2025-07-01') === 'FY26', M6.bucket('fy', '2025-07-01'));
        assert('datesplit bucket fyq Mar=FQ3', M6.bucket('fyq', '2025-03-14') === 'FY25 Q3', M6.bucket('fyq', '2025-03-14'));
        assert('datesplit bucket ym', M6.bucket('ym', '2025-03-14') === 'Mar 2025', M6.bucket('ym', '2025-03-14'));
        assert('datesplit bucket monthnum', M6.bucket('monthnum', '2025-03-14') === '03', M6.bucket('monthnum', '2025-03-14'));
        assert('datesplit bucket dow', M6.bucket('dow', '2025-03-14') === 'Fri', M6.bucket('dow', '2025-03-14'));
        assert('datesplit bucket hour date-only', M6.bucket('hour', '2025-03-14') === '00:00', M6.bucket('hour', '2025-03-14'));
        assert('datesplit bucket hour timestamp', M6.bucket('hour', '2025-03-14 15:42:07') === '15:00', M6.bucket('hour', '2025-03-14 15:42:07'));
        assert('datesplit bucket unparsable keeps raw', M6.bucket('fy', 'not a date') === 'not a date', M6.bucket('fy', 'not a date'));
        assert('datesplit bucket blank stays blank', M6.bucket('fy', '') === '', JSON.stringify(M6.bucket('fy', '')));
        assert('datesplit bucket strips markers', M6.bucket('year', '@@HTML<b>2025-03-14</b>') === '2025', M6.bucket('year', '@@HTML<b>2025-03-14</b>'));
        // Ordering + fill walking
        assert('datesplit vcmp Jan<Feb', M6.vcmp('month', 'Jan', 'Feb') < 0 && M6.vcmp('month', 'Dec', 'Jan') > 0, M6.vcmp('month', 'Jan', 'Feb') + '/' + M6.vcmp('month', 'Dec', 'Jan'));
        assert('datesplit vcmp raw after real buckets', M6.vcmp('month', 'zzz', 'Dec') > 0, String(M6.vcmp('month', 'zzz', 'Dec')));
        var SPL = M6.splitsGet();
        assert('datesplit next fy century wrap', SPL.fy.next('FY99') === 'FY00', SPL.fy.next('FY99'));
        assert('datesplit next ym wraps', SPL.ym.next('Dec 2025') === 'Jan 2026', SPL.ym.next('Dec 2025'));
        var fillSpec = M6.fillSpec(['AWARD_DATE:ym:fill']);
        assert('datesplit fillSpec accepts single period', !!fillSpec && fillSpec.split === 'ym', JSON.stringify(fillSpec));
        assert('datesplit fillSpec rejects cycle', M6.fillSpec(['AWARD_DATE:month:fill']) === null, 'expected null');
        var gapKeys = ['Jan 2025', 'Apr 2025'];
        M6.expand(gapKeys, 'ym');
        assert('datesplit expand inserts Feb+Mar', gapKeys.join('|') === 'Jan 2025|Feb 2025|Mar 2025|Apr 2025', gapKeys.join('|'));
    } else {
        assert('datesplit: __PT6 hooks available', false, window.__PT6_ERR || 'n/a');
    }

    // ---- 5f. Numeric binning (2026-08-26): tokens, buckets, widths, pills ----
    var M7 = window.__PT7;
    if (M7 && M6) {
        var bt = M6.parseTok('AMOUNT:bin50000');
        assert('bin parse: base/split/width', bt.base === 'AMOUNT' && bt.split === 'bin' && bt.binWidth === 50000, JSON.stringify(bt));
        assert('bin parse: auto has null width', M6.parseTok('AMOUNT:bin').split === 'bin' && M6.parseTok('AMOUNT:bin').binWidth == null, JSON.stringify(M6.parseTok('AMOUNT:bin')));
        assert('bin parse: bin0 is a plain field', M6.parseTok('AMOUNT:bin0').split === null && M6.parseTok('AMOUNT:bin0').base === 'AMOUNT:bin0', JSON.stringify(M6.parseTok('AMOUNT:bin0')));
        assert('bin parse: binlog + fill', (function () { var x = M6.parseTok('AMT:binlog:fill'); return x.split === 'binlog' && x.fill === true; })(), JSON.stringify(M6.parseTok('AMT:binlog:fill')));
        assert('bin compose w width + fill', M6.composeTok('AMT', 'bin', true, 1000) === 'AMT:bin1000:fill', M6.composeTok('AMT', 'bin', true, 1000));
        assert('bin compose auto', M6.composeTok('AMT', 'bin', false, null) === 'AMT:bin', M6.composeTok('AMT', 'bin', false, null));
