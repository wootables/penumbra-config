    {"id": "ctl_max_accounting",      "cond": "max(MF) = 1200.5",           "expect": true,  "beforeA": true,  "beforeC": true},
    {"id": "ctl_mode_unchanged",      "cond": "mode(MT, NAME != Alpha) = 7", "expect": true, "beforeA": true,  "beforeC": true},
    {"id": "ctl_p50",                 "cond": "p50(MN) = 7",                "expect": true,  "beforeA": true,  "beforeC": true},
    {"id": "ctl_stddev",              "cond": "stddev(MN) > 2",             "expect": true,  "beforeA": true,  "beforeC": true},
