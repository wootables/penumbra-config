    {"id": "ctl_compound_unsupported","cond": "mode(MN) = 7 and sum(MN) > 1", "expect": false, "beforeA": false, "beforeC": false},
    {"id": "marker_count_filled",     "cond": "count_filled(DM) = 2",       "expect": true,  "beforeA": false, "beforeC": true},
