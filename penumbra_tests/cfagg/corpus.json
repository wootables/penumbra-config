    {"id": "distinct_scope_all",      "cond": "distinct(DB, all) = 2",      "expect": true,  "beforeA": false, "beforeC": false},
    {"id": "ctl_sum",                 "cond": "sum(MN) = 17",               "expect": true,  "beforeA": true,  "beforeC": true},
