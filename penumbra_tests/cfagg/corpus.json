    {"NAME": "Eps",   "STATUS": "",       "MN": "3",  "MT": "",  "DB": " a ", "DH": "",        "MF": "(75.75)",   "ME": null, "DM": "@@HTML  "},
    {"NAME": "Zeta",  "STATUS": "Active", "MN": "  ", "MT": "",  "DB": "b",   "DH": null,      "MF": "",          "ME": "",   "DM": ""}
