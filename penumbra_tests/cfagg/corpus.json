    {"id": "mode_text_eq0",           "cond": "mode(STATUS) = 0",           "expect": false, "beforeA": true,  "beforeC": true},
    {"id": "mode_text_ne1",           "cond": "mode(STATUS) != 1",          "expect": false, "beforeA": true,  "beforeC": true},
    {"id": "mode_accounting_neg",     "cond": "mode(MF) < 0",               "expect": true,  "beforeA": false, "beforeC": false},
    {"id": "mode_html_marker",        "cond": "mode(DH) = 5",               "expect": true,  "beforeA": false, "beforeC": false},
    {"id": "mode_html_marker_eq0",    "cond": "mode(DH) = 0",               "expect": false, "beforeA": true,  "beforeC": false},
    {"id": "mode_empty_set",          "cond": "mode(MN, MN > 100) < 1",     "expect": false, "beforeA": true,  "beforeC": true},
