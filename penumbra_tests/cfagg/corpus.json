    {"id": "mode_scope_all",          "cond": "mode(MN, all) = 7",          "expect": true,  "beforeA": false, "beforeC": false},
    {"id": "distinct_blanks",         "cond": "distinct(DB) = 2",           "expect": true,  "beforeA": false, "beforeC": false},
    {"id": "distinct_old_a_count",    "cond": "distinct(DB) = 5",           "expect": false, "beforeA": true,  "beforeC": false},
    {"id": "distinct_old_c_count",    "cond": "distinct(DB) = 4",           "expect": false, "beforeA": false, "beforeC": true},
    {"id": "distinct_html_marker",    "cond": "distinct(DH) = 2",           "expect": true,  "beforeA": false, "beforeC": false},
    {"id": "distinct_all_blank",      "cond": "distinct(ME) = 0",           "expect": true,  "beforeA": false, "beforeC": false},
    {"id": "distinct_missing_col",    "cond": "distinct(NOPE) = 0",         "expect": true,  "beforeA": false, "beforeC": true},
