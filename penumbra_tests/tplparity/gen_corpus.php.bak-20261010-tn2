}

// ---- pivot fixtures ------------------------------------------------------------
// 'exact': whole numbers and a FULL grid, so the two pivot renderers print the
// same text and the template layer on top of them is compared byte for byte.
// 'known': cents, and one hole in the grid (Arts has no 2025). The renderers
// print the DECIMALS differently today, independent of templates:
//   browser formatPivotValue(): Intl min 0 / max N decimals  -> 175.5   5     '' (empty cell)
//   runner  pivot_format_value(): number_format(N)           -> 175.50  5.00  '' (empty cell)
// (The empty cell matched from 2026-09-25, stamp fycomp: the browser used to
// print 0 there. The hole stays in the fixture; the decimals keep this case
// divergent.)
// Cases on it are flagged known=pivot_display: they MUST diverge, and the run
// fails if one starts matching so the flag cannot outlive the difference.
$mkPivot = function ($list) {
    $o = array();
    foreach ($list as $p) $o[] = array('COLLEGE' => enc($p[0]), 'DEPT' => enc($p[1]), 'FY' => enc($p[2]), 'AMOUNT' => enc($p[3]));
    return $o;
};
