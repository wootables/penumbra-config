/**
 * tplparity corpus - ONE fixture for both engines.
 *
 * Rows are written here as the RAW database values and emitted in SERVER form:
 * plain cells pass through htmlspecialchars(ENT_QUOTES) exactly as
 * penumbraProcessOutputRow() (shared_logic.php) hands them to the browser and to
 * the runner; @@HTML / @@JSON cells pass through untouched. The browser side
 * renders each cell with the app's real formatCellContent(); the PHP side feeds
 * the same strings to generate_custom_template_string().
 *
 * 'rows' is in DISPLAY order (sorted by NAME asc) - the order the browser table
 * is built in. The PHP side is handed the SAME rows shuffled, as rawData in
 * query order, plus the saved sort: putting them back in display order with the
 * hidden column still attached is part of what is under test.
 */
function enc($v) { return ($v === null) ? null : htmlspecialchars($v, ENT_QUOTES, 'UTF-8'); }

