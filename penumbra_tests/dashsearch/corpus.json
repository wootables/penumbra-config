[
  { "name": "keeps a column the report has",
    "dsearch": { "p": "", "f": [["COLLEGE", "COLLEGE = Eng"]] }, "cols": ["COLLEGE", "AMOUNT"],
    "ok": true, "text": "COLLEGE = Eng", "applied": ["COLLEGE"], "skipped": [] },
  { "name": "skips a column the report lacks, keeps the rest",
    "dsearch": { "p": "", "f": [["COLLEGE", "COLLEGE = Eng"], ["AMOUNT", "AMOUNT > 5"]] }, "cols": ["NAME", "AMOUNT"],
    "ok": true, "text": "AMOUNT > 5", "applied": ["AMOUNT"], "skipped": ["COLLEGE"] },
  { "name": "a fragment with no column always applies",
    "dsearch": { "p": "", "f": [["", "grant"], ["COLLEGE", "COLLEGE = Eng"]] }, "cols": ["NAME"],
    "ok": true, "text": "grant", "applied": [], "skipped": ["COLLEGE"] },
  { "name": "nothing applies = empty text",
    "dsearch": { "p": "", "f": [["COLLEGE", "COLLEGE = Eng"]] }, "cols": ["NAME"],
    "ok": true, "text": "", "applied": [], "skipped": ["COLLEGE"] },
  { "name": "columns match regardless of case",
    "dsearch": { "p": "", "f": [["college", "college = Eng"]] }, "cols": ["College"],
    "ok": true, "text": "college = Eng", "applied": ["COLLEGE"], "skipped": [] },
  { "name": "a skipped column is named once",
    "dsearch": { "p": "", "f": [["X", "X > 1"], ["X", "X < 9"]] }, "cols": ["Y"],
    "ok": true, "text": "", "applied": [], "skipped": ["X"] },
  { "name": "an applied column is named once",
    "dsearch": { "p": "", "f": [["A", "A > 1"], ["A", "A < 9"]] }, "cols": ["A"],
    "ok": true, "text": "A > 1 and A < 9", "applied": ["A"], "skipped": [] },
  { "name": "the __ROW prefix is kept",
    "dsearch": { "p": "__ROW ", "f": [["A", "A = 1"]] }, "cols": ["A"],
    "ok": true, "text": "__ROW A = 1", "applied": ["A"], "skipped": [] },
  { "name": "a prefix that is not a modifier is dropped",
    "dsearch": { "p": "DROP TABLE ", "f": [["A", "A = 1"]] }, "cols": ["A"],
    "ok": true, "text": "A = 1", "applied": ["A"], "skipped": [] },
  { "name": "a prefix never applies on its own",
    "dsearch": { "p": "__ROW ", "f": [["B", "B = 1"]] }, "cols": ["A"],
    "ok": true, "text": "", "applied": [], "skipped": ["B"] },
  { "name": "blank fragment text is ignored",
    "dsearch": { "p": "", "f": [["A", "   "], ["", "x"]] }, "cols": ["A"],
    "ok": true, "text": "x", "applied": [], "skipped": [] },
  { "name": "fragments that are not pairs are ignored",
    "dsearch": { "p": "", "f": ["junk", { "a": 1 }, ["A", "A = 1"]] }, "cols": ["A"],
    "ok": true, "text": "A = 1", "applied": ["A"], "skipped": [] },
  { "name": "malformed JSON is refused",
    "raw": "{not json", "cols": ["A"],
    "ok": false, "text": "", "applied": [], "skipped": [] },
  { "name": "a list without f is refused",
    "dsearch": { "p": "" }, "cols": ["A"],
    "ok": false, "text": "", "applied": [], "skipped": [] },
  { "name": "the row-number column #",
    "dsearch": { "p": "", "f": [["#", "# > 2"]] }, "cols": ["A", "#"],
    "ok": true, "text": "# > 2", "applied": ["#"], "skipped": [] },
  { "name": "order and inner spacing are kept",
    "dsearch": { "p": "", "f": [["", "DEPT = Ops"], ["A", "A   =   'x y'"]] }, "cols": ["A"],
    "ok": true, "text": "DEPT = Ops and A   =   'x y'", "applied": ["A"], "skipped": [] },
  { "name": "a column with a space in its name",
    "dsearch": { "p": "", "f": [["TOTAL AMOUNT", "'Total Amount' > 5"]] }, "cols": ["Total Amount"],
    "ok": true, "text": "'Total Amount' > 5", "applied": ["TOTAL AMOUNT"], "skipped": [] },

  { "name": "rows: a nested (@@JSON) column counts, a missing one is skipped",
    "dsearch": { "p": "", "f": [["SPECIES", "SPECIES = Chicken"], ["COLLEGE", "COLLEGE = Eng"], ["N", "N > 1"]] },
    "rows": [ { "PROJ": "P1", "AMOUNT": "10", "SUB": "@@JSON[{\"SPECIES\":\"Chicken\",\"N\":\"2\"}]" },
              { "PROJ": "P2", "AMOUNT": "20", "SUB": "@@JSON[{\"SPECIES\":\"Duck\",\"N\":\"1\"}]" } ],
    "ok": true, "text": "SPECIES = Chicken and N > 1", "applied": ["SPECIES", "N"], "skipped": ["COLLEGE"] },
  { "name": "rows: the row-number column # counts though no row has it",
    "dsearch": { "p": "", "f": [["#", "# > 2"], ["A", "A != 9"]] },
    "rows": [ { "A": "1" }, { "A": "2" }, { "A": "3" } ],
    "ok": true, "text": "# > 2 and A != 9", "applied": ["#", "A"], "skipped": [] },
  { "name": "rows: a nested column first seen after the first row",
    "dsearch": { "p": "", "f": [["SPECIES", "SPECIES = Duck"]] },
    "rows": [ { "PROJ": "P1", "SUB": null },
              { "PROJ": "P2", "SUB": "@@JSON[]" },
              { "PROJ": "P3", "SUB": "@@JSON[{\"SPECIES\":\"Duck\"}]" } ],
    "ok": true, "text": "SPECIES = Duck", "applied": ["SPECIES"], "skipped": [] },
  { "name": "rows: nested columns are looked for in the first 10 rows only",
    "dsearch": { "p": "", "f": [["SPECIES", "SPECIES = Duck"]] },
    "rows": [ { "PROJ": "P1", "SUB": null }, { "PROJ": "P2", "SUB": null }, { "PROJ": "P3", "SUB": null },
              { "PROJ": "P4", "SUB": null }, { "PROJ": "P5", "SUB": null }, { "PROJ": "P6", "SUB": null },
              { "PROJ": "P7", "SUB": null }, { "PROJ": "P8", "SUB": null }, { "PROJ": "P9", "SUB": null },
              { "PROJ": "P10", "SUB": null },
              { "PROJ": "P11", "SUB": "@@JSON[{\"SPECIES\":\"Duck\"}]" } ],
    "ok": true, "text": "", "applied": [], "skipped": ["SPECIES"] },

  { "name": "rows + journal: a journal toggle column counts on both sides",
    "dsearch": { "p": "", "f": [["DONE", "Done = ☑"], ["COLLEGE", "COLLEGE = Eng"]] },
    "rows": [ { "PROJ": "P1", "AMOUNT": "10" }, { "PROJ": "P2", "AMOUNT": "20" } ],
    "journal": { "toggles": [ { "key": "done", "label": "Done" } ], "keys": ["PROJ"], "checked": { "done": ["P1"] } },
    "ok": true, "text": "Done = ☑", "applied": ["DONE"], "skipped": ["COLLEGE"] }
]
