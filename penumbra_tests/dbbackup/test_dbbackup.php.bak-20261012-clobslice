function scratch($tag) {
    $d = sys_get_temp_dir() . DIRECTORY_SEPARATOR . 'pnb_dbbak_' . getmypid() . '_' . $tag;
    @mkdir($d . DIRECTORY_SEPARATOR . 'bk', 0777, true); @mkdir($d . DIRECTORY_SEPARATOR . 'state'); @mkdir($d . DIRECTORY_SEPARATOR . 'log');
    return $d;
}
function rmtree($d) {
    if (!is_dir($d) || strpos(basename($d), 'pnb_dbbak_') !== 0 && strpos($d, 'pnb_dbbak_') === false) return;   // leaf-pattern guard
    foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($d, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::CHILD_FIRST) as $f) {
        $f->isDir() ? @rmdir($f->getPathname()) : @unlink($f->getPathname());
    }
    @rmdir($d);
}
