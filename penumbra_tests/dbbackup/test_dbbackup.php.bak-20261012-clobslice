/** A stand-in for DbBackupOci: dictionary + data from arrays, the fake clock moves per row. */
class FakeDb {
    public $t; public $clock; public $perRow; public $fail = array(); public $began = 0; public $ended = 0; public $queries = array();
    function __construct(array $tables, &$clock, $perRow) { $this->t = $tables; $this->clock =& $clock; $this->perRow = $perRow; }
    function begin() { $this->began++; }
    function end() { $this->ended++; }
    function close() {}
    function all($sql, array $b = array()) {
        if (strpos($sql, 'FROM ALL_TABLES') !== false) {
            $out = array();
            foreach ($this->t as $n => $d) $out[] = array('TABLE_NAME' => $n, 'NUM_ROWS' => count($d['rows']), 'AVG_ROW_LEN' => isset($d['len']) ? $d['len'] : 10,
                                                          'TEMPORARY' => 'N', 'COMMENTS' => isset($d['comment']) ? $d['comment'] : null);
            return $out;
        }
        if (strpos($sql, 'FROM ALL_TAB_COLS') !== false) { return isset($this->t[$b[':t']]) ? $this->t[$b[':t']]['cols'] : array(); }
        if (strpos($sql, 'FROM ALL_CONSTRAINTS') !== false) { return array_map(function ($c) { return array('COLUMN_NAME' => $c); }, $this->t[$b[':t']]['pk']); }
        throw new Exception('fake: unexpected dictionary SQL ' . $sql);
    }
    function rows($sql, array $b = array()) {
        $this->queries[] = $sql;
        if (!preg_match('/^SELECT (.*) FROM "NC_REPORTING"\."([A-Z0-9_]+)"( WHERE "(\w+)" > (TO_NUMBER\(:k\)|:k))?( ORDER BY "(\w+)")?$/', $sql, $m)) throw new Exception('fake: unexpected SQL ' . $sql);
        $tn = $m[2];
        if (isset($this->fail[$tn])) throw new Exception('ORA-00942: table or view does not exist (fake)');
        preg_match_all('/"([^"]+)"/', $m[1], $cm);
        $rows = $this->t[$tn]['rows'];
        $order = isset($m[7]) ? $m[7] : null;
        if ($order) usort($rows, function ($x, $y) use ($order) { return is_numeric($x[$order]) ? $x[$order] <=> $y[$order] : strcmp($x[$order], $y[$order]); });
        foreach ($rows as $r) {
            if (!empty($m[3])) {
                $kv = $r[$m[4]];
                if ($m[5] === ':k' ? strcmp((string)$kv, $b[':k']) <= 0 : (float)$kv <= (float)$b[':k']) continue;
            }
            $this->clock += $this->perRow;
            $out = array();
            foreach ($cm[1] as $c) {
                $v = array_key_exists($c, $r) ? $r[$c] : null;
                $type = '';
                foreach ($this->t[$tn]['cols'] as $cd) if ($cd['COLUMN_NAME'] === $c) $type = $cd['DATA_TYPE'];
                $out[] = ($v !== null && $type === 'RAW') ? strtoupper(bin2hex($v)) : $v;
            }
            yield $out;
        }
    }
}
