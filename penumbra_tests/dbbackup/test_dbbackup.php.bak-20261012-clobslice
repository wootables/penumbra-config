/** One job run; the log is swallowed (kept in $LASTLOG). */
function runjob($dir, $db, &$clock, array $over = array(), array $opts = array()) {
    global $LASTLOG;
    $GLOBALS['db_backup_log_dir'] = $dir . DIRECTORY_SEPARATOR . 'log';
    $settings = array_merge(db_backup_settings(array('dir' => $dir . DIRECTORY_SEPARATOR . 'bk', 'min_free_gb' => 0)), $over);
    ob_start();
    $code = db_backup_run(array_merge(array('db' => $db, 'clock' => function () use (&$clock) { return $clock; },
                                            'settings' => $settings, 'state_dir' => $dir . DIRECTORY_SEPARATOR . 'state', 'cycle_start' => null), $opts));
    $LASTLOG = ob_get_clean();
    return $code;
}
function sets($dir) { return db_backup_list_sets($dir . DIRECTORY_SEPARATOR . 'bk'); }
function read_table($setDir, $m, $tn) {
    $rows = array();
    foreach ($m['tables'][$tn]['parts'] as $p) {
        db_backup_read_part($setDir . DIRECTORY_SEPARATOR . $p['file'], function ($r, $h) use (&$rows) { $rows[] = array_combine(array_map(function ($c) { return $c['name']; }, $h['columns']), $r); });
    }
    return $rows;
}
function flag($dir, $kind) { return penumbra_maintenance_flag_on(penumbra_maintenance_control_path('db_backup', $kind, $dir . DIRECTORY_SEPARATOR . 'state')); }

