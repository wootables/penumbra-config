  {"slug": "value-fx-grp",  "q": "(D = f(x) or B = no) and A = yes",                                    "expect": null},
  {"slug": "close-first",   "q": ") A = yes (",                                                         "expect": null},
  {"slug": "empty-mid",     "q": "A = yes () and C = yes",                                              "expect": ["1","3"]},
  {"slug": "empty-only",    "q": "()",                                                                  "expect": null},
