  {"slug": "upper-nested",  "q": "((A = YES OR B = YES) AND C = YES) OR D = ZQ",                        "expect": ["1","2","3","5"]},
  {"slug": "spaces-wild",   "q": "   (  A = yes   or   B = yes  )   and   C = yes   ",                  "expect": ["1","3","5"]},
  {"slug": "tabs",          "q": "(A = yes\tor B = yes)\tand C = yes",                                  "expect": ["1","3","5"]},
  {"slug": "brace-space",   "q": "({ A } = yes or {B} = yes) and {C} = yes",                            "expect": ["1","3","5"]},
  {"slug": "paren-in-brace","q": "{D} = (x) and A = yes",                                               "expect": ["1"]},
  {"slug": "unbalanced-q",  "q": "(A = 'yes' or B = yes and C = yes",                                   "expect": ["1","5"]},
  {"slug": "or-chain-grps", "q": "(A = yes and B = yes) or (A = no and B = no) or (C = yes and D = zq)", "expect": ["1","2","7","8"]},
