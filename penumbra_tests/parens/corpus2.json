  {"#": "1", "ID": "1", "A": "yes", "B": "yes", "C": "yes", "D": "(x)",      "E": "Feb 2025",  "SUBS": "@@JSON[{\"K\":\"a\",\"V\":\"1\"},{\"K\":\"b\",\"V\":\"2\"}]"},
  {"#": "2", "ID": "2", "A": "yes", "B": "yes", "C": "no",  "D": "zq",       "E": "Mar 2025",  "SUBS": "@@JSON[{\"K\":\"a\",\"V\":\"2\"},{\"K\":\"c\",\"V\":\"1\"}]"},
  {"#": "3", "ID": "3", "A": "yes", "B": "no",  "C": "yes", "D": "f(x)",     "E": "Feb 2024",  "SUBS": "@@JSON[{\"K\":\"c\",\"V\":\"2\"},{\"K\":\"a\",\"V\":\"1\"}]"},
  {"#": "4", "ID": "4", "A": "yes", "B": "no",  "C": "no",  "D": "a (b) c",  "E": "",          "SUBS": ""},
  {"#": "5", "ID": "5", "A": "no",  "B": "yes", "C": "yes", "D": "yes)",     "E": "2025-02-10","SUBS": ""},
  {"#": "6", "ID": "6", "A": "no",  "B": "yes", "C": "no",  "D": "(",        "E": "",          "SUBS": ""},
  {"#": "7", "ID": "7", "A": "no",  "B": "no",  "C": "yes", "D": ")",        "E": "",          "SUBS": ""},
  {"#": "8", "ID": "8", "A": "no",  "B": "no",  "C": "no",  "D": "and",      "E": "",          "SUBS": ""}
 ],
