    }
    function clearAll() {
        localStorage.clear(); env._forceDefaultApplied.clear();
        $('.modal-prompt-overlay').remove(); window.__execClicks = 0; calls.toasts.length = 0;
    }
    function K(tag) { return env.getPromptStorageKey(tag); }
    function store(tag, value, message) { localStorage.setItem(K(tag), JSON.stringify({ value: value, display: value, message: message })); }
    function stored(tag) { var s = localStorage.getItem(K(tag)); return s ? JSON.parse(s) : null; }
    function storedRaw(tag) { return localStorage.getItem(K(tag)); }
    function lastDialog() {
        var $d = $('.modal-prompt-overlay').last();
        if (!$d.length) return null;
        var id = $d.attr('id');
        return { $d: $d, id: id, input: document.getElementById(id + '_input') };
    }
    function answerOne(seen) {
        var d = lastDialog();
        if (!d || d.$d.data('seenByTest')) return false;
        d.$d.data('seenByTest', 1);
        seen.push(d.$d.find('.modal-prompt-content span').first().text() + '=' + (d.input ? d.input.value : ''));
        $('#' + d.id + '_ok').trigger('click');
        return true;
    }
    // Presses OK in every dialog a flow opens; returns "message=shown value" per dialog.
    async function okThrough(promise) {
        var seen = [], done = false;
        promise.then(function () { done = true; }, function () { done = true; });
        for (var guard = 0; guard < 300 && !done; guard++) { await tick(20); answerOne(seen); }
        await promise;
        return seen;
    }
    // The same, for a flow started by a real click (the handler keeps its promise).
    async function okThroughClick($el) {
        var seen = [], exec0 = window.__execClicks || 0, toast0 = calls.toasts.length, quiet = 0;
        $el.first().trigger('click');
        for (var guard = 0; guard < 300; guard++) {
            await tick(20);
            if (answerOne(seen)) { quiet = 0; continue; }
            if ((window.__execClicks || 0) > exec0 || calls.toasts.length > toast0) { if (++quiet > 3) break; }
        }
        return seen;
    }
    function sqlOf(list) { return 'SELECT 1 FROM DUAL WHERE 1=1\n' + list.join('\n') + '\n'; }
