            check('a UNION report with ONE copy of a tag given a section: still one chip, and it is in that section',
                [textsOf($list.find('a.prompt-byline-link em')), $('#resetAllPromptsLink').attr('data-prompt-section')], [['Unit:', 'From date:'], 'dates']);

            // =================================================================
            section('E. main.css - the box, its button, the pencil');
            window.__editorSql = sqlOf(MIX);
            clearAll(); answerAll();
            env.updatePromptDisplay();
            var btn = $list.find('.prompt-section-review').get(0);
            var link = document.getElementById('resetAllPromptsLink');
            if (!btn) {
                check('a section button to measure', false, true);
            } else {
                var cs = getComputedStyle(btn), lk = getComputedStyle(link);
                check('the button is the bar\'s 30 x 30 control - no global `button` margin or padding', [cs.width, cs.height, cs.marginTop, cs.paddingLeft], ['30px', '30px', '0px', '0px']);
                check('... and looks exactly like the bar\'s own button', [cs.backgroundColor, cs.color, cs.borderTopColor, cs.borderTopLeftRadius], [lk.backgroundColor, lk.color, lk.borderTopColor, lk.borderTopLeftRadius]);
                document.body.classList.add('theme-dark-blue');
                cs = getComputedStyle(btn); lk = getComputedStyle(link);
                var plain = document.createElement('button');
                document.body.appendChild(plain);
                var pcs = getComputedStyle(plain);
                check('CONTROL: under theme-dark-blue a bare <button> IS restyled by the theme', pcs.backgroundColor !== lk.backgroundColor, true);
                check('... but the section button still matches the bar\'s own button', [cs.backgroundColor, cs.color, cs.marginTop], [lk.backgroundColor, lk.color, '0px']);
                plain.parentNode.removeChild(plain);
                document.body.classList.remove('theme-dark-blue');
            }
            var soloA = $list.find('a.is-solo').get(0), boxA = $list.find('.prompt-section a.prompt-byline-link').get(0);
            check('the pencil: always visible on the solo chip, hover-only on a boxed chip',
                [soloA ? getComputedStyle(soloA, '::after').opacity : null, boxA ? getComputedStyle(boxA, '::after').opacity : null], ['1', '0']);
            var box = $list.find('.prompt-section').get(0);
            var bcs = box ? getComputedStyle(box) : {};
            check('the box: a flex row, rounded, bordered', [bcs.display, bcs.borderTopLeftRadius, bcs.borderTopStyle], ['flex', '11px', 'solid']);
            $('#hdr').css('width', '320px');
            store(T.dept, new Array(61).join('W'), 'Department');
            // The plain bar first. Before 2026-09-24 a capped chip ran its padding +
            // border (31px) past its slot even here: max-width:100% on a content-box
            // chip. Found while measuring the boxes; the chip is border-box now.
            window.__editorSql = sqlOf(NOSEC);
            env.updatePromptDisplay();
            var plainChip = $list.find('a.prompt-byline-link').filter(function () { return $(this).find('em').text() === 'Department:'; }).get(0);
            check('without sections, a long answer stays inside a narrow container too (the chip is border-box)',
                plainChip ? plainChip.getBoundingClientRect().right <= document.getElementById('promptInfoContainer').getBoundingClientRect().right + 1 : null, true);
            window.__editorSql = sqlOf(MIX);
            env.updatePromptDisplay();
            var cont = document.getElementById('promptInfoContainer').getBoundingClientRect();
            var longChip = $list.find('a.prompt-byline-link').filter(function () { return $(this).find('em').text() === 'Department:'; }).get(0);
            var st = longChip ? longChip.querySelector('strong') : null;
            check('a long answer in a box stays inside a narrow container and ellipsizes',
                longChip ? [longChip.getBoundingClientRect().right <= cont.right + 1, st.scrollWidth > st.clientWidth] : null, [true, true]);
            if (longChip) {
                var r = function (el) { var b = el.getBoundingClientRect(); return Math.round(b.left) + '-' + Math.round(b.right); };
                note('x-extents: hdr ' + r(document.getElementById('hdr')) + ' | container ' + r(document.getElementById('promptInfoContainer'))
                    + ' | list ' + r(document.getElementById('promptInfoList')) + ' | box ' + r($(longChip).closest('.prompt-section').get(0))
                    + ' | inner list ' + r($(longChip).closest('.prompt-section-list').get(0)) + ' | li ' + r(longChip.parentNode)
                    + ' | chip ' + r(longChip) + ' | value ' + r(st));
            }
            $('#hdr').css('width', '640px');

            // =================================================================
            section('F. reconfigureAllPrompts(section) - reviewing one section');
            window.__editorSql = sqlOf(MIX);
            clearAll(); answerAll();
            var before = {};
            MIX.forEach(function (t) { before[t] = storedRaw(t); });
            var seen = await okThrough(env.reconfigureAllPrompts('dates'));
            check('Dates: only its two prompts are asked, in order, each showing its answer', seen, ['From date=01-JUL-25', 'To date=30-JUN-26']);
            check('... every other saved answer is untouched, byte for byte', [T.dept, T.pi, T.stat].map(function (t) { return storedRaw(t) === before[t]; }), [true, true, true]);
            check('... its own answers are kept', [(stored(T.from) || {}).value, (stored(T.to) || {}).value], ['01-JUL-25', '30-JUN-26']);
            check('... and the report re-ran once', window.__execClicks, 1);

            clearAll(); answerAll();
            seen = await okThrough(env.reconfigureAllPrompts(''));
            check('"" = the unsectioned prompts, a section of their own', seen, ['Department=OSP', 'PI=Anderson']);
            clearAll(); answerAll();
            seen = await okThrough(env.reconfigureAllPrompts('  DATES '));
            check('the section asked for is matched without case or extra spaces', seen, ['From date=01-JUL-25', 'To date=30-JUN-26']);
            clearAll(); answerAll();
            seen = await okThrough(env.reconfigureAllPrompts());
            check('no section given: every prompt, as before', seen, ['From date=01-JUL-25', 'Department=OSP', 'To date=30-JUN-26', 'Status=Active', 'PI=Anderson']);
            clearAll(); answerAll();
            MIX.forEach(function (t) { before[t] = storedRaw(t); });
            seen = await okThrough(env.reconfigureAllPrompts('nosuch'));
            check('a section with no prompts: nothing asked, nothing changed, nothing re-run, a notice',
                [seen.length, MIX.every(function (t) { return storedRaw(t) === before[t]; }), window.__execClicks, calls.toasts.join(' ').indexOf('No prompts found in this section') >= 0], [0, true, 0, true]);

            clearAll(); answerAll();
            MIX.forEach(function (t) { before[t] = storedRaw(t); });
            var pc = env.reconfigureAllPrompts('dates');
            await tick(40);
            var dlg = lastDialog();
            if (dlg) $('#' + dlg.id + '_cancel').trigger('click');
            await pc;
            check('Cancel: nothing saved, nothing re-run', [MIX.every(function (t) { return storedRaw(t) === before[t]; }), window.__execClicks], [true, 0]);

            // A child in a section of its OWN is reviewed apart from its parent. The
            // failure to prevent: judged against NO answer, a failed resultif DELETES
            // the child's saved answer - so it is judged on the parent's SAVED answer.
            var RP = '[PROMPT;type=select;name=col;message=Search by;options=NAME,OUC;template="";section=Filters]';
            var RK = '[PROMPT;type=text;name=kid;resultif=col:OUC;message=OUC value;section=Dates;template="AND x = :val"]';
            var answerTree = function () { store(T.from, '01-JUL-25', 'From date'); store(T.to, '30-JUN-26', 'To date'); store(RP, 'OUC', 'Search by'); store(RK, '10', 'OUC value'); };
            window.__editorSql = sqlOf([T.from, T.to, RP, RK]);
            clearAll(); answerTree();
            seen = await okThrough(env.reconfigureAllPrompts('dates'));
            check('reviewing Dates asks the child that named Dates, judged on its parent\'s SAVED answer (col = OUC)', seen, ['From date=01-JUL-25', 'To date=30-JUN-26', 'OUC value=10']);
            check('... it keeps its answer, and the parent\'s is untouched', [(stored(RK) || {}).value, (stored(RP) || {}).value], ['10', 'OUC']);
            clearAll(); answerTree();
            var rkBefore = storedRaw(RK);
            seen = await okThrough(env.reconfigureAllPrompts('filters'));
            check('reviewing Filters asks the parent only - that child is in Dates', seen, ['Search by=OUC']);
            check('... and the child\'s saved answer is untouched, byte for byte', storedRaw(RK) === rkBefore, true);
            clearAll(); answerTree(); store(RP, 'NAME', 'Search by');
            seen = await okThrough(env.reconfigureAllPrompts('dates'));
            check('the parent\'s SAVED answer fails the child\'s condition: not asked and its answer cleared, as a run would',
                [seen, stored(RK)], [['From date=01-JUL-25', 'To date=30-JUN-26'], null]);

            // A parent the review cannot see (hidden = never saved, or written AFTER
            // the child): the child is neither asked nor deleted - the re-run decides.
            var HP = '[PROMPT;type=text;name=hp;hidden;forcedefault=x]';
            var HK = '[PROMPT;type=text;name=hk;resultif=hp:x;message=Hidden kid;section=Own]';
            var HK2 = '[PROMPT;type=text;name=hk2;resultif=hp:x;message=Hidden kid two]';
            window.__editorSql = sqlOf([HP, HK, HK2, T.dept]);
            clearAll(); store(HK, 'keep', 'Hidden kid'); store(HK2, 'keep2', 'Hidden kid two'); store(T.dept, 'OSP', 'Department');
            seen = await okThrough(env.reconfigureAllPrompts('own'));
            check('a child whose parent is hidden (never saved): its section\'s review does not ask it and KEEPS its answer', [seen, (stored(HK) || {}).value], [[], 'keep']);
            clearAll(); store(HK, 'keep', 'Hidden kid'); store(HK2, 'keep2', 'Hidden kid two'); store(T.dept, 'OSP', 'Department');
            seen = await okThrough(env.reconfigureAllPrompts());
            check('... and Review all keeps it too (it used to DELETE it, so the re-run asked again from nothing)', [seen, (stored(HK2) || {}).value], [['Department=OSP'], 'keep2']);

            // The shape that broke on 2026-09-24: dirsearch's People - a control of its
            // own, in a section of its own, whose resultif only skips it for some columns.
            var COLP = '[PROMPT;type=select;name=column;nosave;template="";message=Search by;options=None:NONE,Last name:LAST_NAME,Active flag:ACTIVE]';
            var LN = '[PROMPT;type=text;name=last_name;resultif=column:LAST_NAME;nosave;message=Last name;template="AND LAST_NAME = :val"]';
            var PPL = '[PROMPT;type=select;name=people;section=active_only;resultif=column:!ACTIVE;forcedefault=Active only;message=People;options=Active only,Everyone;template="AND (:val = \'Everyone\' OR ACTIVE = 1)"]';
            var answerDir = function (col) { store(COLP, col, 'Search by'); store(LN, 'LIMON', 'Last name'); store(PPL, 'Everyone', 'People'); };
            window.__editorSql = sqlOf([COLP, LN, PPL]);
            clearAll(); answerDir('LAST_NAME');
            env.updatePromptDisplay();
            check('dirsearch shape: Search by + Last name in one box with a button, People a chip of its own (no button, pencil kept)',
                [$list.find('li.prompt-section').map(function () { return textsOf($(this).find('em')).join('|'); }).get(), textsOf($list.find('a.is-solo em'))],
                [['Search by:|Last name:'], ['People:']]);
            var pplBefore = storedRaw(PPL);
            seen = await okThrough(env.reconfigureAllPrompts(''));
            check('... the box\'s review asks Search by and Last name, NOT People', seen, ['Search by=LAST_NAME', 'Last name=LIMON']);
            check('... and People\'s answer is untouched', storedRaw(PPL) === pplBefore, true);
            clearAll(); answerDir('LAST_NAME');
            seen = await okThrough(env.reconfigureAllPrompts('active_only'));
            check('... People\'s own section: asked, judged on the SAVED column (LAST_NAME is not ACTIVE)', [seen, (stored(PPL) || {}).value], [['People=Everyone'], 'Everyone']);
            clearAll(); answerDir('ACTIVE');
            seen = await okThrough(env.reconfigureAllPrompts('active_only'));
            check('... with ACTIVE saved as the column, People is skipped and cleared - exactly what a run does', [seen, stored(PPL)], [[], null]);

            // =================================================================
            section('G. the real click handlers');
            check('both handlers were found in main.js', [env.handlersFound.bar, env.handlersFound.section], [true, true]);
            window.__editorSql = sqlOf(MIX);
            clearAll(); answerAll();
            env.updatePromptDisplay();
            seen = await okThroughClick($('#promptInfoList .prompt-section-review[data-prompt-section="dates"]'));
            check('clicking the Dates box\'s button reviews Dates', seen, ['From date=01-JUL-25', 'To date=30-JUN-26']);
            clearAll(); answerAll();
            env.updatePromptDisplay();
            seen = await okThroughClick($('#promptInfoList .prompt-section-review[data-prompt-section=""]'));
            check('clicking the unsectioned box\'s button reviews those two', seen, ['Department=OSP', 'PI=Anderson']);

            var ELSE = '[PROMPT;type=text;name=zz;message=Elsewhere;default=d;section=Else]';
            window.__editorSql = sqlOf(ONESEC.concat([ELSE]));
            clearAll(); store(ONESEC[0], '01-JUL-25', 'From date'); store(ONESEC[1], '30-JUN-26', 'To date'); store(ONESEC[2], 'OSP', 'Department');
            env.updatePromptDisplay();
            check('CONTROL: an unanswered prompt in another section has no chip, so the bar shows ONE section',
                [$list.find('.prompt-section').length, $('#resetAllPromptsLink').attr('data-prompt-section')], [0, 'main']);
            seen = await okThroughClick($('#resetAllPromptsLink'));
            check('the bar\'s own button reviews its one named section - not the prompt elsewhere', seen, ['From date=01-JUL-25', 'To date=30-JUN-26', 'Department=OSP']);
            window.__editorSql = sqlOf(NOSEC.concat(['[PROMPT;type=text;name=zz;message=Elsewhere;default=d]']));
            clearAll(); store(NOSEC[0], '01-JUL-25', 'From date'); store(NOSEC[1], '30-JUN-26', 'To date'); store(T.dept, 'OSP', 'Department');
            env.updatePromptDisplay();
            seen = await okThroughClick($('#resetAllPromptsLink'));
            check('no sections: the bar\'s own button reviews every prompt, as before', seen, ['From date=01-JUL-25', 'To date=30-JUN-26', 'Department=OSP', 'Elsewhere=d']);

            if (window.__control) check('CONTROL: deliberate failure', 1, 2);
        } catch (e) {
            fail++;
            out.push('  FAIL threw: ' + (e && e.stack ? e.stack : e));
        }
        finish();
    })();
