            check('a resultif child with no section is drawn in its PARENT\'s box; one that names its own, in THAT box',
                $list.find('li.prompt-section').map(function () { return textsOf($(this).find('em')).join('|'); }).get(), ['From date:|To date:|Own value:', 'Search by:|Value:']);

