    function textsOf($els) { return $els.map(function () { return $(this).text(); }).get(); }

    var T = {
        from: '[PROMPT;type=text;name=from;message=From date;section=Dates]',
        to: '[PROMPT;type=text;name=to;message=To date;section= dates ]',     // same section, other spelling
        dept: '[PROMPT;type=text;name=dept;message=Department]',
        pi: '[PROMPT;type=text;name=pi;message=PI]',
        stat: '[PROMPT;type=select;name=status;message=Status;options=Active,Closed;section=Status]'
    };
    function answerAll() {
        store(T.from, '01-JUL-25', 'From date'); store(T.to, '30-JUN-26', 'To date');
        store(T.dept, 'OSP', 'Department'); store(T.pi, 'Anderson', 'PI'); store(T.stat, 'Active', 'Status');
    }
    var MIX = [T.from, T.dept, T.to, T.stat, T.pi];    // Dates, -, Dates, Status, -
    var NOSEC = ['[PROMPT;type=text;name=from;message=From date]', '[PROMPT;type=text;name=to;message=To date]', T.dept];

    (async function () {
        try {
            // =================================================================
            section('A. parsePrompt reads section=, nothing else changes');
            check('section= is read', env.parsePrompt('[PROMPT;type=text;name=a;section=Dates;message=Pick one]').section, 'Dates');
            check('no section= = null', env.parsePrompt('[PROMPT;type=text;name=a]').section, null);
            check('an empty section= = null', env.parsePrompt('[PROMPT;type=text;name=a;section=]').section, null);
            check('spaces around the name are trimmed', env.parsePrompt(T.to).section, 'dates');
            check('SECTION= in capitals is the same key', env.parsePrompt('[PROMPT;type=text;SECTION=X]').section, 'X');
            check('"section=" inside a message value is not a section', env.parsePrompt('[PROMPT;type=text;name=a;message=Use section=x]').section, null);
            var withSec = env.parsePrompt('[PROMPT;type=select;name=s;message=Status;section=Filters;options=A:1,B:2;template="AND c = :val";nosave]');
            var withoutSec = env.parsePrompt('[PROMPT;type=select;name=s;message=Status;options=A:1,B:2;template="AND c = :val";nosave]');
            delete withSec.section; delete withoutSec.section;
            check('every other field parses exactly as without it (options, template, flags)', withSec, withoutSec);
            check('the value before it keeps its end', env.parsePrompt('[PROMPT;type=text;message=Pick one;section=S]').message, 'Pick one');

            // =================================================================
            section('B. the answer key leaves section= out');
            var base = '[PROMPT;type=text;name=a;message=A]';
            check('section= last', K('[PROMPT;type=text;name=a;message=A;section=Dates]'), K(base));
            check('section= in the middle', K('[PROMPT;type=text;section=Dates;name=a;message=A]'), K(base));
            check('section= first after PROMPT;', K('[PROMPT;section=Dates;type=text;name=a;message=A]'), K(base));
            check('SECTION= in capitals, a two-word name, spaces before the ]', K('[PROMPT;type=text;name=a;message=A;SECTION= Report period ]'), K(base));
            check('renaming a section keeps the key', K('[PROMPT;type=text;name=a;message=A;section=Dates]'), K('[PROMPT;type=text;name=a;message=A;section=Filters]'));
            check('a tag written over several lines, with its section line deleted',
                K('[PROMPT;\n  type=text;\n  section=Dates;\n  name=a\n]'), K('[PROMPT;\n  type=text;\n  name=a\n]'));
            check('... and when the section line was the last one',
                K('[PROMPT;\n  type=text;\n  name=a;\n  section=Dates\n]'), K('[PROMPT;\n  type=text;\n  name=a\n]'));
            check('a shared prompt keeps its global key', K('[PROMPT;type=text;name=a;share;section=X]'), K('[PROMPT;type=text;name=a;share]'));
            // A tag WITHOUT section= keeps the key it always had - the hash, written out here as the spec.
            var legacyKey = function (tag) {
                var h = 0;
                for (var i = 0; i < tag.length; i++) { h = ((h << 5) - h) + tag.charCodeAt(i); h = h & h; }
                return 'penumbra_prompt_' + (new URLSearchParams(window.location.search).get('id') || '__adhoc__') + '_' + Math.abs(h);
            };
            check('a tag without section= keeps its old key', K(base), legacyKey(base));
            check('... also when its message says "section=" (only a ;section= key is dropped)', K('[PROMPT;type=text;name=a;message=Use section=x]'), legacyKey('[PROMPT;type=text;name=a;message=Use section=x]'));
            check('a look-alike key (subsection=) is NOT dropped', K('[PROMPT;type=text;name=a;message=A;subsection=X]') === K(base), false);
            check('two different prompts in one section keep two keys', K('[PROMPT;type=text;name=b;section=Dates]') === K('[PROMPT;type=text;name=a;section=Dates]'), false);

            // =================================================================
            section('C. promptSectionMap - which section a prompt is in');
            var hasMap = typeof env.promptSectionMap === 'function' && typeof env.promptSectionKey === 'function';
            check('main.js has promptSectionMap and promptSectionKey', hasMap, true);
            var mapOf = function (tags) {
                var m = hasMap ? env.promptSectionMap(tags.join('\n')) : new Map();
                var o = {};
                tags.forEach(function (t) { o[env.parsePrompt(t).name || '?'] = m.has(K(t)) ? m.get(K(t)) : '(none)'; });
                return o;
            };
            check('names compare without case or extra spaces; no section = ""', mapOf([T.from, T.to, T.dept]), { from: 'dates', to: 'dates', dept: '' });
            check('promptSectionKey("  Report   Period ") = "report period"', hasMap ? env.promptSectionKey('  Report   Period ') : null, 'report period');
            var c1 = '[PROMPT;type=text;name=c;message=C]', c2 = '[PROMPT;type=text;name=c;message=C;section=Dates]', c3 = '[PROMPT;type=text;name=c;message=C;section=Other]';
            check('an unsectioned copy, then a sectioned copy: the section counts', hasMap ? env.promptSectionMap([c1, c2].join('\n')).get(K(c1)) : null, 'dates');
            check('two copies naming different sections: the first one decides', hasMap ? env.promptSectionMap([c2, c3].join('\n')).get(K(c1)) : null, 'dates');
            var par = '[PROMPT;type=select;name=col;message=Search by;options=A,B;section=Filters]';
            var kid = '[PROMPT;type=text;name=kid;resultif=col:A;message=Kid;section=Dates]';
            var grand = '[PROMPT;type=text;name=grand;resultif=kid:x;message=Grandchild]';
            var orphan = '[PROMPT;type=text;name=orph;resultif=nobody:x;message=Orphan;section=Dates]';
            var kid2 = '[PROMPT;type=text;name=kid2;resultif=col:B;message=Kid two]';
            var grand2 = '[PROMPT;type=text;name=grand2;resultif=kid2:x;message=Grandchild two]';
            check('a child that names NO section sits in its parent\'s (up the chain, even written before it); one that names its own KEEPS it; an orphan keeps its own',
                mapOf([kid, par, grand, orphan, kid2, grand2]), { kid: 'dates', col: 'filters', grand: 'dates', orph: 'dates', kid2: 'filters', grand2: 'filters' });
            var la = '[PROMPT;type=text;name=la;resultif=lb:x;message=LA;section=S1]', lb = '[PROMPT;type=text;name=lb;resultif=la:x;message=LB;section=S2]';
            check('a parent loop (a <-> b) still ends', Object.keys(mapOf([la, lb])).length, 2);

            // =================================================================
            section('D. updatePromptDisplay - the bar');
            mountBar();
            var $list = $('#promptInfoList');
            clearAll();
            window.__editorSql = sqlOf(NOSEC);
            store(NOSEC[0], '01-JUL-25', 'From date'); store(NOSEC[1], '30-JUN-26', 'To date'); store(T.dept, 'OSP', 'Department');
            env.updatePromptDisplay();
            check('no sections: three chips straight in the list, no boxes, no section buttons',
                [$list.children('li').length, $list.find('.prompt-section').length, $list.find('.prompt-section-review').length], [3, 0, 0]);
            check('no sections: the bar\'s own button shows and reviews everything (no section on it)',
                [$('#resetAllPromptsLink').css('display') !== 'none', $('#resetAllPromptsLink').attr('data-prompt-section')], [true, undefined]);
            check('no sections: no .is-solo, no has-sections', [$list.find('.is-solo').length, $list.hasClass('has-sections')], [0, false]);
            var htmlNoSec = $list.html();
            if (ref) {
                ref.updatePromptDisplay();
                check('no sections: the bar is BYTE-IDENTICAL to the reference build\'s', $list.html(), htmlNoSec);
                env.updatePromptDisplay();
            } else {
                note('no separate reference build - the byte comparison with the pre-section bar is skipped');
            }

            var ONESEC = NOSEC.map(function (t) { return t.replace(']', ';section=Main]'); });
            window.__editorSql = sqlOf(ONESEC);
            env.updatePromptDisplay();
            check('every chip in ONE named section: the same three plain chips - their answers found under the old keys',
                [$list.children('li').length, $list.find('.prompt-section').length, textsOf($list.find('a.prompt-byline-link strong'))],
                [3, 0, ['01-JUL-25', '30-JUN-26', 'OSP']]);
            check('... and the bar\'s own button reviews that section',
                [$('#resetAllPromptsLink').css('display') !== 'none', $('#resetAllPromptsLink').attr('data-prompt-section')], [true, 'main']);

            window.__editorSql = sqlOf(MIX);
            clearAll(); answerAll();
            env.updatePromptDisplay();
