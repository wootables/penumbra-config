/*
 * promptsection_bar_tests.js - section= on query prompts (2026-09-24): the
 * answered-prompts BAR and its REVIEW buttons.
 *
 * Drives the SHIPPED code: window.__src holds js/main.js as text (baked by
 * run.ps1); the functions under test and the bar's two click handlers are cut
 * out of it by name / exact first line and compiled with real jQuery, jQuery UI
 * and moment. The bar's markup (#promptInfoContainer) is LIFTED from the
 * index.php under test and styled by the css/main.css under test, so the CSS
 * checks measure the rules that ship. window.__srcRef, when run.ps1 supplies a
 * different build (live, while a stage is tested), is the reference for "the
 * bar without sections is byte for byte what it was".
 *
 * What it pins - each one a decision, not an accident:
 *   A. parsePrompt reads section=, and nothing else about a prompt changes.
 *   B. getPromptStorageKey leaves section= out of the answer key: adding,
 *      renaming or removing a section keeps the saved answer, and copies of a
 *      tag that differ only in section= stay ONE prompt. A tag without
 *      section= keeps the key it always had.
 *   C. promptSectionMap: names compare without case or extra spaces; the first
 *      copy that names a section decides; a resultif child that names NO
 *      section sits in its PARENT's (followed up the chain), one that names its
 *      own keeps it (2026-09-24 14:50 - before that a child always followed).
 *   D. updatePromptDisplay: one section or none = the bar as before; two or
 *      more = a box with its own review button per section of 2+ chips, a plain
 *      .is-solo chip for a section of one, the bar's own button hidden. The
 *      wrappers add no text and the button is a <button>, so data(prompts)
 *      (the list's text) and the exports (`#promptInfoList li a`) see only chips.
 *   E. main.css: the <button> ignores the global and themed button rules and
 *      looks like the bar's own button; a solo chip keeps its pencil; a long
 *      answer in a box still ellipsizes at the container edge.
 *   F. reconfigureAllPrompts(section): only that section is asked; every other
 *      saved answer is untouched (its save loop clears every key it lists);
 *      no argument = every prompt, as before; Cancel saves nothing; a child in
 *      a section of its own is judged on its parent's SAVED answer, never on
 *      nothing (a failed condition DELETES the child's answer); a child whose
 *      parent the review cannot see (hidden = never saved) is neither asked nor
 *      deleted; and the dirsearch People shape that broke on 2026-09-24.
 *   G. The real click handlers: a box's button reviews its section; the bar's
 *      own button reviews everything - or its one named section.
 */
(function () {
    var out = [];
    var pass = 0, fail = 0;
    function show(v) { try { return JSON.stringify(v); } catch (e) { return String(v); } }
    function check(label, got, want) {
        if (show(got) === show(want)) { pass++; out.push('  ok   ' + label); }
        else { fail++; out.push('  FAIL ' + label + '\n         got:  ' + show(got) + '\n         want: ' + show(want)); }
    }
    function note(t) { out.push('  note ' + t); }
    function section(t) {
        out.push('\n=== ' + t + ' ===');
        document.getElementById('out').textContent = out.join('\n') + '\nSTALLED in: ' + t;
    }
    function finish() {
        out.push('\nPASS: ' + pass + '   FAIL: ' + fail);
        out.push('RESULT: ' + (fail === 0 ? 'GREEN' : 'RED'));
        document.getElementById('out').textContent = out.join('\n') + '\nDONE';
    }

    // main.js is CRLF; every anchor below is written with \n.
    var code = String(window.__src || '').replace(/\r\n/g, '\n');
    var codeRef = String(window.__srcRef || '').replace(/\r\n/g, '\n');

    function fnRe(name) { return new RegExp('\\n    (?:async )?function ' + name + '\\('); }
    function grabFn(src, name) {
        var m = fnRe(name).exec(src);
        if (!m) throw new Error('grab: function ' + name + ' not found in main.js');
        var start = m.index + 1;
        var end = src.indexOf('\n    }\n', start);
        if (end < 0) throw new Error('grab: end of ' + name + ' not found');
        return src.substring(start, end + 7);
    }
    function grabLine(src, re, what) {
        var m = re.exec(src);
        if (!m) throw new Error('grab: ' + what + ' not found in main.js');
        return m[0];
    }
    // A top-level statement: from its exact first line to the first "\n    });\n".
    function grabStmt(src, firstLine) {
        var at = src.indexOf('\n    ' + firstLine);
        if (at < 0) return null;
        var end = src.indexOf('\n    });\n', at + 1);
        return end < 0 ? null : src.substring(at + 1, end + 9);
    }

    var NAMES = [
        'escapeHtml', 'decodeHtmlEntities', 'stripWrappingQuotePair',
        'resolveDynamicValues', 'resolveKeywordDate', 'resolveDynamicDate',
        'penumbraIsDateRangeType', 'penumbraSplitDateRange', 'penumbraJoinDateRange', 'penumbraRangeHasKeywordEnd',
        'penumbraParseRangeEnd', 'penumbraFormatRangeEnd', 'penumbraRangeKeywordDate', 'penumbraResolveRangeEnd',
        'penumbraResolveDateRange', 'penumbraApplyDateRangeTemplate', 'penumbraDateRangePresets',
        'penumbraDateRangePresetFor', 'penumbraDateRangeLabel', 'penumbraDateRangeResolvedText', 'penumbraDateRangeRawDefault',
        'parsePrompt', 'parseMultiSelectDefault', 'splitValidateRules', 'validatePromptInput', 'sanitizeCssString',
        'showPromptDialog', '_pnbDateRangeDialogHtml', '_pnbWireDateRangeDialog',
        'generateResetLinkHtml', 'attachResetHandler', 'getPromptStorageKey', 'getPromptAnswerByName',
        'autofillAuthFailed', 'autofillPayloadError', 'resolvePromptDateRange',
        'promptTypeIconPaths', 'promptTypeIconSvg', '_pnbDatepickerBeforeShow',
        'promptStateIconSvg', 'updatePromptDisplay',
        'reconfigureSinglePrompt', 'reconfigureAllPrompts'
    ];
    // New with section=; a build without them still compiles (and goes red below).
    var OPTIONAL = ['promptSectionKey', 'promptSectionMap'];
    var HANDLER_BAR = "$(document).on('click', '#resetAllPromptsLink', function (e) {";
    var HANDLER_SECTION = "$(document).on('click', '#promptInfoList .prompt-section-review', function (e) {";

    var calls = { toasts: [] };
    function buildEnv(src, withHandlers) {
        var names = NAMES.concat(OPTIONAL.filter(function (n) { return fnRe(n).test(src); }));
        var body = "var PNB_DATE_RANGE_SEP = '..';\n"
            + grabLine(src, /\n    const _isRangeKeyword = [^\n]+\n/, '_isRangeKeyword')
            + 'var _promptRangeCache = new Map();\n'
            + 'var _forceDefaultApplied = new Set();\n'
            + names.map(function (n) { return grabFn(src, n); }).join('\n');
        var found = { bar: false, section: false };
        if (withHandlers) {
            var h1 = grabStmt(src, HANDLER_BAR), h2 = grabStmt(src, HANDLER_SECTION);
            if (h1) { body += '\n' + h1; found.bar = true; }
            if (h2) { body += '\n' + h2; found.section = true; }
        }
        body += '\nreturn {' + names.map(function (n) { return n + ':' + n; }).join(',')
            + ', _forceDefaultApplied: _forceDefaultApplied };';
        var e = new Function('getQuery', 'getSnippet', 'currentThemeId', 'penumbra_vars', 'editor', 'renderReportSnippet', 'handleSessionExpiredError',
            'showLoading', 'hideLoading', 'show_text', body)(
            function () { return window.__editorSql || ''; },
            function () { return window.__snippetSql || ''; },
            function () { return 'theme-default'; },
            { shibboleth: {} },
            { getValue: function () { return window.__editorSql || ''; } },
            function () { }, function () { }, function () { }, function () { },
            function (html) { calls.toasts.push(String(html)); });
        e.handlersFound = found;
        return e;
    }

    var env, ref = null;
    try {
        $.ajax = function () { return Promise.resolve([]); };
        window._pnbModalHost = function () { return $(document.body); };
        env = buildEnv(code, true);
        if (codeRef && codeRef !== code) ref = buildEnv(codeRef, false);
        if (!window.__containerHtml) throw new Error('run.ps1 did not supply the #promptInfoContainer markup');
    } catch (e) {
        out.push('HARNESS FAILED TO BUILD: ' + e.message);
        fail++;
        finish();
        return;
    }

    function tick(ms) { return new Promise(function (r) { setTimeout(r, ms || 0); }); }
    function mountBar() {
        $('#hdr').remove();
