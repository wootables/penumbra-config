<script>
(function () {
  function report(txt) { document.getElementById('out').textContent = txt; }
  var results = [];
  function assert(name, cond, detail) { results.push({ name: name, pass: !!cond, detail: detail === undefined ? '' : String(detail) }); }
  function eq(name, got, want) { assert(name, JSON.stringify(got) === JSON.stringify(want), 'got ' + JSON.stringify(got) + ' want ' + JSON.stringify(want)); }
  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  function finish() { report('RESULTS_JSON:' + JSON.stringify({ pageErrors: window.__errors.slice(0, 6), results: results })); }

  var COLS = ['#', 'COLLEGE', 'FY', 'AMOUNT', 'STATUS', '% CHANGE'];
  function row(n, college, fy, amount, status, pct) {
    var m = new Map();
    m.set('#', String(n)); m.set('COLLEGE', college); m.set('FY', fy); m.set('AMOUNT', amount); m.set('STATUS', status); m.set('% CHANGE', pct);
    return m;
  }
  // 13 rows. COLLEGE: Eng 6 (one 'ENG', one @@HTML-wrapped), Sci 3, Ag 2, CHASS 1,
  // one blank. FY: 2025 x7, 2024 x4, 2023 x2. STATUS: Active 8, Closed 3, Pending 2.
  function fixture() {
    return [
      row(1, 'Eng', '2025', '100', 'Active', '5'),
      row(2, 'Eng', '2025', '250', 'Closed', '5'),
      row(3, 'Eng', '2024', '50', 'Active', '-2'),
      row(4, 'Eng', '2023', '500', 'Pending', '10'),
      row(5, 'ENG', '2024', '20', 'Active', '5'),
      row(6, '@@HTML<a href="#">Eng</a>', '2025', '900', 'Active', '7'),
      row(7, 'Sci', '2025', '300', 'Active', '5'),
      row(8, 'Sci', '2024', '75', 'Closed', '1'),
      row(9, 'Sci', '2023', '10', 'Active', '0'),
      row(10, 'Ag', '2025', '40', 'Active', '5'),
      row(11, 'Ag', '2024', '60', 'Closed', '3'),
      row(12, 'CHASS', '2025', '5', 'Pending', '5'),
      row(13, '', '2025', '1', 'Active', '9')
    ];
  }
  function vals(g, col) {
    var grp = null;
    g.groups.forEach(function (x) { if (x.field.col === col) grp = x; });
    return grp ? grp.values.map(function (e) { return [e.v, e.n, e.on]; }) : null;
  }
  function chipText(sel) { return $(sel).map(function () { return $(this).find('.pnb-fs-v').text(); }).get(); }
  function matchCount(F, text, rows) {
    var parsed = F.parseQ(text, COLS), n = 0;
    rows.forEach(function (r) { if (F.evalQ(r, parsed, COLS)) n++; });
    return n;
  }

  // ══════ I. the composable toggle: filter|COND / unfilter|COND (2026-09-29) ══════
  // A toggle built on search| replaced the whole box: it wiped a strip's chips,
  // and read OFF as soon as a chip was pressed beside it. filter| adds ONE
  // condition to the AND-run and unfilter| takes it out, leaving the rest.
  function until(fn, ms) {
    var t0 = Date.now();
    return new Promise(function (res) {
      (function poll() {
        var ok = false;
        try { ok = !!fn(); } catch (e) { ok = false; }
        if (ok || Date.now() - t0 > ms) res(ok); else setTimeout(poll, 40);
      })();
    });
  }
  function sectionI(F, draw, outText, S) {
    var TG = '#reportSnippetOutput .pnb-toggle';
    var box = function () { return String($('#tableSearch').val()); };
    var tsOn = function (i) { return $(TG).eq(i).attr('data-ts-on'); };
    $('#tableSearch').val('');
    // Runs on every main.js (the positive control shows the number pass
    // rewriting a search| toggle's command before this change).
    return draw("toggle_switch('FY 2025 old', 'on|search|FY = 2025', 'off|search|')").then(function () {
      eq('toggle: a number in a search| command reaches the markup unformatted', $('#reportSnippetOutput .pnb-toggle-btn').attr('data-ts-onc'), 'search|FY = 2025');
      eq('toggle: ... and in its label', $('#reportSnippetOutput .pnb-toggle-label').text(), 'FY 2025 old');
      var T = window.PenumbraTiles && window.PenumbraTiles.strip;
      if (!T || typeof T.has !== 'function' || typeof T.add !== 'function' || typeof T.remove !== 'function') {
        assert('cond: PenumbraTiles.strip.has/add/remove available', false, 'PenumbraTiles.strip=' + typeof T);
        return null;
      }
      // I.1 has / add / remove
      assert('cond: has finds a condition among the AND fragments', T.has('COLLEGE = /^(?:Eng)$/ and STATUS = Active', 'STATUS = Active') === true, '');
      assert('cond: has ignores spacing around the operator', T.has('STATUS=Active', 'STATUS = Active') === true && T.has('STATUS = Active', 'STATUS=Active') === true, '');
      assert('cond: has is exact otherwise (case counts)', T.has('status = active', 'STATUS = Active') === false, '');
      assert('cond: has is false on a box holding a top-level or', T.has('STATUS = Active or FY = 2025', 'STATUS = Active') === false, '');
      assert('cond: several conditions are all-or-nothing, in any order', T.has('A = 1 and B = 2', 'B = 2 and A = 1') === true && T.has('A = 1', 'A = 1 and B = 2') === false, '');
      eq('cond: add to an empty box', T.add('', 'STATUS = Active'), 'STATUS = Active');
      eq('cond: add keeps the chips and joins with and', T.add('COLLEGE = /^(?:Eng)$/', 'STATUS = Active'), 'COLLEGE = /^(?:Eng)$/ and STATUS = Active');
      eq('cond: add never doubles a condition already there', T.add('STATUS = Active', 'STATUS=Active'), 'STATUS = Active');
      eq('cond: add keeps the __ROW prefix in front', T.add('__ROW X = 1', 'Y = 2'), '__ROW X = 1 and Y = 2');
      eq('cond: add keeps a regex alternation whole', T.add('', 'COLLEGE = /^(?:Eng|Sci)$/'), 'COLLEGE = /^(?:Eng|Sci)$/');
      assert('cond: add refuses a box holding an or (null)', T.add('A = 1 or B = 2', 'C = 3') === null, String(T.add('A = 1 or B = 2', 'C = 3')));
      assert('cond: add refuses a condition holding an or (null)', T.add('A = 1', 'B = 1 or C = 2') === null, String(T.add('A = 1', 'B = 1 or C = 2')));
      eq('cond: remove takes out only that condition', T.remove('AMOUNT > 100 and STATUS = Active and FY = 2025', 'STATUS = Active'), 'AMOUNT > 100 and FY = 2025');
      eq('cond: remove of the last condition empties the box, prefix and all', T.remove('__ROW STATUS = Active', 'STATUS = Active'), '');
      eq('cond: remove of an absent condition leaves the text alone', T.remove('X = 1', 'STATUS = Active'), 'X = 1');
      assert('cond: remove refuses a box holding an or (null)', T.remove('A = 1 or B = 2', 'A = 1') === null, '');
      var sp = window.PenumbraTiles.splitSearch('__ROW A = 1 and B = /x and y/ or C = 3');
      eq('split: splitSearch reads the same through the shared splitter', { p: sp.prefix, f: sp.fragments.map(function (x) { return x.col + ':' + x.text; }), or: sp.or },
        { p: '__ROW ', f: ['A:A = 1', 'B:B = /x and y/', 'C:C = 3'], or: true });

      // I.2 rendering
      return draw("toggle_switch('Active only', 'on|filter|STATUS = Active')");
    }).then(function (skip) {
      if (skip === null) return null;
      var $b = $('#reportSnippetOutput .pnb-toggle-btn');
      assert('toggle: a filter|-only ON side renders without an off| side', $b.length === 1, outText().substring(0, 160));
      eq('toggle: its OFF side is the implied unfilter|', $b.attr('data-ts-offc'), 'unfilter|STATUS = Active');
      return draw("toggle_switch('Big Eng', 'on|filter|COLLEGE = Eng', 'on|filter|AMOUNT > 100')").then(function () {
        eq('toggle: an implied OFF series undoes each step, last first', $('#reportSnippetOutput .pnb-toggle-btn').attr('data-ts-offc'), 'unfilter|AMOUNT > 100␟unfilter|COLLEGE = Eng');
        return draw("toggle_switch('Mixed', 'on|filter|STATUS = Active', 'on|group_by|COLLEGE')");
      }).then(function () {
        assert('toggle: an ON side with anything besides filter| still needs its off| side', $(TG).length === 0 && outText().indexOf('needs at least one off|COMMAND') !== -1, outText().substring(0, 160));
        return draw("toggle_switch('Empty', 'on|filter|')");
      }).then(function () {
        assert('toggle: filter| with no condition is refused by name', $(TG).length === 0 && outText().indexOf('filter| needs a condition') !== -1, outText().substring(0, 160));
        return draw("toggle_switch('Or', 'on|filter|STATUS = Active or FY = 2025')");
      }).then(function () {
        assert('toggle: a condition holding an or is refused', $(TG).length === 0 && outText().indexOf('an or cannot be combined') !== -1, outText().substring(0, 160));
        return draw("toggle_switch('Row', 'on|filter|__ROW STATUS = Active')");
      }).then(function () {
        assert('toggle: a condition carrying __ROW is refused', $(TG).length === 0 && outText().indexOf('cannot carry __ROW') !== -1, outText().substring(0, 160));
        return draw("toggle_switch('FY 2025', 'on|filter|FY = 2025')");
      }).then(function () {
        eq('toggle: a number in a filter| condition reaches the markup unformatted', $('#reportSnippetOutput .pnb-toggle-btn').attr('data-ts-onc'), 'filter|FY = 2025');

        // I.3 a strip and two toggles sharing the box
        $('#tableSearch').val('');
        return draw("filter_strip('College|COLLEGE', 'Fiscal Year|FY|az') toggle_switch('Active only', 'on|filter|STATUS = Active') toggle_switch('Active (old)', 'on|search|STATUS = Active', 'off|search|')");
      }).then(function () {
        F.syncToggles();
        assert('flow: both toggles read OFF on an empty box', tsOn(0) === '0' && tsOn(1) === '0', tsOn(0) + ' ' + tsOn(1));
        $(TG).eq(0).find('.pnb-toggle-btn').trigger('click');
        return until(function () { return !F.motion() && box() !== ''; }, 5000);
      }).then(function () {
        eq('flow: the filter| toggle adds its condition', box(), 'STATUS = Active');
        assert('flow: ... and reads ON', tsOn(0) === '1', tsOn(0));
        assert('flow: the search| toggle with the same condition reads ON too (whole-box equality)', tsOn(1) === '1', tsOn(1));
        $(S + ' .pnb-fs-chip[data-fs-val="Eng"]').trigger('click');
        return until(function () { return !F.motion() && box() !== 'STATUS = Active'; }, 5000);
      }).then(function () {
        eq('flow: a chip joins the toggle condition instead of replacing it', box(), 'COLLEGE = /^(?:Eng)$/ and STATUS = Active');
        assert('flow: the filter| toggle stays ON beside a pressed chip', tsOn(0) === '1', tsOn(0));
        assert('flow: the search| toggle reads OFF once the box holds more (unchanged behaviour)', tsOn(1) === '0', tsOn(1));
        eq('flow: the strip counts take the toggle condition into account', $(S + ' .pnb-fs-group:eq(1) .pnb-fs-chip .pnb-fs-n').map(function () { return $(this).text(); }).get(), ['0', '2', '2']);
        $(TG).eq(0).find('.pnb-toggle-btn').trigger('click');
        return until(function () { return !F.motion() && box() !== 'COLLEGE = /^(?:Eng)$/ and STATUS = Active'; }, 5000);
      }).then(function () {
        eq('flow: switching it OFF removes only its condition', box(), 'COLLEGE = /^(?:Eng)$/');
        assert('flow: ... the chip stays pressed and the toggle reads OFF', $(S + ' .pnb-fs-chip[data-fs-val="Eng"]').attr('aria-pressed') === 'true' && tsOn(0) === '0',
          $(S + ' .pnb-fs-chip[data-fs-val="Eng"]').attr('aria-pressed') + ' ' + tsOn(0));
        $(TG).eq(1).find('.pnb-toggle-btn').trigger('click');
        return until(function () { return !F.motion() && box() !== 'COLLEGE = /^(?:Eng)$/'; }, 5000);
      }).then(function () {
        eq('flow: the search| toggle still replaces the whole box (unchanged)', box(), 'STATUS = Active');

        // I.4 a series of filter| steps
        $('#tableSearch').val('');
        return draw("toggle_switch('Big Eng', 'on|filter|COLLEGE = Eng', 'on|filter|AMOUNT > 100')");
      }).then(function () {
        $(TG).eq(0).find('.pnb-toggle-btn').trigger('click');
        return until(function () { return !F.motion() && box() === 'COLLEGE = Eng and AMOUNT > 100'; }, 6000);
      }).then(function () {
        eq('series: an ON series of filter| steps adds each condition in order', box(), 'COLLEGE = Eng and AMOUNT > 100');
        assert('series: ... and the toggle reads ON', tsOn(0) === '1', tsOn(0));
        $(TG).eq(0).find('.pnb-toggle-btn').trigger('click');
        return until(function () { return !F.motion() && box() === ''; }, 6000);
      }).then(function () {
        eq('series: the implied OFF series takes them all out again', box(), '');
        assert('series: ... and the toggle reads OFF', tsOn(0) === '0', tsOn(0));

        // I.5 the executor directly (chain() steps go through it too)
        F.exec('filter|COLLEGE = /^(?:Eng|Sci)$/');
        eq('exec: a pipe inside the condition survives (everything after the FIRST pipe)', box(), 'COLLEGE = /^(?:Eng|Sci)$/');
        assert('exec: isActive reads the condition back', F.isActive('filter|COLLEGE = /^(?:Eng|Sci)$/') === true && F.isActive('unfilter|COLLEGE = /^(?:Eng|Sci)$/') === false, '');
        F.exec('unfilter|COLLEGE = /^(?:Eng|Sci)$/');
        eq('exec: unfilter| takes it out', box(), '');
        assert('exec: unfilter| reads active on a box without the condition', F.isActive('unfilter|STATUS = Active') === true, '');
        $('#tableSearch').val('COLLEGE = Eng or FY = 2025');
        assert('exec: on a box holding an or, neither reads active', F.isActive('filter|STATUS = Active') === false && F.isActive('unfilter|STATUS = Active') === false, '');
        F.exec('filter|STATUS = Active');
        return wait(150);
      }).then(function () {
        eq('exec: a filter| step on an or box changes nothing', box(), 'COLLEGE = Eng or FY = 2025');
        assert('exec: ... and says why in a notice', ($('#action_overlay').text() || '').indexOf('cannot add or remove one condition') !== -1, ($('#action_overlay').text() || '').substring(0, 200));
        $('#tableSearch').val('');
        return null;
      });
    });
  }

  function run() {
    var F = window.__FS;
    if (!F || typeof F.state !== 'function' || typeof F.compose !== 'function') {
      report('RESULTS_JSON:' + JSON.stringify({ fatal: 'hooks unavailable: ' + (window.__FS_ERR || 'n/a'), pageErrors: window.__errors.slice(0, 6) }));
      return;
    }
    var FIELDS = [{ label: 'College', col: 'COLLEGE', mode: 'in', top: 12, az: false }, { label: 'Fiscal Year', col: 'FY', mode: 'in', top: 12, az: true }];
    var FIELDS3 = FIELDS.concat([{ label: 'Status', col: 'STATUS', mode: 'in', top: 12, az: false }]);

    // ══════ A. argument parsing ══════
    var a1 = F.parseArgs(['College|COLLEGE', 'Fiscal Year|FY|az']);
    assert('args: two fields parse with defaults', !a1.error && a1.fields.length === 2 && a1.fields[0].label === 'College' && a1.fields[0].col === 'COLLEGE'
      && a1.fields[0].mode === 'in' && a1.fields[0].top === 12 && a1.fields[0].az === false && a1.fields[1].az === true, JSON.stringify(a1));
    var a2 = F.parseArgs(['wide', 'College|COLLEGE', 'Small']);
    eq('args: bare words are keywords, case-forgiven, deduped', !a2.error && a2.mods, ['wide', 'small']);
    var a3 = F.parseArgs(['sideways', 'College|COLLEGE']);
    assert('args: an unknown keyword is a loud error naming itself', a3.error && a3.error.indexOf('unknown keyword sideways') !== -1, a3.error);
    assert('args: a field with no column is refused', /needs a column/.test(F.parseArgs(['College|']).error || ''), F.parseArgs(['College|']).error);
    assert('args: a field with no label is refused', /needs a label/.test(F.parseArgs(['|COLLEGE']).error || ''), F.parseArgs(['|COLLEGE']).error);
    assert('args: a column listed twice is refused', /listed twice/.test(F.parseArgs(['A|COLLEGE', 'B|college']).error || ''), '');
    assert('args: keywords alone are refused (at least one field)', /at least one field/.test(F.parseArgs(['wide']).error || ''), '');
    var a8 = F.parseArgs(['Status|STATUS|exclude|top=3', 'X|Y|top=0']);
    assert('args: exclude and top=N options', !a8.error && a8.fields[0].mode === 'ex' && a8.fields[0].top === 3 && a8.fields[1].top === 0, JSON.stringify(a8));
    assert('args: an unknown option is a loud error', /unknown option foo/.test(F.parseArgs(['Status|STATUS|foo']).error || ''), F.parseArgs(['Status|STATUS|foo']).error);
    eq('args: the column is upper-cased', F.parseArgs(['College|college']).fields[0].col, 'COLLEGE');
    eq('args: look, label and alignment keywords become classes', F.parseArgs(['segmented', 'ghost', 'bare', 'labels=top', 'labels=left', 'right', 'center', 'College|COLLEGE']).mods,
      ['segmented', 'ghost', 'bare', 'labels-top', 'labels-left', 'align-right', 'align-center']);
    eq('args: columns=N becomes a cols class; labels=none is the default (no class)', F.parseArgs(['columns=3', 'labels=none', 'College|COLLEGE']).mods, ['cols-3']);
    assert('args: nolabels is not a keyword any more (labels are hidden by default)', /unknown keyword nolabels/.test(F.parseArgs(['nolabels', 'College|COLLEGE']).error || ''), '');
    assert('args: columns out of range is a loud error', /columns=9 is out of range/.test(F.parseArgs(['columns=9', 'College|COLLEGE']).error || ''), F.parseArgs(['columns=9', 'College|COLLEGE']).error);
    assert('args: a prototype name is not a keyword', /unknown keyword constructor/.test(F.parseArgs(['constructor', 'College|COLLEGE']).error || ''), F.parseArgs(['constructor', 'College|COLLEGE']).error);
    assert('args: the unknown-keyword error lists the looks', /segmented/.test(F.parseArgs(['sideways', 'College|COLLEGE']).error || ''), '');

    // ══════ B. encoder / decoder ══════
    eq('enc: plain value untouched', F.enc('Eng'), 'Eng');
    var meta = 'a.b*c+d?e^f$g(h)i|j[k]l{m}n\\o';
    assert('enc: metacharacters are escaped', F.enc(meta).indexOf('a\\.b\\*c\\+d\\?e\\^f\\$g\\(h\\)i\\|j\\[k\\]l\\{m\\}n\\\\o') === 0, F.enc(meta));
