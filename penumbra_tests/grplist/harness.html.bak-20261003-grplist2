<script>
  (function () { try { localStorage.clear(); } catch (e) {} })();
  window.PENUMBRA_THEMES = { 'theme-default': { label: 'Default' } };
  window.PENUMBRA_THEME_IDS = ['theme-default'];
  window.PENUMBRA_THEME_ALIASES = {};
  window.PENUMBRA_LANDING_DEFAULT_THEME = 'theme-default';
  (function () {
    var P = new URLSearchParams(location.search);
    window.__SCN = P.get('scn') || 'boot';
    // --- the fixture (the hiddencols suite's, unchanged) -------------------
    var COLS = [
      'V_ID', 'V_NAME', 'V_AMOUNT', 'V_DATE', 'V_LINK', 'V_STATUS',            // 0-5 visible
      'H_TEXT', 'H_NUM', 'H_MONEY', 'H_DATE', 'H_HTML', 'H_JSON', 'H_ENT',     // 6-12 hidden
      'H_NL', 'H_NULL', 'H_GROUP', 'H_GROUP2', 'H_AMT', 'H_FLAG', 'H_CODE'     // 13-19 hidden
    ];
    window.__COLS = COLS;
    var seed = 20260930;
    function rnd() { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; }
    function pick(a) { return a[Math.floor(rnd() * a.length)]; }
    var W = ['Alpha', 'Bravo', 'Charlie', 'Delta', 'Echo', 'Foxtrot', 'Golf', 'Hotel', 'India', 'Juliet', 'Kilo', 'Lima'];
    function money() { return '$' + (rnd() * 90000 + 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
    function date() { var d = new Date(2021, 0, 1 + Math.floor(rnd() * 1500)); return (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear(); }
    function link() { var id = String(400000 + Math.floor(rnd() * 99999)); return '@@HTML<a href="https://oitras.oit.ncsu.edu/resolver/103?id=' + id + '" target="_new" title="View the project record (requires proper access)" class="resolver-link">' + id + '</a>'; }
    var rows = [];
    for (var i = 1; i <= 300; i++) {
      var r = {};
      r.V_ID = 'ID-' + String(1000 + i);
      r.V_NAME = pick(W) + ' ' + pick(W);
      r.V_AMOUNT = money();
      r.V_DATE = date();
      r.V_LINK = link();
      r.V_STATUS = pick(['Open', 'Closed', 'Pending']);
      r.H_TEXT = pick(W) + ' ' + pick(W) + ' ' + i;
      r.H_NUM = String(Math.floor(rnd() * 1000));
      r.H_MONEY = money();
      r.H_DATE = date();
      r.H_HTML = link();
      var sub = []; for (var k = 0, n = 1 + Math.floor(rnd() * 3); k < n; k++) sub.push({ SUB_ID: 'S' + Math.floor(rnd() * 90), SUB_AMT: Math.floor(rnd() * 5000), SUB_NAME: pick(W) });
      r.H_JSON = (i % 7 === 0) ? null : '@@JSON' + JSON.stringify(sub);
      r.H_ENT = pick(['R&amp;D', 'O&#039;Brien', '&lt;tag&gt;', 'plain', 'A &amp; B &amp; C']);
      r.H_NL = pick(W) + '\n' + pick(W);
      r.H_NULL = (i % 3 === 0) ? null : ((i % 3 === 1) ? '' : pick(W));
      r.H_GROUP = (i % 11 === 0) ? null : pick(['North', 'South', 'East', 'West', 'Central']);
      r.H_GROUP2 = pick(['Tier 1', 'Tier 2', 'Tier 3']);
      r.H_AMT = String(Math.floor(rnd() * 20000) / 100);
      r.H_FLAG = rnd() < 0.3 ? 'Y' : 'N';
      r.H_CODE = pick(['AB', 'CD', 'EF', 'GH']) + '-' + Math.floor(rnd() * 99);
      rows.push(r);
    }
    window.__rowsFixture = rows;
    // The CSV export: one heading line + every row, whatever the layout hides.
    window.__CSV_LINES_EXPECTED = rows.length + 1;
    // --- the scenario's stored report ------------------------------------
    var order = []; for (var c = 0; c < COLS.length; c++) order.push(c);
    var st = {
      name: 'lrfix', query: 'SELECT * FROM LR_FIXTURE', reportTitle: 'Lazy rows fixture',
      theme: 'theme-default', density: 'standard',
      visibleColumns: ['#', 0, 1, 2, 3, 4, 5], columnOrder: order,
      sortCriteria: [], noLimit: true, rowExpandDefault: false, resolverLinksDefault: true,
      rowsPerPage: '200', reportSnippet: ''
    };
    var S = window.__SCN;
    // Every scenario is GROUPED; the nested ones (n*) by two levels. Stored as
    // LIST unless the scenario is about Stacked (layoutonly, widestacked, nstick).
    st.groupBy = /^n/.test(S) ? 'H_GROUP,H_GROUP2' : (S === 'many' ? 'V_NAME' : 'H_GROUP');
    st.groupAgg = { column: 'H_AMT', type: 'sum' };
    if (!/^(layoutonly|widestacked|nstick|nstack)$/.test(S)) st.groupLayout = 'list';   // nstack: probes only
    // The wide scenarios show all 20 columns: more text than the box is wide.
    if (/^wide/.test(S)) { st.visibleColumns = ['#']; for (var v = 0; v < COLS.length; v++) st.visibleColumns.push(v); }
    window.__STORED = st;
    // narrow: the window reads 800px wide until the scenario widens it.
    if (S === 'narrow') {
      window.__FAKEW = 800;
      Object.defineProperty(window, 'innerWidth', { configurable: true, get: function () { return window.__FAKEW; } });
    }
    window.penumbra_vars = {
      isAdmin: true, isGlobalAdmin: true, canEditReport: true, currentUserKey: 'harness', shibboleth: { ouc: '', dept: '' },
      tables: { oracle: [], pins: [], infoed: [], hr: [], fin: [] },
      imports: [], reports: [], themes: {}, prompts: {}, grants: [],
      totalExemptions: ['AMOUNT', 'H_AMT', 'H_NUM'],
      preloadedState: st
    };
    window.__queryResponse = { data: rows };
  })();
  window.__T = {};
  window.__queryDone = 0;
  window.__ajaxLog = [];
</script>
