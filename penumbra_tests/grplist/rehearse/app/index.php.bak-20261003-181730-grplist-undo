            <?php
            // System health (admins) - FIRST in the rail, above the email/info
            // blocks: a degraded scheduler or unreachable database outranks
            // "arriving by email".
            // Shown ONLY when something is wrong - a healthy system earns no
            // pixels here, matching the rail's "blocks earn their pixels" rule.
            // The full picture is always at health.php. Scheduler 'paused' is
            // deliberate, so it is flagged amber rather than red.
            $pnlHealthBad = array();
            if ($isAdmin && is_array($pnl_health)) {
                $pnlHs = isset($pnl_health['components']['scheduler']['status']) ? $pnl_health['components']['scheduler']['status'] : 'unknown';
                if ($pnlHs !== 'online') {
                    /* The note used to be "no heartbeat in Ns" for everything
                       that was not online, and N came from a seconds_ago that
                       is 0 whenever the row was never read - so the one case
                       where the rail knew least stated it most precisely, as
                       "no heartbeat in 0s". Each status now says only what it
                       actually establishes, and only a confirmed dead runner
                       is red. */
                    $pnlSecs = isset($pnl_health['components']['scheduler']['seconds_ago'])
                             ? (int)$pnl_health['components']['scheduler']['seconds_ago'] : null;
                    if ($pnlHs === 'paused') {
                        $pnlNote = 'paused on purpose';
                    } elseif ($pnlHs === 'blocked') {
                        $pnlNote = 'running, but cannot reach the database to record';
                    } elseif ($pnlHs === 'unknown') {
                        $pnlNote = 'could not be checked';
                    } else {
