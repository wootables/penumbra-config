<script>
(function () {
    // Lazy-load the shared form module (JS + CSS) on first use, so it never
    // weighs on the initial page load. Rendered GLOBALLY (outside the landing
    // block) so [data-pf-open] triggers fire everywhere they appear -- the
    // landing dock/footer AND the "Bugs? Problems? Suggestions?" link in the
    // Help Center on report/state views. Progressive enhancement: each trigger
    // keeps its mailto href as a no-JS fallback; we intercept the click and open
    // the in-place modal instead. If the module fails to load we fall back to
    // the mailto so the user is never stuck.
    var _pfAssets = window.PENUMBRA_FORMS_ASSETS ||
        { js: 'js/penumbra_forms.js', css: 'css/penumbra_forms.css' };
    var jsUrl  = _pfAssets.js;
    var cssUrl = _pfAssets.css;
    // $pnl_*_mailto exist only inside the landing block; on report/state views
    // they are unset, so fall back to a simple mailto for the rare module-load
    // failure path.
    var mailtos = {
        request:  <?php echo json_encode(isset($pnl_req_mailto) ? $pnl_req_mailto : 'mailto:bplimon@ncsu.edu?subject=' . rawurlencode('Penumbra Report Request')); ?>,
        feedback: <?php echo json_encode(isset($pnl_fb_mailto) ? $pnl_fb_mailto : 'mailto:bplimon@ncsu.edu?subject=' . rawurlencode('Penumbra Feedback')); ?>
    };
    var state = 0; // 0 = unloaded, 1 = loading, 2 = ready
    var pending = null;

    function flush() {
        if (state === 2 && pending && window.PenumbraForms) {
            var id = pending; pending = null;
            window.PenumbraForms.open(id);
        }
    }
    function ensure() {
        if (state === 2) { flush(); return; }
        if (state === 1) { return; }
        state = 1;
        var link = document.createElement('link');
        link.rel = 'stylesheet'; link.href = cssUrl;
        document.head.appendChild(link);
        var s = document.createElement('script');
        s.src = jsUrl;
        s.onload = function () { state = 2; flush(); };
        s.onerror = function () {
            state = 0;
            if (pending && mailtos[pending]) { window.location.href = mailtos[pending]; }
            pending = null;
        };
        document.head.appendChild(s);
    }

    document.addEventListener('click', function (e) {
        var t = e.target;
        while (t && t !== document) {
            if (t.nodeType === 1 && t.hasAttribute('data-pf-open')) { break; }
            t = t.parentNode;
        }
        if (!t || t === document) { return; }
        e.preventDefault();
        pending = t.getAttribute('data-pf-open');
        ensure();
    }, false);
})();
</script>

