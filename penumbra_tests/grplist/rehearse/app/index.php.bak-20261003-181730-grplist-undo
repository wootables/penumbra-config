<script>
(function () {
    // Theme the splash with the same resolution main.js will use at ready:
    // URL ?theme= > landing pref ('report-default' sentinel = stock default)
    // > global user default. PENUMBRA_THEMES is emitted in <head>.
    var el = document.getElementById('pnlSplash');
    if (!el || !window.PENUMBRA_THEMES) return;
    var themeId = null, forceDefault = false;
    try { themeId = new URLSearchParams(location.search).get('theme'); } catch (e) {}
    if (!themeId) {
        try {
            var prefs = JSON.parse(localStorage.getItem('penumbra_pref_theme') || '{}');
            if (Object.prototype.hasOwnProperty.call(prefs, '__landing__')) {
                if (prefs['__landing__'] === 'report-default') forceDefault = true;
                else themeId = prefs['__landing__'];
            }
        } catch (e) {}
        if (!themeId && !forceDefault) themeId = localStorage.getItem('penumbra_user_theme');
    }
    // No URL theme, no home-screen override, no global default (or the
    // 'report-default' sentinel = "use the app default here"): the home screen
    // defaults to Wolfpack Red, matching main.js's landing resolution.
    if (!themeId) themeId = window.PENUMBRA_LANDING_DEFAULT_THEME || 'theme-default';
    var row = PENUMBRA_THEMES[themeId] || PENUMBRA_THEMES['theme-default'] || {};
    var v = row.vars || {};
    var bg = v['bg-body'] || '#f4f4f4';
    el.style.backgroundColor = bg;
    el.style.backgroundImage = 'radial-gradient(circle at 50% 38%, ' + (v['bg-surface'] || '#fff') + ' 0%, ' + bg + ' 72%)';
    el.style.color = v['text-main'] || '#333';
    var sp = document.getElementById('pnlSplashSpin');
    if (sp) {
        sp.style.borderColor = row.isDark ? 'rgba(255,255,255,.18)' : 'rgba(0,0,0,.12)';
        sp.style.borderTopColor = v['brand-primary'] || '#336699';
    }
})();
</script>
