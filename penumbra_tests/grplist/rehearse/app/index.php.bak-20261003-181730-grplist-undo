<?php
require_once 'db_connection.php';
require_once 'themes_config.php'; // single source of theme truth (registry + emitters)
// --- REMOVED 2026-07-05: DEV_API "trusted IP" rescue ---
// This block used to set $currentUserKey='DEV_API' (an admin identity in allowed_users) for
// ANY request from a single hardcoded IP (10.136.131.236) with ?json=1. That IP is long
// dead, but it was a latent admin backdoor - an IP reassignment, or a naive "fix" pointing
// it at the SP proxy, would have handed admin to unauthenticated callers. Identity now comes
// ONLY from the Shibboleth KDUSER path gated in db_connection.php. See the KDUSER gate.

// --- ACCESS CONTROL: JSON ONLY MODE ---
// Restrict to JSON-only output when there is no authenticated user OR the request did not
// arrive via the www3 SP proxy. (Identity itself is governed by db_connection's KDUSER gate;
// this only decides HTML-vs-JSON output.)
$referrer = isset($_SERVER["HTTP_X_FORWARDED_SERVER"]) ? $_SERVER["HTTP_X_FORWARDED_SERVER"] : '';
$isRestrictedJsonMode = empty($currentUserKey) || 
                        (strpos($referrer, 'www3.acs.ncsu.edu') === false);

if ($isRestrictedJsonMode) {
    // If restricted, STRICTLY require json=1. Return error otherwise.
    if (!isset($_GET['json']) || $_GET['json'] != 1) {
        header('Content-Type: application/json');
        die(json_encode(["error" => "Invalid API key. Access Logged."]));
    }
}

// --- MAINTENANCE MODE GATE (2026-08-18) ---
// Placed here deliberately: after identity + the JSON-mode decision (so the
// answer can be shaped correctly for API callers) but BEFORE any report lookup
// or query execution, which is the expensive work maintenance exists to stop.
//
// Admins are never blocked. Note that &noadm makes an admin non-admin, which is
// how you TEST this page without a second account - and is undone by dropping
// the parameter, so it cannot strand you.
//
// penumbra_notice.php reads a FILE, not the database, so this gate still works
// during the DB outage you are most likely to be doing maintenance for. Every
// ambiguity there (missing/corrupt/expired state) resolves to "not blocking".
require_once 'penumbra_notice.php';
if (penumbra_maintenance_blocks($isAdmin)) {
    $pnbMaint = penumbra_active_maintenance();
    $pnbMaintMsg = ($pnbMaint && $pnbMaint['message'] !== '')
        ? $pnbMaint['message']
        : 'Penumbra is temporarily unavailable for scheduled maintenance.';
    $pnbMaintUntil = $pnbMaint ? date('g:ia \o\n D j M', $pnbMaint['until']) : '';

    if (isset($_GET['json']) && $_GET['json'] == 1) {
        header('Content-Type: application/json');
        http_response_code(503);
        header('Retry-After: 1800');
        die(json_encode(array('error' => $pnbMaintMsg, 'error_code' => 'maintenance',
                              'until' => $pnbMaint ? (int)$pnbMaint['until'] : 0)));
    }

    // 503 + Retry-After, not 200: monitors and crawlers must read this as "down
    // on purpose, come back", never as the real site.
    http_response_code(503);
    header('Retry-After: 1800');
    header('Content-Type: text/html; charset=utf-8');
    $pnbEsc = function ($s) { return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); };
    ?><!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Penumbra - Maintenance</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 15px/1.6 "Segoe UI", system-ui, sans-serif; margin: 0; min-height: 100vh;
         display: flex; align-items: center; justify-content: center; background: #f4f4f4; color: #222; }
  .box { max-width: 520px; padding: 36px 40px; background: #fff; border: 1px solid #ddd;
         border-radius: 10px; text-align: center; margin: 20px; }
  .mark { width: 46px; height: 46px; border-radius: 50%; background: #990000; color: #fff;
          font-weight: 700; font-size: 22px; line-height: 46px; margin: 0 auto 16px; }
  h1 { font-size: 20px; margin: 0 0 10px; }
  p { margin: 0 0 10px; }
  .until { font-weight: 600; }
  .foot { color: var(--text-muted); font-size: 13px; margin-top: 18px; }
  @media (prefers-color-scheme: dark) {
    body { background: #1c1c1c; color: #e6e6e6; }
    .box { background: #262626; border-color: #3a3a3a; }
  }
</style></head>
<body>
  <div class="box">
    <div class="mark" aria-hidden="true">P</div>
    <h1>Penumbra is down for maintenance</h1>
    <p><?php echo $pnbEsc($pnbMaintMsg); ?></p>
    <?php if ($pnbMaintUntil !== ''): ?>
      <p class="until">Expected back by <?php echo $pnbEsc($pnbMaintUntil); ?>.</p>
    <?php endif; ?>
    <p class="foot">Scheduled report emails are unaffected and will still be delivered.</p>
  </div>
</body></html><?php
    exit;
}

// --- REPOSITORY PAGE MODE (2026-08-19) ---
// repository.php is a 3-line wrapper that defines PENUMBRA_REPO_MODE and
// includes this file. In this mode index.php renders the sticky admin-tools
// header (penumbra_admin_chrome.php) and docks the EXISTING repository
// lightbox (#openReportListLightbox) as the page content - the landing, the
// report header and the console are all suppressed. One engine, two
// presentations; see js/penumbra_repository.js.
$isRepoMode = defined('PENUMBRA_REPO_MODE');
if ($isRepoMode) {
    if (!$isAdmin) {
        // Global-admin only, same rule as the lightbox markup below. &noadm
        // also lands here (it de-admins you), which is correct for testing.
        header('Location: index.php');
        exit;
    }
    if (isset($_GET['id']) || isset($_GET['state'])) {
        // A report deep-link has no business on the repository page - hand it
        // to the console with its query string intact.
        header('Location: index.php?' . http_build_query($_GET));
        exit;
    }
}
// Unconditional (not repo-mode only): penumbra_admin_tools() is the ONE
// registry of admin tool links - the home dock's admin band and the repo-mode
// header both render from it, so a new tool added there appears everywhere.
require_once 'penumbra_admin_chrome.php';

// &noheader - render the header in its collapsed (F2) state from the very first
// paint. The .is-collapsed class is applied server-side to both
// #reportHeaderContainer and #headerToggleHandle so the header is zero-height
// before the browser paints the page. No visibility flash at any time.
$noHeader = isset($_GET['noheader']);


// --- PER-REPORT POWER-USER ROLE ---
// A non-admin who holds a report grant matching the loaded report gets the
// builder console for THAT report. The server still enforces sql-scope on
// save/run (query.php / save_server_state.php), and GLOBAL admin features
// (repository, analytics, DDL) stay $isAdmin-only. $canScheduleLoadedReport
// additionally requires the grant's optional 'scheduler' verb.
//
// &noadm previews the page as a plain viewer (db_connection.php clears $isAdmin
// for it), so report ownership and report grants stop conferring EDITOR rights
// as well: no console, View Options or their outlines, save, version history,
// ?asof=, scheduler tab or Owner pill. They still authorize VIEWING the report
// ($pnbViewByRole below; query.php's view check agrees), so an author can
// preview a report before opening its access list, and dashboard embed tiles
// (which always carry &noadm) keep showing an owner's own reports.
$pnbEditorRolesOn = !$noadm;
$loadedShortId = (isset($_GET['id']) && $_GET['id'] !== '') ? $_GET['id'] : '';
$canEditLoadedReport = $isAdmin || ($pnbEditorRolesOn && $loadedShortId !== '' && penumbraReportGrantMatches($userGrants, $loadedShortId));
$canScheduleLoadedReport = $isAdmin || ($pnbEditorRolesOn && $loadedShortId !== '' && penumbraReportGrantAllowsScheduler($userGrants, $loadedShortId));

// 'admin-view' drives the builder chrome (and the show/hide toggle button), so
// give it to any editor. 'scoped-editor' marks a non-admin editor for optional CSS.
$admin_class = $canEditLoadedReport ? 'admin-view' : '';
if ($canEditLoadedReport && !$isAdmin) { $admin_class .= ' scoped-editor'; }
// Repo page never shows the console - drop the class server-side so there is
// no admin-view flash before main.js forces the console closed.
if ($isRepoMode) { $admin_class = ''; }


// Dynamic date keywords in prompt values are resolved by
// resolveParamDateExpression() in shared_logic.php - the single resolver shared
// by all three tag-resolving entry points (query.php, index.php,
// schedule_runner.php). A private SYSDATE-only copy used to live here; it
// understood neither the fiscal-year grammar nor natural-language phrases like
// "first day of last month", so a ?json=1 run of any report whose prompt carried
// such a default injected the phrase into the SQL verbatim (ORA-01858). Resolve
// prompt values through the shared function instead of re-growing a copy here.

// Authorization helpers (checkAuthorization / extractAuthIdentifier) live in
// report_auth.php - the single source of truth shared by index.php, query.php,
// analytics.php and get_audit_log.php, so the "may this user view this report?"
// rule stays identical everywhere. report_auth.php guards each function with
// function_exists(), so including it here is safe even if a copy already exists.
require_once 'report_auth.php';
require_once 'cron_describe.php'; // shared cron -> plain-English for the subscriptions payload
$preloaded_state_json = 'null'; // Default to JS null
$preloaded_authorized_list = 'adminonly';
$pnb_subscriptions = null;      // Header Subscribe button payload (set when a loaded report has subscribable schedules)
// Report Journal note counts for the loaded report ({installed, total, unseen}),
// or null when nobody on this page will read them. Filled in the authorized ?id=
// branch below, on the connection that branch already holds - the toolbar badge
// used to cost a separate manage_journal.php round trip on every boot.
$pnb_journal = null;
// Will manage_journal.php answer this user for the loaded report? The journal
// peek needs it on top of the editor flag (set in the authorized ?id= branch).
$pnbJrnAccess = false;
// data(lastaccess): seconds since this user's PREVIOUS 'OPEN' of the loaded
// report, -1 when they have never opened it (or there is no loaded report /
// no identity). Filled in the authorized ?id= branch below.
$pnbLastAccess = -1;
// ?asof=<audit id> version preview (see the block after the STATE_DATA read).
// $pnbAsOf is the accepted version's identity for the status-bar chip; when the
// request named a version we could NOT honor, $pnbAsOfError says why. Both stay
// null on an ordinary load, and the chip renders on neither.
$pnbAsOf = null;
$pnbAsOfError = null;

// --- ?snap= DEEP LINK WITHOUT ?id= ---
// A server-snapshot link is meaningful on its own (the snap row knows its
// parent report), so resolve the parent and redirect to the canonical id+snap
// URL before any output. This does NOT grant access - the normal report-auth
// path below and manage_snapshots.php (action=load) still gate everything.
// Uses connectOracle() directly: getConnectionForTable()'s whitelist is
// report-scoped and empty when no report is loaded (same reason the landing
// pulse does). local|<ts> references live in browser storage and can't be
// resolved server-side; those fall through to the home screen untouched.
if (!$isRestrictedJsonMode && !isset($_GET['id']) && !isset($_GET['state'])
    && isset($_GET['snap']) && ctype_digit((string)$_GET['snap'])) {
    try {
        $snapResolveConn = connectOracle();
        if ($snapResolveConn) {
            $snapStmt = $snapResolveConn->prepare(
                "SELECT TRIM(r.SHORT_ID) AS SHORT_ID
                   FROM PENUMBRA_SNAPS s
                   JOIN PENUMBRA_REPORTS r ON s.REPORT_ID = r.ID
                  WHERE s.ID = :sid"
            );
            $snapStmt->bindValue(':sid', (int)$_GET['snap'], PDO::PARAM_INT);
            $snapStmt->execute();
            $snapRow = $snapStmt->fetch(PDO::FETCH_ASSOC);
            if ($snapRow && !empty($snapRow['SHORT_ID'])) {
                $snapQs = $_GET;
                $snapQs['id'] = $snapRow['SHORT_ID'];
                header('Location: index.php?' . http_build_query($snapQs));
                exit;
            }
        }
    } catch (Exception $e) { /* fall through to the normal (home) render */ }
}

if (isset($_GET['id']) && !empty($_GET['id'])) {
    try {
        $report_id = $_GET['id'];
        // Trimmed copy for the two DB lookups below. Kept separate rather than
        // reassigning $report_id, which is used further down for subscriptions and
        // the preloaded payload - this changes how the report is FOUND, nothing else.
        $report_id_lookup = trim((string)$report_id);
        $oracleConn = getConnectionForTable('DUAL'); 
        if ($oracleConn) {
            // TRIM(SHORT_ID), like the ~30 other lookups in the app. This one and the
            // readClobViaOci8 below were the only two comparing the raw column, so a
            // value with stray whitespace would resolve here but miss there (or vice
            // versa) - the report would authorize and then load with no state, which
            // is exactly the class of bug restore_server_report.php carries FIX notes
            // about. Aligned 2026-08-10.
            $sql = "SELECT OWNER_ID, AUTHORIZED 
                    FROM PENUMBRA_REPORTS 
                    WHERE TRIM(SHORT_ID) = :report_id";
            $stmt = $oracleConn->prepare($sql);
            $stmt->bindValue(':report_id', $report_id_lookup, PDO::PARAM_STR); 
            $stmt->execute();
            $report_data = $stmt->fetch(PDO::FETCH_ASSOC); 
            
            if ($report_data) {
                $authorized_list = $report_data['AUTHORIZED'];
                $preloaded_authorized_list = $authorized_list;
                $owner_id = $report_data['OWNER_ID'];

                // OWNER == report-grant-equivalent (design choice, 2026-07-03):
                // whoever owns a report can always view + edit it in the builder,
                // keeping this consistent with query.php / save / delete (which
                // already honor owner). It does NOT confer scheduling (a separate
                // verb) or creation (owner applies to one existing report). A
                // non-admin owner gets the page an admin gets, View Options
                // outlines included (penumbra_vars.isAdmin is this flag). Not under
                // &noadm, where the owner is previewing the viewer's page.
                if ($pnbEditorRolesOn && !$canEditLoadedReport && penumbraIsReportOwner($owner_id, $currentUserKey)) {
                    $canEditLoadedReport = true;
                    $admin_class = 'admin-view' . ($isAdmin ? '' : ' scoped-editor');
                }
                // Under &noadm ownership and a matching report grant still let the
                // report OPEN, as a viewer would get it (see $pnbEditorRolesOn).
                $pnbViewByRole = !$pnbEditorRolesOn
                    && (penumbraIsReportOwner($owner_id, $currentUserKey)
                        || ($loadedShortId !== '' && penumbraReportGrantMatches($userGrants, $loadedShortId)));

                if ($canEditLoadedReport || $pnbViewByRole || checkAuthorization($authorized_list, $currentUserKey, $user_ouc)) {
                    // Read CLOB via OCI8 to avoid PDO's 4000-byte buffer corruption
                    // TRIM(SHORT_ID) to match the authorization lookup above and every
                    // other reader (query.php, report_auth.php, schedule_runner.php).
                    $preloaded_state_json = readClobViaOci8('PENUMBRA_REPORTS', 'STATE_DATA', 'TRIM(SHORT_ID)', $report_id_lookup);

                    // --- ?asof=<audit id>: BOOT THIS REPORT AS IT WAS AT ONE VERSION ---
                    // A read-only preview. The swap happens HERE, before anything downstream
                    // reads the state, so penumbraExtractReportTables (~1045),
                    // penumbra_vars.preloadedState (~1112) and the entire client boot pick it
                    // up with no second code path and no deferred boot. Version History's
                    // "Copy link" still points at the DIFF; this is the separate
                    // "open the report as it was" action.
                    //
                    // Deliberately narrow:
                    //   - EDITORS ONLY. $canEditLoadedReport is resolved above and already
                    //     includes the owner promotion, so this is admin OR owner OR a
                    //     matching report grant (none of them under &noadm) - the set
                    //     get_audit_data.php's $auditReadAllowed admits for THIS report.
                    //     Audit snapshots are authoring data; a merely-authorized viewer
                    //     must not read them through a new door.
                    //   - The audit row must belong to THIS report. That is what keeps report
                    //     A's page from rendering report B's state, and it is why the gate
                    //     above can be the simple editor check instead of a second copy of
                    //     the owner/grant closure.
                    //   - UPDATE/ROLLBACK/CREATE only. Scheduler rows hold task snapshots and
                    //     RENAME holds {short_id}; neither is a report state (same exclusions
                    //     get_audit_data.php's restore path makes, for the same reason).
                    //
                    // Anything unreadable, unparseable, or mismatched FALLS BACK to the live
                    // state with $pnbAsOfError set. Booting silently-live off a URL that asked
                    // for a version is the one outcome that could get someone to save over the
                    // wrong thing, so the chip has to be able to say why it didn't happen.
                    $pnbAsOfId = (isset($_GET['asof']) && ctype_digit((string)$_GET['asof'])) ? (int)$_GET['asof'] : 0;
                    if ($pnbAsOfId > 0 && !$canEditLoadedReport) {
                        $pnbAsOfError = 'Viewing an earlier version is available to this report\'s editors only.';
                    } elseif ($pnbAsOfId > 0) {
                        try {
                            $asofStmt = $oracleConn->prepare(
                                "SELECT a.ACTION,
                                        TO_CHAR(a.TIMESTAMP, 'DD-MON-YYYY HH:MI:SS AM') AS AUDIT_TIME,
                                        a.USER_ID,
                                        TRIM(r.SHORT_ID) AS SHORT_ID
                                   FROM PENUMBRA_AUDIT a
                                   LEFT JOIN PENUMBRA_REPORTS r ON a.REPORT_ID = r.ID
                                  WHERE a.ID = :aid AND a.ACTION IN ('UPDATE','ROLLBACK','CREATE')"
                            );
                            $asofStmt->bindValue(':aid', $pnbAsOfId, PDO::PARAM_INT);
                            $asofStmt->execute();
                            $asofRow = $asofStmt->fetch(PDO::FETCH_ASSOC);

                            if (!$asofRow) {
                                $pnbAsOfError = 'That version no longer exists, or it is not a saved report state.';
                            } elseif (trim((string)$asofRow['SHORT_ID']) !== $report_id_lookup) {
                                // Belongs to a different report. Never render it here.
                                $pnbAsOfError = 'That version belongs to a different report.';
                            } else {
                                // CREATE captures its state in AFTER (nothing preceded it);
                                // every other action's "this version" is the BEFORE side -
                                // the same snapshot the Restore button writes back, so the
                                // preview and the restore can never disagree about which
                                // state a version IS.
                                $asofCol  = ($asofRow['ACTION'] === 'CREATE') ? 'AFTER' : 'BEFORE';
                                $asofClob = readClobViaOci8('NC_REPORTING.PENUMBRA_AUDIT', '"' . $asofCol . '"', 'ID', $pnbAsOfId);
                                $asofWrap = ($asofClob === null) ? null : json_decode($asofClob, true);

                                if (!is_array($asofWrap) || !isset($asofWrap['report'])) {
                                    $pnbAsOfError = 'That version\'s saved state could not be read.';
                                } else {
                                    // save_server_state.php stores 'report' as a decoded array
                                    // when the state parsed, and as the RAW STRING when it did
                                    // not - which is exactly the encrypted case, where
                                    // STATE_DATA is a PENUMBRA_GCM:: ciphertext rather than
                                    // JSON. A ciphertext has no keys to merge, so the two
                                    // shapes take different paths and a MIXED pair is refused
                                    // rather than guessed at.
                                    $asofState = $asofWrap['report'];
                                    $liveState = json_decode((string)$preloaded_state_json, true);

                                    if (is_array($asofState) && is_array($liveState)) {
                                        // Union with the version on the LEFT: its keys win,
                                        // and any key the version predates keeps its live
                                        // value instead of vanishing. (`+`, not array_merge:
                                        // the union operator preserves keys as-is rather than
                                        // renumbering integer ones.)
                                        $asofMerged = $asofState + $liveState;
                                        $asofJson   = json_encode($asofMerged);
                                        // Malformed UTF-8 anywhere in the snapshot makes this
                                        // false; assigning that would blank the report's whole
                                        // state client-side. Fall back to live instead.
                                        if ($asofJson === false) {
                                            $pnbAsOfError = 'That version\'s saved state could not be re-encoded.';
                                        } else {
                                            $preloaded_state_json = $asofJson;
                                        }
                                    } elseif (is_string($asofState) && !is_array($liveState)) {
                                        // Encrypted both then and now: substitute wholesale and
                                        // let the client prompt for the password as it always does.
                                        $preloaded_state_json = $asofState;
                                    } else {
                                        $pnbAsOfError = 'That version cannot be previewed: the report\'s encryption changed between then and now.';
                                    }

                                    if ($pnbAsOfError === null) {
                                        $pnbAsOf = array(
                                            'auditId' => $pnbAsOfId,
                                            'action'  => $asofRow['ACTION'],
                                            'when'    => $asofRow['AUDIT_TIME'],
                                            'who'     => $asofRow['USER_ID']
                                        );
                                        // WHAT THE PREVIEW ADDS THAT A RESTORE WOULD NOT.
                                        // This page merges (version keys win, keys the
                                        // version predates keep their LIVE value), but
                                        // "Restore this version" writes the snapshot
                                        // WHOLESALE - so any key carried from live here
                                        // would be REMOVED by a restore. Two different
                                        // and defensible rules, sitting one button apart:
                                        // name the difference rather than let the preview
                                        // quietly over-promise.
                                        if (is_array($asofState) && is_array($liveState)) {
                                            $pnbAsOfCarried = array_values(array_diff(
                                                array_keys($liveState), array_keys($asofState)
                                            ));
                                            if ($pnbAsOfCarried) {
                                                sort($pnbAsOfCarried);
                                                $pnbAsOf['carried'] = array_slice($pnbAsOfCarried, 0, 12);
                                                $pnbAsOf['carriedCount'] = count($pnbAsOfCarried);
                                            }
                                        }
                                    }
                                }
                            }
                        } catch (Exception $asofEx) {
                            error_log('PENUMBRA ASOF: ' . $asofEx->getMessage());
                            $pnbAsOfError = 'That version could not be loaded.';
                        }
                    }

                    // --- data(lastaccess): SECONDS SINCE THIS USER'S PREVIOUS OPEN ---
                    // Read HERE, at page render, which is what makes "excluding now"
                    // exact and free: query.php writes THIS visit's OPEN row from the
                    // report's own query POST, which has not happened yet - so MAX()
                    // is genuinely the PREVIOUS visit. Anything computed later (or in
                    // the client) would have to subtract the current visit back out.
                    //
                    // -1 = never opened by this user before (first visit). It is a
                    // NUMBER rather than '' / 'never' so authors only ever handle one
                    // type: case(data(lastaccess) < 0, 'Welcome!', ...) reads as well
                    // as case(data(lastaccess) > 604800, 'Been a while', ...).
                    // Anonymous / unauthenticated requests also get -1.
                    //
                    // The subtraction is done in ORACLE, not PHP, so the web tier's
                    // clock and timezone never enter into it. CAST(... AS DATE) drops
                    // sub-second precision from the TIMESTAMP column, which is fine at
                    // this resolution and keeps the arithmetic in plain DATE days.
                    $pnbLastAccess = -1;
                    if (!empty($currentUserKey)) {
                        try {
                            // :usr, NOT :uid - UID is an Oracle built-in and binding
                            // to that name is an ORA-01745 "invalid host/bind variable
                            // name". It fails at prepare() time, so the whole lookup
                            // silently returned "never visited" until the error_log
                            // below made it visible.
                            $pnbLaStmt = $oracleConn->prepare(
                                "SELECT ROUND((SYSDATE - CAST(MAX(a.TIMESTAMP) AS DATE)) * 86400) AS SECS
                                   FROM PENUMBRA_AUDIT a
                                   JOIN PENUMBRA_REPORTS r ON a.REPORT_ID = r.ID
                                  WHERE TRIM(r.SHORT_ID) = :rid
                                    AND a.USER_ID = :usr
                                    AND a.ACTION = 'OPEN'");
                            $pnbLaStmt->bindValue(':rid', $report_id_lookup, PDO::PARAM_STR);
                            $pnbLaStmt->bindValue(':usr', (string)$currentUserKey, PDO::PARAM_STR);
                            $pnbLaStmt->execute();
                            $pnbLaRow = $pnbLaStmt->fetch(PDO::FETCH_ASSOC);
                            // MAX() over zero rows returns one row with a NULL SECS -
                            // that is the never-visited case, not an error.
                            if ($pnbLaRow && $pnbLaRow['SECS'] !== null) {
                                // Clamp at 0: a clock skew between the DB write and
                                // SYSDATE must never surface as a negative age, which
                                // would read as "first visit" to every author's test.
                                $pnbLastAccess = max(0, (int)$pnbLaRow['SECS']);
                            }
                        } catch (Exception $pnbLaEx) {
                            // Stays -1; a snippet key is never worth a failed page. But
                            // LOG it - a silent catch here is indistinguishable from
                            // "this user has never visited", which is exactly how the
                            // ORA-01745 above went unnoticed.
                            error_log('PENUMBRA data(lastaccess) lookup failed: ' . $pnbLaEx->getMessage());
                        }
                    }

                    // --- JOURNAL BADGE: note counts for the loaded report ---
                    // Piggybacked on THIS already-open connection on purpose. The
                    // toolbar badge used to come from a separate
                    // manage_journal.php?action=summary request fired at boot, which
                    // paid a whole PHP bootstrap plus a FRESH ORACLE LOGON for two
                    // small queries - db_connection.php uses oci_connect, not
                    // oci_pconnect, so every request is a full logon and that is the
                    // dominant cost, not the SQL. Computed here it is one aggregate on
                    // a session already paid for, and the client has the counts before
                    // it paints instead of one round trip later. refreshJournalBadge()
                    // survives in main.js for the AFTER-mutation refreshes (add,
                    // delete, mark_seen, bulk), where the numbers really have changed.
                    //
                    // Skipped unless somebody will actually READ it: a viewer of a
                    // journal-enabled report, or one of this report's editors the
                    // journal API also answers (an admin, its owner, or a report-grant
                    // holder on its access list, who sees the dotted "off, but
                    // available to you" journal button on it; nobody under &noadm,
                    // which clears the editor flag). That keeps the common
                    // case - a viewer opening a report with no journal - at exactly
                    // the zero queries it costs today. The state JSON is already in
                    // memory from the STATE_DATA read above, so the pre-filter is a
                    // strpos, not a decode: the same trick the subscriptions block
                    // below uses to spot "encrypted".
                    //
                    // `enabled` rides along for a second reason: main.js used to
                    // learn "is the journal on for this report?" only from the async
                    // state restore, which lands AFTER first paint. With the admin
                    // peek that meant an admin loading a journal-ON report saw the
                    // button flash amber-dashed ("off, available to you") for a beat
                    // before the restore corrected it. Seeding the flag from here
                    // kills the flash; the restore still re-asserts it from the
                    // decoded state, which stays the source of truth.
                    $pnbJrnEnabled = strpos((string)$preloaded_state_json, '"journalEnabled":true') !== false
                        || strpos((string)$preloaded_state_json, '"journalEnabled": true') !== false;
                    // manage_journal.php's journalCallerCanView, term for term: an
                    // admin, the owner, a report grant (since 2026-10-02 - before, a
                    // grant holder missing from the access list got the J button and
                    // every request the panel made was refused) or the access list.
                    // This page's $isAdmin, so &noadm previews it too; the grant term
                    // is a VIEW term and stays on under &noadm, as $pnbViewByRole does.
                    $pnbJrnAccess = $isAdmin || penumbraIsReportOwner($owner_id, $currentUserKey)
                        || ($loadedShortId !== '' && is_array($userGrants) && penumbraReportGrantMatches($userGrants, $loadedShortId))
                        || checkAuthorization($authorized_list, $currentUserKey, $user_ouc);
                    $pnbJrnWanted = ($canEditLoadedReport && $pnbJrnAccess) || $pnbJrnEnabled;
                    if ($pnbJrnWanted && !empty($currentUserKey)) {
                        try {
                            // :usr / :usr2, never :uid - UID is an Oracle built-in and
                            // binding that name is ORA-01745 at prepare() time (the
                            // same trap the lastaccess query above carries a note for).
                            // Two names for one value because the summary endpoint this
                            // mirrors does the same: distinct placeholders per position.
                            $pnbJrnStmt = $oracleConn->prepare(
                                "SELECT COUNT(j.ID) AS TOTAL,
                                        SUM(CASE WHEN j.CREATED_BY <> :usr
                                                  AND (s.LAST_SEEN IS NULL OR j.CREATED_AT > s.LAST_SEEN)
                                             THEN 1 ELSE 0 END) AS UNSEEN
                                   FROM PENUMBRA_REPORTS r
                                   JOIN PENUMBRA_JOURNAL j ON j.REPORT_ID = r.ID
                                   LEFT JOIN PENUMBRA_JOURNAL_SEEN s
                                     ON s.REPORT_ID = j.REPORT_ID AND s.USER_ID = :usr2
                                  WHERE TRIM(r.SHORT_ID) = :rid");
                            $pnbJrnStmt->bindValue(':usr',  (string)$currentUserKey, PDO::PARAM_STR);
                            $pnbJrnStmt->bindValue(':usr2', (string)$currentUserKey, PDO::PARAM_STR);
                            $pnbJrnStmt->bindValue(':rid',  $report_id_lookup, PDO::PARAM_STR);
                            $pnbJrnStmt->execute();
                            $pnbJrnRow = $pnbJrnStmt->fetch(PDO::FETCH_ASSOC);
                            // Aggregates over zero matching notes still return ONE row:
                            // TOTAL 0 and a NULL UNSEEN. That is "no notes yet", not a
                            // failure, so it must not fall through to the catch.
                            $pnb_journal = array(
                                'installed' => true,
                                'enabled'   => $pnbJrnEnabled,
                                'total'     => $pnbJrnRow ? (int)$pnbJrnRow['TOTAL'] : 0,
                                'unseen'    => ($pnbJrnRow && $pnbJrnRow['UNSEEN'] !== null) ? (int)$pnbJrnRow['UNSEEN'] : 0
                            );
                        } catch (Exception $pnbJrnEx) {
                            // ORA-00942 = the journal tables were never created in this
                            // environment (Phase 1 install is a manual DDL step, since
                            // ORIED_RO cannot CREATE). That is a legitimate state, not
                            // an error: report installed=false so the client hides the
                            // button for non-admins exactly like the summary endpoint
                            // does, and do not log it as a failure. Anything else IS a
                            // failure and gets logged, but never fails the page - the
                            // client falls back to its own summary fetch.
                            if (strpos($pnbJrnEx->getMessage(), 'ORA-00942') !== false) {
                                $pnb_journal = array('installed' => false, 'enabled' => $pnbJrnEnabled, 'total' => 0, 'unseen' => 0);
                            } else {
                                error_log('PENUMBRA journal badge preload failed: ' . $pnbJrnEx->getMessage());
                            }
                        }
                    }

                    // --- SUBSCRIPTIONS: subscribable EMAIL schedules for this report ---
                    // Powers the header Subscribe button (main.js initReportSubscriptions)
                    // and the one-click ?unsub= handler. Computed only for viewers who
                    // passed the report-auth gate above, and carries NO other subscriber
                    // identities - just this user's own membership per task. Tasks store
                    // the report SHORT_ID string in REPORT_ID (see manage_schedule.php).
                    // ENCRYPTED reports get NO chip: the scheduler decrypts with the
                    // task's stored password, so self-service subscription would let a
                    // list-authorized viewer receive decrypted content WITHOUT knowing
                    // the password - delivery there stays an explicit owner decision
                    // (manage_subscription.php enforces the same rule server-side).
                    $pnbSubStateHead = substr((string)$preloaded_state_json, 0, 200);
                    $pnbSubEncrypted = (strpos($pnbSubStateHead, 'PENUMBRA_GCM::') !== false
                        || strpos($pnbSubStateHead, '"encrypted":true') !== false
                        || strpos($pnbSubStateHead, '"encrypted": true') !== false);
                    if (!$pnbSubEncrypted) try {
                        $pnbSubMail = isset($_SERVER['HTTP_SHIB_MAIL']) ? strtolower(trim($_SERVER['HTTP_SHIB_MAIL'])) : '';
                        if (!filter_var($pnbSubMail, FILTER_VALIDATE_EMAIL)) {
                            $pnbSubMail = (!empty($currentUserKey) && preg_match('/^[A-Za-z0-9._-]+$/', (string)$currentUserKey))
                                ? strtolower($currentUserKey) . '@ncsu.edu' : '';
                        }
                        $pnbSubUid = strtolower(trim((string)$currentUserKey));
                        $pnbSubStmt = $oracleConn->prepare(
                            "SELECT ID, SUBJECT, CRON_EXPRESSION, RECIPIENTS, OPTIONS
                               FROM NC_REPORTING.PENUMBRA_SCHEDULED_TASKS
                              WHERE TRIM(REPORT_ID) = :rid AND TASK_TYPE = 'EMAIL' AND IS_ACTIVE = 1");
                        $pnbSubStmt->bindValue(':rid', trim((string)$report_id));
                        $pnbSubStmt->execute();
                        $pnbSubTasks = array();
                        while ($pnbSubRow = $pnbSubStmt->fetch(PDO::FETCH_ASSOC)) {
                            $pnbSubOptsRaw = is_resource($pnbSubRow['OPTIONS']) ? stream_get_contents($pnbSubRow['OPTIONS']) : $pnbSubRow['OPTIONS'];
                            $pnbSubOpts = json_decode((string)$pnbSubOptsRaw, true);
                            if (!is_array($pnbSubOpts) || empty($pnbSubOpts['subscriptions_enabled']) || !empty($pnbSubOpts['_test_run_transient'])) continue;
                            $pnbSubMine = false;
                            if (isset($pnbSubOpts['subscribers']) && is_array($pnbSubOpts['subscribers'])) {
                                foreach ($pnbSubOpts['subscribers'] as $pnbSubEnt) {
                                    if (!is_array($pnbSubEnt)) continue;
                                    $pnbSubEntUid  = isset($pnbSubEnt['uid']) ? strtolower(trim((string)$pnbSubEnt['uid'])) : '';
                                    $pnbSubEntMail = isset($pnbSubEnt['email']) ? strtolower(trim((string)$pnbSubEnt['email'])) : '';
                                    if (($pnbSubEntUid !== '' && $pnbSubEntUid === $pnbSubUid)
                                        || ($pnbSubEntMail !== '' && $pnbSubEntMail === $pnbSubMail)) { $pnbSubMine = true; break; }
                                }
                            }
                            // Typed-recipient + suppression state for this viewer: a typed
                            // recipient gets the same chip (opt out = suppression, the
                            // owner's list itself is never rewritten). See report_auth.php's
                            // penumbra_recipients_email_set + manage_subscription.php.
                            $pnbSubRecipRaw = is_resource($pnbSubRow['RECIPIENTS']) ? stream_get_contents($pnbSubRow['RECIPIENTS']) : $pnbSubRow['RECIPIENTS'];
                            $pnbSubTypedSet = penumbra_recipients_email_set((string)$pnbSubRecipRaw);
                            $pnbSubIsTyped  = ($pnbSubMail !== '' && isset($pnbSubTypedSet[$pnbSubMail]));
                            $pnbSubSuppressed = false;
                            if ($pnbSubMail !== '' && isset($pnbSubOpts['suppressed']) && is_array($pnbSubOpts['suppressed'])) {
                                foreach ($pnbSubOpts['suppressed'] as $pnbSupE) {
                                    if (strtolower(trim((string)$pnbSupE)) === $pnbSubMail) { $pnbSubSuppressed = true; break; }
                                }
                            }
                            // "Allow only on custom condition" (2026-09-23): a viewer whose
                            // directory record does not match never sees this schedule's
                            // Subscribe control - unless they already receive it (subscriber,
                            // typed recipient, opted-out typed recipient), so leaving or
                            // resuming stays within reach. Fails closed (no record, unusable
                            // condition). One lookup per page: $pnbSubCondMemo.
                            $pnbSubCond = isset($pnbSubOpts['subscriptions_condition']) ? trim((string)$pnbSubOpts['subscriptions_condition']) : '';
                            if ($pnbSubCond !== '' && !$pnbSubMine && !$pnbSubIsTyped) {
                                require_once __DIR__ . '/penumbra_subscribe_condition.php';
                                if (!isset($pnbSubCondMemo)) $pnbSubCondMemo = array();
                                if (!penumbraSubCondPersonMatches($oracleConn, $pnbSubCond, $pnbSubUid, $pnbSubCondMemo)) continue;
                            }
                            $pnbSubTasks[] = array(
                                'id'         => (int)$pnbSubRow['ID'],
                                'subject'    => (string)$pnbSubRow['SUBJECT'],
                                'cron'       => (string)$pnbSubRow['CRON_EXPRESSION'],
                                // Plain-English schedule ('' when the cron is too exotic
                                // to describe confidently; the client then shows the raw
                                // cron). ONE describer feeds the chip, popover and the
                                // confirmation emails - see cron_describe.php.
                                'schedule'   => penumbra_cron_human((string)$pnbSubRow['CRON_EXPRESSION']),
                                'recipient'  => $pnbSubIsTyped,
                                'suppressed' => $pnbSubSuppressed,
                                // Effective "am I receiving this": subscriber, or a typed
                                // recipient who hasn't opted out.
                                'subscribed' => ($pnbSubMine || ($pnbSubIsTyped && !$pnbSubSuppressed))
                            );
                        }
                        if (!empty($pnbSubTasks)) {
                            $pnb_subscriptions = array('email' => $pnbSubMail, 'tasks' => $pnbSubTasks);
                        }
                    } catch (Exception $pnbSubEx) { /* header button simply stays hidden */ }
                } else {
                    // Report is not public, and user is not authorized
                    $error_state = [
                        "query" => "SELECT 'Access Denied' AS Error FROM DUAL",
                        "reportTitle" => "Access Denied",
                        "reportSnippet" => "You are not authorized to view this report."
                    ];
                    $preloaded_state_json = json_encode($error_state);
                }
            } else {
                // Report not found. Create a friendly error state.
                // We'll create a special error message that main.js can detect.
                $error_message = "Report Not Found (ID: " . htmlspecialchars($report_id, ENT_QUOTES, 'UTF-8') . ")";
                $error_state = [
                    "query" => "SELECT '" . str_replace("'", "''", $error_message) . "' AS Error FROM DUAL",
                    "reportTitle" => "Report Not Found"
                ];
                $preloaded_state_json = json_encode($error_state);
            }
        }
    } catch (Exception $e) {
        error_log("Penumbra - Failed to preload state by ID: " . $e->getMessage());
    }
}

// --- API / JSON MODE ---
if (isset($_GET['json']) && $_GET['json'] == '1' && (isset($_GET['id']) || isset($_GET['state']))) {

    // Match query.php's limits (set at its top): this path holds the decoded
    // dataset in multiple arrays at once, so without this a large report can
    // OOM here at the php.ini default while succeeding via query.php directly.
    ini_set('memory_limit', '1536M');
    set_time_limit(300);

    // 1. SMART URL REPAIR (Fixes the "&" cutoff issue)
    // Standard PHP $_GET splits at '&', breaking values like "Res. & Educ."
    // We manually fix common patterns in the raw query string and re-parse.
    $raw_qs = $_SERVER['QUERY_STRING'];
    // Replace " & " (encoded or plus-sign) with " %26 "
    $fixed_qs = preg_replace('/(%20|\+)&(%20|\+)/', '$1%26$2', $raw_qs);
    
    if ($fixed_qs !== $raw_qs) {
        parse_str($fixed_qs, $_GET);
    }

    $state = null;

    // Case 1: Server-Side Report (ID)
    if (isset($_GET['id'])) {
        // Use the state already fetched by the preload block above
        $state = json_decode($preloaded_state_json, true);
    } 
    // Case 2: Private State (URL Param)
    elseif (isset($_GET['state'])) {
        // Decode: Base64 -> ZLIB (Pako) -> JSON
        $decoded_b64 = base64_decode($_GET['state']);
        if ($decoded_b64) {
            $decompressed = @gzuncompress($decoded_b64);
            if ($decompressed === false) {
                $decompressed = @gzinflate($decoded_b64);
            }
            if ($decompressed) {
                $state = json_decode($decompressed, true);
            }
        }
    }

    if ($state && (isset($state['query']) || (isset($state['encrypted']) && $state['encrypted'] === true))) {
    
        // 1. If it's an encrypted report and we received a decrypted query from a Stub, use it.
        //    SECURITY: Only accept decrypted_query when the state is actually encrypted.
        //    This prevents attackers from POSTing arbitrary SQL to override a non-encrypted
        //    report's stored query.
        if (isset($state['encrypted']) && $state['encrypted'] === true
            && isset($_POST['decrypted_query']) && !empty($_POST['decrypted_query'])) {
            $sql = $_POST['decrypted_query'];
        }
        // 2. If it's a standard unencrypted report, use the stored query.
        elseif (isset($state['query'])) {
            $sql = $state['query'];
        }
        // 3. If it's encrypted and we didn't get a key, return the blob so the client/stub can handle it.
        elseif (isset($state['encrypted']) && $state['encrypted'] === true) {
            header('Content-Type: application/json');
            echo json_encode($state, JSON_UNESCAPED_SLASHES);
            exit;
        }

        // --- 1. PROMPT PROCESSING (Two-Pass Logic) ---
        // Uses bracket-balanced extraction so that ']' inside PROMPT parameters
        // (e.g. MSSQL bracket identifiers in templates like [DEPARTMENT]) doesn't
        // prematurely truncate the tag match.
        require_once 'shared_logic.php';

        // me() USER VARIABLES IN PROMPT VALUES - resolve as PLAIN TEXT here,
        // BEFORE the value gets quoted into SQL (mirrors resolveDynamicValues()
        // in js/main.js, which the interactive client runs on every prompt
        // default). This path used to skip that, so a forcedefault like
        // "me(lname), me(fname)" reached query.php as the already-quoted
        // literal 'me(lname), me(fname)' - and query.php's SQL-context me()
        // resolver then substituted QUOTED values INSIDE that literal, nesting
        // quotes Oracle rejects (ORA-00907). A browser-session call (via the
        // www3 SP proxy) carries the Shibboleth headers, so resolve for real;
        // secret-key/IP API callers have NO user identity, so me() is
        // unresolvable BY DESIGN for them - the caller must supply the
        // prompt's URL param, and Pass 2 below fails loud with a 400 saying so
        // instead of letting the literal crash Oracle.
        $jsonMeMap = ($currentUserKey !== '') ? penumbraBuildMeMacroMap($currentUserKey, $user_ouc) : null;
        $jsonMeTokenRe = '/\bme\(\s*[A-Za-z0-9_]*\s*\)/i';

        // Pass 1: Build an 'Answer Map' of all prompt values (from URL or Defaults)
        // We need this first so 'resultif' knows the answers to parent prompts that haven't been processed yet.
        $prompt_answers = [];
        $promptTagsPass1 = extractPromptTags($sql);
        foreach ($promptTagsPass1 as $ptag) {
            $inner_content = $ptag['inner_content'];
                // Parse params
                $params = [];
                // Allow ; inside quotes using a smarter regex
                preg_match_all('/([a-zA-Z0-9_-]+)=([^;]*(?:;(?!\s*[a-zA-Z0-9_-]+=|\s*\bhidden\b|\s*\bnoquote\b|\s*\bmessage\b|\s*\blabel\b|\s*\bnosave\b|\s*\bforcedefault\b)[^;]*)*)/', $inner_content, $pairs, PREG_SET_ORDER);
                foreach ($pairs as $pair) {
                    $params[strtolower(trim($pair[1]))] = trim($pair[2]);
                }

                // Determine Value. Resolve the chosen value through the shared
                // date resolver whatever its source, so the answer map holds the
                // same string Pass 2 injects. resolveParamDateExpression() only
                // touches values matching the app's date grammar - plain text
                // answers ("May", "Smith", "all") come back untouched.
                $val = null;
                if (isset($params['name']) && isset($_GET[$params['name']])) {
                    $val = $_GET[$params['name']];
                } elseif (isset($params['forcedefault'])) {
                    $val = $params['forcedefault'];
                } elseif (isset($params['default'])) {
                    $val = $params['default'];
                }
                // Resolve me() plain-text BEFORE the date-range lookup so the
                // answer map (resultif comparisons, {name} tokens) holds the
                // same resolved string the client-side map would. Best-effort
                // only - no fail-loud here, because a prompt whose resultif
                // fails is REMOVED in Pass 2 and its value never reaches SQL.
                if ($jsonMeMap !== null) {
                    $val = penumbraResolveMeInPromptValue($val, $jsonMeMap);
                }
                // Dynamic date-range prompts: resolve `min`/`max` keywords via the
                // shared MIN/MAX lookup. {name} tokens in the autofill condition
                // are filled from earlier prompts' answers (tags resolve in SQL
                // order, so parents populate the map before their dependents).
                if (penumbraDateRangeIsType(isset($params['type']) ? $params['type'] : '')) {
                    // type=date-range answers as "<from>..<to>". Resolve BOTH halves
                    // so the answer map holds the concrete range Pass 2 injects. An
                    // unresolvable range stays raw here on purpose: Pass 2 is where
                    // it fails loud, and only if the prompt survives its resultif.
                    $drPass1 = penumbraDateRangeResolve($params, $val, function($n) use ($prompt_answers) {
                        return isset($prompt_answers[$n]) ? $prompt_answers[$n] : null;
                    });
                    if (!isset($drPass1['error'])) {
                        $val = penumbraDateRangeUrlValue($drPass1);
                    }
                } else {
                    $val = penumbraApplyDateRangeKeyword($params, $val, function($n) use ($prompt_answers) {
                        return isset($prompt_answers[$n]) ? $prompt_answers[$n] : null;
                    });
                    $val = resolveParamDateExpression($val);
                }
                if (isset($params['name']) && $val !== null) {
                    $prompt_answers[$params['name']] = $val;
                }
        }

        // Pass 2: Perform Replacements (Backwards to preserve offsets)
        $promptTagsPass2 = extractPromptTags($sql);
        for ($i = count($promptTagsPass2) - 1; $i >= 0; $i--) {
                $full_tag = $promptTagsPass2[$i]['full_tag'];
                $offset = $promptTagsPass2[$i]['offset'];
                $inner_content = $promptTagsPass2[$i]['inner_content'];

                // Re-parse params for this specific tag
                $params = [];
                preg_match_all('/([a-zA-Z0-9_-]+)=([^;]*(?:;(?!\s*[a-zA-Z0-9_-]+=|\s*\bhidden\b|\s*\bnoquote\b|\s*\bnosave\b|\s*\bforcedefault\b)[^;]*)*)/', $inner_content, $pairs, PREG_SET_ORDER);
                foreach ($pairs as $pair) {
                    $params[strtolower(trim($pair[1]))] = trim($pair[2]);
                }
                // template="..." loses its wrapping quote pair, as it does in the
                // browser and the scheduler (penumbraPromptUnquoteTemplate,
                // shared_logic.php). This engine never stripped it, so a quoted
                // template reached the SQL WITH its quotes - WHERE 1=1 "AND c = 'v'" -
                // and template="" was never the empty string that marks a control
                // prompt: the tile or API caller got a stray "" in its statement.
                if (isset($params['template'])) {
                    $params['template'] = penumbraPromptUnquoteTemplate($params['template']);
                }

                // --- RESULTIF LOGIC ---
                if (isset($params['resultif'])) {
                    $parts = explode(':', $params['resultif'], 2);
                    if (count($parts) == 2) {
                        $parentName = trim($parts[0]);
                        $expectedVal = trim($parts[1]);

                        // Negation support: "resultif=parent:!value" inverts the match
                        $negate = false;
                        if (strlen($expectedVal) > 0 && $expectedVal[0] === '!') {
                            $negate = true;
                            $expectedVal = substr($expectedVal, 1);
                        }

                        // Check our Answer Map
                        $actualVal = isset($prompt_answers[$parentName]) ? $prompt_answers[$parentName] : '';

                        // Check if expected value is a regex (starts and ends with slash, optional flags)
                        $isMatch = false;
                        if (preg_match('/^\/.*\/[a-z]*$/i', $expectedVal)) {
                            // Regex comparison
                            $isMatch = @preg_match($expectedVal, (string)$actualVal);
                        } else {
                            // Standard match with pipe-delimited multi-value support (val1|val2)
                            $expectedValues = explode('|', $expectedVal);
                            $isMatch = in_array((string)$actualVal, $expectedValues, true);
                        }

                        // Apply negation after evaluation
                        if ($negate) $isMatch = !$isMatch;

                        if (!$isMatch) {
                            // Condition FAILED: remove this prompt and try to strip a single
                            // preceding SQL clause fragment so the query stays valid.
                            //
                            // INTENTIONALLY NARROW - only handles `AND/OR col OP` and
                            // `WHERE col OP` (op: = != <> < > <= >= LIKE IN BETWEEN IS / IS NOT,
                            // optional NOT, schema-qualified `s.col` recognized). Does NOT handle
                            // function-wrapped columns (TRUNC, UPPER), arithmetic, parenthesized
                            // expressions, HAVING, subquery contexts, or dialect-specific operators.
                            // For those shapes, authors should wrap the whole clause inside
                            // template="..." on the prompt so it vanishes cleanly when resultif
                            // fails. See data-tip="resultif" in help_content.php.
                            //
                            // SAME REGEX in js/main.js and schedule_runner.php - keep in sync.
                            $precedingSql = substr($sql, 0, $offset);

                            // Pattern 1: Strip trailing AND/OR + column + operator
                            $andOrClause = '/\s+(AND|OR)\s+(?:[\w."]+\s*\.\s*)?[\w."]+\s*(?:NOT\s+)?(?:>=|<=|!=|<>|>|<|=|LIKE|IN|BETWEEN|IS(?:\s+NOT)?)\s*$/i';
                            if (preg_match($andOrClause, $precedingSql, $cm)) {
                                // Strip the trailing AND/OR clause
                                $stripLen = strlen($cm[0]);
                                $sql = substr($sql, 0, $offset - $stripLen) . substr($sql, $offset + strlen($full_tag));
                            } else {
                                // Pattern 2: WHERE as first condition - replace with WHERE 1=1
                                $whereClause = '/\s+(WHERE)\s+(?:[\w."]+\s*\.\s*)?[\w."]+\s*(?:NOT\s+)?(?:>=|<=|!=|<>|>|<|=|LIKE|IN|BETWEEN|IS(?:\s+NOT)?)\s*$/i';
                                if (preg_match($whereClause, $precedingSql, $wm)) {
                                    $stripLen = strlen($wm[0]);
                                    $sql = substr($sql, 0, $offset - $stripLen) . ' WHERE 1=1' . substr($sql, $offset + strlen($full_tag));
                                } else {
                                    // No clause detected - just remove the tag (best effort)
                                    $sql = substr_replace($sql, "", $offset, strlen($full_tag));
                                }
                            }
                            continue; // Skip standard processing
                        }
                    }
                }
                // ---------------------
                
                // Resolve Value (Same logic as Pass 1)
                // The resolveParamDateExpression() call is what makes that true:
                // without it a dynamic default reached the SQL as its literal
                // phrase ("SYSDATE-30", "first day of last month"), which Oracle
                // rejected with ORA-01858. Interactive runs never hit this - the
                // client resolves the phrase and posts a real date - so only the
                // ?json=1 API saw it.
                $raw_value = '';
                if (isset($params['name']) && isset($_GET[$params['name']])) {
                    $raw_value = $_GET[$params['name']];
                } elseif (isset($params['forcedefault'])) {
                    $raw_value = $params['forcedefault'];
                } elseif (isset($params['default'])) {
                    $raw_value = $params['default'];
                }
                // Resolve me() plain-text (same contract as Pass 1). This runs
                // AFTER resultif removal, so only a value that will actually be
                // injected into SQL can fail loud here. Two loud cases:
                //  - no user identity (secret-key/IP API caller): me() cannot
                //    resolve, the caller must pass the prompt's URL param;
                //  - unknown me() key (typo): same contract as query.php's
                //    SQL-context resolver.
                // Letting the literal through instead used to crash Oracle
                // (ORA-00907) once query.php substituted inside the quotes.
                if (is_string($raw_value) && preg_match($jsonMeTokenRe, $raw_value)) {
                    if ($jsonMeMap === null) {
                        preg_match_all($jsonMeTokenRe, $raw_value, $jsonMeToks);
                        $jsonPromptName = isset($params['name']) ? trim((string)$params['name']) : '';
                        http_response_code(400);
                        header('Content-Type: application/json');
                        echo json_encode(array('error' =>
                            ($jsonPromptName !== '' ? "Prompt '" . $jsonPromptName . "'" : 'A prompt in this report')
                            . ' uses user variables (' . implode(', ', $jsonMeToks[0]) . ') that resolve from the signed-in user, '
                            . 'and this API call has no user session. '
                            . ($jsonPromptName !== ''
                                ? 'Supply the value explicitly by adding &' . $jsonPromptName . '=<value> to the URL.'
                                : 'Supply the value explicitly via the prompt\'s URL parameter.')));
                        exit;
                    }
                    $jsonUnknownMe = array();
                    $raw_value = penumbraResolveMeInPromptValue($raw_value, $jsonMeMap, $jsonUnknownMe);
                    if (!empty($jsonUnknownMe)) {
                        http_response_code(400);
                        header('Content-Type: application/json');
                        echo json_encode(array('error' => penumbraUnknownMeVarsMessage(array_keys($jsonUnknownMe))));
                        exit;
                    }
                }
                // type=date-range: ONE answer ("<from>..<to>"), TWO dates. Handled
                // whole here - the single-value path below would quote the pair as
                // one string literal. Both ends are required and From must not be
                // after To: BETWEEN with reversed bounds is zero rows, silently, in
                // both databases, so refuse it out loud. Same rules, same shared
                // helpers (shared_logic.php) as the browser and the scheduler.
                if (penumbraDateRangeIsType(isset($params['type']) ? $params['type'] : '')) {
                    $drLabel = isset($params['message']) ? $params['message']
                        : (isset($params['name']) ? $params['name'] : '?');
                    // Surrounding quotes were already stripped off template= above
                    // (for every type now; a second strip here would eat a pair the
                    // author meant to keep).
                    $drTemplate = isset($params['template']) ? $params['template'] : null;
                    if ($drTemplate === '') {
                        // Control prompt: drives resultif only, emits no SQL.
                        $sql = penumbraDateRangeSplice($sql, $offset, strlen($full_tag), '');
                        continue;
                    }
                    if (stripos($inner_content, 'noquote') !== false) {
                        http_response_code(400);
                        header('Content-Type: application/json');
                        echo json_encode(array('error' => penumbraNoQuoteTypeError($drLabel, 'date-range')));
                        exit;
                    }
                    $drRange = penumbraDateRangeResolve($params, $raw_value, function($n) use ($prompt_answers) {
                        return isset($prompt_answers[$n]) ? $prompt_answers[$n] : null;
                    });
                    if (isset($drRange['error'])) {
                        $drName = isset($params['name']) ? trim((string)$params['name']) : '';
                        http_response_code(400);
                        header('Content-Type: application/json');
                        echo json_encode(array('error' => "Prompt '" . $drLabel . "': " . $drRange['error']
                            . ($drName !== '' ? ' Supply it in the URL as &' . $drName . '=<from>..<to>.' : '')));
                        exit;
                    }
                    $sql = penumbraDateRangeSplice($sql, $offset, strlen($full_tag),
                        penumbraDateRangeEmit($drTemplate, "'" . $drRange['from'] . "'", "'" . $drRange['to'] . "'"));
                    continue;
                }

                // Dynamic date-range prompts: same keyword resolution as Pass 1
                // (the answer map is complete by now).
                $raw_value = penumbraApplyDateRangeKeyword($params, $raw_value, function($n) use ($prompt_answers) {
                    return isset($prompt_answers[$n]) ? $prompt_answers[$n] : null;
                });
                $raw_value = resolveParamDateExpression($raw_value);

                $type = isset($params['type']) ? strtolower(trim($params['type'])) : 'text';
                $noQuote = stripos($inner_content, 'noquote') !== false;

                // SECURITY + ENGINE PARITY: a noquote answer is spliced into the SQL
                // unquoted (see the raw $cleanValue splice in the single-value branch
                // below - note it deliberately bypasses $escapedValue). This path had
                // NEITHER a type gate NOR a value check, so a ?json=1 caller could put
                // arbitrary SQL in the URL parameter of any noquote prompt - while the
                // browser engine refused the same report outright and the scheduler at
                // least validated the value. Enforce the shared rule here too.
                //
                // A control prompt (template="") emits no SQL at all, so it stays exempt
                // - matching the equivalent skip in js/main.js.
                $isControlPrompt = isset($params['template']) && $params['template'] === '';
                if ($noQuote && !$isControlPrompt) {
                    $promptLabel = isset($params['message']) ? $params['message']
                        : (isset($params['name']) ? $params['name'] : '?');
                    if (!penumbraNoQuoteTypeIsAllowed($type)) {
                        http_response_code(400);
                        header('Content-Type: application/json');
                        echo json_encode(array('error' => penumbraNoQuoteTypeError($promptLabel, $type)));
                        exit;
                    }
                    // Validate $raw_value, i.e. BEFORE the '['/']' strip below. That is
                    // deliberately the stricter of the two: brackets are not safe chars,
                    // so a bracketed identifier must come from the author's options list.
                    if (!penumbraNoQuoteValueIsAllowed($raw_value, isset($params['options']) ? $params['options'] : '')) {
                        http_response_code(400);
                        header('Content-Type: application/json');
                        echo json_encode(array('error' => penumbraNoQuoteValueError($promptLabel)));
                        exit;
                    }
                }

                // Per-option templates (options=Display:Value::Template, parsed by the one
                // shared penumbraPromptOptionTemplates): a picked option that carries its own
                // SQL emits THAT - even on a control prompt - and the others fall back to the
                // prompt's template (joined by penumbraPromptJoinPieces). The scheduler's block,
                // mirrored (process_scheduler_prompts); the browser does the same. This engine
                // had none until 2026-09-29: `All::and c LIKE '%'` went out as c = 'All'.
                $perOptionTemplates = (is_string($raw_value) && $raw_value !== '') ? penumbraPromptOptionTemplates($inner_content) : array();
                if (!empty($perOptionTemplates)) {
                    $valueList = ($type === 'multi-select' && strpos($raw_value, ',') !== false)
                        ? array_map('trim', explode(',', $raw_value))
                        : array(trim($raw_value));
                    $anyPerOption = false;
                    foreach ($valueList as $v) {
                        if (array_key_exists($v, $perOptionTemplates)) { $anyPerOption = true; break; }
                    }
                    if ($anyPerOption) {
                        $promptTpl = isset($params['template']) ? $params['template'] : null;
                        $logic = (isset($params['logic']) && strtolower($params['logic']) === 'and') ? ' AND ' : ' OR ';
                        $pieces = array();
                        foreach ($valueList as $v) {
                            $hasPerOpt = array_key_exists($v, $perOptionTemplates);
                            $tpl = $hasPerOpt ? $perOptionTemplates[$v] : $promptTpl;
                            $valForTemplate = $noQuote ? $v : ("'" . str_replace("'", "''", $v) . "'");
                            if ($tpl === null) {
                                $pieces[] = $valForTemplate;
                            } elseif ($tpl === '') {
                                continue;       // an empty per-option template emits nothing for that value
                            } else {
                                $pieces[] = str_replace(':val', $valForTemplate, $tpl);
                            }
                        }
                        // One piece as it is; several grouped, a leading AND/OR once in front
                        // of the group and off every piece inside it (penumbraPromptJoinPieces).
                        $replacement_sql = penumbraPromptJoinPieces($pieces, $promptTpl, $logic);
                        $sql = penumbraPromptSplice($sql, $offset, strlen($full_tag), $replacement_sql, $noQuote);
                        continue;
                    }
                }

                if ($isControlPrompt) {
                    // Control prompt (template=""): it drives resultif and emits NO SQL,
                    // whatever its type - the browser checks this before anything else.
                    // The single-value path below got there by accident (a template with
                    // no :val in it); a multi-select emitted its list regardless.
                    $sql = penumbraPromptSplice($sql, $offset, strlen($full_tag), '', $noQuote);
                    continue;
                }

                $replacement_sql = "";

                if ($type === 'multi-select') {
                    $decoded_val = html_entity_decode($raw_value, ENT_QUOTES | ENT_HTML5);
                    $values = array_filter(explode(',', $decoded_val), function($v) { return trim($v) !== ''; });

                    if (empty($values)) {
                        // Nothing picked. Straight after IN the list still owes its
                        // parentheses (penumbraPromptFollowsBareIn, shared_logic.php).
                        $replacement_sql = penumbraPromptFollowsBareIn(substr($sql, 0, $offset)) ? "('')" : "''";
                    } else {
                        // Look backwards for SQL context: <operand> <operator> in front of
                        // the tag (penumbraPromptOperatorBefore, shared_logic.php - it reads
                        // NOT LIKE / NOT IN, "My Col", UPPER(c) and c=[PROMPT] too), in the
                        // SQL as it will stand - without the opening quote of a pair written
                        // around the tag, so c = '[PROMPT]' reads like c = [PROMPT] (it went
                        // out as c = 'A', 'B') and the rewrite takes the pair with it.
                        $preceding_sql = penumbraPromptSqlBefore($sql, $offset, strlen($full_tag), $noQuote);
                        $pair_quote = (strlen($preceding_sql) !== $offset) ? "'" : '';
                        $op_match = penumbraPromptOperatorBefore($preceding_sql);
                        if ($op_match !== null) {
                            $full_match_str = $op_match['text'];
                            $column = $op_match['operand'];
                            $operator = $op_match['operator'];
                            // AND after != / <> / NOT LIKE, else OR; logic= wins (penumbraPromptJoin).
                            $logic = penumbraPromptJoin($operator, isset($params['logic']) ? $params['logic'] : null);

                            if ($operator === 'IN' || $operator === 'NOT IN') {
                                $quoted_values = array_map(function($v) {
                                    return "'" . str_replace("'", "''", trim($v)) . "'";
                                }, $values);
                                $replacement_sql = "$column $operator (" . implode(", ", $quoted_values) . ")";
                            } else {
                                $clauses = [];
                                foreach ($values as $val) {
                                    $clean_val = str_replace("'", "''", trim($val));
                                    $clauses[] = "$column $operator '$clean_val'";
                                }
                                $replacement_sql = "(" . implode($logic, $clauses) . ")";
                            }
                            // The replacement covers operand .. tag - and both quotes of a pair.
                            $offset -= strlen($full_match_str) + strlen($pair_quote);
                            $full_tag = $full_match_str . $pair_quote . $full_tag . $pair_quote;
                        } else {
                            // No operator context found in preceding SQL
                            $quoted_values = array_map(function($v) {
                                return "'" . str_replace("'", "''", trim($v)) . "'";
                            }, $values);
                            if (penumbraPromptFollowedByIsNull(penumbraPromptSqlAfter($sql, $offset, strlen($full_tag), $noQuote))) {
                                // [PROMPT] IS NULL - the optional-filter idiom: the tag stands
                                // for ONE value, the first picked, as in the browser. The whole
                                // list went out as 'A', 'B' IS NULL: a syntax error.
                                $first_value = reset($quoted_values);
                                $replacement_sql = (isset($params['template']) && $params['template'] !== '')
                                    ? str_replace(':val', $first_value, $params['template']) : $first_value;
                            } else if (isset($params['template']) && $params['template'] !== '' && strpos($params['template'], ':val') !== false && count($quoted_values) > 1) {
                                // FIX: Multi-select with template containing :val - apply template
                                // per value to avoid producing invalid SQL.
                                // e.g., template="AND col = :val" with 3 values expands to:
                                // "AND (col = 'v1' OR col = 'v2' OR col = 'v3')"
                                $logic = isset($params['logic']) && strtolower($params['logic']) === 'and' ? ' AND ' : ' OR ';
                                $condPart = $params['template'];
                                $sqlPrefix = '';
                                if (preg_match('/^\s*(AND|OR)\s+/i', $condPart, $cm)) {
                                    $sqlPrefix = $cm[0];
                                    $condPart = substr($condPart, strlen($cm[0]));
                                }
                                $perValue = array();
                                foreach ($quoted_values as $qv) {
                                    $perValue[] = str_replace(':val', $qv, $condPart);
                                }
                                $replacement_sql = $sqlPrefix . '(' . implode($logic, $perValue) . ')';
                            } else if (isset($params['template']) && $params['template'] !== '') {
                                // Single value with template
                                $replacement_sql = str_replace(':val', $quoted_values[0], $params['template']);
                            } else {
                                // No template, just output CSV list - inside parentheses
                                // of its own when the tag stands straight after IN and
                                // the operand could not be read (c IN '[PROMPT;...]': the
                                // quote in front hides the IN from the reader above).
                                $replacement_sql = implode(", ", $quoted_values);
                                if (penumbraPromptFollowsBareIn(penumbraPromptSqlBefore($sql, $offset, strlen($full_tag), $noQuote))) {
                                    $replacement_sql = '(' . $replacement_sql . ')';
                                }
                            }
                        }
                    }
                } else {
                    // Single Value Logic
                    $cleanValue = str_replace(['[', ']'], '', $raw_value);
                    $escapedValue = str_replace("'", "''", $cleanValue);
                    
                    $finalVal = "";
                    if (!$noQuote) {
                        $finalVal = "'" . $escapedValue . "'";
                    } else {
                        $finalVal = $cleanValue;
                    }

                    // --- NEW: Apply Template ---
                    if (isset($params['template'])) {
                        // Replace :val with the final quoted/unquoted value
                        $replacement_sql = str_replace(':val', $finalVal, $params['template']);
                    } else {
                        $replacement_sql = $finalVal;
                    }
                }
                // Quotes the author wrote around the tag go with it (penumbraPromptSplice,
                // shared_logic.php): TO_DATE('[PROMPT;type=date;...]', ...) used to reach
                // the database as TO_DATE(''01-JUL-22'', ...). Not when the answer is
                // spliced bare (noquote), and not when the replacement grew backwards
                // over the column and operator - the character in front is then no
                // longer the tag's own. And not when there is NO ANSWER: that path is
                // deliberately left byte for byte as it was (c = '[PROMPT;...]' still
                // goes out as c = ''''), because unlike a quoted tag WITH an answer -
                // always a database error before 2026-09-21 - it is valid SQL a tile
                // or a caller may be living on. It changes only after the saved
                // reports have been read (README section 6).
                $tagGrew = strlen($full_tag) !== strlen($promptTagsPass2[$i]['full_tag']);
                $sql = penumbraPromptSplice($sql, $offset, strlen($full_tag), $replacement_sql,
                    $noQuote || $tagGrew || $raw_value === '');
        }

        // --- 1.5 SQL-CONTEXT me() SUBSTITUTION (must precede subqueries) ---
        // The loops below execute [SUBQUERY]/[CTE_SUBQUERY] bodies against the
        // inner DB *now*, but query.php only receives the OUTER template (the
        // tags are gone by the require handoff) - so a me() token INSIDE a
        // subquery body used to reach the inner DB unresolved on JSON calls
        // (ORA-00904, or wrong/empty rows) while the same report worked
        // interactively, because query.php substitutes me() across the whole
        // template before executing subqueries itself. Resolve the WHOLE
        // template here with the same shared resolver query.php uses
        // (penumbraSubstituteMeInSql); query.php's later pass becomes a
        // harmless no-op. Every me() token still present is a genuine
        // SQL-context use - me() in prompt VALUES was already resolved
        // plain-text by the prompt passes above.
        if (preg_match($jsonMeTokenRe, $sql)) {
            if ($jsonMeMap === null) {
                // Secret-key/IP API caller: no Shibboleth headers, so me() is
                // unresolvable BY DESIGN (same contract as the prompt-value
                // 400 above). Fail loud naming the tokens rather than letting
                // known keys silently become '' and return wrong/empty rows.
                preg_match_all($jsonMeTokenRe, $sql, $jsonSqlMeToks);
                http_response_code(400);
                header('Content-Type: application/json');
                echo json_encode(array('error' =>
                    'This report\'s SQL uses user variables ('
                    . implode(', ', array_values(array_unique($jsonSqlMeToks[0])))
                    . ') that resolve from the signed-in user, and this API call has no user session. '
                    . 'Replace them with explicit values, or with [PROMPT] parameters the caller supplies in the URL.'));
                exit;
            }
            $jsonSqlUnknownMe = array();
            $sql = penumbraSubstituteMeInSql($sql, $jsonMeMap, $jsonSqlUnknownMe);
            if (!empty($jsonSqlUnknownMe)) {
                http_response_code(400);
                header('Content-Type: application/json');
                echo json_encode(array('error' => penumbraUnknownMeVarsMessage(array_keys($jsonSqlUnknownMe))));
                exit;
            }
        }

        // --- 2. SUBQUERY PROCESSING (New Logic using Shared Logic) ---
        // (shared_logic.php already required above for extractPromptTags)

        // Detect target DB for CTE formatting using the same robust approach as query.php:
        // Strip all [...] tags first so inner subquery table names don't cause false positives,
        // then extract only FROM/JOIN table references and check against global allow lists.
        // Innermost pairs are stripped repeatedly so nested brackets (e.g. MS-SQL
        // [identifiers] inside a tag) don't leak inner SQL into detection.
        $sqlForDetection = $sql;
        for ($sd = 0; $sd < 20 && preg_match('/\[[^\[\]]*\]/', $sqlForDetection); $sd++) {
            $sqlForDetection = preg_replace('/\[[^\[\]]*\]/s', ' ', $sqlForDetection);
        }
        preg_match_all('/(?:FROM|JOIN)\s+([a-zA-Z0-9_.]+)/i', $sqlForDetection, $detectedMatches);
        $detectedTables = array_map('strtoupper', $detectedMatches[1]);
        $detectedTables = array_map(function($t) { return str_replace('DBO.', '', $t); }, $detectedTables);

        $targetDb = 'oracle';
        foreach ($detectedTables as $t) {
            if (in_array($t, $pinsTableNames) || in_array($t, $infoEdTableNames)) {
                $targetDb = 'mssql';
                break;
            }
        }

        // Process [CTE_SUBQUERY] tags using bracket-balanced extraction.
        // Fail loud (same contract as query.php): a swallowed inner error used to
        // leave an empty placeholder CTE that broke the outer query with a
        // misleading ORA-00904 - or silently changed the data consumers received.
        $cteTags = extractSubqueryTags($sql, 'CTE_SUBQUERY');
        for ($i = count($cteTags) - 1; $i >= 0; $i--) {
            $tag = $cteTags[$i];
            try {
                $replacement = executeSubqueryLogic($tag['db'], $tag['query'], 'cte', $targetDb);
                $sql = substr_replace($sql, $replacement, $tag['offset'], strlen($tag['full_tag']));
            } catch (Exception $e) {
                http_response_code(400);
                header('Content-Type: application/json');
                echo json_encode(array('error' => penumbraSubqueryErrorMessage('CTE_SUBQUERY', $tag['db'], $e->getMessage())));
                exit;
            }
        }

        // Process standard [SUBQUERY] tags (IN clause style) using bracket-balanced extraction
        $inTags = extractSubqueryTags($sql, 'SUBQUERY');
        for ($i = count($inTags) - 1; $i >= 0; $i--) {
            $tag = $inTags[$i];
            try {
                // $targetDb (set above from the main query's database) decides the
                // >1,000-value IN (SELECT ...) dialect - without it an MS-SQL outer
                // query got the Oracle "FROM dual" form. Mirrors the CTE call above.
                $replacement = executeSubqueryLogic($tag['db'], $tag['query'], 'in', $targetDb);

                // Smart paren wrapping: check if the character before the tag is already '('
                // If user wrote IN ([SUBQUERY...]), don't double-wrap.
                // If user wrote IN [SUBQUERY...], add parens to produce valid SQL.
                $charBefore = ($tag['offset'] > 0) ? $sql[$tag['offset'] - 1] : '';
                if ($charBefore !== '(') {
                    $replacement = '(' . $replacement . ')';
                }

                $sql = substr_replace($sql, $replacement, $tag['offset'], strlen($tag['full_tag']));
            } catch (Exception $e) {
                http_response_code(400);
                header('Content-Type: application/json');
                echo json_encode(array('error' => penumbraSubqueryErrorMessage('SUBQUERY', $tag['db'], $e->getMessage())));
                exit;
            }
        }

        // --- RESOLVE [IMPORT] TAGS for JSON API ---
        // When serving via ?json=1, the JS client isn't involved, so we must
        // look up linked imports from the DB and pass them to query.php.
        if (preg_match('/\[\s*IMPORT/i', $sql) && isset($_GET['id'])) {
            try {
                // Get the numeric report ID from the SHORT_ID
                $impReportRows = queryViaOci8(
                    "SELECT ID FROM PENUMBRA_REPORTS WHERE TRIM(SHORT_ID) = :sid",
                    array(':sid' => $_GET['id'])
                );
                if (!empty($impReportRows)) {
                    $impNumericId = $impReportRows[0]['ID'];
                    $impLinked = queryViaOci8(
                        "SELECT ID, IMPORT_NAME FROM PENUMBRA_IMPORTS WHERE REPORT_ID = :rid",
                        array(':rid' => $impNumericId)
                    );
                    if (!empty($impLinked)) {
                        $importRefs = array();
                        foreach ($impLinked as $imp) {
                            $importRefs[strtoupper($imp['IMPORT_NAME'])] = $imp['ID'];
                        }
                        $_POST['importRefs'] = json_encode($importRefs);
                    }
                }
            } catch (Exception $e) {
                error_log('[PENUMBRA JSON API] Failed to resolve imports: ' . $e->getMessage());
            }
        }

        // --- EXECUTION ---
        $_POST['query_template'] = $sql;
        $_POST['params'] = '[]';
        $_POST['noLimit'] = (isset($state['noLimit']) && $state['noLimit'] === true) ? 'true' : 'false';

        // ?rowlimit=true forces the 200-row cap ON, overriding the report's saved
        // noLimit - the same URL param the browser client honors (js/main.js,
        // _penumbraRowLimitOverride). Client-parsed params never reach this path
        // (no JS runs here), so it needs its own copy.
        //
        // ONLY the `true` direction is implemented, and it needs no auth check:
        // adding the cap can only ever fetch FEWER rows, so it grants nothing.
        // `rowlimit=false` (uncapping) is deliberately NOT honored here - it would
        // return more rows than the report's author configured to a caller
        // authenticated differently from the Shibboleth user the client-side gate
        // keys on ($canEditLoadedReport). Falling through leaves the report's own
        // setting in force, which is the safe default.
        //
        // Boolean spellings mirror _bool() in js/main.js (true|yes|1, or the bare
        // key) so one link behaves the same with or without &json=1.
        if (isset($_GET['rowlimit'])) {
            $rlRaw = strtolower(trim((string)$_GET['rowlimit']));
            if ($rlRaw === '' || $rlRaw === 'true' || $rlRaw === 'yes' || $rlRaw === '1') {
                $_POST['noLimit'] = 'false'; // limiter ON => query.php caps at 200
            }
        }

        if (isset($_GET['id'])) { $_POST['short_id'] = $_GET['id']; }
        
        // Capture the output of query.php instead of sending it directly.
        //
        // This capture only holds because query.php refuses to touch the output
        // layer unless it is itself the top-level request (see the run-metrics
        // block near the end of query.php). ANY flush from inside this buffer
        // commits the response and hands back an EMPTY $raw_json, at which point
        // every transform below no-ops and the client keeps query.php's raw
        // payload - which is exactly what the run-metrics ob_flush() did between
        // 2026-08-20 and 2026-08-21. Do not optimize that guard away.
        ob_start();
        require 'query.php';
        $raw_json = ob_get_clean();

        // Empty capture == output escaped the buffer above. Silent-but-wrong is
        // the one outcome indistinguishable from success here, so say it.
        if (trim((string)$raw_json) === '') {
            error_log('[PENUMBRA JSON API] Empty capture from query.php - output escaped the ob_start() buffer; response post-processing was skipped.');
        }

        // Decode the response to process it
        $response = json_decode($raw_json, true);

        // Strip debug info from JSON API responses unless explicitly requested.
        // query.php includes debug for admins by default, but the JSON API
        // output can be very large (import CTEs) and consumers don't need it.
        if (!isset($_GET['debug']) || $_GET['debug'] != '1') {
            unset($response['debug']);
        }

        // Report title for API consumers that label their output (additive key,
        // 2026-08-20; the ?livecmp= live-vs-live comparison boot names its
        // against side with it). Saved states carry the title as reportTitle
        // (verified live); 'title' kept as a legacy fallback. Both output paths
        // below re-encode $response, so setting it here covers them all.
        if (is_array($response) && !isset($response['error']) && isset($state) && is_array($state)) {
            $pnbJsonTitle = '';
            if (isset($state['reportTitle']) && trim((string)$state['reportTitle']) !== '') {
                $pnbJsonTitle = (string)$state['reportTitle'];
            } elseif (isset($state['title']) && trim((string)$state['title']) !== '') {
                $pnbJsonTitle = (string)$state['title'];
            }
            if ($pnbJsonTitle !== '') {
                $response['report_title'] = strip_tags($pnbJsonTitle);
            }
        }

        // --- JOURNAL TOGGLE STATUS (1/0 columns, appended at the END of each row) ---
        // Toggle columns are otherwise client-only; here we join
        // PENUMBRA_JOURNAL_TOGGLE so API consumers + scheduled emails see the
        // checkbox state. Injected on the flat rows BEFORE sort/reorder; the
        // reorder step re-appends these names so they survive + stay at the end.
        // Notes are intentionally ignored in machine output.
        $journal_toggle_cols = array();
        $journal_toggle_resolver = null;
        if (isset($_GET['id']) && $response && isset($response['data']) && is_array($response['data']) && !empty($response['data'])) {
            require_once __DIR__ . '/journal_export.php';
            $jt = journalExportToggleColumns($_GET['id'], $state, $response['data']);
            $journal_toggle_cols = $jt['colNames'];
            // For the search steps below: a toggle condition written the way the
            // report page offers it ("Done = ☑", "Done = unchecked") reads the
            // stored 1/0, as it does on the page and in a scheduled email.
            $journal_toggle_resolver = isset($jt['resolver']) ? $jt['resolver'] : null;
        }

        // --- APPLY SAVED SORT ORDER (Enhanced with Date Support) ---
        if ($response && isset($response['data']) && !empty($response['data']) && isset($state['sortCriteria']) && is_array($state['sortCriteria']) && !empty($state['sortCriteria'])) {
            
            $header_row_keys = array_keys($response['data'][0]);

            // Decorate-sort-undecorate (2026-08-01). The old comparator ran
            // trim + str_replace x2 + is_numeric x2 + two preg_match and
            // possibly two strtotime PER COMPARISON - O(N log N) regex/date
            // parses per criterion. Precompute each row's
            // [trimmedValue, numericValue|null, timestamp|null|false] once per
            // criterion; the comparator below replays the ORIGINAL branch order
            // exactly (empties first; numeric only when BOTH sides numeric;
            // date only when BOTH look date-like AND both parse; else natural
            // case-insensitive), so the resulting order is identical. Rows are
            // uniform, so the column key resolves once per criterion instead
            // of per comparison.
            $criteria_keys = [];
            foreach ($state['sortCriteria'] as $ci => $criteria) {
                $col_ref = $criteria['colIndex'];
                $key = null;
                if (is_numeric($col_ref) && isset($header_row_keys[(int)$col_ref])) {
                    $key = $header_row_keys[(int)$col_ref];
                } elseif (array_key_exists($col_ref, $response['data'][0])) {
                    $key = $col_ref;
                }
                $criteria_keys[$ci] = [$key, (strtolower($criteria['direction']) === 'desc') ? -1 : 1];
            }
            $date_like_re = '/[0-9].*[\/\-:]|[\/\-:].*[0-9]/';
            $sort_keys = [];
            foreach ($response['data'] as $ri => $row) {
                $tuples = [];
                foreach ($criteria_keys as $ci => $ck) {
                    if ($ck[0] === null) { $tuples[$ci] = null; continue; }
                    $val = isset($row[$ck[0]]) ? trim((string)$row[$ck[0]]) : '';
                    $clean = str_replace(['$', ','], '', $val);
                    $tuples[$ci] = [
                        $val,
                        is_numeric($clean) ? (float)$clean : null,
                        preg_match($date_like_re, $val) ? strtotime($val) : null
                    ];
                }
                $sort_keys[$ri] = $tuples;
            }
            $sort_order = array_keys($response['data']);
            usort($sort_order, function ($ia, $ib) use ($sort_keys, $criteria_keys) {
                foreach ($criteria_keys as $ci => $ck) {
                    if ($ck[0] === null) continue;
                    $ta = $sort_keys[$ia][$ci];
                    $tb = $sort_keys[$ib][$ci];
                    if ($ta[0] === '' && $tb[0] === '') { $cmp = 0; }
                    elseif ($ta[0] === '') { $cmp = -1; }
                    elseif ($tb[0] === '') { $cmp = 1; }
                    elseif ($ta[1] !== null && $tb[1] !== null) { $cmp = $ta[1] <=> $tb[1]; }
                    elseif ($ta[2] !== null && $tb[2] !== null && $ta[2] !== false && $tb[2] !== false) { $cmp = $ta[2] - $tb[2]; }
                    else { $cmp = strnatcasecmp($ta[0], $tb[0]); }
                    if ($cmp !== 0) {
                        return ($ck[1] === -1) ? -$cmp : $cmp;
                    }
                }
                return 0;
            });
            $sorted_data = [];
            foreach ($sort_order as $ri) { $sorted_data[] = $response['data'][$ri]; }
            $response['data'] = $sorted_data;
            unset($sort_keys, $sort_order, $sorted_data);
        }

        // columns (2026-09-30): the column names of this rowset BEFORE the search
        // steps - the same list the &dsearch= step routes by (the first row's
        // keys, '#', the @@JSON sub-table columns) - so a dashboard learns what a
        // tile's report has even when the filter leaves it no rows: its Visual
        // Search Builder, the count line and the routing of a short-form
        // condition read it (penumbra_dashboard.js tileBuilderCols). Additive key.
        // A query with no rows at all (2026-10-01): the driver's column metadata
        // (query.php's columns_meta, one entry per field with its name) names the
        // columns the rows cannot, so the envelope and the routing below still
        // know them - a dashboard tile of such a report is named by the count
        // line and the builder instead of waiting forever, and a fragment on a
        // column it lacks is still reported as skipped. No metadata = no columns
        // key, as before.
        $_dsCols = array();
        if ($response && isset($response['data']) && is_array($response['data'])) {
            require_once __DIR__ . '/penumbra_search.php';
            $_dsCols = !empty($response['data'])
                ? penumbra_search_known_columns($response['data'])
                : penumbra_search_columns_from_meta(isset($response['columns_meta']) ? $response['columns_meta'] : null);
            if (!empty($_dsCols)) { $response['columns'] = $_dsCols; }
        }

        // &search= (2026-09-05): filter the rows with the SAME search engine the
        // report page and scheduled email use (penumbra_search.php, lifted out of
        // the runner) - so a dashboard address pre-filters data tiles exactly like
        // a framed report. Runs here, while every column is still present (hidden
        // columns match, as they do on the page and in email) and BEFORE the row
        // cap, so total_rows counts the matches, not the report.
        if ($response && isset($response['data']) && is_array($response['data'])
            && isset($_GET['search']) && trim((string)$_GET['search']) !== '') {
            require_once __DIR__ . '/penumbra_search.php';
            $response['data'] = php_apply_search_filter($response['data'], 'standard', (string)$_GET['search'], null, $journal_toggle_resolver);
        }

        // &dsearch= (2026-09-29): a DASHBOARD's filter as a fragment list
        // ({"p":..., "f":[[COLUMN or "", text], ...]}). Only this report's rows
        // (or, with no rows at all, the driver's metadata - the list the columns
        // envelope above holds) say which columns it has, so the routing happens here: fragments on a
        // column the report lacks are left out - not turned into a literal
        // comparison that matches nothing - and named in search_skipped for the
        // tile's "not filtered" note. Same engine as &search= above, and before
        // the row cap for the same reason. Twin: main.js penumbraRouteDashSearch.
        // Journal toggle columns route like any column (the rows carry them, from
        // the step above) and read "Done = ☑" like the report page; row notes never
        // reach these rows, so a NOTES condition is named as skipped.
        if ($response && isset($response['data']) && is_array($response['data'])
            && isset($_GET['dsearch']) && trim((string)$_GET['dsearch']) !== '') {
            require_once __DIR__ . '/penumbra_search.php';
            $response['search_skipped'] = array();
            if (!empty($_dsCols)) {   // the rows' columns, or a rowless query's metadata (2026-10-01)
                $_dsRouted = penumbra_route_dash_search((string)$_GET['dsearch'], $_dsCols);
                if ($_dsRouted['text'] !== '' && !empty($response['data'])) {
                    $response['data'] = php_apply_search_filter($response['data'], 'standard', $_dsRouted['text'], null, $journal_toggle_resolver);
                }
                $response['search_skipped'] = $_dsRouted['skipped'];
            }
        }

        // Optional row cap (&limit=N), applied AFTER the saved sort so the caller
        // gets the TOP N of the report's own ordering, and BEFORE the column
        // visibility pass so both output paths below carry the sliced data.
        // total_rows is added ONLY when a limit actually trims - an additive key,
        // so existing json consumers are untouched. Dashboard table tiles use this
        // to fetch 10 rows instead of the whole report.
        if ($response && isset($response['data']) && is_array($response['data'])
            && isset($_GET['limit']) && is_numeric($_GET['limit']) && (int)$_GET['limit'] > 0
            && count($response['data']) > (int)$_GET['limit']) {
            $response['total_rows'] = count($response['data']);
            $response['data'] = array_slice($response['data'], 0, (int)$_GET['limit']);
        }

        // Only process if we have valid data and state settings
        if ($response && isset($response['data']) && !empty($response['data']) && (isset($state['visibleColumns']) || isset($state['columnOrder']))) {
            
            // 1. Map Indices to Actual Column Names (0 => 'COL_A', 1 => 'COL_B')
            // We use the first row of data to establish this mapping.
            $first_row_keys = array_keys($response['data'][0]);
            
            // 2. Determine Visible Columns (Default to all if not set)
            $visible_indices = [];
            if (isset($state['visibleColumns']) && is_array($state['visibleColumns'])) {
                // Filter out '#' and keep only valid numeric indices
                foreach ($state['visibleColumns'] as $idx) {
                    if ($idx !== '#' && is_numeric($idx) && isset($first_row_keys[(int)$idx])) {
                        $visible_indices[] = (int)$idx;
                    }
                }
            } else {
                // If no visibility settings, all columns are visible
                $visible_indices = array_keys($first_row_keys);
            }

            // 3. Determine Column Order
            // Start with the saved order, but filter to only include columns that are actually visible
            $final_column_order = [];
            
            if (isset($state['columnOrder']) && is_array($state['columnOrder'])) {
                foreach ($state['columnOrder'] as $idx) {
                    // Only add if it's numeric, exists in the dataset, AND is marked as visible
                    if (is_numeric($idx) && isset($first_row_keys[(int)$idx]) && in_array((int)$idx, $visible_indices)) {
                        $final_column_order[] = $first_row_keys[(int)$idx];
                    }
                }
                
                // Edge Case: If visible columns exist that weren't in the order list (e.g. new columns), append them
                foreach ($visible_indices as $idx) {
                    $col_name = $first_row_keys[$idx];
                    if (!in_array($col_name, $final_column_order)) {
                        $final_column_order[] = $col_name;
                    }
                }
            } else {
                // If no order is saved, just use the visible list in default index order
                sort($visible_indices);
                foreach ($visible_indices as $idx) {
                    $final_column_order[] = $first_row_keys[$idx];
                }
            }

            // Keep the appended journal toggle columns (non-indexed sentinels) at
            // the very end so the reorder doesn't drop them.
            foreach ($journal_toggle_cols as $jc) {
                if (!in_array($jc, $final_column_order, true)) $final_column_order[] = $jc;
            }

            // 4. Rebuild the Data Array
            // We map over the rows and create a new array for each, ensuring order and visibility
            $processed_data = array_map(function($row) use ($final_column_order) {
                $new_row = [];
                foreach ($final_column_order as $col_name) {
                    // Use array_key_exists to handle null values correctly
                    if (array_key_exists($col_name, $row)) {
                        $new_row[$col_name] = $row[$col_name];
                    }
                }
                return $new_row;
            }, $response['data']);

            // Replace the data in the response
            $response['data'] = $processed_data;

            // --- NEW: APPLY GROUP MODE ---
            if (isset($state['groupBy']) && !empty($state['groupBy'])) {
                $group_col = strtoupper($state['groupBy']);
                
                // Find the exact column key in the dataset (handle case sensitivity)
                $actual_group_key = null;
                // Check the first row of the *processed* data
                $sample_row = reset($response['data']); 
                if ($sample_row) {
                    foreach (array_keys($sample_row) as $k) {
                        if (strtoupper($k) === $group_col) {
                            $actual_group_key = $k;
                            break;
                        }
                    }
                }

                if ($actual_group_key) {
                    $grouped_data = [];
                    foreach ($response['data'] as $row) {
                        // Get the value to group by, default to '[Blank]' if null/empty
                        $val = isset($row[$actual_group_key]) ? $row[$actual_group_key] : '';
                        if ($val === '' || $val === null) { $val = '[Blank]'; }
                        
                        if (!isset($grouped_data[$val])) {
                            $grouped_data[$val] = [];
                        }
                        $grouped_data[$val][] = $row;
                    }
                    
                    // Replace the flat data with the grouped data
                    $response['data'] = $grouped_data;
                    
                    // Set metadata so the stub knows to render it as grouped
                    $response['viewMode'] = 'grouped';
                    $response['groupedBy'] = $actual_group_key;
                    
                    // Sort the groups alphabetically by key
                    ksort($response['data']);
                }
            }
            
            // Output the modified JSON
            ob_end_clean(); // Clean any previous buffer just in case
            header('Content-Type: application/json');
            $json_output = json_encode($response);
            if ($json_output === false) {
                error_log("PENUMBRA json_encode failed in index.php API path (error: " . json_last_error_msg() . ")");
                $json_output = json_encode($response, JSON_PARTIAL_OUTPUT_ON_ERROR);
            }
            if ($json_output === false) {
                http_response_code(500);
                echo json_encode(["error" => "Failed to encode response as JSON."]);
            } else {
                echo $json_output;
            }
            exit;
        }

        // No column visibility/order to apply. Re-encode $response rather than
        // echoing the ORIGINAL string: everything done since it was captured -
        // journal toggle injection, the saved sortCriteria, debug stripping - lives
        // in $response, and echoing $raw_json silently discarded all of it. A report
        // saved without ever hiding or reordering a column (both keys absent) took
        // this path, so its API output lost the toggle columns AND its sort order.
        ob_end_clean();
        header('Content-Type: application/json');
        // If the original payload could not be decoded there is nothing to re-encode,
        // so pass the upstream bytes through untouched rather than emitting "null".
        $fallback_json = is_array($response) ? json_encode($response) : false;
        echo ($fallback_json === false) ? $raw_json : $fallback_json;
        exit;
    } else {
        header('Content-Type: application/json');
        http_response_code(404);
        echo json_encode(["error" => "Report not found or access denied."]);
        exit;
    }
}

// --- RESTRICTED MODE GUARD ---
// If we are in restricted mode and have reached this point, it means the 
// JSON block above was skipped (likely due to missing 'id' or 'state' params).
// We must NOT render HTML.
if ($isRestrictedJsonMode) {
    header('Content-Type: application/json');
    http_response_code(400); // Bad Request
    echo json_encode(["error" => "Missing required parameters (x4041)."]);
    exit;
}

// --- SECURITY: TABLE WHITELIST REDUCTION ---
// Non-admins are scoped to (their configured sql grants) UNION (the loaded
// report's own tables). With no report loaded and no grants, every list is
// wiped (New Query mode shows no tables); a granted power user still sees their
// granted tables. This uses the SAME resolver as the server-side enforcement in
// query.php (penumbraApplySqlScope), so the UI can never show a table the
// backend would refuse to run.
if (!$isAdmin) {
    $reportTables = ($preloaded_state_json !== 'null')
        ? penumbraExtractReportTables($preloaded_state_json)
        : array();
    penumbraApplySqlScope($userGrants, $reportTables);
}
    
