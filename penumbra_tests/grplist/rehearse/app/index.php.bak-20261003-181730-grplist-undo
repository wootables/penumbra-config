<?php
// --- LANDING PAGE DATA FETCH ---
$recent_reports = [];
$platform_kpi = null;
$pulse_hourly = array_fill(0, 24, 0);   // opens per hour-of-day, last 30 days
$pulse_daily = array();                  // opens per day, last 30 days (oldest first)
$pulse_peak_label = '';                  // e.g. "9 am - 12 pm"
$pulse_views_delta = null;               // % change vs the previous 30-day window
$pnl_load_error = false;                 // pulse queries failed; show friendly notice
$pnl_updated_rows = array();             // recents with LAST_UPDATED > LAST_OPENED ("For you" rail)
$pnl_deliveries = array();               // active email schedules that deliver to this user
$pnl_new_reports = array();              // admin rail: reports created in the last 7 days
$pnl_task_errors = array();              // admin rail: scheduler failure audits, last 7 days
if (!isset($_GET['id']) && !isset($_GET['state']) && !$isRepoMode && !empty($currentUserKey)) {
    // Push everything rendered so far - including the landing splash - out to
    // the browser so it is visible while the pulse queries below run.
    // (Best-effort: front-end buffering such as IIS responseBufferLimit can
    // still hold the response; the splash then covers parse-to-ready only.)
    while (ob_get_level() > 0) { @ob_end_flush(); }
    @flush();
    try {
        // 1. Ensure DB connection exists
        // Use connectOracle() directly - getConnectionForTable() relies on the
        // table whitelist which is reduced to report-specific tables for non-admins.
        // On the landing page no report is loaded so the whitelist is empty.
        if (!isset($oracleConn) || empty($oracleConn)) {
            $oracleConn = connectOracle();
        }
        if ($oracleConn) {
            // 2. Sanitize User ID
            $safeKey = preg_replace('/[^a-zA-Z0-9_.-]/', '', $currentUserKey);

            // 2b. Audit this landing-page visit (ACTION='OPEN' against the reserved
            // __HOME__ placeholder report) so analytics.php?id=__HOME__ shows home
            // traffic. Skip API / restricted-JSON callers - only real human page
            // loads count. Best-effort; never breaks the render.
            if (!$isRestrictedJsonMode && !isset($_GET['json']) && $currentUserKey !== 'DEV_API'
                && function_exists('penumbraLogHomeVisit')) {
                penumbraLogHomeVisit();
            }

            // 2c. Page-visit placeholders (2026-09-16). $pnlSysIdSql lists every
            // placeholder SHORT_ID (__HOME__ + the admin tools') for the queries
            // that list REPORTS. $pnlToolExcl drops only the admin-tool placeholders
            // from the pulse aggregates below: __HOME__ opens are counted there by
            // design, and tool views must not move those numbers. Both are
            // constants/ints, safe to inline.
            $pnlSysIdSql = penumbraShortIdSqlList(penumbraSystemShortIds());
            $pnlToolExcl = penumbraExcludeReportIdsSql(penumbraToolReportIds());

            // 3. Fetch last 30 unique opened reports
            // Use TO_CHAR to format the date inside the DB.
            // This returns a clean string like "2025-12-16 20:34:38" that PHP handles natively.
            // Fetches extra rows because pinned reports (localStorage, so unknown
            // server-side) are deduped out of "Last opened" client-side.
            // LAST_UPDATED powers the "updated since you last opened it" badge.
            $audit_sql = "
                SELECT r.SHORT_ID, r.TITLE,
                       TO_CHAR(MAX(a.TIMESTAMP), 'YYYY-MM-DD HH24:MI:SS') as LAST_OPENED,
                       TO_CHAR(MAX(r.UPDATED_AT), 'YYYY-MM-DD HH24:MI:SS') as LAST_UPDATED
                FROM PENUMBRA_AUDIT a
                JOIN PENUMBRA_REPORTS r ON a.REPORT_ID = r.ID
                WHERE a.USER_ID = '$safeKey'
                AND a.ACTION = 'OPEN'
                AND TRIM(r.SHORT_ID) NOT IN ($pnlSysIdSql)
                GROUP BY r.SHORT_ID, r.TITLE
                ORDER BY LAST_OPENED DESC
                FETCH FIRST 30 ROWS ONLY
            ";

            $stmt = $oracleConn->prepare($audit_sql);
            $stmt->execute();

            // 4. Manual Fetch Loop
            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                $recent_reports[] = array_change_key_case($row, CASE_UPPER);
            }

            // 4b. Reports that changed since this user last opened them - the
            // same rule as the per-row "updated" badge, hoisted so the personal
            // strip tile and the "For you" rail block can surface it. Only
            // reports the user has already opened qualify (need-to-know).
            foreach ($recent_reports as $pnlUr) {
                $pnlUrO = strtotime($pnlUr['LAST_OPENED']);
                $pnlUrU = !empty($pnlUr['LAST_UPDATED']) ? strtotime($pnlUr['LAST_UPDATED']) : 0;
                if ($pnlUrU && $pnlUrO && $pnlUrU > $pnlUrO) {
                    $pnl_updated_rows[] = array(
                        'sid'   => $pnlUr['SHORT_ID'],
                        'title' => strip_tags($pnlUr['TITLE']),
                        'ts'    => $pnlUrU * 1000
                    );
                }
            }

            // 5. Platform pulse KPIs (audit-table aggregates, one round trip)
            $kpi_sql = "
                SELECT
                    (SELECT COUNT(DISTINCT REPORT_ID) FROM PENUMBRA_AUDIT
                       WHERE 1=1 $pnlToolExcl) AS ACTIVE_REPORTS,
                    (SELECT COUNT(DISTINCT USER_ID) FROM PENUMBRA_AUDIT
                       WHERE TIMESTAMP > SYSDATE - 30 $pnlToolExcl) AS UNIQUE_USERS_30D,
                    (SELECT COUNT(*) FROM PENUMBRA_AUDIT
                       WHERE ACTION = 'OPEN' AND TIMESTAMP > SYSDATE - 30 $pnlToolExcl) AS VIEWS_30D,
                    (SELECT COUNT(*) FROM PENUMBRA_AUDIT
                       WHERE ACTION = 'OPEN' AND TIMESTAMP <= SYSDATE - 30
                         AND TIMESTAMP > SYSDATE - 60 $pnlToolExcl) AS VIEWS_PREV_30D,
                    (SELECT COUNT(*) FROM PENUMBRA_REPORTS
                       WHERE CREATED_AT > SYSDATE - 7
                         AND TRIM(SHORT_ID) NOT IN ($pnlSysIdSql)) AS NEW_REPORTS_7D,
                    (SELECT COUNT(*) FROM PENUMBRA_AUDIT
                       WHERE ACTION = 'OPEN' AND USER_ID = '$safeKey'
                         AND TIMESTAMP > SYSDATE - 30 $pnlToolExcl) AS MY_OPENS_30D
                FROM DUAL
            ";
            $kpiStmt = $oracleConn->prepare($kpi_sql);
            $kpiStmt->execute();
            $kpiRow = $kpiStmt->fetch(PDO::FETCH_ASSOC);
            if ($kpiRow) {
                $platform_kpi = array_change_key_case($kpiRow, CASE_UPPER);
                $pv = (int)$platform_kpi['VIEWS_PREV_30D'];
                if ($pv > 0) {
                    $pulse_views_delta = (int)round((((int)$platform_kpi['VIEWS_30D'] - $pv) / $pv) * 100);
                }
            }

            // 5b. "For you" deliveries: active EMAIL schedules that actually
            // deliver to THIS user, next-run first. SQL prefilters cheaply on
            // the CLOBs (false positives fine); PHP then applies the same
            // receiving rules as the per-report Subscribe payload above -
            // typed recipient who hasn't opted out, or an OPTIONS subscriber.
            // Own try/catch: a failure here just hides the rail block.
            try {
                $pnlFyMail = isset($_SERVER['HTTP_SHIB_MAIL']) ? strtolower(trim($_SERVER['HTTP_SHIB_MAIL'])) : '';
                if (!filter_var($pnlFyMail, FILTER_VALIDATE_EMAIL)) {
                    $pnlFyMail = (preg_match('/^[A-Za-z0-9._-]+$/', (string)$currentUserKey))
                        ? strtolower($currentUserKey) . '@ncsu.edu' : '';
                }
                $pnlFyUid = strtolower(trim((string)$currentUserKey));
                if ($pnlFyMail !== '' && function_exists('penumbra_recipients_email_set')) {
                    $pnlFyStmt = $oracleConn->prepare(
                        "SELECT t.SUBJECT, t.CRON_EXPRESSION, t.RECIPIENTS, t.OPTIONS,
                                TRIM(t.REPORT_ID) AS REPORT_ID, r.TITLE,
                                TO_CHAR(t.NEXT_RUN, 'YYYY-MM-DD HH24:MI:SS') AS NEXT_RUN_TS
                           FROM NC_REPORTING.PENUMBRA_SCHEDULED_TASKS t
                           LEFT JOIN PENUMBRA_REPORTS r ON TRIM(r.SHORT_ID) = TRIM(t.REPORT_ID)
                          WHERE t.TASK_TYPE = 'EMAIL' AND t.IS_ACTIVE = 1
                            AND (DBMS_LOB.INSTR(UPPER(t.RECIPIENTS), UPPER(:fymail1), 1, 1) > 0
                                 OR DBMS_LOB.INSTR(LOWER(t.OPTIONS), '\"email\":\"' || :fymail2 || '\"', 1, 1) > 0
                                 OR DBMS_LOB.INSTR(LOWER(t.OPTIONS), '\"uid\":\"' || :fyuid1 || '\"', 1, 1) > 0)
                          ORDER BY t.NEXT_RUN ASC NULLS LAST
                          FETCH FIRST 12 ROWS ONLY");
                    $pnlFyStmt->bindValue(':fymail1', $pnlFyMail);
                    $pnlFyStmt->bindValue(':fymail2', $pnlFyMail);
                    $pnlFyStmt->bindValue(':fyuid1', $pnlFyUid);
                    $pnlFyStmt->execute();
                    while ($pnlFyRow = $pnlFyStmt->fetch(PDO::FETCH_ASSOC)) {
                        $pnlFyRow = array_change_key_case($pnlFyRow, CASE_UPPER);
                        $pnlFyOptsRaw = is_resource($pnlFyRow['OPTIONS']) ? stream_get_contents($pnlFyRow['OPTIONS']) : $pnlFyRow['OPTIONS'];
                        $pnlFyOpts = json_decode((string)$pnlFyOptsRaw, true);
                        if (is_array($pnlFyOpts) && !empty($pnlFyOpts['_test_run_transient'])) continue;
                        $pnlFySub = false;
                        if (is_array($pnlFyOpts) && isset($pnlFyOpts['subscribers']) && is_array($pnlFyOpts['subscribers'])) {
                            foreach ($pnlFyOpts['subscribers'] as $pnlFyEnt) {
                                if (!is_array($pnlFyEnt)) continue;
                                $pnlFyEntUid  = isset($pnlFyEnt['uid']) ? strtolower(trim((string)$pnlFyEnt['uid'])) : '';
                                $pnlFyEntMail = isset($pnlFyEnt['email']) ? strtolower(trim((string)$pnlFyEnt['email'])) : '';
                                if (($pnlFyEntUid !== '' && $pnlFyEntUid === $pnlFyUid)
                                    || ($pnlFyEntMail !== '' && $pnlFyEntMail === $pnlFyMail)) { $pnlFySub = true; break; }
                            }
                        }
                        $pnlFyRecipRaw = is_resource($pnlFyRow['RECIPIENTS']) ? stream_get_contents($pnlFyRow['RECIPIENTS']) : $pnlFyRow['RECIPIENTS'];
                        $pnlFyTypedSet = penumbra_recipients_email_set((string)$pnlFyRecipRaw);
                        $pnlFyIsTyped  = isset($pnlFyTypedSet[$pnlFyMail]);
                        $pnlFySuppressed = false;
                        if (is_array($pnlFyOpts) && isset($pnlFyOpts['suppressed']) && is_array($pnlFyOpts['suppressed'])) {
                            foreach ($pnlFyOpts['suppressed'] as $pnlFySupE) {
                                if (strtolower(trim((string)$pnlFySupE)) === $pnlFyMail) { $pnlFySuppressed = true; break; }
                            }
                        }
                        if ($pnlFySub || ($pnlFyIsTyped && !$pnlFySuppressed)) {
                            $pnlFyTitle = ($pnlFyRow['TITLE'] !== null && trim((string)$pnlFyRow['TITLE']) !== '')
                                ? strip_tags((string)$pnlFyRow['TITLE']) : (string)$pnlFyRow['SUBJECT'];
                            $pnl_deliveries[] = array(
                                'report_id' => (string)$pnlFyRow['REPORT_ID'],
                                'title'     => $pnlFyTitle,
                                'next_ts'   => $pnlFyRow['NEXT_RUN_TS'] ? strtotime($pnlFyRow['NEXT_RUN_TS']) : 0,
                                'schedule'  => penumbra_cron_human((string)$pnlFyRow['CRON_EXPRESSION'])
                            );
                        }
                    }
                }
            } catch (Exception $pnlFyEx) {
                $pnl_deliveries = array();   // block hides; pulse still renders
            }

            // 5c. Admin rail extras. "New in the repository" mirrors the
            // band's NEW_REPORTS_7D window as actual rows; "Recent task
            // errors" reads the scheduler failure audits (schedule_runner's
            // log_penumbra_scheduler_audit writes ACTION = SCHEDULE_FAIL /
            // SCHEDULE_RUN_FAIL / SCHEDULE_NOAUTH with the numeric report
            // id). Admin-only surfaces: report discovery is fine here.
            if ($isAdmin) {
                try {
                    $pnlNrStmt = $oracleConn->prepare(
                        "SELECT SHORT_ID, TITLE, TO_CHAR(CREATED_AT, 'YYYY-MM-DD HH24:MI:SS') AS CREATED_TS
                           FROM PENUMBRA_REPORTS
                          WHERE CREATED_AT > SYSDATE - 7
                            AND TRIM(SHORT_ID) NOT IN ($pnlSysIdSql)
                          ORDER BY CREATED_AT DESC
                          FETCH FIRST 4 ROWS ONLY");
                    $pnlNrStmt->execute();
                    while ($pnlNrRow = $pnlNrStmt->fetch(PDO::FETCH_ASSOC)) {
                        $pnlNrRow = array_change_key_case($pnlNrRow, CASE_UPPER);
                        $pnl_new_reports[] = array(
                            'sid'   => trim((string)$pnlNrRow['SHORT_ID']),
                            'title' => strip_tags((string)$pnlNrRow['TITLE']),
                            'ts'    => $pnlNrRow['CREATED_TS'] ? strtotime($pnlNrRow['CREATED_TS']) * 1000 : 0
                        );
                    }
                } catch (Exception $pnlNrEx) { $pnl_new_reports = array(); }
                try {
                    $pnlTeStmt = $oracleConn->prepare(
                        "SELECT a.ACTION, r.SHORT_ID, r.TITLE,
                                TO_CHAR(a.TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS') AS ERR_TS
                           FROM PENUMBRA_AUDIT a
                           LEFT JOIN PENUMBRA_REPORTS r ON a.REPORT_ID = r.ID
                          WHERE a.ACTION IN ('SCHEDULE_FAIL', 'SCHEDULE_RUN_FAIL', 'SCHEDULE_NOAUTH')
                            AND a.TIMESTAMP > SYSDATE - 7
                          ORDER BY a.TIMESTAMP DESC
                          FETCH FIRST 4 ROWS ONLY");
                    $pnlTeStmt->execute();
                    while ($pnlTeRow = $pnlTeStmt->fetch(PDO::FETCH_ASSOC)) {
                        $pnlTeRow = array_change_key_case($pnlTeRow, CASE_UPPER);
                        $pnl_task_errors[] = array(
                            'sid'    => $pnlTeRow['SHORT_ID'] !== null ? trim((string)$pnlTeRow['SHORT_ID']) : '',
                            'title'  => ($pnlTeRow['TITLE'] !== null && trim((string)$pnlTeRow['TITLE']) !== '')
                                            ? strip_tags((string)$pnlTeRow['TITLE']) : 'Deleted report',
                            'action' => (string)$pnlTeRow['ACTION'],
                            'ts'     => $pnlTeRow['ERR_TS'] ? strtotime($pnlTeRow['ERR_TS']) * 1000 : 0
                        );
                    }
                } catch (Exception $pnlTeEx) { $pnl_task_errors = array(); }
            }

            // 5b. Admin rail: system health.
            // Renders the SAME snapshot health.php and the admin console's runner
            // pill use (penumbra_health.php), so "scheduler offline" can never be
            // true on one surface and false on another.
            //
            // CHEAP SIGNALS ONLY (probe_dbs => false): a live database probe can
            // block for 60-90s on a dead Oracle listener (ORA-12170), which would
            // hang the home page. Database status comes from the cache that
            // health.php?full=1 writes - stale is acceptable here, hanging is not.
            $pnl_health = null;
            if ($isAdmin) {
                try {
                    require_once 'penumbra_health.php';
                    $pnl_health = penumbra_health_snapshot(array('probe_dbs' => false, 'error_hours' => 24));
                } catch (Exception $pnlHEx) { $pnl_health = null; }
            }

            // 6. Busiest hours: opens per hour-of-day over the last 30 days
            $hr_sql = "
                SELECT TO_CHAR(TIMESTAMP, 'HH24') AS HR, COUNT(*) AS CNT
                FROM PENUMBRA_AUDIT
                WHERE ACTION = 'OPEN' AND TIMESTAMP > SYSDATE - 30 $pnlToolExcl
                GROUP BY TO_CHAR(TIMESTAMP, 'HH24')
            ";
            $hrStmt = $oracleConn->prepare($hr_sql);
            $hrStmt->execute();
            while ($row = $hrStmt->fetch(PDO::FETCH_ASSOC)) {
                $row = array_change_key_case($row, CASE_UPPER);
                $h = (int)$row['HR'];
                if ($h >= 0 && $h <= 23) {
                    $pulse_hourly[$h] = (int)$row['CNT'];
                }
            }
            // Peak label = busiest consecutive 3-hour window
            $bestStart = 9; $bestSum = -1;
            for ($h = 0; $h <= 21; $h++) {
                $s = $pulse_hourly[$h] + $pulse_hourly[$h + 1] + $pulse_hourly[$h + 2];
                if ($s > $bestSum) { $bestSum = $s; $bestStart = $h; }
            }
            $pulse_peak_label = date('g a', mktime($bestStart, 0, 0))
                              . ' - ' . date('g a', mktime($bestStart + 3, 0, 0));

            // 7. Views-per-day sparkline (last 30 days, zero-filled)
            $day_sql = "
                SELECT TO_CHAR(TRUNC(TIMESTAMP), 'YYYY-MM-DD') AS D, COUNT(*) AS CNT
                FROM PENUMBRA_AUDIT
                WHERE ACTION = 'OPEN' AND TIMESTAMP > SYSDATE - 30 $pnlToolExcl
                GROUP BY TRUNC(TIMESTAMP)
            ";
            $dayStmt = $oracleConn->prepare($day_sql);
            $dayStmt->execute();
            $dayMap = array();
            while ($row = $dayStmt->fetch(PDO::FETCH_ASSOC)) {
                $row = array_change_key_case($row, CASE_UPPER);
                $dayMap[$row['D']] = (int)$row['CNT'];
            }
            for ($i = 29; $i >= 0; $i--) {
                $d = date('Y-m-d', strtotime("-$i days"));
                $pulse_daily[] = isset($dayMap[$d]) ? $dayMap[$d] : 0;
            }
        }
    } catch (Exception $e) {
        // Full detail goes to the PHP error log only - raw Oracle/exception
        // text must never reach the page. The landing still renders (pins and
        // history fill client-side); a friendly notice shows via $pnl_load_error.
        error_log("Penumbra Landing Page Error: " . $e->getMessage());
        $pnl_load_error = true;
    }
}

