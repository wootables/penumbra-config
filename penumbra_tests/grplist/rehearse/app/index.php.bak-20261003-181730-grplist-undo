                        <strong>Gantt</strong>
                        <div class="viz-option-desc">Timeline</div>
                    </div>
                    <div class="viz-type-option" role="option" aria-selected="false" data-type="map">
                        <svg viewBox="0 0 36 28"><rect class="viz-icon-fill" x="1" y="2" width="6" height="5" rx="1" fill="#336699" opacity="0.25"/><rect class="viz-icon-fill" x="8" y="2" width="6" height="5" rx="1" fill="#336699" opacity="0.5"/><rect class="viz-icon-fill" x="15" y="2" width="6" height="5" rx="1" fill="#336699" opacity="0.85"/><rect class="viz-icon-fill" x="22" y="2" width="6" height="5" rx="1" fill="#336699" opacity="0.4"/><rect class="viz-icon-fill" x="29" y="2" width="6" height="5" rx="1" fill="#336699" opacity="0.6"/><rect class="viz-icon-fill" x="1" y="9" width="6" height="5" rx="1" fill="#336699" opacity="0.6"/><rect class="viz-icon-fill" x="8" y="9" width="6" height="5" rx="1" fill="#336699" opacity="0.3"/><rect class="viz-icon-fill" x="15" y="9" width="6" height="5" rx="1" fill="#336699" opacity="0.75"/><rect class="viz-icon-fill" x="22" y="9" width="6" height="5" rx="1" fill="#336699" opacity="0.95"/><rect class="viz-icon-fill" x="29" y="9" width="6" height="5" rx="1" fill="#336699" opacity="0.35"/><rect class="viz-icon-fill" x="8" y="16" width="6" height="5" rx="1" fill="#336699" opacity="0.45"/><rect class="viz-icon-fill" x="15" y="16" width="6" height="5" rx="1" fill="#336699" opacity="0.7"/><rect class="viz-icon-fill" x="22" y="16" width="6" height="5" rx="1" fill="#336699" opacity="0.2"/><rect class="viz-icon-fill" x="15" y="23" width="6" height="4" rx="1" fill="#336699" opacity="0.55"/></svg>
                        <strong>Map</strong>
                        <div class="viz-option-desc">By State</div>
                    </div>
                </div>
                <!-- Position rail: with only 8 of the 17 tiles in view, this is
                     what says how far along the row you are. Sized and moved by
                     vizSyncCarousel(). -->
                <div class="viz-carou-rail" role="scrollbar" aria-controls="vizTypeSelector" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" title="Chart types: click to jump, drag to scroll"><i></i></div>
            </div>
            <button type="button" id="vizCarouNext" class="viz-carou-btn" aria-label="More chart types" title="More chart types">&#x203A;</button>
        </div>

        <!-- ============ CONFIGURATION TABS ============
             Four tabs. The first three are fixed; the fourth is CONTEXTUAL - it
             renames itself to the selected chart type and holds that type&#39;s own
             strip (Combo series, Map bands, Gantt end date, ...). That is what
             lets .viz-panes take a FIXED height: no strip can push the preview
             down any more. Every #viz* id below is unchanged - the fields were
             re-parented, not rewritten. ============ -->
        <div class="viz-tabs" role="tablist" aria-label="Chart settings">
            <button type="button" class="viz-tab active" role="tab" id="vizTabData" data-viz-tab="data" aria-selected="true" aria-controls="vizPaneData">Data</button>
            <button type="button" class="viz-tab" role="tab" id="vizTabAppearance" data-viz-tab="appearance" aria-selected="false" aria-controls="vizPaneAppearance">Appearance</button>
            <button type="button" class="viz-tab" role="tab" id="vizTabAxes" data-viz-tab="axes" aria-selected="false" aria-controls="vizPaneAxes">Axes &amp; Scale</button>
            <button type="button" class="viz-tab viz-tab-ctx" role="tab" id="vizTabType" data-viz-tab="type" aria-selected="false" aria-controls="vizPaneType" title="Settings that belong to the selected chart type">
                <span id="vizTabTypeLabel">Bar options</span>
                <span class="viz-tab-dot" id="vizTabTypeDot" hidden title="This chart type has settings of its own"></span>
            </button>
        </div>

        <div class="viz-panes" id="vizPanes">

            <!-- ---- DATA: what is plotted ---- -->
            <div class="viz-pane active" id="vizPaneData" role="tabpanel" aria-labelledby="vizTabData">
                <div class="viz-row">
                    <div class="viz-fld" id="vizXAxisFld" style="flex:1; min-width:0">
                        <span class="viz-lbl" id="vizXAxisLbl"><span class="viz-lbl-text">X-Axis</span> <span class="bld-help-icon" data-tip="viz-x-axis"></span></span>
                        <select id="vizXAxis" style="width:100%"><option value="">Select column...</option></select>
                    </div>
                    <div class="viz-fld" id="vizYAxisFld" style="flex:1; min-width:0">
                        <span class="viz-lbl" id="vizYAxisLbl"><span class="viz-lbl-text">Y-Axis</span> <span class="bld-help-icon" data-tip="viz-y-axis"></span></span>
                        <select id="vizYAxis" style="width:100%"><option value="">Select column...</option></select>
                    </div>
                    <div class="viz-fld" id="vizAggFld">
                        <span class="viz-lbl"><span class="viz-lbl-text">Aggregation</span> <span class="bld-help-icon" data-tip="viz-aggregation"></span></span>
                        <select id="vizAggregation">
                            <option value="sum" selected>Sum</option>
                            <option value="count">Count</option>
                            <option value="avg">Average</option>
                            <option value="min">Minimum</option>
                            <option value="max">Maximum</option>
                            <option value="median">Median</option>
                            <option value="distinct">Distinct Count</option>
                            <option value="running_total">Running Total</option>
                            <option value="running_count">Running Count</option>
                            <option value="stddev">Std Deviation</option>
                            <option value="range">Range (Max - Min)</option>
                            <option value="p10">P10 (10th percentile)</option>
                            <option value="p25">P25 (lower quartile)</option>
                            <option value="p75">P75 (upper quartile)</option>
                            <option value="p90">P90 (90th percentile)</option>
                            <option value="p95">P95 (95th percentile)</option>
                            <option value="p99">P99 (99th percentile)</option>
                            <option value="wavg">Weighted Average&hellip;</option>
                        </select>
                    </div>
                    <div class="viz-fld" id="vizWavgFld" style="display:none;">
                        <span class="viz-lbl"><span class="viz-lbl-text">Weight By</span></span>
                        <select id="vizWavgWeight" title="Weight each row by this column"></select>
                    </div>
                    <div class="viz-fld">
                        <span class="viz-lbl"><span class="viz-lbl-text">Group By</span> <span class="bld-help-icon" data-tip="viz-group-by"></span></span>
                        <select id="vizGroupBy"><option value="">No grouping</option></select>
                    </div>
                </div>
                <div class="viz-row">
                    <!-- Custom bin ranges for a NUMERIC X-Axis. Sits directly under
                         X-Axis because that is what it rewrites: typing cut points
                         here switches the axis to its COL:bins<e1>_<e2>... form -
                         the same token the pivot's "Custom ranges" split emits, and
                         one the chart engine already understood. Shown only when the
                         X-Axis column is numeric (see vizSyncBinEdgesUI). -->
                    <div class="viz-fld" id="vizBinEdgesFld" style="width:186px; display:none;">
                        <span class="viz-lbl"><span class="viz-lbl-text">Custom Ranges</span> <span class="bld-help-icon" data-tip="viz-bin-edges"></span></span>
                        <input type="text" id="vizBinEdges" placeholder="e.g. 100K, 250K, 1M" autocomplete="off" aria-label="Custom bin ranges for the X-Axis">
                    </div>
                    <div class="viz-fld" id="vizFilterExprFld" style="flex:2; min-width:0">
                        <span class="viz-lbl"><span class="viz-lbl-text">Filter Expression</span> <span class="bld-help-icon" data-tip="viz-filter-expression"></span></span>
                        <input type="text" id="vizFilterExpression" placeholder="e.g. STATUS = Active AND AMOUNT > 1000" style="width:100%" autocomplete="off" aria-label="Chart filter expression">
                    </div>
                    <div class="viz-fld" id="vizSortByFld">
                        <span class="viz-lbl"><span class="viz-lbl-text">Sort By</span> <span class="bld-help-icon" data-tip="viz-sort-by"></span></span>
                        <select id="vizSortBy">
                            <option value="value">Value (Y-Axis)</option>
                            <option value="label">Label (X-Axis)</option>
                            <!-- Gantt only. A timeline's "Value" IS the start date, so
                                 the LENGTH of a bar had no sort of its own: picking
                                 Value moved the bars by when they began while the day
                                 counts printed on them stayed in no visible order.
                                 Hidden for every other type (the same per-type option
                                 hiding the Values row already uses for scatter), and
                                 revealed by the Gantt branches in main.js. It lives in
                                 the markup rather than being injected so a saved chart
                                 with sortBy=duration always has an option to land on -
                                 .val() on a missing option is a silent no-op. -->
                            <option value="duration" style="display:none">Duration</option>
                        </select>
                    </div>
                    <div class="viz-fld" id="vizSortDirFld">
                        <span class="viz-lbl"><span class="viz-lbl-text">Sort Order</span> <span class="bld-help-icon" data-tip="viz-sort-order"></span></span>
                        <select id="vizSortDir">
                            <option value="desc">Desc</option>
                            <option value="asc">Asc</option>
                        </select>
                    </div>
                    <div class="viz-fld" id="vizLimitFld">
                        <span class="viz-lbl" id="vizLimitLbl"><span class="viz-lbl-text">Limit</span> <span class="bld-help-icon" data-tip="viz-limit"></span></span>
                        <input type="number" id="vizLimit" value="10" min="1" max="9999" style="width:62px">
                    </div>
                </div>
                <div class="viz-chip-row">
                    <div id="vizAllowFilterWrap">
                        <label class="viz-chip" data-tip="Let viewers filter the chart via its settings cog: by individual X-Axis categories and/or by Group values (whichever the chart type supports). Filter state is preserved on re-renders.">
                            <input type="checkbox" id="vizAllowFilter" checked> Allow Filtering
                        </label>
                    </div>
                    <label class="viz-chip" data-tip="Combine all categories beyond the Limit into a single 'Other' bar or slice, so totals reflect the full dataset.">
                        <input type="checkbox" id="vizOtherBucket"> +Other Bucket
                    </label>
                    <!-- Hidden state inputs: the combined "Allow Filtering" chip is
                         the user-facing control, but the underlying config still
                         stores separate filterXAxis / filterGroup flags (and the
                         chart-type handler disables them individually for types
                         that can't support each).  These inputs hold that state. -->
                    <input type="checkbox" id="vizFilterXAxis" checked style="display:none">
                    <input type="checkbox" id="vizFilterGroup" checked style="display:none">
                </div>
            </div>

            <!-- ---- APPEARANCE: how it reads ---- -->
            <div class="viz-pane" id="vizPaneAppearance" role="tabpanel" aria-labelledby="vizTabAppearance">
                <div class="viz-row">
                    <!-- col 1: auto-title button -->
                    <button id="autoTitleBtn" class="viz-auto-btn" title="Auto-generate title from selected columns">&#x26A1;</button>
                    <div class="viz-fld" style="flex:1">
                        <span class="viz-lbl"><span class="viz-lbl-text">Title</span> <span class="bld-help-icon" data-tip="viz-title"></span></span>
                        <input type="text" id="vizTitle" placeholder="Enter chart title...">
                    </div>
                    <div class="viz-fld" style="width:56px; flex-shrink:0">
                        <span class="viz-lbl"><span class="viz-lbl-text">Pos</span> <span class="bld-help-icon" data-tip="viz-title-pos"></span></span>
                        <select id="vizTitlePosition">
                            <option value="top" selected>Top</option>
                            <option value="bottom">Bottom</option>
                        </select>
                    </div>
                    <!-- flex:1.5, not grid-column. `.viz-row` is display:flex, so the
                         grid-column this carried was INERT - the field got no flex at
                         all, fell back to its content width and sat frozen at 160px no
                         matter how wide the panel grew (17% of the Title at a 1180px
                         panel). A subtitle usually carries the descriptive line and runs
                         LONGER than the title, so it now takes half again the Title's
                         share and grows with the panel like every other fluid field. -->
                    <div class="viz-fld" style="flex:1.5; min-width:0">
                        <span class="viz-lbl"><span class="viz-lbl-text">Subtitle</span> <span class="bld-help-icon" data-tip="viz-subtitle"></span></span>
                        <input type="text" id="vizSubtitle" placeholder="Subtitle...">
                    </div>
                </div>
                <div class="viz-row">
                    <div id="vizAxisLabelsRow" style="flex:2; min-width:0; display:flex; gap:7px; align-items:flex-end;">
                        <div class="viz-fld" style="flex:1; min-width:0">
                            <span class="viz-lbl"><span class="viz-lbl-text">X Label</span> <span class="bld-help-icon" data-tip="viz-x-label"></span></span>
                            <input type="text" id="vizXAxisLabel" placeholder="X-axis label...">
                        </div>
                        <div class="viz-fld" style="flex:1">
                            <span class="viz-lbl"><span class="viz-lbl-text">Y Label</span> <span class="bld-help-icon" data-tip="viz-y-label"></span></span>
                            <input type="text" id="vizYAxisLabel" placeholder="Y-axis label...">
                        </div>
                    </div>
                    <div class="viz-fld" style="width:96px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Legend</span> <span class="bld-help-icon" data-tip="viz-legend"></span></span>
                        <select id="vizLegend">
                            <option value="none">None</option>
                            <option value="top" selected>Top</option>
                            <option value="right">Right</option>
                            <option value="bottom">Bottom</option>
                            <option value="left">Left</option>
                        </select>
                    </div>
                    <div class="viz-fld" style="width:100px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Values</span> <span class="bld-help-icon" data-tip="viz-values"></span></span>
                        <select id="vizValues">
                            <option value="none">None</option>
                            <option value="end">Edge</option>
                            <option value="center">Center</option>
                            <option value="start">Base</option>
                            <option value="auto" selected>Auto</option>
                        </select>
                    </div>
                    <!-- Colours come from the THEME by default. This is a single
                         swatch choice, deliberately not a per-element colour
                         system: the theme stays the source of truth, and one
                         picker is a choice rather than a configuration surface.
                         (Per-series overrides live in the combo/butterfly series
                         list, where a series already has its own row.) -->
                    <div class="viz-fld" style="width:118px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Palette</span> <span class="bld-help-icon" data-tip="viz-palette"></span></span>
                        <select id="vizPalette">
                            <option value="auto" selected>Auto (theme)</option>
                            <option value="classic">Classic</option>
                            <option value="warm">Warm</option>
                            <option value="cool">Cool</option>
                            <option value="mono">Mono</option>
                        </select>
                    </div>
                    <!-- Number format. Every control defaults to Auto/blank, and
                         nothing is emitted into the vis() call until one of them
                         moves - so an untouched chart keeps the exact labels it
                         had before this row existed. -->
                    <div class="viz-fld" style="width:118px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Number</span> <span class="bld-help-icon" data-tip="viz-num-style"></span></span>
                        <select id="vizNumStyle">
                            <option value="auto" selected>Auto</option>
                            <option value="compact">Compact 1.2M</option>
                            <option value="plain">Full 1,234,567</option>
                            <option value="percent">Percent</option>
                        </select>
                    </div>
                    <div class="viz-fld" style="width:82px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Decimals</span> <span class="bld-help-icon" data-tip="viz-num-decimals"></span></span>
                        <!-- 0-6 covers the parser's whole accepted range, so a
                             snippet-authored value always has an option to land
                             on and cannot be silently dropped on re-save. -->
                        <select id="vizNumDecimals">
                            <option value="auto" selected>Auto</option>
                            <option value="0">0</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                            <option value="6">6</option>
                        </select>
                    </div>
                    <div class="viz-fld" style="width:74px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Prefix</span> <span class="bld-help-icon" data-tip="viz-num-prefix"></span></span>
                        <input type="text" id="vizNumPrefix" placeholder="auto" maxlength="8">
                    </div>
                    <div class="viz-fld" style="width:74px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Suffix</span> <span class="bld-help-icon" data-tip="viz-num-suffix"></span></span>
                        <input type="text" id="vizNumSuffix" placeholder="none" maxlength="8">
                    </div>
                    <div class="viz-fld" style="width:90px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Width</span> <span class="bld-help-icon" data-tip="viz-width"></span></span>
                        <input type="text" id="vizWidth" value="100%" title="Pixels (e.g. 800) or a responsive percentage of the space the snippet is given (e.g. 100%). No unit = pixels. New charts default to 100%.">
                    </div>
                    <div class="viz-fld" style="width:92px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Height</span> <span class="bld-help-icon" data-tip="viz-height"></span></span>
                        <input type="text" id="vizHeight" value="420" title="Pixels. Applies to snippet output, not the preview below. New charts get a height proportional to their width, which varies by chart type.">
                    </div>
                </div>
                <div class="viz-chip-row">
                    <!-- Layout group -->
                    <div id="vizHorizontalWrap">
                        <label class="viz-chip" data-tip="Rotate the chart so bars run left-to-right instead of bottom-to-top - useful when category names are long. Available for Bar, Line, Histogram and Box Plot. A Butterfly chart is already horizontal by definition, so it does not use this.">
                            <input type="checkbox" id="vizHorizontal"> Horizontal
                        </label>
                    </div>
                    <div id="vizFillWrap" style="display:none">
                        <label class="viz-chip" data-tip="Fill the area under a line chart to create an area chart. Only available for Line chart type.">
                            <input type="checkbox" id="vizFill"> Fill Area
                        </label>
                    </div>
                    <div id="vizStackedWrap">
                        <label class="viz-chip" data-tip="Stack grouped bars on top of each other instead of side-by-side. Requires Group By to be set. Enables Stack Order and Stack to 100% options.">
                            <input type="checkbox" id="vizStacked"> Stack Data
                        </label>
                    </div>
                    <div id="vizStackOptionsWrap" style="display:none">
                        <label class="viz-chip" data-tip="Normalise all stacks to 100% so each bar shows proportional share rather than absolute values. Requires Stack Data and Group By.">
                            <input type="checkbox" id="vizStackNormalize"> Stack to 100%
                        </label>
                    </div>
                    <span class="viz-chip-group-sep" aria-hidden="true"></span>
                    <!-- Display group -->
                    <div id="vizShowSettingsWrap">
                        <label class="viz-chip" data-tip="Show the settings cog icon on this chart. When unchecked, the cog is hidden so viewers see a cleaner chart - power users can still right-click the chart to access sort, filter, drill, fullscreen, and download options.">
                            <input type="checkbox" id="vizShowSettings" checked> Show Settings
                        </label>
                    </div>
                </div>
            </div>

            <!-- ---- AXES &amp; SCALE: the numeric treatment ---- -->
            <div class="viz-pane" id="vizPaneAxes" role="tabpanel" aria-labelledby="vizTabAxes">
                <div class="viz-row">
                    <div class="viz-fld" id="vizTrendWrap" style="width:120px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Trend Line</span> <span class="bld-help-icon" data-tip="viz-trend"></span></span>
                        <select id="vizTrendLine">
                            <option value="none">None</option>
                            <option value="ma3">Moving Avg (3)</option>
                            <option value="ma5">Moving Avg (5)</option>
                            <option value="ma7">Moving Avg (7)</option>
                            <option value="regression">Linear Regression</option>
                        </select>
                    </div>
                    <div class="viz-fld" id="vizRefLineWrap" style="width:150px">
                        <span class="viz-lbl"><span class="viz-lbl-text">Reference Line</span> <span class="bld-help-icon" data-tip="viz-refline"></span></span>
