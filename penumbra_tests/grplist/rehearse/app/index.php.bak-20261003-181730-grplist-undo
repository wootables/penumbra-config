                        <svg viewBox="0 0 36 28"><line x1="7" y1="3" x2="7" y2="25" class="viz-icon-line" stroke="#888" stroke-width="1.5"/><line x1="4" y1="3" x2="10" y2="3" class="viz-icon-line" stroke="#888" stroke-width="1.5"/><line x1="4" y1="25" x2="10" y2="25" class="viz-icon-line" stroke="#888" stroke-width="1.5"/><rect class="viz-icon-fill viz-icon-stroke" x="3" y="9" width="8" height="10" rx="1" fill="#336699" opacity="0.55" stroke="#336699"/><line x1="3" y1="14" x2="11" y2="14" class="viz-icon-stroke" stroke="#1b3a5c" stroke-width="2"/><line x1="19" y1="6" x2="19" y2="27" class="viz-icon-line" stroke="#888" stroke-width="1.5"/><line x1="16" y1="6" x2="22" y2="6" class="viz-icon-line" stroke="#888" stroke-width="1.5"/><line x1="16" y1="27" x2="22" y2="27" class="viz-icon-line" stroke="#888" stroke-width="1.5"/><rect class="viz-icon-fill viz-icon-stroke" x="15" y="12" width="8" height="9" rx="1" fill="#336699" opacity="0.55" stroke="#336699"/><line x1="15" y1="17" x2="23" y2="17" class="viz-icon-stroke" stroke="#1b3a5c" stroke-width="2"/><circle cx="19" cy="2" r="1.6" fill="none" class="viz-icon-line" stroke="#888"/><line x1="31" y1="8" x2="31" y2="24" class="viz-icon-line" stroke="#888" stroke-width="1.5"/><line x1="28" y1="8" x2="34" y2="8" class="viz-icon-line" stroke="#888" stroke-width="1.5"/><line x1="28" y1="24" x2="34" y2="24" class="viz-icon-line" stroke="#888" stroke-width="1.5"/><rect class="viz-icon-fill viz-icon-stroke" x="27" y="12" width="8" height="8" rx="1" fill="#336699" opacity="0.55" stroke="#336699"/><line x1="27" y1="16" x2="35" y2="16" class="viz-icon-stroke" stroke="#1b3a5c" stroke-width="2"/></svg>
