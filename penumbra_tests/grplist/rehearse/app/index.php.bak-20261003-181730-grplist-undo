(function () {
    // Dismiss the landing splash AFTER the jQuery ready queue (theme class,
    // pinned/recent list render) so the page behind the fade is fully dressed.
    // The setTimeout hop matters now that the bundle loads with `defer`
    // (2026-08-01): this inline listener registers BEFORE the deferred jQuery
    // executes, so at DOMContentLoaded it would otherwise fire first; jQuery 3
    // runs ready callbacks on a microtask, which the macrotask hop lets drain.
    function pnlSplashDismiss() {
        var el = document.getElementById('pnlSplash');
        if (!el) return;
        el.style.opacity = '0';
        setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 280);
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { setTimeout(pnlSplashDismiss, 0); });
    } else {
        setTimeout(pnlSplashDismiss, 0);
    }
})();
</script>
