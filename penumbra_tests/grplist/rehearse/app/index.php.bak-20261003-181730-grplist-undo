<?php /* --- CLIENT ERROR TELEMETRY (2026-08-18) ---------------------------------
     Until now a JS exception in the browser left NO trace anywhere: the user got
     a broken UI and we never learned. Server-side errors already reach
     php82_errors.log + the audit table + Analytics; this gives browser errors the
     same treatment via a CLIENT_ERROR audit row (see log_client_error.php).

     WHY INLINE, AND WHY HERE. Every app bundle below loads with `defer`, so it
     runs after this block no matter what. Installing here means the handler is
     already live when js/main.js executes and therefore catches main.js's OWN
     errors - which an external <script> listed alongside the others could not
     guarantee, and which are exactly the errors we most need to see. CSP is in
     enforce mode but allows 'unsafe-inline' for script-src, so this is compliant.

     ES5 ONLY - no const/let, arrow functions or template literals. An error
     handler that fails to parse on some browser is worse than none at all, since
     it would take the rest of this inline block down with it.

     Errors thrown by the two inline blocks ABOVE (the theme emitter and the
     penumbra_vars literal) are still missed; both are server-generated and
     effectively static, so that is an accepted gap rather than an oversight. */ ?>
<script>
(function () {
    'use strict';
    if (window.__pnbErrInstalled) { return; }
    window.__pnbErrInstalled = true;

    var ENDPOINT     = 'log_client_error.php';
    var MAX_PER_PAGE = 5;      // hard ceiling per page load
    var sentCount    = 0;
    var seen         = {};     // dedupe signature -> true

    // Path only. The query string is deliberately dropped: prompt values ride in
    // it and must not land in the audit table. The report id is pulled out
    // separately below because it is the one part worth keeping.
    function pagePath() {
        try { return String(window.location.pathname).slice(0, 300); } catch (e) { return ''; }
    }
    function reportId() {
        try {
            var m = /[?&]id=([^&#]*)/.exec(window.location.search);
            return m ? decodeURIComponent(m[1]).slice(0, 64) : '';
        } catch (e) { return ''; }
    }

    function send(payload) {
        if (sentCount >= MAX_PER_PAGE) { return; }
        // Key prefix keeps a message of "__proto__" from poisoning the map.
        var sig = 'k' + payload.message + '|' + payload.source + '|' + payload.line + '|' + payload.col;
        if (seen[sig]) { return; }
        seen[sig] = true;
        sentCount++;

        var body;
        try { body = JSON.stringify(payload); } catch (e) { return; }

        // sendBeacon survives an unload (an error thrown during navigation would
        // otherwise never be delivered); XHR is the fallback.
        try {
            if (window.navigator && navigator.sendBeacon) {
                if (navigator.sendBeacon(ENDPOINT, new Blob([body], { type: 'application/json' }))) { return; }
            }
        } catch (e) { /* fall through */ }
        try {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', ENDPOINT, true);
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.send(body);
        } catch (e) { /* telemetry must NEVER break the app */ }
    }

    function base(kind, message) {
        return { kind: kind, message: message, source: '', line: 0, col: 0, stack: '',
                 page: pagePath(), report: reportId(),
                 ua: (window.navigator && navigator.userAgent) ? navigator.userAgent : '' };
    }

    // Capture phase: resource-load errors (a 404'd lazy module) do NOT bubble,
    // so a listener on window without capture would never see them.
    window.addEventListener('error', function (ev) {
        try {
            if (ev && ev.target && ev.target !== window && ev.target.tagName) {
                var p = base('resource', 'Failed to load '
                    + String(ev.target.tagName).toLowerCase() + ': '
                    + String(ev.target.src || ev.target.href || '(unknown)'));
                send(p);
                return;
            }
            var q = base('error', (ev && ev.message) ? String(ev.message) : 'Unknown error');
            q.source = (ev && ev.filename) ? String(ev.filename) : '';
            q.line   = (ev && ev.lineno) ? ev.lineno : 0;
            q.col    = (ev && ev.colno) ? ev.colno : 0;
            q.stack  = (ev && ev.error && ev.error.stack) ? String(ev.error.stack) : '';
            send(q);
        } catch (e) { /* never rethrow from inside the error handler */ }
    }, true);

    // The browser's OWN view-transition aborts (2026-09-25). The admin tool pages
    // opt into cross-document transitions (penumbra_admin_chrome.php) and this
    // page does not, so moving between them makes Chromium reject its own
    // transition promises - "Transition was skipped", "Transition was aborted
    // because of invalid state. ViewTransition opt-in disabled" - with an
    // AbortError / InvalidStateError that no page code holds. Harmless, never
    // actionable: not recorded. Name AND message must match, so a real
    // AbortError from our own code still reports. (log_client_error.php drops
    // the same messages too, for pages still running an older copy of this.)
    function benignRejection(r, msg) {
        var n = (r && typeof r === 'object' && r.name) ? String(r.name) : '';
        return (n === 'AbortError' || n === 'InvalidStateError') && /transition/i.test(msg);
    }

    window.addEventListener('unhandledrejection', function (ev) {
        try {
            var r = ev ? ev.reason : null, msg = '', stk = '';
            if (r && typeof r === 'object') {
                msg = r.message ? String(r.message) : '';
                stk = r.stack ? String(r.stack) : '';
            }
            if (benignRejection(r, msg)) { return; }
            if (!msg) { try { msg = String(r); } catch (e2) { msg = 'Unhandled promise rejection'; } }
            var p = base('unhandledrejection', msg);
            p.stack = stk;
            send(p);
        } catch (e) { }
    });

    // Public hook for code that CATCHES an error but still wants it recorded -
    // this codebase has many defensive catch blocks that swallow silently.
    window.penumbraReportError = function (err, context) {
        try {
            var msg = (err && err.message) ? String(err.message) : String(err);
            var p = base('error', (context ? String(context) + ': ' : '') + msg);
            p.stack = (err && err.stack) ? String(err.stack) : '';
            send(p);
        } catch (e) { }
    };
})();
</script>
