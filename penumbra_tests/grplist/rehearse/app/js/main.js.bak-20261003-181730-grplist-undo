    // Server-side snapshot creation. Mirrors doCreateLocalSnapshot's row + metadata
    // collection, but persists to the central PENUMBRA_SNAPS store via
    // manage_snapshots.php (action=save) instead of localStorage. snap_data is stored
    // as raw (uncompressed) JSON so BOTH the unified loader (decompressString passes a
    // leading '[' / '{' straight through) and the macro compare path (raw JSON.parse)
    // can read it. onComplete fires on BOTH success and failure so a macro step that
    // waits on it (snapshot_create_server) never hangs.
    function doCreateServerSnapshot(snapshotName, snapshotNotes, reportId, $sourceRows, onComplete) {
        var done = (typeof onComplete === 'function') ? onComplete : function () {};

        if (!reportId) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No server report loaded. Save this report to the server first.</p>");
            done();
            return;
        }

        showLoading("Creating server snapshot...");

        setTimeout(async function () {
            try {
                // Build the row payload in the exact shape loadSnapshotData() expects:
                // an array of { signature, rowData } objects.
                var snapshotData = [];
                var signatureCounts = {};
                $sourceRows.each(function () {
                    var rowIndex = parseInt($(this).find("td[data-column='#']").text(), 10) - 1;
                    var rowDataMap = masterRowData[rowIndex];
                    if (rowDataMap) {
                        var baseSignature = generateRowSignature(rowDataMap);
                        signatureCounts[baseSignature] = (signatureCounts[baseSignature] || 0) + 1;
                        var uniqueSignature = signatureCounts[baseSignature] > 1
                            ? (baseSignature + '_' + (signatureCounts[baseSignature] - 1))
                            : baseSignature;
                        snapshotData.push({
                            signature: uniqueSignature,
                            rowData: (window.Penumbra && window.Penumbra.journalSnapshotRowData)
                                                ? window.Penumbra.journalSnapshotRowData(rowDataMap)
                                                : Object.fromEntries(rowDataMap)
                        });
                    }
                });

                if (snapshotData.length === 0) {
                    show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No visible rows to snapshot.</p>");
                    hideLoading();
                    done();
                    return;
                }

                // --- Metadata (mirrors doCreateLocalSnapshot) ---
                var totalColumns = 0;
                var visibleColumns = 0;
                var isGrouped = $('#groupedResultsContainer').is(':visible');
                if (isGrouped) {
                    totalColumns = $("#groupedResultsContainer .group-wrapper:first thead th[data-colname]").length;
                    visibleColumns = $("#groupedResultsContainer .group-wrapper:first thead th[data-colname]:visible").length;
                } else {
                    totalColumns = $("#tableHeader th[data-colname]").length;
                    visibleColumns = $("#tableHeader th[data-colname]:visible").length;
                }
                var columnCountString = totalColumns + " (" + visibleColumns + " visible)";

                var tablesUsedString = extractTablesFromQuery(editor.getValue());

                // Canonical SIG_<hash>_<count> signature, computed from the exact
                // rows being saved. The prior code stored a raw concatenation of
                // per-row signatures whose LENGTH scaled with row count and blew
                // past DATA_SIGNATURE's 200-char limit (ORA-12899) at ~19 rows -
                // and never matched the client's SIG_ badge format even when it fit.
                var dataSignature = _hashedSignatureFromSnapshotRows(snapshotData);

                // Uppercase column names for pre-compare validation (matches local).
                var snapshotColumnNames = [];
                if (snapshotData[0] && snapshotData[0].rowData) {
                    for (var colKey in snapshotData[0].rowData) {
                        if (snapshotData[0].rowData.hasOwnProperty(colKey)) {
                            var upperKey = colKey.toUpperCase();
                            if (upperKey !== '#') snapshotColumnNames.push(upperKey);
                        }
                    }
                    snapshotColumnNames.sort();
                }

                // Encrypt at rest if this report is password-protected (else unchanged).
                var snapDataToStore;
                try {
                    snapDataToStore = await encodeSnapDataForStorage(JSON.stringify(snapshotData));
                } catch (e) {
                    show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> " + escapeHtml(e.message || 'Could not secure snapshot.') + "</p>");
                    hideLoading();
                    done();
                    return;
                }

                $.ajax({
                    url: 'manage_snapshots.php',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        action: 'save',
                        report_id: reportId,
                        snap_name: snapshotName,
                        // Raw JSON (uncompressed, or PENUMBRA_GCM:: ciphertext for
                        // encrypted reports) - see decompressString()'s server-JSON branch.
                        snap_data: snapDataToStore,
                        row_count: snapshotData.length,
                        column_count: columnCountString,
                        tables_used: tablesUsedString,
                        search_term: $('#tableSearch').val().trim(),
                        data_signature: dataSignature,
                        notes: snapshotNotes || '',
                        column_names: snapshotColumnNames,
                        prompts: _captureCurrentPrompts()
                    }),
                    dataType: 'json',
                    success: function (resp) {
                        hideLoading();
                        if (resp && resp.status === 'success') {
                            show_text("<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Snapshot \"" + escapeHtml(snapshotName) + "\" saved to server.</p>");
                        } else {
                            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> " + escapeHtml((resp && resp.message) || 'Failed to create server snapshot.') + "</p>");
                        }
                        // The save response is passed through so a caller that
                        // needs the new snapshot's id (the feedback freeze) can
                        // read it. Existing callers take no arguments.
                        done(resp || null);
                    },
                    error: function (xhr) {
                        hideLoading();
                        var msg = 'Server error while creating snapshot.';
                        try { msg = JSON.parse(xhr.responseText).message || msg; } catch (e) {}
                        show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> " + escapeHtml(msg) + "</p>");
                        done(null);
                    }
                });
            } catch (e) {
                console.error("Server snapshot creation failed:", e);
                show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to create server snapshot. " + escapeHtml((e && e.message) || 'Unknown error') + "</p>");
                hideLoading();
                done();
            }
        }, 50);
    }

    // (Removed: dead pre-unified #deleteSnapshotBtn handler - delete is now wired from the unified detail drawer [data-snap-action="delete"].)
    function formatBytes(bytes, decimals = 2) {
        if (!+bytes)
            return '0 Bytes';
        const k = 1024;
        const dm = decimals < 0 ? 0 : decimals;
        const sizes = ['Bytes', 'KB', 'MB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
    }

