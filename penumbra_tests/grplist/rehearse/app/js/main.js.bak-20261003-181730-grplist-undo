        var currentRawSig = computeCurrentViewRawSignature();
        var currentHashedSig = computeCurrentViewHashedSignature();

        _unifiedSnapshots = [];

        localSnaps.forEach(function (snap) {
            var matches = !!(currentRawSig && snap.dataSignature && snap.dataSignature === currentRawSig);
            var colNames = snap.columnNames || [];
            _unifiedSnapshots.push({
                kind: 'local',
                key: String(snap.timestamp),
                sortDate: new Date(snap.timestamp),
                name: snap.name || '(unnamed)',
                creator: snap.creator || 'you',
                rowCount: snap.rowCount != null ? snap.rowCount : 0,
                colCount: colNames.length || snap.columnCount || 0,
