            return; // Allow normal link behavior (e.g. external href) when no jump target

        e.preventDefault();
        // Prevents the link from adding '#' to the URL

        // Find the scrollable parent container and the target element (the h4).
        // Inside the Help Center hub the pane scrolls, not the per-topic wrapper.
        let $scrollContainer = $(this).closest('#helpCenterContent');
        if (!$scrollContainer.length) $scrollContainer = $(this).closest('.lightbox-content');
        const $target = $scrollContainer.find('#' + targetId);

        if ($target.length && $scrollContainer.length) {
            // Account for any sticky header inside this lightbox.
            // Detect sticky via computed style so class-based stickies (e.g. .snap-help-sticky)
            // are picked up alongside inline-styled ones.
            var stickyOffset = 20; // default padding offset
            $scrollContainer.children().each(function () {
                var pos = window.getComputedStyle(this).position;
                if (pos === 'sticky' || pos === 'fixed') {
                    var h = $(this).outerHeight();
                    if (h > stickyOffset) stickyOffset = h + 10; // header height + breathing room
                }
            });
            // Also account for the active topic's own sticky header (nested inside
            // .help-topic > .lightbox-content, not a direct child of the pane).
            var $topicSticky = $scrollContainer.find('.help-topic.is-active [style*="position: sticky"], .help-topic.is-active .snap-help-sticky').first();
            if ($topicSticky.length) {
                var th = $topicSticky.outerHeight() + 10;
                if (th > stickyOffset) stickyOffset = th;
            }
            // Animate the scroll for a smooth effect. Use offset() deltas so the
            // math is correct regardless of positioned ancestors (the per-topic
            // .lightbox-content keeps position:relative inside the hub pane).
            $scrollContainer.animate({
                scrollTop: $scrollContainer.scrollTop() + ($target.offset().top - $scrollContainer.offset().top) - stickyOffset
            }, 300);
            // 300ms animation duration

            // Move screen-reader/keyboard context to the target heading (WCAG 2.4.3)
            // - preventScroll so the animate above stays the only scroller.
            $target.attr('tabindex', '-1');
