    // (Removed: dead pre-unified local-snapshot table selection + key-picker + rename handlers - they bound to #snapshotTableBody / #snapshotDetails / #renameSnapshotBtn, which no longer exist. The unified #unifiedSnapshotTableBody + detail-drawer handlers above are live.)
    /**
     * Locate each top-level CTE in a WITH clause and the exact span of its body.
     * (2026-08-12) Name-only CTE matching could not tell these two apart:
     *
     *     WITH accounts AS (SELECT * FROM accounts WHERE active = 1)
     *     SELECT * FROM accounts
     *
     * The inner reference is the REAL table (a CTE is not in scope inside its
     * own body), the outer one is the CTE. Dropping every occurrence by name
     * lost the real table entirely. Knowing where each body STARTS and ENDS is
     * what makes that distinction possible - see _isCteReference below.
     *
     * Returns [{ name, bodyStart, bodyEnd }] with bodyStart at the body's '('
     * and bodyEnd at its matching ')'. PHP twin: _pnb_parse_cte_spans().
     *
     * The optional `(col, col)` alias list is tolerated because Oracle requires
     * it on a RECURSIVE CTE, which is precisely the shape we must recognise.
     * `START WITH` (CONNECT BY) can never match: this demands `AS (` next.
     */
    function _pnbParseCteSpans(sql) {
        const spans = [];
        const head = sql.match(/\bWITH\s+([A-Z0-9_]+)\s*(?:\([^)]*\)\s*)?AS\s*\(/);
        if (!head) return spans;
        let name = head[1];
        let pos = head.index + head[0].length - 1;   // index of the body's '('
        // Bounded so a pathological/unbalanced query can never spin here.
        for (let guard = 0; guard < 200; guard++) {
            let depth = 0, i = pos;
            for (; i < sql.length; i++) {
                const ch = sql[i];
                if (ch === '(') depth++;
                else if (ch === ')') { depth--; if (depth === 0) break; }
            }
            if (i >= sql.length) break;              // unbalanced - stop, keep what we have
            spans.push({ name: name, bodyStart: pos, bodyEnd: i });
            const next = sql.slice(i + 1).match(/^\s*,\s*([A-Z0-9_]+)\s*(?:\([^)]*\)\s*)?AS\s*\(/);
            if (!next) break;
            name = next[1];
            pos = i + 1 + next[0].length - 1;
        }
        return spans;
    }

    /**
     * Is the reference to `name` at character offset `at` a CTE reference (so:
     * not a real table), given the CTE spans of this query?
     *
     * ONE rule covers every ordinary case: a CTE is in scope only AFTER its own
     * body closes. That makes `FROM a` inside a's body the real table, `FROM a`
     * inside a LATER sibling's body the CTE, and `FROM a` in the main query the
     * CTE - with no special-casing.
     *
     * The one legal exception is a RECURSIVE CTE, which does reference itself
     * from inside its own body, always after the UNION [ALL] that separates the
     * anchor member from the recursive member. So an in-body self-reference is
     * read as recursive when a UNION precedes it, and as a shadowed real table
     * otherwise. PHP twin: _pnb_is_cte_reference().
     */
    function _pnbIsCteReference(spans, name, at, sql) {
        for (let s = 0; s < spans.length; s++) {
            const span = spans[s];
            if (span.name !== name) continue;
            if (at > span.bodyEnd) return true;                 // in scope
            if (at > span.bodyStart && at < span.bodyEnd) {     // inside its own body
                return /\bUNION\b/.test(sql.slice(span.bodyStart, at));
            }
        }
        return false;
    }

    /**
     * Robustly parses table names from a query string, ignoring comments, strings, and tags.
     */
    function extractTablesFromQuery(rawSql) {
        if (!rawSql) return 'N/A';

        // 1. Strip Strings (Replace with space to avoid false positives like 'Select From Date')
        // Regex matches '...' allowing for escaped quotes ''
        let clean = rawSql.replace(/'(?:''|[^'])*'/g, ' ');

        // 2. Strip Block Comments (/* ... */)
        clean = clean.replace(/\/\*[\s\S]*?\*\//g, ' ');

        // 3. Strip Line Comments (-- ...)
        clean = clean.replace(/--.*/g, ' ');

        // 4. Strip Penumbra Tags ([PROMPT...], [SUBQUERY...])
        // We use a simple greedy match for brackets to catch message="From date"
        clean = clean.replace(/\[[^\]]*\]/g, ' ');

        // 5. Normalize to Uppercase for keyword matching
        clean = clean.toUpperCase();

        // 5b. Map the CTEs and their body spans so `with awards as (...) select
        //     * from awards` doesn't report AWARDS as a table. They are
        //     query-local aliases, not objects anyone can go look at, and
        //     listing them made the snapshot's "Tables" line actively
        //     misleading. Scope-aware (not name-only) so a CTE that SHADOWS a
        //     real table still reports the real table - see _pnbParseCteSpans.
        const cteSpans = _pnbParseCteSpans(clean);

        const tablesUsed = new Set();
        // Regex looks for FROM or JOIN, followed by whitespace, followed by a valid table identifier
        // Handles: FROM TABLE, FROM SCHEMA.TABLE, JOIN TABLE
        // The leading group captures the word BEFORE the keyword so the
        // "FROM is an argument separator" forms can be rejected below.
        const tableRegex = /([a-zA-Z0-9_]+)?\s*(?:FROM|JOIN)\s+([a-zA-Z0-9_]+(?:\.[a-zA-Z0-9_]+)?)/g;

        // SQL uses FROM as an ARGUMENT SEPARATOR inside several functions, where
        // what follows is a COLUMN, not a table: EXTRACT(YEAR FROM S.LOG_DATE),
        // TRIM(LEADING '0' FROM CODE), SUBSTRING(X FROM 1 FOR 2), POSITION(A IN B).
        // Un-guarded, EXTRACT(YEAR FROM S.LOG_DATE) reported LOG_DATE as a table.
        const fromIsArgSeparator = new Set([
            'YEAR', 'MONTH', 'DAY', 'HOUR', 'MINUTE', 'SECOND', 'WEEK', 'QUARTER',
            'DOW', 'DOY', 'EPOCH', 'TIMEZONE_HOUR', 'TIMEZONE_MINUTE', 'TIMEZONE_REGION',
            'TIMEZONE_ABBR', 'LEADING', 'TRAILING', 'BOTH'
        ]);

        let match;
        while ((match = tableRegex.exec(clean)) !== null) {
            const prevWord = match[1] || '';
            if (fromIsArgSeparator.has(prevWord)) continue;

            // Remove schema prefix if present (e.g. DBO.USERS -> USERS)
            const fullName = match[2];
            const tableName = fullName.includes('.') ? fullName.split('.')[1] : fullName;

            // A SQL identifier can never start with a digit, so anything numeric is
            // noise from another FROM-as-separator form we have not enumerated
            // (SUBSTRING(NAME FROM 1 FOR 3) was reporting a table called "1").
            if (!tableName || /^[0-9]/.test(tableName)) continue;

            // Filter out common SQL keywords/artifacts that might slip through
            // All-caps: `clean` is uppercased above, so the old mixed-case
            // 'Unnest' could never match and this engine reported UNNEST as a
            // table where the PHP twin correctly filtered it.
            const blacklist = ['DUAL', 'SELECT', 'WHERE', 'ON', 'AS', 'DISTINCT', 'CROSS', 'OUTER', 'INNER', 'LEFT', 'RIGHT', 'FULL', 'APPLY', 'VALUES', 'SET', 'UNNEST'];

            // Offset of the NAME itself (match[0] may include the preceding
            // word) - that position is what the CTE scope test needs.
            const nameAt = match.index + match[0].length - fullName.length;
            if (!blacklist.includes(tableName) && !_pnbIsCteReference(cteSpans, tableName, nameAt, clean)) {
                tablesUsed.add(tableName);
            }
        }

        return Array.from(tablesUsed).join(', ') || 'N/A';
    }


    // (Removed: dead pre-unified #createNewSnapshotBtn handler - create is now wired from #createNewSnapshotBtnV2 above, which calls openCreateSnapshotDialog -> doCreateLocalSnapshot/doCreateServerSnapshot.)
