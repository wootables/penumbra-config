                    fname: hit.fname || '', lname: hit.lname || '',
                    username: hit.username || '', email: hit.value || '',
                    empl_id: hit.empl_id || '', ouc: hit.ouc || '',
                    ouc2d: hit.ouc2d || '', ouc4d: hit.ouc4d || '',
                    dept: hit.dept || '',
                    jobcode: hit.jobcode || '', jobcode_prefix: hit.jobcode_prefix || '',
                    empl_class: hit.empl_class || '', empl_status: hit.empl_status || '',
                    pi_eligible: hit.pi_eligible || ''
