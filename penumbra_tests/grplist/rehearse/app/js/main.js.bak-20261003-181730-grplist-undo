                // wavg need a raw value list / a second weight column). Emit a token
                // the final numeric comparison cannot parse so the condition resolves
                // to FALSE and the rule drops - never silently "true".
                return 'NaN';
            }
            );

            if (functionsFound === 0)
                break;
        }

