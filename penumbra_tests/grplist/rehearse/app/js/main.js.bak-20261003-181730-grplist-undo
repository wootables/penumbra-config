        // Handle navigation keys
        if (e.key === 'ArrowDown' || e.key === 'Tab') {
            e.preventDefault();
            const $current = $items.filter('.highlighted');
            let $next;

            if ($current.length === 0) {
                // If nothing is selected, select the first item
                $next = $items.first();
            } else {
                const currentIndex = $items.index($current);
                // Move to the next item, wrapping around to the start if at the end
                $next = $items.eq((currentIndex + 1) % $items.length);
            }
            $current.removeClass('highlighted');
            $next.addClass('highlighted');
            scrollSelectedItemIntoView();
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const $current = $items.filter('.highlighted');
            let $prev;

            if ($current.length === 0) {
                // If nothing is selected, select the last item
                $prev = $items.last();
            } else {
                const currentIndex = $items.index($current);
                // Move to the previous item, wrapping around to the end if at the start
                $prev = $items.eq((currentIndex - 1 + $items.length) % $items.length);
            }
            $current.removeClass('highlighted');
            $prev.addClass('highlighted');
            scrollSelectedItemIntoView();
        } else if (e.key === 'Enter') {
            e.preventDefault();
            const $selected = $items.filter('.highlighted');
