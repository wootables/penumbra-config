                    }
                    case 'download_tsv': {
                        const tsvDlFlatten = (args[0] || '').toLowerCase() === 'flatten';
                        runSilent('#downloadActionsLightbox', () => {
                            $('input[name="downloadFormat"][value="tsv"]').prop('checked', true);
                            $('input[name="tsvDownloadNestedOption"][value="' + (tsvDlFlatten ? 'flatten' : 'keep') + '"]').prop('checked', true);
                        }, '#confirmDownloadBtn');
                        break;
                    }
                    case 'download_xls': {
                        const xlsFlags = args.map(a => String(a || '').toLowerCase().trim());
                        const xlsInclude = xlsFlags.indexOf('include') !== -1;
                        const xlsMono = xlsFlags.indexOf('mono') !== -1 || xlsFlags.indexOf('monochrome') !== -1;
                        runSilent('#downloadActionsLightbox', () => {
                            $('input[name="downloadFormat"][value="xls"]').prop('checked', true);
                            $('#xlsIncludeHeader').prop('checked', xlsInclude);
                            $('#xlsMonochrome').prop('checked', xlsMono);
                        }, '#confirmDownloadBtn');
                        break;
                    }
                    case 'download_pdf':
                        runSilent('#downloadActionsLightbox', () => $('input[name="downloadFormat"][value="pdf"]').prop('checked', true), '#confirmDownloadBtn');
                        break;
                    case 'download_json':
                        runSilent('#downloadActionsLightbox', () => $('input[name="downloadFormat"][value="json"]').prop('checked', true), '#confirmDownloadBtn');
                        break;
                    case 'download_php':
                        runSilent('#downloadActionsLightbox', () => $('input[name="downloadFormat"][value="php"]').prop('checked', true), '#confirmDownloadBtn');
                        break;

                    // ============================================================
                    // 5. STANDARD CLIPBOARD (Silent)
                    //    copy_csv / copy_tsv accept an optional "flatten" arg
                    //    (e.g. copy_csv|flatten) which flips the nested-tables
                    //    radio on so @@JSON sub-tables expand into Parent-Sub
                    //    columns with parallel-zip row expansion. Harmless on
                    //    views without nested data (no flatten happens).
                    // ============================================================
                    case 'copy_html':
                        runSilent('#copyActionsLightbox', () => $('input[name="copyFormat"][value="html"]').prop('checked', true), '#confirmCopyBtn');
                        break;
                    case 'copy_csv': {
                        const csvFlatten = (args[0] || '').toLowerCase() === 'flatten';
                        runSilent('#copyActionsLightbox', () => {
                            $('input[name="copyFormat"][value="csv"]').prop('checked', true);
                            $('input[name="csvCopyNestedOption"][value="' + (csvFlatten ? 'flatten' : 'keep') + '"]').prop('checked', true);
                        }, '#confirmCopyBtn');
                        break;
                    }
                    case 'copy_tsv': {
                        const tsvFlatten = (args[0] || '').toLowerCase() === 'flatten';
                        runSilent('#copyActionsLightbox', () => {
                            $('input[name="copyFormat"][value="tsv"]').prop('checked', true);
                            $('input[name="tsvCopyNestedOption"][value="' + (tsvFlatten ? 'flatten' : 'keep') + '"]').prop('checked', true);
                        }, '#confirmCopyBtn');
                        break;
                    }
                    case 'copy_json':
                        runSilent('#copyActionsLightbox', () => $('input[name="copyFormat"][value="json"]').prop('checked', true), '#confirmCopyBtn');
                        break;

                    // ============================================================
                    // 5a. API CONNECTION STRING (Supports: "copy_api_snippet|language")
                    //     language is one of: python, powershell, node, php, bash
                    //     (case-insensitive). Disabled for encrypted reports -
                    //     mirrors the dialog gate; the PHP Stub handles those.
                    // ============================================================
                    case 'copy_api_snippet': {
                        if (currentReportIsEncrypted) {
                            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> API connection string isn't available for encrypted reports. Use \"Copy Code for PHP Stub\" instead.</p>");
                            break;
                        }
                        const apiLang = (args[0] || 'python').toLowerCase();
                        const validLangs = ['python', 'powershell', 'node', 'php', 'bash'];
                        const lang = validLangs.indexOf(apiLang) !== -1 ? apiLang : 'python';
                        runSilent('#copyActionsLightbox', () => {
                            $('input[name="copyFormat"][value="api_snippet"]').prop('checked', true);
                            $('#apiSnippetLanguage').val(lang);
                        }, '#confirmCopyBtn');
                        break;
                    }

                    // ============================================================
                    // 5b. COPY WITH CUSTOM TEMPLATE (Supports: "copy_template|{COL1} - {COL2}")
                    // ============================================================
                    case 'copy_template': {
                        // Rejoin in case template itself contains |. A wrapping backtick
                        // pair is the "defer to click time" escape (engine A restores the
                        // protected content, but a template authored in the subtitle/
                        // infobox engine keeps its literal backticks) - strip it here.
                        let tplStr = args.join('|').trim();
                        if (tplStr.length >= 2 && tplStr.charAt(0) === '`' && tplStr.charAt(tplStr.length - 1) === '`') {
                            tplStr = tplStr.slice(1, -1);
                        }
                        if (!tplStr.trim()) {
                            // No template provided - open the UI with custom selected
                            $('#copyActionsBtn').click();
                            $('input[name="copyFormat"][value="custom"]').prop('checked', true).trigger('change');
                            break;
                        }
                        const tplTemplate = tplStr.replace(/\\t/g, '\t');
                        // Shared helper: same single-pass substitution + nested
                        // {Parent-Sub} zip + bare {Parent} clean-JSON behavior as
                        // the Custom Template option in the Copy dialog.
                        const tplOutput = generateTemplateOutput(tplTemplate);
                        if (tplOutput.length === 0) {
                            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> No visible rows to generate text from.</p>");
                        } else {
                            navigator.clipboard.writeText(tplOutput.join('\n')).then(function () {
                                show_text("<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Copied " + tplOutput.length + " generated lines to clipboard.</p>");
                            }, function () {
                                show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to copy generated text.</p>");
                            });
                        }
                        break;
                    }

                    // ============================================================
                    // 6. UI OPENERS (No Args, Just Open)
                    // ============================================================
                    case 'open_email':
                        $('#emailTableBtn').click();
                        break;
                    case 'open_snapshot':
                        $('#snapshotBtn').click();
                        break;
                    case 'open_pivot':
                        $('#pivotBtn').click();
                        break;
                    case 'open_viz':
                        $('#visualizeBtn').click();
                        break;
                    case 'open_copy':
                        $('#copyActionsBtn').click();
                        break;
                    case 'open_download':
                        $('#downloadBtn').click();
                        break;
                    // ============================================================
                    // 7. SNAPSHOT CREATION (Supports: "snapshot_create|Custom Name")
                    // ============================================================
                    case 'snapshot_create':
                        const $visibleSnapshotRows = $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)");
                        if ($visibleSnapshotRows.length === 0 && !$('#groupedResultsContainer').is(':visible')) {
                            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No visible rows to snapshot.</p>");
                            break;
                        }

                        // 1. Determine Name
                        let snapName = args[0];
                        if (!snapName) {
                            // Default: "Report Title (Date Time)"
                            snapName = `${getReportTitle()} (${new Date().toLocaleString()})`;
                        }

                        show_text(`<p id='undo_text'><span style='color: #fff;'>📸 Creating snapshot "${escapeHtml(snapName)}"...</span></p>`, 2000);

                        // 2. Run logic (De-coupled from UI thread to allow toast to render)
                        setTimeout(() => {
                            try {
                                const snapshotData = [];
                                const signatureCounts = Object.create(null); // keyed by row data - never {}

                                // A. Capture Data
                                // Use the same extraction logic as the UI button to ensure consistency
                                const $rowsToProcess = $('#groupedResultsContainer').is(':visible') ? $("#groupedResultsContainer tbody tr:not(.search-hidden):not(.journal-note-child)") : $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)");

                                $rowsToProcess.each(function () {
                                    // Find the index from the # column to get the true Master Data record
                                    const rowIndex = parseInt($(this).find("td[data-column='#']").text(), 10) - 1;
                                    const rowDataMap = masterRowData[rowIndex];

                                    if (rowDataMap) {
                                        const baseSignature = generateRowSignature(rowDataMap);
                                        signatureCounts[baseSignature] = (signatureCounts[baseSignature] || 0) + 1;
                                        // Handle duplicate rows in dataset
                                        const uniqueSignature = signatureCounts[baseSignature] > 1 ? `${baseSignature}_${signatureCounts[baseSignature] - 1}` : baseSignature;

                                        snapshotData.push({
                                            signature: uniqueSignature,
                                            rowData: (window.Penumbra && window.Penumbra.journalSnapshotRowData)
                                                ? window.Penumbra.journalSnapshotRowData(rowDataMap)
                                                : Object.fromEntries(rowDataMap)
                                        });
                                    }
                                });

                                // B. Capture Metadata
                                let totalColumns = 0;
                                let visibleColumns = 0;
                                if ($('#groupedResultsContainer').is(':visible')) {
                                    totalColumns = $("#groupedResultsContainer .group-wrapper:first thead th[data-colname]").length;
                                    visibleColumns = $("#groupedResultsContainer .group-wrapper:first thead th[data-colname]:visible").length;
                                } else {
                                    totalColumns = $("#tableHeader th[data-colname]").length;
                                    visibleColumns = $("#tableHeader th[data-colname]:visible").length;
                                }
                                const columnCountString = `${totalColumns} (${visibleColumns} visible)`;

                                // Capture table names from query for metadata
                                // Use the shared helper to ensure Tags, Strings, and Comments are all stripped correctly
                                const tablesUsedString = extractTablesFromQuery(editor.getValue());

                                // Generate data signature for duplicate detection
                                const dataSignature = snapshotData.map(d => d.signature.split('_')[0]).sort().join('');
                                const compressedData = compressString(JSON.stringify(snapshotData));

                                // Extract column names for metadata
                                var macroColNames = [];
                                if (snapshotData.length > 0 && snapshotData[0].rowData) {
                                    for (var mk in snapshotData[0].rowData) {
                                        if (snapshotData[0].rowData.hasOwnProperty(mk)) {
                                            var mkU = mk.toUpperCase();
                                            if (mkU !== '#') macroColNames.push(mkU);
                                        }
                                    }
                                    macroColNames.sort();
                                }

                                const newSnapshot = {
                                    name: snapName,
                                    timestamp: Date.now(),
                                    creator: penumbra_vars.currentUserKey || 'unknown',
                                    searchTerm: $('#tableSearch').val().trim(),
                                    columnCount: columnCountString,
                                    columnNames: macroColNames,
                                    rowCount: snapshotData.length,
                                    tables: tablesUsedString,
                                    dataSignature: dataSignature,
                                    storedSize: compressedData.length,
                                    // prompts/notes were dropped by this macro path (the dialog
                                    // path captures both) - a missing prompts array made the
                                    // compare context grid flag every prompt as a false mismatch.
                                    notes: '',
                                    prompts: _captureCurrentPrompts(),
                                    compressedData
                                };

                                // C. Save to Local Storage
                                const SNAPSHOT_KEY = "penumbra_data_snapshots";
                                let snapshots;
                                try { snapshots = JSON.parse(localStorage.getItem(SNAPSHOT_KEY) || "[]"); } catch (e) { snapshots = []; }
                                if (snapshots.length >= MAX_LOCAL_SNAPSHOTS) {
                                    show_text(`<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Maximum of ${MAX_LOCAL_SNAPSHOTS} snapshots reached. Delete old snapshots first.</p>`);
                                    return;
                                }
                                snapshots.push(newSnapshot);
                                if (!safeLocalStorageSet(SNAPSHOT_KEY, JSON.stringify(snapshots))) {
                                    show_text(`<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Browser storage is full. Delete old snapshots to free space.</p>`);
                                    return;
                                }

                                show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Snapshot "${escapeHtml(snapName)}" saved.</p>`);

                            } catch (e) {
                                console.error("Macro snapshot failed:", e);
                                show_text(`<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Snapshot failed: ${e.message}</p>`);
                            }
                            $(document).trigger('penumbra:stepComplete');
                        }
                            , 50);
                        _isAsyncStep = true;
                        break;

                    // ============================================================
                    // 7a. SERVER SNAPSHOT CREATION (Supports: "snapshot_create_server|Custom Name|Optional Notes")
                    // Saves to the central server-side snapshot store for the current report.
                    // Requires an authenticated server report (?id=...) - bails otherwise.
                    // ============================================================
                    case 'snapshot_create_server':
                    {
                        _isAsyncStep = true; // AJAX-based - emits stepComplete via onComplete
                        const reportIdServerSnap = new URLSearchParams(window.location.search).get('id');
                        if (!reportIdServerSnap) {
                            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No server report loaded. Save to server first.</p>");
                            $(document).trigger('penumbra:stepComplete');
                            break;
                        }

                        const $sourceRowsServerSnap = $('#groupedResultsContainer').is(':visible')
                            ? $("#groupedResultsContainer tbody tr:not(.search-hidden):not(.journal-note-child)")
                            : $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)");
                        if ($sourceRowsServerSnap.length === 0) {
                            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No visible rows to snapshot.</p>");
                            $(document).trigger('penumbra:stepComplete');
                            break;
                        }

                        let serverSnapName = args[0];
                        if (!serverSnapName) {
                            serverSnapName = `${getReportTitle()} (${new Date().toLocaleString()})`;
                        }
                        const serverSnapNotes = args[1] || '';

                        doCreateServerSnapshot(serverSnapName, serverSnapNotes, reportIdServerSnap, $sourceRowsServerSnap, function () {
                            $(document).trigger('penumbra:stepComplete');
                        });
                        break;
                    }

                    // ============================================================
                    // 7b. SNAPSHOT COMPARE
                    // "snapshot_compare"                          latest snapshot, all columns
                    // "snapshot_compare|COL1,COL2"                latest snapshot, custom keys
                    // "snapshot_compare|COL1,COL2|<selector>"     picked snapshot, custom keys
                    // "snapshot_compare||<selector>"              picked snapshot, all columns
                    // Compares a server snapshot against the current view. The 2nd
                    // arg is an evergreen selector token (latest / prev / pinned /
                    // latest-scheduler / latest-mine / latest-by-<uid> / latest-<n>)
                    // resolved at CLICK time - see _pickSnapshotBySelector - so the
                    // authored link never goes stale.
                    // ============================================================
                    case 'snapshot_compare':
                    {
                        _isAsyncStep = true; // AJAX-based - emits stepComplete itself
                        const reportId = new URLSearchParams(window.location.search).get('id');
                        if (!reportId) {
                            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No server report loaded. Save to server first.</p>");
                            $(document).trigger('penumbra:stepComplete');
                            break;
                        }

                        // Parse optional column list from args: "snapshot_compare|COL1,COL2"
                        let compareCustomKeys = null;
                        if (args[0]) {
                            compareCustomKeys = args[0].split(',').map(c => c.trim().toUpperCase()).filter(c => c);
                            if (compareCustomKeys.length === 0) compareCustomKeys = null;
                        }

                        // Optional 3rd part: which snapshot to compare against
                        // (evergreen selector, resolved at click time). Default
                        // stays "latest" - the pre-selector behavior.
                        let compareSelector = (args[1] || 'latest').trim();
                        if (!_isSnapshotSelectorToken(compareSelector)) {
                            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Unknown snapshot selector \"" + escapeHtml(compareSelector) + "\" - use latest, prev, pinned, latest-scheduler, latest-mine, latest-by-&lt;uid&gt; or latest-&lt;n&gt;.</p>", 10000);
                            $(document).trigger('penumbra:stepComplete');
                            break;
                        }

                        showLoading("Loading " + _describeSnapshotSelector(compareSelector) + " for comparison...");

                        // Fetch the latest snapshot for this report
                        $.ajax({
                            url: 'manage_snapshots.php?action=list&report_id=' + encodeURIComponent(reportId),
                            method: 'GET',
                            dataType: 'json',
                            success: function (response) {
                                if (response.status !== 'success' || !response.data || response.data.length === 0) {
                                    hideLoading();
                                    show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No server snapshots found for this report.</p>");
                                    $(document).trigger('penumbra:stepComplete');
                                    return;
                                }

                                // Pick by selector (list is ordered by CREATED_AT
                                // DESC; "latest" = data[0], the original behavior).
                                const latestMeta = _pickSnapshotBySelector(response.data, compareSelector);
                                if (!latestMeta || !latestMeta.ID) {
                                    hideLoading();
                                    show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No snapshot matches \"" + escapeHtml(compareSelector) + "\" (" + _describeSnapshotSelector(compareSelector) + ") for this report.</p>", 10000);
                                    $(document).trigger('penumbra:stepComplete');
                                    return;
                                }
                                var loadUrl = 'manage_snapshots.php?action=load&snap_id=' + encodeURIComponent(latestMeta.ID);
                                loadUrl += '&from_report=' + encodeURIComponent(reportId);

                                $.ajax({
                                    url: loadUrl,
                                    method: 'GET',
                                    dataType: 'json',
                                    success: async function (loadResp) {
                                        hideLoading();
                                        if (loadResp.status === 'success' && loadResp.data && loadResp.data.SNAP_DATA) {
                                            try {
                                                // Decrypt at rest if this is an encrypted report's snapshot.
                                                loadResp.data.SNAP_DATA = await decodeSnapDataFromStorage(loadResp.data.SNAP_DATA);
                                                var rawSnapAuto = typeof loadResp.data.SNAP_DATA === 'string'
                                                    ? JSON.parse(loadResp.data.SNAP_DATA)
                                                    : loadResp.data.SNAP_DATA;
                                                var snapData = (rawSnapAuto && rawSnapAuto._meta && rawSnapAuto.rows) ? rawSnapAuto.rows : rawSnapAuto;

                                                const snapshotObj = {
                                                    name: loadResp.data.SNAP_NAME,
                                                    timestamp: new Date(loadResp.data.CREATED_AT).getTime(),
                                                    searchTerm: loadResp.data.SEARCH_TERM || '',
                                                    columnCount: loadResp.data.COLUMN_COUNT || '',
                                                    tables: loadResp.data.TABLES_USED || '',
                                                    notes: loadResp.data.NOTES || '',
                                                    // Prompts too - the context grid diffs them per side.
                                                    prompts: Array.isArray(loadResp.data.PROMPTS) ? loadResp.data.PROMPTS : [],
                                                    // Server row id: without it the banner's "Copy link" saw a
                                                    // serverId-less object and told the user to "copy this local
                                                    // snapshot to the server" - impossible advice for a snapshot
                                                    // that was just fetched FROM the server. Also lets
                                                    // _forgetDeletedSnapshotFromCompare match this object.
                                                    serverId: latestMeta.ID,
                                                    compressedData: compressString(JSON.stringify(snapData))
                                                };

                                                runComparisonAndDisplayGrouped(snapshotObj, compareCustomKeys);
                                            } catch (e) {
                                                console.error("Failed to parse snapshot for compare:", e);
                                                show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to parse snapshot data.</p>");
                                            }
                                            $(document).trigger('penumbra:stepComplete');
                                        } else {
                                            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> " + escapeHtml(loadResp.message || 'Failed to load snapshot.') + "</p>");
                                            $(document).trigger('penumbra:stepComplete');
                                        }
                                    },
                                    error: function () {
                                        hideLoading();
                                        show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to load snapshot from server.</p>");
                                        $(document).trigger('penumbra:stepComplete');
                                    }
                                });
                            },
                            error: function () {
                                hideLoading();
                                show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to list server snapshots.</p>");
                                $(document).trigger('penumbra:stepComplete');
                            }
                        });
                        break;
                    }

                    // ============================================================
                    // COLUMN SORTING
                    // sort|COLUMN|asc/desc  - replaces all sort criteria
                    // sort+|COLUMN|asc/desc - adds to existing sort criteria (multi-column)
                    // sort|clear / sort|none - removes all sorting
                    // Works in Standard, Grouped, and Pivot views.
                    // ============================================================
                    case 'sort+':
                    case 'sort':
                    {
                        const sortColArg = (args[0] || '').trim();
                        const sortDirArg = (args[1] || 'asc').trim().toLowerCase();
                        const isAdditive = (cmd === 'sort+');

                        // --- Clear / None ---
                        if (!isAdditive && (sortColArg.toLowerCase() === 'clear' || sortColArg.toLowerCase() === 'none' || !sortColArg)) {
                            sortCriteria = [];

                            const isPivotVisible = $('#pivot-output-container').is(':visible');
                            if (isPivotVisible) {
                                // Restore original pivot row order
                                const $pTbody = $('#pivotResultTable tbody');
                                const originalHtml = $pTbody.data('original-rows-html');
                                if (originalHtml) {
                                    $pTbody.html(originalHtml);
                                }
                            } else {
                                // Standard/grouped: restore original row order in each tbody
                                const $tbodies = $('#groupedResultsContainer').is(':visible')
                                    ? $('#groupedResultsContainer table tbody')
                                    : $('#resultsTable tbody');
                                $tbodies.each(function () {
                                    const originalRows = $(this).data('original-rows');
                                    if (originalRows) {
                                        const fragment = document.createDocumentFragment();
                                        for (let i = 0; i < originalRows.length; i++) {
                                            fragment.appendChild(originalRows[i]);
                                        }
                                        const tbodyRaw = this;
                                        const newTbody = tbodyRaw.cloneNode(false);
                                        newTbody.appendChild(fragment);
                                        $(tbodyRaw).removeData().off();
                                        tbodyRaw.parentNode.replaceChild(newTbody, tbodyRaw);
                                        $(newTbody).data('original-rows', originalRows);
                                    }
                                });
                            }

                            updateHeaderIcons();
                            if (!isPivotVisible && !$('#groupedResultsContainer').is(':visible')) {
                                currentPage = 1;
                                applyPagination();
                            } else {
                                applyConditionalFormatting();
                                applyRewriteRules();
                                applyZebraStriping();
                            }
                            break;
                        }

                        // --- Validate direction ---
                        if (sortDirArg !== 'asc' && sortDirArg !== 'desc') {
                            show_text(`<p id='undo_text'><span style='color: orange'>NOTICE:</span> Invalid sort direction '${sortDirArg}'. Use 'asc' or 'desc'.</p>`);
                            break;
                        }

                        const isPivotSort = $('#pivot-output-container').is(':visible');

                        if (isPivotSort) {
                            // --- PIVOT SORT ---
                            penumbraPivotEnsureAllRows();
                            const $pivotTable = $('#pivotResultTable');
                            const $pivotThead = $pivotTable.find('thead');
                            const $pivotTbody = $pivotTable.find('tbody');
                            const numRowFieldsPvt = $pivotThead.find('th[data-row-field]').length;
                            let matchedTh = null;
                            let matchedColIndex = -1;
                            let matchedIdentifier = '';

                            if (sortColArg.includes('::')) {
                                // Composite sub-column (e.g. "2024::Sum")
                                const compParts = sortColArg.split('::');
                                const parentTarget = compParts[0];
                                const subTarget = compParts[1];

                                $pivotThead.find('th.pivot-sub-header').each(function () {
                                    const subLabel = $(this).clone().find('.sort-icon, .col-sort-icon').remove().end().text().trim();
                                    if (subLabel.toLowerCase() !== subTarget.toLowerCase()) return;

                                    let ci = this.cellIndex;
                                    const $headerRow = $(this).closest('tr');
                                    const $parentRow = $headerRow.prev('tr');
                                    if ($pivotThead.find('tr').length > 1 && !$headerRow.is(':first-child')) {
                                        ci += numRowFieldsPvt;
                                    }
                                    const foundParent = findParentHeaderText($parentRow, ci, numRowFieldsPvt);
                                    if (foundParent && foundParent.toLowerCase() === parentTarget.toLowerCase()) {
                                        matchedTh = this;
                                        matchedColIndex = ci;
                                        matchedIdentifier = foundParent + '::' + subLabel;
                                        return false;
                                    }
                                });
                            } else {
                                // Simple column name - match by header text (case-insensitive)
                                $pivotThead.find('th').each(function () {
                                    if ($(this).attr('colspan')) return; // skip group headers
                                    const headerText = $(this).clone().find('.sort-icon, .col-sort-icon').remove().end().text().trim();
                                    if (headerText.toLowerCase() === sortColArg.toLowerCase()) {
                                        matchedTh = this;
                                        let ci = this.cellIndex;
                                        const $headerRow = $(this).closest('tr');

                                        // Grand Total sub-columns
                                        if ($(this).hasClass('pivot-grand-total')) {
                                            const $gtHeaders = $headerRow.find('th.pivot-grand-total');
                                            const totalGtCols = $gtHeaders.length;
                                            const gtIndex = $gtHeaders.index(this);
                                            const totalBodyCols = $pivotTbody.find('tr:first td').length;
                                            ci = totalBodyCols - totalGtCols + gtIndex;
                                        } else if ($pivotThead.find('tr').length > 1 && !$headerRow.is(':first-child')) {
                                            ci += numRowFieldsPvt;
                                        }

                                        matchedColIndex = ci;
                                        matchedIdentifier = $(this).hasClass('pivot-sub-header')
                                            ? (function () {
                                                const sl = $(matchedTh).clone().find('.sort-icon, .col-sort-icon').remove().end().text().trim();
                                                const $pr = $headerRow.prev('tr');
                                                const pt = findParentHeaderText($pr, ci, numRowFieldsPvt);
                                                return pt + '::' + sl;
                                            })()
                                            : headerText;
                                        return false;
                                    }
                                });
                            }

                            if (!matchedTh) {
                                show_text(`<p id='undo_text'><span style='color: orange'>NOTICE:</span> Pivot column '${sortColArg}' not found.</p>`);
                                break;
                            }

                            // Build criterion
                            if (!isAdditive) sortCriteria = [];
                            // Remove existing entry for this identifier
                            const existIdx = sortCriteria.findIndex(c => c.colIdentifier === matchedIdentifier);
                            if (existIdx > -1) sortCriteria.splice(existIdx, 1);
                            sortCriteria.push({
                                colIdentifier: matchedIdentifier,
                                colIndex: matchedColIndex,
                                direction: sortDirArg
                            });

                            // Save original if not yet saved
                            var _snipCollapsed = null;
                            if (!$pivotTbody.data('original-rows-html')) {
                                $pivotTbody.data('original-rows-html', $pivotTbody.html());
                            } else if (sortCriteria.length > 1) {
                                // Chain (sort+): rebuild from the original order so the
                                // stable passes leave it as the final tie-breaker. Was
                                // previously sortCriteria[length-1] -- icons showed every
                                // criterion but only the LAST one actually sorted.
                                // The rebuild resets expand/collapse, so capture it here
                                // and restore below (the header-click handler does the same).
                                _snipCollapsed = captureCollapseState();
                                $pivotTbody.html($pivotTbody.data('original-rows-html'));
                            }

                            sortPivotTablePreservingStructure($pivotTbody, sortCriteria);
                            if (_snipCollapsed) {
                                restoreCollapseState(_snipCollapsed);
                                reapplyChildSummaryRowspan();
                            }
                            updateHeaderIcons();
                            applyConditionalFormatting();
                            applyRewriteRules();
                            applyZebraStriping();
                        } else {
                            // --- STANDARD / GROUPED SORT ---
                            let actualColName = null;
                            let actualColId = null;

                            $('#tableHeader th[data-colname]').each(function () {
                                const name = $(this).data('colname');
                                if (name && name.toLowerCase() === sortColArg.toLowerCase()) {
                                    actualColName = name;
                                    actualColId = $(this).data('column');
                                    return false;
                                }
                            });

                            if (!actualColName) {
                                show_text(`<p id='undo_text'><span style='color: orange'>NOTICE:</span> Column '${sortColArg}' not found.</p>`);
                                break;
                            }

                            if (!isAdditive) sortCriteria = [];
                            // Remove existing entry for this column
                            const existStdIdx = sortCriteria.findIndex(c => c.colIdentifier === actualColName);
                            if (existStdIdx > -1) sortCriteria.splice(existStdIdx, 1);
                            sortCriteria.push({
                                colIdentifier: actualColName,
                                colIndex: actualColId,
                                direction: sortDirArg
                            });

                            const isGroupedSort = $('#groupedResultsContainer').is(':visible');

                            const performSort = () => {
                                if (isGroupedSort) {
                                    $('#groupedResultsContainer table').each(function () {
                                        const $grpTbody = $(this).find('tbody');
                                        if ($grpTbody.length) {
                                            let originalRows = $grpTbody.data('original-rows');
                                            if (!originalRows) {
                                                const nativeTbody = $grpTbody[0];
                                                const len = nativeTbody.rows.length;
                                                originalRows = new Array(len);
                                                for (let ri = 0; ri < len; ri++) originalRows[ri] = nativeTbody.rows[ri];
                                                $grpTbody.data('original-rows', originalRows);
                                            }
                                            const rowsCopy = [...originalRows];
                                            sortRows(rowsCopy);
                                            const fragment = document.createDocumentFragment();
                                            for (let ri = 0; ri < rowsCopy.length; ri++) fragment.appendChild(rowsCopy[ri]);
                                            const tbodyRaw = $grpTbody[0];
                                            const newTbody = tbodyRaw.cloneNode(false);
                                            newTbody.appendChild(fragment);
                                            $(tbodyRaw).removeData().off();
                                            tbodyRaw.parentNode.replaceChild(newTbody, tbodyRaw);
                                            $(newTbody).data('original-rows', originalRows);
                                        }
                                    });
                                } else {
                                    const $tbody = $('#resultsTable tbody');
                                    let originalRows = $tbody.data('original-rows');
                                    if (!originalRows) {
                                        const nativeTbody = $tbody[0];
                                        const len = nativeTbody.rows.length;
                                        originalRows = new Array(len);
                                        for (let ri = 0; ri < len; ri++) originalRows[ri] = nativeTbody.rows[ri];
                                        $tbody.data('original-rows', originalRows);
                                    }
                                    const rowsCopy = [...originalRows];
                                    sortRows(rowsCopy);
                                    const fragment = document.createDocumentFragment();
                                    for (let ri = 0; ri < rowsCopy.length; ri++) fragment.appendChild(rowsCopy[ri]);
                                    const tbodyRaw = $tbody[0];
                                    const newTbody = tbodyRaw.cloneNode(false);
                                    newTbody.appendChild(fragment);
                                    $(tbodyRaw).removeData().off();
                                    tbodyRaw.parentNode.replaceChild(newTbody, tbodyRaw);
                                    $(newTbody).data('original-rows', originalRows);
                                }

                                updateHeaderIcons();
                                if (!isGroupedSort) {
                                    currentPage = 1;
                                    applyPagination();
                                } else {
                                    applyConditionalFormatting();
                                    applyRewriteRules();
                                    applyZebraStriping();
                                }
                                updateFloatingButtonStates();
                                updateTableBorders();
                            };

                            const totalRows = isGroupedSort
                                ? $('#groupedResultsContainer tbody tr').length
                                : $('#resultsTable tbody tr').length;

                            if (totalRows > 500) {
                                showLoading('Sorting ' + totalRows.toLocaleString() + ' rows...', false, { scoped: true });
                                setTimeout(() => {
                                    performSort();
                                    requestAnimationFrame(() => { setTimeout(hideLoading, 0); });
                                }, 50);
                            } else {
                                performSort();
                            }
                        }
                        break;
                    }

                    default:
                        show_text(`<p id='undo_text'><span style='color: orange'>NOTICE:</span> Unknown trigger '${cmd}'</p>`);
                        break;
                    // ============================================================
                    // 8. THEME SWITCHER (Supports: "theme|theme-name")
                    // ============================================================
                    case 'theme':
                        // Resolve the requested theme: accept the exact id, the
                        // name WITHOUT the 'theme-' prefix, or any registry alias
                        // (case-insensitive). Unknown values fall through; empty
                        // -> theme-default. (mirrors the URL-override _normTheme.)
                        var _reqTheme = (args[0] || 'theme-default').trim();
                        var themeName = _reqTheme;
                        if (!PENUMBRA_THEMES[themeName]) {
                            var _lt = _reqTheme.toLowerCase();
                            var _bare = _lt.replace(/^theme-/, '');
                            if (PENUMBRA_THEME_ALIASES[_lt]) themeName = PENUMBRA_THEME_ALIASES[_lt];
                            else if (PENUMBRA_THEME_ALIASES[_bare]) themeName = PENUMBRA_THEME_ALIASES[_bare];
                            else if (PENUMBRA_THEMES['theme-' + _bare]) themeName = 'theme-' + _bare;
                            else if (PENUMBRA_THEMES[_lt]) themeName = _lt;
                        }

                        // Apply theme + format rules under one loading screen
                        var _themeRows = $("#resultsTable tbody tr, #groupedResultsContainer tbody tr").length;
                        var _themeNeedsLoading = _themeRows >= 2000;
                        if (_themeNeedsLoading) showLoading("Applying theme...");
                        setTimeout(function() {
                            applyTheme(themeName);
                            var triggerThemePrefs = _spPrefMap('penumbra_pref_theme');
                            triggerThemePrefs[_spPrefKey()] = themeName;
                            localStorage.setItem('penumbra_pref_theme', JSON.stringify(triggerThemePrefs));
                            $('#spThemeSelector').val(themeName);
                            applyConditionalFormatting(true);
                            applyRewriteRules(true);
                            applyZebraStriping();
                            // The catch-all post-trigger render (below the outer switch) already
                            // ran SYNCHRONOUSLY - i.e. BEFORE this deferred applyTheme() - so a
                            // snippet that branches on the current theme (e.g. a case() that flips
                            // a dark/light action(trigger, theme) toggle, or reads data(theme))
                            // would still show the pre-switch branch. Re-render now that the new
                            // theme is live. Guarded by _snippetReferencesData so it's a no-op for
                            // snippets that don't read the theme - mirrors the group/pivot pattern.
                            if (_snippetReferencesData(['theme'])) {
                                renderReportSnippet(null, true);
                            }
                            show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Theme changed to ${themeName}.</p>`);
                            if (_themeNeedsLoading) {
                                requestAnimationFrame(function() { setTimeout(function() { hideLoading(); $(document).trigger('penumbra:stepComplete'); }, 0); });
                            } else {
                                $(document).trigger('penumbra:stepComplete');
                            }
                        }, _themeNeedsLoading ? 50 : 0);
                        _isAsyncStep = true;
                        break;

                    // ============================================================
                    // 9. ROW EXPAND TOGGLE (Supports: "rowexpand")
                    // ============================================================
                    case 'rowexpand':
                        // Toggle row expand state directly
                        isRowExpandActive = !isRowExpandActive;
                        $('body').toggleClass('disable-auto-expand', !isRowExpandActive);
                        if (currentLoadedStateName) {
                            var _rep;
                            try { _rep = _spPrefMap('penumbra_pref_rowExpand'); } catch (e) { _rep = Object.create(null); }
                            _rep[currentLoadedStateName] = isRowExpandActive;
                            localStorage.setItem('penumbra_pref_rowExpand', JSON.stringify(_rep));
                        }

                        const statusText = isRowExpandActive ? "Compact Mode (Expand on Hover)" : "Full Mode (Always Visible)";

                        show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Row Layout: ${statusText}</p>`);
                        break;

                    // ============================================================
                    // SUBTITLE / BY-LINE WRITE (Supports: "subtitle|New text")
                    // ============================================================
                    case 'subtitle':
                    case 'byline': {
                        // Everything after the first pipe is the new subtitle text
                        // (case preserved by the action() renderer; empty clears).
                        // Transient like search| - persisted only if the report is saved.
                        var _newSub = args.join('|');
                        $('#reportSubtitle').val(_newSub);
                        renderReportSubtitle();
                        break;
                    }

                    // ============================================================
                    // JOURNAL BULK OPS
                    //   mark|<ToggleLabel>[|<limit>]
                    //   unmark|<ToggleLabel>[|<limit>]
                    //   addnote|<limit or empty>|<note text>
                    // Acts on the rows CURRENTLY SHOWN (post-search) in view order,
                    // so the affected set is visible before the click. The handler
                    // confirms the exact count - these writes are shared and have no
                    // one-step undo. Deliberately click-only: the renderer emits a
                    // link, it never fires at render time, and engine C strips
                    // action() entirely so a scheduled e-mail can never mutate data.
                    // ============================================================
                    case 'mark':
                    case 'unmark':
                    case 'addnote': {
                        if (window.Penumbra && window.Penumbra.journalBulkAction) {
                            window.Penumbra.journalBulkAction(cmd, args);
                        }
                        break;
                    }

                    // ============================================================
                    // 10. VIEW NAVIGATION (Exit Pivot/Group/Generic)
                    // ============================================================

                    // Specific: Exit Pivot
                    case 'exit_pivot':
                    case 'close_pivot':
                        if ($('#pivot-output-container').is(':visible')) {
                            $('#exitPivotModeBtn').click();
                        } else {
                            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> Not currently in pivot view.</p>");
                        }
                        break;

                    // Specific: Exit Group
                    case 'exit_group':
                    case 'ungroup':
                        if ($('#groupedResultsContainer').is(':visible')) {
                            $('#removeGroupingLink').click();
                        } else {
                            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> Not currently in grouped view.</p>");
                        }
                        break;

                    // Generic: Exit whatever is active
                    case 'exit':
                    case 'reset_view':
                    case 'back':
                        if ($('#pivot-output-container').is(':visible')) {
                            $('#exitPivotModeBtn').click();
                        } else if ($('#groupedResultsContainer').is(':visible')) {
                            $('#removeGroupingLink').click();
                        } else {
                            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> No active view (Pivot or Group) to exit.</p>");
                        }
                        break;
                }
                // For synchronous commands, emit stepComplete now.
                // Async commands (pivot, group_by, snapshot, theme) set _isAsyncStep=true
                // and emit the event themselves when their async work finishes.
                if (!_isAsyncStep) {
                    $(document).trigger('penumbra:stepComplete');
                }
                // A pivot or a grouping re-renders the snippet itself once the new
                // view is up, when the snippet reads the view (data(pivot) /
                // data(group)). The catch-all render at the tail would run NOW,
                // against the view about to be replaced: wasted work on a heavy
                // snippet; it rebuilt a layout_switch in the middle of its slide;
                // and as a live-edit render on a report over 1,000 rows it swaps
                // every vis() chart for a greyed "paused" image that nothing
                // restores when the snippet does not read the view. 2026-09-24
                _skipPostRender = _isAsyncStep && /^(pivot|create_pivot|group_by|group)$/.test(cmd);
                break;
            case 'search':
                wasSearchTriggeredByLink = true;
                previousSearchValue = '';   // one search, not two - see executeChainStep
                $('#tableSearch').val(actionValue).trigger('input');
                runTableSearch();
                $(document).trigger('penumbra:stepComplete');
                break;

            case 'toast':
                // Decode entities (like &lt;) so HTML from string functions renders correctly
                // show_text() handles security sanitization
                const toastMsg = decodeHtmlEntities(actionValue);
                show_text(toastMsg);
                break;

            case 'fullscreen':
                {
                    // Snippet-generated fullscreen link - dashboard banner + animate + chartnumber
                    // + interval come from data attributes set by the action() parser above.
                    var _fsTitle = $link.attr('data-fs-title') || '';
                    var _fsSubtitle = $link.attr('data-fs-subtitle') || '';
                    var _fsAnimate = $link.attr('data-fs-animate') !== 'false';
                    var _fsChartnum = $link.attr('data-fs-chartnum') || 'all';
                    var _fsInterval = parseFloat($link.attr('data-fs-interval'));
                    var _fsTheme = $link.attr('data-fs-theme') || '';
                    if (typeof openChartCarousel === 'function') {
                        openChartCarousel(null, {
                            title: _fsTitle,
                            subtitle: _fsSubtitle,
                            animate: _fsAnimate,
                            chartnumber: _fsChartnum,
                            interval: isFinite(_fsInterval) ? _fsInterval : undefined,
                            theme: _fsTheme
                        });
                    }
                }
                break;

            case 'prompt':
                const target = $link.data('prompt-target');
                const newValue = String(actionValue);
                // Ensure string

                // 1. Find the target prompt definition in the full code
                const fullQuery = getQuery() + "\n" + getSnippet();
                const promptRegex = /\[\s*PROMPT[^\]]*\]/gi;
                const matches = fullQuery.match(promptRegex) || [];

                let targetPromptString = null;

                // Check if target is an index (prompt1, prompt2...)
                const indexMatch = String(target).match(/^prompt(\d+)$/i);
                if (indexMatch) {
                    const index = parseInt(indexMatch[1], 10) - 1;
                    // 1-based to 0-based
                    if (matches[index]) {
                        targetPromptString = matches[index];
                    }
                } else {
                    // Check if target is a prompt name
                    for (const pStr of matches) {
                        try {
                            const parsed = parsePrompt(pStr);
                            if (parsed.name === target) {
                                targetPromptString = pStr;
                                break;
                            }
                        } catch (e) { }
                    }
                }

                if (targetPromptString) {
                    const storageKey = getPromptStorageKey(targetPromptString);
                    let config = {};
                    try {
                        config = parsePrompt(targetPromptString);
                    } catch (e) { }

                    // 2. Prepare data object for localStorage
                    // Preserve existing metadata if possible
                    let storedData = {};
                    try {
                        storedData = JSON.parse(localStorage.getItem(storageKey) || "{}");
                    } catch (e) { }

                    let dataToSave = {
                        ...storedData,
                        message: config.message || config.name || "Prompt",
                        reportId: (new URLSearchParams(window.location.search)).get('id')
                    };

                    if (config.nosave) {
                        dataToSave.nosave = true;
                    }

                    // Format based on type
                    if (config.type === 'multi-select') {
                        // Split comma-separated value into array structure
                        const valArray = newValue.split(',').map(s => s.trim());
                        dataToSave.values = valArray.map(v => ({
                            value: v,
                            display: v
                        }));
                    } else {
                        dataToSave.value = newValue;
                        dataToSave.display = newValue;
                    }

                    // 3. Save and Refresh
                    localStorage.setItem(storageKey, JSON.stringify(dataToSave));

                    // Update display immediately
                    updatePromptDisplay();

                    // If the prompt is used in the main SQL query, we must re-run it.
                    // Otherwise (snippet only), just re-render the snippet.
                    if (getQuery().includes(targetPromptString)) {
                        $("#executeQuery").click();
                    } else {
                        renderReportSnippet();
                    }

                    // Optional: Visual feedback
                    show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Updated prompt '${target}' to '${newValue}'</p>`, 3000);

                } else {
                    alert(`Error: Prompt target '${target}' not found in the current query.`);
                }
                break;

            case 'infobox':
                {
                    const mode = $link.attr('data-action-mode') || 'raw';
                    const isUrl = $link.attr('data-action-isurl') === '1';
                    const rawKey = String(actionValue);
                    const title = $link.text() || 'Info';

                    // For non-URL: pull raw snippet + data context from registry
                    let content, rowData, columns;
                    if (isUrl) {
                        content = rawKey;
                    } else {
                        const entry = _infoboxContentRegistry[rawKey];
                        if (entry && entry.snippet) {
                            content = entry.snippet;
                            rowData = entry.rowData;
                            columns = entry.columns;
                        } else {
                            content = rawKey;
                        }
                    }

                    showInfoboxDialog({
                        title: title,
                        content: content,
                        mode: mode,
                        isUrl: isUrl,
                        rowData: rowData,
                        columns: columns,
                        registryKey: isUrl ? '' : rawKey
                    });
                }
                break;

            case 'chain':
                {
                    const chainKey = String(actionValue);
                    const steps = (_chainRegistry[chainKey] || []).slice();
                    if (steps.length === 0) break;

                    _chainInProgress = true;

                    // Event-based sequential execution: each step waits for
                    // 'penumbra:stepComplete' from the previous step before running.
                    var stepIdx = 0;
                    var STEP_TIMEOUT = 15000; // 15s safety timeout per step
                    var runNextStep = function() {
                        if (stepIdx >= steps.length) {
                            // All steps done - clean up
                            _chainInProgress = false;
                            renderReportSnippet(null, true);
                            return;
                        }
                        var currentStep = steps[stepIdx];
                        stepIdx++;
                        var handled = false;
                        var safetyTimer = setTimeout(function() {
                            if (!handled) {
                                handled = true;
                                $(document).off('penumbra:stepComplete');
                                console.warn('Chain step timed out after ' + STEP_TIMEOUT + 'ms:', currentStep);
                                setTimeout(runNextStep, 50);
                            }
                        }, STEP_TIMEOUT);
                        // Listen for stepComplete once, then run next step
                        $(document).one('penumbra:stepComplete', function() {
                            if (!handled) {
                                handled = true;
                                clearTimeout(safetyTimer);
                                // Small delay to let DOM settle before next step
                                setTimeout(runNextStep, 50);
                            }
                        });
                        executeChainStep(currentStep);
                    };
                    // Kick off the first step
                    runNextStep();
                }
                break;

            case 'feedback':
                {
                    // data-action-value carries the TYPESPEC (possibly empty).
                    penumbraOpenFeedbackDialog(String(actionValue == null ? '' : actionValue), $link.text());
                }
                break;

            default:
                console.error('Unknown snippet action:', actionName);
                break;
        }
        if (actionName === 'trigger' && !_chainInProgress && !_skipPostRender) {
            renderReportSnippet(null, true);
        }
    });

    // --- Infobox snippet-action click handler ---
    // Mirrors the main handler above but for actions rendered inside infobox dialogs.
    // Closes the infobox after the action fires so the user sees the filtered/updated report.
    $(document).on('click', '.infobox-overlay .snippet-action', function (e) {
        e.preventDefault();
        const $link = $(this);
        const actionName = $link.data('action-name');
        const actionValue = $link.data('action-value');
        const $dialog = $link.closest('.infobox-overlay');

        // Close the infobox dialog
        const closeInfobox = () => {
            // Destroy any Chart.js instances on canvases inside this dialog
            $dialog.find('canvas').each(function () {
                const chartInstance = Chart.getChart(this);
                if (chartInstance) try { chartInstance.destroy(); } catch (e) { }
            });
            // Destroy all open tooltips (jQuery UI + chart filter tip)
            $('.ui-tooltip').stop(true, true).remove();

            $dialog.fadeOut(150, function () { $(this).remove(); });
        };

        switch (actionName) {
            case 'search':
                {
                    const searchVal = String(actionValue);
                    $('#tableSearch').val(searchVal).trigger('input');
                    runTableSearch();
                    closeInfobox();
                }
                break;

            case 'trigger':
                {
                    // Delegate to the main trigger handler by briefly injecting into snippet output
                    const rawValue = String(actionValue);
                    const parts = rawValue.split('|');
                    const cmd = parts[0].toLowerCase().trim();

                    // For triggers that navigate away or modify the view, close the dialog
                    closeInfobox();

                    // Re-fire as if it came from snippet output
                    const tempLink = $(`<a class="snippet-action" data-action-name="trigger" data-action-value="${htmlEncode(rawValue)}">`);
                    $('#reportSnippetOutput').append(tempLink);
                    tempLink.trigger('click');
                    tempLink.remove();
                }
                break;

            case 'prompt':
                {
                    // Prompt actions set a value silently - no visible change, keep dialog open
                    const targetStr = String($link.data('prompt-target') || '');
                    const newValue = String(actionValue);
                    if (targetStr) {
                        $(`#snippetPrompt_${targetStr}`).val(newValue);
                    }
                }
                break;

            case 'infobox':
                {
                    // Nested infobox - close current, open new
                    closeInfobox();
                    const mode = $link.attr('data-action-mode') || 'raw';
                    const isUrl = $link.attr('data-action-isurl') === '1';
                    const rawKey = String(actionValue);
                    let content, rowData, columns;
                    if (isUrl) {
                        content = rawKey;
                    } else {
                        const entry = _infoboxContentRegistry[rawKey];
                        if (entry && entry.snippet) {
                            content = entry.snippet;
                            rowData = entry.rowData;
                            columns = entry.columns;
                        } else {
                            content = rawKey;
                        }
                    }
                    showInfoboxDialog({ title: $link.text() || 'Info', content, mode, isUrl, rowData, columns, registryKey: isUrl ? '' : rawKey });
                }
                break;

            case 'chain':
                {
                    closeInfobox();
                    // Delegate to main chain handler via synthetic click
                    const tempLink = $(`<a class="snippet-action" data-action-name="chain" data-action-value="${htmlEncode(String(actionValue))}">`);
                    $('#reportSnippetOutput').append(tempLink);
                    tempLink.trigger('click');
                    tempLink.remove();
                }
                break;

            case 'feedback':
                {
                    // Close first: the feedback modal runs its own focus trap, and
                    // stacking it over the infobox overlay would leave two traps
                    // fighting over Tab.
                    closeInfobox();
                    penumbraOpenFeedbackDialog(String(actionValue == null ? '' : actionValue), $link.text());
                }
                break;

            default:
                closeInfobox();
                break;
        }
    });

    // --- "View in table" link inside pivot breakdown infobox ---
    // Closes the infobox, exits pivot mode, and filters the main table
    // to the same rows shown in the breakdown.
    $(document).on('click', '.infobox-drill-to-table', function (e) {
        e.preventDefault();
        var $dialog = $(this).closest('.infobox-overlay');
        var searchStr = $dialog.data('drill-search');
        if (!searchStr) return;

        // Safety net for the pivot-controls-disabled case. The pivot drill no
        // longer renders this link at all when the controls are hidden, but the
        // CHART drill builds its own copy and a chart breakdown can be opened
        // while a pivot is on screen - and the exit below would be one-way for
        // a viewer who can't rebuild the pivot. Stay put and say why.
        if (penumbraDrillExitBlocked() && $('#pivot-output-container').is(':visible')) {
            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> This report's pivot controls are turned off, so leaving the pivot view can't be undone. Search from the pivot instead.</p>", 9000);
            return;
        }

        // Close the infobox
        $dialog.find('canvas').each(function () {
            var chartInstance = (typeof Chart !== 'undefined') ? Chart.getChart(this) : null;
