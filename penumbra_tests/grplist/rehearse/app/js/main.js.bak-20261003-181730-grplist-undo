            var ev = $.Event('click');
            ev.shiftKey = true;
            $th.trigger(ev);
        }

        if (sortCriteria[idx].direction === 'desc') {
            // Set asc, one click -> the handler flips it to desc and re-sorts.
            // The criterion keeps its place in the chain.
            sortCriteria[idx].direction = 'asc';
            _csShiftClick();
        } else if (sortCriteria.length === 1) {
            // Ascending: set desc, then click TWICE - the first click drops the
            // criterion, the second re-adds it as asc. Only safe as a single-column
            // sort, because the re-add always lands at the END of a chain.
            sortCriteria[idx].direction = 'desc';
            _csShiftClick();
            _csShiftClick();
        } else {
            // Ascending inside a multi-column chain: re-adding would shuffle this
            // column to the end of the chain, which is a worse lie than leaving the
            // table alone. Say what to do instead.
            show_text('Sort by ' + escapeHtml(col) + ' again to apply the new order.');
        }
    }

    /**
     * Uses the state object to build a compressed, shareable URL.
     * @param {boolean} [returnRelative=false] - If true, returns a relative URL (e.g., "index.php?state=...").
     * If false (default), returns absolute (e.g., "https://site/index.php?state=...").
     */
    function buildViewStateURL(returnRelative = false) {
        const state = buildStateObject();
        if (!state) {
            return null;
            // Error was already shown by buildStateObject
        }

        const encoded = compressString(JSON.stringify(state));

        if (returnRelative) {
            // Returns relative path (e.g., "index.php?state=...")
            // Handles cases where pathname might end in a slash by defaulting to index.php
            const fileName = window.location.pathname.split('/').pop() || 'index.php';
            return fileName + "?state=" + encoded;
        }

