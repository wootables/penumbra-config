    // --- Open Prompt Dialog for Scheduler Inputs Handler ---
    $(document).on('click', '.sched-prompt-input', async function () {
        const $input = $(this);
        const rawString = $input.data('raw-prompt');

        // If no prompt definition is attached (or input disabled), do nothing
        if (!rawString || $input.is(':disabled'))
            return;

        try {
            const config = parsePrompt(rawString);
            const currentVal = $input.val();
            const storedValue = $input.attr('data-stored-value');

            // Prepare the prefill value in the format showPromptDialog expects
            let prefill = currentVal;
            if (config.type === 'multi-select') {
                // Split comma-separated string back into array
                prefill = currentVal ? currentVal.split(',') : [];
            } else if (storedValue !== undefined && storedValue !== '' && storedValue !== currentVal) {
                // Autofill prompt with display ≠ value: hand the dialog both
                // pieces so the friendly display shows in the textbox and the
                // underlying value is restored to selectedValue. Without this
                // the dialog would otherwise prefill with the bare key (e.g. a
                // unique_id GUID) and the user would lose their saved label.
                prefill = { value: storedValue, display: currentVal };
            }

            // Reuse the main application's prompt dialog
            const result = await showPromptDialog(config, prefill);

            // If user clicked OK (result is not null), update the input.
            // Track display (visible) and stored (underlying) separately so a
            // subsequent re-open can re-hydrate both halves of the pair.
            if (result !== null) {
                let newDisplay = '';
                let newStored = '';

                if (Array.isArray(result)) {
                    newDisplay = result.map(v => v.display || v.value).join(',');
                    newStored = result.map(v => v.value).join(',');
                } else if (typeof result === 'object') {
                    newDisplay = result.display || result.value;
                    newStored = result.value;
                } else {
                    newDisplay = result;
                    newStored = result;
                }

                $input.val(newDisplay);
                $input.attr('data-stored-value', newStored);
            }
        } catch (e) {
            console.error("Error opening prompt dialog:", e);
        }
    });

    // 5. Cron Helper
    // Granular → Cron sync handled by the duplicate-safe handler near end of scheduler module

    // --- Client-Side Cron Validation Helper ---
    function validateCronExpression(cron) {
        if (!cron)
            return false;
        const parts = cron.trim().split(/\s+/);
        if (parts.length !== 5)
            return false;

        function isValidPart(part, min, max) {
            // Handle lists (e.g. 1,2,3)
            if (part.includes(',')) {
                return part.split(',').every(p => isValidPart(p, min, max));
            }
            // Handle steps (e.g. */5 or 10/2)
            if (part.includes('/')) {
                const [range, step] = part.split('/');
                return isValidPart(range, min, max) && /^\d+$/.test(step) && parseInt(step) > 0;
            }
            // Handle ranges (e.g. 1-5)
            if (part.includes('-')) {
                const [start, end] = part.split('-');
                return isValidPart(start, min, max) && isValidPart(end, min, max) && (start === '*' || parseInt(start) <= parseInt(end));
            }
            // Handle wildcards
            if (part === '*')
                return true;

            // Handle numbers
            const num = parseInt(part);
            return !isNaN(num) && num >= min && num <= max;
        }

        // Standard ranges: Minute(0-59), Hour(0-23), Day(1-31), Month(1-12), DoW(0-7)
        return isValidPart(parts[0], 0, 59) && isValidPart(parts[1], 0, 23) && isValidPart(parts[2], 1, 31) && isValidPart(parts[3], 1, 12) && isValidPart(parts[4], 0, 7);
    }

