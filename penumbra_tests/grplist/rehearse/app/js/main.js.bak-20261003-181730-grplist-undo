            // warning can't disagree with it. The legacy 32-bit hash used here
            // before could collide (~1-in-100 at 10k rows) and warn "N rows share
            // their key" for a key that is in fact perfectly unique - scaring the
            // user off a correct choice. (slice(): the builder sorts a copy, but
            // keep it explicit.)
            var sig = generateRowSignatureStrong(rowMap, upper.slice());
