                if (decodedState.sortCriteria && Array.isArray(decodedState.sortCriteria) && !_penumbraTablelessEmbed()) {
                    sortCriteria = decodedState.sortCriteria;
                }
                // Reset first, exactly like reportColumnSummaries below: this map
                // is keyed by column NAME, so a stale entry from a previously
                // loaded report would silently re-order this one's data AND get
                // written back into its state on the next save. The old code only
                // assigned when the key was present, so "no custom orders" never
                // cleared anything.
                customSortOrders = (decodedState.customSortOrders && typeof decodedState.customSortOrders === 'object')
                    ? decodedState.customSortOrders
                    : {};
                _csInvalidateComparators();
                renderCustomSortOrderCards();

                // The report author's per-column summary defaults. Reset first:
                // this runs per state load, and a stale map from a previously
                // opened report would leak its summaries onto this one.
                reportColumnSummaries = (decodedState.columnSummaries && typeof decodedState.columnSummaries === 'object')
                    ? decodedState.columnSummaries
                    : {};
                reportSummaryBadges = (decodedState.summaryBadges === false) ? false : true;
                reportFrozenCols = penumbraClampFrozenCols(decodedState.frozenCols, 0);
                reportColumnWidths = penumbraCleanColWidths(decodedState.columnWidths, false);
                penumbraColWidthsRefresh();
                reportColumnSummaryFormulas = (decodedState.columnSummaryFormulas && typeof decodedState.columnSummaryFormulas === 'object')
                    ? decodedState.columnSummaryFormulas
