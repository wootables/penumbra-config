                    // holds no content to restore - filling writes it from scratch.
                    if (cell.hasAttribute('data-pnb-lazy')) {
                        // style only (below)
                    } else if (originalHtml !== undefined) {
                        cell.innerHTML = formatCellContent(originalHtml);
                    } else if (byPos[_ci]) {
