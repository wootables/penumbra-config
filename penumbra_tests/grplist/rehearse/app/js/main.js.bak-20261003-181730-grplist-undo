        // Apply default search preset if one exists and search bar is empty
        // (fallback). Tableless embeds skip it - twin of the live-table site.
        if (!snapPreFilterQuery && window._penumbraSearchPresets && !$('#tableSearch').val().trim() && !_penumbraTablelessEmbed()) {
