    // Index-keyed because the <option> value is the row index into this cache.
    var _presetRowCache = [];

    function populatePresetList() {
        var $selector = $('#presetListSelector').empty();
        $('#presetDetails').html('Select a preset to see its details.');
        $('#deleteSelectedPresetBtn').prop('disabled', true);

        if (!window.PenumbraPresets || typeof window.PenumbraPresets.localScopes !== 'function') {
            $selector.append('<option disabled>Preset engine not loaded.</option>');
            return;
        }

        var scopes = window.PenumbraPresets.localScopes();
        var rows = [];
        scopes.forEach(function (sc) {
            window.PenumbraPresets.list(sc.ns, sc.id).forEach(function (p) {
                rows.push({
                    ns: sc.ns,
                    id: sc.id,
                    name: p.name,
                    pinned: !!p.pinned,
                    // The preset body, pretty-printed for the details pane. Kept out
                    // of the <option> attributes on purpose - a pivot preset can be
                    // several KB, and 200 of them in the DOM is a real cost.
                    data: p.data
                });
            });
        });

        if (!rows.length) {
            $selector.append('<option disabled>No presets are saved in this browser.</option>');
            return;
        }

        // Report first, then kind, then name - so every preset for one report sits
        // together, which is how someone cleaning up actually thinks about them.
        rows.sort(function (a, b) {
            if (a.id !== b.id) { return a.id.localeCompare(b.id); }
            if (a.ns !== b.ns) { return a.ns.localeCompare(b.ns); }
            return a.name.localeCompare(b.name);
        });

        _presetRowCache = rows;
        rows.forEach(function (r, i) {
            var label = _presetScopeLabel(r.id) + '  -  ' + _presetNsLabel(r.ns) + ': ' + r.name +
                        (r.pinned ? '  (auto-loads)' : '');
            $selector.append('<option value="' + i + '">' + escapeHtml(label) + '</option>');
        });
