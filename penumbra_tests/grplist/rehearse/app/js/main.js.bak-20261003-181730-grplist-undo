                _accessVarsCache[email] = vars;
                // Attach to EVERY unresolved pill carrying this email - the
                // populate loop can rebuild several pills before this lands.
                $('#authAccessContainer .access-capsule').each(function () {
                    var $c = $(this);
                    if ($c.data('user-vars')) return;
                    var rv = ($c.data('value') || '') + '';
                    var mm = rv.match(/<([^>]+)>/);
                    if (((mm ? mm[1] : rv) + '').trim().toLowerCase() === email) {
                        $c.data('user-vars', vars).addClass('has-user-vars');
