                    const promptErrEl = (e && e.pnbField) || promptInpEl;
                    if (promptErrEl) {
                        const promptOwnHint = _dlgIsDr
                            ? `${dialogId}_hint${promptErrEl.id === `${dialogId}_input2` ? 1 : 0} ` : '';
                        promptErrEl.setAttribute('aria-invalid', 'true');
                        promptErrEl.setAttribute('aria-describedby', `${promptOwnHint}${dialogId}_err`);
                        if (typeof promptErrEl.focus === 'function') promptErrEl.focus();
                    }
                }
            });

            $(`#${dialogId}_cancel`).on('click', function () {
                $(`#${dialogId}`).remove();
                resolve(null);
            });
            $(`#${dialogId}_input`).on('keypress', function (e) {
                if (e.which === 13 && promptConfig.type !== 'multi-select' && promptConfig.type !== 'textarea') {
                    $(`#${dialogId}_ok`).click();
                }
            });

            setTimeout(() => {
                const $input = $(`#${dialogId}_input`);
                $input.focus();
                // Only select text for text-based inputs (excludes dropdowns/multi-selects)
                if ($input.is('input[type="text"], textarea')) {
                    $input.select();
                }
            }
                , 100);
        }
        );
    }

    // =====================================================================
    // DATE-RANGE PROMPT DIALOG BODY
    // =====================================================================
    // A FIXED list of quick ranges, and TWO calendars - one under the From field,
    // one under the To field. The fields are the source of truth: whatever they
    // hold is what gets saved, RAW, so "first day of last month" typed (or picked
    // as a quick range) stays a rolling expression. Each calendar is a pointing
    // device for the field above it: the left one sets From, the right one sets
    // To, and both paint the span.
    //
    // WHY TWO CALENDARS and not one two-month calendar (the first build,
    // 2026-09-21): jQuery UI gives the month / year menus to the FIRST month of a
    // multi-month calendar only - _generateMonthYearHeader() is handed
    // `secondary = row > 0 || col > 0` and prints plain text for every other
    // month - so the second pane could not be navigated on its own. Two
    // single-month calendars each get their own menus, show BOTH ends of a long
    // range at once (a fiscal year: July on the left, June on the right), and
    // need no "which end does the next click set" state at all.
    //
    // The From field keeps the dialog's standard `_input` id on purpose: the
    // shared open/focus/Enter/inline-error plumbing in showPromptDialog all
    // addresses `#<dialogId>_input`, and works here unchanged.
    function _pnbDateRangeDialogHtml(dialogId, promptConfig) {
        const presets = penumbraDateRangePresets().filter(p => !p.needsSource || !!promptConfig.autofill);
        const presetHtml = presets.map(p =>
            `<button type="button" class="pnb-dr-preset" aria-pressed="false" data-from="${escapeHtml(p.from)}" data-to="${escapeHtml(p.to)}" data-label="${escapeHtml(p.label)}">${escapeHtml(p.label)}</button>`
        ).join('');
        const tip = "Pick a day on the calendar below, or type a date or an expression such as TODAY-30, 'first day of last month', '2 years ago'.";
        // The calendars are aria-hidden and out of the tab order: they are a
        // pointing device, and everything they can do the field above them does
        // from the keyboard.
        const endHtml = (i, label, inputId) => `
                    <div class="pnb-dr-end">
                        <label for="${inputId}">${label}</label>
                        <input type="text" id="${inputId}" autocomplete="off" spellcheck="false" title="${escapeHtml(tip)}" aria-describedby="${dialogId}_hint${i}">
                        <div class="pnb-dr-hint" id="${dialogId}_hint${i}" aria-live="polite"></div>
                        <div class="pnb-dr-cal" id="${dialogId}_cal${i}" aria-hidden="true"></div>
                    </div>`;
        return `
            <div class="pnb-dr" id="${dialogId}_dr">
                <div class="pnb-dr-presets" role="group" aria-label="Quick ranges">${presetHtml}</div>
                <div class="pnb-dr-main">${endHtml(0, 'From', `${dialogId}_input`)}${endHtml(1, 'To', `${dialogId}_input2`)}
                </div>
            </div>`;
    }

    function _pnbWireDateRangeDialog(dialogId, promptConfig, initialRaw) {
        const $root = $(`#${dialogId}_dr`);
        const $fields = [$(`#${dialogId}_input`), $(`#${dialogId}_input2`)];
        const $hints = [$(`#${dialogId}_hint0`), $(`#${dialogId}_hint1`)];
        const $cals = [$(`#${dialogId}_cal0`), $(`#${dialogId}_cal1`)];
        if (!$root.length || !$cals[0].length || !$cals[1].length) return;

        let ms = [null, null];      // the two ends resolved to moments (null = empty / not a date)

        const resolveEnds = () => {
            ms = [penumbraResolveRangeEnd($fields[0].val(), promptConfig), penumbraResolveRangeEnd($fields[1].val(), promptConfig)];
        };

        const paint = () => {
            for (let i = 0; i < 2; i++) {
                const raw = String($fields[i].val()).trim();
                let text = '', bad = false;
                if (raw !== '' && !ms[i]) { text = 'Not a date'; bad = true; }
                else if (raw !== '' && raw.toUpperCase() !== penumbraFormatRangeEnd(ms[i])) { text = '= ' + penumbraFormatRangeEnd(ms[i]); }
                if (i === 1 && ms[0] && ms[1] && ms[0].isAfter(ms[1], 'day')) { text = 'Before the From date'; bad = true; }
                $hints[i].text(text).toggleClass('is-bad', bad);
            }
            const preset = penumbraDateRangePresetFor(penumbraJoinDateRange($fields[0].val(), $fields[1].val()));
            $root.find('.pnb-dr-preset').each(function () {
                const on = !!preset && $(this).attr('data-label') === preset.label;
                $(this).toggleClass('is-active', on).attr('aria-pressed', on ? 'true' : 'false');
            });
        };

        // moveEnd: 0 / 1 / 'both' = bring that end's date into view in ITS
        // calendar; null = repaint both where they stand. A calendar click never
        // moves a view - the day that was clicked is already on screen.
        const sync = (moveEnd) => {
            resolveEnds();
            paint();
            for (let i = 0; i < 2; i++) {
                if ((moveEnd === i || moveEnd === 'both') && ms[i]) $cals[i].datepicker('setDate', ms[i].toDate());
                else $cals[i].datepicker('refresh');
            }
        };

        // Only an AUTHOR'S validate= fences the calendars. Bounds injected from an
        // autofill= lookup do not: a range may overhang the data.
        let lo = null, hi = null;
        if (promptConfig.validate && !promptConfig._validateInjected) {
            const minM = promptConfig.validate.match(/min_date\((.+?)\)/);
            const maxM = promptConfig.validate.match(/max_date\((.+?)\)/);
            lo = minM ? moment(minM[1], ['YYYY-MM-DD', 'DD-MMM-YY', 'D-MMM-YY'], true) : null;
            hi = maxM ? moment(maxM[1], ['YYYY-MM-DD', 'DD-MMM-YY', 'D-MMM-YY'], true) : null;
            if (lo && !lo.isValid()) lo = null;
            if (hi && !hi.isValid()) hi = null;
        }

        const calOpts = (i) => {
            const o = {
                numberOfMonths: 1,
                changeMonth: true,
                changeYear: true,
                yearRange: '1900:2100',
                dateFormat: 'dd-M-y',
                defaultDate: i === 0 ? '-1m' : null,    // unanswered: last month on the left, this month on the right
                beforeShowDay: function (date) {
                    const t = moment(date);
                    const cls = [];
                    if (ms[0] && t.isSame(ms[0], 'day')) cls.push('pnb-dr-edge', 'pnb-dr-edge-from');
                    if (ms[1] && t.isSame(ms[1], 'day')) cls.push('pnb-dr-edge', 'pnb-dr-edge-to');
                    if (ms[0] && ms[1] && t.isAfter(ms[0], 'day') && t.isBefore(ms[1], 'day')) cls.push('pnb-dr-in');
                    // The To calendar cannot pick a day before From, so a
                    // backwards range cannot be CLICKED. Done here rather than
                    // with the minDate option: setting an option makes jQuery UI
                    // snap the view back to its own selected date.
                    const selectable = !(i === 1 && ms[0] && t.isBefore(ms[0], 'day'));
                    return [selectable, cls.join(' '), ''];
                },
                onSelect: function (dateText, inst) {
                    resolveEnds();
                    const picked = moment({ year: inst.selectedYear, month: inst.selectedMonth, day: inst.selectedDay });
                    $fields[i].val(penumbraFormatRangeEnd(picked));
                    // A new start PAST the old end starts the range over.
                    if (i === 0 && ms[1] && picked.isAfter(ms[1], 'day')) $fields[1].val('');
                    sync(null);
                }
            };
            if (lo) o.minDate = lo.toDate();
            if (hi) o.maxDate = hi.toDate();
            return o;
        };

        // jQuery UI's inline calendar always carries ONE "selected" day of its
        // own and fills today the same way on dark themes - both would read as
        // range edges. After every render (its own included: month arrows, the
        // month/year menus) hand those cells back to the plain themed look, so
        // the only filled days are the ones beforeShowDay painted. Day links and
        // the menus also leave the tab order: a keyboard user types in the
        // fields, and a hundred tab stops between them and OK help nobody.
        const tidy = () => {
            $root.find('.pnb-dr-cal td.ui-datepicker-current-day').removeClass('ui-datepicker-current-day');
            $root.find('.pnb-dr-cal td a').removeClass('ui-state-active ui-state-highlight').attr('tabindex', '-1').removeAttr('href');
            $root.find('.pnb-dr-cal select').attr('tabindex', '-1');
        };
        $cals[0].datepicker(calOpts(0));
        $cals[1].datepicker(calOpts(1));
        tidy();
        if (typeof MutationObserver !== 'undefined') {
            const obs = new MutationObserver(tidy);
            obs.observe($root.find('.pnb-dr-main')[0], { childList: true, subtree: true });
            $root.on('remove', function () { obs.disconnect(); });
        }

        $fields.forEach(($f, i) => {
            $f.on('input', function () { sync(null); });
            $f.on('change', function () { sync(i); });
        });
        $fields[1].on('keypress', function (e) {
            if (e.which === 13) $(`#${dialogId}_ok`).click();
        });
        $root.on('click', '.pnb-dr-preset', function () {
            $fields[0].val($(this).attr('data-from'));
            $fields[1].val($(this).attr('data-to'));
            sync('both');
        });

        // Used by "Reset to default" - one entry point for putting a raw answer
        // in. A value with no ".." (a default written for a single date) lands in
        // From rather than being dropped.
        const setRange = (raw) => {
            const s = (raw === null || raw === undefined) ? '' : String(raw);
            const k = s.indexOf(PNB_DATE_RANGE_SEP);
            $fields[0].val((k < 0 ? s : s.substring(0, k)).trim());
            $fields[1].val(k < 0 ? '' : s.substring(k + PNB_DATE_RANGE_SEP.length).trim());
            sync('both');
        };
        $root.data('pnbSetRange', setRange);
        setRange(initialRaw);
    }

    // --- Helper to generate the Reset Link HTML ---
    function generateResetLinkHtml(promptConfig, prefillValue, dialogId) {
        // Boolean dialogs have no editable input element - the yes/no buttons
        // ARE the answer mechanism. A "Reset to default" link previously
        // rendered for boolean prompts with default= + saved value but the
        // handler targeted #${dialogId}_input (which doesn't exist on boolean
        // dialogs), making the link a silent no-op. Users seeking to change
        // their answer simply click the desired button directly.
        if (promptConfig.type === 'boolean') {
            return '';
        }

        // Determine effective default (forcedefault supersedes default)
        const defVal = promptConfig.forcedefault !== null ? promptConfig.forcedefault : promptConfig.default;

        // Only show if a default exists AND we are editing a saved value
        if (defVal !== null && defVal !== undefined && prefillValue !== null) {
            const rawDefault = String(defVal);
            const tooltipValue = decodeHtmlEntities(rawDefault);
            return `<a href="#" id="${dialogId}_reset" title="Default: ${escapeHtml(tooltipValue)}" style="font-size: 11px; color: var(--text-muted); text-decoration: underline; margin-left: 10px;">Reset to default</a>`;
        }
        return '';
    }

    // --- Helper to attach the Reset click handler ---
    function attachResetHandler(dialogId, promptConfig) {
        $(`#${dialogId}_reset`).on('click', function (e) {
            e.preventDefault();

            // Determine the value to reset to
            const rawDefault = promptConfig.forcedefault !== null ? promptConfig.forcedefault : promptConfig.default;

            // Date range: TWO fields and a calendar to repaint, so the body's own
            // setter takes the raw "<from>..<to>" default. (The generic branch
            // below would drop the whole pair into the From field.)
            if (penumbraIsDateRangeType(promptConfig.type)) {
                const drSetRange = $(`#${dialogId}_dr`).data('pnbSetRange');
                if (typeof drSetRange === 'function') drSetRange(decodeHtmlEntities(penumbraDateRangeRawDefault(promptConfig)));
                return;
            }

            if (promptConfig.type === 'multi-select') {
                const defaults = parseMultiSelectDefault(rawDefault);
                $(`#${dialogId}_input`).val(defaults).trigger('change');
            } else if (promptConfig.type === 'select') {
                $(`#${dialogId}_input`).val(rawDefault).trigger('change');
            } else {
                // For text/date, decode entities so they appear as normal characters in the input
                const decoded = decodeHtmlEntities(rawDefault);
                $(`#${dialogId}_input`).val(decoded);
                // Also clear any hidden autocomplete data
                $(`#${dialogId}_input`).data('selectedValue', null);
            }
        });
    }

    /**
     * Generates a unique localStorage key for a prompt's saved answer.
     *
     * Scoping (added when the per-report scoping feature landed):
     *  - Default: key is scoped to the currently-loaded report (or `__adhoc__`
     *    for unsaved queries in the editor). Two reports with identical prompt
     *    tags get *separate* saved answers - prevents action-at-a-distance
     *    where editing prompt A's saved value in Report X surprised users of
     *    Report Y.
     *  - Opt-in: when the prompt carries `share` (valueless flag), the key
     *    reverts to the legacy global format so authors who genuinely want
     *    cross-report continuity (e.g. an org-wide "Fiscal Year" prompt) can
     *    keep it. The legacy format match means existing pre-feature saved
     *    values automatically work for `share` prompts without migration.
     *
     * @param {string} promptString  The raw `[PROMPT;...]` tag text.
     * @param {object} [parsedPrompt] Optional pre-parsed config. If omitted,
     *   the key is treated as private (report-scoped) - safe default since
     *   the only way to opt into sharing is via the explicit `share` flag.
     */
    function getPromptStorageKey(promptString, parsedPrompt) {
        // If the caller didn't pre-parse, do it here so the `share` check
        // works at every call site without forcing all 22+ callers to
        // thread a parsedPrompt arg through their loops. Parse is cheap
        // (regex-based string work, no I/O). On parse failure we just treat
        // the prompt as not-shared (the safe default).
        if (!parsedPrompt) {
            try {
                parsedPrompt = parsePrompt(promptString);
            } catch (e) {
                parsedPrompt = null;
            }
        }

        // section= is display only (which review button the chip sits under),
        // so it is not part of the answer's identity: adding, renaming or
        // removing a section keeps every saved answer, and two copies of one tag
        // that differ only in section= (a UNION report with one copy edited)
        // stay ONE prompt - one chip, one dialog. The strip takes the spaces
        // after the value but stops at a line break, so a tag reads the same
        // with its section= (or its section line) deleted. A tag without
        // section= hashes exactly as before.
        const keyText = /section=/i.test(promptString)
            ? promptString.replace(/;\s*section=[^;\]]*?[ \t]*(?=\s*(?:;|\]|$))/gi, '')
            : promptString;

        // Hash the tag string. Same hash function as before so legacy keys
        // line up byte-for-byte with the new `share`-flagged keys.
        let hash = 0;
        for (let i = 0; i < keyText.length; i++) {
            const char = keyText.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash;
        }
        const hashStr = Math.abs(hash);

        const isShared = parsedPrompt && parsedPrompt.share === true;
        if (isShared) {
            return `penumbra_prompt_${hashStr}`;
        }

        // Report scope: matches the pattern used by pivot/viz presets - uses
        // the URL `?id=` param when a saved report is loaded, otherwise the
        // shared `__adhoc__` bucket for editor scratch work.
        const reportId = new URLSearchParams(window.location.search).get('id') || '__adhoc__';
        return `penumbra_prompt_${reportId}_${hashStr}`;
    }

    /**
     * A section= name as a comparable key: trimmed, inner spaces collapsed,
     * lower case ("Report  Period" = "report period"). '' = no section.
     */
    function promptSectionKey(name) {
        return String(name === null || name === undefined ? '' : name).trim().replace(/\s+/g, ' ').toLowerCase();
    }

    /**
     * section= (DISPLAY ONLY): which review button a prompt's chip sits under.
     * Returns a Map of answer key (getPromptStorageKey) -> section key
     * (promptSectionKey; '' = none) for every prompt tag in `text`. The chip bar
     * (updatePromptDisplay) and the review (reconfigureAllPrompts) both use it,
     * so they can never disagree about where a prompt belongs:
     *  - copies of one tag share one answer key (section= is not part of it),
     *    and the FIRST copy that names a section decides;
     *  - a resultif child that names NO section sits in its PARENT's (followed
     *    up the chain), so a follow-up question is reviewed with the answer it
     *    depends on; one that names its OWN section keeps it - a filter that
     *    merely skips itself for some parent answers (dirsearch's People) is
     *    its own control. reconfigureAllPrompts judges such a child against the
     *    parent's SAVED answer. (Until 2026-09-24 14:50 a child ALWAYS followed
     *    its parent and the builder disabled the field; the only way around it
     *    was clearing the Decision Tree, SQL Template included - which broke a
     *    saved report within minutes.)
     */
    function promptSectionMap(text) {
        const tags = String(text || '').match(/\[\s*PROMPT[^\]]*\]/gi) || [];
        const own = new Map();       // answer key -> section key its copies name
        const parentOf = new Map();  // answer key -> resultif parent NAME
        const keyByName = new Map(); // prompt name -> answer key (first wins)
        tags.forEach(tag => {
            let parsed;
            try { parsed = parsePrompt(tag); } catch (e) { return; }
            const k = getPromptStorageKey(tag, parsed);
            const sec = promptSectionKey(parsed.section);
            if (!own.has(k) || (own.get(k) === '' && sec !== '')) own.set(k, sec);
            if (parsed.resultif && parsed.resultif.parentName && !parentOf.has(k)) parentOf.set(k, parsed.resultif.parentName);
            if (parsed.name && !keyByName.has(parsed.name)) keyByName.set(parsed.name, k);
        });
        const out = new Map();
        own.forEach((sec, k) => {
            // No section of its own: walk up the parents until one names a
            // section (or there is no parent); `seen` stops a loop (a <-> b).
            let at = k;
            const seen = new Set([k]);
            while (own.get(at) === '' && parentOf.has(at)) {
                const up = keyByName.get(parentOf.get(at));
                if (up === undefined || seen.has(up)) break;
                seen.add(up);
                at = up;
            }
            out.set(k, own.get(at));
        });
        return out;
    }

    /**
     * Deletes any prompt values flagged as 'nosave' from localStorage.
     * Called after query execution to ensure the next run starts fresh.
     */
    function cleanupNosavePrompts() {
        for (let i = localStorage.length - 1; i >= 0; i--) {
            const key = localStorage.key(i);
            if (key && key.startsWith('penumbra_prompt_')) {
                try {
                    const data = JSON.parse(localStorage.getItem(key));
                    if (data && data.nosave === true) {
                        localStorage.removeItem(key);
                    }
                } catch (e) { }
            }
        }
    }
    // Run cleanup immediately on page load to clear previous session's 'nosave' prompts
    cleanupNosavePrompts();

    // ============================================================
    //  DYNAMIC DATE-RANGE PROMPTS
    //  [PROMPT;type=date;autofill=TABLE.DATE_COL|condition;forcedefault=min]
    //  On a DATE prompt, autofill= is a MIN/MAX range lookup instead of an
    //  option list: the calendar is bounded to the column's [MIN, MAX] and the
    //  `min` / `max` default keywords resolve to those dates. {name} tokens in
    //  the condition are replaced with the current answer of the named prompt
    //  (e.g. PI_NAME = '{pi_name}'), so the range follows the chosen parent.
    //  SERVER TWIN: penumbraApplyDateRangeKeyword() in shared_logic.php
    //  (used by index.php ?json=1 + schedule_runner.php) - keep in sync.
    // ============================================================
    const _promptRangeCache = new Map();
    const _isRangeKeyword = v => typeof v === 'string' && /^\s*(min|max)\s*$/i.test(v);

    /**
     * Current answer of the prompt named `name`, read from localStorage (used
     * by the chip-edit dialog, where processPrompts' answer map isn't in
     * scope). Falls back to the named prompt's own resolved default. Returns
     * null when nothing is known (hidden parents don't persist answers).
     */
    function getPromptAnswerByName(name) {
        try {
            const sql = (typeof editor !== 'undefined' && editor) ? editor.getValue() : '';
            const re = /\[\s*PROMPT[^\]]*\]/gi;
            let m;
            while ((m = re.exec(sql)) !== null) {
                let parsed;
                try { parsed = parsePrompt(m[0]); } catch (e) { continue; }
                if (!parsed.name || parsed.name !== name) continue;
                const key = getPromptStorageKey(m[0], parsed);
                const stored = localStorage.getItem(key);
                if (stored) {
                    try {
                        const data = JSON.parse(stored);
                        if (data && data.value !== undefined) return data.value;
                    } catch (e) { }
                }
                const def = parsed.forcedefault !== null ? parsed.forcedefault : parsed.default;
                return (def === null || def === undefined || _isRangeKeyword(def)) ? null : String(def);
            }
        } catch (e) { }
        return null;
    }

    /**
     * Was an autofill/lookup call killed by an expired sign-in session?
     *
     * The browser gets no session heartbeat - expiry is only ever visible in the
     * SHAPE of a failed request, and this stack produces three different shapes:
     *   - status 0     the XHR followed the SP's 302 to shib.ncsu.edu and CSP
     *                  `connect-src 'self'` killed the cross-origin hop.
     *   - status 403   the request reached PHP with no identity (the proxy did
     *                  not forward KDUSER, or the trust gate blanked it).
     *   - HTML at 200  an SP/proxy interstitial page came back, so dataType
     *                  'json' could not parse it (textStatus 'parsererror').
     * Only the first two were ever checked, which is why an expired session on a
     * prompt type-ahead looked like "no matches" instead of a sign-in dialog.
     *
     * A deliberate abort ALSO reports status 0, so it is exempted FIRST - same
     * trap the #stopQueryBtn regression hit on the main query's error handler.
     *
     * @param   {object} xhr          jqXHR, or the rejection value of an awaited $.ajax
     * @param   {string} [textStatus] jQuery's 2nd error arg; absent on the await path
     * @returns {boolean}
     */
    function autofillAuthFailed(xhr, textStatus) {
        if (!xhr) return false;
        if (textStatus === 'abort' || xhr.statusText === 'abort' || xhr.statusText === 'canceled') return false;
        if (xhr.status === 0 || xhr.status === 403) return true;
        if (textStatus === 'parsererror') return true;
        // await path: jQuery leaves statusText as the transport's native "OK" on a
        // parse failure, so sniff the body instead - a JSON endpoint answering
        // HTML is a login/interstitial page, never a legitimate result.
        return xhr.status === 200 && xhr.responseJSON === undefined &&
               typeof xhr.responseText === 'string' && /^\s*<(!doctype|html)\b/i.test(xhr.responseText);
    }

    /**
     * The same question for a SUCCESSFUL payload. get_autofill_values.php used to
     * answer 200 with {"error":"Access Denied."}, which landed in the success
     * branch - the object was handed straight to jQuery UI and rendered as a menu
     * item reading "Access Denied.". The endpoint sends 403 now, but a cached
     * response or a sibling lookup endpoint can still produce this shape.
     *
     * @param   {*} data  parsed response body
     * @returns {?{message: string, isAuth: boolean}} null when the payload is fine
     */
    function autofillPayloadError(data) {
        if (!data || Array.isArray(data) || typeof data !== 'object') return null;
        if (typeof data.error !== 'string' || data.error === '') return null;
        return {
            message: data.error,
            isAuth: /access denied|not authoriz|unauthoriz|must be logged in|sign(ed)? in/i.test(data.error)
        };
    }

    /**
     * Resolves the MIN/MAX date range for a date prompt carrying an autofill=
     * source: stamps the bounds onto the config (_rangeMinIso/_rangeMaxIso -
     * the datepicker and OK-time validation read these) and swaps `min`/`max`
     * default keywords for the real dates so they never leak into SQL.
     * Idempotent - the second call short-circuits on _rangeResolved.
     *
     * On any failure the keywords fall back to 01-JAN-70 / today: a lookup
     * hiccup should widen the report to the legacy full span, never empty it.
     *
     * @param {object}   config        Parsed prompt (mutated in place)
     * @param {function} answerLookup  name -> current value (or null)
     */
    async function resolvePromptDateRange(config, answerLookup) {
        if (config._rangeResolved) return;
        config._rangeResolved = true;

        const fallbackFor = kw => /min/i.test(kw) ? '01-JAN-70' : moment().format('DD-MMM-YY').toUpperCase();
        const swapKeywords = (minVal, maxVal) => {
            if (_isRangeKeyword(config.forcedefaultRaw) || _isRangeKeyword(config.forcedefault)) {
                const kw = String(config.forcedefaultRaw || config.forcedefault);
                config.forcedefault = /min/i.test(kw) ? minVal : maxVal;
            }
            if (_isRangeKeyword(config.defaultRaw) || _isRangeKeyword(config.default)) {
                const kw = String(config.defaultRaw || config.default);
                config.default = /min/i.test(kw) ? minVal : maxVal;
            }
        };

        try {
            // Substitute {name} tokens; abort to fallbacks if any can't resolve
            // (a literal brace string would just be rejected server-side).
            let condition = config.autofill.condition || '';
            let unresolved = false;
            condition = condition.replace(/\{([a-zA-Z0-9_-]+)\}/g, (m0, n) => {
                const v = answerLookup ? answerLookup(n) : null;
                if (v === null || v === undefined || v === '' || Array.isArray(v)) { unresolved = true; return m0; }
                return String(v).replace(/'/g, "''");
            });
            if (unresolved) { swapKeywords(fallbackFor('min'), fallbackFor('max')); return; }

            const cacheKey = `${config.autofill.table}|${config.autofill.column}|${condition}`;
            let range = _promptRangeCache.get(cacheKey);
            if (range === undefined) {
                range = await $.ajax({
                    url: 'get_autofill_values.php',
                    type: 'GET',
                    data: {
                        mode: 'range',
                        table: config.autofill.table,
                        column: config.autofill.column,
                        condition: condition,
                        short_id: new URLSearchParams(window.location.search).get('id') || ''
                    },
                    dataType: 'json'
                });
                _promptRangeCache.set(cacheKey, range || null);
            }

            // An expired session answers with an error object, not a range. Never
            // let that denial sit in the cache - it would poison every later date
            // prompt for the rest of the page's life, including after re-auth.
            const rangeErr = autofillPayloadError(range);
            if (rangeErr && rangeErr.isAuth) {
                _promptRangeCache.delete(cacheKey);
                handleSessionExpiredError();
            }

            if (range && range.min && range.max) {
                config._rangeMinIso = range.min;
                config._rangeMaxIso = range.max;
                const minVal = moment(range.min, 'YYYY-MM-DD').format('DD-MMM-YY').toUpperCase();
                const maxVal = moment(range.max, 'YYYY-MM-DD').format('DD-MMM-YY').toUpperCase();
                swapKeywords(minVal, maxVal);
                // Enforce the bounds at OK-time through the existing
                // min_date/max_date validation - but never clobber an
                // author-supplied validate= rule.
                if (!config.validate) {
                    config.validate = `min_date(${range.min}),max_date(${range.max})`;
                    // Says the rule above is OURS, not the author's. A date-range
                    // prompt reads this and does not enforce it: a range that
                    // overhangs the data is still a good filter.
                    config._validateInjected = true;
                }
            } else {
                swapKeywords(fallbackFor('min'), fallbackFor('max'));
            }
        } catch (e) {
            // Expiry here used to be swallowed whole: the prompt silently fell back
            // to 01-JAN-70..today and the report ran WIDE, with nothing telling the
            // user their session had gone. The widening still happens (a lookup
            // hiccup must never empty the report) - it just no longer happens quietly.
            if (autofillAuthFailed(e)) handleSessionExpiredError();
            console.warn('Date-range prompt lookup failed:', e);
            swapKeywords(fallbackFor('min'), fallbackFor('max'));
        }
    }

    /**
     * Updates the prompt information display
     */
    // Inline SVG glyphs for each prompt type (the app ships no icon font, so we
    // hand-roll small 24x24 stroke icons that inherit `currentColor`). Used by
    // the typed-chip prompt design - the leading icon tells the user at a glance
    // whether a prompt is a date, dropdown, multi-select, etc.
    // Inner SVG path(s) per prompt type. Shared so the answer-byline chips
    // (promptTypeIconSvg) and the prompt dialog header (showPromptDialog) use
    // identical glyphs — change a glyph here and both update together.
    function promptTypeIconPaths(type) {
        var paths = {
            'text': '<path d="M12 5v14M9 5h6M9 19h6"/>',
            'textarea': '<line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="10" x2="20" y2="10"/><line x1="4" y1="14" x2="20" y2="14"/><line x1="4" y1="18" x2="13" y2="18"/>',
            'date': '<rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/>',
            'select': '<polyline points="5 9 12 16 19 9"/>',
            'multi-select': '<polyline points="12 3 3 8 12 13 21 8 12 3"/><polyline points="3 13 12 18 21 13"/>',
            'boolean': '<rect x="2" y="7" width="20" height="10" rx="5"/><circle cx="16" cy="12" r="3"/>',
            // the date calendar, plus a bar across the grid: a span of days
            'date-range': '<rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="7" y1="15" x2="17" y2="15"/>'
        };
        return paths[type] || paths.text;
    }
    function promptTypeIconSvg(type) {
        return '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + promptTypeIconPaths(type) + '</svg>';
    }

    // Trailing state glyph: a lock for URL-locked prompts, an alert triangle for
    // URL-vs-saved conflicts. Normal prompts get no trailing glyph (the hover
    // pencil from the CSS ::after rule signals "click to edit").
    function promptStateIconSvg(overrideClass) {
        if (overrideClass === 'is-url-overridden') {
            return '<span class="prompt-state-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>';
        }
        if (overrideClass === 'is-url-conflict') {
            return '<span class="prompt-state-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3z"/><line x1="12" y1="10" x2="12" y2="14.5"/><line x1="12" y1="17.5" x2="12" y2="17.6"/></svg></span>';
        }
        return '';
    }

    function updatePromptDisplay() {
        const query = getQuery();
        const snippetQuery = getSnippet();
        const allQueries = query + "\n" + snippetQuery;
        // section= : which box (and review button) each chip sits under, and
        // each section's caption - its name as FIRST written (display only).
        const sectionOf = promptSectionMap(allQueries);
        const sectionLabel = new Map();

        const promptRegex = /\[\s*PROMPT[^\]]*\]/gi;
        const prompts = new Map();
        let match;

        while ((match = promptRegex.exec(allQueries)) !== null) {
            try {
                const parsed = parsePrompt(match[0]);
                const storageKey = getPromptStorageKey(match[0]);
                if (parsed.section) {
                    const _secKey = promptSectionKey(parsed.section);
                    if (_secKey && !sectionLabel.has(_secKey)) sectionLabel.set(_secKey, String(parsed.section).trim().replace(/\s+/g, ' '));
                }

                if (prompts.has(storageKey) || parsed.hidden) {
                    continue;
                }

                const storedDataString = localStorage.getItem(storageKey);

                if (storedDataString) {
                    const storedData = JSON.parse(storedDataString);
                    let displayValue;
                    let fullValue;

                    // --- NEW: Helper to format the *saved* user value for the tooltip ---
                    let savedValueStr = null;
                    if (storedData.savedUserValue !== undefined) {
                        const sv = storedData.savedUserValue;
                        if (Array.isArray(sv)) {
                            savedValueStr = sv.map(item => item.display || item.value).join(', ');
                        } else if (sv && typeof sv === 'object') {
                            savedValueStr = sv.display || sv.value;
                        } else {
                            savedValueStr = String(sv);
                        }
                    }
                    // --------------------------------------------------------------------

                    // Determine Display Value (Standard Logic)
                    let valueToParse = storedData;
                    if (storedData.values !== undefined) {
                        valueToParse = storedData.values;
                    } else if (storedData.message !== undefined) { }

                    if (Array.isArray(valueToParse)) {
                        fullValue = valueToParse.map(item => item.display || item.value).join(', ');
                    } else if (valueToParse && typeof valueToParse === 'object' && valueToParse.display !== undefined) {
                        fullValue = valueToParse.display;
                    } else if (valueToParse && typeof valueToParse === 'object' && valueToParse.value !== undefined) {
                        fullValue = valueToParse.value;
                    } else {
                        fullValue = storedDataString;
                    }

                    if (fullValue === null || fullValue === undefined)
                        fullValue = "[No Value Set]";
                    displayValue = (fullValue.length > 50) ? fullValue.substring(0, 50) + '...' : fullValue;

                    // --- Check for URL Override & Conflicts ---
                    const urlParams = new URLSearchParams(window.location.search);
                    let overrideClass = '';
                    let urlParamName = null;

                    if (parsed.name && urlParams.has(parsed.name)) {
                        urlParamName = parsed.name;

                        // Check for Conflict: URL Value vs Saved User Value
                        let hasConflict = false;
                        if (storedData.savedUserValue !== undefined) {
                            // Compare current 'value' (URL) vs 'savedUserValue' (User)
                            const currentStr = JSON.stringify(storedData.value);
                            const savedStr = JSON.stringify(storedData.savedUserValue);

                            if (currentStr !== savedStr) {
                                hasConflict = true;
                            }
                        }

                        if (hasConflict) {
                            overrideClass = 'is-url-conflict';
                            // Warning style
                        } else {
                            overrideClass = 'is-url-overridden';
                            // Standard lock style
                        }
                    }
                    // --- END ---

                    prompts.set(storageKey, {
                        key: storageKey,
                        message: parsed.label || parsed.message || parsed.type,
                        value: displayValue,
                        fullValue: fullValue,
                        type: penumbraIsDateRangeType(parsed.type) ? 'date-range' : (parsed.type || 'text'),
                        // Date range: the chip shows the LABEL ("Last month"); the
                        // tooltip adds the dates that label means today. Empty when
                        // they cannot be known without a lookup (a min/max half).
                        rangeDates: penumbraIsDateRangeType(parsed.type)
                            ? penumbraDateRangeResolvedText(storedData.value, parsed) : '',
                        count: (Array.isArray(valueToParse) ? valueToParse.length : 0),
                        overrideClass: overrideClass,
                        urlParamName: urlParamName,
                        savedValueStr: savedValueStr,
                        section: sectionOf.has(storageKey) ? sectionOf.get(storageKey) : ''
                    });
                }
            } catch (e) {
                console.warn("Parse Error:", e);
            }
        }

        const $promptList = $('#promptInfoList').empty();

        if (prompts.size > 0) {
            // section= : chips grouped by section, sections in the order their
            // first chip appears. Only TWO OR MORE sections change the bar (see
            // the assembly below); one section, or none, renders as it always did.
            const sectionOrder = [];
            const bySection = new Map();
            prompts.forEach(p => {
                if (!bySection.has(p.section)) {
                    bySection.set(p.section, []);
                    sectionOrder.push(p.section);
                }
                bySection.get(p.section).push(p);
            });
            const sectioned = sectionOrder.length > 1;
            const chipHtml = new Map();
            prompts.forEach(p => {
                // Alone in its section: that section has no review button, so the
                // chip keeps its edit pencil visible (.is-solo) - see below.
                const soloInSection = sectioned && bySection.get(p.section).length === 1;
                let titleAttr = '';

                if (p.overrideClass === 'is-url-conflict') {
                    // Scenario A: Conflict
                    const valTxt = p.savedValueStr ? `'${escapeHtml(p.savedValueStr)}'` : 'your saved value';
                    titleAttr = `title="NOTE: The URL parameter ${escapeHtml(p.urlParamName)} is overriding your saved value (${valTxt}). Clicking will first remove the URL parameter before proceeding."`;
                } else if (p.overrideClass === 'is-url-overridden') {
                    // Scenario B: Standard Override
                    titleAttr = `title="Value locked by URL parameter '${escapeHtml(p.urlParamName)}'. Click to unlock."`;
                } else {
                    // Scenario C: Standard
                    const chipTip = (p.rangeDates && p.rangeDates !== p.fullValue) ? `${p.fullValue} (${p.rangeDates})` : p.fullValue;
                    titleAttr = `title="${escapeHtml(chipTip)}"`;
                }

                const typeClass = 'prompt-type-' + (p.type || 'text');
                const showCount = (p.type === 'multi-select' && p.count > 1);
                const countBadge = showCount ? `<span class="prompt-count" title="${p.count} values selected">${p.count}</span>` : '';
                const li = `
                    <li>
                        <a href="#" class="prompt-byline-link ${typeClass} ${p.overrideClass}${soloInSection ? ' is-solo' : ''}" data-prompt-key="${p.key}" ${titleAttr}>
                            <span class="prompt-ic" aria-hidden="true">${promptTypeIconSvg(p.type)}</span>
                            <em>${escapeHtml(p.message)}:</em> <strong>${escapeHtml(p.value)}</strong>${countBadge}${promptStateIconSvg(p.overrideClass)}
                        </a>
                    </li>
                `;
                chipHtml.set(p.key, li);
            }
            );
            let anyCaption = false;
            if (!sectioned) {
                prompts.forEach(p => $promptList.append(chipHtml.get(p.key)));
            } else {
                // Two or more sections: EVERY section is a box, a section of one
                // included, captioned with its name as first written - set into
                // the box's top border like a form group's legend. A name with no
                // letter or digit ("-", "_") is a box without a caption; the
                // unsectioned prompts' box never has one. A box of 2+ chips also
                // has its own review button (reviews just that section, then
                // re-runs the report); a box of one has none.
                // The wrappers add NO text - the caption is CSS content drawn from
                // data-caption - and the button is a <button>, never an <a>:
                // data(prompts) reads this list's text and the exports (email
                // pills, PDF cover, Excel header, export context) read its `li a`,
                // so all of them still see exactly the chips.
                const reviewSvg = '<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">'
                    + '<polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline>'
                    + '<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>';
                sectionOrder.forEach(sec => {
                    const members = bySection.get(sec);
                    const label = sec === '' ? '' : (sectionLabel.get(sec) || '');
                    const caption = /[\p{L}\p{N}]/u.test(label) ? label : '';
                    if (caption) anyCaption = true;
                    let button = '';
                    if (members.length > 1) {
                        // Names the section and its chips, so each button has its
                        // own accessible name.
                        const names = members.map(p => p.message);
                        const tip = 'Review ' + (caption ? caption + ': ' : '') + (names.length < 3 ? names.join(' and ')
                            : names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1]) + ', then re-run the report.';
                        button = '<button type="button" class="prompt-section-review" data-prompt-section="' + escapeHtml(sec) + '"'
                            + ' title="' + escapeHtml(tip) + '" aria-label="' + escapeHtml(tip) + '">' + reviewSvg + '</button>';
                    }
                    $promptList.append('<li class="prompt-section" data-prompt-section="' + escapeHtml(sec) + '"'
                        + (caption ? ' data-caption="' + escapeHtml(caption) + '"' : '') + '>'
                        + button
                        + '<ul class="prompt-section-list">' + members.map(p => chipHtml.get(p.key)).join('') + '</ul></li>');
                });
            }
            $('#promptInfoList').toggleClass('has-sections', sectioned);
            // Room above the first row for the captions (main.css).
            $('#promptInfoContainer').toggleClass('has-section-captions', anyCaption);
            $('#promptInfoContainer').css('display', 'flex');

            // With exactly ONE visible prompt, "reset all" is a duplicate of
            // clicking the chip: reconfigureAllPrompts de-dupes by storage key,
            // skips hidden prompts, and prefills from localStorage exactly as
            // reconfigureSinglePrompt does - same dialog, same prefill, same
            // save path. Its transactional wrapper and resultif cleanup have
            // nothing to act on at n=1, so hide it.
            //
            // The chip's edit pencil is revealed on :hover, and touch devices
            // have no hover - so mark the solo chip to keep its pencil visible.
            // Without that, hiding the reset icon would leave a phone/tablet
            // user no persistent cue that the answer is editable at all.
            // (Opacity only - the pencil is absolutely positioned in a reserved
            // gutter, so this cannot reflow the chip. See the flex-wrap
            // hover-oscillation note in main.css.)
            //
            // Sections: the section buttons replace this one (a section of one
            // has none, so its chip is marked .is-solo for the same reason).
            // When every chip shares ONE named section the bar looks as it
            // always did, and this button reviews that section.
            var _soloPrompt = (prompts.size === 1);
            $('#resetAllPromptsLink').css('display', (_soloPrompt || sectioned) ? 'none' : '');
            if (!sectioned && sectionOrder[0] !== '') {
                $('#resetAllPromptsLink').attr('data-prompt-section', sectionOrder[0]);
            } else {
                $('#resetAllPromptsLink').removeAttr('data-prompt-section');
            }
            $('#promptInfoList').toggleClass('has-solo-prompt', _soloPrompt);
        } else {
            $('#promptInfoContainer').css('display', 'none');
        }
    }

    $(document).on('click', '#resetAllPromptsLink', function (e) {
        e.preventDefault();
        // Prevents the link from navigating
        // No data-prompt-section (no sections in use) = review every prompt.
        reconfigureAllPrompts($(this).attr('data-prompt-section'));
    });

    // section= : a section's own review button reviews only that section.
    $(document).on('click', '#promptInfoList .prompt-section-review', function (e) {
        e.preventDefault();
        reconfigureAllPrompts(String($(this).attr('data-prompt-section') || ''));
    });

    /**
     * Re-prompts the user for a single prompt value.
     * @param {string} storageKey - The localStorage key for the prompt to re-ask.
     */
    async function reconfigureSinglePrompt(storageKey) {
        const query = getQuery();
        const snippetQuery = getSnippet();
        const allQueries = query + "\n" + snippetQuery;

        const promptRegex = /\[\s*PROMPT[^\]]*\]/gi;
        let match;
        let promptToAsk = null;

        // Find the full prompt string that matches the storage key
        while ((match = promptRegex.exec(allQueries)) !== null) {
            if (getPromptStorageKey(match[0]) === storageKey) {
                promptToAsk = match[0];
                break;
            }
        }

        if (!promptToAsk) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Could not find the original prompt in the query. If you made a change to the prompt, you must first re-run the report (F9).</p>", 10000);
            return;
        }

        // --- NEW: Fetch currently saved value to pre-fill the dialog ---
        let prefillValue = null;
        const storedDataString = localStorage.getItem(storageKey);
        if (storedDataString) {
            try {
                const storedData = JSON.parse(storedDataString);
                if (!Array.isArray(storedData) && storedData.values !== undefined) {
                    prefillValue = storedData.values.map(v => v.value);
                } else if (storedData.value !== undefined) {
                    // If a separate display label was saved alongside the value
                    // (autofill text/textarea prompts where the visible text
                    // differs from the underlying key, e.g. "Limon, Bruce
                    // (4095)" → unique_id GUID), pass both so the dialog shows
                    // the friendly display in the textbox and re-binds the
                    // underlying value to selectedValue.
                    if (storedData.display !== undefined && storedData.display !== storedData.value) {
                        prefillValue = { value: storedData.value, display: storedData.display };
                    } else {
                        prefillValue = storedData.value;
                    }
                } else if (Array.isArray(storedData)) {
                    prefillValue = storedData.map(v => v.value || v);
                } else {
                    prefillValue = storedData;
                }
            } catch (e) { }
        }
        // --- END NEW ---

        try {
            const parsedPrompt = parsePrompt(promptToAsk);

            // --- START: RESTRICTION LOGIC ---
            // If the user clicked a 'nosave' prompt, check if there are OTHER 'nosave' prompts.
            // If so, force them to use "Reset All" to prevent data inconsistency.

            /* ***************** too confusing, disabling for now
            
            if (parsedPrompt.nosave) {
                const countRegex = /\[\s*PROMPT[^\]]*\]/gi;
                let nsCount = 0;
                let cMatch;
                while ((cMatch = countRegex.exec(allQueries)) !== null) {
                     try {
                         if (parsePrompt(cMatch[0]).nosave) nsCount++;
                     } catch(e){}
                }
                
                if (nsCount > 1) {
                    const refreshIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: text-bottom;"><path d="M23 4v6h-6"></path><path d="M1 20v-6h6"></path><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>`;
                    show_text(`<p id='undo_text'><span style='color: orange'>NOTE:</span> This is a tandem value and can only be changed using the 'Reset All' button (${refreshIconSvg} icon).</p>`);
                    return;
                }
            }
            */
            // --- END: RESTRICTION LOGIC ---

            // Pass the prefillValue to the dialog
            const userInput = await showPromptDialog(parsedPrompt, prefillValue);

            if (userInput !== null) {
                const urlParams = new URLSearchParams(window.location.search);
                const currentReportId = urlParams.get('id') || null;
                if (!parsedPrompt.hidden) {
                    const dataToSave = (Array.isArray(userInput)) ? {
                        message: parsedPrompt.message,
                        values: userInput,
                        reportId: currentReportId
                    } : {
                        ...userInput,
                        message: parsedPrompt.message,
                        reportId: currentReportId
                    };

                    // INJECT FLAG:
                    if (parsedPrompt.nosave)
                        dataToSave.nosave = true;

                    localStorage.setItem(storageKey, JSON.stringify(dataToSave));

                    // --- Clear dependent 'nosave' children to force recalculation ---
                    // If the prompt the user just edited is a parent, drop any
