                // and count(COL, Done = ☑) resolve. The two sibling snippet engines
                // already merge; this one was missed, so the condition form the design
                // explicitly supports silently returned 0.
                if (window.Penumbra && window.Penumbra.journalMergeCols) {
                    visibleContextCols = window.Penumbra.journalMergeCols(visibleContextCols);
                }

                // 3. OPTIMIZATION: Parse the query ONCE, outside the filter loop
                let parsedCondition = null;
                if (condition) {
                    parsedCondition = parseAdvancedQuery(condition, visibleContextCols);
                }

                // 4. Filter rows using the pre-parsed condition object
                const filteredMaps = parsedCondition ? matchingRowMaps.filter(map => evaluateParsedQuery(map, parsedCondition, visibleContextCols)) : matchingRowMaps;

