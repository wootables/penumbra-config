    // Map the pivot currently on screen onto a viz config.
    // Returns { config, warnings[] } - config is always usable; warnings name
    // every part of the pivot that could not come along.
    function pivotToVizConfig() {
        var P = _lastPivotChart;
        if (!P) return null;
