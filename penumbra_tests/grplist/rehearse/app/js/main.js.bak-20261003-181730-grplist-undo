    var _schedTestOnceIntent = false;
    var _schedTransientTestId = null;
    var _schedTransientPoll = null;
    var SCHED_TEST_DRAFT_TITLE = 'Run this draft once now WITHOUT adding it to the scheduled events. Executes within ~5 min on the next scheduler cycle, then cleans itself up. No Schedule (cron) required.';

    function serializeSchedulerForm() {
        var parts = [];
        $('.scheduler-config-panel').find('input, select, textarea').each(function () {
            var el = this;
            // Skip hidden plumbing (task id, schema) and the transient email
            // entry box (text typed before it becomes a recipient capsule).
            if (el.type === 'hidden') return;
            if (el.classList && el.classList.contains('capsule-input')) return;
            var key = el.id || el.name || '';
            if (el.type === 'checkbox' || el.type === 'radio') {
                parts.push(key + '#' + el.value + '=' + (el.checked ? 1 : 0));
            } else {
                parts.push(key + '=' + (el.value == null ? '' : el.value));
