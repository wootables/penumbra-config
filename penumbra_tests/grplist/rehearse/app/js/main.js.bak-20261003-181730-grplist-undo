        var state = $c.data('drillState');
        if (!state) return;
        var originalCfg = state.originalCfg;
        var originalRows = state.originalRows;

        // Tear down drill adornments before re-rendering to avoid a
        // frame where the old breadcrumb still sits above the restored
        // chart.
        _wipeDrillState(canvas);

        var existing = (typeof Chart !== 'undefined' && Chart.getChart) ? Chart.getChart(canvas) : null;
        if (existing) { try { existing.destroy(); } catch (e) { } }

        if (typeof renderSnippetChart !== 'function') return;
        try {
            var restoredData = generateChartDataFromMaps(
                originalRows, originalCfg.xAxis, originalCfg.yAxis,
                originalCfg.groupBy || null, originalCfg.agg, originalCfg.limit,
                originalCfg.type, originalCfg.sortBy, originalCfg.sortDir,
                originalCfg.stackOrder, originalCfg.normalize,
                originalCfg.otherBucket, originalCfg.comboSeries || null, originalCfg.funnelMode, originalCfg
            );
            if (originalCfg.trendLine && originalCfg.trendLine !== 'none' && typeof injectTrendDataset === 'function') {
                injectTrendDataset(restoredData, originalCfg.trendLine);
            }
            renderSnippetChart(canvas.id, originalCfg.type, restoredData, originalCfg.title || '',
                originalCfg.legend, originalCfg.values, originalCfg.legendPos, originalCfg.valuePos,
                originalCfg.animate, originalCfg.stacked, originalCfg.horizontal, originalCfg.titlePos,
                originalCfg.isCurrency, originalCfg.normalize, originalCfg.subtitle,
                originalCfg.xAxisLabel, originalCfg.yAxisLabel, originalCfg.logScale,
                originalCfg.yMin, originalCfg.yMax, originalCfg.comboSeries || null, originalCfg.comboFill, originalCfg.referenceLine);
            $c.data('vizConfig', originalCfg);
            $c.data('sourceRowData', originalRows);
        } catch (e) {
            console.error('Failed to restore pre-drill chart:', e);
        }
    }

    // Change a breadcrumb dropdown → modify the path at that index,
    // truncate deeper steps (they're scoped to the old value), set the
    // displayed column to whatever was next in the old path (so e.g.
    // changing College while viewing Dept still shows a Dept chart),
    // and redraw.
    $(document).on('change', 'select.chart-drill-bc-val', function () {
        var $sel = $(this);
        var idx = parseInt($sel.attr('data-step-idx'), 10);
        var newVal = $sel.val();
        // Breadcrumb lives inside a centering container; walk up to
        // that container and then grab the sibling canvas in the
        // common parent.
        var $bar = $sel.closest('.chart-drill-breadcrumb-bar');
        var $container = $bar.closest('.chart-drill-breadcrumb-container');
        var $owner = $container.length ? $container : $bar;
        var $canvas = $owner.siblings('canvas').first();
        if (!$canvas.length) {
            $canvas = $owner.parent().find('canvas').first();
        }
        if (!$canvas.length) return;
        var canvas = $canvas[0];
        var state = $canvas.data('drillState');
        if (!state || !state.path[idx]) return;

        var oldPath = state.path.slice();
        // Truncate to just [0..idx], update val + display at idx
        state.path = oldPath.slice(0, idx + 1);
        state.path[idx] = Object.assign({}, state.path[idx], {
            val: newVal,
            display: state.path[idx].col + ' = ' + newVal
        });
        // If the old path went deeper, the next col becomes the
        // displayed col (user was N levels deep on OLD; after truncate
        // they're back at level i with the chart showing one level
        // deeper - the breadcrumb should shorten, but the displayed
        // axis is what they were drilled into at that level).
        if (oldPath.length > idx + 1) {
            state.displayedCol = oldPath[idx + 1].col;
        }
        // (if no truncation happened - idx was the last step - the
        //  displayedCol stays unchanged)
        $canvas.data('drillState', state);
        _redrawChartFromDrillState(canvas);
    });

    // Exit-drill click handler.
    $(document).on('click', '.chart-drill-exit', function (e) {
        e.preventDefault();
        var $bar = $(this).closest('.chart-drill-breadcrumb-bar');
        var $container = $bar.closest('.chart-drill-breadcrumb-container');
        var $owner = $container.length ? $container : $bar;
        var $canvas = $owner.siblings('canvas').first();
        if (!$canvas.length) $canvas = $owner.parent().find('canvas').first();
        if (!$canvas.length) return;
        _exitDrill($canvas[0]);
    });

    // Install the chart-click drill-popup handler on a chart config.
    // Called from createVisualization and renderSnippetChart before
    // `new Chart(ctx, config)`.  Only data-element clicks (bars, slices,
    // points) open the drill popup - axis-label clicks were removed
    // because reliable hit-testing on rotated / truncated tick labels
    // proved impractical across Chart.js versions.
