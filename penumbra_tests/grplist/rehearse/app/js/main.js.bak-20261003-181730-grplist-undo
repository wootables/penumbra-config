                $('#snapshotComparisonContainer .group-wrapper').each(function () { recomputeWrapperTotals($(this)); });
                totalVisibleRows = $('#snapshotComparisonContainer tbody tr').length;

            } else {
                // Logic for APPLYING a search
                // String(): jQuery .data() coerces a numeric-looking data-colname
            // (a fiscal-year column literally named "2025") to a Number, and
            // parseAdvancedQuery then calls .toUpperCase() on it -> TypeError.
            // runTableSearch is async, so that surfaced as an unhandled rejection
            // with the "Filtering comparison results..." overlay stranded forever.
            const allColumns = $("#snapshotComparisonContainer th[data-colname]").map((_, th) => String($(th).data('colname'))).get();
                const parsedQuery = parseAdvancedQuery(searchValue, allColumns);

                $('#snapshotComparisonContainer .group-wrapper').each(function () {
                    const $groupWrapper = $(this);
                    const $header = $groupWrapper.find('.group-header');
                    const totalRowsInGroup = $header.data('total-rows');
                    let visibleRowsInGroup = 0;
                    // NEW FIXED CODE:
                    // 1. Build a map of { Name -> ID } derived directly from the DOM headers
                    const colMap = [];
                    $groupWrapper.find("thead th[data-colname]").each(function () {
                        colMap.push({
                            name: $(this).data('colname'),
                            id: $(this).attr('data-column')// Gets "#" or "0", "1", etc. correctly
                        });
                    });

                    // 2. Iterate rows using the correct IDs
                    $groupWrapper.find('tbody tr').each(function () {
                        const $row = $(this);
                        const rowDataMap = new Map();

                        colMap.forEach(col => {
                            // _readComparisonCellText: match against the CURRENT value
                            // of modified cells, not both dual views concatenated.
                            rowDataMap.set(col.name, _readComparisonCellText($row.find(`td[data-column='${col.id}']`)[0]));
                        }
                        );

                        const match = evaluateParsedQuery(rowDataMap, parsedQuery, colMap.map(c => c.name));
                        // .search-hidden class instead of inline display:none - so
                        // getExportData() can filter on .search-hidden when collecting
                        // rows for download/copy triggers (js/main.js:29936).
                        $row.toggleClass('search-hidden', !match);
                        if (match) {
                            visibleRowsInGroup++;
                        }
                    });

                    totalVisibleRows += visibleRowsInGroup;
                    // Add to the grand total
                    $header.find('.group-count').text(`${visibleRowsInGroup} of ${totalRowsInGroup}`);
                    $groupWrapper.toggleClass('search-hidden', visibleRowsInGroup === 0);
                    // Recompute the per-group tfoot totals so they reflect the filtered
                    // rows. Without this, the XLSX/CSV/HTML export reads a stale tfoot
                    // computed at render time from the full group, even though the body
                    // row data correctly skips hidden rows.
                    recomputeWrapperTotals($groupWrapper);
                });
            }

            updateComparisonResultCount(totalVisibleRows);
            // Update the main count with the correct number
            applyZebraStriping();
            penumbraUpdateSearchEmptyState(searchValue, totalVisibleRows, masterRowData.length);
            updateFloatingButtonStates();
            showLinkSearchNotification();
            hideLoading();
            updateTableBorders();
            return;
            // Exit to prevent other search logic from running
        }
        const isPivotMode = $('#pivot-output-container').is(':visible');
        const isGroupedMode = $('#groupedResultsContainer').is(':visible');
        // __SRC (pivot view: a name a source column shares with an aggregate
        // label searches the column) is taken out HERE, before the view
        // branches, so in the grouped and flat views it is a no-op rather than
        // a search term. See penumbraTakeSrcModifier.
        const _srcTake = penumbraTakeSrcModifier($('#tableSearch').val().trim());
        const searchValue = _srcTake.query;
        const searchSourceRows = _srcTake.src;

        // --- GROUPED MODE SEARCH LOGIC ---
        if (isGroupedMode) {
            showLoading("Filtering grouped results...");
            setTimeout(async () => {
                // Summary conditions (e.g. "Sum of AMOUNT > 50000") filter whole groups
                // by their recalculated summary; collected in the apply branch below.
                let groupSummaryConds = null;
                if (searchValue === '') {
                    // When clearing a search, unmark all rows in the hidden main table.
                    // (No .show(): the flat table is hidden here, and every path back
