    // Resolve nested now()/calc()/case() calls in a data-search value so
    // snippet-output pills can embed dynamic date logic. Only the three
    // functions commonly used in counters are supported - everything else
    // passes through unchanged.
    function _resolveDataSearchDynamic(q) {
        if (!q || typeof q !== 'string') return q;
        const evalLiteralCond = (cond) => {
            const m = String(cond).trim().match(/^(.+?)\s*(>=|<=|!=|==|=|>|<)\s*(.+?)$/);
            if (!m) return !!String(cond).trim();
            const toVal = (s) => {
                s = stripWrappingQuotePair(s.trim());
                const n = parseFloat(s);
                return (!isNaN(n) && /^-?\d*\.?\d+$/.test(s)) ? n : s;
            };
            const l = toVal(m[1]), r = toVal(m[3]);
            switch (m[2]) {
                case '>=': return l >= r;
                case '<=': return l <= r;
                case '>':  return l > r;
                case '<':  return l < r;
                case '==': case '=': return l == r;
                case '!=': return l != r;
            }
            return false;
        };
        let out = q;
        let safety = 0;
        while (safety++ < 25) {
            let changed = false;
            out = out.replace(/\bnow\(([^()]*)\)/gi, (m, body) => {
                changed = true;
                // Split args honoring quoted commas, then strip outer quotes
                const argsArr = [];
                let cur = '', inQ = false, qc = '';
                for (let i = 0; i < body.length; i++) {
                    const ch = body[i];
                    if (!inQ && (ch === "'" || ch === '"')) { inQ = true; qc = ch; cur += ch; }
                    else if (inQ && ch === qc) { inQ = false; qc = ''; cur += ch; }
                    else if (!inQ && ch === ',') { argsArr.push(cur.trim()); cur = ''; }
                    else cur += ch;
                }
                if (cur.trim()) argsArr.push(cur.trim());
                const stripped = argsArr.map(a => {
                    if ((a.startsWith("'") && a.endsWith("'")) || (a.startsWith('"') && a.endsWith('"'))) return a.slice(1, -1);
                    return a;
                });
                const offsetRE = /^[+-]?\d+\s+(year|years|y|month|months|M|day|days|d|week|weeks|w|hour|hours|h|minute|minutes|m|second|seconds|s)$/;
                let fmt = 'MM/DD/YYYY', offsets = [];
                if (stripped.length === 1) {
                    fmt = stripped[0] || 'MM/DD/YYYY';
                } else if (stripped.length > 1) {
                    const hasOffsets = stripped.slice(1).some(a => offsetRE.test(a.trim()));
                    if (hasOffsets) {
                        fmt = stripped[0];
                        offsets = stripped.slice(1).filter(a => offsetRE.test(a.trim())).map(a => a.trim());
                    } else {
                        fmt = body.replace(/['"]/g, '');
                    }
                }
                if (!fmt.trim()) fmt = 'MM/DD/YYYY';
                try {
                    let mo = moment();
                    for (const off of offsets) {
                        const nm = off.match(/^([+-]?\d+)\s+(\w+)$/);
                        if (nm) {
                            const n = parseInt(nm[1], 10);
                            const unit = nm[2];
                            if (n >= 0) mo = mo.add(n, unit); else mo = mo.subtract(Math.abs(n), unit);
                        }
                    }
                    return mo.format(fmt).toUpperCase();
                } catch (e) { return m; }
            });
            out = out.replace(/\bcalc\(([^()]+)\)/gi, (m, expr) => {
                if (/^[0-9+\-*/().\s]+$/.test(expr)) {
                    try { const v = new Function('return ' + expr)(); if (typeof v === 'number' && isFinite(v)) { changed = true; return String(v); } } catch (e) {}
                }
                return m;
            });
            out = out.replace(/\bcase\(([^()]+)\)/gi, (m, inner) => {
                const parts = inner.split(',').map(s => s.trim());
                if (parts.length < 2) return m;
                const hasDefault = parts.length % 2 === 1;
                const pairCount = hasDefault ? (parts.length - 1) / 2 : parts.length / 2;
                for (let i = 0; i < pairCount; i++) {
                    if (evalLiteralCond(parts[i * 2])) { changed = true; return parts[i * 2 + 1]; }
                }
                if (hasDefault) { changed = true; return parts[parts.length - 1]; }
                changed = true; return '';
            });
            if (!changed) break;
        }
        return out;
    }

