        $('#authAccessContainer .access-capsule').remove();
        $('#authAccessInput').val('');

        if (!rawList) return;

        var entries = rawList.split(',');
        var textParts = [];

        for (var i = 0; i < entries.length; i++) {
            var entry = entries[i].trim();
            if (!entry) continue;

            var parsed = parseAccessEntry(entry);
            if (!parsed) continue;

            if (isPillAccessType(parsed.type)) {
                addAccessCapsule(parsed.value, parsed.display, parsed.type);
            } else {
                textParts.push(parsed.value);
            }
        }

        if (textParts.length > 0) {
            $('#authAccessInput').val(textParts.join(', '));
