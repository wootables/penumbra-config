    // ── Data-exploration mode: leaving a saved report for an ad-hoc table ──
    // When the live view diverges from the saved report named by ?id= (e.g. an
    // admin double-clicks a table to inspect it), the id in the URL becomes a
    // lie: a refresh, bookmark, or shared link would reload the saved report,
    // not the raw table that's actually on screen. So we drop ?id= and surface
    // a toast that offers one click back to the report they came from.
    //
    // This is deliberately NOT the snapshot-exit behaviour: snapshot exit keeps
    // ?id= and falls back to the live version of the SAME report. An ad-hoc
    // table has no such in-between state - it's genuinely unsaved - hence the
    // full id removal plus an explicit "restore" affordance instead.
    var _explorationRestoreHref = null;

    function _enterExplorationModeFromSavedReport() {
        try {
            var url = new URL(window.location.href);
            var priorId = url.searchParams.get('id');
            if (!priorId) return;                            // already ad-hoc - nothing to clear
            _explorationRestoreHref = window.location.href;  // full URL incl. id, for restore
            url.searchParams.delete('id');
