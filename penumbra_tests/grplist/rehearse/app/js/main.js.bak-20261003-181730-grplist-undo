     * @param {string} displayName - The label to display on the pill
     * @param {string} type - 'ncsu' or 'external'
     * @param {string} [preserveText] - Optional text to keep in the input (e.g., OUCs that precede the pill term)
     */
    function addAccessCapsule(value, displayName, type, preserveText, userData) {
        if (!value) return;

        var containerSel = '#authAccessContainer';
        var inputSel = '#authAccessInput';

        // Prevent duplicates by normalized value. String-coerce the stored
        // value: jQuery .data() turns a numeric data-value (an OUC pill like
        // "51") into a Number, and Number.trim() throws.
        var normalizedVal = value.trim().toLowerCase();
        var exists = false;
        $(containerSel + ' .access-capsule').each(function () {
            if ((($(this).data('value') || '') + '').trim().toLowerCase() === normalizedVal) {
                exists = true;
            }
        });
        if (exists) {
            $(inputSel).val(preserveText !== undefined ? preserveText : '');
            return;
        }

        var typeClass = (type === 'ncsu') ? 'ncsu-user'
            : (type === 'ouc') ? 'ouc-code'
            : (type === 'public') ? 'keyword-public'
            : (type === 'adminonly') ? 'keyword-adminonly'
            : 'external-email';
        var tooltip = escapeHtml(value);

        var capsuleHtml = '<div class="access-capsule ' + typeClass + '" data-value="' + escapeHtml(value) + '" data-type="' + type + '" title="' + tooltip + '">' +
            '<span>' + escapeHtml(displayName || value) + '</span>' +
            '<span class="remove-access">&times;</span>' +
