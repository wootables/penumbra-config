                    requestAnimationFrame(function () { setTimeout(fin, 0); });
                });
            }
        });
    }

    // Scoped loading (2026-09-24). A view change started from a layout_switch or
    // toggle_switch dims the data region only, so the control can be seen
    // moving and the rest of the header stays in view; so does a load that only
    // rearranges the data (Restore Transaction List, Remove Grouping, a sort -
    // showLoading's opts.scoped, 2026-09-25). The overlay itself still
    // spans the viewport - transparent - so the page is exactly as un-clickable
    // as under the full-screen load; only what is PAINTED is scoped (the veil is
    // its ::before, and padding centres the spinner and message in the same
    // box). With too little of the data on screen to carry the spinner it stays
    // the ordinary full-screen overlay. The box is re-measured on every frame
    // the browser gets to paint, so a reflow or a scroll keeps it on the data.
    var _pnbScopeRaf = 0;
    var _PNB_SCOPE_MIN_H = 200, _PNB_SCOPE_MIN_W = 240, _PNB_SCOPE_ROOMY_H = 300;
    function _pnbLoadingScope(on) {
        var ov = document.getElementById('loadingOverlay');
        if (!ov) return;
        if (_pnbScopeRaf && window.cancelAnimationFrame) cancelAnimationFrame(_pnbScopeRaf);
        _pnbScopeRaf = 0;
