                        break;
                    }
                case 'remove-favorite':
                    {
                        let favs = Array.from(new Set(JSON.parse(localStorage.getItem(favoriteStorageKey) || "[]")));
                        favs = favs.filter(f => f !== tableName);
                        localStorage.setItem(favoriteStorageKey, JSON.stringify(favs));
                        populateSelectorBox();
                        dispatchFavoritesChanged('console');
                        show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Removed "${tableName}" from favorites.</p>`);
                        break;
                    }
                case 'clear-sql':
                    editor.setValue(`SELECT * FROM ${tableName}`);
                    $("#executeQuery").click();
                    break;
                case 'open-new':
                    const adminState = {
                        query: `SELECT * FROM ${tableName}`,
                        noLimit: false
                    };
                    const adminEncoded = compressString(JSON.stringify(adminState));
                    const adminUrl = window.location.href.split("?")[0] + "?state=" + adminEncoded;
                    window._pnbOpenTabOrNotice(_srcItem, adminUrl, 'use <strong>Open Here</strong> to load the table in this view');
                    break;
                case 'insert-text':
                    if (editor) {
                        editor.replaceSelection(tableName);
                        editor.focus();
                    }
                    break;
                case 'copy-text':
                    window._pnbCopyText(tableName, `Copied "${tableName}" to clipboard.`);
                    break;

            }

            menu.remove();
        });

        window._pnbBodyFor(e).append(menu); // PiP-aware: menu renders in the window that spawned it

        setTimeout(() => {
            $(document).one('click', () => menu.remove());
        }
            , 0);
    }

    // Show additional state options
