    }

    // The data region's visible box, as insets from the viewport edges, or null
    // when too little of it is on screen. Outside split layout the results
    // header (search box, pager) is part of it; in split layout that header
    // spans both halves, and taking it in would veil the pane the control is in.
    //
    // The box runs from the top of the data region to the bottom of what is on
    // screen, not to the region's own bottom: a grouped view with its groups
    // collapsed can be ~100px tall, and the view coming in fills that space
    // anyway. Nothing sits below the data region in any header layout (split
    // puts the snippet BESIDE the table), so nothing else is covered.
    function _pnbLoadingScopeBox() {
        var tv = document.getElementById('table-view-container');
        if (!tv || !tv.getClientRects().length) return null;
        var r = tv.getBoundingClientRect();
        if (r.bottom <= 0) return null;
        var top = r.top, left = r.left, right = r.right, bottom = Infinity;
        var rh = document.getElementById('resultsHeader');
