    // Offer to create a baseline snapshot when this report has none yet. Shared
    // by "Skip if no changes" and "Send as Change Analysis" - both compare future
    // runs against the last server snapshot, and the scheduler can read the
    // plain-JSON baseline this saves.
    function offerSchedulerBaselineSnapshot() {
        {
            var reportId = new URLSearchParams(window.location.search).get('id');
            if (!reportId) return;

            $.ajax({
                url: 'manage_snapshots.php?action=list&report_id=' + encodeURIComponent(reportId),
                method: 'GET',
                dataType: 'json',
                success: function (response) {
                    if (response.status === 'success' && response.data && response.data.length > 0) {
                        return; // Snapshots exist, nothing to do
                    }
                    // No snapshots exist - offer to create a baseline
                    var hasData = $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)").length > 0;
                    var message = 'No server snapshots exist for this report yet.\n\n';
                    if (hasData) {
                        message += 'Would you like to create a baseline snapshot now?\n\n' +
                            'If you choose "OK", a snapshot of your current data view will be saved to the server immediately. ' +
                            'The scheduler will compare future runs against this baseline.\n\n' +
                            'If you choose "Cancel", the initial snapshot will be created on the first scheduled run (so the email will send out the first time).';
                    } else {
                        message += 'No data is currently loaded, so a baseline snapshot cannot be created right now. ' +
                            'The first scheduled run will automatically create the initial snapshot (and will always send/execute since there is nothing to compare against).';
                    }

                    if (!hasData) {
                        alert(message);
                        return;
                    }

                    if (!confirm(message)) return;

                    // Create baseline snapshot using current view data
                    showLoading("Saving baseline snapshot...");
                    setTimeout(async function () {
                        try {
                            var $sourceRows = $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)");
                            var snapshotData = [];
                            var signatureCounts = {};
                            $sourceRows.each(function () {
                                var rowIndex = parseInt($(this).find("td[data-column='#']").text(), 10) - 1;
                                var rowDataMap = masterRowData[rowIndex];
                                if (rowDataMap) {
                                    var baseSignature = generateRowSignature(rowDataMap);
                                    signatureCounts[baseSignature] = (signatureCounts[baseSignature] || 0) + 1;
                                    var uniqueSignature = signatureCounts[baseSignature] > 1 ? baseSignature + '_' + (signatureCounts[baseSignature] - 1) : baseSignature;
                                    snapshotData.push({
                                        signature: uniqueSignature,
                                        rowData: (window.Penumbra && window.Penumbra.journalSnapshotRowData)
                                                ? window.Penumbra.journalSnapshotRowData(rowDataMap)
                                                : Object.fromEntries(rowDataMap)
                                    });
                                }
                            });

                            var isGrouped = $('#groupedResultsContainer').is(':visible');
                            var totalColumns = 0, visibleColumns = 0;
                            if (isGrouped) {
                                totalColumns = $("#groupedResultsContainer .group-wrapper:first thead th[data-colname]").length;
                                visibleColumns = $("#groupedResultsContainer .group-wrapper:first thead th[data-colname]:visible").length;
                            } else {
                                totalColumns = $("#tableHeader th[data-colname]").length;
                                visibleColumns = $("#tableHeader th[data-colname]:visible").length;
                            }

                            var rawSigParts = $sourceRows.map(function () {
                                var rowIndex = parseInt($(this).find("td[data-column='#']").text(), 10) - 1;
                                return generateRowSignature(masterRowData[rowIndex]);
                            }).get().sort().join('');
                            var sigHash = 0;
                            for (var i = 0; i < rawSigParts.length; i++) {
                                var ch = rawSigParts.charCodeAt(i);
                                sigHash = ((sigHash << 5) - sigHash) + ch;
                                sigHash = sigHash & sigHash;
                            }
                            var dataSignature = 'SIG_' + Math.abs(sigHash).toString(36) + '_' + snapshotData.length;

                            var baselineColNames = [];
                            if (snapshotData.length > 0 && snapshotData[0].rowData) {
                                for (var bk in snapshotData[0].rowData) {
                                    if (snapshotData[0].rowData.hasOwnProperty(bk)) {
                                        var bkU = bk.toUpperCase();
                                        if (bkU !== '#') baselineColNames.push(bkU);
                                    }
                                }
                                baselineColNames.sort();
                            }
                            var payload = {
                                action: 'save',
                                report_id: reportId,
                                snap_name: 'Baseline (pre-scheduler)',
                                snap_data: JSON.stringify(snapshotData),
                                row_count: snapshotData.length,
                                column_count: totalColumns + ' (' + visibleColumns + ' visible)',
                                tables_used: extractTablesFromQuery(editor.getValue()),
                                search_term: $('#tableSearch').val().trim(),
                                data_signature: dataSignature,
                                notes: '',
                                column_names: baselineColNames,
                                // Was omitted - a baseline without prompts made the compare
                                // context grid flag every prompt as a false mismatch.
                                prompts: _captureCurrentPrompts()
                            };

                            // Encrypt at rest if this report is password-protected (else unchanged).
                            try {
                                payload.snap_data = await encodeSnapDataForStorage(payload.snap_data);
                            } catch (e) {
                                show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> " + escapeHtml(e.message || 'Could not secure baseline snapshot.') + "</p>");
                                hideLoading();
                                return;
                            }

                            $.ajax({
                                url: 'manage_snapshots.php',
                                method: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify(payload),
                                dataType: 'json',
                                success: function (resp) {
                                    hideLoading();
                                    if (resp.status === 'success') {
                                        show_text("<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Baseline snapshot saved. The scheduler will compare future runs against this data.</p>");
                                    } else {
                                        show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> " + escapeHtml(resp.message || 'Failed to save baseline snapshot.') + "</p>");
                                    }
                                },
                                error: function (xhr) {
                                    hideLoading();
                                    var msg = 'Server error';
                                    try { msg = JSON.parse(xhr.responseText).message || msg; } catch (e) {}
                                    show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> " + escapeHtml(msg) + "</p>");
                                }
                            });
                        } catch (e) {
                            hideLoading();
                            console.error("Baseline snapshot failed:", e);
                            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to create baseline snapshot. " + e.message + "</p>");
                        }
                    }, 50);
                }
            });
        }
    }

