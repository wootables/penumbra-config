    // Shared tail for theme switches: re-apply format/rewrite rules and zebra
    // striping, recalculate layout, refresh hints, dismiss the loading screen.
    function _spThemeSwitchTail(needsLoading) {
        // PERF: a theme switch only changes COLORS, and every themed color is a CSS
        // custom property (--brand-*, --zebra-*, --table-*, --text-* ...) that updates
        // automatically when the theme class on <body> changes. The three per-row
        // passes that used to run here -
        //     applyConditionalFormatting(true); applyRewriteRules(true); applyZebraStriping();
        // - produce THEME-INDEPENDENT output that is already in the DOM: zebra striping
        // is just .zebra-light/.zebra-dark classes (colored via CSS vars), conditional
        // formatting writes fixed user-defined inline styles (which persist across a
        // class swap, and re-resolve on their own if they reference a var()), and rewrite
        // rules change cell CONTENT. Re-running them re-touched every row and forced a
        // SECOND whole-tree style recalc - multi-second on large reports (?id=iacucred
        // locked up ~14s) - for zero visual change. The density switcher already omits
        // them for the same reason, so dropping them here is consistent.

        // Pause the accessibility MutationObserver sweeps while the swap churns the DOM
        // (editor.refresh + the snippet re-render below) so they don't stack whole-doc
        // querySelectorAll passes on top of the recalc; the nudge on resume re-arms them
        // for exactly one catch-up sweep over anything the swap added.
        window.__pnbA11ySuspended = true;

        // Layout/scroll metrics still need a refresh: some themes change --report-font
        // (e.g. Amber Terminal is monospace), which alters text geometry.
        if (window.stackHeaders) window.stackHeaders();
        updateContainerHeight();
        if (typeof updateStickyHeaderOffset === 'function') updateStickyHeaderOffset();
        if (typeof updateStickyColumnLayout === 'function') updateStickyColumnLayout();
        // The grouped view keeps its own sticky metrics and they are MEASURED,
        // so a theme that changes --report-font leaves them stale in exactly the
        // way a density change does - applyDensity() syncs them for that reason.
        if (typeof _groupSyncStickyOffsets === 'function') _groupSyncStickyOffsets();
        if (typeof _groupSyncLeafHeader === 'function') _groupSyncLeafHeader();
        if (typeof renderReportSnippet === 'function') renderReportSnippet(null, false);

        // Re-merge the sentinel rows. Which concrete row is hidden depends on
        // what is selected - an explicit pin that matches a default keeps its own
        // row - so the list has to be re-evaluated after the selection moves, not
        // only on open and on global-default changes.
        _syncMyDefaultOptions();
        _updateReportDefaultHints();

        setTimeout(function () {
