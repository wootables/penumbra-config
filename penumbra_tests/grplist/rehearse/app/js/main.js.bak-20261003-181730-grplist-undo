        new MutationObserver(sync).observe(sel, { subtree: true, childList: true, attributes: true, attributeFilter: ['class'] });
    })();

    // ========== HELPER: Case-insensitive select value setter ==========
    function setSelectCaseInsensitive($el, val) {
        if (!val) { $el.val(''); return; }
        var lower = String(val).toLowerCase();
        var match = null;
        $el.find('option').each(function () {
            if ($(this).val().toLowerCase() === lower) { match = $(this).val(); return false; }
        });
        $el.val(match || val);
    }

    // ════════════════════════════════════════════════════════════════════
    //  CHART MODULE BRIDGE  ->  js/penumbra_charts.js
    //
    //  Every per-type chart builder (funnel, gauge, bullet, box, gantt, map,
    //  pareto) and its pure helpers now live in a separate file that is
    //  fetched ONLY when a chart is actually drawn - the same lazy path
    //  Chart.js itself already takes. Chart types are the fastest-growing
    //  part of this file, so they are the part that should stop growing it.
    //
    //  main.js keeps thin shims below so the ~30 existing call sites in
    //  createVisualization / renderSnippetChart / generateChartDataFromMaps /
    //  restoreVizConfig stay EXACTLY as they were. Nothing past this banner
    //  knows the code moved, which is what keeps the two renderers from
    //  drifting apart again.
    //
    //  penumbraLoadChartModule() is awaited beside every
    //  loadScript("js/chart-4.5.1.min.js") call, so by the time any shim
    //  fires the module is armed. The guard is for the impossible case, and
    //  it names the call instead of throwing "undefined is not a function".
    // ════════════════════════════════════════════════════════════════════

    var _penumbraChartModPromise = null;

    // Filled in by penumbraLoadChartModule(). Declared here (rather than
    // reached through PenumbraCharts.* at the two use sites) so the tile-grid
    // call sites in generateChartDataFromMaps read exactly as they did when
    // the table was local.
    var PENUMBRA_US_GRID = null;

    /**
     * Fetch and arm js/penumbra_charts.js exactly once.
     * Returns the same promise on every call, so it is safe to await from all
     * five Chart.js load sites without racing.
