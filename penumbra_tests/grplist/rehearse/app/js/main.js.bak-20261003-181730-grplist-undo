            // warning reflects THIS machine rather than the box the 18 us/cell
            // default was benchmarked on. Only large renders are sampled: small
            // ones are dominated by fixed overhead and would bias the rate low.
            // Must stay INSIDE this branch - lastLoadTime is stale otherwise.
            if (_pnbPendingRenderCells) {
                _pnbRecordRenderRate(_pnbPendingRenderCells, lastLoadTime);
            }
            try { document.dispatchEvent(new CustomEvent('penumbra:loadtiming')); } catch (e) {}
        }
        _pnbPendingRenderCells = 0;
        penumbraClearBigRenderNotice();
        $('#reportHeaderContainer').show();
        // Reset the UI state for the next run (direct-child `> p` only, so the
        // #execution-timer <p> is left untouched).
        $("#loadingOverlay > p").text("Executing Query, Please Wait...");

