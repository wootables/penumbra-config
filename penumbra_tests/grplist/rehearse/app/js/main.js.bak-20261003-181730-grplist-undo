                        }
                        const chipsHtml = ctxChips.map(c =>
                            `<span class="audit-ctx-chip${c.q ? ' audit-chip-click' : ''}"${c.q ? ` role="button" tabindex="0" data-audit-filter-q="${escapeHtml(c.q)}"` : ''} title="${escapeHtml(c.title)}">${escapeHtml(c.t)}</span>`).join('');

                        // Format timestamp for display
                        const m = moment(log.AUDIT_TIME, 'DD-MMM-YYYY hh:mm:ss A');
                        const timeSortVal = m.isValid() ? m.valueOf() : 0;
                        const timeDisplay = m.isValid()
                            ? `<span title="${escapeHtml(log.AUDIT_TIME)}">${m.format('MMM D') + ' &middot; ' + m.format('h:mm A')}</span>`
                            : escapeHtml(log.AUDIT_TIME);

