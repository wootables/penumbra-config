    // ════════════════════════════════════════════════════════════════════
    //  HOW MANY CATEGORIES FIT (2026-08-28)
    //  Auto-build used to hand every chart the 9999 "unlimited" sentinel,
    //  which is the worst possible guess: 200 categories in a 1000px bar
    //  chart is a picket fence, and 40 slices in a pie is a colour wheel.
    //
    //  The right number depends on three things, which is what this reads:
    //    - the TYPE (a pie tops out around 8; a line can carry 100+),
    //    - the SPACE that type's categories actually run along (bar spends
    //      width, butterfly/gantt/funnel spend HEIGHT - one row each),
    //    - the LABEL TEXT (30-character category names need far more room
    //      per bar than 4-character ones).
    //
    //  `limit` is not one concept: it is "Bins" for a histogram and
    //  "Max Points" for scatter, and gauge (one aggregate) and map (fixed
    //  geography) never apply it at all. The table encodes that.
    // ════════════════════════════════════════════════════════════════════
    var VIZ_LIMIT_UNLIMITED = 9999;
    var VIZ_LIMIT_RULE = {
        //  axis 'x'    = categories run along the WIDTH
        //  axis 'y'    = one row each, so HEIGHT is the constraint
        //  axis 'none' = not pixel-bound, bounded by legibility alone
        //  px          = room one category needs on that axis before label scaling
        bar:       { axis: 'x', px: 34, min: 4, max: 40 },
        combo:     { axis: 'x', px: 34, min: 4, max: 40 },
        line:      { axis: 'x', px: 14, min: 5, max: 120 },
        waterfall: { axis: 'x', px: 42, min: 3, max: 20 },
        box:       { axis: 'x', px: 55, min: 2, max: 20 },
        // "Bins", not categories. Narrow bins on a narrow chart are a blur.
        histogram: { axis: 'x', px: 46, min: 8, max: 30 },
        // "Max Points" - overplotting is the limit, not pixels per category.
        scatter:   { axis: 'none', min: 50, max: 1000 },
        // Area-based / angular: legibility, not width.
        treemap:   { axis: 'none', min: 4, max: 24 },
        pie:       { axis: 'none', min: 3, max: 8 },
        doughnut:  { axis: 'none', min: 3, max: 8 },
        radar:     { axis: 'none', min: 3, max: 12 },
        // One row per category, so these are bounded by height.
        butterfly: { axis: 'y', px: 26, min: 2, max: 25 },
        gantt:     { axis: 'y', px: 26, min: 1, max: 30 },
        funnel:    { axis: 'y', px: 38, min: 2, max: 10 },
        bullet:    { axis: 'y', px: 38, min: 1, max: 8 },
