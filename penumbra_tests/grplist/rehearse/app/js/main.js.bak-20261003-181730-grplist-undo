        e.stopPropagation();
        var $m = $(this).closest('.pivot-chip-menu'), chip = $m[0].__pnbChip, act = $(this).attr('data-act');
        $m.remove();
        if (!chip || !document.contains(chip)) return;
        var $chip = $(chip);
        if (act === 'up') { var $p = $chip.prev('.pivot-column-item'); if ($p.length) { $p.before($chip); updatePivotLayoutOptions(); } }
        else if (act === 'down') { var $n = $chip.next('.pivot-column-item'); if ($n.length) { $n.after($chip); updatePivotLayoutOptions(); } }
        else _pivotMoveChipTo($chip, act);
