    // --- Feature: Double-click source field to quick-add ---
    $('#pivot-source-columns').on('dblclick', '.pivot-column-item', function () {
        var $item = $(this);
        // Determine target: first empty zone, or first zone with room
        var $rows = $('#pivot-rows');
        var $cols = $('#pivot-cols');

        if ($rows.children('.pivot-column-item').length < 10) {
            $item.detach().appendTo($rows);
            updatePivotLayoutOptions();
        } else if ($cols.children('.pivot-column-item').length < 10) {
            $item.detach().appendTo($cols);
            updatePivotLayoutOptions();
        } else {
            // All row/col zones full - add as a value aggregation
            var colName = ($item.attr('data-field') || $item.text()).trim().toUpperCase();
            var aggPriority = ['sum','count','avg','median','min','max','mode','distinct'];
            for (var ai = 0; ai < aggPriority.length; ai++) {
                var exists = false;
                $('#pivot-agg-table-body tr').each(function () {
                    if ($(this).attr('data-agg-type') === aggPriority[ai] &&
                        ($(this).attr('data-agg-col') || '').toUpperCase() === colName) {
                        exists = true; return false;
                    }
                });
                if (!exists) { addAggregationRow(aggPriority[ai], colName, null); break; }
            }
        }
    });

