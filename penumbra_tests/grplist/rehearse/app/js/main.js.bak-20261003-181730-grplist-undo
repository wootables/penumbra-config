    /**
     * Repurposes the PDF export logic to return the file content as a base64 string.
     * Improvements:
     * - Scans for JSON columns and forces them to be wider (preventing header wrap).
     * - Height estimation buffer increased to prevent vertical cutoffs/bleeding.
     * - Nested headers left-aligned and forced to single line.
     * @returns {Promise<string|null>} A promise that resolves with the base64 content of the PDF.
     */
    function generatePdfContent() {
        return new Promise((resolve) => {
            const { jsPDF } = window.jspdf;

            // Initialize document
            const doc = new jsPDF({
                orientation: 'landscape',
                unit: 'px',
                format: 'letter'// ~792px wide by ~612px high
            });

            // --- PAGE 1: COVER PAGE ---
            const pageWidth = doc.internal.pageSize.getWidth();
            const pageCenterX = pageWidth / 2;
            let currentY = 100;

            // 1. Main Title
            const mainTitle = getReportTitle();
            doc.setFontSize(24);
            doc.setFont(undefined, 'bold');
            doc.text(mainTitle, pageCenterX, currentY, {
                align: 'center',
                maxWidth: pageWidth - 60
            });

            const titleLines = doc.splitTextToSize(mainTitle, pageWidth - 60).length;
            currentY += (titleLines * 30);

            // 1a. Subtitle / by-line - smaller type directly under the title.
            // Read from the RENDERED header element rather than the raw field so
            // snippet functions arrive already resolved, minus the browser-only
            // bits that can't work on paper (same strip policy as the Summary
            // block below and the manual-email header ~56901). <br> becomes a
            // real line break so a multi-line by-line stays multi-line; the
            // element is only ever visible when it has content, so :visible is
            // the same gate the email header uses.
            let subtitleText = '';
            const $subtitleEl = $('#mainReportSubtitle');
            if ($subtitleEl.length && $subtitleEl.is(':visible')) {
                // This block used to carry its own copy of the flatten rule, and
                // it only handled <br> - so a by-line built from block elements
                // ran together here while the server-side PDF broke it correctly.
                // One flattener now serves the by-line, the Summary and the XLSX
                // Summary, so they cannot drift apart again.
                subtitleText = penumbraExportPlainText($subtitleEl);
            }
            if (subtitleText) {
                doc.setFontSize(13);
                doc.setFont(undefined, 'normal');
                doc.setTextColor(90);
                let subtitleLines = doc.splitTextToSize(subtitleText, pageWidth - 100);
                // Bound the by-line: this block is INSERTED above the parameter
                // and Summary blocks, and jsPDF clips whatever runs past the
                // page instead of flowing to the next one - so an essay in the
                // subtitle field would silently push those off the cover.
                // (The TCPDF cover has no cap; its MultiCell paginates.)
                const SUBTITLE_MAX_LINES = 4;
                if (subtitleLines.length > SUBTITLE_MAX_LINES) {
                    subtitleLines = subtitleLines.slice(0, SUBTITLE_MAX_LINES);
                    subtitleLines[SUBTITLE_MAX_LINES - 1] += '...';
                }
                doc.text(subtitleLines, pageCenterX, currentY, {
                    align: 'center'
                });
                currentY += (subtitleLines.length * 16) + 4;
                doc.setTextColor(0);
            }

            // 2. Data Retrieved Timestamp
            const $timeEl = $("#dataLoadedTimestamp");
            let timestampText = $timeEl.text().trim();
            if (timestampText) {
                const firstCharIndex = timestampText.search(/[a-zA-Z0-9]/);
                if (firstCharIndex > -1) {
                    timestampText = timestampText.substring(firstCharIndex);
                }
                doc.setFontSize(12);
                doc.setFont(undefined, 'normal');
                doc.setTextColor(100);
                doc.text(timestampText, pageCenterX, currentY, {
                    align: 'center'
                });
                currentY += 18;
            } else {
                currentY += 20;
            }

            // 2a. Row count. The XLSX header block has carried this for a while;
            // the PDF cover - the copy people print and hand over - did not, so a
            // reader had no idea whether they were holding the whole report or a
            // filtered slice. getExpandedResultCount() splices the pivot
            // source-transaction tooltip inline (a static page can't hover).
            // Rendered even when the timestamp is missing, so it can't disappear
            // the way the XLSX one does.
            const rowCountText = (typeof getExpandedResultCount === 'function') ? getExpandedResultCount() : '';
            if (rowCountText) {
                doc.setFontSize(11);
                doc.setFont(undefined, 'normal');
                doc.setTextColor(120);
                doc.text(rowCountText, pageCenterX, currentY, { align: 'center' });
                currentY += 16;
            }

            // 2b. Import Timestamps
            var importTsLines = [];
            $('#importTimestamps .import-ts-line').each(function () {
                var rawText = $(this).text().trim();
                var firstChar = rawText.search(/[a-zA-Z0-9]/);
                if (firstChar > -1) rawText = rawText.substring(firstChar);
                if (rawText) importTsLines.push(rawText);
            });
            if (importTsLines.length > 0) {
                doc.setFontSize(10);
                doc.setFont(undefined, 'normal');
                doc.setTextColor(120);
                importTsLines.forEach(function (line) {
                    doc.text(line, pageCenterX, currentY, { align: 'center' });
                    currentY += 14;
                });
                currentY += 10;
            } else {
                currentY += 22;
            }

            doc.setTextColor(0);

            // 3. Prompts
            const prompts = [];
            $('#promptInfoList li a').each(function () {
                const $link = $(this);
                const label = $link.find('em').text().trim();
                const value = promptChipExportValue($link);
                if (label && value)
                    prompts.push(`${label} ${value}`);
            });

            if (prompts.length > 0) {
                doc.setFontSize(14);
                doc.setFont(undefined, 'bold');
                doc.text("Report Parameters:", pageCenterX, currentY, {
                    align: 'center'
                });
                currentY += 20;

                doc.setFontSize(11);
                doc.setFont(undefined, 'normal');
                prompts.forEach(p => {
                    const lines = doc.splitTextToSize(p, pageWidth - 100);
                    doc.text(lines, pageCenterX, currentY, {
                        align: 'center'
                    });
                    currentY += (lines.length * 15);
                }
                );
                currentY += 20;
            }

            // 4. Snippet Output. Web-only content and action/chain link text are
            // dropped (they can't function on paper) and noweb() content is kept;
            // <br> and block-element boundaries become real line breaks rather than
            // depending on how the author happened to indent their HTML. See
            // penumbraExportPlainText - the XLSX Summary uses the same flattener.
            const snippetText = penumbraExportPlainText($('#reportSnippetOutput'));
            if (snippetText) {
                doc.setFontSize(14);
                doc.setFont(undefined, 'bold');
                doc.text("Summary:", pageCenterX, currentY, {
                    align: 'center'
                });
                currentY += 20;

                doc.setFontSize(12);
                doc.setFont(undefined, 'normal');
                const splitSnippet = doc.splitTextToSize(snippetText, pageWidth - 100);
                doc.text(splitSnippet, pageCenterX, currentY, {
                    align: 'center'
                });
            }

            // --- DATA PREPARATION HELPERS ---

            const getCleanText = ($cell) => {
                const cellNode = $cell[0];
                // Journal toggle cell: a textless <button aria-checked> - emit 1/0
                // (totals-row placeholder has no button -> journalExportCell null -> "").
                if (cellNode && cellNode.classList && cellNode.classList.contains('journal-toggle-col')) {
                    const _tv = (window.Penumbra && window.Penumbra.journalExportCell) ? window.Penumbra.journalExportCell(cellNode) : null;
                    return _tv !== null ? _tv : '';
                }
                // Modified comparison cell (dual pre-rendered views): read the
                // CURRENT value only - a raw .text() glued both views into
                // "NEW [was:] OLD [now:] NEW" in PDF exports (parity with the
                // CSV/XLSX/email strips).
                if (cellNode && cellNode.querySelector && cellNode.querySelector('.snap-ba-now-only')) {
                    const clone = cellNode.cloneNode(true);
                    clone.querySelectorAll('.snap-ba-pair, .raw-json-data').forEach(el => el.remove());
                    let cHtml = clone.innerHTML.replace(/<br\s*\/?>/gi, '\n');
                    return $('<div>').html(cHtml).text().trim();
                }
                if ($cell.find('br').length === 0) {
                    return $cell.text().trim();
                }
                let html = $cell.html();
                html = html.replace(/<br\s*\/?>/gi, '\n');
                return $('<div>').html(html).text().trim();
            }
                ;

            // --- HTML TABLE EXTRACTION ---
            // Converts @@HTML cells containing <table> elements into @@JSON-style
            // arrays so they flow through the existing nested autoTable renderer.
            const extractHtmlTableAsJson = ($cell) => {
                const $table = $cell.find('table').first();
                if ($table.length === 0) return null;

                // Detect header row: look for <th> elements or first <tr> in <thead>
                const headers = [];
                const $headerRow = $table.find('thead tr:first');
                if ($headerRow.length > 0) {
                    $headerRow.find('th, td').each(function () { headers.push($(this).text().trim()); });
                } else {
                    // Fall back to first row if it has <th> elements
                    const $firstRow = $table.find('tr:first');
                    if ($firstRow.find('th').length > 0) {
                        $firstRow.find('th').each(function () { headers.push($(this).text().trim()); });
                    }
                }

                // Collect body rows (skip header row if we found headers)
                const rows = [];
                const skipFirst = headers.length > 0;
                $table.find('tbody tr, tr').each(function (idx) {
                    // If table has <tbody>, jQuery finds both "tbody tr" and bare "tr".
                    // Deduplicate by checking parent.
                    if ($(this).closest('thead').length > 0) return;
                    if (skipFirst && idx === 0 && $(this).closest('tbody').length === 0) return;
                    const row = {};
                    $(this).find('td, th').each(function (colIdx) {
                        const key = colIdx < headers.length ? headers[colIdx] : 'Col ' + (colIdx + 1);
                        row[key] = $(this).text().trim();
                    });
                    if (Object.keys(row).length > 0) rows.push(row);
                });

                // If no headers were found, generate from first data row keys
                if (headers.length === 0 && rows.length > 0) {
                    const firstRow = rows[0];
                    const keys = Object.keys(firstRow);
                    const namedRows = rows.map(r => {
                        const nr = {};
                        keys.forEach((k, i) => { nr['Col ' + (i + 1)] = r[k]; });
                        return nr;
                    });
                    return namedRows.length > 0 ? namedRows : null;
                }

                return rows.length > 0 ? rows : null;
            };

            // --- NESTED TABLE LOGIC ---

            /**
             * Hook: didParseCell
             * Reserves vertical space for the nested table.
             */
            const preParseJsonCell = (data) => {
                if (data.section === 'body' && typeof data.cell.raw === 'string' && data.cell.raw.startsWith('@@JSON')) {
                    data.cell.text = '';

                    try {
                        const jsonStr = data.cell.raw.substring(6);
                        const jsonData = JSON.parse(jsonStr);

                        let rowCount = 0;
                        let maxCharLength = 0;

                        // We assume the column is wider now (e.g. 50 chars approx)
                        const avgCharPerLine = 50;

                        // Strip @@HTML prefix and tags for accurate length measurement
                        const cleanLen = (v) => {
                            let s = String(v == null ? '' : v);
                            if (s.indexOf('@@HTML') === 0) s = s.substring(6).replace(/<[^>]*>/g, '');
                            return s.trim().length;
                        };

                        if (Array.isArray(jsonData)) {
                            rowCount = jsonData.length;
                            jsonData.forEach(row => {
                                if (typeof row === 'object') {
                                    Object.values(row).forEach(val => {
                                        const len = cleanLen(val);
                                        if (len > maxCharLength)
                                            maxCharLength = len;
                                    }
                                    );
                                }
                            }
                            );
                        } else if (typeof jsonData === 'object' && jsonData !== null) {
                            rowCount = Object.keys(jsonData).length;
                            Object.values(jsonData).forEach(val => {
                                const len = cleanLen(val);
                                if (len > maxCharLength)
                                    maxCharLength = len;
                            }
                            );
                        }

                        const wrapFactor = Math.ceil(maxCharLength / avgCharPerLine);
                        // Calculation: Header(12) + (Rows * 10 * Wrap) + Padding(8) + Buffer(4)
                        let estHeight = 12 + (Math.max(1, rowCount) * Math.max(1, wrapFactor) * 10) + 12;

                        data.cell.styles.minCellHeight = estHeight;
                    } catch (e) {/* ignore */
                    }
                }
                if (data.row.section === 'foot') {
                    data.cell.styles.fontStyle = 'bold';
                }
            }
                ;

            /**
             * Hook: didDrawCell
             * Draws the nested table.
             */
            const drawNestedTable = (data) => {
                if (data.section === 'body' && data.cell.raw && typeof data.cell.raw === 'string' && data.cell.raw.startsWith('@@JSON')) {
                    try {
                        const jsonData = JSON.parse(data.cell.raw.substring(6));
                        let head = []
                            , body = [];

                        // Replace spaces with Non-Breaking Space to force single line headers
                        const noWrap = (str) => String(str).replace(/ /g, '\u00a0');

                        // Strip @@HTML prefix and HTML tags from cell values
                        const cleanScalar = (v) => {
                            let s = String(v == null ? '' : v);
                            if (s.indexOf('@@HTML') === 0) {
                                s = s.substring(6).replace(/<[^>]*>/g, '');
                            }
                            return s.trim();
                        };

                        if (Array.isArray(jsonData)) {
                            if (jsonData.length === 0)
                                return;
                            if (typeof jsonData[0] === 'object' && jsonData[0] !== null) {
                                const keys = Object.keys(jsonData[0]);
                                head = [keys.map(noWrap)];
                                body = jsonData.map(o => keys.map(k => {
                                    const val = o[k];
                                    return typeof val === 'object' ? JSON.stringify(val) : cleanScalar(val);
                                }
                                ));
                            } else {
                                head = [['Values']];
                                body = jsonData.map(v => [cleanScalar(v)]);
                            }
                        } else if (typeof jsonData === 'object' && jsonData !== null) {
                            head = [['Key', 'Value']];
                            body = Object.entries(jsonData).map(([k, v]) => {
                                const val = typeof v === 'object' ? JSON.stringify(v) : cleanScalar(v);
                                return [noWrap(k), val];
                            }
                            );
                        } else {
                            return;
                        }

                        data.doc.autoTable({
                            head: head,
                            body: body,
                            startY: data.cell.y + 2,
                            margin: {
                                left: data.cell.x + 2
                            },
                            tableWidth: data.cell.width - 4,
                            theme: 'grid',
                            styles: {
                                fontSize: 6,
                                cellPadding: 1,
                                overflow: 'linebreak',
                                valign: 'middle'
                            },
                            headStyles: {
                                fillColor: [80, 80, 80],
                                textColor: 255,
                                fontSize: 6,
                                fontStyle: 'bold',
                                halign: 'left',
                                // Left align helps fit more text
                                overflow: 'visible'// Allow drawing outside if needed (but clipped by parent usually)
                            },
                            pageBreak: 'avoid',
                            showHead: 'firstPage'
                        });
                    } catch (e) {
                        console.error("Nested table render error", e);
                    }
                }
            }
                ;

            const getAdaptiveTableSettings = (columnCount) => {
                const settings = {
                    theme: 'grid',
                    styles: {
                        fontSize: 8,
                        cellPadding: 3,
                        overflow: 'linebreak'
                    },
                    headStyles: {
                        fillColor: [51, 102, 153],
                        textColor: 255,
                        fontStyle: 'bold',
                        halign: 'center'
                    },
                    footStyles: {
                        fillColor: [224, 234, 241],
                        textColor: 0,
                        fontStyle: 'bold'
                    },
                    didParseCell: preParseJsonCell,
                    didDrawCell: drawNestedTable,
                    showFoot: 'lastPage',
                    rowPageBreak: 'avoid',
                    // Keep rows together
                    margin: {
                        top: 20,
                        right: 14,
                        bottom: 20,
                        left: 14
                    }
                };

                if (columnCount > 50) {
                    settings.styles.fontSize = 3.5;
                    settings.styles.cellPadding = 0.3;
                    settings.margin = {
                        top: 15,
                        right: 3,
                        bottom: 15,
                        left: 3
                    };
                } else if (columnCount > 40) {
                    settings.styles.fontSize = 4.5;
                    settings.styles.cellPadding = 0.5;
                    settings.margin = {
                        top: 20,
                        right: 5,
                        bottom: 20,
                        left: 5
                    };
                } else if (columnCount > 30) {
                    settings.styles.fontSize = 5.5;
                    settings.styles.cellPadding = 1;
                    settings.margin = {
                        top: 20,
                        right: 8,
                        bottom: 20,
                        left: 8
                    };
                } else if (columnCount > 20) {
                    settings.styles.fontSize = 6.5;
                    settings.styles.cellPadding = 2;
                }
                return settings;
            }
                ;

            /**
             * Computes content-aware proportional column widths.
             * Uses the same sqrt-dampening algorithm as the grouped view so
             * short columns (IDs, codes) stay narrow and long columns (names,
             * descriptions) get more space.  JSON/nested-table columns use a
             * moderate fixed weight so they don't hog width.
             *
             * @param {Array[]} dataArray  - [headers, ...rows] with raw cell strings
             * @param {Object}  margins    - { left, right } from autoTable settings
             * @returns {Object} columnStyles keyed by column index
             */
            const calculateSmartColumnStyles = (dataArray, margins, tableStyles) => {
                const styles = {};
                if (!dataArray || dataArray.length === 0)
                    return styles;

                const numCols = dataArray[0].length;
                const colMaxLens = [];
                const hasJson = {};
                // The longest actual STRING per column, plus whether the column is
                // "atomic" - every value one unbroken token. Prose wraps gracefully;
                // an identifier does not, so these two need different treatment
                // below. See the atomic-floor block.
                const colLongest = [];
                const colAtomic = [];

                // Scan headers
                dataArray[0].forEach((h, i) => {
                    colMaxLens[i] = String(h).length || 1;
                    colLongest[i] = String(h);
                    colAtomic[i] = true;
                });

                // Scan body (sample first 200 rows for speed)
                const limit = Math.min(dataArray.length, 200);
                for (let r = 1; r < limit; r++) {
                    const row = dataArray[r];
                    row.forEach((cell, i) => {
                        const str = String(cell);
                        if (str.startsWith('@@JSON')) {
                            hasJson[i] = true;
                            return; // don't inflate with raw JSON string
                        }
                        if (str.trim() !== '' && /\s/.test(str.trim())) colAtomic[i] = false;
                        if (str.length > colMaxLens[i]) {
                            colMaxLens[i] = str.length;
                            colLongest[i] = str;
                        }
                    });
                }

                // Compute weights using sqrt dampening
                const colWeights = [];
                for (let i = 0; i < numCols; i++) {
                    if (dataArray[0][i] === '#') {
                        colWeights.push(2); // row-number column: always narrow
                    } else if (hasJson[i]) {
                        colWeights.push(Math.sqrt(100) * 2.5); // 25 - gives nested tables ~2.3x a typical column
                    } else {
                        colWeights.push(Math.max(3, Math.sqrt(Math.min(colMaxLens[i], 60)) * 2.5));
                    }
                }

                // Adaptive max-% cap based on column count
                let maxPct;
                if (numCols <= 3)       maxPct = 50;
                else if (numCols <= 6)  maxPct = 35;
                else if (numCols <= 10) maxPct = 25;
                else                    maxPct = Math.max(15, Math.round(200 / numCols));

                // Normalize to percentages, iteratively cap & redistribute
                let totalW = 0;
                for (let i = 0; i < colWeights.length; i++) totalW += colWeights[i];
                let pcts = colWeights.map(w => (w / totalW) * 100);

                let didCap = true, capIter = 0;
                while (didCap && capIter < 10) {
                    didCap = false;
                    let excess = 0, uncappedSum = 0;
                    for (let i = 0; i < pcts.length; i++) {
                        if (pcts[i] > maxPct) {
                            excess += pcts[i] - maxPct;
                            pcts[i] = maxPct;
                            didCap = true;
                        } else {
                            uncappedSum += pcts[i];
                        }
                    }
                    if (didCap && uncappedSum > 0) {
                        for (let i = 0; i < pcts.length; i++) {
                            if (pcts[i] < maxPct) {
                                pcts[i] += (pcts[i] / uncappedSum) * excess;
                            }
                        }
                    }
                    capIter++;
                }

                // Convert percentages to pixel widths
                const ml = (margins && margins.left) || 14;
                const mr = (margins && margins.right) || 14;
                const usableWidth = doc.internal.pageSize.getWidth() - ml - mr;
                const widths = pcts.map(p => (p / 100) * usableWidth);

                // --- Atomic-column floor --- (2026-08-12)
                // The sqrt dampening above is right for PROSE (a title given half
                // the room it wants simply wraps onto a second line and still
                // reads), but wrong for a column of unbreakable tokens. PROJECT_ID
                // is always exactly "PAM-P18-000406": dampened to ~9 weight against
                // a title's ~18, it came out one glyph too narrow and autoTable
                // broke every single ID mid-token, leaving the final digit alone on
                // a second line - "PAM-P18-00040" / "6". Same for the totals row:
                // "$25,000.00" / "0". Nothing was lost, but the IDs read as
                // valid-but-different at a glance, which is worse than ugly.
                //
                // So: measure what one line actually needs (jsPDF's own metrics at
                // the table's font size, not a character-count guess) and refuse to
                // go below it for columns that cannot wrap. The room comes out of
                // the columns that CAN.
                const _fs = (tableStyles && tableStyles.fontSize) || 8;
                const _pad = (tableStyles && tableStyles.cellPadding) || 3;
                const _prevFs = doc.getFontSize();
                doc.setFontSize(_fs);
                const minW = [];
                let minTotal = 0;
                for (let i = 0; i < numCols; i++) {
                    minW[i] = 0;
                    if (hasJson[i] || !colAtomic[i] || !colLongest[i]) continue;
                    // Header text is bold, so measure the wider of header and value.
                    const need = Math.max(
                        doc.getTextWidth(String(colLongest[i])),
                        doc.getTextWidth(String(dataArray[0][i] || ''))
                    ) + (_pad * 2) + 1;   // +1pt slack for autoTable's own rounding
                    minW[i] = need;
                    minTotal += need;
                }
                doc.setFontSize(_prevFs);

                // Never let the atomic columns eat the page: if they collectively
                // want more than 70% of it, scale their demand back and accept some
                // wrapping rather than crushing every prose column to nothing.
                const atomicCap = usableWidth * 0.7;
                if (minTotal > atomicCap && minTotal > 0) {
                    const shrink = atomicCap / minTotal;
                    for (let i = 0; i < numCols; i++) minW[i] *= shrink;
                }

                let deficit = 0;
                for (let i = 0; i < numCols; i++) {
                    if (minW[i] > widths[i]) { deficit += minW[i] - widths[i]; widths[i] = minW[i]; }
                }
                if (deficit > 0) {
                    let donorTotal = 0;
                    for (let i = 0; i < numCols; i++) if (!minW[i]) donorTotal += widths[i];
                    if (donorTotal > deficit) {
                        const scale = (donorTotal - deficit) / donorTotal;
                        for (let i = 0; i < numCols; i++) if (!minW[i]) widths[i] *= scale;
                    }
                }

                for (let i = 0; i < numCols; i++) {
                    styles[i] = { cellWidth: widths[i] };
                }
                return styles;
            }
                ;

            // --- PAGE 2+: TABLE GENERATION ---
            doc.addPage();

            const isPivotMode = $('#pivot-output-container').is(':visible');
            const isGroupMode = $('#groupedResultsContainer').is(':visible');

            // 1. PIVOT TABLE
            if (isPivotMode) {
                // Use flattened headers (e.g. "Design-Sum") for clean single-row PDF headers
                const tableArray = getPivotDataAsArrayFlat();
                if (tableArray.length === 0) {
                    resolve(null);
                    return;
                }

                // Flat array always has exactly 1 header row
                const headerRowCount = 1;
                const footerRowCount = $('#pivotResultTable tfoot tr').length;
                const head = tableArray.slice(0, headerRowCount);
                const body = tableArray.slice(headerRowCount, tableArray.length - footerRowCount);
                const foot = tableArray.slice(tableArray.length - footerRowCount);

                // Determine number of row field columns for styling
                const numRowFields = (typeof currentPivotSettings !== 'undefined' && currentPivotSettings && currentPivotSettings.rows)
                    ? currentPivotSettings.rows.length : 0;

                const settings = getAdaptiveTableSettings(tableArray[0].length);
                settings.columnStyles = calculateSmartColumnStyles(tableArray, settings.margin, settings.styles);

                // Style row field columns slightly differently (left-aligned, slightly bolder)
                for (let rf = 0; rf < numRowFields; rf++) {
                    if (!settings.columnStyles[rf]) settings.columnStyles[rf] = {};
                    settings.columnStyles[rf].halign = 'left';
                    settings.columnStyles[rf].fontStyle = 'bold';
                }

                // Use didParseCell to style Grand Total / aggregation rows differently
                const originalDidParseCell = settings.didParseCell;
                settings.didParseCell = function (data) {
                    // Call original hook (handles JSON cells)
                    if (originalDidParseCell) originalDidParseCell(data);

                    // Bold the row field cells in body rows
                    if (data.section === 'body' && data.column.index < numRowFields) {
                        data.cell.styles.fontStyle = 'bold';
                        data.cell.styles.fillColor = [240, 245, 250];
                    }

                    // Style Grand Total rows (detected by first cell text)
                    if (data.section === 'body') {
                        var firstCellText = String(data.row.raw[0] || '').trim();
                        if (firstCellText === 'Grand Total' || firstCellText.indexOf('Grand Total') === 0) {
                            data.cell.styles.fontStyle = 'bold';
                            data.cell.styles.fillColor = [224, 234, 241];
                        }
                    }
                };

                doc.autoTable({
                    head,
                    body,
                    foot,
                    ...settings
                });
            }// 2. GROUPED MODE
            else if (isGroupMode) {
                const $groups = $('#groupedResultsContainer .group-wrapper').not('.search-hidden');

                $groups.each(function (index) {
                    if (index > 0)
                        doc.addPage();
                    const $groupWrapper = $(this);

                    doc.setFontSize(12);
                    doc.setFont(undefined, 'bold');
                    doc.setTextColor(51, 102, 153);
                    // Group name + count (left side).
                    // The header's count lives in its own <span class="group-count">
                    // sibling with no text node between it and the name, so a flat
                    // .text() glued them together ("Design10"). Pull the two pieces
                    // apart and re-join them as "Design (10 items)". The count text
                    // is "10" normally and "3 of 25" while a search filter is active,
                    // both of which read correctly inside the parens.
                    const $gh = $groupWrapper.find('.group-header');
                    const $aggSummary = $gh.find('.group-agg-summary');
                    const $ghClone = $gh.clone();
                    $ghClone.find('.group-agg-summary').remove();
                    const gCountText = $ghClone.find('.group-count').text().trim();
                    // Remove the count BEFORE reading the name so the fallback
                    // .text() path (snapshot-comparison headers have no
                    // .group-name wrapper) doesn't pick the number back up.
                    $ghClone.find('.group-count').remove();
                    const gName = $ghClone.text().trim();
                    let leftText = gName;
                    if (gCountText) {
                        const gItemWord = (gCountText === '1') ? 'item' : 'items';
                        leftText = (gName ? gName + ' ' : '') + '(' + gCountText + ' ' + gItemWord + ')';
                    }
                    doc.text(leftText, 14, 30);
                    // Aggregation summary (right side) if present
                    if ($aggSummary.length) {
                        const aggLabel = $aggSummary.find('.group-agg-label').text();
                        const aggValue = $aggSummary.find('.group-agg-value').text();
                        const pageW = doc.internal.pageSize.getWidth();
                        if (aggLabel && aggValue) {
                            // Render value (bold) first to measure, then label (italic) before it
                            doc.setFont(undefined, 'bold');
                            const valWidth = doc.getTextWidth(aggValue);
                            doc.setFont(undefined, 'bolditalic');
                            const lblWidth = doc.getTextWidth(aggLabel);
                            const rightMargin = 14;
                            doc.setFont(undefined, 'italic');
                            doc.text(aggLabel, pageW - rightMargin - valWidth - lblWidth, 30);
                            doc.setFont(undefined, 'bold');
                            doc.text(aggValue, pageW - rightMargin - valWidth, 30);
                        }
                    }

                    // Temporarily show collapsed group content so we can read all data.
                    // The group's OWN content, and "collapsed" = its own display, never
                    // :visible (2026-10-03). :visible is also false for an OPEN group
                    // inside a collapsed or hidden ancestor, and .find() reached every
                    // nested group's content as well - so a PDF closed the open groups
                    // inside a collapsed branch. The headings below no longer depend on
                    // what is shown, so a branch need not open its children to be read.
                    const $groupContent = $groupWrapper.children('.group-content');
                    const wasHidden = $groupContent.css('display') === 'none';
                    if (wasHidden) $groupContent.show();

                    const head = []
                        , body = []
                        , visibleHeaders = [];
                    // Scope-strict descendants only - direct child traversal prevents
                    // a wrapper's iteration from picking up sibling/nested wrapper rows.
                    var $thisTable = $groupWrapper.children('.group-content').children('table');
                    // A hidden COLUMN is an inline style on its th: test that, as the XLSX
                    // exporter and _penumbraGroupedVisibleColCount() do. :visible also
                    // reads where the GROUP is on screen, and gave a hidden group no
                    // columns at all (2026-10-03).
                    $thisTable.children('thead').children('tr').children('th').filter(function () { return this.style.display !== 'none'; }).each(function () {
                        if ($(this).hasClass('journal-notes-col')) return; // notes column excluded from exports
                        var _dcg = $(this).data('colname') || '#';
                        var _frg = (window.Penumbra && window.Penumbra.journalFriendlyCol) ? window.Penumbra.journalFriendlyCol(_dcg) : null;
                        visibleHeaders.push({
                            id: $(this).data("column"),
                            name: _frg || _dcg // journal toggle sentinel -> friendly "Done"
                        });
                    });
                    head.push(visibleHeaders.map(h => h.name));

                    // Hard semantic filter (PDF) - see XLSX path for rationale.
                    const _pdfIsCompare = $('#snapshotComparisonContainer').is(':visible');
                    const _pdfGroupKey = $groupWrapper.attr('data-group-key') || '';
                    $thisTable.children('tbody').children('tr').not('.search-hidden').not('.journal-note-child').filter(function () {
                        if (!_pdfIsCompare || !_pdfGroupKey) return true;
                        const rowType = $(this).children('td[data-column="__SNAP_TYPE"]').text();
                        return rowType === _pdfGroupKey;
                    }).each(function () {
                        const $row = $(this);
                        const row = [];
                        visibleHeaders.forEach(header => {
                            const $cell = $row.children(`td[data-column='${header.id}']`);
                            // Modified comparison cells carry dual views with up to
                            // THREE .raw-json-data copies - a plain .find().text()
                            // glued them into invalid @@JSON{new}{old}{new}. Use the
                            // now-view's copy; a dual cell whose now-side is PLAIN
                            // must NOT fall back to the [was:] copy (getCleanText
                            // strips the pair and returns the current value).
                            const _pdfDual = $cell.find('.snap-ba-now-only, .snap-ba-pair').length > 0;
                            const $rawJson = _pdfDual
                                ? $cell.find('.snap-ba-now-only .raw-json-data').first()
                                : $cell.find('.raw-json-data').first();
                            if ($rawJson.length > 0) {
                                row.push('@@JSON' + $rawJson.text());
                            } else if (!_pdfDual && $cell.find('table').length > 0) {
                                const tableData = extractHtmlTableAsJson($cell);
                                row.push(tableData ? '@@JSON' + JSON.stringify(tableData) : getCleanText($cell));
                            } else {
                                row.push(getCleanText($cell));
                            }
                        }
                        );
                        body.push(row);
                    });

                    let foot = undefined;
                    var $thisTfootRows = $thisTable.children('tfoot').children('tr');
                    if ($thisTfootRows.length > 0) {
                        foot = [];
                        const footerRow = [];
                        visibleHeaders.forEach(h => footerRow.push(penumbraSummaryCellText($thisTfootRows.children(`td[data-column='${h.id}']`))));
                        foot.push(footerRow);
                    }

                    const settings = getAdaptiveTableSettings(visibleHeaders.length);
                    // Pass full data for analysis - INCLUDING the footer row. The
                    // totals cell is the widest string in a money column
                    // ("$25,000.00" against a body max of "$20,000"), so leaving it
                    // out of the measurement is exactly how it ended up wrapping.
                    settings.columnStyles = calculateSmartColumnStyles(
                        [head[0], ...body, ...(foot || [])], settings.margin, settings.styles);
                    settings.startY = 40;

                    doc.autoTable({
                        head,
                        body,
                        foot,
                        ...settings
                    });

                    // Restore collapsed state
                    if (wasHidden) $groupContent.hide();
                });
            }// 3. STANDARD TABLE MODE
            else {
                // Lazy rows (2026-09-30): this reads every row the search keeps.
                _pnbFillSearchVisibleRows();
                const head = []
                    , body = []
                    , visibleHeaders = [];
                $("#tableHeader th:visible").each(function () {
                    if ($(this).hasClass('journal-notes-col')) return; // notes column excluded from exports
                    var _dc = $(this).data('colname') || '#';
                    var _fr = (window.Penumbra && window.Penumbra.journalFriendlyCol) ? window.Penumbra.journalFriendlyCol(_dc) : null;
                    visibleHeaders.push({
                        id: $(this).data("column"),
                        name: _fr || _dc // journal toggle sentinel -> friendly "Done"
                    });
                });
                head.push(visibleHeaders.map(h => h.name));

                $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)").each(function () {
                    const $row = $(this);
                    const row = [];
                    visibleHeaders.forEach(header => {
                        const $cell = $row.find(`td[data-column='${header.id}']`);
                        // .first() for parity with the grouped branch (flat cells
                        // hold a single raw-json copy; dual views never render here).
                        const $rawJson = $cell.find('.raw-json-data').first();
                        if ($rawJson.length > 0) {
                            row.push('@@JSON' + $rawJson.text());
                        } else if ($cell.find('table').length > 0) {
                            const tableData = extractHtmlTableAsJson($cell);
                            row.push(tableData ? '@@JSON' + JSON.stringify(tableData) : getCleanText($cell));
                        } else {
                            row.push(getCleanText($cell));
                        }
                    }
                    );
                    body.push(row);
                });

                let foot = undefined;
                if ($("#resultsTable tfoot").length > 0) {
                    foot = [];
                    const footerRow = [];
                    const $footer = $("#resultsTable tfoot tr");
                    visibleHeaders.forEach(h => footerRow.push(penumbraSummaryCellText($footer.find(`td[data-column='${h.id}']`))));
                    foot.push(footerRow);
                }

                const settings = getAdaptiveTableSettings(visibleHeaders.length);
                // Footer row included: see the note on the grouped branch above.
                settings.columnStyles = calculateSmartColumnStyles(
                    [head[0], ...body, ...(foot || [])], settings.margin, settings.styles);

                doc.autoTable({
                    head,
                    body,
                    foot,
                    ...settings
                });
            }

            // --- Page numbers --- (2026-08-12)
            // Stamped in ONE pass at the very end rather than from autoTable's
            // didDrawPage hook, because the total is only knowable once every
            // table (and, in grouped mode, every group's own page) has been laid
            // out. Sits inside the bottom margin, so it can never collide with a
            // table that ran to the foot of the page. A single-page export gets
            // nothing: "Page 1 of 1" is noise.
            try {
                const _pageCount = doc.internal.getNumberOfPages();
                if (_pageCount > 1) {
                    const _pw = doc.internal.pageSize.getWidth();
                    const _ph = doc.internal.pageSize.getHeight();
                    for (let p = 1; p <= _pageCount; p++) {
                        doc.setPage(p);
                        doc.setFontSize(8);
                        doc.setTextColor(120);
                        doc.text('Page ' + p + ' of ' + _pageCount, _pw / 2, _ph - 8, { align: 'center' });
                    }
                    doc.setTextColor(0);
                }
            } catch (e) { /* numbering is cosmetic - never fail an export over it */ }

            const dataUri = doc.output('datauristring');
            resolve(dataUri.split(',')[1]);
        }
        );
    }

    // Visible column count of the grouped view, INDEPENDENT of expand/collapse.
    // jQuery's :visible is false for anything inside a display:none ancestor, so
    // "…group-wrapper:visible:first thead th:visible" returned 0 whenever the
    // first group happened to be collapsed - silently defeating the PDF width
    // guard (0 > 25 is false, so a 40-column report sailed through and rendered
    // badly). Downloads are not WYSIWYG: a collapsed group still exports in full,
    // so the guard has to measure the same thing the exporter will emit. Column
    // HIDING is an inline style on the th, so test that directly - the same
    // technique the XLSX exporter uses.
    function _penumbraGroupedVisibleColCount() {
        return $('#groupedResultsContainer .group-wrapper.group-leaf').not('.search-hidden')
            .first().find('thead th')
            .filter(function () { return this.style.display !== 'none'; }).length;
    }

    /**
 * Checks the current column count and disables the PDF export/attach options if it's too high.
 */
    function updatePdfOptionState(precomputedFlatVisibleCount) {
        let columnCount = 0;
        let rowCount = 0;
        const isPivotMode = $('#pivot-output-container').is(':visible');
        const isGroupMode = $('#groupedResultsContainer').is(':visible');

        // Parse displayed row count from #resultCount (e.g. "6,802 total rows")
        // This works for all modes and avoids expensive DOM scraping on large pivots.
        const _rcText = $('#resultCount').text();
        const _rcMatch = _rcText.match(/([\d,]+)\s*total\s*rows/i);
        const displayedRowCount = _rcMatch ? parseInt(_rcMatch[1].replace(/,/g, ''), 10) : 0;

        if (isPivotMode) {
            const $pivotTable = $('#pivotResultTable');
            const $firstHeaderRow = $pivotTable.find('thead tr:first');
            columnCount = 0;
            $firstHeaderRow.find('th').each(function() {
                columnCount += parseInt($(this).attr('colspan') || 1);
            });
            // When rank is active, the actual rendered row count is at most rankN + 1 (for Other)
            var _rankCfg = currentPivotSettings ? buildRankConfig(currentPivotSettings) : null;
            if (_rankCfg && _rankCfg.n && !_rankCfg.scope && _rankCfg.n < displayedRowCount) {
                rowCount = _rankCfg.n + (_rankCfg.other !== false ? 1 : 0);
            } else {
                rowCount = displayedRowCount;
            }
        } else if (isGroupMode) {
            columnCount = _penumbraGroupedVisibleColCount();
            // Count what the export will actually emit: every row of every group
            // that hasn't been filtered out via the group header's X, open or
            // collapsed. (The old count kept search-hidden and journal note-child
            // rows, so it over-reported against the cap.)
            rowCount = $("#groupedResultsContainer .group-wrapper.group-leaf").not('.search-hidden')
                .find('tbody tr').not('.search-hidden').not('.journal-note-child').length;
        } else {
            columnCount = $("#tableHeader th:visible").length;
            // Use the search-filtered visible count, not the full dataset: the scheduler
            // applies the same search filter server-side, so a filter that brings the table
            // under the cap should re-enable PDF. masterRowData stays the full set; the table
            // search only adds a 'search-hidden' class to filtered-out rows (cf. updateFilteredResultCount).
            if (($('#tableSearch').val() || '').trim().length > 0) {
                if (typeof precomputedFlatVisibleCount === 'number') {
                    // updateFilteredResultCount just walked the rows - reuse its count
                    rowCount = precomputedFlatVisibleCount;
                } else {
                    const _ftrs = document.querySelectorAll("#resultsTable tbody tr");
                    let _vis = 0;
                    for (let _i = 0; _i < _ftrs.length; _i++) {
                        if (!_ftrs[_i].classList.contains('search-hidden')) _vis++;
                    }
                    rowCount = _vis;
                }
            } else {
                rowCount = masterRowData ? masterRowData.length : 0;
            }
        }

        // Pivot tables can use smaller fonts, so allow more columns (up to 50)
        const maxCols = isPivotMode ? 50 : 25;
        const isTooWide = columnCount > maxCols;

        // Row cap is PER-TARGET because the two PDF paths use different engines:
        //   - Download          -> client-side jsPDF + autoTable (runs in the user's browser;
        //     they wait, and it handles large tables) -> only a high safety ceiling.
        //   - Email / Scheduler  -> server-side TCPDF, which chokes on big tables and is bounded
        //     by the scheduler max_execution_time + email attachment size -> tighter 4,000 cap.
        const TCPDF_MAX_ROWS = 4000;
        const DOWNLOAD_MAX_ROWS = 25000;

        // Target elements in the Download lightbox, Email lightbox, and Scheduler tab
        const targets = [
            { input: 'input[name="downloadFormat"][value="pdf"]', maxRows: DOWNLOAD_MAX_ROWS },
            { input: '#emailAttachPDF', maxRows: TCPDF_MAX_ROWS },
            { input: '#schedAttachPdf', maxRows: TCPDF_MAX_ROWS }
        ];

        targets.forEach(target => {
            const isTooTall = rowCount > target.maxRows;
            const isDisabled = isTooWide || isTooTall;

            let reason = '';
            if (isTooWide && isTooTall) {
                reason = `PDF disabled: too many columns (${columnCount}/${maxCols}) and rows (${rowCount.toLocaleString()}/${target.maxRows.toLocaleString()}).`;
            } else if (isTooWide) {
                reason = `PDF disabled: too many columns for PDF rendering (${columnCount} found, max ${maxCols}).`;
            } else if (isTooTall) {
                reason = `PDF disabled: too many rows for PDF rendering (${rowCount.toLocaleString()} found, max ${target.maxRows.toLocaleString()}). The PDF generator cannot handle tables this large.`;
            }

            const $input = $(target.input);
            const $label = $input.closest('label');
            if (isDisabled) {
                $input.prop('disabled', true).prop('checked', false);
                $label.addClass('option-disabled').attr('title', reason);
            } else {
                $input.prop('disabled', false);
                $label.removeClass('option-disabled').removeAttr('title');
            }
        });

        // Disabling PDF above also UNCHECKS it. If PDF happened to be the picked
        // download format, that leaves the dialog with no format selected at all,
        // and "Download Selected" answers with a bare "Please select a download
        // format." Fall back to the dialog's own default (Excel) so the user
        // always opens onto a valid, pre-selected choice.
        if (!$('input[name="downloadFormat"]:checked').length) {
            $('input[name="downloadFormat"][value="xls"]').prop('checked', true).trigger('change');
        }

        // Email lightbox warning panel mirrors the PDF disabled reason (and
        // checks for strippable snippet content). Refresh it whenever the PDF
        // state changes so the panel stays in sync if the lightbox is open.
        if (typeof updateEmailWarnings === 'function') updateEmailWarnings();
    }

    /**
 * Refreshes the email lightbox notices panel (right side of the email UI).
 * Collates non-blocking notices the user should see before sending:
 *   1. Row-count info / row-limit warning for the inline table embed.
 *   2. Grouped-mode warning when no groups are expanded (the embed would
 *      ship only group headers, no rows).
 *   3. Strip notice when "Include header block" is checked and the snippet
 *      contains interactive elements the email path will remove.
 *   4. Filtered-link info when "Prepend link" is checked AND a search
 *      filter is active (recipients click through to the full dataset, not
 *      the filtered view they see embedded).
 *   5. PDF-attachment disabled reason (mirrors the title set by
 *      updatePdfOptionState - the verbose explanation lives here now rather
 *      than buried in a hover tooltip).
 * Reads DOM state only - safe to call any time, including when the email
 * lightbox is hidden (it just updates an invisible panel).
 */
    function updateEmailWarnings(force) {
        const $warn = $('#emailWarnings');
        if (!$warn.length) return;
        // Skip the refresh when the email lightbox is not on screen (2026-08-01):
        // this runs on EVERY updatePdfOptionState() call - i.e. every search /
        // count update / mode transition - and its row tallies are two full
        // :not() scans, all to update a panel nobody can see. The email-open
        // handler passes force=true (it refreshes just before the fadeIn), so
        // the panel is always fresh the moment it becomes visible.
        if (!force && !$('#emailLightbox').is(':visible')) return;
        const messages = [];
        const fmt = n => Number(n).toLocaleString();

        // Compute current visible vs total row counts. Mirrors the logic in
        // the email-open handler so the displayed number matches what the
        // recipient will actually see in the embedded table.
        const isPivotMode = $('#pivot-output-container').is(':visible');
        const isGroupedMode = $('#groupedResultsContainer').is(':visible');
        let visibleRows = 0;
        let totalRows = 0;
        // Grouped mode only: rows that pass the search filter but sit inside a
        // COLLAPSED group. The email embed is WYSIWYG - generateWysiwygHtml
        // renders a collapsed group as its header/summary card only (it skips
        // the table when .group-content is hidden) - so these rows will NOT
        // appear in the email and must not be counted as "will appear". The
        // old all-rows count said "5 rows will appear" while the
        // no-groups-expanded warning below correctly said none would.
        let collapsedRows = 0;
        // Flat mode: rows the current PAGE leaves out. A separate concept from
        // collapsedRows (grouped) and from the search filter - all three reduce
        // what reaches the email, for different reasons the reader fixes
        // differently.
        let pagedRows = 0;
        if (isPivotMode) {
            visibleRows = penumbraPivotBodyRowCount();
            totalRows = visibleRows; // pivot has no search-hidden notion
        } else if (isGroupedMode) {
            const rowSel = 'tbody tr:not(.search-hidden):not(.journal-note-child)';
            // Count from LEAVES, not from every wrapper (2026-08-30). Rows live
            // only in leaf tables, and a leaf's rows reach the email only when
            // that leaf is open AND no ancestor band is collapsed - an open
            // BRANCH says nothing about whether its children are open.
            //
            // The old count started from `.group-wrapper.open`, which credited
            // an open branch with every row beneath it including those inside
            // its own CLOSED leaves. With one level a wrapper was always a leaf
            // so it was right; nesting broke it, and "Start expanded to
            // Level 1" - outer bands open, leaves shut - is now the common
            // shape, where it reported the whole report as embeddable while the
            // email carried nothing but band headers.
            //
            // offsetParent is the cheap "is an ancestor collapsed" test, and it
            // is asked once per LEAF rather than once per row.
            let searchVisible = 0;
            visibleRows = 0;
            $('#groupedResultsContainer .group-leaf:not(.search-hidden)').each(function () {
                const n = $(this).find(rowSel).length;
                searchVisible += n;
                if (this.classList.contains('open') && this.offsetParent !== null) visibleRows += n;
            });
            collapsedRows = searchVisible - visibleRows;
            totalRows = $('#groupedResultsContainer tbody tr').length;
        } else {
            // PAGINATION counts (2026-08-30). generateWysiwygHtml skips any row
            // whose display is 'none', and applyPagination() sets exactly that
            // inline on every row outside the current page - so a paginated
            // report embeds ONE PAGE, not the whole filtered set. Counting the
            // search-visible rows said "4,559 rows will appear" for an email
            // that carried 200, and it fed a size estimate that was wrong by the
            // same factor.
            //
            // Reading the INLINE style is deliberate: it is what pagination and
            // the search both write, and it costs no style recomputation - which
            // matters because this runs on a table that can hold thousands of
            // rows.
            const $flatRows = $('#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)');
            visibleRows = 0;
            $flatRows.each(function () { if (this.style.display !== 'none') visibleRows++; });
            pagedRows = $flatRows.length - visibleRows;
            totalRows = $('#resultsTable tbody tr').length;
        }
        // pagedRows counts alongside collapsedRows: both are rows the reader
        // still HAS, just not on screen, so neither means the search filtered
        // them out. Without it a paginated report reported itself as filtered
        // and got the "clear your filters" advice for rows no filter touched.
        const isFiltered = (visibleRows + collapsedRows + pagedRows) < totalRows;

        // 1. Embed (Insert report table as-shown) - informational when enabled
        //    and checked, warning when disabled by the row-limit check.
        const $embedLabel = $('#emailInsertData').closest('label');
        const embedDisabled = $embedLabel.hasClass('option-disabled');
        const embedChecked = $('#emailInsertData').is(':checked');
        if (embedDisabled) {
            const reason = ($embedLabel.attr('title') || '').trim();
            if (reason) messages.push({ kind: 'warn', text: reason });
        } else if (embedChecked && visibleRows > 0) {
            // Worked out BEFORE the row message, because when the table will be
            // trimmed to fit, "N rows will appear" is simply false - the size
            // message below carries the real arithmetic instead. The filter and
            // collapse variants still run: they explain a DIFFERENT reduction
            // (what the reader has hidden) and remain true either way.
            const _budget = _emailBodyBudgetBytes([]);
            const _fits = _budget > 0 ? Math.floor(_budget / PENUMBRA_WYSIWYG_BYTES_PER_ROW) : 0;
            const _willTrim = _budget > 0 && _fits < visibleRows;
            let text;
            if (isFiltered && collapsedRows > 0) {
                text = `${fmt(visibleRows)} of ${fmt(totalRows)} rows will appear in the email body - your search/filter hides some rows, and ${fmt(collapsedRows)} more sit inside collapsed groups (a collapsed group sends only its summary header). Clear filters and expand groups before sending if you want more rows embedded.`;
            } else if (isFiltered) {
                text = `${fmt(visibleRows)} of ${fmt(totalRows)} rows will appear in the email body - only the rows your current search/filter is showing are sent. Clear filters before sending if you want the full dataset embedded.`;
            } else if (collapsedRows > 0) {
                text = `${fmt(visibleRows)} of ${fmt(totalRows)} rows will appear in the email body - the other ${fmt(collapsedRows)} sit inside collapsed groups, which send only their summary header. Expand those groups before sending if you want their rows included.`;
            } else if (pagedRows > 0) {
                text = `${fmt(visibleRows)} of ${fmt(totalRows)} rows will appear in the email body - the embed carries the page you are looking at, and ${fmt(pagedRows)} rows are on other pages. Show more rows per page before sending if you want them included, or attach the report.`;
            } else {
                // Suppressed when the size message is about to give a smaller,
                // truer number - two notices disagreeing about the same count
                // is worse than one.
                text = _willTrim ? '' : `${fmt(visibleRows)} rows will appear in the email body.`;
            }
            if (text) messages.push({ kind: 'info', text });

            // Size, as distinct from filters and collapse. The body is budgeted
            // against the MTA ceiling share.php enforces, so a large embed is
            // trimmed to fit and carries a notice rather than being refused -
            // matching what a scheduled send of the same report already does.
            //
            // PENUMBRA_WYSIWYG_BYTES_PER_ROW is MEASURED, not guessed, and is
            // far larger than a plain <tr> looks: generateWysiwygHtml copies
            // COMPUTED STYLES onto every cell, so each row carries a full inline
            // style string per column. A 9-column report measured ~3,285 bytes
            // per row; 3,000 is a deliberate slight under-estimate so the notice
            // errs toward "more will fit" rather than crying wolf. The real cut
            // is decided by the byte tally during the build, never by this.
            if (_willTrim) {
                messages.push({
                    kind: 'info',
                    text: `This table is likely too large to embed whole - roughly ${fmt(_fits)} of the ${fmt(visibleRows)} rows should fit under the message size limit. The email will carry what fits and end with a note naming how many were left out. Attach the report instead if recipients need every row.`
                });
            }
        }

        // 2. Grouped mode where the embed would carry NO rows at all.
        //
        //    Keyed on the row count, not on how many wrappers carry .open. With
        //    nesting an open BRANCH contributes no rows of its own, so "some
        //    wrapper is open" and "rows will be embedded" stopped being the
        //    same question: branches open with their leaves shut left
        //    openGroups > 0 here and visibleRows === 0 above, and since message
        //    1 is deliberately silent at zero, the one case that most needs a
        //    warning - the email will contain no data whatsoever - produced
        //    none. (2026-08-30)
        //
        //    collapsedRows distinguishes the two ways of reaching zero: rows
        //    exist but are all folded away, versus nothing matches the filter.
        if (isGroupedMode && embedChecked && !embedDisabled && visibleRows === 0) {
            messages.push({
                kind: 'warn',
                text: collapsedRows > 0
                    ? `No groups are expanded - the email will show only the group headers, with no rows at all. All ${fmt(collapsedRows)} matching rows sit inside collapsed groups, and a collapsed group sends only its summary header. Expand the groups you want recipients to see, or send anyway if a summary view is what you intended.`
                    : 'The email will contain no rows - nothing matches the current search/filter. Clear it before sending if you want data embedded.'
            });
        }

        // 3. Strippable interactive content in the report header
        if ($('#emailIncludeSnippet').is(':checked')) {
            const hasStrippable = $('#reportSnippetOutput')
                .find('.penumbra-web-only, .snippet-action').length > 0;
            if (hasStrippable) {
                messages.push({
                    kind: 'warn',
                    text: 'Your report header contains interactive elements (clickable links, browser-only notes, or presentation slides). These will be removed from the email since they can\'t function in a static message - recipients will see the rest of the header normally.'
                });
            }
            // The opposite case: noweb() content is hidden on screen, so the sender
            // is about to mail something they have not actually looked at. Say so.
            const hasExportOnly = $('#reportSnippetOutput').find('.penumbra-export-only').length > 0
                || $('#mainReportSubtitle').find('.penumbra-export-only').length > 0;
            if (hasExportOnly) {
                messages.push({
                    kind: 'info',
                    text: 'Your report header contains export-only content (noweb()). It is hidden on screen but WILL appear in this email, so recipients see something you don\'t.'
                });
            }
        }

        // 4. Live link scope. This notice used to say the OPPOSITE - that the
        //    link landed on the full unfiltered dataset - which was true while
        //    the link was the bare page URL. It now carries the active search
        //    filter and the current prompt values, so the statement had to flip
        //    with the behaviour rather than be left to quietly mislead.
        if ($('#emailIncludeLink').is(':checked')) {
            const searchVal = ($('#tableSearch').val() || '').trim();
            let promptCount = 0;
            try { promptCount = Object.keys(getCurrentPromptParams() || {}).length; } catch (e) { }
            const carried = [];
            if (searchVal.length > 0) carried.push('your search filter');
            if (promptCount > 0) carried.push(promptCount === 1 ? 'the prompt value' : 'the prompt values');
            if (carried.length) {
                messages.push({
                    kind: 'info',
                    text: 'The live-report link carries ' + carried.join(' and ')
                        + ', so recipients open the same view you are sending. They see current data, not a frozen copy, and only if they are authorized for this report.'
                });
            }
        }

        // 5. Recipient visibility. Off (the default) means one message per
        //    recipient, so nobody learns who else got it; on means a single
        //    shared send. Worth saying out loud either way - the sender is
        //    deciding something about OTHER people's addresses.
        if ($('#emailShowRecipients').is(':checked')) {
            const recipCount = $('#emailRecipientContainer .email-capsule').length;
            messages.push({
                kind: 'warn',
                text: recipCount > 1
                    ? 'All ' + fmt(recipCount) + ' recipients will see each other\'s email addresses in the To: line. Uncheck "Let recipients see each other\'s addresses" to send everyone their own copy instead.'
                    : 'Recipients will see each other\'s email addresses in the To: line.'
            });
        }

        // 6. PDF disabled - mirror the reason already computed by updatePdfOptionState()
        const $pdfLabel = $('#emailAttachPDF').closest('label');
        if ($pdfLabel.hasClass('option-disabled')) {
            const reason = ($pdfLabel.attr('title') || '').trim();
            if (reason) messages.push({ kind: 'warn', text: reason });
        }

        if (messages.length === 0) {
            $warn.empty().hide();
            return;
        }
        const html = messages.map(m => {
            const color = m.kind === 'info' ? '#31708f' : '#8a6d3b';
            const icon = m.kind === 'info' ? '&#9432;' : '&#9888;';
            return `<div style="margin-bottom: 8px; color: ${color};"><span style="margin-right:6px; font-size: 13px;">${icon}</span>${escapeHtml(m.text)}</div>`;
        }).join('');
        $warn.html(html).show();
    }

    // Keep notices live as the user toggles the relevant options in the lightbox.
    $(document).on('change', '#emailIncludeSnippet, #emailInsertData, #emailIncludeLink, #emailShowRecipients', updateEmailWarnings);

    /**
 * Extracts header data from reportHeaderContainer for Excel export
 * @returns {Object} Object containing header rows and metadata
 */
    // opts.monochrome: chart bitmaps are captured in greyscale, so the
    // "Don't include theme colors" workbook carries no colour anywhere.
    function extractHeaderDataForExcel(opts) {
        opts = opts || {};
        const sections = [];

        // 1. Report Title
        const reportTitle = $('#mainReportTitle').text().trim();
        if (reportTitle) {
            sections.push({
                type: 'title',
                content: reportTitle
            });
        }

        // 1b. Subtitle / by-line - the rendered element minus browser-only
        // content, flattened by the same rule as the PDF cover and the email
        // header (web() dropped, noweb() kept, block boundaries -> newlines).
        const $subtitleEl = $('#mainReportSubtitle');
        if ($subtitleEl.length && $subtitleEl.is(':visible')) {
            const subtitleText = penumbraExportPlainText($subtitleEl);
            if (subtitleText) {
                sections.push({ type: 'subtitle', content: subtitleText });
            }
        }

        // 2. Data Timestamp - minus any leading icon glyph, as the PDF cover
        // strips it (on screen the arrow is an inline SVG that .text() does
        // not see, but snapshot views stash text in front of it).
        let timestamp = $('#dataLoadedTimestamp').text().trim();
        const tsFirst = timestamp.search(/[a-zA-Z0-9]/);
        if (tsFirst > 0) timestamp = timestamp.substring(tsFirst);
        if (timestamp) {
            sections.push({ type: 'timestamp', content: timestamp });
        }

        // 2a. The active search filter: the row count printed next to the
        // timestamp is the FILTERED count, so the filter that produced it
        // belongs beside it (the email header records it the same way).
        const searchVal = String($('#tableSearch').val() || '').trim();
        if (searchVal) {
            sections.push({ type: 'search', content: searchVal });
        }

        // 2b. Import Timestamps
        var importTsTexts = [];
        $('#importTimestamps .import-ts-line').each(function () {
            var rawText = $(this).text().trim();
            var firstChar = rawText.search(/[a-zA-Z0-9]/);
            if (firstChar > -1) rawText = rawText.substring(firstChar);
            if (rawText) importTsTexts.push(rawText);
        });
        if (importTsTexts.length > 0) {
            sections.push({
                type: 'import_timestamps',
                content: importTsTexts
            });
        }

        // 3. Query Prompts (if any)
        const prompts = [];
        $('#promptInfoList li a').each(function () {
            const $link = $(this);
            const label = $link.find('em').text().trim();
            const value = promptChipExportValue($link);

            if (label && value) {
                prompts.push({
                    label,
                    value
                });
            }
        });

        if (prompts.length > 0) {
            sections.push({
                type: 'prompts',
                content: prompts
            });
        }

        // 4. Snippet Text (extract text only for now, charts handled separately; strip web-only content)
        // Normalize: trim each line and drop empties so chip-style snippets
        // (one label + one value per inline-block span) don't carry padding
        // from the source HTML and so the row-height calc can count visual
        // lines reliably downstream.
        // .snippet-action is stripped because action()/chain() produce clickable
        // links that can't function in a static spreadsheet - their label text
        // would otherwise leak into the Summary as orphaned words.
        // Shared flattener with the PDF Summary block (penumbraExportPlainText):
        // web-only stripped, noweb() kept, <br>/block boundaries -> newlines, each
        // line whitespace-collapsed and trimmed, blanks dropped. It removes the
        // canvases itself, so the chart handling below is unaffected.
        const snippetText = penumbraExportPlainText($('#reportSnippetOutput'));

        if (snippetText && snippetText.length > 0) {
            sections.push({
                type: 'snippet',
                content: snippetText
            });
        }

        // 5. Snippet Charts/Visualizations
        // Canvases inside a slide() frame are excluded - slides are a
        // browser-only presentation feature and don't belong in exports.
        const charts = [];
        $('#reportSnippetOutput canvas').filter(function () {
            return !$(this).closest('.penumbra-slide-frame').length;
        }).each(function (index) {
            const canvas = this;
            try {
                // Determine background color based on current theme
                const $body = $('body');
                const isDark = bodyIsDark();
                const bgColor = isDark ? '#1a1a1a' : '#ffffff';

                // Create a temporary canvas with background
                const tempCanvas = document.createElement('canvas');
                tempCanvas.width = canvas.width;
                tempCanvas.height = canvas.height;
                const ctx = tempCanvas.getContext('2d');

                // Fill background, then draw the chart on top
                ctx.fillStyle = opts.monochrome ? '#ffffff' : bgColor;
                ctx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
                ctx.drawImage(canvas, 0, 0);

                // Monochrome export: the chart palette is the theme's too, so
                // flatten it to luminance (Rec.601). A pixel loop rather than
                // ctx.filter = 'grayscale(1)' - same result, no Safari caveat.
                if (opts.monochrome) {
                    const px = ctx.getImageData(0, 0, tempCanvas.width, tempCanvas.height);
                    const d = px.data;
                    for (let i = 0; i < d.length; i += 4) {
                        const y = Math.round(0.299 * d[i] + 0.587 * d[i + 1] + 0.114 * d[i + 2]);
                        d[i] = d[i + 1] = d[i + 2] = y;
                    }
                    ctx.putImageData(px, 0, 0);
                }

                // Get base64 image data
                const imageData = tempCanvas.toDataURL('image/png');

                // Placement size = the canvas's CSS box, i.e. exactly how big
                // the chart is on screen (Chart.js draws the bitmap at
                // devicePixelRatio, so canvas.width can be 2x that - the
                // picture stays sharp, the sheet shows it at web size).
                charts.push({
                    index,
                    data: imageData,
                    width: canvas.clientWidth || canvas.width,
                    height: canvas.clientHeight || canvas.height
                });
            } catch (e) {
                console.warn('Could not capture chart for Excel export:', e);
            }
        });

        if (charts.length > 0) {
            sections.push({
                type: 'charts',
                content: charts
            });
        }

        // (No link back to the report on purpose: a workbook travels to people
        // who may have no access, and the email header's link is a different
        // audience.)

        return sections;
    }

    // --- REFACTORED: ExcelJS Version with WORKING Freeze Panes ---
    // includeHeaderOpt: true/false to embed (or omit) the report header block -
    // title, timestamp, prompts, snippet, charts - above the grid. REQUIRED from
    // every caller. It used to be sniffed here as
    //   downloadDialogRadio === 'include' || emailDialogRadio === 'include'
    // which crossed the two surfaces: setting "Include header data" in the Email
    // dialog silently forced it on for a later plain Download (and vice versa),
    // with no way to turn it back off from the dialog you were actually using.
    // Each caller now passes its OWN radio.
    // xlsxOpts.monochrome: build the workbook in the registry's Monochrome
    // palette (greyscale cells, greyscale chart bitmaps) whatever theme the
    // page is showing - the Download dialog's "Don't include theme colors".
    async function createXlsxWorkbook(includeHeaderOpt, xlsxOpts) {
        const includeHeader = includeHeaderOpt === true;
        const monochrome = !!(xlsxOpts && xlsxOpts.monochrome);
        // Load ExcelJS for full Excel feature support (including freeze panes)
        if (typeof ExcelJS === 'undefined') {
            await loadScript("js/exceljs-4.4.0.min.js");
            // Give it a moment to initialize
            await new Promise(resolve => setTimeout(resolve, 100));
        }

        // --- Theme Definitions ---
        // XLSX theme colors come from the registry (window.PENUMBRA_THEMES,
        // emitted by themes_config.php and derived from the same $theme_styles
        // the PHP exporter uses). getThemeExcel() returns the ARGB palette.
        // getThemeExcel() falls back to theme-default for an id the registry
        // lacks, which for a monochrome request would mean silently shipping
        // the default BLUE - so the Monochrome row is checked for explicitly
        // and a built-in grey palette stands in if it is ever missing.
        const _monoRow = window.PENUMBRA_THEMES && window.PENUMBRA_THEMES['theme-monochrome'];
        const colors = !monochrome ? getThemeExcel(currentThemeId())
            : ((_monoRow && _monoRow.excel && _monoRow.excel.headerBg) ? _monoRow.excel : {
                headerBg: 'FF2B2B2B', headerFont: 'FFFFFFFF', oddBg: 'FFFFFFFF', evenBg: 'FFEFEFEF',
                dataFont: 'FF1A1A1A', groupHeaderBg: 'FFE8E8E8', groupHeaderFont: 'FF1A1A1A'
            });

        const workbook = new ExcelJS.Workbook();
        const isPivotMode = $('#pivot-output-container').is(':visible');
        let hasData = false;

        // --- HELPER: Decode HTML Entities ---
        const decodeEntities = (str) => {
            if (!str)
                return "";
            const temp = document.createElement('div');
            temp.innerHTML = str;
            return temp.textContent || temp.innerText || "";
        }
            ;

        // --- HELPER: Clean Cell Value ---
        const cleanCellValue = (rawValue) => {
            if (rawValue === null || rawValue === undefined) return "";

            let val = String(rawValue);

            if (val.startsWith('@@JSON')) {
                val = formatJsonForTextExport(decodeEntities(val));
            } else if (val.includes('<') || val.includes('>')) {
                // Parse the markup ONCE. This branch used to run AFTER
                // decodeEntities(), which is itself an innerHTML -> textContent
                // round trip - every tag was already gone by the time the
                // <br>/<p> handling below looked for one, so a multi-line cell
                // exported as one run-together line ("line oneline two"). The
                // innerHTML parse here decodes the entities anyway.
                const tmp = document.createElement("div");
                tmp.innerHTML = val;

                // Modified-cell dual-view cleanup - keep only the currently-
                // visible view from .snap-cell-modified cells so XLSX export
                // doesn't concat both [was:]/[now:] AND the now-only span.
                const _baOnXlsx = document.body.classList.contains('snap-show-before-after');
                tmp.querySelectorAll(_baOnXlsx ? '.snap-ba-now-only' : '.snap-ba-pair').forEach(el => el.remove());

                // Manually walk through and replace BR tags with newlines
                const brTags = tmp.querySelectorAll('br');
                brTags.forEach(br => {
                    const textNode = document.createTextNode('\n');
                    br.parentNode.replaceChild(textNode, br);
                });

                // Also handle closing P tags as paragraph breaks
                const pTags = tmp.querySelectorAll('p');
                pTags.forEach(p => {
                    const textNode = document.createTextNode('\n');
                    p.appendChild(textNode);
                });

                // Now get the text content
                val = tmp.textContent || tmp.innerText || "";
            } else {
                val = decodeEntities(val);
            }

            return val;
        };

        // Resolves a table cell to the raw string handed to cleanCellValue,
        // correctly for snapshot-comparison "modified" cells (which carry BOTH
        // pre-rendered views, .snap-ba-now-only + .snap-ba-pair) and @@JSON cells.
        // Fixes three XLSX-only faults: (1) reading $cell.html() concatenated
        // both dual views into "NEW [was:] OLD [now:] NEW"; (2) a modified @@JSON
        // cell holds THREE .raw-json-data copies and .text() glued them into
        // invalid @@JSON{new}{old}{new}; (3) the plain path's tag concat. A @@JSON
        // cell always exports its CURRENT (now) value - the single real data
        // value; the [was:] is diff annotation that can't live in one JSON cell.
        const readExportCell = (cellNode) => {
            if (!cellNode || !cellNode.querySelector) return cellNode ? cellNode.innerHTML : '';
            // Modified comparison cell (dual views): the CURRENT value is
            // authoritative. If the now-view holds a JSON payload, export that;
            // if the now-view is PLAIN (value changed from JSON to plain), do
            // NOT fall through to the [was:] view's raw-json - strip the pair
            // and export the plain current value.
            if (cellNode.querySelector('.snap-ba-now-only, .snap-ba-pair')) {
                const nowJson = cellNode.querySelector('.snap-ba-now-only .raw-json-data');
                if (nowJson) return '@@JSON' + nowJson.textContent;
                const clone = cellNode.cloneNode(true);
                const baOn = document.body.classList.contains('snap-show-before-after');
                clone.querySelectorAll(baOn ? '.snap-ba-now-only' : '.snap-ba-pair').forEach(el => el.remove());
                // Hidden raw-JSON metadata remnants would leak into textContent.
                clone.querySelectorAll('.raw-json-data').forEach(el => el.remove());
                return clone.innerHTML;
            }
            const jsonHost = cellNode.querySelector('.raw-json-data');
            if (jsonHost) return '@@JSON' + jsonHost.textContent;
            return cellNode.innerHTML;
        };

        // --- HELPER: Apply Cell Styling ---
        // Excel number format inferred from the RENDERED cell text, so a numeric
        // cell lands in the sheet as a real number that still DISPLAYS what the
        // screen displayed. One implementation for the flat/grouped writer and
        // the pivot writer - they used to be separate and disagreed:
        //   "$1,234"     flat -> "$1,234"   pivot -> "$1,234.00"  (invented cents)
        //   "3.14159"    flat -> "3.14"     pivot -> "3.1416"     (flat rounded away 3 digits)
        //   "1234.5"     flat -> "1234.50"  (added a digit, dropped grouping)
        // Now both keep the EXACT decimal count and separator the screen showed.
        // Returns { value, numFmt } for a numeric cell, or null to leave it text.
        const _xlsxNumericCell = (raw) => {
            const s = String(raw == null ? '' : raw).trim();
            if (!s || s.indexOf('\n') !== -1) return null;
            // Percentages stay text on purpose: written as a number with a percent
            // format "45%" would render 4500%, and storing 0.45 loses what was shown.
            if (s.indexOf('%') !== -1) return null;
            const cleaned = s.replace(/[$,\s]/g, '');
            if (cleaned === '' || isNaN(parseFloat(cleaned)) || !isFinite(cleaned)) return null;
            // A leading zero ("007", "0123", "-0042") marks an identifier - zip, OUC,
            // account suffix - not a quantity: as a number the zero is gone for good,
            // while the screen and the SQL kept it. "0", "0.5", "-0.25" stay numeric.
            // Mirrors _xlsx_leading_zero_text() in schedule_runner.php.
            if (/^[+-]?0\d/.test(cleaned)) return null;
            const hasDollar = s.indexOf('$') !== -1;
            const hasComma = s.indexOf(',') !== -1;
            const dot = cleaned.indexOf('.');
            const decimals = dot === -1 ? 0 : Math.min(cleaned.length - dot - 1, 6);
            // Currency implies grouping (it is what Excel's own currency format
            // does, and any rendered value >= 1000 that the screen grouped already
            // carries the comma); otherwise only group if the screen grouped.
            const grouped = hasComma || hasDollar;
            const core = (grouped ? '#,##0' : '0') + (decimals ? '.' + '0'.repeat(decimals) : '');
            let numFmt = null;
            if (hasDollar) numFmt = '"$"' + core + '_);[Red]("$"' + core + ')';
            else if (grouped || decimals) numFmt = core;
            // plain integer with no separators -> no format at all (unchanged)
            return { value: parseFloat(cleaned), numFmt: numFmt };
        };

        // --- format() conditional formatting -> Excel ---------------------------
        // The workbook used to carry only the THEME (zebra + header colors), so every
        // highlight a report author had set up with format(row|cell|header, ...) was
        // silently dropped on export - the one part of the view most likely to be the
        // POINT of the report. applyConditionalFormatting() writes its whitelisted CSS
        // as INLINE styles (~8074/8142/8147), while zebra striping uses CLASSES
        // (applyZebraStriping ~7967), so reading the inline style attribute picks up
        // exactly the format() rules and nothing else - no getComputedStyle, no risk
        // of baking the theme's own striping into the cells twice.
        const _argbCache = {};
        const _xlsxArgb = (css) => {
            if (!css) return null;
            if (Object.prototype.hasOwnProperty.call(_argbCache, css)) return _argbCache[css];
            let out = null;
            try {
                const probe = document.createElement('span');
                probe.style.color = css;
                if (probe.style.color) {            // invalid colors don't stick
                    probe.style.display = 'none';
                    document.documentElement.appendChild(probe);
                    const m = getComputedStyle(probe).color.match(/rgba?\(([^)]+)\)/);
                    probe.remove();
                    if (m) {
                        const p = m[1].split(',').map(v => parseFloat(v));
                        // Fully transparent = "no colour set", not black.
                        if (!(p.length > 3 && p[3] <= 0.01)) {
                            out = 'FF' + p.slice(0, 3).map(n =>
                                Math.max(0, Math.min(255, Math.round(n))).toString(16).padStart(2, '0')
                            ).join('').toUpperCase();
                        }
                    }
                }
            } catch (e) { out = null; }
            _argbCache[css] = out;
            return out;
        };

        // Inline (= format()-authored) styling on a source <td>/<th>. A format(row, ...)
        // rule styles the <tr> and only pushes borders down to the cells, so a td with
        // nothing of its own inherits its row's. Returns null when the cell carries no
        // rule, which is the overwhelmingly common case and costs one property read.
        const _xlsxRuleStyle = (el) => {
            if (!el || !el.style) return null;
            const own = el.style;
            const row = (el.tagName === 'TD' && el.parentNode && el.parentNode.tagName === 'TR')
                ? el.parentNode.style : null;
            const pick = (p) => own[p] || (row ? row[p] : '') || '';
            // Border shorthands don't always round-trip off .style, so fall back to
            // the longhands (a rule like 'border-left: 2px dashed' is in the format()
            // whitelist and is a common way to mark a column boundary).
            const side = (p) => {
                const short = pick(p);
                if (short) return short;
                const st = pick(p + 'Style');
                if (!st || st === 'none') return '';
                return [pick(p + 'Width'), st, pick(p + 'Color')].filter(Boolean).join(' ');
            };
            const r = {
                bg: pick('backgroundColor'),
                fg: pick('color'),
                weight: pick('fontWeight'),
                style: pick('fontStyle'),
                deco: pick('textDecoration') || pick('textDecorationLine'),
                border: side('border'),
                borderLeft: side('borderLeft'),
                borderRight: side('borderRight'),
                borderTop: side('borderTop'),
                borderBottom: side('borderBottom')
            };
            for (const k in r) { if (r[k]) return r; }
            return null;
        };

        // CSS border shorthand -> ExcelJS border. '2px dashed' is the shape that shows
        // up most (a column-boundary marker); width picks thin/medium/thick.
        const _xlsxBorder = (css) => {
            if (!css) return null;
            const s = String(css).trim();
            const low = s.toLowerCase();
            if (!low || low === 'none' || low.indexOf('none') === 0 || low.indexOf('hidden') === 0) return null;
            const w = parseFloat(low) || 1;
            let style;
            if (low.indexOf('dashed') !== -1) style = w >= 2 ? 'mediumDashed' : 'dashed';
            else if (low.indexOf('dotted') !== -1) style = 'dotted';
            else if (low.indexOf('double') !== -1) style = 'double';
            else style = w >= 3 ? 'thick' : (w >= 2 ? 'medium' : 'thin');
            const KEYWORDS = ['solid', 'dashed', 'dotted', 'double', 'none', 'hidden',
                              'groove', 'ridge', 'inset', 'outset'];
            const colorTok = s.split(/\s+/).find(t =>
                !/^[\d.]/.test(t) && KEYWORDS.indexOf(t.toLowerCase()) === -1);
            const argb = colorTok ? _xlsxArgb(colorTok) : null;
            const out = { style: style };
            if (argb) out.color = { argb: argb };
            return out;
        };

        // Repaint an already-styled ExcelJS cell with the rule's colours, keeping the
        // theme's font family/size and the borders.
        const _xlsxApplyRuleStyle = (cell, el) => {
            const r = _xlsxRuleStyle(el);
            if (!r) return;
            const bgArgb = _xlsxArgb(r.bg);
            if (bgArgb) {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgArgb } };
            }
            const font = Object.assign({}, cell.font);
            const fgArgb = _xlsxArgb(r.fg);
            if (fgArgb) {
                font.color = { argb: fgArgb };
            } else if (bgArgb) {
                // A rule that sets only a background would otherwise keep the THEME's
                // font colour - near-white under a dark theme, i.e. invisible on a pale
                // highlight. Pick black/white by luminance so the cell stays readable
                // whatever theme the export was taken in.
                const r8 = parseInt(bgArgb.substr(2, 2), 16),
                      g8 = parseInt(bgArgb.substr(4, 2), 16),
                      b8 = parseInt(bgArgb.substr(6, 2), 16);
                const lum = (0.299 * r8 + 0.587 * g8 + 0.114 * b8) / 255;
                font.color = { argb: lum > 0.55 ? 'FF000000' : 'FFFFFFFF' };
            }
            if (r.weight) {
                const w = String(r.weight).toLowerCase();
                font.bold = (w === 'bold' || w === 'bolder' || (parseInt(w, 10) >= 600));
            }
            if (r.style) font.italic = String(r.style).toLowerCase() === 'italic';
            if (r.deco) {
                const d = String(r.deco).toLowerCase();
                if (d.indexOf('underline') !== -1) font.underline = true;
                if (d.indexOf('line-through') !== -1) font.strike = true;
            }
            cell.font = font;

            // Borders merge onto the theme's grid rather than replacing it, so a
            // one-sided rule marks that edge and leaves the other three alone.
            const bord = Object.assign({}, cell.border);
            let borderTouched = false;
            const all = _xlsxBorder(r.border);
            if (all) {
                bord.left = bord.right = bord.top = bord.bottom = all;
                borderTouched = true;
            }
            [['borderLeft', 'left'], ['borderRight', 'right'],
             ['borderTop', 'top'], ['borderBottom', 'bottom']].forEach(pair => {
                const b = _xlsxBorder(r[pair[0]]);
                if (b) { bord[pair[1]] = b; borderTouched = true; }
            });
            if (borderTouched) cell.border = bord;
        };

        const applyCellStyle = (cell, isHeader, isFooter, rowIndex, value, srcEl) => {
            // Standard thin border for all cells
            const thinB = { style: 'thin', color: { argb: 'FFCCCCCC' } };

            // Base font
            cell.font = {
                name: 'Verdana',
                size: 10,
                color: {
                    argb: isHeader || isFooter ? colors.headerFont : colors.dataFont
                },
                bold: isHeader || isFooter
            };

            // Background fill
            if (isHeader || isFooter) {
                cell.fill = {
                    type: 'pattern',
                    pattern: 'solid',
                    fgColor: {
                        argb: colors.headerBg
                    }
                };
            } else {
                // Data rows arrive 1-based here (flat, grouped and nested all
                // start at 1) and the screen paints its FIRST row zebra-light
                // = oddBg, so an odd rowIndex is the light stripe. `=== 0` had
                // the stripes inverted against the screen, the pivot sheet
                // (0-based) and the scheduler's workbook.
                const bgColor = rowIndex % 2 === 1 ? colors.oddBg : colors.evenBg;
                cell.fill = {
                    type: 'pattern',
                    pattern: 'solid',
                    fgColor: {
                        argb: bgColor
                    }
                };
            }

            // Alignment
            cell.alignment = {
                vertical: isHeader ? 'middle' : 'top',
                horizontal: isHeader || isFooter ? 'center' : 'left',
                wrapText: true
            };

            // Borders - all cells get normal thin borders, headers/footers get emphasized edge
            if (isHeader) {
                cell.border = {
                    top: thinB, left: thinB, right: thinB,
                    bottom: { style: 'medium', color: { argb: 'FF888888' } }
                };
            } else if (isFooter) {
                cell.border = {
                    bottom: thinB, left: thinB, right: thinB,
                    top: { style: 'medium', color: { argb: 'FF888888' } }
                };
                cell.alignment.horizontal = 'right';
            } else {
                cell.border = { top: thinB, bottom: thinB, left: thinB, right: thinB };
            }

            // Number formatting - preserve original format
            const originalValue = String(value);

            // Don't convert to number if value contains newlines (multi-line text)
            if (originalValue.includes('\n')) {
                // Explicitly set as text to preserve newlines
                cell.value = originalValue;
                cell.type = ExcelJS.ValueType.String;
                _xlsxApplyRuleStyle(cell, srcEl);
                return;
            }

            const num = _xlsxNumericCell(originalValue);
            if (num) {
                cell.value = num.value;
                cell.type = ExcelJS.ValueType.Number;
                if (num.numFmt) cell.numFmt = num.numFmt;
            }

            // Last, so a format() rule wins over the theme's zebra/header colours -
            // on screen it does too (inline style beats the stylesheet).
            _xlsxApplyRuleStyle(cell, srcEl);
        }
            ;

        // --- HELPER: Apply Header Info Styling ---
        const applyHeaderInfoStyle = (cell, styleType = 'normal') => {
            switch (styleType) {
                case 'title':
                    cell.font = {
                        name: 'Verdana',
                        size: 16,
                        color: {
                            argb: colors.headerFont
                        },
                        bold: true
                    };
                    cell.fill = {
                        type: 'pattern',
                        pattern: 'solid',
                        fgColor: {
                            argb: colors.headerBg
                        }
                    };
                    cell.alignment = {
                        vertical: 'middle',
                        horizontal: 'left',
                        wrapText: true
                    };
                    cell.border = {
                        bottom: {
                            style: 'medium',
                            color: {
                                argb: colors.headerBg
                            }
                        }
                    };
                    break;

                case 'section-header':
                    cell.font = {
                        name: 'Verdana',
                        size: 10,
                        color: {
                            argb: colors.dataFont
                        },
                        bold: true,
                        italic: true
                    };
                    cell.fill = {
                        type: 'pattern',
                        pattern: 'solid',
                        fgColor: {
                            argb: colors.evenBg
                        }
                    };
                    cell.alignment = {
                        vertical: 'middle',
                        horizontal: 'left',
                        wrapText: true
                    };
                    break;

                case 'prompt-label':
                    cell.font = {
                        name: 'Verdana',
                        size: 9,
                        color: {
                            argb: colors.dataFont
                        },
                        bold: true
                    };
                    cell.alignment = {
                        vertical: 'top',
                        horizontal: 'right',
                        wrapText: true
                    };
                    break;

                case 'prompt-value':
                    cell.font = {
                        name: 'Verdana',
                        size: 9,
                        color: {
                            argb: colors.dataFont
                        }
                    };
                    cell.fill = {
                        type: 'pattern',
                        pattern: 'solid',
                        fgColor: {
                            argb: colors.oddBg
                        }
                    };
                    cell.alignment = {
                        vertical: 'top',
                        horizontal: 'left',
                        wrapText: true
                    };
                    break;

                default:
                    // 'normal'
                    cell.font = {
                        name: 'Verdana',
                        size: 9,
                        color: {
                            argb: colors.dataFont
                        }
                    };
                    cell.alignment = {
                        vertical: 'top',
                        horizontal: 'left',
                        wrapText: true
                    };
            }
        }
            ;

        // --- Sheet geometry (shared by the header block, autosize and freeze) ---
        // Excel row heights are POINTS; canvas bitmaps are PIXELS (0.75pt each).
        // Column widths are Excel "character" units: a column of width w renders
        // about w*7+5 px, and Verdana 9pt averages ~0.55em (~6.6px) per glyph -
        // that ratio is what turns a merged span into a line length for the
        // wrap-height maths below.
        const XLSX_PX_TO_PT = 0.75;
        const XLSX_MAX_ROW_PT = 409;          // Excel's hard ceiling for one row
        // Frozen panes pin rows 1..N to the top of the window, so a header
        // block is only frozen (together with the column headers) while it
        // takes up to about HALF a screen - 300pt is half of the ~600pt grid
        // Excel shows on a 1080p display. A taller block (several charts)
        // stays unfrozen so the data can still scroll into view.
        const XLSX_FREEZE_MAX_PT = 300;
        // Charts are placed at their on-screen size (the reader can resize the
        // picture in Excel); these only cap a runaway canvas, and the height
        // cap keeps one chart inside Excel's 409pt row ceiling.
        const XLSX_CHART_MAX_W = 1600, XLSX_CHART_MAX_H = 520;
        const _xlsxColPx = (w) => Math.floor((typeof w === 'number' ? w : 8.43) * 7 + 5);
        const _xlsxColLetter = (idx) => {           // 0-based -> A, B, ..., Z, AA
            let letter = '', n = idx;
            while (n >= 0) { letter = String.fromCharCode(65 + (n % 26)) + letter; n = Math.floor(n / 26) - 1; }
            return letter;
        };
        const _xlsxWrappedLines = (text, charsPerLine) => String(text).split('\n')
            .reduce((n, line) => n + Math.max(1, Math.ceil(line.length / Math.max(1, charsPerLine))), 0);

        // --- HELPER: Auto-adjust column widths ---
        // Measures the TABLE cells only. Two things used to distort it:
        //   1. Merged cells. ExcelJS hands a merge's slave cells the master's
        //      value, so the report title (merged A:end) made EVERY column as
        //      wide as the title, the snippet made C:end as wide as the
        //      snippet, and a nested-grouping band did the same to the whole
        //      sheet - a table-only export came out [20,15,15,18,...] and the
        //      identical table with the header on came out [70,70,65,65,...].
        //      Any merge spanning more than one column is skipped now; its text
        //      is spread across the span and has no single column to size -
        //      and the header block's rows are skipped outright, so a prompt
        //      label in A (the one unmerged cell the block has) cannot widen
        //      the first data column either.
        //   2. Multi-line cells were measured by TOTAL length, newlines
        //      included, so three 12-character lines sized the column for 36.
        //      wrapText is on everywhere, so the longest LINE is the width.
        // Runs the header block's finalize hook last: wrap heights and chart
        // positions depend on the widths this just settled.
        const autoSizeColumns = (worksheet) => {
            if (!worksheet.columns) return;
            const merges = worksheet._merges || {};
            const skipRows = worksheet._pnbHeaderRows || 0;
            worksheet.columns.forEach(column => {
                let maxLength = 0;
                column.eachCell({
                    includeEmpty: false
                }, (cell, rowNumber) => {
                    if (rowNumber <= skipRows) return;
                    if (cell.isMerged) {
                        const master = cell.master || cell;
                        const m = merges[master.address];
                        // Unknown extent (private API changed?) -> be safe, skip.
                        if (!m || typeof m.left !== 'number' || m.right > m.left) return;
                    }
                    let raw = cell.value;
                    if (raw && typeof raw === 'object') raw = (raw.text != null) ? raw.text : (raw.result != null ? raw.result : '');
                    const cellValue = raw == null ? '' : String(raw);
                    let len = 0;
                    cellValue.split('\n').forEach(line => { if (line.length > len) len = line.length; });

                    // Add buffer for bold text (headers/footers)
                    if (cell.font && cell.font.bold) {
                        len = (len * 1.5) + 5;
                    } else {
                        len = (len * 1.2) + 2;
                    }

                    // Extra buffer for numbers/dates
                    if (cell.numFmt || cellValue.includes('$') || /^\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}/.test(cellValue)) {
                        len += 6;
                    }

                    maxLength = Math.max(maxLength, len);
                }
                );
                column.width = Math.min(Math.max(maxLength, 15), 70);
            }
            );
            if (typeof worksheet._pnbFinalizeHeader === 'function') {
                try { worksheet._pnbFinalizeHeader(); } catch (e) { console.warn('XLSX header finalize failed:', e); }
                worksheet._pnbFinalizeHeader = null;
            }
        }
            ;

        // --- HELPER: Freeze panes ---
        // headerInfoRows = rows of the report header block (0 when omitted),
        // tableHeaderRows = the column-header row(s) under it. Both are pinned
        // while the block stays within XLSX_FREEZE_MAX_PT (about half a
        // screen); past that nothing is row-frozen. frozenCols = the pivot's
        // row-field columns or the flat table's frozen leading columns,
        // independent of the row rule.
        const _xlsxFreeze = (worksheet, headerInfoRows, tableHeaderRows, frozenCols) => {
            let pt = 0;
            for (let r = 1; r <= headerInfoRows; r++) {
                const h = worksheet.getRow(r).height;
                pt += (typeof h === 'number' ? h : 15);
            }
            const ySplit = (pt <= XLSX_FREEZE_MAX_PT) ? (headerInfoRows + tableHeaderRows) : 0;
            const xSplit = frozenCols || 0;
            if (!ySplit && !xSplit) { worksheet.views = []; return; }
            const anchor = _xlsxColLetter(xSplit) + (ySplit + 1);
            worksheet.views = [{
                state: 'frozen',
                xSplit: xSplit,
                ySplit: ySplit,
                topLeftCell: anchor,
                activeCell: anchor
            }];
        };

        /**
         * Writes the report header block above the table: the same block the
         * scheduled-email header shows - title band, by-line, retrieval time
         * with the row count, search filter, import timestamps, Report
         * Parameters (one label|value row per prompt), Summary (the snippet
         * text) and Visualizations (the chart bitmaps at their on-screen
         * size) - as a continuous full-width band with the theme's accent
         * stripe down its left edge. No link back to the report: a workbook
         * travels to people who may have no access.
         *
         * Every row spans the whole table (merged A:columnCount), so the block
         * no longer depends on how many columns the table happens to have: the
         * old layout put prompts in A:B and the snippet from C onward, which on
         * a one- or two-column table left the snippet hanging outside the
         * table and on a wide one squeezed everything into the first cells.
         *
         * Heights are calculated, not guessed: text rows are registered here
         * and sized in the finalize hook once autoSizeColumns() has settled
         * the column widths (a wrap height needs the real span width), and the
         * chart bitmaps are anchored in the same pass so they can sit side by
         * side inside the table's width instead of stacking one per row.
         *
         * @param {Object} worksheet - ExcelJS worksheet
         * @param {Array} sections - Header sections from extractHeaderDataForExcel()
         * @param {number} columnCount - Table width in columns (merge span)
         * @returns {number} Number of rows added
         */
        function insertFormattedHeader(worksheet, sections, columnCount) {
            const span = Math.max(1, columnCount || 1);
            const by = {};
            (sections || []).forEach(s => { by[s.type] = s; });
            const wrapRows = [];    // { row, text, fontPt, minPt, fromCol } -> heights in finalize
            const chartRows = [];   // { row, charts: [{ chart, width, height, x }] } -> images in finalize
            let rowCount = 0;
            const accent = { style: 'medium', color: { argb: colors.headerBg } };

            // One block row: fills every cell of the span, carries the accent
            // stripe on the left edge (the email header's 5px bar), merges the
            // span and returns the row.
            const blockRow = (values, opts) => {
                opts = opts || {};
                const row = worksheet.addRow(values);
                for (let c = 1; c <= span; c++) {
                    const cell = row.getCell(c);
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: opts.bg || colors.oddBg } };
                    cell.font = Object.assign({ name: 'Verdana', size: 9, color: { argb: colors.dataFont } }, opts.font || {});
                    cell.alignment = Object.assign({ vertical: 'top', horizontal: 'left', wrapText: true }, opts.align || {});
                    if (c === 1) cell.border = Object.assign({}, cell.border, { left: accent });
                }
                if (span > 1 && !opts.noMerge) worksheet.mergeCells(row.number, 1, row.number, span);
                if (opts.height) row.height = opts.height;
                rowCount++;
                return row;
            };
            const wrapRow = (text, fontPt, minPt, opts) => {
                const o = Object.assign({}, opts || {});
                o.font = Object.assign({ size: fontPt }, o.font || {});
                const row = blockRow([text], o);
                wrapRows.push({ row: row, text: text, fontPt: fontPt, minPt: minPt || 0, fromCol: 1 });
                return row;
            };
            const sectionLabel = (text) => blockRow([text], {
                bg: colors.evenBg,
                font: { size: 10, bold: true, italic: true },
                align: { vertical: 'middle' },
                height: 18
            });

            // 1. Title band - brand colour, like the email header's title.
            if (by.title) {
                wrapRow(by.title.content, 16, 34, {
                    bg: colors.headerBg,
                    font: { bold: true, color: { argb: colors.headerFont } },
                    align: { vertical: 'middle', indent: 1 }
                });
            }

            // 1b. By-line / subtitle.
            if (by.subtitle) {
                wrapRow(by.subtitle.content, 10, 15, { font: { italic: true }, align: { indent: 1 } });
            }

            // 2. Retrieval time + row count on ONE line, as the email prints it.
            // Not $('#resultCount').text(): in pivot mode the source-transaction
            // count lives in a title attribute on a trailing "*" marker, so the
            // raw text lands in the sheet as a dangling "10 pivot rows *".
            // getExpandedResultCount() splices the tooltip inline.
            if (by.timestamp) {
                const resultCount = getExpandedResultCount();
                blockRow([by.timestamp.content + (resultCount ? '. ' + resultCount : '')], { height: 14, align: { indent: 1 } });
            }

            // 2a. The search filter that produced that row count.
            if (by.search) {
                blockRow(['Search filter: ' + by.search.content], { height: 14, font: { italic: true }, align: { indent: 1 } });
            }

            // 2b. Import / DB_DUMP refresh timestamps.
            if (by.import_timestamps && by.import_timestamps.content.length > 0) {
                by.import_timestamps.content.forEach(function (line) {
                    blockRow([line], { height: 14, font: { italic: true, color: { argb: 'FF888888' } }, align: { indent: 1 } });
                });
            }

            // 3. Report Parameters - one row per prompt: label right-aligned in
            // A, value across B:end. (The PDF cover uses the same heading.)
            if (by.prompts && by.prompts.content.length > 0) {
                sectionLabel('Report Parameters');
                by.prompts.content.forEach(p => {
                    if (span === 1) {
                        wrapRow(p.label + ' ' + p.value, 9, 14);
                        return;
                    }
                    const row = worksheet.addRow([p.label, p.value]);
                    for (let c = 1; c <= span; c++) {
                        const cell = row.getCell(c);
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: colors.oddBg } };
                        cell.font = { name: 'Verdana', size: 9, color: { argb: colors.dataFont }, bold: c === 1 };
                        cell.alignment = { vertical: 'top', horizontal: c === 1 ? 'right' : 'left', wrapText: true };
                        if (c === 1) cell.border = Object.assign({}, cell.border, { left: accent });
                    }
                    if (span > 2) worksheet.mergeCells(row.number, 2, row.number, span);
                    // The label sits in A alone and is NOT measured by autosize,
                    // so a long one wraps inside whatever width the data gave
                    // column A - finalize sizes the row for both cells.
                    wrapRows.push({ row: row, text: p.value, fontPt: 9, minPt: 14, fromCol: 2, label: p.label });
                    rowCount++;
                });
            }

            // 4. Summary - the snippet text. Chunked on its hard lines so no
            // single row needs more than Excel's 409pt ceiling (one row per
            // ~28 wrapped lines at a conservative 60 chars/line); the finalize
            // hook then sizes each chunk exactly.
            if (by.snippet) {
                sectionLabel('Summary');
                const chunks = [];
                let cur = [], est = 0;
                String(by.snippet.content).split('\n').forEach(line => {
                    const n = Math.max(1, Math.ceil(line.length / 60));
                    if (cur.length && est + n > 28) { chunks.push(cur.join('\n')); cur = []; est = 0; }
                    cur.push(line);
                    est += n;
                });
                if (cur.length) chunks.push(cur.join('\n'));
                chunks.forEach(chunk => wrapRow(chunk, 9, 14, { align: { indent: 1 } }));
            }

            // 5. Visualizations - charts packed left to right across the
            // table's width. The row layout has to be fixed NOW (rows are
            // appended in order), so it packs against the table's MINIMUM
            // width (every column is at least 15 units ~ 110px); the exact
            // x-anchors come in finalize from the real widths. A narrow table
            // therefore stacks them, a wide one lines them up - the same thing
            // the email's right-hand column does with the space it has.
            if (by.charts && by.charts.content.length > 0) {
                sectionLabel('Visualizations');
                const GAP = 10, PAD = 8;
                const rowMinPx = span * _xlsxColPx(15);
                let cur = null, x = PAD;
                by.charts.content.forEach(chart => {
                    let width = chart.width || 1, height = chart.height || 1;
                    if (width > XLSX_CHART_MAX_W) { height = (XLSX_CHART_MAX_W / width) * height; width = XLSX_CHART_MAX_W; }
                    if (height > XLSX_CHART_MAX_H) { width = (XLSX_CHART_MAX_H / height) * width; height = XLSX_CHART_MAX_H; }
                    width = Math.round(width); height = Math.round(height);
                    if (!cur || (x + width + PAD > rowMinPx && cur.charts.length > 0)) {
                        cur = { row: blockRow([''], { height: 20 }), charts: [], maxH: 0 };
                        chartRows.push(cur);
                        x = PAD;
                    }
                    cur.charts.push({ chart: chart, width: width, height: height, x: x });
                    cur.maxH = Math.max(cur.maxH, height);
                    x += width + GAP;
                });
                chartRows.forEach(cr => { cr.row.height = Math.min(XLSX_MAX_ROW_PT, cr.maxH * XLSX_PX_TO_PT + 2 * PAD * XLSX_PX_TO_PT); });
            }

            // Final spacer before table data
            if (rowCount > 0) {
                blockRow([''], { height: 8 });
            }
            worksheet._pnbHeaderRows = rowCount;   // autoSizeColumns() skips these rows

            // Deferred geometry - runs from autoSizeColumns() once the column
            // widths are final. Wrap heights: chars per line from the span's
            // pixel width and the row's font (0.78 * pt ~ px per glyph, a hair
            // generous so nothing clips); charts: pixel x -> fractional column.
            worksheet._pnbFinalizeHeader = () => {
                const colPx = [];
                for (let c = 1; c <= span; c++) colPx.push(_xlsxColPx(worksheet.getColumn(c).width));
                const spanPx = (from) => colPx.slice(from - 1).reduce((a, b) => a + b, 0);
                wrapRows.forEach(w => {
                    const cpl = Math.max(8, Math.floor(spanPx(w.fromCol) / (w.fontPt * 0.78)));
                    let lines = _xlsxWrappedLines(w.text, cpl);
                    if (w.label) {
                        const cplA = Math.max(6, Math.floor(colPx[0] / (w.fontPt * 0.78 * 1.15)));  // bold
                        lines = Math.max(lines, _xlsxWrappedLines(w.label, cplA));
                    }
                    w.row.height = Math.min(XLSX_MAX_ROW_PT, Math.max(w.minPt, lines * w.fontPt * 1.35 + 5));
                });
                const imageIds = worksheet.workbook._pnbImageIds = worksheet.workbook._pnbImageIds || {};
                chartRows.forEach(cr => {
                    cr.charts.forEach(item => {
                        try {
                            // One media entry per chart for the WHOLE workbook: a
                            // grouped export repeats this block on every sheet,
                            // and each repeat used to embed its own copy of the
                            // PNG (30 sheets = 30 copies of every chart).
                            const key = String(item.chart.index);
                            if (imageIds[key] === undefined) {
                                imageIds[key] = worksheet.workbook.addImage({
                                    base64: item.chart.data.replace(/^data:image\/\w+;base64,/, ''),
                                    extension: 'png'
                                });
                            }
                            // pixel x -> { column index, fraction of that column }
                            let col = 0, left = item.x;
                            while (col < colPx.length - 1 && left >= colPx[col]) { left -= colPx[col]; col++; }
                            const frac = Math.min(0.99, left / Math.max(1, colPx[col]));
                            worksheet.addImage(imageIds[key], {
                                tl: { col: col + frac, row: cr.row.number - 1 + 0.03 },
                                ext: { width: item.width, height: item.height },
                                editAs: 'oneCell'
                            });
                        } catch (e) {
                            console.warn('Could not add chart to Excel:', e);
                        }
                    });
                });
            };

            return rowCount;
        }

        if (isPivotMode) {
            // --- PIVOT TABLE EXPORT ---
            // Use native multi-row headers for proper merged header display
            const rawArray = getPivotDataAsArray();
            if (rawArray.length > 0) {
                const worksheet = workbook.addWorksheet('Pivot Analysis');

                let headerInfoRowCount = 0;

                // Insert header data if requested
                if (includeHeader) {
                    const headerSections = extractHeaderDataForExcel({ monochrome: monochrome });
                    const columnCount = rawArray[0] ? rawArray[0].length : 10;
                    headerInfoRowCount = await insertFormattedHeader(worksheet, headerSections, columnCount);
                }

                // Detect actual header row count from the HTML pivot table
                const headerRowCount = $('#pivotResultTable thead tr').length || 1;
                const footerRowCount = $('#pivotResultTable tfoot tr').length;

                // Number of row field columns (needed early for footer fix)
                const numRowFields = (typeof currentPivotSettings !== 'undefined' && currentPivotSettings && currentPivotSettings.rows)
                    ? currentPivotSettings.rows.length : 0;

                // Fix footer: colspan-expanded "Grand Total" label repeats across row-field columns
