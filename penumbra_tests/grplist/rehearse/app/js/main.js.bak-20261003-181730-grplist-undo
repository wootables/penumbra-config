    // The task form's warning for a pivot report (2026-09-28): the report's own
    // search reads a name that is also a pivot aggregate label as the aggregate,
    // but an email filters source rows only, so a shared name (AMOUNT, labelled
    // Amount) is the COLUMN there and a pivot-only label (%Δ) is no column at all.
    // Returns a jQuery span to append after the count, or '' when nothing applies.
    function schedFilterPivotNote(filterText) {
        var api = window._penumbraSearchAPI;
        var refs = (api && typeof api.pivotLabelRefs === 'function') ? api.pivotLabelRefs(filterText) : null;
        if (!refs) return '';
        var notes = [];
        if (refs.shared.length === 1) {
            notes.push('In emails, ' + refs.shared[0].column + ' filters the source rows, not the pivot\'s ' + refs.shared[0].label + '.');
        } else if (refs.shared.length > 1) {
            notes.push('In emails, ' + refs.shared.map(function (s) { return s.column; }).join(', ') + ' filter the source rows, not the pivot totals.');
        }
        if (refs.labelOnly.length) {
            // No row count claim here: "= x" on a name that is not a column matches
            // nothing, but "!= x" matches everything - the count above says which.
            notes.push('Emails can\'t filter by the pivot\'s ' + refs.labelOnly.join(', ') + ': ' + (refs.labelOnly.length > 1 ? 'they are not columns' : 'it is not a column') + ' there.');
        }
        if (!notes.length) return '';
        return $('<span class="sched-filter-pivot-note"></span>')
            .css('color', 'var(--accent-warning, #8f6c00)')
            .text(' ' + notes.join(' '));
