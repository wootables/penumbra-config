        return Object.assign(Object.create(null), JSON.parse(localStorage.getItem(lsKey) || '{}'));
    }

    // Global (all-reports) user defaults. Resolution order everywhere:
    // per-report pref ('report-default' sentinel forces the report theme)
    // > global default > report default.
    function getGlobalTheme() { return localStorage.getItem('penumbra_user_theme') || null; }
    function getGlobalDensity() { return localStorage.getItem('penumbra_user_density') || null; }

    // Theme/density value-to-label maps for "Report Default" hint.
    // Theme labels come from the registry (covers new themes automatically).
    var _spThemeLabels = (function () {
        var m = {};
        for (var i = 0; i < PENUMBRA_THEME_IDS.length; i++) {
            var id = PENUMBRA_THEME_IDS[i];
            m[id] = (PENUMBRA_THEMES[id] && PENUMBRA_THEMES[id].label) || id;
        }
        return m;
    })();
    var _spDensityLabels = {
        'standard': 'Standard',
        'compact': 'Compact',
        'easy-read': 'Easy Read'
    };

    // Keep the two sentinel options - 'report-default' and 'my-default' - in step
    // with what they actually resolve to.
    //
    // They used to sit at the top of the list as their own rows, reading
    // "Report Default (Dark Blue)" and "My Default (Wolfpack Red)", so the list
    // opened with two rows naming themes that ALSO appeared further down under
    // their own names. Now each sentinel is annotated with the theme it resolves
    // to and moved to that theme's position, and the plain duplicate is hidden:
    //
    //     Default Light
    //     Dark Blue (this report's default)     <- value 'report-default'
    //     Charcoal & Gold
    //     ...
    //     Wolfpack Red (my global default)      <- value 'my-default'
    //
    // The VALUES are untouched, so the sentinels keep meaning "follow whatever
    // the report says" and "follow my global default" rather than pinning that
    // theme forever - which is the whole reason they exist and is not something
    // picking the concrete row can express.
    //
    // Two cases the merge has to leave alone:
    //  - report default and global default are the same theme: both sentinels
    //    annotate, sitting adjacent, and the plain row hides once. Collapsing
    //    them into a single row would make the value ambiguous.
    //  - the concrete row is what is CURRENTLY selected (an explicit pin that
    //    happens to match a default): it stays visible, or the select would be
    //    showing a hidden option.
    //
    // Idempotent by construction: every run un-hides first, so it can be called
    // again after the selection is applied (openSettingsPanel does exactly that).
    function _syncMyDefaultOptions() {
        [
            { sel: '#spThemeSelector', val: getGlobalTheme(), labels: _spThemeLabels,
              reportVal: currentReportTheme || 'theme-default',
              reportLabel: _spThemeLabels[currentReportTheme] || 'Default Light' },
            { sel: '#spDensitySelector', val: getGlobalDensity(), labels: _spDensityLabels,
              reportVal: currentReportDensity || 'standard',
              reportLabel: _spDensityLabels[currentReportDensity] || 'Standard' }
        ].forEach(function (p) {
            var $sel = $(p.sel);
            var selectedNow = $sel.val();

            // Clean slate - a previous run may have hidden a row that no longer
            // corresponds to a default.
            $sel.find('option').prop('hidden', false);

            function twinFor(value) {
                return $sel.find('option').filter(function () {
                    return this.value === value &&
                           this.value !== 'report-default' && this.value !== 'my-default';
                }).first();
            }

            var $rd = $sel.find('option[value="report-default"]');
            if ($rd.length) {
                $rd.text((p.labels[p.reportVal] || p.reportLabel) + " (this report's default)");
                var $rdTwin = twinFor(p.reportVal);
                if ($rdTwin.length) {
                    $rd.insertBefore($rdTwin);
                    if (selectedNow !== p.reportVal) $rdTwin.prop('hidden', true);
                }
            }

            var $md = $sel.find('option[value="my-default"]');
            if (p.val) {
                if (!$md.length) $md = $('<option value="my-default">');
                $md.text((p.labels[p.val] || p.val) + ' (my global default)');
                var $mdTwin = twinFor(p.val);
                if ($mdTwin.length) {
                    $md.insertBefore($mdTwin);
                    if (selectedNow !== p.val) $mdTwin.prop('hidden', true);
                } else if ($rd.length) {
                    $md.insertAfter($rd);
                } else {
                    $sel.prepend($md);
                }
            } else {
                $md.remove();
            }
        });
    }

    // The hint line under each dropdown is a state-dependent slot:
    //   Report Default selected  -> "(Report Default: X)" as before
    //   explicit value selected  -> offer link to promote it to global default
    //   global default in effect -> status + clear link
    function _updateReportDefaultHints() {
        var selTheme = $('#spThemeSelector').val();
        var selDensity = $('#spDensitySelector').val();

        if (selTheme === 'my-default' || (getGlobalTheme() && selTheme === getGlobalTheme())) {
            $('#spThemeDefaultHint').html('(this is your default on all reports &middot; <span class="sp-hint-link" id="spThemeClearGlobal">clear</span>)');
        } else if (selTheme && selTheme !== 'report-default') {
            $('#spThemeDefaultHint').html('<span class="sp-hint-link" id="spThemeMakeGlobal">Use this theme on all reports I view</span>');
        } else {
            // Deliberately blank. The selected option now reads "<Theme> (this
            // report's default)", so the old "(Report Default: <Theme>)" line
            // underneath was saying the same thing a second time. This branch
            // never offered the promote link, so nothing is lost by emptying it.
            $('#spThemeDefaultHint').text('');
        }

        if (selDensity === 'my-default' || (getGlobalDensity() && selDensity === getGlobalDensity())) {
            $('#spDensityDefaultHint').html('(this is your default on all reports &middot; <span class="sp-hint-link" id="spDensityClearGlobal">clear</span>)');
        } else if (selDensity && selDensity !== 'report-default') {
            $('#spDensityDefaultHint').html('<span class="sp-hint-link" id="spDensityMakeGlobal">Use this density on all reports I view</span>');
        } else {
            $('#spDensityDefaultHint').text('');   // see the theme branch above
        }
    }

    function openSettingsPanel() {
        // Populate column list from current table state
        populateSettingsColumns();

        // Reset hide-unchecked state
        _spSetHideUnchecked(false);
        $('#spColumnList .sp-col-item').removeClass('sp-col-hidden sp-selected');

        // Sync dropdowns: per-report pref (incl. the 'report-default'
        // sentinel) > "My Default" when a global is set > Report Default
        _syncMyDefaultOptions();
        var currentPref = null;
        try {
            var themePrefs = _spPrefMap('penumbra_pref_theme');
            if (Object.prototype.hasOwnProperty.call(themePrefs, _spPrefKey())) {
                currentPref = themePrefs[_spPrefKey()];
            }
        } catch (e) { /* ignore */ }
        $('#spThemeSelector').val(currentPref || (getGlobalTheme() ? 'my-default' : 'report-default'));

        var currentDensityPref = null;
        try {
            var densityPrefs = _spPrefMap('penumbra_pref_density');
            if (Object.prototype.hasOwnProperty.call(densityPrefs, _spPrefKey())) {
                currentDensityPref = densityPrefs[_spPrefKey()];
            }
        } catch (e) { /* ignore */ }
        $('#spDensitySelector').val(currentDensityPref || (getGlobalDensity() ? 'my-default' : 'report-default'));

        // Second pass, now that both selects hold their real value. The first
        // call had to run BEFORE these .val()s so the 'my-default' option exists
        // to be selected; this one lets the merge see what is actually selected,
        // so an explicit pin that matches a default keeps its own visible row.
        _syncMyDefaultOptions();

        // Update "Report Default" hint labels
        _updateReportDefaultHints();

        // Sync row expand toggle
        $('#spRowExpandToggle').prop('checked', isRowExpandActive);

        // Sync resolver links toggle
        $('#spResolverToggle').prop('checked', resolverLinksEnabled);

        // Hide column sections if pivot is active or admin has disabled column customization
        var isPivotActive = $('#pivot-output-container').is(':visible');
        var columnsRestricted = !penumbra_vars.isAdmin && window._penumbraHideColumns;
        if (columnsRestricted) {
            $('.sp-columns-section .sp-columns-pivot-msg').hide();
            $('.sp-columns-section .sp-columns-disabled-msg').show();
            $('.sp-columns-section .sp-column-search-row, .sp-columns-section .sp-column-container').hide();
            $('.sp-actions').hide();
        } else if (isPivotActive) {
            $('.sp-columns-section .sp-columns-disabled-msg').hide();
            var pivotMsg = '\u26A0 Currently viewing a pivot table. Column changes here, Freeze included, configure the breakdown tables a pivot cell opens.';
            if ($('#pivotBtn').is(':visible')) {
                // The pivot's own frozen columns are the builder's "Frozen" setting -
                // a part of the pivot itself, so it stays there (2026-10-01).
                pivotMsg += ' The pivot\'s own layout, its frozen columns included, is set in <a href="#" id="spPivotConfigLink" style="color:var(--brand-text, var(--brand-primary, #336699));">pivot configuration</a>.';
            }
            $('.sp-columns-section .sp-columns-pivot-msg').html('<p style="margin:0 0 8px 0; font-size:12px; color: var(--text-muted); font-style:italic;">' + pivotMsg + '</p>').show();
            $('.sp-columns-section .sp-column-search-row, .sp-columns-section .sp-column-container').show();
            $('.sp-actions').show();
        } else {
            $('.sp-columns-section .sp-columns-pivot-msg').hide();
            $('.sp-columns-section .sp-columns-disabled-msg').hide();
            $('.sp-columns-section .sp-column-search-row, .sp-columns-section .sp-column-container').show();
            $('.sp-actions').show();
        }

        // Show admin note only when Column Organization is disabled in View Options
        $('#spColumnsAdminNote').toggle(!$('#viewOptionColumns').is(':checked'));
        // The note is the legend for the section's amber ring, so paint the ring
        // from the same shared pass on every open. No-op for non-admins.
        penumbraRefreshUserHiddenMarkers();

        // Display Preferences group: honor a manual pin, else auto-collapse
        // on short viewports so the column list keeps usable height
        _spPrefsSyncToViewport();

        // Show panel (handle is inside panel, inherits slide via parent)
        $('#settingsPanel').addClass('is-open');
        $('#settingsPanelOverlay').addClass('is-open');

        // Freeze control + the frozen-row markers. After is-open on purpose:
        // the sync stands down while the panel is shut.
        _spSyncFreezeControl();
    }

    function closeSettingsPanel() {
        // The summary-type popover is hosted on <body>, not inside the panel, so
        // it does not slide away with it - drop it explicitly or it is left
        // floating over the report.
        _spCloseSummaryMenu();
        $('#settingsPanel').removeClass('is-open');
        $('#settingsPanelOverlay').removeClass('is-open');
    }

    // Link from column settings pivot blurb to the pivot configuration lightbox
    $(document).on('click', '#spPivotConfigLink', function (e) {
        e.preventDefault();
        closeSettingsPanel();
        $('#pivotBtn').trigger('click');
    });

    // --- Display Preferences collapse ---------------------------------
    // The theme/density/toggle group collapses to a single header row so
    // the column list (flex: 1) can take the freed height. Clicking the
    // header pins the choice for this page load; the pin drops once the
    // viewport crosses the short threshold in either direction, where the
    // group auto-collapses (and auto-restores) on its own.
    var SP_PREFS_SHORT_VIEWPORT_PX = 700;
    var _spPrefsUserChoice = null;      // null = automatic; true/false = pinned collapsed/expanded
    var _spPrefsChoiceWasShort = false; // viewport regime when the pin was set
    var _spPrefsResizeTimer = null;

    function _spPrefsShortViewport() { return window.innerHeight < SP_PREFS_SHORT_VIEWPORT_PX; }

    // Collapsed header shows the effective theme/density at a glance.
    // 'my-default'/'report-default' resolve through the same fallbacks the
    // dropdowns use, so the summary names the theme actually in effect.
    function _spUpdatePrefsSummary() {
        var themeSel = $('#spThemeSelector').val();
        var themeId = (themeSel === 'my-default') ? (getGlobalTheme() || currentReportTheme)
                    : (themeSel && themeSel !== 'report-default') ? themeSel : currentReportTheme;
        var densitySel = $('#spDensitySelector').val();
        var densityId = (densitySel === 'my-default') ? (getGlobalDensity() || currentReportDensity)
                      : (densitySel && densitySel !== 'report-default') ? densitySel : currentReportDensity;
        $('#spPrefsSummary').text((_spThemeLabels[themeId] || 'Default Light') + ' · ' + (_spDensityLabels[densityId] || 'Standard'));
    }

    function _spRenderPrefsCollapse() {
        var $group = $('#spPrefsGroup');
        if (!$group.length) return;
        var collapsed = _spPrefsUserChoice !== null ? _spPrefsUserChoice : _spPrefsShortViewport();
        $group.toggleClass('is-collapsed', collapsed);
        $('#spPrefsToggle').attr('aria-expanded', String(!collapsed));
        if (collapsed) _spUpdatePrefsSummary();
    }

    function _spPrefsSyncToViewport() {
        if (_spPrefsUserChoice !== null && _spPrefsShortViewport() !== _spPrefsChoiceWasShort) {
            _spPrefsUserChoice = null;
        }
        _spRenderPrefsCollapse();
    }

    $('#spPrefsToggle').on('click', function () {
        _spPrefsUserChoice = !$('#spPrefsGroup').hasClass('is-collapsed');
        _spPrefsChoiceWasShort = _spPrefsShortViewport();
        _spRenderPrefsCollapse();
    });

    $(window).on('resize.spPrefsCollapse', function () {
        clearTimeout(_spPrefsResizeTimer);
        _spPrefsResizeTimer = setTimeout(_spPrefsSyncToViewport, 120);
    });

    // The inner HTML of one column row in the settings panel.
    //
    // SINGLE SOURCE for the row markup: populateSettingsColumns() builds the list
    // from the live table, resetPanelState() rebuilds it from spInitialState, and
    // the two used to carry hand-copied copies of this string - so a control added
    // to one silently vanished on Reset. Both call this instead.
    //
    // summaryType: a PENUMBRA_SUMMARY_TYPES key, or null for "not summarized".
    // The '#' row-number column can never be summarized, so it gets a spacer that
    // keeps its checkboxes aligned with every row below it.
    function _spColumnRowHtml(displayName, isVisible, summaryType, isFixed, formulaText) {
        var html = '<span class="sp-drag-grip"' + (isFixed ? ' style="visibility:hidden"' : '') + '>&#9776;</span>' +
                   '<input type="checkbox" class="sp-col-check" title="Show this column in the table"' +
                   (isVisible ? ' checked' : '') + '>';
        if (isFixed) {
            // The '#' column can never carry a summary of its own - it is where
            // the KEYWORD lands. A disabled checkbox (rather than a blank
            // spacer) keeps the column of boxes unbroken, and ticking it when
            // any summary exists tells the user that something will appear in
            // this cell. State is refreshed by _spSyncSummaryIndicator().
            html += '<input type="checkbox" class="sp-col-sum-ghost" disabled' +
                    ' title="The summary keyword (TOTALS / AVERAGES / SUMMARY) appears in this column.' +
                    ' Ticked whenever at least one column below is summarized.">';
        } else {
            html += '<input type="checkbox" class="sp-col-sum" title="Summarize this column in the footer row"' +
                    (summaryType ? ' checked' : '') + '>';
        }
        // title = the full name, always. .sp-col-name ellipsizes, and a summarized
        // column hands ~48px of this cell to its type chip, so a long name can
        // truncate with nothing to reveal it. Set unconditionally rather than
        // measuring: scrollWidth is meaningless until the row is laid out, and
        // the truncation point moves with the panel width and the chip.
        html += '<span class="sp-col-name" title="' + escapeHtml(displayName) + '">' +
                escapeHtml(displayName) + '</span>';
        if (!isFixed) {
            var def = summaryType ? penumbraSummaryDef(summaryType) : null;
            html += '<button type="button" class="sp-col-sumtype" tabindex="0"' +
                    (summaryType ? '' : ' style="display:none"') +
                    ' data-type="' + escapeHtml(summaryType || '') + '"' +
                    ' title="' + escapeHtml(def ? def.label + ' - click to change' : 'Choose summary type') + '">' +
                    escapeHtml(def ? def.badge : '') + '</button>';
            // Minimal formula editor: a plain text field that appears only for
            // the 'formula' type. No live validation UI by design - an invalid
            // expression simply renders an empty summary cell, and the field
            // carries the variable list in its placeholder and tooltip.
            // Callers pass the text (_spFormulaBoxText); the fallback is the
            // SAVED expression, never a badge preview.
            var _fx = (formulaText !== undefined && formulaText !== null)
                ? formulaText
                : penumbraResolveSummaryFormulaPersisted(displayName);
            html += '<input type="text" class="sp-col-formula" spellcheck="false"' +
                    (summaryType === 'formula' ? '' : ' style="display:none"') +
                    ' value="' + escapeHtml(_fx) + '"' +
                    ' placeholder="{sum}/{count}"' +
                    ' title="Formula over this column&#39;s own values. Available: ' +
                    escapeHtml(PENUMBRA_FORMULA_VARS.join(', ')) +
                    '. Supports + - * / and parentheses. For maths across DIFFERENT columns, use a snippet instead.">';
        }
        return html;
    }

    // What a column row's formula box starts with. A column SAVED as Custom
    // Formula shows the box, holding the saved expression - the panel shows what
    // is saved, never a badge preview. Any other column keeps the box hidden,
    // starting from the expression in effect on screen: a formula tried out on a
    // footer badge is then already filled in when the user picks Custom Formula
    // here to keep it. (The pending-change snapshot reads the box only while the
    // type is formula, so the hidden text alone never counts as a change.)
    function _spFormulaBoxText(colName, savedType) {
        return (savedType === 'formula')
            ? penumbraResolveSummaryFormulaPersisted(colName)
            : penumbraResolveSummaryFormula(colName);
    }

    // Sticky legend so the two checkbox columns are identifiable. Lives INSIDE
    // #spColumnList (so it lines up with the rows regardless of the move-button
    // gutter) but is deliberately NOT a .sp-col-item, which is what every
    // selector in this panel keys on.
    // One header cell that sorts. Renders the app's standard .sort-icon so the
    // lane advertises itself as sortable at rest exactly like a table column
    // header does: the stacked pair when nothing is sorted by it, a single
    // triangle when it owns the sort. Direction and state are painted by
    // _spRenderSortIcons(); this only builds the resting markup.
    // `rest` is what the icon shows when this lane is NOT the one sorting.
    // Default is the app's stacked pair, the same "you can sort me" cue a report
    // column header gives. A lane can override it with a glyph that also carries
    // meaning - the summary lane does, because 13px cannot hold a legend AND a
    // stacked pair (measured: 17.1px of content in a 13px box, which shoves the
    // glyph off the checkbox column it is supposed to label). That lane shows its
    // legend at rest and a single triangle while it sorts.
    function _spSortHeaderHtml(key, cls, label, tip, rest) {
        rest = rest || '&#9650;&#9660;';
        return '<button type="button" class="sph ' + cls + '" data-sort="' + key + '"' +
               ' data-rest="' + rest + '"' +
               ' title="' + escapeHtml(tip) + '" aria-label="' + escapeHtml(tip) + '">' +
               label +
               '<span class="sort-icon" aria-hidden="true">' + rest + '</span></button>';
    }

    function _spColumnHeadingHtml() {
        var on = penumbraSummaryBadgesOn();
        return '<div class="sp-col-head is-sortable">' +
               // The grip lane's header was an invisible spacer. It now carries the
               // DB-order sort, which is the one sort that belongs to this lane:
               // the grips reorder the list, and data-column IS the DB ordinal.
               _spSortHeaderHtml('db', 'sph-lane sph-grip', '',
                   'Sort by database order') +
               // Master visibility box, sitting directly over the column of boxes
               // it governs. This is the old "select all" / "select none" pair as
               // one control, in the place every data table puts it.
               // _spSyncSummaryIndicator() keeps it checked/indeterminate.
               '<input type="checkbox" class="sp-col-master" data-master="vis"' +
               ' title="Show: check or uncheck every column"' +
               ' aria-label="Show: check or uncheck every column">' +
               // The summary lane sorts rather than bulk-toggling: there is no
               // sensible "summarize everything" (each column would need a TYPE
               // chosen for it, and that reaches exports, PDF and scheduled mail).
               // Grouping the summarized columns together is the useful action.
               // The Sigma IS this lane's resting icon, so it stays the legend for
               // the checkbox column beneath it while still being the sort target.
               _spSortHeaderHtml('sum', 'sph-lane', '',
                   'Sort by summarized columns', '&#931;') +
               _spSortHeaderHtml('name', 'sph-name', 'Column',
                   'Sort alphabetically') +
               // The label names the ACTION, not the state - "Hide badges" means
               // clicking hides them - and the bare verb was ambiguous about WHAT
               // it acts on, hence the noun. No aria-pressed: this is a command
               // button whose label changes, not an ARIA toggle, so "Hide,
               // pressed" would be actively misleading.
               //
               // #spHideUnchecked used to work the same way and no longer does:
               // it became an icon button in the search row (2026-09-10), so its
               // state moved onto aria-pressed and a fill while its name stayed
               // put. A glyph cannot carry a changing label; this chip can.
               //
               // Hidden entirely until at least one column is summarized (see
               // _spSyncSummaryIndicator) - with no summaries there are no badges
               // to govern, and offering it would just be a dead control.
               '<button type="button" id="spBadgeToggle" class="sp-colh-badge" style="display:none"' +
               ' title="Type badges (SUM, AVG, ...) next to each summary value are currently ' +
               (on ? 'shown' : 'hidden') + '. Click to ' + (on ? 'hide' : 'show') +
               ' them everywhere - table, exports, PDF and scheduled email.">' +
               (on ? 'Hide badges' : 'Show badges') + '</button>' +
               '</div>';
    }

    // Keeps the two summary-dependent bits of chrome in step with the list:
    //   - the '#' row's disabled indicator, ticked whenever any column below is
    //     summarized, so the keyword cell is visibly accounted for;
    //   - the badge show/hide chip, which is hidden outright when nothing is
    //     summarized - with no summaries there are no badges for it to govern,
    //     and offering it would just be a dead control.
    // Called from updateApplyResetState(), so it re-runs after populate, reset,
    // every checkbox change and every move/drag.
    function _spSyncSummaryIndicator() {
        var any = $('#spColumnList .sp-col-item .sp-col-sum:checked').length > 0;
        $('#spColumnList .sp-col-sum-ghost').prop('checked', any);
        $('#spBadgeToggle').toggle(any);

        // Master visibility box in the header. Three states, like any select-all:
        // checked when every column is shown, indeterminate when only some are,
        // clear when none. indeterminate is a PROPERTY, not an attribute, so it
        // has to be set here and cannot ride in the header markup.
        var $checks = $('#spColumnList .sp-col-check');
        var total = $checks.length;
        var shown = $checks.filter(':checked').length;
        $('#spColumnList .sp-col-master[data-master="vis"]')
            .prop('checked', total > 0 && shown === total)
            .prop('indeterminate', shown > 0 && shown < total);
    }

    function populateSettingsColumns() {
        var $list = $('#spColumnList').empty();
        var headerCount = $('#tableHeader th').length;

        if (headerCount === 0) {
            $list.html('<div class="sp-col-empty">Load a report to manage columns.</div>');
            $('#spApply, #spReset').prop('disabled', true);
            return;
        }

        $list.append(_spColumnHeadingHtml());

        // '#' row number column - first item, NOT draggable
        var $numTh = $('#tableHeader th[data-column="#"]');
        if ($numTh.length) {
            var isNumVisible = $numTh[0].style.display !== 'none';
            var $numItem = $('<div class="sp-col-item sp-col-fixed">')
                .attr('data-column', '#')
                .attr('data-colname', '#')
                .html(_spColumnRowHtml('# (Row Number)', isNumVisible, null, true));
            $list.append($numItem);
        }

        // Data columns in CURRENT DISPLAY ORDER from table header
        $('#tableHeader th[data-colname]').each(function() {
            var colId = String($(this).data('column'));
            var colName = $(this).data('colname');
            if (colId === '#' || colName === '#') return;
            var isVisible = this.style.display !== 'none';
            // Effective type = user override > report default > global whitelist,
            // so the box opens already ticked for the columns that are (and always
            // were) totalled.
            var props = ($("#resultsTable").data('columnProperties') || {})[colId];
            // Persisted resolution: the panel is the SAVING surface, so it must
            // never show (and therefore never re-save) a transient badge pick.
            var sumType = penumbraResolveSummaryPersisted(colName, props);
            // data-colname stays the raw sentinel (the key for reorder / visibility
            // / summary resolution); only the VISIBLE name is friendly-ified so a
            // journal column reads "Done"/"Notes" instead of __JOURNAL_TOGGLE__done.
            var colDisplay = (window.Penumbra && window.Penumbra.journalFriendlyCol && window.Penumbra.journalFriendlyCol(colName)) || colName;
            var $item = $('<div class="sp-col-item" draggable="true">')
                .attr('data-column', colId)
                .attr('data-colname', colName)
                // The formula text is looked up by the raw name too - the
                // friendly journal name is display-only.
                .html(_spColumnRowHtml(colDisplay, isVisible, sumType, false, _spFormulaBoxText(colName, sumType)));
            $list.append($item);
        });

        // Snapshot initial state (reflects what's currently in the table) so
        // Reset and the 'current' sort return to this order.
        spInitialState = snapshotPanelState();

        // Sort is a one-shot view action: every open starts at 'current'
        // (the list is already in table order), so opening the panel never
        // creates a pending change by itself.
        spColumnSort = 'current';
        // The header lanes are part of that one-shot reset: drop both carets back
        // to the stacked neutral pair. Populate and reset rebuild the header
        // anyway, so the repaint only really matters after an apply, which keeps
        // the existing list DOM.
        spSortKey = null;
        spSortDir = 1;
        _spRenderSortIcons();
        updateApplyResetState();
    }

    // --- Column-list sort (Settings panel) ---
    // Sort selection is a one-shot view action per panel open — intentionally
    // NOT persisted. A sticky sort silently rearranged saved reports on open,
    // registering phantom pending changes before the user touched anything.
    var spColumnSort = 'current';
    // Which header owns the caret, and which way. spSortKey null is the neutral
    // state, and neutral IS 'current' - the table's own order - so the three-way
    // cycle needs no extra mode to return to.
    var spSortKey = null;
    var spSortDir = 1;
    // Retire the persisted preference written by older builds
    localStorage.removeItem('penumbra_sp_column_sort');

    function getCurrentColumnSort() {
        return spColumnSort;
    }

    function setCurrentColumnSort(sortId) {
        spColumnSort = sortId;
    }

    function applyColumnSort(sortId) {
        var $list = $('#spColumnList');
        var $items = $list.children('.sp-col-item').not('.sp-col-fixed');
        if ($items.length < 2) return;

        // 'current' = the table's order, captured in spInitialState at
        // populate/apply time
        var currentRank = {};
        if (sortId === 'current') {
            if (!spInitialState) return;
            spInitialState.forEach(function(item, i) { currentRank[item.colId] = i; });
        }

        // Summarized-or-not is a boolean, so it only ever groups: every tie falls
        // through to 0 and Array.prototype.sort's stability leaves those rows in
        // the order they were already in. 'sum-asc' deliberately means SUMMARIZED
        // FIRST - the up-triangle reads as "these float to the top", which is the
        // useful direction - rather than the false-before-true a literal ascending
        // sort would give.
        function summarized(el) {
            var box = el.querySelector('.sp-col-sum');
            return (box && box.checked) ? 1 : 0;
        }

        var items = $items.get();
        items.sort(function(a, b) {
            switch (sortId) {
                case 'current':
                    return (currentRank[a.getAttribute('data-column')] || 0) -
                           (currentRank[b.getAttribute('data-column')] || 0);
                case 'sum-asc':
                    return summarized(b) - summarized(a);
                case 'sum-desc':
                    return summarized(a) - summarized(b);
                case 'db-desc':
                    return parseInt(b.getAttribute('data-column'), 10) -
                           parseInt(a.getAttribute('data-column'), 10);
                case 'name-asc':
                    return String(a.getAttribute('data-colname'))
                           .localeCompare(String(b.getAttribute('data-colname')));
                case 'name-desc':
                    return String(b.getAttribute('data-colname'))
                           .localeCompare(String(a.getAttribute('data-colname')));
                case 'db-asc':
                default:
                    return parseInt(a.getAttribute('data-column'), 10) -
                           parseInt(b.getAttribute('data-column'), 10);
            }
        });

        // Re-append in sorted order. Fixed items stay where they are (always at top).
        var listEl = $list[0];
        items.forEach(function(el) { listEl.appendChild(el); });
    }

    // Resolve the two header variables to one of the ids applyColumnSort takes.
    function _spSortIdFromHeader() {
        return spSortKey ? (spSortKey + (spSortDir === 1 ? '-asc' : '-desc')) : 'current';
    }

    // Repaint the lane icons. Reuses the table's own .sort-icon, so an unsorted
    // lane shows the stacked pair (advertising that it is clickable) and the
    // sorting lane shows a single triangle - the same vocabulary the report
    // header uses three feet up the screen.
    function _spRenderSortIcons() {
        $('#spColumnList .sph').each(function() {
            var $h = $(this);
            var owns = !!spSortKey && $h.attr('data-sort') === spSortKey;
            $h.toggleClass('is-sorted', owns);
            $h.find('.sort-icon').html(
                owns ? (spSortDir === 1 ? '&#9650;' : '&#9660;')
                     : ($h.attr('data-rest') || '&#9650;&#9660;')
            );
        });
    }

    // Drop back to neutral. Called whenever something happens that makes the
    // caret a LIE - a manual move or drag, or a summary toggle while the summary
    // lane owns the sort - because the list is then no longer in the order the
    // header claims. Deliberately NOT hung off updateApplyResetState(): that also
    // fires on every visibility checkbox, which changes no sort at all.
    function clearHeaderSort() {
        if (!spSortKey) return;
        spSortKey = null;
        spSortDir = 1;
        setCurrentColumnSort('current');
        _spRenderSortIcons();
    }

    // Three-way cycle: ascending, descending, then back to the table's own order.
    // That third state is 'current', which the panel already resets to on open,
    // on apply and on reset - so returning to it strands nothing.
    $(document).on('click', '#spColumnList .sph', function(e) {
        e.stopPropagation();
        var key = $(this).attr('data-sort');
        if (spSortKey !== key)    { spSortKey = key;  spSortDir =  1; }
        else if (spSortDir === 1) {                   spSortDir = -1; }
        else                      { spSortKey = null; spSortDir =  1; }

        var sortId = _spSortIdFromHeader();
        setCurrentColumnSort(sortId);
        applyColumnSort(sortId);
        _spRenderSortIcons();
        updateApplyResetState();
    });

    function snapshotPanelState() {
        var state = [];
        $('#spColumnList .sp-col-item').each(function() {
            var $it = $(this);
            // summary: the chosen type, or null when the box is unticked. Part of
            // the snapshot so Reset restores it and the pending-change counter
            // notices a type swap that leaves visibility untouched.
            var $sum = $it.find('.sp-col-sum');
            var sumType = null;
            if ($sum.length && $sum.is(':checked')) {
                sumType = $it.find('.sp-col-sumtype').attr('data-type') || null;
            }
            state.push({
                colId: String($it.data('column')),
                colName: $it.data('colname'),
                visible: $it.find('.sp-col-check').is(':checked'),
                summary: sumType,
                // Snapshotted too, so Reset restores the text and editing a
                // formula registers as a pending change on its own.
                formula: (sumType === 'formula') ? ($it.find('.sp-col-formula').val() || '') : ''
            });
        });
        return state;
    }

    function updateApplyResetState() {
        // Single hook for the '#' indicator: this runs after populate, after
        // reset, on every checkbox change and after every move/drag.
        _spSyncSummaryIndicator();
        // ...which is also every moment the set of "first N checked rows" can
        // change, so the frozen-row markers ride the same hook.
        _spSyncFrozenMarkers();

        var current = snapshotPanelState();
        var changed = false;
        var changeCount = 0;

        if (!spInitialState || current.length !== spInitialState.length) {
            changed = current.length > 0;
        } else {
            for (var i = 0; i < current.length; i++) {
                if (current[i].colId !== spInitialState[i].colId ||
                    current[i].visible !== spInitialState[i].visible ||
                    current[i].summary !== spInitialState[i].summary ||
                    current[i].formula !== spInitialState[i].formula) {
                    changed = true;
                    changeCount++;
                }
            }
        }

        $('#spApply').prop('disabled', !changed);
        $('#spReset').prop('disabled', !changed);
        if (changed && changeCount > 0) {
            $('#spPendingCount').text(changeCount + ' change' + (changeCount !== 1 ? 's' : ''));
        } else {
            $('#spPendingCount').text('');
        }
    }

    function applyColumnChanges() {
        // 1. Read desired state from panel
        var newOrder = [];
        var numItem = null;
        var summaryOverrides = {};
        var formulaOverrides = {};
        var allColProps = $("#resultsTable").data('columnProperties') || {};
        $('#spColumnList .sp-col-item').each(function() {
            var $it = $(this);
            var item = {
                colId: String($it.data('column')),
                visible: $it.find('.sp-col-check').is(':checked')
            };
            if (item.colId === '#') {
                numItem = item;
            } else {
                newOrder.push(item);
                // Summary override, stored by NAME and only where it actually
                // DIFFERS from what this column would inherit. `false` means the
                // user explicitly switched a summary off - that has to be
                // recorded, or the global whitelist would just turn it back on.
                var colName = String($it.attr('data-colname') || '').toUpperCase();
                var $sum = $it.find('.sp-col-sum');
                var chosen = ($sum.length && $sum.is(':checked'))
                    ? ($it.find('.sp-col-sumtype').attr('data-type') || null)
                    : false;
                if (chosen === null) chosen = false;
                var inherited = penumbraInheritedSummaryForName(colName, allColProps[item.colId]) || false;
                if (chosen !== inherited) summaryOverrides[colName] = chosen;
                // Formula text rides in its own map, and only while the column
                // is actually set to 'formula' - so switching a column back to a
                // normal type does not leave orphaned expressions behind.
                if (chosen === 'formula') {
                    var fx = String($it.find('.sp-col-formula').val() || '').trim();
                    if (fx) formulaOverrides[colName] = fx;
                }
            }
        });

        // 2. Ensure at least 1 column visible
        var anyVisible = newOrder.some(function(i) { return i.visible; });
        if (!anyVisible) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> At least one column must be visible.</p>", 3000);
            return;
        }

        // 4. Detach tbody for performance
        var tbody = document.querySelector('#resultsTable tbody');
        if (!tbody) return;
        var parent = tbody.parentNode;
        var nextSibling = tbody.nextSibling;
        parent.removeChild(tbody);

        // 5. Build header map
        var headerRow = document.getElementById('tableHeader');
        var currentHeaders = Array.from(headerRow.children);
        var colIdToHeaderTh = {};
        currentHeaders.forEach(function(th) { colIdToHeaderTh[th.dataset.column] = th; });

        // 6. Reorder headers
        headerRow.innerHTML = '';
        // '#' column always first
        if (colIdToHeaderTh['#']) {
            var numTh = colIdToHeaderTh['#'];
            if (numItem) numTh.style.display = numItem.visible ? '' : 'none';
            headerRow.appendChild(numTh);
        }
        newOrder.forEach(function(item) {
            var th = colIdToHeaderTh[item.colId];
            if (th) {
                th.style.display = item.visible ? '' : 'none';
                headerRow.appendChild(th);
            }
        });

        // 7. Build desired order for cells
        var desiredOrder = ['#'];
        var visibilityMap = {};
        if (numItem) visibilityMap['#'] = numItem.visible;
        newOrder.forEach(function(item) {
            desiredOrder.push(item.colId);
            visibilityMap[item.colId] = item.visible;
        });

        // 8. Reorder + show/hide body cells
        for (var r = 0; r < tbody.rows.length; r++) {
            var row = tbody.rows[r];
            var cellMap = {};
            var cells = Array.from(row.children);
            cells.forEach(function(td) { cellMap[td.dataset.column] = td; });
            desiredOrder.forEach(function(colId) {
                var td = cellMap[colId];
                if (td) {
                    td.style.display = visibilityMap[colId] === false ? 'none' : '';
                    row.appendChild(td);
                }
            });
        }

        // 9. Re-attach tbody
        if (nextSibling) parent.insertBefore(tbody, nextSibling);
        else parent.appendChild(tbody);

        // 9a. Columns just shown whose cells were built EMPTY get their content
        // now - before the grouped rebuild below clones them, and before anything
        // paints or reads them. (2026-09-30) Flat view: the rows on screen (lazy
        // rows); the grouped rebuild below fills every row it clones.
        penumbraFillForView();

        // 9b. Publish the summary overrides BEFORE the re-render below - every
        // footer builder resolves its types from this map, so setting it at the
        // end (where the layout prefs are written) would render one pass with
        // the OLD summaries. The in-memory assignment is what makes the change
        // visible; persistColumnSummaries only carries it across reloads, and
        // no-ops for an ad-hoc query that has no report id to file it under.
        userColumnSummaries = summaryOverrides;
        // Drop any transient badge picks. They OUTRANK the user layer, so
        // leaving them made Apply appear to do nothing: unticking (or retyping) a
        // column the user had just experimented with on a badge left the old
        // summary on screen, and only a page reload could clear it.
        transientColumnSummaries = {};
        transientColumnSummaryFormulas = {};
        userColumnSummaryFormulas = formulaOverrides;
        persistColumnSummaries(summaryOverrides, formulaOverrides);

        // Set when the grouped refresh hands off to a comparison re-render, which
        // finishes ASYNCHRONOUSLY (fadeOut -> setTimeout -> heavy render) and runs
        // its own show/hideLoading. Returned to the caller so it can leave the
        // overlay up instead of hiding it the moment this function returns - that
        // would flash the overlay off and expose the half-rendered diff to clicks.
        var _asyncRerender = false;

        // 10. Skip view-affecting updates when pivot is active - the column
        // changes only affect breakdown tables, not the visible pivot.
        if (!$('#pivot-output-container').is(':visible')) {
            // Update grouped view if visible - full rebuild with new order
            if ($('#groupedResultsContainer').is(':visible')) {
                // A snapshot comparison lives in the same container but is NOT a
                // regular grouped view: it's grouped by the synthetic __SNAP_TYPE
                // column and includes "Removed" rows that exist only in the
                // snapshot, so rebuildGroupedView() - which regroups the LIVE flat
                // rows - can't reconstruct it and would leave the groups showing
                // the old columns. Re-render the diff from its source snapshot(s)
                // instead; both renderers re-read the header we just updated.
                if ($('body').hasClass('snapshot-comparison-active')) {
                    // If the source snapshot(s) somehow aren't tracked, leave the
                    // diff alone rather than letting rebuildGroupedView regroup the
                    // live rows over the top of it.
                    _asyncRerender = _rerunActiveComparison();
                } else {
                    var visibleColumnOrder = $("#tableHeader th").filter(function () {
                        return this.style.display !== 'none';
                    }).map(function () {
                        return $(this).data("column");
                    }).get();
                    rebuildGroupedView(visibleColumnOrder);
                }
            }

            // Post-update
            updateTotalRow();
            updateTableBorders();
            renderReportSnippet();
            if (!$('#groupedResultsContainer').is(':visible')) applyPagination();
            updateFloatingButtonStates();
            toggleNoColumnsMessage();
            if (/\[\s*PROMPT/i.test(editor.getValue())) updatePromptDisplay();
        }

        // 12. Update panel state - the applied order is now the table's
        // current order, so the one-shot sort selection is consumed
        spInitialState = snapshotPanelState();
        spColumnSort = 'current';
        // The header lanes are part of that one-shot reset: drop both carets back
        // to the stacked neutral pair. Populate and reset rebuild the header
        // anyway, so the repaint only really matters after an apply, which keeps
        // the existing list DOM.
        spSortKey = null;
        spSortDir = 1;
        _spRenderSortIcons();
        updateApplyResetState();

        // 13. Save to localStorage per-report
        saveColumnPrefs();
        // Let the status bar re-evaluate the "custom layout" pill immediately
        // (its MutationObserver only watches the result-count nodes, not column
        // visibility, so nudge it explicitly).
        try { document.dispatchEvent(new CustomEvent('penumbra:columns-changed')); } catch (e) {}

        show_text("<p id='undo_text'><span style='color: lightgreen'>SAVED:</span> Column layout saved as a local preference for this report. This will persist across sessions.</p>", 5000);

        // True when a comparison re-render is still in flight (see _asyncRerender).
        return _asyncRerender;
    }

    function resetPanelState() {
        if (!spInitialState) return;
        var $list = $('#spColumnList').empty();

        $list.append(_spColumnHeadingHtml());

        spInitialState.forEach(function(item) {
            var isFixed = item.colId === '#';
            var displayName = isFixed ? '# (Row Number)' : item.colName;
            var $el = $('<div class="sp-col-item' + (isFixed ? ' sp-col-fixed' : '') + '"' +
                         (isFixed ? '' : ' draggable="true"') + '>')
                .attr('data-column', item.colId)
                .attr('data-colname', item.colName)
                // A hidden box snapshots as '' - restore what populate gave it.
                .html(_spColumnRowHtml(displayName, item.visible, item.summary, isFixed,
                    (isFixed || item.summary === 'formula') ? item.formula : _spFormulaBoxText(item.colName, item.summary)));
            $list.append($el);
        });

        spColumnSort = 'current';
        // The header lanes are part of that one-shot reset: drop both carets back
        // to the stacked neutral pair. Populate and reset rebuild the header
        // anyway, so the repaint only really matters after an apply, which keeps
        // the existing list DOM.
        spSortKey = null;
        spSortDir = 1;
        _spRenderSortIcons();
        updateApplyResetState();
        $('#spColumnSearch').val('');
        $('#spClearSearch').hide();
    }

    // Write ONLY the per-column summary overrides, leaving the layout keys alone.
    // Kept separate from saveColumnPrefs() because the two are written at
    // different points in applyColumnChanges(): summaries must land before the
    // footers re-render, the layout after.
    // An empty map deletes the key entirely, so "reset everything back to the
    // report's defaults" leaves no residue behind.
    function persistColumnSummaries(map, formulas) {
        if (!currentLoadedStateName) return;
        var prefs = _spPrefMap('penumbra_column_prefs');
        var entry = prefs[currentLoadedStateName] || {};
        if (map && Object.keys(map).length > 0) entry.summaries = map;
        else delete entry.summaries;
        if (formulas && Object.keys(formulas).length > 0) entry.summaryFormulas = formulas;
        else delete entry.summaryFormulas;
        prefs[currentLoadedStateName] = entry;
        localStorage.setItem('penumbra_column_prefs', JSON.stringify(prefs));
    }

    // The badge SHOW toggle, stored beside the summaries. Only written when it
    // DIFFERS from what the report says, so a viewer who agrees with the report
    // keeps following it if the author later changes their mind.
    function persistSummaryBadgePref(on) {
        if (!currentLoadedStateName) return;
        var prefs = _spPrefMap('penumbra_column_prefs');
        var entry = prefs[currentLoadedStateName] || {};
        if (on === (reportSummaryBadges !== false)) delete entry.summaryBadges;
        else entry.summaryBadges = on;
        prefs[currentLoadedStateName] = entry;
        localStorage.setItem('penumbra_column_prefs', JSON.stringify(prefs));
    }

    // The frozen-column count, stored beside the layout keys under the same
    // rule as the badge toggle: only while it DIFFERS from the report's own
    // count, so a viewer who agrees with the report keeps following it if the
    // author later changes it. No-op for an ad-hoc query - there is no report
    // id to file it under, and the in-memory value still lasts the session.
    function persistFrozenColsPref(n) {
        if (!currentLoadedStateName) return;
        var prefs = _spPrefMap('penumbra_column_prefs');
        var entry = prefs[currentLoadedStateName] || {};
        if (n === reportFrozenCols) delete entry.frozen;
        else entry.frozen = n;
        if (Object.keys(entry).length === 0) delete prefs[currentLoadedStateName];
        else prefs[currentLoadedStateName] = entry;
        localStorage.setItem('penumbra_column_prefs', JSON.stringify(prefs));
    }

    function saveColumnPrefs() {
        if (!currentLoadedStateName) return;
        var prefs = _spPrefMap('penumbra_column_prefs');
        // Use style.display !== 'none' instead of :visible
        // jQuery :visible returns false when ANY ancestor is hidden (e.g. #resultsTable hidden in grouped/pivot mode)
        // but we set style.display directly on each th, so checking it is reliable
        var savedData = {
            order: $('#tableHeader th[data-colname]').map(function() {
                return $(this).attr('data-colname');
            }).get(),
            visible: $('#tableHeader th[data-colname]').filter(function() {
                return this.style.display !== 'none';
            }).map(function() {
                return $(this).attr('data-colname');
            }).get(),
            isNumVisible: (function() {
                var numTh = document.querySelector('#tableHeader th[data-column="#"]');
                return numTh ? numTh.style.display !== 'none' : false;
            })()
        };
        // Carry the NON-LAYOUT keys across. This function REPLACES the whole
        // per-report entry, so without this it silently dropped the summaries
        // persistColumnSummaries() wrote moments earlier in the same apply pass -
        // and dropped the badge SHOW preference entirely, so badges switched
        // themselves back on the next time anyone saved a column layout.
        var existing = prefs[currentLoadedStateName];
        if (existing && existing.summaries) savedData.summaries = existing.summaries;
        if (existing && typeof existing.summaryBadges === 'boolean') savedData.summaryBadges = existing.summaryBadges;
        if (existing && existing.summaryFormulas) savedData.summaryFormulas = existing.summaryFormulas;
        // ...and the frozen-column count, which is set from its own control and
        // not by this Apply pass.
        if (existing && typeof existing.frozen === 'number') savedData.frozen = existing.frozen;
        // ...and the column widths, which the header grips set, not this pass.
        if (existing && existing.widths && typeof existing.widths === 'object') savedData.widths = existing.widths;
        prefs[currentLoadedStateName] = savedData;
        localStorage.setItem('penumbra_column_prefs', JSON.stringify(prefs));
    }

    function loadColumnPrefs() {
        if (!currentLoadedStateName) return null;
        // If admin has disabled column customization, ignore saved prefs for non-admins
        if (!penumbra_vars.isAdmin && window._penumbraHideColumns) return null;
        var prefs = _spPrefMap('penumbra_column_prefs');
        return prefs[currentLoadedStateName] || null;
    }

    // The same entry, but ONLY when it actually carries a column LAYOUT.
    //
    // penumbra_column_prefs[report] now also holds non-layout keys (summaries,
    // summaryBadges), and those can exist on their own - toggling badges writes
    // an entry with no `order` at all. The layout-override block treats a
    // truthy entry as "the user has a saved layout" and rebuilds visibility from
    // its (absent) fields, which silently HID the '#' column via the
    // `isNumVisible` branch and suppressed the report's own saved column order.
    // Layout consumers must use this; summary consumers use loadColumnPrefs().
    function loadColumnLayoutPrefs() {
        var p = loadColumnPrefs();
        return (p && Array.isArray(p.order) && p.order.length > 0) ? p : null;
    }

    // Snapshot the current flat table's column layout BY NAME (order + which are
    // visible). Same shape as saveColumnPrefs()'s savedData, but not tied to a
    // saved report - used to remember the live column view before a snapshot is
    // loaded so restoreOriginalData() can put it back (rebuildTableFromMasterData()
    // otherwise renders every column in raw query order). Returns null if no table.
    function captureColumnLayoutByName() {
        var $ths = $('#tableHeader th[data-colname]');
        if (!$ths.length) return null;
        var numTh = document.querySelector('#tableHeader th[data-column="#"]');
        return {
            order: $ths.map(function () { return $(this).attr('data-colname'); }).get(),
            visible: $ths.filter(function () { return this.style.display !== 'none'; })
                         .map(function () { return $(this).attr('data-colname'); }).get(),
            isNumVisible: numTh ? numTh.style.display !== 'none' : true
        };
    }

    // Reapply a layout captured by captureColumnLayoutByName() to the CURRENT
    // (freshly rebuilt) flat table, matching by column NAME (colIds are positional
    // and change every rebuild). Reorders + shows/hides the header and every body
    // cell, mirroring applyColumnChanges(). Any column not in the saved layout
    // (e.g. a new computed column) is appended visible so nothing is dropped.
    function applyColumnLayoutByName(layout) {
        if (!layout || !Array.isArray(layout.order)) return;
        var headerRow = document.getElementById('tableHeader');
        if (!headerRow) return;

        var nameToTh = {};
        Array.prototype.forEach.call(headerRow.children, function (th) {
            var nm = th.getAttribute('data-colname');
            if (nm) nameToTh[nm.toUpperCase()] = th;
        });
        var numTh = headerRow.querySelector('th[data-column="#"]');
        var visibleSet = {};
        (layout.visible || []).forEach(function (nm) { visibleSet[String(nm).toUpperCase()] = true; });

        var tbody = document.querySelector('#resultsTable tbody');
        var parent = tbody ? tbody.parentNode : null;
        var nextSibling = tbody ? tbody.nextSibling : null;
        if (tbody) parent.removeChild(tbody); // detach for reorder perf

        // Detached th references survive innerHTML='' and are re-appended in order.
        headerRow.innerHTML = '';
        var desiredColIds = [];
        var visibilityByColId = {};
        var appended = {};

        if (numTh) {
            var numVis = layout.isNumVisible !== false;
            numTh.style.display = numVis ? '' : 'none';
            headerRow.appendChild(numTh);
            var numCid = numTh.getAttribute('data-column');
            desiredColIds.push(numCid); visibilityByColId[numCid] = numVis; appended[numCid] = true;
        }
        layout.order.forEach(function (nm) {
            var th = nameToTh[String(nm).toUpperCase()];
            if (!th) return;
            var cid = th.getAttribute('data-column');
            if (appended[cid]) return;
            var vis = !!visibleSet[String(nm).toUpperCase()];
            th.style.display = vis ? '' : 'none';
            headerRow.appendChild(th);
            desiredColIds.push(cid); visibilityByColId[cid] = vis; appended[cid] = true;
        });
        // Safety: append any column present now but absent from the saved layout.
        Object.keys(nameToTh).forEach(function (upperNm) {
            var th = nameToTh[upperNm];
            var cid = th.getAttribute('data-column');
            if (appended[cid]) return;
            th.style.display = '';
            headerRow.appendChild(th);
