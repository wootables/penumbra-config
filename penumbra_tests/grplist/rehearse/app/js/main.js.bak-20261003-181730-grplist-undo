    // Pin/unpin a LOCAL snapshot. Entirely browser machinery (vs the server's
    // PINNED_BY column): the flag lives on the stored object - `pinnedAt`
    // (epoch ms) marks it pinned, `pinnedReportId` remembers the report's
    // short id so the home card's ?id=X&snap=local|ts deep link can resolve
    // later from the home screen, where no report is open. A local pin is a
    // SELF-guard (Delete disabled in this browser until unpinned) plus a
    // home-card entry; there is no cross-user protection or rotation to
    // exempt for locals. Returns the updated stored object, or null.
    function _setLocalSnapshotPinned(tsKey, pinned) {
        var snapshots = _getLocalSnapshots();
        var ts = parseInt(tsKey, 10);
        var hit = null;
        for (var i = 0; i < snapshots.length; i++) {
            if (snapshots[i].timestamp === ts) { hit = snapshots[i]; break; }
        }
        if (!hit) return null;
        if (pinned) {
            hit.pinnedAt = Date.now();
            // Prefer the snapshot's OWN source report (stamped at creation):
            // the manager lists every local snapshot regardless of which
            // report is open, so the current URL id may be a DIFFERENT report
            // (pinning B's snapshot while viewing A must not link it to A).
            // Current-id fallback covers legacy snaps that predate the stamp.
            var _pinRid = hit.reportShortId || (new URLSearchParams(window.location.search).get('id') || '');
