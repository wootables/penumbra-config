    // ════════════════════════════════════════════════════════════════════
    //  AUTO-BUILD (2026-08-28)
    //  Successor to the "Chart This Pivot" button that used to live in the
    //  report header. That button only appeared on the pivot view and only
    //  knew how to read a pivot, so the same "just show me something" need
    //  went unmet on a grouped or plain report - the two layouts a new user is
    //  far more likely to be looking at. #vizAutoBuildBtn lives in the
    //  builder's own bar instead and reads WHICHEVER layout is on screen, so
    //  there is always a one-click way to get a real chart up and then tweak
    //  it while looking at something rather than at an empty form.
    //
    //  Three readers, one applier. Each reader returns the same shape as
    //  pivotToVizConfig - { config, warnings[] } plus optional sortBy/sortDir
    //  - so _vizApplyAutoConfig never needs to know which one produced it.
    // ════════════════════════════════════════════════════════════════════

    // Which layout the button would read right now. Never returns null: a flat
    // report is always chartable, which is the whole point of the rewrite.
    function _vizAutoSource() {
        if ($('#pivot-output-container').is(':visible') && _lastPivotChart) {
            return {
                kind: 'pivot', noun: 'pivot',
                tip: 'Fill the builder in from the pivot on screen - its row field becomes the X axis, its column field the series, and its measure the Y axis. Adjust anything afterwards.'
            };
        }
        // __SNAP_TYPE is the synthetic column a snapshot comparison groups by; it
        // is not a real column, so charting it would plot New/Removed/Unchanged.
        if (currentGroupingColumn && currentGroupingColumn !== '__SNAP_TYPE'
            && $('#groupedResultsContainer').is(':visible')) {
            return {
                kind: 'groups', noun: 'groups',
                tip: 'Fill the builder in from the grouping on screen - the outer group column becomes the X axis, a second level becomes the series, and the per-group summary becomes the Y axis. Adjust anything afterwards.'
            };
        }
        return {
            kind: 'report', noun: 'report',
            tip: 'Fill the builder in from the table on screen - the text column that groups best becomes the X axis and the money or number column the Y axis; a date-only table charts activity per period and a single row becomes a gauge. Adjust anything afterwards.'
        };
    }

    // Relabel the button for the layout currently behind the dialog. Called on
    // every builder open, so it can never advertise a pivot that has since been
    // dismissed.
    function vizSyncAutoBuildBtn() {
        var src = _vizAutoSource();
        var $b = $('#vizAutoBuildBtn');
        if (!$b.length) return;
        $b.html('&#x1F4CA; Auto-build from ' + src.noun).attr('title', src.tip).data('autoKind', src.kind);
    }

    // columnProperties for a column NAME, tolerating both casings the two load
    // paths write (see getColumnTypeGlyph for why that is necessary).
    function _vizPropsForCol(colName) {
        if (!colName) return null;
