    // The width to reason about when choosing a DEFAULT height: how wide this
    // report is, i.e. how much room a full-width chart has.
    //
    // Deliberately NOT penumbraVizBaseWidth('#reportSnippetOutput'), which is
    // what resolves a live 100% width at RENDER time. That element is empty
    // while the builder is open, so it collapses (measured 220px on a 1350px
    // screen) and every type came out pinned to its clamp floor. The header
    // container is the stable measure of the report's usable width.
    function _vizDefaultBaseWidth() {
        var w = 0;
        try {
            var $h = $('#reportHeaderContainer');
            if ($h.length) w = $h.width() || 0;
            if (!w) { var $t = $('#resultsTable'); if ($t.length) w = $t.width() || 0; }
