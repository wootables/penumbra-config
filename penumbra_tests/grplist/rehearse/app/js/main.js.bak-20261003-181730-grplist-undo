    /**
     * Converts a raw cell value (potentially `@@JSON…`, `@@HTML…`, or a
     * server-escaped plain string) into clean plain text suitable for a
     * `title` attribute / tooltip.
     *
     * Without this:
     *   - `Joe &amp; Jane` shows literal "&amp;" in the tooltip because the
     *     server already entity-encoded the cell, then escapeHtml double-encoded.
     *   - `@@HTML<a href="…">label</a>` shows the raw markup.
     *   - `@@JSON{"a":1}` shows the literal JSON string instead of a readable
     *     key/value list.
     *
     * Strategy:
     *   1. If `@@JSON` prefix → parse and flatten into "key: value" lines.
     *   2. Else strip `@@HTML` prefix.
     *   3. Strip any remaining HTML tags (anchors, spans, etc.).
     *   4. Decode HTML entities so `&amp;` → `&`, `&nbsp;` → ` ` etc.
     *   5. Collapse runs of whitespace.
     *
     * @param {*} rawValue
     * @returns {string} plain-text representation, or "(empty)" placeholder.
     */
    function _cleanCellForTitle(rawValue) {
        if (rawValue == null) return '(empty)';
        var s = String(rawValue);
        if (s === '') return '(empty)';

        // 1. @@JSON path - beautify into newline-separated "key: value" pairs.
        var jsonIdx = s.indexOf('@@JSON');
        if (jsonIdx !== -1) {
            var jsonStr = s.substring(jsonIdx + 6);
            try {
                var parsed = JSON.parse(jsonStr);
                var beautified = _flattenJsonForTitle(parsed, 0);
                if (beautified) return beautified;
            } catch (e) {
                // fall through - the raw text below will still be cleaned up
                s = jsonStr;
            }
        }

        // 2. @@HTML prefix - drop the marker.
        var htmlIdx = s.indexOf('@@HTML');
        if (htmlIdx !== -1) s = s.substring(htmlIdx + 6);

        // 3. Strip HTML tags (anchors, spans, divs, etc).
        s = s.replace(/<[^>]+>/g, '');

        // 4. Decode HTML entities. Using a textarea is the standard idiom that
        //    handles &amp;, &lt;, &gt;, &nbsp;, numeric entities, and named ones.
        var ta = document.createElement('textarea');
        ta.innerHTML = s;
        s = ta.value;

        // 5. Normalize whitespace - collapse multi-line/multi-space runs into
        //    a single space (titles render multi-line anyway, but the source
        //    often has stray indentation from sanitized HTML).
        s = s.replace(/\s+/g, ' ').trim();

        return s === '' ? '(empty)' : s;
    }

    /**
     * Recursively flattens a JSON value into plain-text "indent key: value"
     * lines for the modified-row tooltip. Arrays of scalars get joined inline;
     * arrays of objects render each element on its own block.
     */
    function _flattenJsonForTitle(val, depth) {
        if (val === null || val === undefined) return '(null)';
        if (typeof val !== 'object') {
            return String(val);
        }
        var indent = '  '.repeat(depth);
        if (Array.isArray(val)) {
            if (val.length === 0) return '[]';
            // Scalar array - inline
            if (val.every(function (v) { return v === null || typeof v !== 'object'; })) {
                return val.map(function (v) { return v == null ? '(null)' : String(v); }).join(', ');
            }
            // Object array - block per entry
            return val.map(function (v, i) {
                return indent + '[' + i + ']\n' + _flattenJsonForTitle(v, depth + 1);
            }).join('\n');
        }
        // Plain object
        var keys = Object.keys(val);
        if (keys.length === 0) return '{}';
        return keys.map(function (k) {
            var nested = _flattenJsonForTitle(val[k], depth + 1);
            // Indent and place primitive values inline; nested blocks go on a new line.
            if (nested.indexOf('\n') === -1) return indent + k + ': ' + nested;
            return indent + k + ':\n' + nested;
        }).join('\n');
    }

    /**
     * Builds the comparison "context pair" rows that slot into the analysis
     * card's .snap-pair-grid, directly under the two dataset headers.
     *
     * Surfaces whether the search filter, prompt answers, source tables, and
     * column set match between the two sides of a comparison. Any mismatch
     * can make the row diff misleading:
     *   - Different filters → different visible rows on each side.
     *   - Different prompts → different SQL produced different underlying rows.
     *   - Different tables  → the data was joined from a different source set.
     *   - Different columns → some "differences" are actually missing fields.
     * Each DIFFERING attribute becomes one grid row (label | left value | ≠ |
     * right value) so the two values sit side-by-side under their respective
     * dataset; matching attributes collapse into a single quiet ✓ footnote.
     *
     * @param {{searchTerm?: string, prompts?: Array, tables?: string|string[], columns?: string[]}} left
     * @param {{searchTerm?: string, prompts?: Array, tables?: string|string[], columns?: string[]}} right
     * @returns {{gridHtml: string, diffCount: number}} gridHtml = rows +
     *   footnote to append into .snap-pair-grid ('' if neither side has any
     *   context worth showing); diffCount = number of differing attribute
     *   groups (filter / prompts / tables / columns, 0-4) for the summary
     *   footnote in the criteria column.
     */
    function _renderContextPairRows(left, right) {
        var leftSearch = String(left.searchTerm || '').trim();
        var rightSearch = String(right.searchTerm || '').trim();
        var filterDiffers = leftSearch !== rightSearch;

        // Build a unified prompt map: name → {leftVal, rightVal}
        var leftPrompts = Array.isArray(left.prompts) ? left.prompts : [];
        var rightPrompts = Array.isArray(right.prompts) ? right.prompts : [];
        var promptNames = {};
        leftPrompts.forEach(function (p) {
            if (p && p.name) promptNames[String(p.name)] = { left: String(p.value == null ? '' : p.value), right: null };
        });
        rightPrompts.forEach(function (p) {
            if (!p || !p.name) return;
            var k = String(p.name);
            if (!promptNames[k]) promptNames[k] = { left: null, right: null };
            promptNames[k].right = String(p.value == null ? '' : p.value);
        });
        var promptDiffs = [];
        Object.keys(promptNames).forEach(function (n) {
            var pair = promptNames[n];
            if (pair.left !== pair.right) promptDiffs.push({ name: n, left: pair.left, right: pair.right });
        });
        var hasPrompts = leftPrompts.length > 0 || rightPrompts.length > 0;

        // Tables - accept CSV or array, normalize to uppercase set.
        function _toTableSet(t) {
            if (!t) return null;
            var arr = Array.isArray(t) ? t : String(t).split(',');
            var set = {};
            var any = false;
            arr.forEach(function (n) {
                var s = String(n).trim().toUpperCase();
                if (s) { set[s] = true; any = true; }
            });
            return any ? set : null;
        }
        var leftTables = _toTableSet(left.tables);
        var rightTables = _toTableSet(right.tables);
        var tablesOnlyInLeft = [], tablesOnlyInRight = [];
        if (leftTables && rightTables) {
            Object.keys(leftTables).forEach(function (t) { if (!rightTables[t]) tablesOnlyInLeft.push(t); });
            Object.keys(rightTables).forEach(function (t) { if (!leftTables[t]) tablesOnlyInRight.push(t); });
            tablesOnlyInLeft.sort(); tablesOnlyInRight.sort();
        }
        var tablesDiffer = (tablesOnlyInLeft.length + tablesOnlyInRight.length) > 0;
        var hasTables = !!(leftTables || rightTables);

        // Columns - already normalized to uppercase by callers.
        function _toColSet(c) {
            if (!Array.isArray(c) || c.length === 0) return null;
            var set = {};
            c.forEach(function (n) {
                var s = String(n).trim().toUpperCase();
                if (s && s !== '#') set[s] = true;
            });
            return Object.keys(set).length ? set : null;
        }
        var leftCols = _toColSet(left.columns);
        var rightCols = _toColSet(right.columns);
        var colsOnlyInLeft = [], colsOnlyInRight = [];
        if (leftCols && rightCols) {
            Object.keys(leftCols).forEach(function (c) { if (!rightCols[c]) colsOnlyInLeft.push(c); });
            Object.keys(rightCols).forEach(function (c) { if (!leftCols[c]) colsOnlyInRight.push(c); });
            colsOnlyInLeft.sort(); colsOnlyInRight.sort();
        }
        var colsDiffer = (colsOnlyInLeft.length + colsOnlyInRight.length) > 0;
        var hasCols = !!(leftCols || rightCols);

        // Nothing relevant to show on either side - skip the rows entirely so
        // legacy/no-context comparisons don't grow visual weight.
        if (leftSearch === '' && rightSearch === '' && !hasPrompts && !hasTables && !hasCols) {
            return { gridHtml: '', diffCount: 0 };
        }

        // Helper: one paired value cell (mono chip; italic "(none)" when empty).
        function cell(val) {
            if (val == null || String(val) === '') return '<span class="snap-pair-cell snap-pair-diff snap-pair-none"><em>(none)</em></span>';
            return '<span class="snap-pair-cell snap-pair-diff">' + escapeHtml(val) + '</span>';
        }
        // Helper: a cell holding "+ NAME" chips for the names only THIS side has
        // (used for the tables / columns set differences).
        function extrasCell(arr) {
            if (!arr || arr.length === 0) return '<span class="snap-pair-cell snap-pair-diff snap-pair-none"><em>(none extra)</em></span>';
            var chips = arr.map(function (n) { return '<span class="snap-pair-colchip">+ ' + escapeHtml(n) + '</span>'; }).join('');
            return '<span class="snap-pair-cell snap-pair-diff">' + chips + '</span>';
        }
        // Helper: one full grid row - label | left cell | ≠ | right cell. The
        // label ellipsizes via CSS, so carry the full text in a title.
        function row(label, leftCell, rightCell) {
            return '<span class="snap-pair-row-label" title="' + escapeHtml(label) + '">' + escapeHtml(label) + '</span>' +
                   leftCell +
                   '<span class="snap-pair-mid" aria-label="differs">&ne;</span>' +
                   rightCell;
        }

        var rows = '';
        var diffCount = 0;
        if (filterDiffers) {
            diffCount++;
            rows += row('Filter', cell(leftSearch), cell(rightSearch));
        }
        if (promptDiffs.length > 0) {
            diffCount++;
            promptDiffs.forEach(function (d) {
                rows += row(d.name, cell(d.left), cell(d.right));
            });
        }
        if (tablesDiffer) {
            // Asymmetric set difference: each side's cell lists only the tables
            // the OTHER side lacks - the shared tables are noise here.
            diffCount++;
            rows += row('Tables', extrasCell(tablesOnlyInLeft), extrasCell(tablesOnlyInRight));
        }
        if (colsDiffer) {
            diffCount++;
            rows += row('Columns', extrasCell(colsOnlyInLeft), extrasCell(colsOnlyInRight));
        }

        // Footnote spanning the grid: on a full match it is the only output
        // (quiet ✓ one-liner); on a partial mismatch it names what DOES match.
        var matchBits = [];
        if (!filterDiffers && (leftSearch !== '' || rightSearch !== '')) matchBits.push('filter');
        if (promptDiffs.length === 0 && hasPrompts) matchBits.push('prompts');
        if (!tablesDiffer && hasTables) matchBits.push('tables');
        if (!colsDiffer && hasCols) matchBits.push('columns');
        var note = '';
        if (diffCount === 0) {
            var whatAll = matchBits.length ? matchBits.join(', ') : 'all checked context';
            note = '<span class="snap-pair-match-note" ' +
                   'title="A matching filter, prompts, tables, and column set ensure both sides reflect the same row subset and the same underlying query shape.">' +
                   '<span class="snap-pair-ok">✓</span> Same context - ' + escapeHtml(whatAll) + ' match on both sides.' +
                   '</span>';
        } else if (matchBits.length > 0) {
            var whatSome = matchBits.join(', ');
            // Capitalize the first attribute name for a cleaner sentence start.
            whatSome = whatSome.charAt(0).toUpperCase() + whatSome.slice(1);
            note = '<span class="snap-pair-match-note">' +
                   '<span class="snap-pair-ok">✓</span> ' + escapeHtml(whatSome) + ' match on both sides.' +
                   '</span>';
        }

        return { gridHtml: rows + note, diffCount: diffCount };
    }

    /**
     * Human-readable elapsed-time phrase between two epoch-ms timestamps -
     * "17 hours", "3 days", "1.5 years" - or '' when either timestamp is
     * missing or the gap is under a second. Rendered onto the arrow between
     * the two dataset headers in the analysis card (.snap-gap-note), where
     * the fact about the PAIR sits with the pair instead of in a footnote.
     */
    function _snapTimeGapPhrase(lt, rt) {
        if (typeof lt !== 'number' || typeof rt !== 'number' || lt <= 0 || rt <= 0) return '';
        var diffMs = Math.abs(lt - rt);
        if (diffMs < 1000) return '';
        var sec = Math.round(diffMs / 1000);
        var phrase;
        if (sec < 60)            phrase = sec + ' second' + (sec !== 1 ? 's' : '');
        else if (sec < 3600)     { var m = Math.round(sec / 60);            phrase = m + ' minute' + (m !== 1 ? 's' : ''); }
        else if (sec < 86400)    { var h = Math.round(sec / 3600);          phrase = h + ' hour'   + (h !== 1 ? 's' : ''); }
        else if (sec < 86400*30) { var d = Math.round(sec / 86400);         phrase = d + ' day'    + (d !== 1 ? 's' : ''); }
        else if (sec < 86400*365){ var mo = Math.round(sec / (86400*30));   phrase = mo + ' month' + (mo !== 1 ? 's' : ''); }
        else                     { var y = (sec / (86400*365)).toFixed(1).replace(/\.0$/, ''); phrase = y + ' year'  + (y !== '1' ? 's' : ''); }
        return phrase;
    }

    /**
     * Builds the HTML for the comparison "stats" meta line - a small italic
     * subtitle that renders below the .snap-summary, surfacing a context-
     * mismatch summary (count fed in by the caller from the pair-rows
     * builder) and, when active, the journal-toggle opt-in note. The time
     * gap moved onto the header arrow (_snapTimeGapPhrase) with the
     * 2026-07-23 paired-grid redesign; the row-count delta moved under the
     * AGAINST dataset header (_renderRowDeltaNote) 2026-07-26.
     *
     * @param {number} [ctxDiffCount] - differing context-attribute groups (0-4).
     * @returns {string} HTML for the meta line, or '' when nothing notable.
     */
    function _renderComparisonStatsLine(ctxDiffCount) {
        var bits = [];

        // Context-mismatch summary - the detail rows live in the paired grid
        // under the dataset headers; this is the "so what" reminder next to
        // the match percentage.
        if (ctxDiffCount > 0) {
            bits.push('<span title="For best results, the filter, prompts, tables, and columns should match on both sides - otherwise the diff may compare different row subsets or different underlying queries.">⚠️ Context differs on ' + ctxDiffCount + ' of 4 attributes - the diff may compare different row subsets</span>');
        }

        // Journal toggles: when the opt-in is on, say so here - a diff driven by a
        // mark/unmark since the snapshot would otherwise look like an unexplained
        // data change. Only shown when the report actually has toggle columns.
        if ($('#snapIncludeToggles').is(':checked') && window.Penumbra && window.Penumbra.journalToggleColumnNames) {
            var _statTog = window.Penumbra.journalToggleColumnNames();
            if (_statTog.length) {
                bits.push('<span title="Journal toggle column' + (_statTog.length !== 1 ? 's are' : ' is') + ' part of this comparison, so a mark/unmark since the snapshot is counted as a change.">🔖 ' + _statTog.length + ' journal toggle column' + (_statTog.length !== 1 ? 's' : '') + ' counted as a change</span>');
            }
        }

        if (bits.length === 0) return '';
        return '<div class="snap-stats-meta">' + bits.join(' <span class="snap-stats-sep">·</span> ') + '</div>';
    }

    /**
     * Row-count delta pill - "N% more rows on X" - rendered under the AGAINST
     * dataset header in the paired grid (moved off the criteria-column stats
     * line 2026-07-26: the delta is a fact about the dataset pair, so it sits
     * with the pair, the same way the arrow carries the time gap). Only
     * speaks up when the gap is notable (>=1.5x and >=50 rows absolute),
     * otherwise it's just noise alongside the X% match summary.
     *
     * @param {{label: string, rowCount: number}} left  - CURRENT / B side
     * @param {{label: string, rowCount: number}} right - AGAINST / A side
     * @returns {string} HTML for the pill, or '' when the gap isn't notable.
     */
    function _renderRowDeltaNote(left, right) {
        var lr = typeof left.rowCount  === 'number' ? left.rowCount  : null;
        var rr = typeof right.rowCount === 'number' ? right.rowCount : null;
        if (lr == null || rr == null || lr < 0 || rr < 0 || (lr === 0 && rr === 0)) return '';
        var biggerSide, biggerVal, smallerVal;
        if (lr >= rr) { biggerSide = left.label;  biggerVal = lr; smallerVal = rr; }
        else          { biggerSide = right.label; biggerVal = rr; smallerVal = lr; }
        var absDelta = biggerVal - smallerVal;
        var ratio = smallerVal > 0 ? (biggerVal / smallerVal) : Infinity;
        if (absDelta < 50 || ratio < 1.5) return '';
        var ratioStr;
        if (smallerVal === 0)  ratioStr = (biggerVal).toLocaleString() + ' rows only on ' + biggerSide;
        else if (ratio >= 10)  ratioStr = ratio.toFixed(1).replace(/\.0$/, '') + '× more rows on ' + biggerSide;
        else                   ratioStr = Math.round((ratio - 1) * 100) + '% more rows on ' + biggerSide;
        return '<div class="snap-rowdelta-note" title="A large row-count gap can mean you’re comparing snapshots taken with different filters, prompts, or at very different times.">📊 ' + ratioStr + '</div>';
    }

    // Snapshot note(s) as a small italic subtitle centered in the analysis
    // card's banner band - a snapshot's note usually records WHY it was taken
    // ("baseline before the July load"), which is exactly the context a
    // reader of the comparison needs. One entry per side that IS a snapshot
    // (A-vs-B passes two, prefixed with the side letter; live-vs-snapshot
    // passes one, unprefixed); sides without a note render nothing. CSS
    // ellipsizes each line to one row; the full text rides the title
    // tooltip. .text() does the escaping - notes are free-typed user content.
    function _renderBannerSnapshotNotes($infoDiv, entries) {
        var $banner = $infoDiv.find('.snap-card-banner');
        if (!$banner.length) return;
        (entries || []).forEach(function (e) {
            var noteText = (e && typeof e.text === 'string') ? e.text.trim() : '';
            if (!noteText) return;
            var prefix = (e && e.prefix) ? e.prefix + ': ' : '';
            $('<div class="snap-banner-note"></div>')
                .text('📝 ' + prefix + noteText)
                .attr('title', ((e && e.prefix) ? 'Snapshot ' + e.prefix : 'Snapshot') + ' note: ' + noteText)
                .appendTo($banner);
        });
    }

    /**
     * Sub-row diff annotation for @@JSON-vs-@@JSON modified cells. Parses both
     * sides; rows present in only one side are marked added/removed, leftover
     * rows sharing the same FIRST-column value pair up as "changed", and rows
     * present in both stay unmarked. Marks ride a __PNBDIFF key on the row
     * object, which createTableFromJson() consumes as a row tint + glyph and
     * never renders as a column. MIRRORED in schedule_runner.php's
     * penumbra_annotate_json_subdiff() for the change-analysis emails - keep
     * the two in sync or the email and in-app tints will disagree.
     *
     * @param {string} wasRaw - the snapshot-side cell value ("@@JSON[...]")
     * @param {string} nowRaw - the current-side cell value ("@@JSON[...]")
     * @returns {{was: string, now: string}|null} annotated cell strings, or
     *          null when the pair isn't two parseable arrays-of-objects (the
     *          caller then renders the original values unannotated).
     */
    function _annotateJsonSubDiff(wasRaw, nowRaw) {
        if (typeof wasRaw !== 'string' || typeof nowRaw !== 'string') return null;
        if (wasRaw.indexOf('@@JSON') !== 0 || nowRaw.indexOf('@@JSON') !== 0) return null;
        var wasArr, nowArr;
        try {
            wasArr = JSON.parse(wasRaw.substring(6));
            nowArr = JSON.parse(nowRaw.substring(6));
        } catch (e) { return null; }
        function isRowObj(r) { return !!r && typeof r === 'object' && !Array.isArray(r); }
        if (!Array.isArray(wasArr) || !Array.isArray(nowArr) || !wasArr.length || !nowArr.length) return null;
        if (!wasArr.every(isRowObj) || !nowArr.every(isRowObj)) return null;

        var SEP = '␟'; // same joiner the row-signature code uses
        function cellStr(v) {
            if (v && typeof v === 'object') { try { return JSON.stringify(v); } catch (e) { return ''; } }
            return String(v == null ? '' : v).trim();
        }
        function sig(row) {
            var parts = [];
            Object.keys(row).forEach(function (k) {
                if (k === '__PNBDIFF') return;
                parts.push(k + '=' + cellStr(row[k]));
            });
            return parts.join(SEP);
        }
        function firstVal(row) {
            var ks = Object.keys(row);
            for (var i = 0; i < ks.length; i++) {
                if (ks[i] !== '__PNBDIFF') return cellStr(row[ks[i]]);
            }
            return '';
        }

        var wasStat = wasArr.map(function () { return null; });
        var nowStat = nowArr.map(function () { return null; });

        // Pass 1: exact multiset match -> unmarked on both sides.
        var pool = {};
        wasArr.forEach(function (r, i) { var s = sig(r); (pool[s] = pool[s] || []).push(i); });
        nowArr.forEach(function (r, i) {
            var q = pool[sig(r)];
            if (q && q.length) { wasStat[q.shift()] = 'same'; nowStat[i] = 'same'; }
        });
        // Pass 2: leftovers sharing a first-column value pair up as "changed"
        // (sub-rows have no declared key; the first column is the best stand-in).
        var fpool = {};
        wasArr.forEach(function (r, i) { if (wasStat[i] === null) { var f = firstVal(r); (fpool[f] = fpool[f] || []).push(i); } });
        nowArr.forEach(function (r, i) {
            if (nowStat[i] !== null) return;
            var q = fpool[firstVal(r)];
            if (q && q.length) { wasStat[q.shift()] = 'changed'; nowStat[i] = 'changed'; }
        });
        // Pass 3: the rest exist on one side only.
        wasStat = wasStat.map(function (s) { return s === null ? 'removed' : s; });
        nowStat = nowStat.map(function (s) { return s === null ? 'added' : s; });

        var any = false;
        function markRows(arr, stat) {
            return arr.map(function (row, i) {
                if (stat[i] === 'same') return row;
                any = true;
                var copy = {};
                Object.keys(row).forEach(function (k) { if (k !== '__PNBDIFF') copy[k] = row[k]; });
                copy.__PNBDIFF = stat[i];
                return copy;
            });
        }
        var wasOut = markRows(wasArr, wasStat);
        var nowOut = markRows(nowArr, nowStat);
        if (!any) return null;
        return {
            was: '@@JSON' + JSON.stringify(wasOut),
            now: '@@JSON' + JSON.stringify(nowOut)
        };
    }

    // A compact amber chip (criteria column, under the match summary) naming
    // columns that changed in MODIFIED rows but are HIDDEN from the comparison
    // output (column visibility). Such a row shows in "Modified Rows" with no
    // visible [was:]/[now:], reading as a mystery ("why is this modified?").
    // Shows up to three column names inline; the full list + explanation live
    // in the title tooltip. Empty string when there are none. `shownColumns` =
    // the visible columns (uppercase-compared); `caseMap` maps UPPER -> display
    // name (it carries hidden columns too, so their friendly names resolve).
    function _renderHiddenChangeNote(modifiedRows, shownColumns, caseMap) {
        if (!modifiedRows || !modifiedRows.length) return '';
        var shown = {};
        (shownColumns || []).forEach(function (c) { shown[String(c).toUpperCase()] = true; });
        var hidden = {};
        var affectedRows = 0;
        modifiedRows.forEach(function (m) {
            var cc = m && m.changedCols;
            if (!cc) return;
            var hit = false;
            cc.forEach(function (col) {
                var u = String(col).toUpperCase();
                if (u !== '#' && !shown[u]) {
                    hidden[u] = (caseMap && caseMap.get(u)) || col;
                    hit = true;
                }
            });
            if (hit) affectedRows++;
        });
        var names = Object.keys(hidden).sort().map(function (k) { return String(hidden[k]); });
        if (!names.length) return '';
        var shownNames = names.slice(0, 3).join(', ') + (names.length > 3 ? ' +' + (names.length - 3) + ' more' : '');
        var titleText = 'These columns are hidden from the comparison, so a row that changed only here appears under Modified Rows with no visible before/after. Hidden changed columns: ' + names.join(', ');
        return '<span class="snap-hidden-chip" title="' + escapeHtml(titleText) + '">' +
                   '👁 ' + affectedRows + ' modified row' + (affectedRows !== 1 ? 's' : '') +
                   ' changed in hidden column' + (names.length !== 1 ? 's' : '') + ': ' + escapeHtml(shownNames) +
               '</span>';
    }

    /**
 * Performs comparison using dynamic keys.
 */
    // ═════════════════════════════════════════════════════════════════════
    // EVERGREEN SNAPSHOT SELECTORS (2026-08-20)
    // A snapshot reference in a URL (?snap= / ?snapcmp= / ?snapab=) or in the
    // snapshot_compare trigger command no longer has to be a fixed numeric
    // id - a selector token resolves against the report's snapshot list AT
    // OPEN TIME, so shared links and snippet buttons never go stale as
    // snapshots accumulate or rotate out:
    //   latest              newest snapshot, any creator
    //   latest-<n>          n-th newest (latest-1 = latest, latest-2 = one before)
    //   prev                alias of latest-2
    //   latest-scheduler    newest auto-snapshot (CREATED_BY 'SCHEDULER')
    //   latest-mine         newest created by the signed-in viewer
    //   latest-by-<uid>     newest created by that unity id
    //   pinned              newest PINNED snapshot - the most stable form:
    //                       rotation never deletes pins, and repointing the
    //                       pin repoints every link that references it
    // Hyphen separators on purpose: the audit beacon's snap-ref sanitizer
    // allowlist is [a-zA-Z0-9|_-], so tokens survive into analytics intact.
    function _isSnapshotSelectorToken(ref) {
        return /^(latest(-\d+|-scheduler|-mine|-by-[a-z0-9._@-]+)?|prev|pinned)$/i.test(String(ref || '').trim());
    }
    // Pure picker over an action=list response (already CREATED_AT DESC).
    // Returns the matching list row or null. Split from the fetch so the
    // snapshot_compare trigger (which has its own list call) and the URL
    // boots share ONE definition of every token.
    function _pickSnapshotBySelector(list, token) {
        if (!Array.isArray(list) || !list.length) return null;
        var t = String(token || '').trim().toLowerCase();
        function newestBy(uid) {
            uid = String(uid || '').toLowerCase();
            if (!uid) return null;
            for (var i = 0; i < list.length; i++) {
                if (String(list[i].CREATED_BY || '').toLowerCase() === uid) return list[i];
            }
            return null;
        }
        if (t === 'pinned') {
            for (var p = 0; p < list.length; p++) {
                if (list[p].PINNED_BY) return list[p];
            }
            return null;
        }
        if (t === 'latest-scheduler') return newestBy('scheduler');
        if (t === 'latest-mine') {
            return newestBy(typeof penumbra_vars !== 'undefined' ? penumbra_vars.currentUserKey : '');
        }
        if (t.indexOf('latest-by-') === 0) return newestBy(t.substring('latest-by-'.length));
        if (t === 'prev') return list[1] || null;
        var nMatch = t.match(/^latest-(\d+)$/);
        if (nMatch) {
            var n = parseInt(nMatch[1], 10);
            return (n >= 1 && n <= list.length) ? list[n - 1] : null;
        }
        if (t === 'latest') return list[0];
        return null;
    }
    // Human phrase for a token - used in failure notices and copy toasts.
    function _describeSnapshotSelector(token) {
        var t = String(token || '').trim().toLowerCase();
        if (t === 'pinned') return 'the pinned snapshot';
        if (t === 'latest-scheduler') return 'the latest scheduler (auto) snapshot';
        if (t === 'latest-mine') return 'your own latest snapshot';
        if (t.indexOf('latest-by-') === 0) return 'the latest snapshot by ' + t.substring('latest-by-'.length);
        if (t === 'prev' || t === 'latest-2') return 'the previous (second-newest) snapshot';
        var nMatch = t.match(/^latest-(\d+)$/);
        if (nMatch) {
            var n = parseInt(nMatch[1], 10);
            var sfx = (n % 10 === 1 && n % 100 !== 11) ? 'st' : (n % 10 === 2 && n % 100 !== 12) ? 'nd' : (n % 10 === 3 && n % 100 !== 13) ? 'rd' : 'th';
            return 'the ' + n + sfx + '-newest snapshot';
        }
        return 'the latest snapshot';
    }
    // Fetch + pick. cb(metaRow, null) on success; cb(null, friendlyHtml)
    // when the token matches nothing or the list call fails. Error strings
    // are already escaped for show_text interpolation.
    function _resolveSnapshotSelector(reportId, token, cb) {
        $.ajax({
            url: 'manage_snapshots.php?action=list&report_id=' + encodeURIComponent(reportId),
            method: 'GET',
            dataType: 'json',
            success: function (response) {
                var list = (response && response.status === 'success' && Array.isArray(response.data)) ? response.data : null;
                if (!list) {
                    cb(null, 'Could not list this report\'s snapshots to resolve "' + escapeHtml(String(token)) + '".');
                    return;
                }
                var pick = _pickSnapshotBySelector(list, token);
                if (!pick || !pick.ID) {
                    cb(null, list.length
                        ? ('No snapshot matches "' + escapeHtml(String(token)) + '" (' + _describeSnapshotSelector(token) + ') for this report.')
                        : 'This report has no server snapshots yet.');
                    return;
                }
                cb(pick, null);
            },
            error: function () {
                cb(null, 'Could not reach the server to resolve the snapshot reference "' + escapeHtml(String(token)) + '".');
            }
        });
    }

    function runComparisonAndDisplayGrouped(snapshot, customKeyColumns = null) {
        // Final gate: never diff with a frozen snapshot posing as the live side.
        // The dialog's Compare button checks this too, but its cancellable sync
        // dialogs (column/filter) leave a window where a Load As View can flip
        // the view to snapshot data before the queued compare callback runs.
        if (typeof isViewingSnapshot !== 'undefined' && isViewingSnapshot) {
            hideLoading();
            show_text('<p id="undo_text"><span style="color: var(--accent-danger, #cc0000)">Heads up:</span> You’re viewing snapshot data, not live data — the comparison was cancelled. Return to live data first (click the snapshot indicator), or select two snapshots and use <strong>A vs B</strong>.</p>', 11000);
            return;
        }
        // Distinguish initial-run from search-triggered re-run. The body
        // class is added once the comparison view is rendered (line ~51432)
        // and cleared when the user exits the comparison via "Remove
        // Grouping" / similar (search runComparisonAndDisplayGrouped exits
        // for the class clear). A re-run that lands here from runTableSearch
        // sees the class still present, an initial render does not.
        const _isInitialCompare = !$('body').hasClass('snapshot-comparison-active');

        // Auto-collapse the report header (snippets / charts / filters) on
        // the FIRST view of a comparison if it would eat more than 35% of
        // the viewport - the diff table needs vertical room to read. Skip
        // for search-triggered re-runs: if the header is back on screen at
        // that point the user explicitly toggled it on and we shouldn't
        // override that. Also skip if it's already collapsed (no double-
        // toggle) or hidden entirely (outerHeight 0 → ratio 0 → no-op).
        if (_isInitialCompare) {
            // Hide the report header for the duration of the comparison so the diff
            // + analysis card get the vertical room. Remember (body class) that WE
            // hid it, so the clear paths restore it - but only if it was actually
            // visible when the comparison began. (Click the handle rather than
            // mutating classes so the existing handler fires the layout resize.)
            const $hdr = $('#reportHeaderContainer');
            if (!$hdr.hasClass('is-collapsed')) {
                $('#headerToggleHandle').click();
                $('body').addClass('pnb-snap-hid-hdr');
            } else {
                $('body').removeClass('pnb-snap-hid-hdr');
            }

            // Also collapse the admin console (builder) if it's open, so the
            // snapshot analysis card is visible immediately. No-op if it's
            // already hidden or this user has no console.
            if (typeof toggleSmartAdminView === 'function') { toggleSmartAdminView(false); }
            // ...and the home cards, for the same reason loadSnapshotData hides them:
            // this runs BEFORE the diff reaches #groupedResultsContainer, so the console
            // close sees an empty page and landingWouldCoverData() cannot help here.
            // (A-vs-B genuinely runs on a home-screen tab - it needs no live side.)
            $('.landing-container').stop(true, true).hide();

            // The compare is launched from the snapshot lightbox; on close, focus
            // returns to #snapshotBtn, whose title makes the global jQuery UI
            // tooltip pop even with the cursor elsewhere. Blur it + close any open
            // tooltip on the next tick.
            setTimeout(function () {
                try { $('#snapshotBtn').blur(); } catch (e) {}
                try { $(document).tooltip('close'); } catch (e) {}
            }, 0);
        }

        // (The compare trackers are assigned LATER, after the abort guards -
        // see the note at the assignment. Assigning here disarmed the diff
        // already on screen whenever a NEW compare aborted.)

        $('#manageSnapshotsLightbox').fadeOut('fast', function () {
            showLoading("Running comparison...");
            setTimeout(() => {
                try {
                    if ($('#pivot-output-container').is(':visible')) {
                        $('#pivot-output-container').hide().empty();
                        $('#modifyPivotBtn').hide();
                        $('#exitPivotModeBtn').hide();
                        currentPivotSettings = null;
                        currentPivotSourceData = null;
                        pivotMasterDataSource = null;
                        _pivotPreSearchCollapseState = null;
                    }

                    let decompressed = decompressString(snapshot.compressedData);
                    const oldData = _unwrapSnapshotRows(JSON.parse(decompressed));
                    // Release the raw JSON text - no reader after the parse. 2026-08-01
                    decompressed = null;

                    // Journal toggle handling. Toggles are a WATCHED column only when
                    // the user opts in ("Compare journal toggle columns"); otherwise a
                    // comparison ignores checkbox state entirely, even on a snapshot that
                    // captured it - the normal data-diff behaviour. When opted in, the
                    // live side (masterRowData) is decorated with toggle state so both
                    // sides carry the column; when not, the toggle columns are stripped
                    // from the snapshot rows so they never enter the signature or diff.
                    const _cmpIncludeToggles = $('#snapIncludeToggles').is(':checked');
                    const _cmpToggleMap = (window.Penumbra && window.Penumbra.journalToggleColumnMap)
                        ? window.Penumbra.journalToggleColumnMap() : [];
                    const _cmpToggleSet = new Set(_cmpToggleMap.map(e => String(e.name).toUpperCase()));
                    // sentinel (upper) -> { name, label } so the RENDER can translate a
                    // toggle header (whose data-colname is the sentinel) to the friendly
                    // name the decorated row data actually uses.
                    const _cmpSentinelToName = new Map();
                    _cmpToggleMap.forEach(e => _cmpSentinelToName.set(String(e.sentinel).toUpperCase(), e));
                    const _cmpIsNotesCol = (window.Penumbra && window.Penumbra.journalIsNotesCol)
                        ? window.Penumbra.journalIsNotesCol : function () { return false; };

                    // Active search, split into (a) __SNAP_TYPE group clauses that the
                    // group-header X buttons append (applied to the rendered GROUPS
                    // below, never to data) and (b) real data clauses (applied to BOTH
                    // sides of the diff - the caller already applied them to the live
                    // table via .search-hidden; the snapshot side is filtered right
                    // after normalization so out-of-filter rows drop from the diff
                    // instead of flooding "Removed Rows").
                    const _cmpRawSearch = $('#tableSearch').val() || '';
                    let _cmpStIncl = null;
                    const _cmpStExcl = new Set();
                    // __SRC dropped here exactly as on the live side (_applySearchToLiveTable's
                    // caller), or the two sides would parse the same text differently.
                    let _cmpDataSearch = penumbraTakeSrcModifier(_cmpRawSearch.trim()).query;
                    if (_cmpDataSearch) {
                        const _stRe = /__SNAP_TYPE\s*(=|!=|<>)\s*'([^']*)'/gi;
                        let _stM;
                        // Lowercased group names so a hand-typed clause matches
                        // regardless of case (the render skip lowercases too).
                        while ((_stM = _stRe.exec(_cmpRawSearch)) !== null) {
                            if (_stM[1] === '=') { (_cmpStIncl = _cmpStIncl || new Set()).add(_stM[2].toLowerCase()); }
                            else { _cmpStExcl.add(_stM[2].toLowerCase()); }
                        }
                        _cmpDataSearch = _stripSnapTypeClauses(_cmpDataSearch);
                    }

                    // --- CHANGED: Re-hash the snapshot data based on the selected key ---
                    // Normalize snapshot rows
                    const normalizedOldRows = [];
                    oldData.forEach(item => {
