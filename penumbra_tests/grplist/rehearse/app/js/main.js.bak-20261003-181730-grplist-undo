            }).join('');
            parts.push(
                '<span class="chart-drill-bc-step" data-step-idx="' + i + '">' +
                    '<span class="chart-drill-bc-col">' + escapeHtml(step.col) + ':</span>' +
                    '<select class="chart-drill-bc-val" data-step-idx="' + i + '" ' +
                    'title="Change the value for ' + escapeHtml(step.col) + ' (replaces deeper drill steps)">' +
                    optHtml +
                    '</select>' +
                '</span>'
            );
            parts.push('<span class="chart-drill-bc-sep">\u25B8</span>');
        });
        parts.push('<span class="chart-drill-bc-current" title="Current X axis">' + escapeHtml(state.displayedCol) + '</span>');
        return '<div class="chart-drill-breadcrumb-bar" role="navigation" aria-label="Drill-down breadcrumb">' + parts.join('') + '</div>';
    }

    // Insert or replace the breadcrumb bar as a sibling immediately
    // before the canvas. Placing it in the canvas's own parent keeps
    // the drill UI adjacent to the chart regardless of wrapping
    // context (#vizChartSizer, .penumbra-chart-filter-wrapper,
    // .infobox-body). A centering wrapper (text-align: center) is used
    // so the shrink-to-fit inline-flex bar is horizontally aligned
    // with the canvas rather than pinned to the parent's left edge.
    function _mountDrillBreadcrumb(canvas, state) {
