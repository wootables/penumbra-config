                            }).filter(function (s) { return s !== ''; }).join(', ');
                        } else if (valueToParse && typeof valueToParse === 'object') {
                            if (valueToParse.display !== undefined) displayValue = valueToParse.display;
                            else if (valueToParse.value !== undefined) displayValue = valueToParse.value;
                        } else if (typeof valueToParse === 'string' || typeof valueToParse === 'number') {
                            displayValue = String(valueToParse);
                        }
                    } catch (e) {}
                }

                if (displayValue === null || displayValue === undefined || displayValue === '') {
                    if (parsed.forcedefault !== null && parsed.forcedefault !== undefined && parsed.forcedefault !== '') {
                        displayValue = parsed.forcedefault;
                    } else if (parsed.default !== undefined && parsed.default !== null) {
                        displayValue = parsed.default;
                    } else {
                        displayValue = '';
                    }
                }

                // A date range is captured as the DATES IT STOOD FOR when the snapshot
                // was taken ("01-AUG-26 to 31-AUG-26"), not its label: a snapshot headed
                // "Last month" says nothing a month later, and the mismatch check should
                // see that the window has moved. The scheduler's snapshots record the
                // dates too (penumbraDateRangeDisplay). A min/max half cannot be
                // resolved without a lookup, so that one keeps its label.
                if (penumbraIsDateRangeType(parsed.type)) {
                    var drSnapRaw = null;
                    try {
                        var drSnapObj = JSON.parse(localStorage.getItem(storageKey) || 'null');
                        if (drSnapObj && drSnapObj.value !== undefined) drSnapRaw = drSnapObj.value;
                    } catch (e) {}
                    if (drSnapRaw === null) {
                        drSnapRaw = (parsed.forcedefault !== null && parsed.forcedefault !== undefined && parsed.forcedefault !== '')
                            ? parsed.forcedefault : parsed.default;
                    }
                    var drSnapDates = penumbraDateRangeResolvedText(drSnapRaw, parsed);
                    if (drSnapDates) displayValue = drSnapDates;
                    else if (drSnapRaw !== null && drSnapRaw !== undefined) displayValue = penumbraDateRangeLabel(drSnapRaw);
