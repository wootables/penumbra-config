                // before the numeric parse discards non-numeric values below.
                switch (func.toLowerCase()) {
                    case 'count':
                        return filteredMaps.length;
                    case 'distinct':
                        return new Set(filteredMaps.map(map => map.get(colName))).size;
                    case 'count_filled':
                        return filteredMaps.filter(map => String(map.get(colName) == null ? '' : map.get(colName)).trim() !== '').length;
                    case 'count_blank':
