    // Click ✕ on a Values chip: remove ALL agg rows using that source column,
    // then return the chip to the Fields list. Rejects the removal if it would
    // strand derived aggregations (% Change, Running Total, etc.) with no base.
    $('#pivot-vals').on('mousedown', '.pivot-item-remove', function (e) {
        e.stopImmediatePropagation();
        e.preventDefault();
        var $item = $(this).closest('.pivot-column-item');
        var col = ($item.attr('data-field') || $item.text()).trim().toUpperCase();
        if (!col) return;
        // Guard: would removing this column leave derived rows stranded?
        var baseCountAfter = 0, derivedExists = false;
        $('#pivot-agg-table-body tr').each(function () {
            var t = $(this).attr('data-agg-type');
            var c = ($(this).attr('data-agg-col') || '').toUpperCase();
            if (_isDerivedAgg(t)) { derivedExists = true; return; }
            if (c !== col) baseCountAfter++;
        });
        if (derivedExists && baseCountAfter === 0) {
            showPivotError("Cannot remove '" + col + "' while dependent aggregations (% Change, Running Total, etc.) exist - they need at least one base aggregation to inherit from.", true);
            return;
        }
        // Remove all agg rows for this column
        $('#pivot-agg-table-body tr').each(function () {
            var c = ($(this).attr('data-agg-col') || '').toUpperCase();
            if (c === col) $(this).remove();
        });
        _returnChipToSource($item);
        refreshAggTokenLabels();
        rebuildRowTotalSlots();
        syncRankAggDropdown();
        updatePivotLayoutOptions();
    });

    function updatePivotLayoutOptions() {
        const rowCount = $('#pivot-rows .pivot-column-item').length;
        const colCount = $('#pivot-cols .pivot-column-item').length;
        const valCount = $('#pivot-agg-table-body tr').length; // at least one agg row needed

        // Show inline layout options (inline-flex for the new 3-column layout)
        if (rowCount >= 2) {
            $('#pivot-rows-layout').css('display', 'inline-flex');
            // Show "Start groups expanded" when nested layout with 2+ row fields
            var rowLayout = $('#pivot-rows-layout-select').val() || 'nested';
            if (rowLayout === 'nested') {
                $('#pivot-collapse-option').show();
            } else {
                $('#pivot-collapse-option').hide();
                $('#pivot-start-expanded').prop('checked', false);
            }
        } else {
            $('#pivot-rows-layout').hide();
            $('#pivot-collapse-option').hide();
            $('#pivot-start-expanded').prop('checked', false);
        }
        if (colCount >= 2) {
            $('#pivot-cols-layout').css('display', 'inline-flex');
        } else {
            $('#pivot-cols-layout').hide();
        }

        // --- Feature: Item count badges on zone headers ---
        updateZoneBadge('rows', rowCount);
        updateZoneBadge('cols', colCount);
        updateZoneBadge('vals', valCount);

        // --- Feature: Ensure remove buttons on drop zone pills ---
        $('#pivot-rows .pivot-column-item, #pivot-cols .pivot-column-item, #pivot-vals .pivot-column-item').each(function () {
            if ($(this).find('.pivot-item-remove').length === 0) {
                $(this).append('<span class="pivot-item-remove">&times;</span>');
            }
        });
        // Remove any stray remove buttons from source pills
        $('#pivot-source-columns .pivot-item-remove').remove();

        // --- Date split pills (2026-08-25) ---
        // Idempotent: runs after every drag, drop, transpose and populate, so
        // it is the ONE place split decoration and state hygiene happen.
        // Rows/Cols date pills carry the caret (+ chip when a variant is set);
        // pills anywhere else can never hold a split.
        $('#pivot-rows .pivot-column-item, #pivot-cols .pivot-column-item').each(function () {
            _pivotDecorateZonePill($(this));
        });
        $('#pivot-source-columns .pivot-column-item, #pivot-vals .pivot-column-item').each(function () {
            $(this).removeAttr('data-split').removeAttr('data-fill').removeClass('pnb-has-caret');
            $(this).children('.pivot-split-chip, .pivot-split-caret').remove();
        });
        // Fields list: a small glyph marks date columns, so the split is
        // discoverable before the first drop (owner-approved 2026-08-25).
        $('#pivot-source-columns .pivot-column-item').each(function () {
            var $p = $(this);
            var k = _pivotFieldSplitKind($p.attr('data-field') || $p.text());
            var $g = $p.children('.pivot-date-glyph');
            var want = (k === 'date') ? '📅' : (k === 'num' ? '🔢' : '');
            var wantTitle = (k === 'date')
                ? 'Date column: drop into Rows or Columns, then use its ▾ menu to bucket by year, quarter, month...'
                : 'Numeric column: drop into Rows or Columns, then use its ▾ menu to bin into ranges';
            if (want && $g.length === 0) {
                $p.prepend($('<span class="pivot-date-glyph" aria-hidden="true"></span>').attr('title', wantTitle).text(want));
            } else if (!want && $g.length) {
                $g.remove();
            } else if (want && $g.length && $g.text() !== want) {
                $g.text(want).attr('title', wantTitle);
            }
        });
        if (_pivotSplitMenuPill && !document.contains(_pivotSplitMenuPill[0])) _pivotCloseSplitMenu();

        // Rank scope options follow the Rows zone (2026-08-25).
        _pivotSyncRankScopeOptions();
    }

    function updateZoneBadge(zone, count) {
        var $header = $('.pivot-card[data-zone="' + zone + '"] .pivot-card-title');
        var $badge = $header.find('.pivot-zone-count');
        if (count > 0) {
