                if (xhr && xhr.status === 403 && typeof handleSessionExpiredError === 'function') { handleSessionExpiredError(); return; }
                _schedSubsCondStatus('is-warn', 'Could not check the condition right now - it is still validated when you save.');
            })
            .always(function () { _schedSubsCondXhr = null; });
    }
    // Save-time guard (the save handler calls this): refuses an empty condition and
    // asks before a save the last check says will remove subscribers. true = go on.
    function _schedSubsCondSaveGuard(showError) {
        if (!$('#schedSubsEnable').is(':checked') || !$('#schedSubsCondEnable').is(':checked')) return true;
        var cond = String($('#schedSubsCondExpr').val() || '').trim();
        if (!cond) {
            showError('Enter the subscription condition, or uncheck "Allow only on custom condition".', '#schedSubsCondExpr');
            return false;
        }
        var last = _schedSubsCondLast;
        if (last && last.cond === cond && last.resp && last.resp.valid === false) {
            showError('Subscription condition: ' + escapeHtml(last.resp.error || 'it cannot be used.'), '#schedSubsCondExpr');
            return false;
        }
        var removed = (last && last.cond === cond && last.resp && last.resp.subscribers && Array.isArray(last.resp.subscribers.removed))
            ? last.resp.subscribers.removed : [];
        if (removed.length && !confirm(removed.length + ' current subscriber' + (removed.length === 1 ? ' does' : 's do')
                + ' not match this condition and will be removed at the next send:\n' + removed.join('\n') + '\n\nSave anyway?')) {
            return false;
        }
        return true;
    }

    function updateSubscriptionCardUI() {
