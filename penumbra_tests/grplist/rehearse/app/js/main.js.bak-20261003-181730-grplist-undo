    (function initFloatingBtnDrag() {
        var $container = $('#floating-button-container');
        if (!$container.length) return;

        // Re-apply the saved position, clamped to the CURRENT container size.
        // Single copy on purpose: restore, resize and the d-pad's left/right row all
        // need identical clamping, and the size they clamp against changes underneath
        // them (see penumbraReclampFloatingBtns below).
        // No-op when nothing is saved: the container is then still on its CSS
        // right/bottom anchor, which grows leftward and can't run off the edge.
        function applySavedFloatingBtnPos() {
            var saved = localStorage.getItem(FLOATING_BTN_POS_KEY);
            if (!saved) return;
            try {
                var pos = JSON.parse(saved);
                // Convert percentage to pixels
                var winW = $(window).width();
                var winH = $(window).height();
                var left = (pos.leftPct / 100) * winW;
                var top = (pos.topPct / 100) * winH;

                // Clamp to keep the container on-screen
                var cW = $container.outerWidth() || 66;
                var cH = $container.outerHeight() || 300;
                left = Math.max(0, Math.min(left, winW - cW));
                top = Math.max(0, Math.min(top, winH - cH));

                // Apply position - switch from right/bottom to left/top
                $container.css({
                    left: left + 'px',
                    top: top + 'px',
                    right: 'auto',
                    bottom: 'auto'
                });
            } catch (e) {
                // Invalid JSON - ignore, use default CSS position
            }
        }

        // --- Restore saved position from localStorage ---
        applySavedFloatingBtnPos();

        // --- Orientation (2026-08-10): vertical rail <-> horizontal dock pill.
        // DOUBLE-CLICK the grip to rotate; persisted beside the position pref.
        // Deliberately no extra icon: the handle IS the affordance (its title
        // says so), which keeps the rail down to one piece of chrome. jQuery UI
        // draggable only engages after ~1px of movement, so a clean
        // double-click never starts a drag.
        var FLOATING_BTN_ORIENT_KEY = 'penumbra_floating_btn_orient';
        function applyFloatingBtnOrient() {
            var horiz = localStorage.getItem(FLOATING_BTN_ORIENT_KEY) === 'h';
            $container.toggleClass('pnb-dock', horiz).toggleClass('pnb-rail', !horiz);
        }
        applyFloatingBtnOrient();
        $('#floatingBtnDragHandle').on('dblclick', function (e) {
            e.preventDefault();
            var nowHoriz = !$container.hasClass('pnb-dock');
            localStorage.setItem(FLOATING_BTN_ORIENT_KEY, nowHoriz ? 'h' : 'v');
            applyFloatingBtnOrient();
            // The footprint just changed shape - re-clamp so nothing lands
            // off-screen at the saved position.
            applySavedFloatingBtnPos();
        });

        // Showing the d-pad's left/right row widens the container by a whole button.
        // Once dragged, the container is pinned by `left` with `right:auto`, so it
        // grows RIGHTWARD -- and the clamp above ran while the row was still hidden,
        // against the narrow width. Without re-clamping, the right arrow lands off the
        // edge of the screen. Safe to call synchronously right after .fadeIn(): jQuery
        // applies `display` during the fade's first (synchronous) tick, so the
        // container has already grown by the time this measures it.
        window.penumbraReclampFloatingBtns = applySavedFloatingBtnPos;

        // --- Initialize jQuery UI Draggable ---
        $container.draggable({
            handle: '#floatingBtnDragHandle',
            containment: 'window',
            scroll: false,
            // NOTE: no jQuery UI `opacity` option here on purpose - that fades
            // the WHOLE card (buttons included). Translucency is CSS-driven on
            // the background only: rest = 65% surface mix, .pnb-dragging = 42%
            // (more see-through mid-drag so the drop area underneath stays
            // readable); the buttons stay solid throughout.
            start: function () {
                // FIRST-DRAG STRETCH FIX: at the CSS default position the
                // container is anchored by right/bottom only. Draggable writes
                // left/top per frame but clears right/bottom only in stop() -
                // so during that first drag ALL FOUR anchors were live and the
                // fixed box stretched between the old corner and the pointer.
                // Pin the current geometry to left/top and drop the far
                // anchors BEFORE the first frame; visually nothing moves, and
                // draggable's own offset math (captured at mousedown) agrees.
                var r = $container[0].getBoundingClientRect();
                $container.css({ left: r.left + 'px', top: r.top + 'px', right: 'auto', bottom: 'auto' });
                $('#floatingBtnDragHandle').addClass('is-dragging');
                $container.addClass('pnb-dragging');
            },
            stop: function (event, ui) {
                $('#floatingBtnDragHandle').removeClass('is-dragging');
                $container.removeClass('pnb-dragging');
