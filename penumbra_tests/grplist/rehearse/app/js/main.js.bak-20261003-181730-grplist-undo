    // ============= END SETTINGS PANEL LOGIC =============
    // ====================================================

    /**
     * Wraps the active table in a scrollable container.
     * OPTIMIZED: Uses ResizeObserver for performance instead of window.resize events.
     */
    // =====================================================================
    // FROZEN COLUMNS - FLAT TABLE
    // =====================================================================
    // The pivot stamps a class on every sticky cell and writes `left` onto each
    // one from ~25 call sites. The flat table can hold tens of thousands of rows
    // and is re-rendered by a dozen paths (query, page flip, search, snapshot
    // load, column apply...), so this works the other way round: NOTHING is
    // written to a cell. One generated <style> carries :nth-child rules for the
    // frozen columns, so a row is frozen the moment any path renders it, and
    // the per-column `left` offsets live in those same rules.
    //
    // Hidden columns stay in the DOM as display:none cells, so "the first N
    // VISIBLE columns" are not the first N children: thead and tbody rules are
    // written per DOM index. The tfoot is the exception - updateTotalRow()
    // builds it from the VISIBLE columns only - so there the index is the
    // visible ordinal.
    //
    // Two observers keep it current with no call sites to maintain:
    //   - a MutationObserver on #tableHeader (index.php owns that element and
    //     nothing ever replaces it) sees a re-render, a reorder and a show/hide;
    //   - a ResizeObserver on the frozen <th>s and the wrapper sees every width
    //     change - page flip, search, density, font, window - and only the
    //     offsets are rewritten.
    // Everything is scoped under #results-wrapper: the grouped view is never
    // containerized and the pivot has its own sticky columns, so both are left
    // alone without a single mode check here.
    var _FRZ_SCOPE = '#results-wrapper #resultsTable';
    // The frozen block may take this share of the wrapper before it is paused
    // (three 350px columns on a laptop would otherwise leave nothing to scroll).
    // Two thresholds so a width hovering at the limit cannot flap.
    var _FRZ_PAUSE_AT = 0.6, _FRZ_RESUME_AT = 0.55;
    var _frzStyleEl = null;
    var _frzSig = null;          // what the <style> currently holds
    var _frzPaused = false;
    var _frzRaf = 0;
    var _frzRO = null, _frzMO = null;
    var _frzWatched = [];        // elements the ResizeObserver holds
    var _frzNote = null;         // what the status bar was last told (_frzNotify)

    function _frzStyle() {
        if (!_frzStyleEl || !_frzStyleEl.parentNode) {
            _frzStyleEl = document.createElement('style');
            _frzStyleEl.id = 'pnbFlatFreezeStyle';
            document.head.appendChild(_frzStyleEl);
        }
        return _frzStyleEl;
    }

    // The first N visible headers, left to right, each with its 1-based DOM
    // index - the :nth-child number every body row shares with the header.
    function _frzPickColumns(want) {
        var out = [];
        var row = document.getElementById('tableHeader');
        if (!row || !(want > 0)) return out;
        var ths = row.children, visible = 0, i;
        for (i = 0; i < ths.length; i++) if (ths[i].style.display !== 'none') visible++;
        var n = penumbraClampFrozenCols(want, visible);
        for (i = 0; i < ths.length && out.length < n; i++) {
            if (ths[i].style.display === 'none') continue;
            out.push({ th: ths[i], idx: i + 1 });
        }
        return out;
    }

    // The rule text for a set of frozen columns. Pure (no DOM), so the suite
    // can assert on it directly. `total` is the frozen block's width.
    function _frzBuildCss(cols, lefts, total) {
        if (!cols.length) return '';
        var S = _FRZ_SCOPE, out = [], body = [], foot = [], zebra = [], i;
        for (i = 0; i < cols.length; i++) {
            var d = cols[i].idx, v = i + 1;
            var h = S + ' > thead > tr > th:nth-child(' + d + ')';
            // :not([colspan]) keeps full-width rows out: a journal note row and
            // the footer's "View Last Page" row are each ONE cell, and that
            // cell is the first child.
            var b = S + ' > tbody > tr > td:nth-child(' + d + '):not([colspan])';
            var f = S + ' > tfoot > tr > td:nth-child(' + v + '):not([colspan])';
            out.push(h + ',' + b + ',' + f + '{position:sticky;left:' + lefts[i] + 'px}');
            // Leftmost is highest, as on the pivot: the offsets are floored, so
            // a column may sit a fraction of a pixel over its left neighbour's
            // edge, and the neighbour's border has to stay on top.
            out.push(b + ',' + f + '{z-index:' + (20 - i) + '}');
            // updateStickyHeaderOffset() writes an INLINE z-index on every flat
            // <th>, so only !important lifts the frozen ones above the headers
            // scrolling beneath them.
            out.push(h + '{z-index:' + (1020 - i) + ' !important}');
            body.push(b);
            foot.push(f);
            zebra.push(S + ' > tbody > tr.zebra-light > td:nth-child(' + d + ')',
                       S + ' > tbody > tr.zebra-dark > td:nth-child(' + d + ')');
        }
        // A sticky cell must be opaque or the columns scrolling beneath show
        // through it. These sit at ZERO specificity (:where) on purpose: the row
        // hover, every theme's own cell rules and anything format()/heatmap()
        // paints must all keep winning, and this only fills in a cell nothing
        // else has painted. The zebra colour lives on the <tr> (themes hard-code
        // it there), so the cell inherits it rather than naming a colour here.
        out.push(':where(' + body.join(',') + '){background-color:var(--bg-surface,#fff)}');
        out.push(':where(' + zebra.join(',') + '){background-color:inherit}');
        // The footer's fill is a gradient on the <tfoot> itself; hand it down
        // through the row so a frozen footer cell matches its neighbours.
        out.push(':where(' + S + ' > tfoot > tr){background:inherit}');
        out.push(':where(' + foot.join(',') + '){background:inherit}');
        // Edge on the last frozen column, same treatment as .pivot-last-sticky.
        var L = cols.length - 1;
        out.push(S + ' > thead > tr > th:nth-child(' + cols[L].idx + '),' + body[L] + ',' + foot[L] +
                 '{box-shadow:2px 0 4px var(--pnb-frz-shadow,rgba(0,0,0,.18));clip-path:inset(0 -6px 0 0)}');
        // Focus must not end up UNDER the frozen block (WCAG 2.4.11): tabbing to
        // a link in a cell that has scrolled beneath it makes the browser scroll
        // that cell "into view" - and without this, into view means flush with
        // the wrapper's edge, i.e. behind the frozen columns.
        if (total > 0) out.push('#results-wrapper{scroll-padding-left:' + Math.ceil(total) + 'px}');
        // Screen only: print lays the table out whole and must not inherit any
        // of this.
        return '@media screen{' + out.join('') + '}';
    }

    function _frzWatch(els) {
        if (!_frzRO) return;
        var i;
        for (i = 0; i < _frzWatched.length; i++) {
            if (els.indexOf(_frzWatched[i]) === -1) _frzRO.unobserve(_frzWatched[i]);
        }
        for (i = 0; i < els.length; i++) {
            if (_frzWatched.indexOf(els[i]) === -1) _frzRO.observe(els[i]);
        }
        _frzWatched = els;
    }

    // One synchronous pass: pick the columns, measure, write the rules if they
    // changed. Cheap and idempotent - every trigger just calls it.
    function _frzApply() {
        var cols = _frzPickColumns(penumbraFrozenColsWanted());
        var table = document.getElementById('resultsTable');
        var wrap = table ? table.closest('#results-wrapper') : null;
        var watch = [], i;
        for (i = 0; i < cols.length; i++) watch.push(cols[i].th);
        if (wrap && cols.length) watch.push(wrap);
        _frzWatch(watch);

        if (!cols.length) {
            _frzPaused = false;
            // (No <style> is created just to be emptied: most reports never
            // freeze anything.)
            if (_frzSig) _frzStyle().textContent = '';
            _frzSig = '';
            _spSyncFreezeControl();
            _frzNotify(cols);
            return;
        }

        var lefts = [], total = 0;
        for (i = 0; i < cols.length; i++) {
            lefts.push(Math.floor(total));
            total += cols[i].th.getBoundingClientRect().width;
        }
        // Nothing to measure: the flat table is display:none under a grouping
        // or a pivot, or not laid out yet. Leave the rules as they are - they
        // are inert while it is hidden - and let the ResizeObserver call back
        // when the headers get their boxes.
        if (!(total > 0)) return;

        var room = wrap ? wrap.clientWidth : 0;
        if (room > 0) {
            if (!_frzPaused && total > room * _FRZ_PAUSE_AT) _frzPaused = true;
            else if (_frzPaused && total < room * _FRZ_RESUME_AT) _frzPaused = false;
        }

        var css = _frzPaused ? '' : _frzBuildCss(cols, lefts, total);
        if (css !== _frzSig) {
            _frzSig = css;
            _frzStyle().textContent = css;
        }
        _spSyncFreezeControl();
        _frzNotify(cols);
    }

    // Tell the status bar's frozen-columns chip (#sbFrozen) when WHICH columns
    // are frozen, or whether the width guard has them paused, has changed - and
    // only then: a width change is what calls _frzApply() most of the time, and
    // it changes neither. An event rather than a call because the bar's code
    // lives in its own init further down and may not be there yet.
    function _frzNotify(cols) {
        var note = '';
        for (var i = 0; i < cols.length; i++) note += cols[i].idx + ',';
        if (_frzPaused) note += 'p';
        if (note === _frzNote) return;
        _frzNote = note;
        try { document.dispatchEvent(new CustomEvent('penumbra:freeze-changed')); } catch (e) {}
    }

    // ---- Breakdown tables (2026-10-01) ------------------------------------
    // A breakdown - the transactions behind a pivot cell or a chart point,
    // table.pnb-breakdown in an infobox - shows the flat table's visible columns
    // in its order, always led by a '#' of its own. In a pivot view the Settings
    // panel's Columns section configures exactly these tables, so Freeze reaches
    // them as well: the same DATA columns the flat table freezes, with the
    // breakdown's '#' riding in front (a '#' frozen in the flat table IS that
    // one). Same recipe as the flat table - one generated <style>, nothing
    // written to a cell, :where() fills, the width guard - scoped to each table
    // by a data-pnb-bd stamp. Its scroll box is the dialog's .infobox-content.
