        }

        menuItems.push('<div class="submenu-divider"></div>');
        // Removed red style from here
        menuItems.push(`<div class="submenu-item" data-action="delete-favorite">Remove from Favorites</div>`);

        // --- NEW: Delete Option (Red) for States Only ---
        if (fullData.type === 'state') {
            menuItems.push(`<div class="submenu-item" data-action="delete-state" style="color: var(--accent-danger, #c82333);">Delete State</div>`);
