                    }
                }

                // ── User "apply on load" pivot preset ────────────────────
                // A preset pinned to run on load (status-bar star / builder
                // checkbox) replaces the report's own default view in THIS
                // browser. Plain ?id= loads only: explicit ?state= links and
                // snapshot views (?snap=) show exactly what the sender /
                // snapshot encoded. The default stashes above stay intact so
                // the chip's "Restore default" can undo the override, and the
                // pending-pivot handler falls back to them if the preset no
                // longer validates against the report's columns.
                try {
                    // (?snapcmp= boots straight into a comparison view, which
                    // tears any pivot down again - skip the preset churn.)
                    if (source === "preloaded ID" && !urlParams.has('snap') && !urlParams.has('snapcmp') && !urlParams.has('livecmp') && !_penumbraTablelessEmbed()) {
                        var _olPivot = (typeof _getOnLoadPivotPreset === 'function') ? _getOnLoadPivotPreset() : null;
                        if (_olPivot) {
                            pendingPivotSettings = _olPivot.settings;
                            // The preset wins over a default GROUP view too; the
                            // grouping chip still offers its own restore via the
                            // _reportDefaultGroup stash.
                            pendingGroupByColumn = null;
                            pendingGroupAgg = null;
                            window._pivotOnLoadPending = _olPivot.name;
                        } else {
                            // A pinned GROUP preset claims the load the same way.
                            // These two branches are mutually exclusive for free:
                            // they read ONE 'layout' pin slot, so at most one of
                            // them can ever resolve - no guard needed beyond this
                            // else, and no way for a user to arm both.
                            var _olGroup = (typeof _getOnLoadGroupPreset === 'function') ? _getOnLoadGroupPreset() : null;
                            if (_olGroup && _olGroup.settings &&
                                (_olGroup.settings.levels || []).length) {
