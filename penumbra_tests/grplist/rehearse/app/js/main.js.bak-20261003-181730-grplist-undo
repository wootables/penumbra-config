    /**
 * Safely evaluates a basic mathematical expression string.
 * It uses a regex to validate the input, ensuring only safe characters are evaluated.
 * @param {string} expression The mathematical string to evaluate.
 * @returns {number|string} The result of the calculation, or the original string if invalid.
 */
    function safeEvaluateMathExpression(expression) {
        try {
            // Validate the expression to ensure it only contains safe mathematical characters.
            // eE are IN the set so SCIENTIFIC NOTATION survives: calc(1e3 + 1) used
            // to fail this test and yield '[Invalid Math]' while engine B (which
            // strips to [0-9eE+\-*/%.() ], ~main.js:51786) and engine C both
            // computed 1001. Engine B already learned this - its own comment
            // records calc(2e3 + 1) coming out as 24 before eE was kept.
            // Still safe: e/E are the ONLY letters admitted, so no useful
            // identifier (eval, alert, window, Function) is spellable, and a bare
            // `e` is undefined - new Function throws and the catch below returns
            // the original string. Found 2026-08-29 when engine A joined the
            // parity harness (case num_calc_exponent).
            if (typeof expression !== 'string' || !/^[0-9eE+\-*/%().\s]+$/.test(expression.trim())) {
                // If it contains anything else (like letters), it's not a pure math expression.
                return expression;
            }
            // If it passes the test, it's safe to use new Function for evaluation.
            return new Function(`return ${expression}`)();
        } catch (e) {
            // If the expression is malformed (e.g., "5 *"), return the original string.
            return expression;
        }
    }

    // ONE source of truth for the aggregate function names a format() condition may
    // call. THREE sites need the same list: the two gates that decide whether a
    // condition is an aggregate expression at all, and the evaluator's own
    // substitution regex below. When the list drifted, every aggregate added after
    // it went unrecognized - and the pivot header gate does not fall back, so it
    // skipped evaluation and applied the style UNCONDITIONALLY, while the very same
    // rule silently never fired in scheduled email. Declared as hoisted functions so
    // placement in the closure can never matter.
    // Longest names first: `count` must not shadow `count_filled`.
    // Twin: cf_agg_fn_names() in schedule_runner.php - keep the two lists identical.
    function penumbraCfAggFnNames() {
        return 'count_filled|count_blank|count|sum|avg|min|max|distinct|median|mode|stddev|range|antimode|wavg|p\\d{1,2}';
