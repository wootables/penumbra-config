                var winW = $(window).width();
                var winH = $(window).height();
                var leftPct = (ui.position.left / winW) * 100;
                var topPct = (ui.position.top / winH) * 100;

                // Clamp percentages to safe range
                leftPct = Math.max(0, Math.min(leftPct, 95));
                topPct = Math.max(0, Math.min(topPct, 90));

                localStorage.setItem(FLOATING_BTN_POS_KEY, JSON.stringify({
                    leftPct: leftPct,
                    topPct: topPct
                }));

                // Apply final position using left/top (draggable already sets these)
                $container.css({ right: 'auto', bottom: 'auto' });
            }
        });

