        }
    }

    // ════════════════════════════════════════════════════════════════════
    //  VIZ BUILDER CHROME  ->  chart-type carousel + settings tabs
    //  (2026-08-27)
    //
    //  The Builder used to be a 10-wide grid of type tiles that wrapped to
    //  two rows, three dense config rows, and eight conditional "X only"
    //  strips that PUSHED THE PREVIEW DOWN whenever one appeared. Now the
    //  types are a one-row carousel, the settings are four tabs, and the
    //  fourth tab is CONTEXTUAL - it renames itself to the selected chart
    //  type and owns that type's strip. That is what lets .viz-panes hold a
    //  fixed height, which is what stops the preview from moving.
    //
    //  None of the per-type enable/disable logic below this block changed:
    //  the fields were re-parented in index.php, keeping every #viz* id, and
    //  the chart-type handler still does hide-all-then-show-one on the strip
    //  ids exactly as before.
    // ════════════════════════════════════════════════════════════════════

    // Types that own a strip in the contextual tab. Anything NOT listed here
    // has no per-type settings, and the tab shows #vizTypeNoOptions instead
    // of opening on an empty box. Keep in sync when a chart type is added.
    var VIZ_TYPE_STRIPS = {
        combo: '#vizComboRow',
        butterfly: '#vizButterflyRow',
        scatter: '#vizBubbleRow',
        funnel: '#vizFunnelRow',
        gauge: '#vizGaugeRow',
        bullet: '#vizGaugeRow',
        box: '#vizBoxRow',
        gantt: '#vizGanttRow',
        map: '#vizMapRow'
    };

    // ════════════════════════════════════════════════════════════════════
    //  PER-TYPE CAPABILITY TABLE  (2026-08-27)
    //
    //  Which controls a chart type can actually use. This exists because the
    //  same lists were written out TWICE - once in the .viz-type-option click
    //  handler and once in restoreVizConfig() - and the two copies had drifted:
    //
    //    * Trend Line   restoreVizConfig never disabled it at all, so loading a
    //                   saved pie / map / gauge / box chart left a live Trend
    //                   dropdown on a chart whose renderer ignores it.
    //    * Ref. Line    the restore copy was missing 'map', so a restored map
    //                   offered a reference line the click path disables.
    //    * Horizontal   the restore copy read ['bar','line','area'] while the
    //                   click path allows bar/line/box AND re-enables histogram,
    //                   so restoring a box plot or histogram silently lost it.
    //
    //  Both paths now read THESE lists. Add a chart type here once, not twice.
    //  (Keep 'area' in HORIZONTAL: it is the legacy alias a saved line+fill
    //  chart still restores under.)
    // ════════════════════════════════════════════════════════════════════
    var VIZ_NO_GROUP = ['pie', 'doughnut', 'scatter', 'radar', 'butterfly', 'histogram', 'waterfall', 'funnel', 'gauge', 'bullet', 'box', 'gantt', 'map'];
    var VIZ_NO_OTHER_BUCKET = ['scatter', 'radar', 'histogram', 'gauge', 'bullet', 'gantt', 'map'];
    var VIZ_NO_AXIS_LABELS = ['pie', 'doughnut', 'radar', 'treemap', 'funnel', 'gauge', 'map'];
    var VIZ_NO_Y_RANGE = ['pie', 'doughnut', 'radar', 'treemap', 'funnel', 'gantt'];
    var VIZ_BAR_LIKE = ['bar', 'histogram', 'combo', 'butterfly', 'waterfall', 'bullet'];
    var VIZ_NO_TREND = ['pie', 'doughnut', 'radar', 'treemap', 'scatter', 'histogram', 'waterfall', 'funnel', 'gauge', 'bullet', 'box', 'gantt', 'map'];
    var VIZ_NO_REFLINE = ['pie', 'doughnut', 'radar', 'treemap', 'waterfall', 'butterfly', 'funnel', 'map'];
    // Log Scale only ever does anything through
    // `config.options.scales[valueAxis].type = 'logarithmic'`, so a type with no
    // linear value axis cannot use it. The first six were already gated; pie,
    // doughnut, radar, gauge, map and gantt were NOT, and offered a live
    // checkbox that silently changed nothing (found by sweeping all 17 types
    // 2026-08-27).
    var VIZ_NO_LOG_SCALE = ['histogram', 'butterfly', 'treemap', 'waterfall', 'funnel', 'box',
        'pie', 'doughnut', 'radar', 'gauge', 'map', 'gantt'];
    // Why each type cannot take one - shown on the dimmed chip so it explains
    // itself instead of just greying out. Shared by the click and restore paths.
    var VIZ_LOG_SCALE_REASONS = {
        histogram: 'Disabled - Histogram frequency counts are computed automatically.',
        butterfly: 'Disabled - Butterfly charts use negative values on the left side.',
        treemap: 'Disabled - Treemap charts use rectangle area, not a Y-axis scale.',
        waterfall: 'Disabled - Waterfall charts use floating bars that can cross zero.',
        funnel: 'Disabled - Funnel bars are centred on a symmetric axis, not a scale that can be logged.',
        box: 'Disabled - box whiskers can reach zero or below.',
        pie: 'Disabled - a pie has no value axis; slice angle is the value.',
        doughnut: 'Disabled - a doughnut has no value axis; segment angle is the value.',
        radar: 'Disabled - a radar chart uses one radial axis per dimension, not a Y scale.',
        gauge: 'Disabled - a gauge draws one value on a fixed track, not on a scale you can log.',
        map: 'Disabled - a map has no value axis; the value is the shading. Use Shade Bands instead.',
        gantt: 'Disabled - a Gantt chart\'s value axis is time, which cannot be logarithmic.'
    };
    function vizLogScaleReason(t) {
        return VIZ_LOG_SCALE_REASONS[t] || 'Disabled - this chart type has no logarithmic value axis.';
    }
    var VIZ_HORIZONTAL = ['bar', 'line', 'area', 'box', 'histogram'];

    // Types whose applier FORCES the legend off, because each draws ONE series
    // and a legend would list a single meaningless entry (penumbra_charts.js:
    // funnel ~177, gauge/bullet ~598, box ~780, gantt ~1023); treemap labels
    // its tiles in place instead. The dropdown was dimmed for treemap/funnel/
    // gauge/bullet in the CLICK path and for treemap ALONE in the restore path,
    // so a saved funnel, gauge, bullet, box or Gantt reopened with a live
    // Legend dropdown that could not move the chart. Same lesson as the log /
    // trend lists above: ONE list, read by both paths.
    var VIZ_NO_LEGEND = ['treemap', 'funnel', 'gauge', 'bullet', 'box', 'gantt'];
    var VIZ_NO_LEGEND_REASONS = {
        treemap: 'Disabled - a treemap labels every tile in place, so it has no legend.',
        funnel: 'Disabled - each bar is one stage of a single series.',
        gauge: 'Disabled - a gauge draws one value, so a legend would list one entry.',
        bullet: 'Disabled - a bullet draws one measure per row against a shared scale.',
        box: 'Disabled - a box plot draws one distribution per category, not a series per colour.',
        gantt: 'Disabled - a Gantt draws one bar per task, not a series per colour.'
    };
    function vizLegendReason(t) {
        return VIZ_NO_LEGEND_REASONS[t] || 'Disabled - this chart type draws a single series.';
    }
    // Number Format ({"format":{...}}) reaches chart labels through
    // penumbraFormatChartNumber. A Gantt's labels are DATES and a day count,
    // not a measure, so a currency prefix or a compact 1.2M ladder has nothing
    // to act on - dim the row rather than leave four live controls that cannot
    // change the chart.
    var VIZ_NO_NUM_FORMAT = ['gantt'];

    // The tile's own <strong> is the single source of truth for a type's
    // display name, so the tab label can never drift from the carousel.
    function vizTypeLabel(type) {
        var $s = $('.viz-type-option[data-type="' + type + '"] strong').first();
        if ($s.length) return $s.text();
        return type ? type.charAt(0).toUpperCase() + type.slice(1) : 'Chart';
    }

    // Arrows STOP at each end (no wrap, by design): a disabled arrow is the
    // only cue that you have reached the last of the 17 types.
    function vizSyncCarousel() {
        var el = document.getElementById('vizTypeSelector');
        if (!el) return;
        var max = el.scrollWidth - el.clientWidth;
        var at = max <= 2 ? 'none'
            : (el.scrollLeft <= 2 ? 'start'
                : (el.scrollLeft >= max - 2 ? 'end' : ''));
        $('#vizCarouWin').attr('data-at', at);
        $('#vizCarouPrev').prop('disabled', at === 'none' || at === 'start');
        $('#vizCarouNext').prop('disabled', at === 'none' || at === 'end');

        // Position rail: thumb width = the visible fraction of the row, thumb
        // offset = how far through the scrollable range we are. With 8 of 17
        // tiles on screen this is the only indication of how much is left.
        var $thumb = $('#vizCarouWin .viz-carou-rail i');
        if ($thumb.length) {
            var visible = el.scrollWidth ? (el.clientWidth / el.scrollWidth) : 1;
            var pct = Math.max(6, Math.min(100, visible * 100));
            $thumb.css({
                width: pct + '%',
                left: (max > 0 ? (el.scrollLeft / max) * (100 - pct) : 0) + '%'
            });
            // The rail is a real scroll bar now (see the pointer handlers by
            // the arrow wiring), so it reports its position like one.
            $thumb.parent().attr('aria-valuenow', max > 0 ? Math.round((el.scrollLeft / max) * 100) : 0);
        }
    }

    // One tile per arrow press (plus the grid gap), not a whole page: paging
    // by clientWidth swapped the entire row out at once and lost the reader's
    // place. Measured off a real tile so it tracks the responsive breakpoints.
    function vizCarouStep(el) {
        var tile = el.querySelector('.viz-type-option');
        if (!tile) return el.clientWidth;
        var gap = parseFloat(getComputedStyle(el).columnGap || getComputedStyle(el).gap || '5') || 5;
        return Math.max(40, tile.getBoundingClientRect().width + gap);
    }

    // THE selected tile must be visible. Every path that sets .active WITHOUT
    // a user click has to call this, or a restored preset silently scrolls the
    // active type off-screen and the Builder looks broken. Three such paths:
    // the open default, restoreVizConfig(), and resetVisualizationForm().
    function vizRevealActiveType() {
        var el = document.querySelector('#vizTypeSelector .viz-type-option.active');
        if (el && typeof el.scrollIntoView === 'function') {
            el.scrollIntoView({ block: 'nearest', inline: 'center' });
        }
        vizSyncCarousel();
    }

    // Rename the contextual tab to the selected type and say whether anything
    // is actually behind it (the dot), so a tab is never a mystery box.
    function vizSyncTypeTab(type) {
        var label = vizTypeLabel(type);
        var hasStrip = !!VIZ_TYPE_STRIPS[type];
        $('#vizTabTypeLabel').text(label + ' options');
        $('#vizTabType').attr('title', hasStrip
            ? 'Settings that belong to ' + label + ' charts'
            : label + ' charts have no settings of their own');
        $('#vizTabTypeDot').prop('hidden', !hasStrip);
        $('#vizTypeNoOptionsTitle').text(label + ' has no settings of its own');
        $('#vizTypeNoOptions').toggle(!hasStrip);
    }

    // ── Admin "Actions" menu ────────────────────────────────────────────
    // The five snippet buttons live in a popover instead of the bar, because
    // together they pushed the docked bar onto a second line and that height
    // came straight out of the preview. Their ids, classes and handlers are
    // unchanged, and updateVizAdminButtons() still toggles each independently.
    function vizCloseActionsMenu() {
        $('#vizActionsPanel').prop('hidden', true);
        $('#vizActionsMenu').removeClass('is-open');
        $('#vizActionsBtn').attr('aria-expanded', 'false');
    }

    // If every item is hidden the trigger must hide too, or the bar offers a
    // menu that opens on nothing.
    function vizSyncActionsMenu() {
        var $panel = $('#vizActionsPanel');
        if (!$panel.length) return;
        var shown = $panel.children('button').filter(function () {
            return this.style.display !== 'none';
        }).length;
        $('#vizActionsMenu').toggle(shown > 0);
        if (!shown) vizCloseActionsMenu();
    }
    window.vizSyncActionsMenu = vizSyncActionsMenu;

    // data-viz-tab="appearance" -> #vizPaneAppearance
    function vizActivateTab(name) {
        if (!name) return;
        var paneId = 'vizPane' + name.charAt(0).toUpperCase() + name.slice(1);
        $('#visualizationLightbox .viz-tab').each(function () {
            var on = $(this).attr('data-viz-tab') === name;
            $(this).toggleClass('active', on).attr('aria-selected', on ? 'true' : 'false');
        });
        $('#visualizationLightbox .viz-pane').each(function () {
            $(this).toggleClass('active', this.id === paneId);
        });
    }

    // Called from the chart-type click handler and from every programmatic
    // path, so the carousel, the contextual tab and the preview always agree.
    function vizSyncTypeChrome(type) {
        vizSyncTypeTab(type);
        vizRevealActiveType();
        // On OPEN this runs while the lightbox is still display:none, so the
        // carousel measures clientWidth 0, concludes the row does not overflow
        // and disables BOTH arrows. Re-measure after the dialog is painted.
        // (The ResizeObserver below is meant to cover this, but it does not
        // fire reliably for a none -> flex ancestor, so do not depend on it.)
        setTimeout(vizRevealActiveType, 0);
        setTimeout(vizRevealActiveType, 250);
    }
    window.vizSyncTypeChrome = vizSyncTypeChrome;

    // A type whose extra required field is empty draws NOTHING - which, now
    // that picking a type can scroll the carousel, reads as "that button did
    // nothing at all". So guess the missing field.
    //
    // ONLY ever fills a field that is still EMPTY: this runs on a user click,
    // never from restoreVizConfig(), so a saved preset is reproduced exactly
    // and a value the user typed is never overwritten.
    function vizPrefillForType(type) {
        var xVal = $('#vizXAxis').val() || '';
        var yVal = $('#vizYAxis').val() || '';

        // GANTT: Y-Axis is the START date, #vizGanttEnd the END date. With no
        // end column not one bar can be drawn.
        if (type === 'gantt' && !$('#vizGanttEnd').val()) {
            var start = String(yVal).toUpperCase();
            var guess = '';
            var $opts = $('#vizGanttEnd option');
            // prefer a column that actually names itself an end/finish date...
            $opts.each(function () {
                var v = $(this).val();
                if (guess || !v || v.toUpperCase() === start) return;
                if (/END|STOP|FINISH|CLOSE|COMPLET|EXPIR|THRU/i.test(v)) guess = v;
            });
            // ...otherwise any other date-looking column.
            if (!guess) {
                $opts.each(function () {
                    var v = $(this).val();
                    if (guess || !v || v.toUpperCase() === start) return;
                    if (/DATE|_DT$|_ON$/i.test(v)) guess = v;
                });
            }
            if (guess) $('#vizGanttEnd').val(guess);
        }

        // COMBO / BUTTERFLY: initComboSeriesUI seeds two rows whose column is
        // '', so the preview stays empty until the user fills them in by hand.
        // Seed row 1 from the Y-Axis they already picked. (_syncFirstComboRow
        // looks like it does this but is dead code - never called, and it
        // early-returns on a .viz-combo-locked class nothing ever sets.)
        if (type === 'combo' || type === 'butterfly') {
            var $rows = $((type === 'combo' ? '#vizComboSeriesList' : '#vizButterflySeriesList')
                + ' .viz-combo-series-row');
            $rows.each(function (i) {
                var $col = $(this).find('select.viz-combo-col');
                if (!$col.length || $col.val()) return;
                var want = (i === 0) ? (yVal || xVal) : (xVal || yVal);
                if (want && $col.find('option').filter(function () { return this.value === want; }).length) {
                    $col.val(want);
                }
            });
        }
    }

    $(function () {
        // scroll does not bubble, so this one binds directly. #vizTypeSelector
        // is static markup in index.php and main.js is deferred, so it exists.
        var el = document.getElementById('vizTypeSelector');
        if (el) el.addEventListener('scroll', vizSyncCarousel, { passive: true });
        $(window).on('resize.vizCarou', vizSyncCarousel);
        // The lightbox is display:none until it opens, so any sync that runs
        // during the open handler measures clientWidth 0, decides the row does
        // not overflow, and disables BOTH arrows. Watching the element's box
        // re-syncs the moment it actually gets laid out - and covers density
        // and theme changes too, which a one-off timeout would not.
        if (el && typeof ResizeObserver === 'function') {
            new ResizeObserver(function () { vizSyncCarousel(); }).observe(el);
        }

        // The position rail doubles as a SCROLL BAR (2026-09-04). It used to be
        // read-only - a 2px line that said how far along you were with no way
        // to act on it, so the only ways across 17 tiles were the one-tile
        // arrows or a horizontal wheel most mice do not have. Click the track
        // to jump there (the thumb centres on the click), drag the thumb to
        // scroll. Pointer capture keeps the drag alive when the cursor leaves
        // the 6px track, which it does within the first few pixels of motion.
        // Scale: the thumb travels railWidth/scrollWidth px per scrolled px,
        // so one thumb px is scrollWidth/railWidth scrolled px.
        var _vizRailDrag = null;
        $(document)
            .on('pointerdown.vizRail', '#vizCarouWin .viz-carou-rail', function (e) {
                var t = document.getElementById('vizTypeSelector');
                if (!t || (e.button !== undefined && e.button !== 0)) return;
                var max = t.scrollWidth - t.clientWidth;
                if (max <= 0) return;
                var r = this.getBoundingClientRect();
                var thumb = this.querySelector('i');
                var tr = thumb ? thumb.getBoundingClientRect() : null;
                var onThumb = !!(tr && e.clientX >= tr.left && e.clientX <= tr.right);
                if (!onThumb) {
                    var frac = (e.clientX - r.left) / Math.max(1, r.width);
                    t.scrollLeft = Math.max(0, Math.min(max, frac * t.scrollWidth - t.clientWidth / 2));
                }
                _vizRailDrag = { x: e.clientX, from: t.scrollLeft, scale: t.scrollWidth / Math.max(1, r.width) };
                this.classList.add('is-dragging');
                try { this.setPointerCapture(e.pointerId); } catch (err) { }
                vizSyncCarousel();
                e.preventDefault();
            })
            .on('pointermove.vizRail', '#vizCarouWin .viz-carou-rail', function (e) {
                if (!_vizRailDrag) return;
                var t = document.getElementById('vizTypeSelector');
                if (!t) return;
                var max = t.scrollWidth - t.clientWidth;
                t.scrollLeft = Math.max(0, Math.min(max, _vizRailDrag.from + (e.clientX - _vizRailDrag.x) * _vizRailDrag.scale));
                vizSyncCarousel();
            })
            .on('pointerup.vizRail pointercancel.vizRail', '#vizCarouWin .viz-carou-rail', function (e) {
                if (!_vizRailDrag) return;
                _vizRailDrag = null;
                this.classList.remove('is-dragging');
                try { this.releasePointerCapture(e.pointerId); } catch (err) { }
                vizSyncCarousel();
            })
            .on('click.vizCarou', '#vizCarouPrev, #vizCarouNext', function () {
                var t = document.getElementById('vizTypeSelector');
                if (!t) return;
                var dir = this.id === 'vizCarouNext' ? 1 : -1;
                var max = t.scrollWidth - t.clientWidth;
                var to = Math.max(0, Math.min(max, t.scrollLeft + dir * vizCarouStep(t)));
                if (typeof t.scrollTo === 'function') t.scrollTo({ left: to, behavior: 'smooth' });
                else t.scrollLeft = to;
                // Do not wait on the scroll event to update the arrows and the
                // rail: it is coalesced (and in a background tab, throttled away
                // entirely), which leaves an arrow disabled when it should not be.
                vizSyncCarousel();
                setTimeout(vizSyncCarousel, 320);
            })
            .on('click.vizTabs', '#visualizationLightbox .viz-tab', function () {
                vizActivateTab($(this).attr('data-viz-tab'));
            })
            .on('click.vizActions', '#vizActionsBtn', function (e) {
                e.stopPropagation();
                var open = $('#vizActionsPanel').prop('hidden');
                $('#vizActionsPanel').prop('hidden', !open);
