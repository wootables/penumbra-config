    // Escape anywhere while the card is open (the primary capture handler's step
    // A0.74 calls this, in the main tab and - replayed - in the pop-out console).
    // Focus goes back to the icon QUIETLY: its focusin would reopen the card.
    var _schedRecipQuietFocus = false;
    window._schedRecipAlertEscape = function () {
        _schedRecipCardClose();
        var icon = _schedRecipIconEl();
        if (icon && $(icon).is(':visible')) {
            _schedRecipQuietFocus = true;
