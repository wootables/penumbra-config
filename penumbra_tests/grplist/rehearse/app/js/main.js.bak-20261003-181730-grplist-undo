    // --- NEW: Helper to populate parent prompt selectors ---
    function populateParentPromptSelectors() {
        const query = editor.getValue() + "\n" + snippetEditor.getValue();
        const promptRegex = /\[\s*PROMPT[^\]]*\]/gi;
        const $select = $('#promptResultIfName');
        const currentSelection = $select.val();
        // Preserve selection if possible

        $select.empty().append('<option value="">-- Select Parent Prompt --</option>');

        // Use a map to store prompt definitions by name to access their options later
        const promptMap = new Map();

        // section= suggestions for the Section field: the sections this report
        // already uses, first spelling of each (names compare without case), so
        // a new prompt joins "Dates" rather than starting a "dates " of its own.
        const $sectionList = $('#promptSectionList').empty();
        const sectionsSeen = new Set();

        let match;
        while ((match = promptRegex.exec(query)) !== null) {
            try {
                const parsed = parsePrompt(match[0]);
                const sectionKey = promptSectionKey(parsed.section);
                if (sectionKey && !sectionsSeen.has(sectionKey)) {
                    sectionsSeen.add(sectionKey);
                    $sectionList.append(`<option value="${escapeHtml(String(parsed.section).trim())}"></option>`);
                }
                // A Date Range is left out: its answer is a pair of expressions
                // ("TODAY-30..TODAY"), not a value a child's resultif can usefully be
                // compared to. It can still BE a child - only not a parent.
                if (parsed.name && !penumbraIsDateRangeType(parsed.type)) {
                    const label = parsed.message || parsed.name;
                    // Prevent duplicates
                    if (!promptMap.has(parsed.name)) {
                        promptMap.set(parsed.name, parsed);
                        $select.append(`<option value="${escapeHtml(parsed.name)}">${escapeHtml(label)} (${escapeHtml(parsed.name)})</option>`);
                    }
                }
            } catch (e) { }
        }

        // If the previously selected parent still exists, re-select it
        if (currentSelection && promptMap.has(currentSelection)) {
            $select.val(currentSelection);
        }

        // Store the map on the select element for the change handler to use
        $select.data('promptMap', promptMap);
    }

    // --- NEW: Handler to update Expected Value datalist when parent changes ---
    $('#promptResultIfName').on('change', function () {
        const selectedName = $(this).val();
        const promptMap = $(this).data('promptMap');
        const $datalist = $('#parentPromptValues');
        $datalist.empty();

        if (selectedName && promptMap && promptMap.has(selectedName)) {
