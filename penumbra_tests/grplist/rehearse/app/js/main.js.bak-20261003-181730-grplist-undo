        var colId = $hdr.data('column');
        penumbraFillLazyColumns([colId]);   // a hidden level column's cells may be EMPTY (2026-09-30)
        // Resolve the cell POSITION once: header order matches cell order for
        // every data row, so the hot path is rowEl.cells[pos] rather than an
        // attribute query per row per level.
        var ths = document.querySelectorAll('#resultsTable > thead > tr#tableHeader th');
        var pos = -1;
        for (var i = 0; i < ths.length; i++) { if (ths[i] === $hdr[0]) { pos = i; break; } }
