        const rowCount = $sourceRows.length;
        if (rowCount === 0)
            return {
                content: "",
                rowCount: 0
            };

        const visibleColumnInfo = (isGrouped ? headersFromGroupView : $("#resultsTable > thead > tr#tableHeader th:visible").map(function () {
            return {
                id: $(this).data("column"),
                name: $(this).data('colname') || '#'
            };
        }).get())
        // Journal columns: drop the NOTES column (presence/count, not a value, like
        // grouping/pivot/API) and show a toggle column by its friendly label ("Done")
        // instead of the raw __JOURNAL_TOGGLE__ sentinel. Toggle CELL values are
        // filled with 1/0 by getCleanText above.
        .filter(function (info) {
            return !(window.Penumbra && window.Penumbra.journalIsNotesCol && window.Penumbra.journalIsNotesCol(String(info.name)));
        }).map(function (info) {
            var friendly = (window.Penumbra && window.Penumbra.journalFriendlyCol) ? window.Penumbra.journalFriendlyCol(info.name) : null;
            return friendly ? { id: info.id, name: friendly } : info;
        });

        // Faster exports (2026-09-30): find a row's cell by POSITION - every row
        // holds its cells in the same order ('#', then every column, hidden ones
        // included) - instead of a selector query per cell. A cell that is not
        // where the first row says falls back to the query.
        const _cellPos = Object.create(null);
        const _posRow = $sourceRows[0];
        if (_posRow && _posRow.cells) {
            for (let _ci = 0; _ci < _posRow.cells.length; _ci++) _cellPos[_posRow.cells[_ci].getAttribute('data-column')] = _ci;
        }
        const cellOf = (row, id) => {
            const p = _cellPos[id];
