            // 2. Remove the 'resultif' condition for the test. 
            // This tricks the engine into treating it as a normal prompt so it doesn't 
            // skip generation due to a missing parent answer.
            // Regex matches: "; resultif=... " or "resultif=...;" or just "resultif=..."
            const testPromptString = rawPromptString.replace(/;?\s*resultif=[^;\]]+/, '');

            // 3. Parse and Show Dialog using the CLEANED string
            const promptConfig = parsePrompt(testPromptString);
            const result = await showPromptDialog(promptConfig);

            if (result !== null) {
                // 4. Temporarily store the answer using the key generated from the CLEANED string
                const storageKey = getPromptStorageKey(testPromptString);
                localStorage.setItem(storageKey, JSON.stringify(result));

                // 5. Run processPrompts in "Secure Mode" to get the SQL.
                //
                // A FORCED default needs help here. With dialogs off, processPrompts
                // reads a stored answer only once the forced default counts as
                // "applied" for this page session - and applying it is something
                // only the dialog-on path does. So for a forced prompt this run
                // ignored the answer the tester had just given AND never applied the
                // default: every older type bound NULL and the button reported
                // "Success, SQL generates as: NULL"; a Date Range (which refuses an
                // unanswered range rather than bind NULL) failed outright with
                // PROMPT_REQUIRED. Mark the key applied for the length of the test
                // so what is shown is the SQL for the answer that was just picked,
                // then put the session state back exactly as it was.
                const hadForcedApplied = _forceDefaultApplied.has(storageKey);
                _forceDefaultApplied.add(storageKey);
                let resultObj;
                try {
                    resultObj = await processPrompts(testPromptString, false, true);
                } finally {
                    if (!hadForcedApplied) _forceDefaultApplied.delete(storageKey);
                    // The temporary answer must not outlive a test that threw.
                    localStorage.removeItem(storageKey);
                }

                let displaySql;

                // Handle both Object (Secure) and String (Insecure/Fallback) responses
                if (resultObj && typeof resultObj === 'object' && resultObj.query_template !== undefined) {
                    displaySql = resultObj.query_template;

                    // Interpolate params if they exist
                    if (Array.isArray(resultObj.params)) {
                        resultObj.params.forEach((param, index) => {
                            let val = 'NULL';
                            if (param !== null && param !== undefined) {
                                // Quote strings, leave numbers as-is
                                val = (typeof param === 'string') ? `'${param.replace(/'/g, "''")}'` : String(param);
                            }
                            // Replace :p1, :p2, etc.
                            displaySql = displaySql.split(`:p${index + 1}`).join(val);
                        }
                        );
                    }
                } else if (typeof resultObj === 'string') {
                    displaySql = resultObj;
                } else {
                    displaySql = '[Error: Could not generate SQL response]';
                }

                // 6. Clean up the temporary storage
                localStorage.removeItem(storageKey);

                $('#promptTestOutput').html(`Success, SQL generates as: <code>${escapeHtml(displaySql)}</code>`).fadeIn();
            }
        } catch (err) {
            console.error("Test prompt failed:", err);
            showPromptGeneratorMessage(err.message, true);
        }
    });

