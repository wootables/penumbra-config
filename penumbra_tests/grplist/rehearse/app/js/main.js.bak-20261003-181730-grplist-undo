                $note.html('Your main query looks like <strong>MS-SQL</strong>, so the JSON transport will be ignored at run time and the rows inlined as usual. The tag is still valid - it just has no effect here.').show();
            } else if (getSubqueryType() === 'in') {
                $note.html('For an IN list the JSON transport is used only once the list passes <strong>1,000 values</strong>; smaller lists are inlined as a plain comma list either way.').show();
            } else {
                $note.hide().empty();
            }
        } else {
            $note.hide().empty();
        }
        refreshSubqueryPreview();
    }

