    // search-summary preview counts them independently, and a labeller that
    // drifted between the two would report matches for groups the table on
    // screen does not actually have.
    function groupBucketSpec(token, rowsForAutoWidth) {
        var s = String(token || '');
        if (s.indexOf(':') === -1) return null;
        var spec = pivotParseFieldToken(s);
        if (!spec.split) return null;
        var split = spec.split;
