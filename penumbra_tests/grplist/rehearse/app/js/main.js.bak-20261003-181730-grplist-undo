        }
        } catch (err) {
            // Defense-in-depth: surface any unexpected failure instead of
            // silently aborting (the handler previously had no error handling,
            // so a thrown exception left the dialog open with no feedback).
            console.error('Copy action failed:', err);
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Copy failed: " + escapeHtml(err && err.message ? err.message : String(err)) + "</p>");
