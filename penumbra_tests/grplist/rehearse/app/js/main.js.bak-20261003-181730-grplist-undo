        // getQuery(), not editor.getValue(): the panel is reachable in non-admin
        // mode, where CodeMirror was never initialized.
        var promptMsg = 'Enter the table name or alias to use as a prefix (optional):';
        var detectedAlias = prefillValue ? _spAliasForTable(getQuery(), prefillValue) : '';
        if (detectedAlias) {
            // No quotes around the alias: it may already carry its own ("My Alias").
            promptMsg += '\n\nThe query aliases ' + prefillValue + ' as ' + detectedAlias + ', so the alias is pre-filled.';
            prefillValue = detectedAlias;
