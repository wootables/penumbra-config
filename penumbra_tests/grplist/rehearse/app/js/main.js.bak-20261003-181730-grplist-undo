                promptParts.push(`no=${$('#promptFalse').val()}`);
            if ($('#promptOkOnly').is(':checked'))
                promptParts.push('okonly');
        }
        if (type === 'text' || (type === 'date' || type === 'date-range')) {
            let validationParts = [];
            const regexVal = $('#promptValidate').val().trim();
            if (regexVal)
                validationParts.push(regexVal);

            if (type === 'text') {
                const rangeMin = $('#promptRangeMin').val().trim();
                const rangeMax = $('#promptRangeMax').val().trim();
                if (rangeMin && rangeMax) {
                    validationParts.push(`range(${rangeMin},${rangeMax})`);
                }
            }

            if (type === 'date' || type === 'date-range') {
                const minDateVal = $('#promptMinDate').val().trim();
                const maxDateVal = $('#promptMaxDate').val().trim();
                let minIso, maxIso;

                // Relaxed parsing for Test button as well
                const parseFormats = ['DD-MMM-YY', 'YYYY-MM-DD', 'D-MMM-YY'];

                if (minDateVal) {
                    const m = moment(minDateVal, parseFormats, false);
                    minIso = m.isValid() ? m.format('YYYY-MM-DD') : minDateVal;
                    validationParts.push(`min_date(${minIso})`);
                }

                if (maxDateVal) {
                    const m = moment(maxDateVal, parseFormats, false);
                    maxIso = m.isValid() ? m.format('YYYY-MM-DD') : maxDateVal;
                    validationParts.push(`max_date(${maxIso})`);
                }

                if (minIso && maxIso && minIso > maxIso) {
                    throw new Error('Min Date cannot be after Max Date.');
                }
            }

            if (validationParts.length > 0) {
                promptParts.push(`validate=${validationParts.join(',')}`);
                // VErrorMessage is separate, so it stays
                if ($('#promptVErrorMessage').val()) {
                    promptParts.push(`verrormessage=${$('#promptVErrorMessage').val()}`);
                }
            }
        }

        const template = $('#promptTemplate').val().trim();
        if (template) {
            // Always wrap template in double quotes for safety
            promptParts.push(`template="${template.replace(/"/g, '\\"')}"`);
        }

        const resultIfName = $('#promptResultIfName').val().trim();
        const resultIfValue = $('#promptResultIfValue').val().trim();
        if (resultIfName && resultIfValue) {
            promptParts.push(`resultif=${resultIfName}:${resultIfValue}`);
        }

        return `[${promptParts.join(';')}]`;
    });

