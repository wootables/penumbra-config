            || head.indexOf('gold') !== -1) return 'warn';         // NOTICE: / INFO: / exploration
        return 'info';
    }

    // Inline SVGs, NOT sprite <use> refs: the pop-out console's document has no
    // copy of the #pnbi-* symbol block, and cross-document use() never resolves.
    const _PNB_TOAST_ICONS = {
        ok:   '<svg class="pnb-toast-ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7-8"/></svg>',
        err:  '<svg class="pnb-toast-ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3v6"/><circle cx="8" cy="12.5" r="0.8" fill="currentColor" stroke="none"/></svg>',
        warn: '<svg class="pnb-toast-ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2L14.5 13.5H1.5L8 2z"/><path d="M8 6.5v3"/></svg>',
        load: '<svg class="pnb-toast-ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 1.5A6.5 6.5 0 1 1 1.5 8"/></svg>',
        info: '<svg class="pnb-toast-ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 7v6"/><circle cx="8" cy="3.5" r="0.8" fill="currentColor" stroke="none"/></svg>'
    };

    // Lazy per-dock runtime (cards, queue, pause flag, rAF countdown loop),
    // stored on the dock element itself so the pop-out console's dock carries
    // its own state and handlers with zero registration bookkeeping.
    function _pnbToastDockState(dock) {
        if (dock._pnbT) return dock._pnbT;
        const st = dock._pnbT = {
            dock: dock,
            win: dock.ownerDocument.defaultView || window,
            cards: [], queue: [], paused: false, raf: 0, last: 0
        };
        // Hover or keyboard focus anywhere in the dock pauses every countdown.
        dock.addEventListener('mouseenter', function () { st.paused = true; });
        dock.addEventListener('mouseleave', function () { st.paused = false; });
        dock.addEventListener('focusin', function () { st.paused = true; });
        dock.addEventListener('focusout', function () { st.paused = false; });
        // Delegated close - cards are transient, the dock is not.
        dock.addEventListener('click', function (e) {
            const btn = e.target && e.target.closest ? e.target.closest('.pnb-toast-x') : null;
            if (!btn) return;
            const cardEl = btn.closest('.pnb-toast-card');
            for (let i = 0; i < st.cards.length; i++) {
                if (st.cards[i].el === cardEl) { _pnbToastClose(st, st.cards[i]); break; }
            }
        });
        return st;
    }

    function _pnbToastLive(st) {
        return st.cards.filter(function (c) { return !c.closing; });
    }

    function _pnbToastPill(st) {
        const pill = st.dock.querySelector('.pnb-toast-more');
        if (!pill) return;
        if (st.queue.length) {
            pill.textContent = '+' + st.queue.length + ' waiting';
            pill.title = 'More notifications are queued and will appear as space frees up.';
            pill.hidden = false;
        } else {
            pill.hidden = true;
        }
    }

    function _pnbToastLoop(st) {
        if (st.raf) return;
        st.last = Date.now();
        st.raf = st.win.requestAnimationFrame(function tick() {
            st.raf = 0;
            const now = Date.now();
            // Clamp dt: rAF freezes in hidden tabs, and time away should not
            // count against a toast - come back and it finishes its countdown.
            const dt = Math.min(250, now - st.last);
            st.last = now;
            if (!st.paused) {
                st.cards.slice().forEach(function (t) {
                    if (t.closing) return;
                    t.remaining -= dt;
                    if (t.barEl) t.barEl.style.transform = 'scaleX(' + Math.max(0, t.remaining / t.duration) + ')';
                    if (t.remaining <= 0) _pnbToastClose(st, t);
                });
            }
            if (st.cards.length) st.raf = st.win.requestAnimationFrame(tick);
        });
    }

    function _pnbToastFlash(t) {
        t.el.classList.remove('pnbt-flash');
        void t.el.offsetWidth;                     // restart the box-shadow transition
        t.el.classList.add('pnbt-flash');
        setTimeout(function () { t.el.classList.remove('pnbt-flash'); }, 420);
    }

    function _pnbToastBadge(t) {
        if (t.count > 1) {
            t.badgeEl.textContent = '×' + t.count;
            t.badgeEl.title = 'This notification fired ' + t.count + ' times in the last few minutes.';
            t.el.classList.add('pnbt-hascount');
        }
    }

    function _pnbToastSpawn(st, spec) {
        const doc = st.dock.ownerDocument;
        const el = doc.createElement('div');
        el.className = 'pnb-toast-card pnbt-' + spec.kind + (spec.pinned ? ' pnbt-pinned' : '');
        // role=alert (assertive) for errors, polite status for the rest -
        // inserting the node is what makes screen readers announce it.
        el.setAttribute('role', spec.kind === 'err' ? 'alert' : 'status');
        el.innerHTML = (_PNB_TOAST_ICONS[spec.kind] || _PNB_TOAST_ICONS.info)
            + '<span class="pnb-toast-msg"></span>'
            + '<span class="pnb-toast-count"></span>'
            + '<button type="button" class="pnb-toast-x" aria-label="Close" title="Close">&times;</button>'
            + '<span class="pnb-toast-bar" aria-hidden="true"></span>';
        const t = {
            el: el, key: spec.key, kind: spec.kind, count: spec.count || 1,
            duration: spec.duration, remaining: spec.duration, closing: false,
            msgEl: el.querySelector('.pnb-toast-msg'),
            badgeEl: el.querySelector('.pnb-toast-count'),
            barEl: el.querySelector('.pnb-toast-bar')
        };
        t.msgEl.innerHTML = spec.html;             // caller HTML, already DOMPurify'd
        _pnbToastBadge(t);
        st.dock.appendChild(el);                   // newest lands nearest the status bar
        el.classList.add('pnbt-enter');
        setTimeout(function () { el.classList.remove('pnbt-enter'); }, 30);
        st.cards.push(t);
        _pnbToastLoop(st);
        return t;
    }

    function _pnbToastClose(st, t) {
        if (t.closing) return;
        t.closing = true;
        t.el.classList.add('pnbt-leave');
        setTimeout(function () {
            if (t.el.parentNode) t.el.parentNode.removeChild(t.el);
            const i = st.cards.indexOf(t);
            if (i > -1) st.cards.splice(i, 1);
            // Promote the queue into the freed slot.
            if (st.queue.length && _pnbToastLive(st).length < PNB_TOAST_MAX) {
                _pnbToastSpawn(st, st.queue.shift());
            }
            _pnbToastPill(st);
        }, 180);
    }

    function _pnbToastClearDock(dock) {
        const st = dock && dock._pnbT;
        if (!st) return;
        st.cards.forEach(function (t) { if (t.el.parentNode) t.el.parentNode.removeChild(t.el); });
        st.cards = [];
        st.queue = [];
        if (st.raf) { try { st.win.cancelAnimationFrame(st.raf); } catch (err) { } st.raf = 0; }
        _pnbToastPill(st);
    }

    function show_text(text, duration = 8000) {
        // Sanitize but allow the styling spans/paragraphs call sites use
        const safeText = (typeof DOMPurify !== 'undefined') ? DOMPurify.sanitize(text) : text;
        const els = _pnbToastEls();
        if (!els.target) return;
        // The stack lives in the focused document only (matches the old strip):
        // cards lingering in the window the user is NOT looking at would never
        // be seen and never cleaned up.
        if (els.other) _pnbToastClearDock(els.other);

        const st = _pnbToastDockState(els.target);
        const kind = _pnbToastKind(safeText);
        // Loading toasts and long-duration announcements (snapshot key notices,
        // exploration mode) are deliberate every time - never dedupe them: an
        // echo cutting a 15s LOADING toast to 2.5s would strand the fetch, and
        // they also skip the queue rather than wait behind lesser toasts.
        const exempt = (kind === 'load') || duration >= PNB_TOAST_EXEMPT_MS;
        const now = Date.now();

        if (exempt) {
            const pinned = duration >= PNB_TOAST_EXEMPT_MS;
            _pnbToastSpawn(st, { html: safeText, kind: kind, duration: duration, key: null, count: 1, pinned: pinned });
            return;
        }

        const key = kind + '|' + safeText.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().toLowerCase();
        // Occasional sweep so a long session doesn't grow the registry.
        if (_pnbToastSeen.size > 60) {
            _pnbToastSeen.forEach(function (v, k) {
                if (now - v.last > PNB_TOAST_COALESCE_MS) _pnbToastSeen.delete(k);
            });
        }

        const live = _pnbToastLive(st).find(function (c) { return c.key === key; });
        if (live) {
            // Visible repeat -> bump ×N, restart the countdown, ring once.
            live.count++;
            live.remaining = live.duration;
            _pnbToastBadge(live);
            _pnbToastFlash(live);
            _pnbToastSeen.set(key, { count: live.count, last: now });
            return;
        }

        const seen = _pnbToastSeen.get(key);
        const spec = (seen && (now - seen.last) < PNB_TOAST_COALESCE_MS)
            // Repeat of a recently-closed toast -> brief echo carrying the tally.
            ? { html: safeText, kind: kind, duration: PNB_TOAST_ECHO_MS, key: key, count: seen.count + 1, pinned: false }
            : { html: safeText, kind: kind, duration: duration, key: key, count: 1, pinned: false };
        _pnbToastSeen.set(key, { count: spec.count, last: now });

        if (_pnbToastLive(st).length >= PNB_TOAST_MAX) {
            st.queue.push(spec);
            _pnbToastPill(st);
            return;
        }
        _pnbToastSpawn(st, spec);
    }
    // Expose the standard toast so lazy-loaded modules (e.g. js/penumbra_forms.js)
    // can surface success/failure with the same notification the app uses.
    window.show_text = show_text;

    // Programmatic dismissal for the LOADING toast: the import-fetch callbacks
    // used to blanket-fadeOut #action_overlay, which would now also nuke
    // unrelated cards (e.g. an error that raced in). Close only loading-kind
    // cards, in whichever window they were raised.
    show_text.dismissLoading = function () {
        const els = _pnbToastEls();
        [els.target, els.other].forEach(function (dock) {
            const st = dock && dock._pnbT;
            if (!st) return;
            st.queue = st.queue.filter(function (q) { return q.kind !== 'load'; });
            _pnbToastLive(st).forEach(function (t) {
                if (t.kind === 'load') _pnbToastClose(st, t);
            });
            _pnbToastPill(st);
        });
    };
