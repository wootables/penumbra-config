        //$('#reportHeaderContainer').hide();
        // --- Hide floating controls during load so they don't bleed through ---
        //$('#toggleAdminViewBtn, #scrollBottomBtn').hide();
    }

    /**
     * Hides the main loading overlay and clears any running timers.
     */
    function hideLoading() {
        // Clear both timers to be safe.
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }
        _stopLoadingTips();
        $("#loadingOverlay").hide();
        try { _pnbLoadingScope(false); _pnbMotionLoadHidden(); } catch (e) { /* cosmetic only */ }
        // "Loaded in" timer: the overlay is gone, so the rendered view is now
        // interactive. If a query armed the timer (at response receipt), the
        // elapsed time since is the client render cost. Disarm afterward so later
        // overlay toggles that DON'T re-query (sort / search / pivot handoff)
        // can't recompute against a stale mark. Fan it into the status bar.
        if (_sbQueryDoneMark !== null) {
            var _nowMs = (window.performance && performance.now) ? performance.now() : Date.now();
