                                pendingGroupByColumn = _gs.levels.join(',');
                                pendingGroupAgg = (_gs.agg && _gs.agg.column) ? _gs.agg : null;
                                pendingPivotSettings = null;
                                // Sort, limit and start depth are NOT carried by
                                // the pending pair - rebuildGroupedView reads
                                // these globals directly at render time, so the
                                // preset has to seed them here or a pinned view
                                // comes back with its ordering and limits lost.
                                var _gsSort = String(_gs.sort || 'label|asc').split('|');
                                currentGroupSort = {
                                    key: _gsSort[0] || 'label',
                                    dir: _gsSort[1] || 'asc'
                                };
                                currentGroupLimit = _gs.limit || null;
                                currentGroupStartDepth = _gs.startDepth || 0;
                                currentGroupLayout = (_gs.layout === 'list') ? 'list' : 'stacked';
