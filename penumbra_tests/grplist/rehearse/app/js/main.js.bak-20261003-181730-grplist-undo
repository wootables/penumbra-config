    // ===== START: SERVER-SIDE SNAPSHOT FUNCTIONALITY ====
    // ===================================================

    // When the snapshot lightbox is opened from the Saved Server Reports list
    // ("View Snapshots" link), the lightbox is browsing snapshots for a report
    // OTHER than whatever is loaded in the URL. This override pins the report
    // context for all snapshot-list operations until inline mode is exited.
    //
    // While inline mode is active, only the actions that would WRITE to the
    // wrong report are hidden. Read-only actions (Load As View, Copy to Local,
    // Delete, Compare-A-vs-B, Rename) all stay available because they don't
    // mis-attribute current-view data.
    var _snapshotReportIdOverride = null;
    // IDs of buttons that would write the current-view data under the override
    // report and corrupt it. These are hidden while inline mode is on.
    var _SNAPSHOT_INLINE_HIDDEN_BTNS = [
        '#createNewSnapshotBtnV2',  // would save the CURRENT view's data, not the override report's
        '#compareSnapshotBtn'       // "Compare To Live" against the current view is meaningless cross-report
        // (Copy-to-server is a per-row drawer action and never appears under the server-only
        //  filter inline mode uses, so it doesn't need to be listed here.)
    ];

    function _renderSnapshotInlineBanner(title) {
        var $banner = $('#snapshotInlineBanner');
        if (!title) {
            $banner.remove();
            return;
        }
        if (!$banner.length) {
            // Reuse the .snap-encrypted-notice class - it already provides a
            // theme-aware styled banner (uses --bg-hover / --border-color /
            // --brand-primary / --text-main) that adapts to every theme.
            $banner = $(
                '<div id="snapshotInlineBanner" class="snap-encrypted-notice">' +
                    '<strong>Viewing snapshots for:</strong> <span class="snap-banner-title"></span>' +
                    '<div class="snap-banner-sub" style="font-size:10px; color:var(--text-muted); margin-top:3px;">Create New, Compare-against-current, and Copy-from-local are hidden because this is a different report than the one you have loaded.</div>' +
                '</div>'
            );
            // Insert right after the unified dialog header band, ahead of any
            // tip/warning paragraphs. (Was `.lightbox-content > h3`, which
            // stopped matching when the title moved inside .pnb-dlg-head - the
            // banner silently never rendered in inline mode.)
            $('#manageSnapshotsLightbox .pnb-dlg-head').first().after($banner);
        }
        $banner.find('.snap-banner-title').text(title);
    }

    function _enterInlineSnapshotMode(reportId, reportTitle) {
        _snapshotReportIdOverride = reportId;
        _renderSnapshotInlineBanner(reportTitle || reportId);
        $(_SNAPSHOT_INLINE_HIDDEN_BTNS.join(',')).hide();

        // Load the target report's snapshots into the unified list. Pin to a
        // SERVER-only view: the user's browser-local snapshots belong to other
        // reports and would be misleading under the "viewing snapshots for <report>"
        // banner. Browse-all is hidden too, since inline mode is scoped to one report.
        _serverSnapCache = null;
        _serverSnapsLoaded = false;
        _activeSnapFilter = 'server';
        $('.snap-filter-pill').removeClass('active').filter('[data-snap-filter="server"]').addClass('active');
        $('#snapBrowseAllBtn').removeClass('active').hide();
        buildUnifiedSnapshotList();
        if (typeof initHelpPopover === 'function') initHelpPopover();
        window._pnbHostDialog('#manageSnapshotsLightbox');
        $('#manageSnapshotsLightbox').css('display', 'flex').hide().fadeIn();

        if (reportId) {
            fetchServerSnapshots(reportId, false);
        } else {
            // No specific report id (e.g. an unsaved report being designed): show
            // every server snapshot the user can access so the list isn't empty.
            fetchServerSnapshots(null, true);
        }
    }

    function _exitInlineSnapshotMode() {
        _snapshotReportIdOverride = null;
        _renderSnapshotInlineBanner(null);
        $(_SNAPSHOT_INLINE_HIDDEN_BTNS.join(',')).show();
        // Restore the Browse-all toggle's normal visibility (it's hidden during inline
        // mode). Mirrors the normal open path: shown only when a report id is in the URL.
        $('#snapBrowseAllBtn').toggle(!!(new URLSearchParams(window.location.search).get('id')));
    }

