    /**
     * Central helper function to process imported state data from a JSON string.
     * @param {string} jsonContent - The raw JSON string from a file or clipboard.
     */
    function processStateImport(jsonContent) {
        if (!jsonContent || !jsonContent.trim()) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No content provided to import.</p>");
            return;
        }

        let newStates;
        try {
            const parsed = JSON.parse(jsonContent);

            // FIX: Allow single state object import by wrapping it in an array
            if (!Array.isArray(parsed) && parsed.name && parsed.url) {
                newStates = [parsed];
            } else {
                newStates = parsed;
            }

            if (!Array.isArray(newStates) || !newStates.every(s => s.name && s.url)) {
                throw new Error("Invalid format. Data must be an array of objects (or a single object) with 'name' and 'url' properties.");
            }

            // SECURITY: Sanitize imported state names to prevent stored XSS.
            // Strip HTML tags from names as defense in depth (render-side also escapes).
            newStates.forEach(s => {
                if (typeof s.name === 'string') {
                    s.name = s.name.replace(/<[^>]*>/g, '').trim();
                }
            });
        } catch (e) {
            show_text(`<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Invalid JSON format: ${e.message}</p>`);
            return;
        }

        const existingStates = JSON.parse(localStorage.getItem("savedQueries") || "[]");
        const existingStateMap = new Map(existingStates.map((s, i) => [s.name.toLowerCase(), {
            state: s,
            index: i
        }]));

        let addedCount = 0;
        let replacedCount = 0;
        const statesToOverwrite = [];

        newStates.forEach(newState => {
            if (existingStateMap.has(newState.name.toLowerCase())) {
                statesToOverwrite.push(newState.name);
            }
        }
        );

        let confirmed = true;
        if (statesToOverwrite.length > 0) {
            confirmed = confirm(`This import will overwrite ${statesToOverwrite.length} existing state(s):\n\n- ${statesToOverwrite.slice(0, 5).join('\n- ')}\n${statesToOverwrite.length > 5 ? '...' : ''}\n\nDo you want to continue?`);
        }

        if (confirmed) {
            newStates.forEach(newState => {
                const existing = existingStateMap.get(newState.name.toLowerCase());
                if (existing) {
                    existingStates[existing.index] = newState;
                    replacedCount++;
                } else {
                    existingStates.push(newState);
                    addedCount++;
                }
            }
            );

            localStorage.setItem("savedQueries", JSON.stringify(existingStates));
            populateSelectorBox();
            populateSavedStatesList();

            // Only close if it was a file import
            if ($('#importStatesFileInput').val()) {
                $('#manageDataLightbox').fadeOut();
            }

            show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Added ${addedCount} new state(s) and replaced ${replacedCount} existing state(s).</p>`);
        }
    }

    // ===================================================
    // ===== START: SNAPSHOT MANAGEMENT FUNCTIONALITY =====
    // ===================================================

    const SNAPSHOT_STORAGE_KEY = "penumbra_data_snapshots";

    // Hard cap for local snapshots (browser localStorage). Centralised here so the
    // pre-open guard in the Create-New click handler and the safety check inside
    // doCreateLocalSnapshot stay consistent.
    const MAX_LOCAL_SNAPSHOTS = 20;

    // Tracks the identifier of the snapshot currently loaded into the live view
    // via Load As View. Used by the delete handlers to detect when the user is
    // about to delete the snapshot they're actively viewing - at which point we
    // restore live data first so the view stays consistent with storage.
    //   { kind: 'local', key: <timestamp> } or { kind: 'server', key: <id> } or null
    var _loadedSnapshot = null;

    // True while the Modify Comparison flow is restoring state. The row-click
    // selection handlers consult this so they don't reset prep-mode mid-restore
    // and silently drop the custom key columns the modify flow is reapplying.
    var _modifyRestoreActive = false;

    // Captured at each comparison entry point so re-opening the snapshot
    // lightbox (via #snapshotBtn or the inline "modify" link) lands on the
    // previous selection + key config instead of a reset UI. SESSION-SCOPED
    // BY DESIGN (2026-07-23): lives until the page reloads and is NOT nulled
    // on compare exit. The old localStorage copy ('penumbra_snapshot_ui',
    // per-report buckets) was removed - snapshot choices drift as data ages,
    // and nothing ever pruned those buckets, so persistence was just stale
    // state accumulating. A fresh tab now simply starts with a clean dialog.
    //   mode               - 'local-vs-current' | 'server-vs-current' | 'unified-a-vs-b'
    //   snapshotIds        - [timestamp]/[id] for vs-current; [a,b] for A-vs-B
    //   customKeyColumns   - array of uppercase column names, or null for "All columns" mode
    var _lastCompareConfig = null;

    // One-time sweep of the retired persistence key so existing browsers shed
    // the accumulated per-report buckets. Idempotent; removable after a few
    // releases once installed profiles have been cleaned.
    try { localStorage.removeItem('penumbra_snapshot_ui'); } catch (e) {}

    // Bucket = the report id the config was captured under. Kept (even though
    // persistence is gone) because data-exploration mode strips ?id= from the
    // URL WITHOUT a page reload - the in-memory config must not prefill the
    // dialog for what is now effectively a different report context.
    function _snapUiBucket() {
        var rid = new URLSearchParams(window.location.search).get('id') || '';
        return rid || '__local__';
    }
    function _captureCompareConfig(mode, snapshotIds, customKeyColumns) {
        _lastCompareConfig = {
            mode: mode,
            snapshotIds: snapshotIds,
            customKeyColumns: customKeyColumns,
            // List scope at compare time, so re-opening restores the same filter /
            // browse-all view the user was working in - not just the row selection.
            filter: _activeSnapFilter || 'all',
            browseAll: $('#snapBrowseAllBtn').hasClass('active'),
            bucket: _snapUiBucket()
        };
    }
    // The remembered config for the current report, or null. In-memory only -
    // same page session, same report bucket.
    function _getRememberedSnapConfig() {
        if (_lastCompareConfig && _lastCompareConfig.snapshotIds && _lastCompareConfig.snapshotIds.length
            && _lastCompareConfig.bucket === _snapUiBucket()) {
            return _lastCompareConfig;
        }
        return null;
    }
    // Restore a remembered config into the already-open panel: list filter + browse-all
    // scope, row selection, All-vs-Key mode, and custom key columns. Selection is applied
    // only once the list is in its FINAL state - inside fetchServerSnapshots' callback,
    // which rebuilds the table after the async rows land, so the restore can't be clobbered
    // by that rebuild (the wipe that made "modify" look like a reset). _modifyRestoreActive
    // guards the row-click handlers so they don't reset prep-mode mid-restore.
    function _applyRememberedSnapConfig(cfg) {
        if (!cfg || !cfg.snapshotIds) return;

        var reportId = new URLSearchParams(window.location.search).get('id') || '';
        var wantBrowseAll = !!cfg.browseAll && !!reportId;
        _activeSnapFilter = cfg.filter || 'all';
        $('.snap-filter-pill').removeClass('active').filter('[data-snap-filter="' + _activeSnapFilter + '"]').addClass('active');
        $('#snapBrowseAllBtn').toggleClass('active', wantBrowseAll);
        buildUnifiedSnapshotList(); // immediate local rows, honoring the restored filter

        _modifyRestoreActive = true;

        var applySelection = function () {
            var $rows = $('#unifiedSnapshotTableBody').find('tr:not(.snap-empty-msg)');
            if ($rows.length === 0) { _modifyRestoreActive = false; return; }

            cfg.snapshotIds.forEach(function (id) {
                var $match = $rows.filter('[data-snap-key="' + id + '"]');
                if ($match.length) {
                    $match.addClass('selected').find('.snap-row-cb').prop('checked', true);
                }
            });
            _updateUnifiedSnapSelection();

            // Restore column mode (All vs Key) + repopulate the column panel for a
