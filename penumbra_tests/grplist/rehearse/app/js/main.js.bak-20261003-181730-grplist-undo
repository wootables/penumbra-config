    // it, a bare 'p10' inside a longer identifier (TOP10(...)) would look like a
    // percentile call.
    function penumbraCfAggDetectRegex() {
        return new RegExp('\\b(' + penumbraCfAggFnNames() + ')\\s*\\(', 'i');
    }
    function penumbraCfAggCallRegex() {
        return new RegExp('\\b(' + penumbraCfAggFnNames() + ')\\(([^()]*)\\)', 'gi');
    }

