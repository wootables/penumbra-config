            } else {
                $hint.text(result.total.toLocaleString() + ' total rows, with ' + result.matching.toLocaleString() + ' filtered results').css('color', 'var(--text-muted)');
            }
        }
        $hint.append(schedFilterPivotNote(filterText));

        // Re-evaluate PDF option based on filtered count
        rerunSchedulerPdfCheckWithCount(result.matching);
    }

    function rerunSchedulerPdfCheck() {
        // No scheduler search filter active (or it was cleared): defer entirely to
        // the canonical PDF-option logic, which evaluates #schedAttachPdf against
        // the unfiltered row count and the TCPDF row cap (4,000), plus column /
        // pivot-rank / grouped handling. (Previously this duplicated that logic with
        // a stale 2,000 cap, which wrongly disabled PDF on 2k-4k row reports.)
        updatePdfOptionState();
    }

    function rerunSchedulerPdfCheckWithCount(filteredCount) {
        // Match the server-side TCPDF cap (schedule_runner.php main path = 4,000)
        // and the client TCPDF_MAX_ROWS in updatePdfOptionState. A non-variable
        // scheduler filter is applied in broadcast mode server-side and runs through
        // that 4,000-cap path, so the filtered count is compared against 4,000 here.
        var _maxRows = 4000;
        var _maxCols = $('#pivot-output-container').is(':visible') ? 50 : 25;

        // Get column count (same logic as updatePdfOptionState)
        var colCount = 0;
        if ($('#pivot-output-container').is(':visible')) {
            var $firstHeaderRow = $('#pivotResultTable').find('thead tr:first');
            $firstHeaderRow.find('th').each(function () {
                colCount += parseInt($(this).attr('colspan') || 1);
            });
        } else if ($('#groupedResultsContainer').is(':visible')) {
            colCount = _penumbraGroupedVisibleColCount();
        } else {
            colCount = $('#tableHeader th:visible').length;
        }

        var isTooTall = filteredCount > _maxRows;
        var isTooWide = colCount > _maxCols;
        var isDisabled = isTooTall || isTooWide;

        var $input = $('#schedAttachPdf');
        var $label = $input.closest('label');

        if (isDisabled) {
            var reason = '';
            if (isTooWide && isTooTall) {
                reason = 'PDF disabled: too many columns (' + colCount + '/' + _maxCols + ') and rows (' + filteredCount.toLocaleString() + '/' + _maxRows.toLocaleString() + ').';
            } else if (isTooWide) {
                reason = 'PDF disabled: too many columns for PDF rendering (' + colCount + ' found, max ' + _maxCols + ').';
            } else {
                reason = 'PDF disabled: too many rows for PDF rendering (' + filteredCount.toLocaleString() + ' filtered, max ' + _maxRows.toLocaleString() + ').';
            }
            $input.prop('disabled', true).prop('checked', false);
            $label.addClass('option-disabled').attr('title', reason);
        } else {
            $input.prop('disabled', false);
            $label.removeClass('option-disabled').removeAttr('title');
        }
    }

