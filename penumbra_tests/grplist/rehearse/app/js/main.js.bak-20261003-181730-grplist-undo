    /**
 * Compresses a string using pako and encodes it to a URL-safe Base64 string.
 * This version is more robust as it works with Uint8Arrays to avoid character encoding issues.
 * @param {string} str - The string to compress.
 * @returns {string} The compressed, URL-safe string.
 */
    function compressString(str) {
        if (!str)
            return "";
        try {
            // 1. Deflate the string, getting a Uint8Array as output (pako's default).
            // This is the correct way to handle the binary data.
            const compressed = pako.deflate(str);

            // 2. Convert the Uint8Array into a "binary string" where each character's
            //    code point corresponds to a byte value. This is the format btoa expects.
            let binaryString = '';
            for (let i = 0; i < compressed.length; i++) {
                binaryString += String.fromCharCode(compressed[i]);
            }

            // 3. Then, encode the resulting binary string to Base64.
            const base64 = btoa(binaryString);

            // 4. Make it URL-safe for use in the URL.
            return encodeURIComponent(base64);
        } catch (e) {
            console.error("Compression failed:", e);
            return null;
        }
