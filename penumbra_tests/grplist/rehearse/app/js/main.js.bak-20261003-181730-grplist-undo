            // a browser-only presentation feature (same policy as web()).
            $("#reportSnippetOutput canvas").filter(function () {
                return !$(this).closest('.penumbra-slide-frame').length;
            }).each(function (index) {
                try {
                    const canvas = this;

                    // 1. Determine background color based on current theme
                    const $body = $('body');
                    const isDark = bodyIsDark();
                    const bgColor = isDark ? '#1a1a1a' : '#ffffff';

                    // 2. Create a temporary canvas to composite the background
                    const tempCanvas = document.createElement('canvas');
                    tempCanvas.width = canvas.width;
                    tempCanvas.height = canvas.height;
                    const ctx = tempCanvas.getContext('2d');

                    // 3. Fill background, then draw the chart on top
                    ctx.fillStyle = bgColor;
                    ctx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
                    ctx.drawImage(canvas, 0, 0);

                    // 4. Capture data from the COMPOSITED canvas, not the transparent source
                    const imgData = tempCanvas.toDataURL("image/png").split(',')[1];
                    const cid = `snippet_chart_${index}`;

                    // Add to the attachments array
                    attachments.push({
                        filename: `chart_${index}.png`,
                        content: imgData,
                        encoding: 'base64',
