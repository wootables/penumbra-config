    // --- Access List: Keydown handler for #authAccessInput ---
    $(document).on('keydown', '#authAccessInput', function (e) {
        var $input = $(this);
        var val = $input.val();
        var autocompleteInstance = $input.data('ui-autocomplete');
        var autocompleteActive = autocompleteInstance && autocompleteInstance.menu && autocompleteInstance.menu.active;

        // Comma or semicolon: attempt to create a pill or keep as text
        if (e.key === ',' || e.key === ';') {
            // Extract the text after the last comma (the "current term")
            var lastCommaIdx = val.lastIndexOf(',');
            var currentTerm = (lastCommaIdx >= 0) ? val.substring(lastCommaIdx + 1).trim() : val.trim();

            if (currentTerm && !autocompleteActive) {
                var parsed = parseAccessEntry(currentTerm);
                if (parsed && isPillAccessType(parsed.type)) {
                    e.preventDefault();
                    // Compute preceding text to preserve in the input
                    var preceding = (lastCommaIdx >= 0) ? val.substring(0, lastCommaIdx).trim() : '';
                    addAccessCapsule(parsed.value, parsed.display, parsed.type, preceding);
                    syncAccessHiddenInput();
                    return;
                }
                // else: it's a text entry (a plain unityid) - let the comma through normally
            }
            // For semicolons, prevent default (we use comma as separator)
            if (e.key === ';') {
                e.preventDefault();
                $input.val(val + ', ');
            }
            return;
        }

        // Enter or Tab: create pill from current term if it's an email type
        if (e.key === 'Enter' || e.key === 'Tab') {
            var lastCommaIdx2 = val.lastIndexOf(',');
            var currentTerm2 = (lastCommaIdx2 >= 0) ? val.substring(lastCommaIdx2 + 1).trim() : val.trim();

            if (currentTerm2 && !autocompleteActive) {
                var parsed2 = parseAccessEntry(currentTerm2);
                if (parsed2 && isPillAccessType(parsed2.type)) {
