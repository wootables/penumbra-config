        // Refresh jQuery-data pointers so future clicks see the current
        // filtered rows + config (rather than the pre-drill versions).
        $(canvas).data('vizConfig', newCfg);
        $(canvas).data('sourceRowData', filteredRows);
        $(canvas).data('drillPath', state.path);

        _mountDrillBreadcrumb(canvas, state);
    }

    // Entry point invoked when the user picks a column from the drill
    // popup. Initializes drillState on first drill (snapshotting the
    // pre-drill config + rows so Exit can restore them) and extends it
    // on subsequent drills. `opts.clickSteps` is an array of
    // {col, val} entries - grouped/stacked clicks supply multiple
    // steps in one click (X-axis + group column), each getting its
    // own breadcrumb dropdown.
    function _drillChartInPlace(canvas, opts) {
        if (!canvas) return;
        var $c = $(canvas);
        var parentVizConfig = opts.parentVizConfig || {};
        var nextCol = opts.nextCol;
        var clickSteps = opts.clickSteps || [];
        if (!nextCol || clickSteps.length === 0) return;

        var state = $c.data('drillState');
        if (!state) {
            // First drill on this chart - capture the baseline.
            state = {
                originalCfg: Object.assign({}, parentVizConfig),
                originalRows: (opts.originalRows || $c.data('sourceRowData') || []).slice(),
                path: [],
                displayedCol: nextCol
            };
        }
        clickSteps.forEach(function (s) {
            state.path.push({
                col: s.col,
                val: s.val,
                // `display` is also consumed by _renderDrillBreadcrumb
                // when the breakdown modal is opened via "Show source
                // rows instead"; keep it on every step so the path
                // stays self-describing across both UIs.
                display: s.col + ' = ' + s.val
            });
        });
        state.displayedCol = nextCol;
        $c.data('drillState', state);

        _redrawChartFromDrillState(canvas);
    }

    // Restore the chart to its pre-drill state. Called from the
    // breadcrumb's "\u00d7" button.
    function _exitDrill(canvas) {
