            else if (split === 'bin' || split === 'binlog') lbl = pivotBinBucketLabel(split, raw, bw ? parseFloat(bw) : null);
            else if (split) lbl = pivotSplitBucketLabel(split, raw);
            else lbl = raw;
            lbl = pivotBlank(lbl);
            if (lbl === '' || lbl == null) continue;
            lbl = String(lbl);
            if (!seen[lbl]) { seen[lbl] = true; out.push(lbl); }
        }
        // Built once, outside the comparator: pivotSplitComparator() may build
        // an order map, and this list has to match the header order exactly -
        // custom sort order included.
        var _blCmp = split ? pivotSplitComparator(split, base) : null;
        out.sort(function (a, b) {
            return _blCmp ? _blCmp(a, b)
                         : String(a).localeCompare(String(b), undefined, { numeric: true, sensitivity: 'base' });
        });
        return out;
    }

    function _getAvailableColumns() {
        var cols = [];
        if (typeof masterRowData !== 'undefined' && masterRowData.length > 0) {
            masterRowData[0].forEach(function (_v, k) {
                var colName = k.toUpperCase();
                if (colName && colName !== '#') cols.push(colName);
            });
            cols.sort();
        }
        return cols;
    }

    /**
     * Adds an aggregation row to the pivot-agg-table.
     * @param {string} aggType   - Aggregation type (e.g. 'sum', 'count', 'distinct')
     * @param {string} sourceCol - Source column name (e.g. 'AMOUNT', 'RED_PT_ID')
     * @param {string} [customLabel] - Optional custom display label
     * @param {string} [filter] - Optional filter condition (e.g. "STATUS = Active")
     */
    function addAggregationRow(aggType, sourceCol, customLabel, filter, formula) {
        // Duplicate rows are allowed - users may want multiple Sums on the same
        // column with different filters (e.g. Sum of AMOUNT where STATUS=Active
        // vs STATUS=Closed), different source columns, or different display
        // labels. The Display Label cell lets users rename each row to
        // distinguish them in the generated pivot.

        var isDerived = _isDerivedAgg(aggType);
        var isFormula = (aggType === 'formula');
        var aggLabel = getAggregationLabel(aggType);
        var displayLabel = customLabel || aggLabel;

        // Build row
        var $tr = $('<tr></tr>')
            .attr('data-agg-type', aggType)
            .attr('data-type', aggType)
            .attr('data-agg-col', isDerived ? '' : (sourceCol || '').toUpperCase())
            .attr('draggable', 'true');

        if (customLabel) $tr.data('custom-label', customLabel);
        if (filter) $tr.attr('data-agg-filter', filter);
        if (isFormula) $tr.attr('data-agg-formula', formula || '');

        // 1. Drag handle cell
        $tr.append('<td class="pat-cell-drag" role="button" tabindex="0" aria-label="Reorder this aggregation: drag it, or press Alt+Up or Alt+Down">\u2261</td>');

        // 2. Aggregate cell
        //    Formula rows repurpose this cell: it shows the formula expression
        //    itself (with a leading ƒ marker) and clicking opens an inline text
        //    input instead of the type dropdown.
        var aggCellHtml;
        if (isFormula) {
            var formulaText = formula || '';
            var formulaDisplay = formulaText === ''
                ? '<span class="pat-cell-text pat-formula-placeholder">\u0192 click to enter formula</span>'
                : '<span class="pat-cell-text pat-formula-text" title="' + escapeHtml(formulaText) + '">\u0192 ' + escapeHtml(formulaText) + '</span>';
            aggCellHtml = '<span class="pat-agg-dot" data-type="formula" title="Custom formula - references other aggregations by label"></span>' +
                formulaDisplay +
                '<span class="pat-edit-icon" aria-hidden="true">\u270e</span>';
        } else {
            // arrow is part of the label for running types, not a separate toggle
            aggCellHtml = _patAggCellHtml(aggType);
        }
        $tr.append('<td class="pat-cell-agg" role="button" tabindex="0">' + aggCellHtml + '</td>');

        // 3. Source column cell - pencil icon only for base aggs (not derived/inherits/formula)
        var srcClass = 'pat-cell-src';
        var srcHtml;
        if (isFormula) {
            srcClass += ' pat-inherits';
            srcHtml = '-'; // em dash - formulas have no source column
        } else if (isDerived) {
            srcClass += ' pat-inherits';
            var inheritedCol = _getLastUsedAggCol();
            srcHtml = escapeHtml(inheritedCol ? '(inherits ' + inheritedCol + ')' : '(inherits)');
        } else {
            srcHtml = '<span class="pat-cell-text">' + escapeHtml((sourceCol || '').toUpperCase()) + '</span><span class="pat-edit-icon" aria-hidden="true">\u270e</span>';
        }
        $tr.append('<td class="' + srcClass + '"' + (srcClass.indexOf('pat-inherits') === -1 ? ' role="button" tabindex="0"' : '') + '>' + srcHtml + '</td>');

        // 4. Display label cell
        $tr.append('<td class="pat-cell-lbl" role="button" tabindex="0"><span class="pat-cell-text">' + escapeHtml(displayLabel) + '</span><span class="pat-edit-icon" aria-hidden="true">\u270e</span></td>');

        // 5. Filter cell - derived aggs and formulas inherit, base aggs can have independent filters
        var fltClass = 'pat-cell-flt';
        var fltHtml;
        if (isFormula) {
            fltClass += ' pat-inherits';
            fltHtml = '-';
        } else if (isDerived) {
            fltClass += ' pat-inherits';
            fltHtml = '(inherits)';
        } else if (filter) {
            fltClass += ' pat-has-filter';
            fltHtml = '<span class="pat-cell-text">' + escapeHtml(filter) + '</span><span class="pat-edit-icon" aria-hidden="true">\u270e</span>';
        } else {
            fltHtml = '<span class="pat-cell-text pat-filter-placeholder">none</span><span class="pat-edit-icon" aria-hidden="true">\u270e</span>';
        }
        $tr.append('<td class="' + fltClass + '"' + (fltClass.indexOf('pat-inherits') === -1 ? ' role="button" tabindex="0"' : '') + '>' + fltHtml + '</td>');

        // 5b. Column Total override cell - formulas opt out, others default to "Same as {aggLabel}"
        if (isFormula) {
            $tr.attr('data-col-total-override', '');
            $tr.append('<td class="pat-cell-colt pat-inherits">-</td>');
        } else {
            var _coltSameText = 'Same as ' + aggLabel;
            if (customLabel && customLabel !== aggLabel) {
                _coltSameText += ' (' + customLabel + ')';
            }
            $tr.attr('data-col-total-override', '');
            $tr.append('<td class="pat-cell-colt" role="button" tabindex="0"><span class="pat-cell-text pat-colt-same">' +
                escapeHtml(_coltSameText) + '</span><span class="pat-edit-icon" aria-hidden="true">\u270e</span></td>');
        }

        // 6. Remove cell
        $tr.append('<td class="pat-cell-rm" role="button" tabindex="0" aria-label="Remove this aggregation">\u00d7</td>');

        $('#pivot-agg-table-body').append($tr);
        // Derived aggs and formulas don't represent a new source column on their
        // own - only ensure a vals chip for base aggs.
        if (!isDerived && !isFormula && sourceCol) {
            _ensureValsChip(sourceCol);
        }
        refreshAggTokenLabels();
        rebuildRowTotalSlots();
        syncRankAggDropdown();
        // Ensure any newly-added chip gets its × button
        if (typeof updatePivotLayoutOptions === 'function') updatePivotLayoutOptions();
    }

    // --- Inline editing handlers for the agg table (delegated) ---

    // Re-render a formula row's Aggregate cell content from data-agg-formula
    function _renderFormulaAggCell($tr) {
        var f = $tr.attr('data-agg-formula') || '';
        var inner = f === ''
            ? '<span class="pat-cell-text pat-formula-placeholder">\u0192 click to enter formula</span>'
            : '<span class="pat-cell-text pat-formula-text" title="' + escapeHtml(f) + '">\u0192 ' + escapeHtml(f) + '</span>';
        $tr.find('.pat-cell-agg').html(
            '<span class="pat-agg-dot" data-type="formula" title="Custom formula - references other aggregations by label"></span>' +
            inner + '<span class="pat-edit-icon" aria-hidden="true">\u270e</span>'
        );
    }

    // Click Aggregate cell → dropdown to change type (or text input for formulas)
    // ── One aggregation menu, three places ───────────────────────────────────
    // The canonical list of aggregation types lives ONCE, as the option markup
    // of #pivot-aggregation-selector in index.php. The inline Aggregate-cell
    // editor and the row-total override menus are built from it rather than
    // each keeping its own array - keeping three copies by hand is what let
    // them drift apart in both wording and content.
    //
    // `keep(type)` filters (the "+ Add Aggregation" placeholder is always
    // dropped). `currentType` marks its option selected and, when the canonical
    // list CANNOT contain it, is carried as its own entry: wavg@AMOUNT,
    // index@FY2023 and roll<N> are parameterized, so they never appear as
    // literal options. Without that entry the browser selects the first option
    // instead, and a caller that reads the value back on blur silently rewrites
    // the row.
    function penumbraBuildAggMenu($select, keep, currentType) {
        var added = 0, sawCurrent = false;
        $('#pivot-aggregation-selector').children('optgroup').each(function () {
            var $group = $('<optgroup></optgroup>').attr('label', $(this).attr('label'));
            var kept = 0;
            $(this).children('option').each(function () {
                var t = this.value;
                if (!t) return;
                if (keep && !keep(t)) return;
                var $opt = $('<option></option>').val(t).text($(this).text());
                if (t === currentType) { $opt.attr('selected', true); sawCurrent = true; }
                $group.append($opt);
                kept++;
            });
            if (kept) { $select.append($group); added += kept; }
        });
        if (currentType && !sawCurrent) {
            $select.prepend($('<optgroup label="Current"></optgroup>').append(
                $('<option></option>').val(currentType)
                    .text(getAggregationLabel(currentType)).attr('selected', true)
            ));
            added++;
        }
        return added;
    }

    // Which types a row-total override can actually compute: not the derived
    // ones (they read a base row, not cells), not a formula, and not a weighted
    // average - there are no per-row weights left at that level.
    //
    // Percentiles ARE offered. Every layer below this menu already supported
    // them and only the menu had not been told: both override routes compute a
    // real percentile rather than falling through to their sum default, the
    // trigger parser already accepted one in a row-total token (via
    // _pivotIsPctileAgg), and the column is already headed "Overall P90" rather
    // than "Grand Total". Checked against the scheduled-email runner BEFORE
    // being exposed here, because a menu entry the runner cannot compute is a
    // browser/email divergence by construction: penumbra_tests\pivotparity\
    // verify_pctile_override.php drives both routes and all three PHP builders
    // (47/0, no warnings), and the two engines return identical values for the
    // same lists.
    //
    // The two routes answer different questions ON PURPOSE - a percentile over
    // the per-cell totals when the override differs from the base aggregation,
    // and one over the underlying rows when it does not - so p90 of [30,110]
    // (=102) and p90 of [10,20,50,60] (=57) are both correct in their own path.
    // Both engines choose between them with the same condition.
    function penumbraIsRowTotalOverrideAgg(t) {
        return !_isDerivedAgg(t) && t !== 'formula' && t !== 'wavg'
            && pivotWavgWeightCol(t) === null;
    }

    // WCAG 2.1.1: every editable cell of the values table is a focusable button
    // (stamped in the row builder); Enter/Space runs the same click path. Keys
    // typed into the inline <select>/<input> a click creates stay with it.
    $('#pivot-agg-table').on('keydown', '.pat-cell-agg, .pat-cell-src, .pat-cell-lbl, .pat-cell-flt, .pat-cell-colt, .pat-cell-rm', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        if ($(e.target).is('select, input, textarea')) return;
        e.preventDefault();
        $(this).trigger('click');
    });

    $('#pivot-agg-table').on('click', '.pat-cell-agg', function () {
        var $td = $(this);
        var $tr = $td.closest('tr');
        if ($td.find('select,input').length) return;

        // Formula rows: inline text input for the expression
        if ($tr.attr('data-agg-type') === 'formula') {
            var currentFormula = $tr.attr('data-agg-formula') || '';
            var $input = $('<input type="text" class="pat-inline-input" placeholder="e.g. {Active} - {Closed}">').val(currentFormula);
            $td.empty().append($input);
            $input.focus().select();
            $input.on('keydown', function (ev) {
                if (ev.key === 'Enter') $(this).blur();
                if (ev.key === 'Escape') { $(this).val(currentFormula); $(this).blur(); }
            });
            $input.on('blur', function () {
                var newVal = $.trim($(this).val());
                // Validate parse (surface error but keep input open? No - keep the old value and show error)
                if (newVal !== '') {
                    try { parsePivotFormula(newVal); }
                    catch (e) {
                        if (typeof showPivotError === 'function') {
                            showPivotError('Formula syntax error: ' + e.message, true);
                        }
                        // Fall through and save anyway so the user can see/edit it;
                        // validation will catch it again at Generate time.
                    }
                }
                $tr.attr('data-agg-formula', newVal);
                _renderFormulaAggCell($tr);
            });
            return;
        }

        var currentType = $tr.attr('data-agg-type');
        var $select = $('<select class="pat-inline-select"></select>');
        // Built from the same canonical menu as "+ Add Aggregation", so the two
        // agree on grouping, wording, and which types exist at all. The array
        // that used to live here was hand-kept and had fallen behind: it never
        // learned the rolling types, and a row whose type is absent from the
        // options leaves the browser sitting on the FIRST one - which this
        // handler's own blur then writes back, silently turning the row into a
        // Sum. Measured: 8 of 12 real row types were lost that way.
        penumbraBuildAggMenu($select, function (t) { return t !== 'formula'; }, currentType);
        $td.empty().append($select);
        $select.focus();
        $select.on('blur change', function () {
            var newType = $select.val();
            if (!newType) newType = currentType;
            $tr.attr('data-agg-type', newType).attr('data-type', newType);
            // Update source cell editability
            var isDerived = _isDerivedAgg(newType);
            var $srcTd = $tr.find('.pat-cell-src');
            if (isDerived) {
                var inheritedCol = _getLastUsedAggCol();
                $srcTd.addClass('pat-inherits').removeClass('pat-override').text(inheritedCol ? '(inherits ' + inheritedCol + ')' : '(inherits)');
                $tr.attr('data-agg-col', '');
            } else if (!$tr.attr('data-agg-col') || $tr.attr('data-agg-col') === '') {
                $tr.attr('data-agg-col', _getLastUsedAggCol());
                // .html(), not .text(): a bare text node wipes the
                // `pat-cell-text` span AND the pencil, so the cell lost the only
                // cue that it can still be edited (it can - the click handler is
                // delegated on the cell). refreshAggTokenLabels() could not put
                // it back either: its repair only runs `if ($srcSpan.length)`.
                $srcTd.removeClass('pat-inherits').html(
                    '<span class="pat-cell-text">' + escapeHtml($tr.attr('data-agg-col')) + '</span>' +
                    '<span class="pat-edit-icon" aria-hidden="true">✎</span>');
            }
            // FILTER cell - nothing here used to touch it at all. A derived agg
            // has no filter of its own (it reads the base row's), which is why
            // addAggregationRow gives a new derived row an uneditable
            // "(inherits)" cell. A row SWITCHED to a derived type kept the
            // editable "none" box instead, so the engine offered a filter it
            // ignores - and a filter set before the switch stayed in
            // data-agg-filter, invisible, and was still emitted by
            // getAggregationFilters(), which reads every row unconditionally.
            var $fltTd = $tr.find('.pat-cell-flt');
            if (isDerived) {
                $tr.removeAttr('data-agg-filter');
                $fltTd.attr('class', 'pat-cell-flt pat-inherits').text('(inherits)');
            } else {
                var _keptFilter = $tr.attr('data-agg-filter') || '';
                $fltTd.attr('class', 'pat-cell-flt' + (_keptFilter ? ' pat-has-filter' : '')).html(
                    _keptFilter
                        ? '<span class="pat-cell-text">' + escapeHtml(_keptFilter) + '</span><span class="pat-edit-icon" aria-hidden="true">✎</span>'
                        : '<span class="pat-cell-text pat-filter-placeholder">none</span><span class="pat-edit-icon" aria-hidden="true">✎</span>');
            }
            // Rebuild agg cell
            $td.html(_patAggCellHtml(newType));
            // Reset custom label if type changed
            if (newType !== currentType) {
                $tr.removeData('custom-label');
                $tr.find('.pat-cell-lbl').text(getAggregationLabel(newType));
            }
            // If the col-total cell is in "Same as" mode, refresh its text for the new agg
            if (!$tr.attr('data-col-total-override')) {
                _renderColTotalCell($tr);
            }
            refreshAggTokenLabels();
            rebuildRowTotalSlots();
            syncRankAggDropdown();
            // A bare 'wavg' carries no weight yet - go straight to the picker
            // instead of leaving the row in a half-configured state.
            if (newType === 'wavg') $td.find('.pat-wavg-w').trigger('click');
        });
    });

    // Click the "× WEIGHT" half of a Weighted Avg cell → pick the weight column.
