    /**
 * Parses a @@JSON string and converts it into a readable text format 
 * (with indentation) for Excel and PDF cells.
 * @param {string} cellValue - The raw cell string
 * @returns {string} Formatted text or original string
 */
    function formatJsonForTextExport(cellValue) {
        if (typeof cellValue !== 'string' || !cellValue.startsWith('@@JSON')) {
            return cellValue;
        }

        try {
            const jsonStr = cellValue.substring(6);
            // Strip @@JSON
            const jsonObj = JSON.parse(jsonStr);

            // Helper: strip nested @@HTML prefix and HTML tags from leaf values
            const cleanLeaf = (v) => {
                var s = String(v);
                if (s.substring(0, 6) === '@@HTML') s = s.substring(6).replace(/<[^>]*>/g, '').trim();
                return s;
            };

            // Recursive helper to build indented string
            const buildString = (obj, indent = 0) => {
                let lines = [];
                const space = '   '.repeat(indent);
                // 3 spaces per level

                if (Array.isArray(obj)) {
                    // Only add blank-line separators for multi-key objects
                    var multiKey = obj.length > 0 && typeof obj[0] === 'object' && obj[0] !== null && Object.keys(obj[0]).length > 1;
                    obj.forEach((item, index) => {
                        // Add a separator for array items if they are multi-key objects
                        if (typeof item === 'object' && item !== null) {
                            if (index > 0 && multiKey)
                                lines.push('');
                            // spacing between array items
                            lines.push(buildString(item, indent));
                        } else {
                            lines.push(`${space}- ${cleanLeaf(item)}`);
                        }
                    }
                    );
                } else if (typeof obj === 'object' && obj !== null) {
                    for (const [key, val] of Object.entries(obj)) {
                        if (typeof val === 'object' && val !== null) {
                            lines.push(`${space}${key}:`);
                            lines.push(buildString(val, indent + 1));
                        } else {
                            lines.push(`${space}${key}: ${cleanLeaf(val)}`);
                        }
                    }
                } else {
                    return cleanLeaf(obj);
                }
                return lines.join('\n');
            }
                ;

            return buildString(jsonObj);
        } catch (e) {
            return cellValue;
            // Fallback on error
        }
    }

