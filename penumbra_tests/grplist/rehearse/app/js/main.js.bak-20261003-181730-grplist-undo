    (function suppressSchedPwIcons() {
        var ids = ['schedSubject', 'schedBodyPreamble', 'schedDbDumpTable', 'schedDropFilenamePattern',
                   'schedDropPath', 'schedDbDumpOverrideReason', 'schedCustomConditionExpr',
                   'schedCron'];
        function optOut(node) {
            node.setAttribute('autocomplete', 'off');
