                    }
                    renderAuditRibbon(response.kpis, shortId);
                    renderAuditSegBar(response.counts, response.kpis, shortId);
                    renderAuditFilterBar(response.counts);
                    renderAuditFoot(response.counts, response.data.length, shortId);
                    if (_auditSeg === 'pulse') renderAuditSegPulse(_auditKpisCache);
                    else if (_auditSeg === 'changes') _auditRenderChanges(shortId);
                    else if (_auditSeg === 'health') _auditRenderHealth(shortId);

