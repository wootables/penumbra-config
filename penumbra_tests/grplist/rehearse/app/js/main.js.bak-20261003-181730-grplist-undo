        // entities - a &#40; written by info() arrives as a real '('.
        const text = $('<div>').html(html).text();
        // Each HARD segment is normalised on its own, so an EMPTY segment (from
        // back-to-back <br>) survives as the blank line the author asked for,
        // while blank lines inside a segment (block-tag artifacts) still go.
        return text.split(HARD)
            .map(seg => seg.split('\n')
                .map(line => line.replace(/\s+/g, ' ').trim())
                .filter(line => line !== '')
                .join('\n'))
            .join('\n')
            // A leading/trailing <br> must not leave the block padded.
            .replace(/^\n+/, '')
            .replace(/\n+$/, '')
            .replace(/\x1F/g, '');
    }

