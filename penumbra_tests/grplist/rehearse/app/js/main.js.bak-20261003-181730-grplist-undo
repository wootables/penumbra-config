    // 7. Generate Button (Updated for CodeMirror)
    $('#generateSubqueryBtn').on('click', function () {
        const type = getSubqueryType();

        // Get value from CodeMirror
        const sql = subqueryEditor.getValue().trim();
        const $errorBox = $('#subqueryErrorBox').hide().empty();

        if (!sql) {
            $errorBox.text("Please enter a SQL query.").show();
            return;
        }

        // Check for SELECT *
        if (/^\s*SELECT\s+(DISTINCT\s+)?(\*|[a-zA-Z0-9_]+\.\*)/i.test(sql)) {
            $errorBox.html(`
                <strong>Validation Error:</strong> Wildcards (<code>*</code>) are not allowed.<br>
                Please specify the exact column name(s) you wish to retrieve (e.g., <code>SELECT ID FROM...</code>).
            `).show();
            return;
        }

        // Single Column Check for 'IN' type
        if (type === 'in') {
            const cleanSql = sql.replace(/\s+/g, ' ');
            const selectMatch = cleanSql.match(/SELECT\s+(.+?)\s+FROM/i);

            if (selectMatch) {
                let columnsPart = selectMatch[1];
                let prevLength = -1;
                while (columnsPart.length !== prevLength) {
                    prevLength = columnsPart.length;
                    columnsPart = columnsPart.replace(/\([^()]*\)/g, '');
                }

                if (columnsPart.includes(',')) {
                    $errorBox.html(`
                        <strong>Validation Error:</strong> The 'IN list' type requires a query that returns exactly <strong>one column</strong>.<br>
                        Multiple columns were detected in your SELECT clause.<br>
                        <em>Tip: If you need multiple columns, switch the Tag Type to 'Data table [CTE_SUBQUERY]'.</em>
                    `).show();
                    return;
                }
            }
        }

        // Assembled in the db= / transport= / query= order the server parser
        // requires (see buildSubqueryTag).
        const newTag = buildSubqueryTag(sql);

        const overwriteTarget = $(this).data('overwrite-target');
        const $activePanel = $('#promptGeneratorIcon').closest('.ui-tabs-panel');
        let activeEditor = ($activePanel.attr('id') === 'report-options-tab') ? snippetEditor : editor;

        if (overwriteTarget && !activeEditor.getValue().includes(overwriteTarget)) {
            activeEditor = (activeEditor === editor) ? snippetEditor : editor;
        }

        if (overwriteTarget) {
            const currentContent = activeEditor.getValue();
            const startIndex = currentContent.indexOf(overwriteTarget);

            if (startIndex !== -1) {
                const from = activeEditor.posFromIndex(startIndex);
                const to = activeEditor.posFromIndex(startIndex + overwriteTarget.length);
                activeEditor.replaceRange(newTag, from, to);
                activeEditor.setSelection(from, activeEditor.posFromIndex(startIndex + newTag.length));
            } else {
                activeEditor.replaceSelection(newTag);
            }
        } else {
            activeEditor.replaceSelection(newTag);
        }

        $('#promptGeneratorLightbox').fadeOut();
        activeEditor.focus();
    });

    // --- Local-save URL size guard --------------------------------------------
    // Local saves encode the ENTIRE report state into the URL (?state=...) and
    // pushState it. The state rides entirely in the query string, which IIS caps
    // at maxQueryString = 2048 bytes by default, and a fronting proxy can be even
    // tighter (observed rejection at ~3191 chars). 2000 is the long-standing safe
    // URL length and sits just under the 2048 query-string limit, so a state past
    // this length can't be reloaded or shared. We warn + block before saving.
    // (Server Save sends the state in a POST body, so it has no such limit.)
    // compressString() output is ASCII, so character length here ~= byte length.
    const LOCAL_STATE_URL_LIMIT = 2000;
    let _localStateOversized = false;

    // Length of the request target (path + query) a local, unencrypted save would
    // produce, or null if there's no valid state yet. Quiet: never toasts. Encryption
    // only grows this, so the click-time guard re-checks the real (post-encrypt) URL.
    function measureLocalStateUrlLength() {
        try {
            if (!editor || typeof editor.getValue !== 'function' || !editor.getValue().trim()) return null;
            const stateObject = buildStateObject();
            if (!stateObject) return null;
            const encoded = compressString(JSON.stringify(stateObject));
            const fileName = window.location.pathname.split('/').pop() || 'index.php';
            const relUrl = fileName + "?state=" + encoded;
            try {
                const u = new URL(relUrl, window.location.href);
                return (u.pathname + u.search).length;
            } catch (e) {
                return relUrl.length;
            }
        } catch (e) {
            return null;
        }
    }

    // Refresh the oversize warning banner + button-disable in the Local Save tab.
    // Sets _localStateOversized so the name/overwrite handlers keep the button off.
    function updateLocalSaveSizeGuard() {
        const $warn = $('#localSaveSizeWarning');
        const len = measureLocalStateUrlLength();
        _localStateOversized = false;
        $warn.removeClass('save-error save-warning').hide().empty();
        if (len === null) return;

        if (len > LOCAL_STATE_URL_LIMIT) {
            _localStateOversized = true;
            $warn.addClass('save-error').html(
                '<strong>&#9888; State too large to save locally.</strong> This report&rsquo;s link would be ' +
                len.toLocaleString() + ' characters (limit ' + LOCAL_STATE_URL_LIMIT.toLocaleString() + '). ' +
                'Local saves store the whole report in the URL, and the proxy will likely reject a link this long when you reload or share it. ' +
                'Trim the report (fewer columns, a simpler query or snippet) or use <strong>Server Save</strong> instead &mdash; it has no URL-length limit.'
            ).show();
            $('#confirmLocalSaveBtn').prop('disabled', true);
        } else if (len > LOCAL_STATE_URL_LIMIT * 0.85) {
            $warn.addClass('save-warning').html(
                '<strong>&#9888; Approaching the URL size limit.</strong> This local save&rsquo;s link is ' +
                len.toLocaleString() + ' of ~' + LOCAL_STATE_URL_LIMIT.toLocaleString() + ' characters. ' +
                'If it grows much more the proxy may reject it &mdash; consider <strong>Server Save</strong> for large reports.'
            ).show();
        }
    }

