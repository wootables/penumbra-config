                }
            }

            for (let i = 0; i < len; i++) {
                const row = rows[i];
                if (row.classList.contains('search-hidden'))
                    continue;

                visibleCount++;

                // DOM-only columns first: they don't depend on the masterRowData
                // lookup below, so they must not be skipped when it misses.
                for (let j = 0; j < domOnlyCols.length; j++) {
                    const dc = domOnlyCols[j];
                    accs[dc].push(penumbraReadCellForSummary(row.cells[colIdToCellIdx[dc]]));
                }

                // Get row index from the # cell (first cell)
                const rowNumText = row.cells[0] ? row.cells[0].textContent : '';
                const rowIndex = parseInt(rowNumText, 10) - 1;
                const rowMap = masterRowData[rowIndex];
                if (!rowMap) continue;

                for (let j = 0; j < activeCols.length; j++) {
                    const colId = activeCols[j];
                    if (!colIdToName[colId]) continue;   // handled above
                    accs[colId].push(rowMap.get(colIdToName[colId]));
                }
            }
        } else {
            // Fallback: read from DOM (e.g. no masterRowData available)
            for (let i = 0; i < len; i++) {
                const row = rows[i];
                if (row.classList.contains('search-hidden'))
                    continue;

                visibleCount++;

                const cells = row.cells;
                for (let j = 0; j < visibleColIndices.length; j++) {
                    const cellIndex = visibleColIndices[j];
                    const cell = cells[cellIndex];
                    const colId = cell.getAttribute("data-column");

                    if (accs[colId]) {
                        accs[colId].push(penumbraReadCellForSummary(cell));
                    }
                }
            }
        }

        if (visibleCount === 0)
            return;

        // 5. Finish the accumulators. A column that produced nothing worth
        //    showing (all blank / no numbers / stddev over one row) drops out.
        const results = {};
        const typesShown = [];
        for (let j = 0; j < activeCols.length; j++) {
            const colId = activeCols[j];
            const res = accs[colId].finish();
            if (res === null) continue;
            results[colId] = res;
            typesShown.push(summaryTypes[colId]);
        }
        if (typesShown.length === 0)
            return;

        const footerLabel = penumbraSummaryHeaderLabel(typesShown);
        const isMixed = (footerLabel === 'SUMMARY');

        // 6. Build New Footer
        const tfoot = document.createElement('tfoot');
        const trData = document.createElement('tr');
        trData.className = 'total-row-data';

        // Add cells matching visible columns. The keyword lands in '#', or - when
        // '#' is hidden - in the first column that has no summary of its own, so
        // the footer is never left unlabelled. (The grouped and snapshot-diff
        // footers have always relocated it; the flat one used to just drop it.)
        let labelPlaced = false;
        Array.from(headerRow.children).forEach((th) => {
            if (th.style.display === 'none')
                return;

            const colId = th.getAttribute("data-column");
            const td = document.createElement('td');
            td.setAttribute('data-column', colId);

            if (colId === '#') {
                td.className = 'pnb-sum-label';
                td.innerHTML = '<strong>' + escapeHtml(footerLabel) + '</strong>';
                labelPlaced = true;
            } else if (results[colId] !== undefined) {
                const type = summaryTypes[colId];
                const props = columnProperties ? columnProperties[colId] : null;
                const displayVal = penumbraFormatSummary(results[colId], type, {
                    isCurrency: props ? !!props.isCurrency : undefined
                });
                td.setAttribute('data-sum-type', type);
                // Column NAME on the cell, so the click-to-change handler never
                // has to re-derive it from the header (drill tables can't).
                if (th.getAttribute('data-colname')) td.setAttribute('data-sum-col', th.getAttribute('data-colname'));
                td.innerHTML = '<strong>' + escapeHtml(displayVal) + '</strong>' +
                               penumbraSummaryBadgeHtml(type, isMixed, th.getAttribute('data-colname'));
            } else if (!labelPlaced) {
                td.className = 'pnb-sum-label';
                td.innerHTML = '<strong>' + escapeHtml(footerLabel) + '</strong>';
                labelPlaced = true;
            }
            // A journal column's footer cell carries the column's class, like its
            // header and body cells: Copy as HTML / the email embed drop the Notes
            // column BY CLASS, and a footer cell without it stayed behind and
            // pushed every summary after it one column right. (2026-10-02)
            if (th.classList.contains('journal-toggle-col')) td.classList.add('journal-toggle-col');
            else if (th.classList.contains('journal-notes-col')) td.classList.add('journal-notes-col');
            trData.appendChild(td);
        }
        );

        // Always show the data row now that we calculate the full total
        tfoot.appendChild(trData);

        // Link row for paginated tables. Deliberately says "the summary row"
        // rather than naming the type: the keyword varies per report (TOTALS /
        // AVERAGES / UNIQUE / SUMMARY / ...) and several of those read badly in
        // this sentence ("to see unique", "to see non-blank").
        var colspanCount = 0;
        Array.from(headerRow.children).forEach(function(th) {
            if (th.style.display !== 'none') colspanCount++;
        });
        var trLink = document.createElement('tr');
        trLink.className = 'total-row-link';
        var tdLink = document.createElement('td');
        tdLink.setAttribute('colspan', colspanCount);
        tdLink.innerHTML = '<a href="#" id="viewLastPageLink">View Last Page to see the summary row</a>';
        trLink.appendChild(tdLink);
        tfoot.appendChild(trLink);

        table.appendChild(tfoot);
    }

    function updateFilteredResultCount() {
        // PERF: Native DOM count instead of two jQuery :not() scans on 90K rows
        const allTrs = document.querySelectorAll("#resultsTable tbody tr");
        let totalRowCount = allTrs.length;
