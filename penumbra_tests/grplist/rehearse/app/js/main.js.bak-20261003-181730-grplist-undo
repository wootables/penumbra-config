    // --- Table-alias detection for the Clip-to-Query prefix prompt ---
    // Once a query aliases its table ("FROM PROJECTS p") the alias is the ONLY
    // legal column prefix - Oracle rejects "PROJECTS.ID" from that point on - so
    // the prefix prompt pre-fills the alias when the query supplies one and the
    // bare table name otherwise.
    //
    // Deliberately not findAllTablesInQueryV17(): that parser feeds autocomplete
    // hints, where a wrong guess costs a stray suggestion, and its keyword list
    // (no UNION / FETCH / START / OF ...) would hand back "UNION" as an alias.

    // Words that can legally follow a table reference without being its alias.
    var SP_NOT_AN_ALIAS = new Set([
        'AS', 'ON', 'USING', 'WHERE', 'GROUP', 'ORDER', 'BY', 'HAVING', 'JOIN',
        'INNER', 'LEFT', 'RIGHT', 'FULL', 'OUTER', 'CROSS', 'NATURAL', 'LATERAL',
        'UNION', 'MINUS', 'INTERSECT', 'EXCEPT', 'START', 'CONNECT', 'WITH',
        'SELECT', 'FROM', 'INTO', 'SET', 'VALUES', 'FOR', 'OF', 'FETCH', 'OFFSET',
        'LIMIT', 'PARTITION', 'SUBPARTITION', 'PIVOT', 'UNPIVOT', 'SAMPLE',
        'TABLESAMPLE', 'MODEL', 'APPLY', 'VERSIONS', 'FLASHBACK', 'WHEN', 'AND', 'OR', 'NOT'
    ]);

    var SP_IDENT_RE = /^(?:"[^"]*"|\[[^\]]*\]|[A-Za-z_$#][A-Za-z0-9_$#]*)/;
    var SP_QUALIFY_RE = /^\s*\.\s*(?:"[^"]*"|\[[^\]]*\]|[A-Za-z_$#][A-Za-z0-9_$#]*)/;
    var SP_ALIAS_RE = /^\s+(?:AS\s+)?("[^"]*"|\[[^\]]*\]|[A-Za-z_$#][A-Za-z0-9_$#]*)/i;

    // Blank out comments and quoted literals, keeping length and line breaks, so
    // a table name that only shows up in a commented-out line or inside a string
    // can't be read as a real source.
    function _spStripSqlNoise(sql) {
        return String(sql || '').replace(/--[^\n\r]*|\/\*[\s\S]*?\*\/|'(?:''|[^'])*'/g, function(m) {
            return m.replace(/[^\n\r]/g, ' ');
        });
    }

    // Reads one "SCHEMA.TABLE@LINK alias" reference starting at pos. Returns null
    // for anything that isn't a plain identifier (an opening paren for a subquery,
    // or the end of the query), which is the caller's signal to stop.
    function _spReadTableRef(sql, pos) {
        while (pos < sql.length && /\s/.test(sql.charAt(pos))) pos++;
        var m = SP_IDENT_RE.exec(sql.slice(pos));
        if (!m) return null;

        var name = m[0];
        pos += m[0].length;
        for (var q; (q = SP_QUALIFY_RE.exec(sql.slice(pos))); ) {
            name += q[0];
            pos += q[0].length;
        }
        var link = /^@[A-Za-z0-9_$#.]+/.exec(sql.slice(pos));   // Oracle db link
        if (link) pos += link[0].length;

        var alias = '';
        var a = SP_ALIAS_RE.exec(sql.slice(pos));
        if (a) {
            // An unquoted keyword here ends the reference instead of naming it,
            // and has to stay unconsumed so the caller still sees the clause that
            // follows. Quoting or bracketing makes any word a legal alias.
            var quoted = /^["\[]/.test(a[1]);
            if (quoted || !SP_NOT_AN_ALIAS.has(a[1].toUpperCase())) {
                alias = a[1];       // kept as written: "My Alias" / [My Alias] paste back intact
                pos += a[0].length;
            }
        }
        return { name: name, alias: alias, end: pos };
    }

    // Every table the query names in a FROM or JOIN, including the comma list an
    // Oracle-style join puts after FROM ("FROM PROJECTS p, SPONSORS s").
    function _spCollectQuerySources(rawSql) {
        var sql = _spStripSqlNoise(rawSql);
        var sources = [];
        var clause = /\b(FROM|JOIN)\b/gi;
        var m;
        while ((m = clause.exec(sql)) !== null) {
            var pos = m.index + m[0].length;
            var isFrom = m[1].toUpperCase() === 'FROM';
            for (;;) {
                var ref = _spReadTableRef(sql, pos);
                if (!ref) break;
                sources.push(ref);
                pos = ref.end;
                var comma = isFrom ? /^\s*,/.exec(sql.slice(pos)) : null;
                if (!comma) break;
                pos += comma[0].length;
            }
            // Resume past what we consumed. A subquery's own FROM is still found:
            // _spReadTableRef stops at its opening paren without advancing pos.
            if (pos > clause.lastIndex) clause.lastIndex = pos;
        }
        return sources;
    }

    // Last dot-separated part, unquoted and uppercased ("SPONSOR"."PROJECTS" ->
    // PROJECTS). Comparing on the base name is what makes the match work when
    // only one side is schema-qualified, which is the norm here: the selector
    // lists bare table names while queries often write SCHEMA.TABLE.
    function _spBaseTableName(ident) {
        var parts = String(ident || '').split('.');
        var last = parts[parts.length - 1] || '';
        return last.replace(/^\s*["\[]|["\]]\s*$/g, '').trim().toUpperCase();
    }

    // The alias the current query gives tableName, or '' when it doesn't alias it
    // (or doesn't reference it at all). First alias wins: the right answer for the
    // single reference that is the common case, and a sane guess for a self-join,
    // where the user can still edit the pre-filled value.
    function _spAliasForTable(sql, tableName) {
        var target = _spBaseTableName(tableName);
        if (!target) return '';
        var sources = _spCollectQuerySources(sql);
        for (var i = 0; i < sources.length; i++) {
            if (sources[i].alias && _spBaseTableName(sources[i].name) === target) {
                return sources[i].alias;
            }
        }
        return '';
    }

    // --- Clip to Query (from panel) ---
    $(document).on('click', '#spClipToQuery', function() {
        var checkedNames = [];
        $('#spColumnList .sp-col-item').each(function() {
            var $check = $(this).find('.sp-col-check');
            if ($check.is(':checked')) {
                var name = $(this).data('colname');
                if (name && name !== '#') checkedNames.push(name);
            }
        });

        if (checkedNames.length === 0) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Please select at least one column to copy.</p>", 3000);
            return;
        }

        var prefillValue = '';
