        var vh = document.documentElement.clientHeight || window.innerHeight;
        var floor = vh;
        var sb = document.getElementById('pnbStatusBar');
        if (sb && sb.getClientRects().length) floor = Math.min(floor, sb.getBoundingClientRect().top);
        top = Math.max(0, top);
        left = Math.max(0, left);
        right = Math.min(vw, right);
        bottom = Math.min(floor, bottom);
        if (bottom - top < _PNB_SCOPE_MIN_H || right - left < _PNB_SCOPE_MIN_W) return null;
        return { t: top, r: vw - right, b: vh - bottom, l: left, h: bottom - top };
    }

    function _pnbLoadingScopeSet(ov, b) {
        ov.style.setProperty('--pnb-lo-t', Math.round(b.t) + 'px');
        ov.style.setProperty('--pnb-lo-r', Math.round(b.r) + 'px');
