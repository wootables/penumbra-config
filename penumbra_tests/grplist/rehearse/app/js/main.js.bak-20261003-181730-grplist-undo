    function extractPromptsForScheduler() {
        const query = getQuery();
        const snippet = getSnippet();
        const allCode = query + "\n" + snippet;
        const promptRegex = /\[\s*PROMPT[^\]]*\]/gi;

        const prompts = [];
        const seenKeys = new Set();

        let match;
        while ((match = promptRegex.exec(allCode)) !== null) {
            try {
                const parsed = parsePrompt(match[0]);

                // --- CAPTURE RAW STRING FOR LOOKUP ---
                parsed.rawString = match[0];
                // -------------------------------------

                let uniqueIdentifier;
                if (parsed.name) {
                    uniqueIdentifier = 'NAME:' + parsed.name.toLowerCase();
                } else {
                    uniqueIdentifier = 'RAW:' + match[0].trim();
                }

                if (seenKeys.has(uniqueIdentifier)) {
                    continue;
                }
                seenKeys.add(uniqueIdentifier);

                prompts.push(parsed);
            } catch (e) { }
        }
        return prompts;
    }

    // Distinct me(...) macros in the report's SQL (query only - snippet me() is
    // resolved separately per-recipient by the runner's _snippet_me). Scheduled
    // runs have no live identity, so each of these needs an admin-supplied value.
    // Keyed by the lowercased inner argument; bare me() has the empty-string key.
    function extractMeTokensForScheduler() {
        const query = getQuery();
        const meRegex = /\bme\(\s*([A-Za-z0-9_]*)\s*\)/gi;
        const tokens = [];
        const seen = new Set();
        let match;
        while ((match = meRegex.exec(query)) !== null) {
            const key = (match[1] || '').trim().toLowerCase();
            if (seen.has(key)) continue;
            seen.add(key);
            tokens.push({ key: key, token: key ? ('me(' + key + ')') : 'me()' });
        }
        return tokens;
    }

