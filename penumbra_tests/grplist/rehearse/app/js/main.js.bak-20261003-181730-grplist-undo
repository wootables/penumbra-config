    // Cell-level equivalent of the data-search link pattern, enabled per-report
    // in View Options. Delegated + CSS only: no per-cell nodes or bindings, so
    // the cost does not scale with row count. Pivot is excluded on purpose --
    // its cells already own a click (drilldown, bound at pivotDrilldown).
    $(document).on('click', '#resultsTable tbody td, #groupedResultsContainer tbody td', function (e) {
        if (!document.body.classList.contains('pnb-click-filter'))
