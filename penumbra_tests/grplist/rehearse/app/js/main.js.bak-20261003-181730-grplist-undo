    // Determine whether the shared change detection row should be visible and
    // which option(s) currently own it. "Skip if no changes" (any task type) and
    // the EMAIL-only "Send as Change Analysis" delivery option both consume the
    // same column selection, so the card's title + hint swap to describe the
    // active combination (columns = watched set for skip alone, row KEY once a
    // change analysis is on).
    // Per-recipient change analysis (2026-09-16): when the query, the search
    // filter or a me() mapping carries recipient variables, the runner compares
    // each recipient against THEIR OWN last delivery (a private baseline per
    // recipient, kept with the task) rather than one shared snapshot. The
    // change-detection card says so. Same token regex as the me() guard below.
    function schedTaskIsPerRecipient() {
        var re = /\{(?:FNAME|LNAME|USERNAME|EMAIL|OUCS2D|OUCS4D|OUCS6D|OUCS|OUC2D|OUC4D|OUC6D|DEPT|OUC|EMPL_ID4|EMPL_ID|JOBCODE_PREFIX|JOBCODE|EMPL_CLASS|EMPL_STATUS|PI_ELIGIBLE)\}/i;
        var q = (typeof getQuery === 'function') ? String(getQuery() || '') : '';
        if (re.test(q)) return true;
        // The filter and skip condition are tested NORMALIZED ("{ DEPT }" = "{DEPT}"), like the runner.
        if (re.test(_pnbCanonBraceTokens($('#schedSearchFilter').val() || ''))) return true;
        // A recipient variable in the custom skip condition promotes the task too (2026-09-23).
        if ($('#schedSkipCustomCondition').is(':checked') && re.test(_pnbCanonBraceTokens($('#schedCustomConditionExpr').val() || ''))) return true;
        var hit = false;
        $('.sched-me-input').each(function () {
            if (re.test(String($(this).val() || ''))) { hit = true; return false; }
        });
        return hit;
    }
    function updateSchedPrHint() {
        var $h = $('#schedPrHint');
        if (!$h.length) return;
        var wanted = ($('#schedSkipNoChange').is(':checked') || $('#schedChangesOnly').is(':checked'))
            && $('#schedEventType').val() === 'EMAIL' && schedTaskIsPerRecipient();
        if (wanted) {
            $h.html('<strong>Per-recipient task:</strong> the query or filter uses recipient variables, so each recipient is compared against <em>their own</em> last delivery - a private baseline per recipient, kept with this task - not against one shared snapshot. The baseline snapshot offered when you tick the option is not used for those comparisons.').show();
        } else {
            $h.hide();
        }
    }
    function updateChangeModeVisibility() {
        var skipChecked = $('#schedSkipNoChange').is(':checked');
        var analysisChecked = $('#schedChangesOnly').is(':checked') && $('#schedEventType').val() === 'EMAIL';
        if (skipChecked || analysisChecked) {
            $('#schedChangeModeRow').slideDown('fast');
        } else {
            $('#schedChangeModeRow').slideUp('fast');
        }

        var title, hint;
        if (analysisChecked && skipChecked) {
            title = '[Change Analysis + Skip if no changes] Change detection based on:';
            hint = '<strong>Change analysis:</strong> the email is grouped into New / Removed / Modified / Unchanged rows vs the last scheduler snapshot. ' +
                'With <em>Specific columns</em>, the selected columns act as the <em>row key</em> and modified cells show [was:]/[now:] values. ' +
                '<strong>Skip if no changes:</strong> the run is skipped when that diff finds no changes at all.';
        } else if (analysisChecked) {
            title = '[Send as Change Analysis] Change detection based on:';
            hint = 'The email is grouped into New / Removed / Modified / Unchanged rows vs the last scheduler snapshot (like the Snapshot Analysis view). ' +
                'With <em>Specific columns</em>, the selected columns act as the <em>row key</em> and modified cells show [was:]/[now:] values; ' +
                'with <em>All columns</em>, edits appear as New + Removed pairs. ' +
                'If nothing changed, the report still sends as one full Unchanged group. The first run delivers the full report as the baseline.';
