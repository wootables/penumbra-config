    /**
     * V17 Compatible Table Parser
     * Supports FROM [Table] syntax
     */
    function findAllTablesInQueryV17(query, ctes) {
        const tables = new Map();
        const sqlKeywordsSet = new Set(['SELECT', 'FROM', 'WHERE', 'JOIN', 'ON', 'GROUP', 'ORDER', 'BY', 'AS', 'DISTINCT', 'AND', 'OR', 'SET', 'UPDATE', 'INTO', 'VALUES', 'LEFT', 'RIGHT', 'INNER', 'HAVING', 'OUTER', 'CROSS', 'APPLY']);

        // 1. Standard FROM/JOIN (Updated regex to support [Table])
        const fromJoinRegex = /(?:FROM|JOIN)\s+(?:([a-zA-Z0-9_.]+)|\[([^\]]+)\])(?:\s+(?:AS\s+)?([a-zA-Z0-9_]+))?/gi;
        let match;
        while ((match = fromJoinRegex.exec(query)) !== null) {
            // Group 1: Standard Table, Group 2: [Table]
            const name = (match[1] || match[2]).replace(/dbo\./i, '');
            let alias = match[3] || null;
            if (alias && sqlKeywordsSet.has(alias.toUpperCase()))
                alias = null;
            const upperName = name.toUpperCase();
            const key = alias || name;

            if (!tables.has(key)) {
                tables.set(key, {
                    name: name,
                    alias: alias,
                    isCte: ctes.has(upperName)
                });
            }
        }

        // 2. Comma-separated (Simplified)
        const prefixRegex = /\b([a-zA-Z0-9_]+)\.[a-zA-Z0-9_]+\b/g;
        while ((match = prefixRegex.exec(query)) !== null) {
            const potentialTable = match[1].toUpperCase();
            if (!sqlKeywordsSet.has(potentialTable) && !tables.has(potentialTable) && allTableNames.some(t => t.toUpperCase() === potentialTable)) {
                tables.set(match[1], {
                    name: match[1],
                    alias: null,
                    isCte: false
                });
            }
        }

        // 3. APPLY Aliases
        const applyRegex = /(?:OUTER|CROSS)\s+APPLY\s*\(/gi;
        let applyMatch;
        while ((applyMatch = applyRegex.exec(query)) !== null) {
            const startBody = applyMatch.index + applyMatch[0].length;
            let parenCount = 1;
            let endBody = -1;
            for (let i = startBody; i < query.length; i++) {
                if (query[i] === '(')
                    parenCount++;
                else if (query[i] === ')')
                    parenCount--;
                if (parenCount === 0) {
                    endBody = i;
                    break;
                }
            }
            if (endBody !== -1) {
                const remainder = query.substring(endBody + 1);
                const aliasMatch = remainder.match(/^\s*(?:AS\s+)?([a-zA-Z0-9_]+)/i);
                if (aliasMatch) {
                    const alias = aliasMatch[1];
                    if (!tables.has(alias)) {
                        tables.set(alias, {
                            name: alias,
                            alias: alias,
                            isCte: true
                        });
                    }
                }
            }
        }
        return Array.from(tables.values());
    }

    /**
     * Helper to filter a list by "contains" but sort "starts with" to the top.
     * MODIFIED: Added includeAll parameter to keep non-matches at the bottom.
     */
    function applyContainsFilter(items, fragment, defaultClass = null, includeAll = false) {
        // If no filter text and not forcing all items, return standard list
        if (!fragment && !includeAll)
            return items.map(item => {
                return (typeof item === 'string') ? {
                    text: item,
                    displayText: item,
                    className: defaultClass
                } : item;
            }
            );

        const fragLower = fragment ? fragment.toLowerCase() : "";
        const startsWith = [];
        const contains = [];
        const others = [];

        items.forEach(item => {
            // Normalize item to object
            const obj = (typeof item === 'string') ? {
                text: item,
                displayText: item,
                className: defaultClass
            } : item;

            const textLower = obj.displayText.toLowerCase();

            // Logic: An item can only enter ONE of these buckets
            if (fragment && textLower.startsWith(fragLower)) {
                startsWith.push(obj);
            } else if (fragment && textLower.includes(fragLower)) {
                contains.push(obj);
            } else if (includeAll) {
                // Only added if it DIDN'T match above
                others.push(obj);
            }
        }
        );

        // Stack them: Matches first, then the rest.
        // NEW: Sort each bucket by Score (Desc) then Alphabetical
        const sorter = (a, b) => {
            const scoreA = a.score || 0;
            const scoreB = b.score || 0;
            if (scoreA !== scoreB)
                return scoreB - scoreA;
            // High score first
            return a.displayText.localeCompare(b.displayText);
        }
            ;

        startsWith.sort(sorter);
        contains.sort(sorter);
        others.sort(sorter);

        return [...startsWith, ...contains, ...others];
    }

