    var PRESET_NS_LABELS = {
        pivot: 'Pivot layout',
        group: 'Group layout',
        viz: 'Visualization',
        search: 'Search',
        tplcopy: 'Copy template',
        tpldownload: 'Download template'
    };
    function _presetNsLabel(ns) {
        return Object.prototype.hasOwnProperty.call(PRESET_NS_LABELS, ns) ? PRESET_NS_LABELS[ns] : ns;
    }
    function _presetScopeLabel(id) {
        // '__adhoc__' is the engine's id for "no report loaded" (the ad-hoc editor).
        return (id === '__adhoc__') ? '(ad-hoc / no report)' : id;
