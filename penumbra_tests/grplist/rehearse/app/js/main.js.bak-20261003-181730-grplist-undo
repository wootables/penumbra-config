    // ─── Custom formula aggregations (Category A) ────────────────────────────
    // Recursive-descent parser for scalar formulas that reference other
    // aggregation rows by display label. Grammar:
    //   expression := term   (('+' | '-') term)*
    //   term       := factor (('*' | '/') factor)*
    //   factor     := NUMBER | '{' LABEL '}' | '(' expression ')' | '-' factor
    // Output: AST nodes {type:'num'|'label'|'neg'|'binop', ...}.
    // Parse once at validation time, evaluate per cell. See plan file for scope.
    function parsePivotFormula(expr) {
        if (expr == null || typeof expr !== 'string') throw new Error('Formula is empty');
        var s = expr.trim();
        if (s === '') throw new Error('Formula is empty');
        // Tokenize
        var tokens = [];
        var i = 0;
        while (i < s.length) {
            var c = s.charAt(i);
            if (c === ' ' || c === '\t' || c === '\n' || c === '\r') { i++; continue; }
            if ((c >= '0' && c <= '9') || c === '.') {
                var start = i;
                while (i < s.length && ((s.charAt(i) >= '0' && s.charAt(i) <= '9') || s.charAt(i) === '.')) i++;
                var num = parseFloat(s.substring(start, i));
                if (isNaN(num)) throw new Error('Invalid number at position ' + start);
                tokens.push({ type: 'num', value: num });
                continue;
            }
            if (c === '{') {
                var end = s.indexOf('}', i);
                if (end === -1) throw new Error('Unclosed label reference - missing "}"');
                var label = s.substring(i + 1, end).trim();
                if (label === '') throw new Error('Empty label reference "{}"');
                tokens.push({ type: 'label', value: label });
                i = end + 1;
                continue;
            }
            if (c === '+' || c === '-' || c === '*' || c === '/' || c === '(' || c === ')') {
                tokens.push({ type: 'op', value: c });
                i++;
                continue;
            }
            throw new Error('Unexpected character "' + c + '" at position ' + i);
        }
        if (tokens.length === 0) throw new Error('Formula is empty');

        // Parse (recursive descent)
        var pos = 0;
        function peek() { return tokens[pos]; }
        function consume() { return tokens[pos++]; }

        function parseExpression() {
            var left = parseTerm();
            while (peek() && peek().type === 'op' && (peek().value === '+' || peek().value === '-')) {
                var op = consume().value;
                var right = parseTerm();
                left = { type: 'binop', op: op, left: left, right: right };
            }
            return left;
        }
        function parseTerm() {
            var left = parseFactor();
            while (peek() && peek().type === 'op' && (peek().value === '*' || peek().value === '/')) {
                var op = consume().value;
                var right = parseFactor();
                left = { type: 'binop', op: op, left: left, right: right };
            }
            return left;
        }
        function parseFactor() {
            var tok = peek();
            if (!tok) throw new Error('Unexpected end of formula');
            if (tok.type === 'op' && tok.value === '-') {
                consume();
                return { type: 'neg', operand: parseFactor() };
            }
            if (tok.type === 'op' && tok.value === '+') {
                consume();
                return parseFactor();
            }
            if (tok.type === 'num') { consume(); return { type: 'num', value: tok.value }; }
            if (tok.type === 'label') { consume(); return { type: 'label', name: tok.value }; }
            if (tok.type === 'op' && tok.value === '(') {
                consume();
                var inner = parseExpression();
                var close = peek();
                if (!close || close.type !== 'op' || close.value !== ')') {
                    throw new Error('Missing closing ")"');
                }
                consume();
                return inner;
            }
            throw new Error('Unexpected token "' + tok.value + '"');
        }

        var ast = parseExpression();
        if (pos < tokens.length) {
            throw new Error('Unexpected token "' + tokens[pos].value + '" at end of formula');
        }
        return ast;
    }

    // Walk a parsed formula AST with a context object mapping labels to numbers.
    // Returns a number or null (division by zero, unresolved label, NaN/Infinity).
    // Null propagates through arithmetic so any failure short-circuits to null
    // which the renderer formats as '-'.
    function evaluatePivotFormula(ast, ctx) {
        if (!ast) return null;
        switch (ast.type) {
            case 'num':
                return ast.value;
            case 'label': {
                var v = ctx[ast.name];
                if (typeof v !== 'number' || !isFinite(v)) return null;
                return v;
            }
            case 'neg': {
                var inner = evaluatePivotFormula(ast.operand, ctx);
                return inner === null ? null : -inner;
            }
            case 'binop': {
                var l = evaluatePivotFormula(ast.left, ctx);
                var r = evaluatePivotFormula(ast.right, ctx);
                if (l === null || r === null) return null;
                var out;
                switch (ast.op) {
