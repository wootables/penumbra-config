                content: JSON.stringify(jsonData, null, 2),
                rowCount: rowCount
            };
        }

        // ============================================================
        // 5. CSV / TSV Export (Flat/Grouped)
        // ============================================================
        const delim = (format === 'tsv') ? '\t' : ',';
        let content = "";

        // ─── 5a. Optional flatten-nested branch ─────────────────────
        // When opts.flattenNested is true, @@JSON sub-tables are "exploded"
        // into top-level columns named "Parent-Sub", and rows with nested
        // data emit one output row per nested entry. Rows without nested
        // data emit a single row with empty sub-cell values. Skipped in
        // pivot mode (pivot data has no @@JSON) and silently no-op when
        // no visible column contains @@JSON.
        //
