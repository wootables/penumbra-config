                    agg: aggTypes,  // Now stores array instead of single string
                    aggLabels: hasCustomLabels ? aggCustomLabels : null,
                    aggColOverrides: hasAggColOverrides ? aggColOverrides : null,
                    aggFilters: aggFilters,
                    aggFormulas: aggFormulas,
                    rowLayout: rowLayout,
