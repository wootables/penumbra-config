                    kind: 'server',
                    key: String(srv.ID),
                    sortDate: new Date(srv.CREATED_AT),
                    name: srv.SNAP_NAME || '(unnamed)',
                    creator: srv.CREATED_BY || '-',
                    rowCount: parseInt(srv.ROW_COUNT, 10) || 0,
                    colCount: colNames.length || parseInt(srv.COLUMN_COUNT, 10) || 0,
                    colNames: colNames,
                    matchesCurrent: matches,
