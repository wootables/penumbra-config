    // --- "Allow only on custom condition" (2026-09-23) ---------------------------
    // Search Filter syntax over each viewer's employee-directory record
    // (penumbra_subscribe_condition.php - the one evaluator behind the header chip,
    // the subscribe endpoint and the runner's send-time removal). As the owner types,
    // the server checks it: does it parse, how many active people match (a few
    // names), do YOU match, and which current subscribers the next send would remove.
    var _schedSubsCondTimer = null;
    var _schedSubsCondXhr = null;
    var _schedSubsCondLast = null;      // { cond, resp } of the last completed check
    var _schedSubsCondRemoved = {};     // lowercased emails that check says would be removed

    function _schedSubsCondStatus(cls, html) {
        $('#schedSubsCondStatus').attr('class', 'sched-subs-cond-status' + (cls ? ' ' + cls : '')).html(html || '');
    }
    function _schedSubsCondReset() {
        clearTimeout(_schedSubsCondTimer);
        if (_schedSubsCondXhr) { try { _schedSubsCondXhr.abort(); } catch (e) { } _schedSubsCondXhr = null; }
        _schedSubsCondLast = null;
        _schedSubsCondRemoved = {};
        _schedSubsCondStatus('', '');
    }
    function _schedSubsCondSchedule(delay) {
        clearTimeout(_schedSubsCondTimer);
        _schedSubsCondTimer = setTimeout(_schedSubsCondCheck, delay);
    }
    function _schedSubsCondRender(resp) {
        _schedSubsCondRemoved = {};
        if (!resp || resp.status !== 'success') {
            _schedSubsCondStatus('is-warn', escapeHtml((resp && resp.message) || 'Could not check the condition right now.'));
        } else if (!resp.valid) {
            _schedSubsCondStatus('is-error', escapeHtml(resp.error || 'This condition cannot be used.'));
        } else {
            var parts = [], warn = false;
            var d = resp.directory || {};
            if (d.ok) {
                var n = Number(d.matches) || 0;
                if (n === 0) { warn = true; parts.push('<strong>Nobody in the directory matches</strong> - no one would see the Subscribe option.'); }
                else {
                    parts.push('<strong>' + n.toLocaleString() + '</strong> of ' + (Number(d.active) || 0).toLocaleString()
                        + ' active people match' + ((d.samples && d.samples.length)
                            ? ' (e.g. ' + d.samples.map(function (s) { return escapeHtml(s); }).join(', ') + (n > d.samples.length ? ', ...' : '') + ')'
                            : '') + '.');
                }
            } else {
                parts.push('The directory could not be counted right now.');
            }
            var y = resp.you || {};
            if (y.checked) parts.push(!y.found ? 'You are not in the directory, so you would not match.' : (y.match ? 'You match.' : 'You do not match.'));
            var sub = resp.subscribers || {};
            var removed = Array.isArray(sub.removed) ? sub.removed : [];
            removed.forEach(function (e) { _schedSubsCondRemoved[String(e).toLowerCase()] = true; });
            if (removed.length) {
                warn = true;
                parts.push('<strong>' + removed.length + ' current subscriber' + (removed.length === 1 ? ' does' : 's do')
                    + ' not match and will be removed at the next send.</strong>');
            } else if (sub.checked === false && sub.reason) {
                parts.push('Current subscribers could not be checked (' + escapeHtml(sub.reason) + ').');
            }
            _schedSubsCondStatus(warn ? 'is-warn' : 'is-ok', parts.join(' '));
        }
        updateSubscriptionCardUI();
    }
    function _schedSubsCondCheck() {
        if (_schedSubsCondXhr) { try { _schedSubsCondXhr.abort(); } catch (e) { } _schedSubsCondXhr = null; }
        if (!$('#schedSubsCondEnable').is(':checked')) return;
        var cond = String($('#schedSubsCondExpr').val() || '').trim();
        if (!cond) {
            _schedSubsCondLast = null;
            _schedSubsCondRemoved = {};
            _schedSubsCondStatus('', 'Write a condition with recipient variables, e.g. <code>{OUC2D} = 14 AND {PI_ELIGIBLE} = 1</code> or <code>{TAGS} = CALS_PREAWARD</code>.');
            updateSubscriptionCardUI();
            return;
        }
        _schedSubsCondStatus('is-busy', 'Checking the directory...');
        var reportId = new URLSearchParams(window.location.search).get('id') || '';
        _schedSubsCondXhr = $.post('manage_schedule.php', {
            action: 'sub_condition_check', report_id: reportId, task_id: $('#schedTaskId').val() || '', condition: cond
        }, null, 'json')
            .done(function (resp) {
                if (String($('#schedSubsCondExpr').val() || '').trim() !== cond) return;   // typed on meanwhile
