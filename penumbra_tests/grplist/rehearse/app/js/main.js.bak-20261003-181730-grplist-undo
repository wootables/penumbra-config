            split: split,
            edges: spec.binEdges || null,
            binWidth: width,
            // Blank in stays blank out, so each caller's own '' -> '[Blank]'
            // rule keeps working. A value the variant cannot parse comes back
            // as its raw text (the contract the pivot already honors), landing
            // it in a group named after itself rather than vanishing.
            label: function (raw) {
                if (split === 'bins') return pivotBinsBucketLabel(raw, spec.binEdges);
                if (split === 'bin' || split === 'binlog') return pivotBinBucketLabel(split, raw, width);
                return pivotSplitBucketLabel(split, raw);
