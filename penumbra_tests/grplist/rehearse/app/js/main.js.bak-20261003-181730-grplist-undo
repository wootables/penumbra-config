                                const headerParts = [];
                                if (d.task_id)   headerParts.push(`Task #${escapeHtml(String(d.task_id))}`);
                                if (d.cron)      headerParts.push(escapeHtml(d.cron));
                                if (d.owner)     headerParts.push(escapeHtml(d.owner));
                                var headerLine = headerParts.join(' &middot; ');
                                if (msg) headerLine += (headerLine ? ': ' : '') + escapeHtml(msg);
                                if (headerLine) parts.push(headerLine);

                                // Detail lines (only for non-OK actions or when extra info exists)
                                if (d.exception)  parts.push(`<span class="audit-msg-err" style="font-size:10px;"><strong>Error:</strong> ${escapeHtml(d.exception)}</span>`);
