    // --- Query Prompts Management ---
    function populatePromptList() {
        const $selector = $('#promptListSelector').empty();
        const $details = $('#promptDetails').html('Select a prompt to see its saved value.');
        $('#deleteSelectedPromptBtn').prop('disabled', true);

        // --- Build a map of prompts in the current editor ---
        const keyToDefinitionMap = new Map();
        const query = editor.getValue();
        const promptRegex = /\[\s*PROMPT[^\]]*\]/gi;
        let match;
        while ((match = promptRegex.exec(query)) !== null) {
            try {
                const parsed = parsePrompt(match[0]);
                const storageKey = getPromptStorageKey(match[0]);
                keyToDefinitionMap.set(storageKey, parsed);
            } catch (e) { }
        }
        // --- END ---

        const urlParams = new URLSearchParams(window.location.search);
        const currentReportId = urlParams.get('id') || null;
        const prompts = [];

        for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            if (key && key.startsWith('penumbra_prompt_')) {
                const promptDataString = localStorage.getItem(key);
                try {
                    const promptData = JSON.parse(promptDataString);
                    const savedReportId = promptData.reportId || null;
                    // Get the saved ID
                    let message = promptData.message || null;
                    // Get the saved message

                    // --- Orphaned Prompt Logic ---
                    if (!message) {
                        // No message was saved with the prompt (old data)
                        let definition = keyToDefinitionMap.get(key);
                        // Check current query by key

                        if (!definition && savedReportId && savedReportId === currentReportId) {
                            // Key not in query, but the prompt's ID matches the page's ID.
                            // This means it *belongs* to this report, even if the query changed.
                            message = `[Current Report]`;
                            // Special label
                        } else if (definition) {
                            // Key *was* in the current query.
                            // Prioritize label, then message, then name, then type
                            message = definition.label || definition.message || definition.name || definition.type;
                        }
                    }
                    // --- END ---

                    // Get the display value (the answer)

                    // Get the display value (the answer)
                    let answerDisplay = '[No Value Set]';
                    let fullDisplayValue = '[No Value Set]';
                    // This will be stored in data-value
                    let valueToParse = (promptData.values !== undefined) ? promptData.values : promptData;

                    if (Array.isArray(valueToParse) && valueToParse.length > 0) {
                        // Handles new/old multi-select
                        fullDisplayValue = valueToParse.map(p => p.display || p.value).join('\n');
                    } else if (valueToParse && typeof valueToParse === 'object' && valueToParse.display !== null && valueToParse.display !== undefined) {
                        // Handles new/old single-value with display
                        fullDisplayValue = valueToParse.display;
                    } else if (valueToParse && typeof valueToParse === 'object' && valueToParse.value !== null && valueToParse.value !== undefined) {
                        // Handles new/old single-value with only value
                        fullDisplayValue = valueToParse.value;
                    } else if (typeof valueToParse === 'string' && valueToParse && valueToParse !== '[]' && valueToParse !== 'null') {
                        // Handles old raw string values
                        fullDisplayValue = valueToParse;
                    } else if (!message && promptDataString !== '[]' && promptDataString !== 'null' && promptDataString) {
                        // Fallback for orphaned raw strings (that aren't JSON)
                        try {
                            JSON.parse(promptDataString);
                            // If this parses, it's an object we missed
                        } catch (e) {
                            fullDisplayValue = promptDataString;
                            // If it fails, it's a simple string
                        }
                    }

                    // Create the truncated version for the list
                    if (fullDisplayValue === '[No Value Set]') {
                        answerDisplay = '[No Value Set]';
                    } else {
                        answerDisplay = (fullDisplayValue.length > 50) ? fullDisplayValue.substring(0, 50) + '...' : fullDisplayValue;
                    }

                    let listLabel = '';
                    if (message && message === '[Current Report]') {
                        listLabel = `${message}: ${answerDisplay}`;
                    } else if (message) {
                        listLabel = `${message}: ${answerDisplay}`;
                    } else {
                        listLabel = `[Orphaned Prompt]: ${answerDisplay}`;
                        // Truly orphaned
                    }

                    prompts.push({
                        key: key,
                        name: listLabel,
                        message: message,
                        value: fullDisplayValue,
                        // Store the human-readable value
                        reportId: savedReportId
                    });
                } catch (e) {/* ignore malformed data */
                }
            }
        }

        if (prompts.length > 0) {
            prompts.sort((a, b) => a.name.localeCompare(b.name)).forEach(prompt => {
                $selector.append(`<option value="${escapeHtml(prompt.key)}" 
                                          data-message="${escapeHtml(prompt.message)}" 
                                          data-value="${escapeHtml(prompt.value)}" 
                                          data-report-id="${escapeHtml(prompt.reportId)}">
                                    ${escapeHtml(prompt.name)}
                                  </option>`);
            }
            );
        } else {
            $selector.append('<option disabled>No saved prompt answers found.</option>');
        }
    }

