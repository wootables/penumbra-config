            return neg ? -n : n;
        }

        function percentile(sorted, p) {
            if (sorted.length === 0) return 0;
            var idx = (p / 100) * (sorted.length - 1);
            var lo = Math.floor(idx), hi = Math.ceil(idx);
            if (lo === hi) return sorted[lo];
            return sorted[lo] + (sorted[hi] - sorted[lo]) * (idx - lo);
        }

        // Build a domain from raw values. `range` takes min:max for a hard
        // override, or pLo:pHi for a percentile clamp - the percentile form is
        // the outlier defence, so a single whale row does not flatten the ramp
        // for everything else.
        function domainFrom(values, range, mid) {
            var nums = [];
            for (var i = 0; i < values.length; i++) {
                var v = values[i];
                if (typeof v === 'number' && isFinite(v)) nums.push(v);
            }
            if (nums.length === 0) return null;

            // Data min/max first. Explicit loop, not Math.min.apply - a big flat
            // table can push past the argument-count limit and throw.
            var min = nums[0], max = nums[0];
            for (var j = 1; j < nums.length; j++) {
                if (nums[j] < min) min = nums[j];
                if (nums[j] > max) max = nums[j];
            }

            // range= resolves EACH SIDE independently, so a number, a percentile
            // and "auto" can be mixed freely:
            //   range=0:          floor at zero, top follows the data
            //   range=0:p99       floor at zero, clamp the top outlier
            //   range=p5:p95      clamp both tails
            //   range=0:5000000   fully fixed
            // Pinning the floor matters more than it looks: on the awards report
            // five negative revisions drag the data min to -$200,000, and with
            // curve=log (which amplifies the low end hard) that pushed 95 genuine
            // $0 cells to 27% of the ramp - they read as "some money" when they
            // are nothing. range=0: fixes exactly that.
            var txt = range ? String(range).trim() : '';
            if (txt.indexOf(':') !== -1) {
                var parts = txt.split(':');
                var sorted = null;
                var resolveEnd = function (tok, fallback) {
                    tok = String(tok || '').trim();
                    if (!tok) return fallback;                 // empty side = auto
                    var pm = /^p([\d.]+)$/i.exec(tok);
                    if (pm) {
                        if (!sorted) sorted = nums.slice().sort(function (a, b) { return a - b; });
                        return percentile(sorted, parseFloat(pm[1]));
                    }
                    var nv = parseFloat(tok);
                    return isFinite(nv) ? nv : fallback;
                };
                min = resolveEnd(parts[0], min);
                max = resolveEnd(parts[1], max);
            }
            if (max < min) { var t = min; min = max; max = t; }

            var dom = { min: min, max: max, mid: null, count: nums.length, sorted: null };
            // curve=rank needs the full value set to compute a percentile rank.
            // Capped so a phase-2 flat table of 90k rows cannot quietly retain a
            // second copy of every number in the report.
            if (nums.length <= 20000) {
                dom.sorted = nums.slice().sort(function (a, b) { return a - b; });
            }
            if (mid !== null && mid !== undefined && String(mid) !== '') {
                var mv = parseFloat(mid);
                if (isFinite(mv)) dom.mid = mv;
            }
            return dom;
        }

        // Returns fn(value) -> inline css string. Built once per domain so ramp
        // construction and endpoint parsing never happen per cell; the internal
        // cache then collapses repeated positions to one colour computation.
        function colorizer(domain, opts) {
            opts = opts || {};
            var ramp = buildRamp(opts.ramp || 'brand');
            var bins = parseInt(opts.bins, 10) || 0;
            var wantText = opts.text !== 'keep';
            // Read once per colorizer, like the ramp endpoints above: the theme
            // cannot change while this colorizer lives, and reading it per value
            // (readableOn below) cost a forced style pass per cell. (2026-10-01)
            var textMain = wantText ? (parseColor(themeVar('--text-main', '#222222')) || [34, 34, 34]) : null;
            var curve = opts.curve || 'linear';
            var min = domain.min, max = domain.max, mid = domain.mid;
            var span = max - min;
            var sorted = domain.sorted;
            var cache = {};

            // Reshape the 0..1 ramp position. Real financial data is heavily
            // right-skewed - on the awards pivot the median FY column value is
            // $0 against a $17M max, so a LINEAR ramp puts the 95th percentile
            // at 3% of the scale and all but one cell renders as bare surface.
            // Linear stays the default because it is the honest encoding (a $17M
            // cell really is 30x a $570K one) and it matches Excel / Power BI;
            // the other curves are opt-in, named, and documented transforms.
            function shape(t) {
                if (curve === 'sqrt') return Math.sqrt(t);
                if (curve === 'log') {
                    // log1p compression - k sets how hard the low end is lifted.
                    var k = 99;
                    return Math.log(1 + t * k) / Math.log(1 + k);
                }
                return t;
            }
            // Percentile rank: colour by ORDER, not magnitude. Guarantees the
            // ramp is fully used no matter how skewed the values are, at the
            // cost of no longer encoding distance between them.
            function rankT(v) {
                if (!sorted || sorted.length === 0) return null;
                var lo = 0, hi = sorted.length;
                while (lo < hi) {
                    var m = (lo + hi) >> 1;
                    if (sorted[m] < v) lo = m + 1; else hi = m;
                }
                var first = lo;
                hi = sorted.length;
                var lo2 = first;
                while (lo2 < hi) {
                    var m2 = (lo2 + hi) >> 1;
                    if (sorted[m2] <= v) lo2 = m2 + 1; else hi = m2;
                }
                // Midpoint of the tied block, so equal values get one colour.
                var pos = (first + lo2 - 1) / 2;
                return sorted.length <= 1 ? 0.5 : pos / (sorted.length - 1);
            }

            return function (v) {
                if (typeof v !== 'number' || !isFinite(v)) return '';
                var t;
                if (curve === 'rank' && mid === null) {
                    var rt = rankT(v);
                    t = rt === null ? 0.5 : rt;
                } else if (mid !== null) {
                    // Diverging: mid pins to 0.5 and each wing is scaled by the
                    // LARGER reach, so an asymmetric spread keeps both sides on
                    // the same units instead of squashing the shorter one. The
                    // curve is applied to each wing's MAGNITUDE so both sides
                    // compress identically and the midpoint stays at 0.5.
                    var reach = Math.max(Math.abs(max - mid), Math.abs(mid - min));
                    if (reach <= 0) {
                        t = 0.5;
                    } else {
                        var d = (v - mid) / reach;
                        // Math.min(1, Math.abs(d)) clamps the wing magnitude into
                        // 0..1 BEFORE shaping - same requirement as the plain
                        // branch below, see the note there.
                        var s = shape(Math.min(1, Math.abs(d)));
                        t = 0.5 + (d < 0 ? -s : s) / 2;
                    }
                } else {
                    // CLAMP BEFORE SHAPING. An explicit range= can leave values
                    // OUTSIDE the domain (range=0:p99 on a column with large
                    // negatives puts them at t = -1.35), and shape() is only
                    // defined on 0..1: curve=log does Math.log(1 + t*99), so a
                    // negative t took the log of a negative and returned NaN -
                    // and NaN then defeats sample(), because every `t <= stop`
                    // comparison is false for NaN and the loop falls through to
                    // the LAST stop. Out-of-range values therefore rendered at
                    // FULL saturation, the exact opposite of the floor they
                    // belong on. curve=linear hid the bug (shape is identity).
                    var raw = span <= 0 ? 0.5 : (v - min) / span;
                    t = shape(Math.max(0, Math.min(1, raw)));
                }
                if (!isFinite(t)) t = 0;
                t = Math.max(0, Math.min(1, t));
                if (bins > 1) t = Math.round(t * (bins - 1)) / (bins - 1);

                var key = t.toFixed(4);
                if (cache[key] !== undefined) return cache[key];
                var fill = sample(ramp, t);
                var css = 'background-color:' + toHex(fill);
                if (wantText) {
                    var fg = readableOn(fill, textMain);
                    if (fg) css += ';color:' + toHex(fg);
                }
                cache[key] = css;
                return css;
            };
        }

        var VALID = {
            scale: ['col', 'row', 'shared', 'grid'],
            scope: ['filtered', 'all', 'page'],
            ramp: ['brand', 'warm', 'cool', 'diverging', 'mono'],
            curve: ['linear', 'sqrt', 'log', 'rank'],
            text: ['auto', 'keep']
        };

        // heatmap(TARGET, COLUMNS?, key=value...)
        // Positional slots stay fixed and everything optional is an
        // order-independent key=value modifier - the action(..., autoload=true)
        // idiom - so new knobs never shift an existing call's argument meaning.
        function parseArgs(args) {
            if (!args || args.length === 0) return null;
            var target = String(args[0] || '').trim().toLowerCase();
            if (target !== 'cell' && target !== 'row' && target !== 'pivot') return null;

            var rule = {
                type: 'heat',
                target: target,
                columns: [],
                scale: target === 'pivot' ? 'grid' : 'col',
                scope: 'filtered',
                ramp: 'brand',
                curve: 'linear',
                range: null,
                mid: null,
                bins: 0,
                text: 'auto'
            };

            var sawColumns = false;
            for (var i = 1; i < args.length; i++) {
                var raw = String(args[i] || '').trim();
                if (!raw) continue;
                var eq = raw.indexOf('=');
                if (eq > 0) {
                    var k = raw.slice(0, eq).trim().toLowerCase();
                    var v = raw.slice(eq + 1).trim();
                    if (k === 'scale' || k === 'scope' || k === 'ramp' || k === 'curve' || k === 'text') {
                        var lv = v.toLowerCase();
                        if (VALID[k].indexOf(lv) !== -1) rule[k] = lv;
                    } else if (k === 'range') {
                        rule.range = v;
                    } else if (k === 'mid') {
                        rule.mid = v;
                    } else if (k === 'bins') {
                        var b = parseInt(v, 10);
                        if (isFinite(b) && b > 1) rule.bins = b;
                    }
                    continue;
                }
                if (!sawColumns) {
                    sawColumns = true;
                    // '|' column list matches the search builder's typed-pipe
                    // value-set convention rather than inventing a separator.
                    rule.columns = raw.split('|').map(function (c) {
                        return c.trim().toUpperCase();
                    }).filter(Boolean);
                }
            }

            // scale= is target-sensitive; coerce rather than drop the rule, so a
            // near-miss still paints something instead of silently doing nothing.
            if (target === 'pivot' && rule.scale === 'shared') rule.scale = 'grid';
            if (target !== 'pivot' && rule.scale === 'grid') rule.scale = 'col';
            // heatmap(row, COL) is necessarily driven by that one column's spread.
            if (target === 'row') rule.scale = 'col';
            if (target !== 'pivot' && rule.columns.length === 0) return null;

            return rule;
        }

        return {
            parseArgs: parseArgs,
            domainFrom: domainFrom,
            colorizer: colorizer,
            numFrom: numFrom,
            parseColor: parseColor,
            themeVar: themeVar,
            toHex: toHex,
            contrast: contrast,
            // Exported for the CHART palette engine (getChartColor). Exported
            // rather than re-implemented on purpose: an Oklab rotation written
            // twice is two things to keep in step, and a heatmap and a bar chart
            // on the same report disagreeing about "the brand hue rotated 90"
            // is exactly the drift this codebase keeps paying for.
            rotateHue: rotateHue,
            rgbToOklab: rgbToOklab,
            oklabToRgb: oklabToRgb
        };
    })();

    // action() dispatches on its FIRST argument into five branches that share
    // almost nothing (different arity, different argument meanings, different
    // output), so the lazy module carries a SEPARATE signature per type, keyed
    // `action:<type>`. This list is the single source for resolving which one to
    // show; `action` stays ONE keyword to the CodeMirror mode above.
    const PENUMBRA_ACTION_TYPES = ['search', 'trigger', 'infobox', 'toast', 'prompt', 'feedback'];
    window.PENUMBRA_ACTION_TYPES = PENUMBRA_ACTION_TYPES;

    // ---- action(feedback, ...) ------------------------------------------------
    // Shared by BOTH snippet engines and BOTH click handlers, so the four sites
    // cannot drift (the standing hazard for every other action type).
    //
    // TYPESPEC grammar - ONE argument, so parseFunctionArgs' quote tracking
    // protects any commas inside it:
    //     'Type A|Question 1*|Question 2 ; Type B|Question 3'
    //   ';' separates TYPES (the dropdown), '|' separates a type's label from
    //   its questions. A trailing '*' marks a question required; a trailing
    //   '[One,Two,Three]' turns it into a dropdown instead of a text box.
    const PENUMBRA_FEEDBACK_MAX_TYPES = 12;
    const PENUMBRA_FEEDBACK_MAX_QUESTIONS = 12;

    function penumbraParseFeedbackSpec(spec) {
        const out = [];
        // \x02 wraps a pre-formatted number/date so its thousands comma cannot
        // split an enclosing argument list. parseFunctionArgs has already done
        // its splitting by the time we get here, so the guard has served its
        // purpose - strip it, or the sentinels show up inside a question label.
        // Doing it HERE covers both engines from one place.
        const raw = String(spec == null ? '' : spec).replace(/\x02/g, '').trim();
        if (!raw) return out;
        const types = raw.split(';');
        for (let i = 0; i < types.length && out.length < PENUMBRA_FEEDBACK_MAX_TYPES; i++) {
            const chunk = types[i].trim();
            if (!chunk) continue;
            const parts = chunk.split('|');
            const typeLabel = parts[0].trim();
            if (!typeLabel) continue;
            const questions = [];
            for (let j = 1; j < parts.length && questions.length < PENUMBRA_FEEDBACK_MAX_QUESTIONS; j++) {
                let q = parts[j].trim();
                if (!q) continue;
                // '*' is stripped BEFORE the bracket parse so `Severity[A,B]*`
                // works as well as the bare `Severity*`.
                let required = false;
                if (q.charAt(q.length - 1) === '*') { required = true; q = q.slice(0, -1).trim(); }
                let choices = null;
                const m = q.match(/^(.*?)\s*\[([^\]]*)\]$/);
                if (m) {
                    const stem = m[1].trim();
                    const opts = m[2].split(',').map(o => o.trim()).filter(o => o !== '');
                    if (stem && opts.length) { q = stem; choices = opts; }
                }
                if (q) questions.push({ label: q, required: required, choices: choices });
            }
            out.push({ label: typeLabel, questions: questions });
        }
        return out;
    }

    // The report this feedback is ABOUT. The short id is only a lookup key - the
    // server resolves the owner address from it and never trusts a posted
    // recipient - so an unsaved report simply yields '' and routes to support.
    function penumbraFeedbackReportContext() {
        let id = '';
        try { id = new URLSearchParams(window.location.search).get('id') || ''; } catch (e) { }
        let title = '';
        try { title = ($('#mainReportTitle').text() || '').replace(/\s+/g, ' ').trim(); } catch (e) { }
        return { id: id.trim(), title: title };
    }

    // Pull the leading DIRECTIVE segments off a TYPESPEC. Directives are ordinary
    // `;` segments that come first, so nothing needs a positional slot:
    //   'to:jsmith,jdoe ; freeze:Disputed totals ; Bug|What happened?*'
    //
    //   to:UNITYID[,UNITYID]  send to these people instead of the report owner.
    //                         The snippet can only ever NAME someone, never give
    //                         an address; the server accepts a name only if that
    //                         person is individually authorised on this report,
    //                         and otherwise falls back to the owner and says so.
    //                         Ids pass through UNVALIDATED on purpose - the server
    //                         is the authority, and quietly dropping a typo here
    //                         would hide it from the rejection banner.
    //   freeze[:LABEL]        offer a checkbox that saves the rows currently in
    //                         view as a server snapshot and links it in the mail.
    //                         LABEL names the snapshot.
    //
    // A type whose label literally starts with `to:` or is exactly `freeze` is
    // not expressible - the trade for needing no empty argument slots.
    function penumbraExtractFeedbackDirectives(spec) {
        const out = {
            to: '', freeze: false, freezeLabel: '',
            rest: String(spec == null ? '' : spec).replace(/\x02/g, '')
        };
        let guard = 0;
        while (guard++ < 4) {
            const semi = out.rest.indexOf(';');
            const head = (semi === -1 ? out.rest : out.rest.substring(0, semi)).trim();
            const tail = semi === -1 ? '' : out.rest.substring(semi + 1);
            if (/^to\s*:/i.test(head)) {
                out.to = head.replace(/^to\s*:/i, '')
                    .split(',')
                    .map(s => s.trim())
                    .filter(s => s !== '')
                    .slice(0, 5)
                    .join(',');
                out.rest = tail;
                continue;
            }
            // `(:|$)` so a type genuinely called "Freezer issues" is left alone.
            if (/^freeze\s*(:|$)/i.test(head)) {
                out.freeze = true;
                out.freezeLabel = head.replace(/^freeze\s*:?/i, '').trim().slice(0, 120);
                out.rest = tail;
                continue;
            }
            break;
        }
        return out;
    }

    // Every column IN THE ORDER THE USER HAS THEM, each tagged with what is being
    // done to it. Replaces an earlier "Hidden columns" line, which only answered
    // one question: an owner reconciling a number needs to see the whole layout -
    // what is off, what is being totalled, what is sorted, what is grouped -
    // because any of those explains a figure that "looks wrong".
    //
    // DOM order of #tableHeader IS the display order, so no separate ordering
    // state is needed. Each lookup is independently guarded; a column that
    // cannot be interrogated still gets listed by name.
    const PENUMBRA_FEEDBACK_MAX_COLUMNS = 80;

    function penumbraFeedbackColumnReport() {
        const out = [];
        let jsonCols = null;
        try { jsonCols = _detectJsonColumns(); } catch (e) { jsonCols = null; }

        let groupCol = '';
        try { groupCol = String(currentGroupingColumn || '').toUpperCase(); } catch (e) { }

        // colIdentifier -> "sort N dir", N being multi-sort priority.
        const sortMap = {};
        try {
            if (Array.isArray(sortCriteria)) {
                for (let i = 0; i < sortCriteria.length; i++) {
                    const c = sortCriteria[i];
                    if (c && c.colIdentifier) {
                        sortMap[String(c.colIdentifier).toUpperCase()] =
                            'sort ' + (i + 1) + ' ' + (c.direction || 'asc');
                    }
                }
            }
        } catch (e) { }

        try {
            $('#tableHeader th[data-colname]').each(function () {
                if (out.length >= PENUMBRA_FEEDBACK_MAX_COLUMNS) { return false; }
                const raw = $(this).data('colname');
                if (raw === undefined || raw === null || raw === '') { return; }
                const name = String(raw);
                const upper = name.toUpperCase();
                const flags = [];

                if (this.style.display === 'none') { flags.push('hidden'); }
                if (jsonCols && jsonCols.has && jsonCols.has(upper)) { flags.push('nested'); }
                if (groupCol && upper === groupCol) { flags.push('grouped'); }
                if (sortMap[upper]) { flags.push(sortMap[upper]); }
                try {
                    const sum = penumbraResolveSummaryForName(name);
                    if (sum) { flags.push('summary: ' + sum); }
                } catch (e) { }

                out.push({ n: name, f: flags });
            });
        } catch (e) { }

        return out;
    }

    // "John Smith (jsmith@ncsu.edu)" for the frozen snapshot's note, so someone
    // reading the snapshot list months later can see who raised it without
    // cross-referencing the email. Degrades name+email -> name -> email -> unity
    // id -> '' rather than emitting a half-formed "(jsmith@ncsu.edu)".
    //
    // Convenience only: the note is client-supplied, so the AUTHORITATIVE record
    // of who created a snapshot remains CREATED_BY, which manage_snapshots.php
    // sets server-side from the session.
    function penumbraFeedbackAuthorLabel() {
        let s = {};
        try {
            if (typeof penumbra_vars !== 'undefined' && penumbra_vars && penumbra_vars.shibboleth) {
                s = penumbra_vars.shibboleth;
            }
        } catch (e) { }
        const name = String((s.fname || '') + ' ' + (s.lname || '')).replace(/\s+/g, ' ').trim();
        const email = String(s.mail || s.email || '').trim();
        if (name && email) { return name + ' (' + email + ')'; }
        if (name) { return name; }
        if (email) { return email; }
        let uid = '';
        try {
            uid = String((typeof penumbra_vars !== 'undefined' && penumbra_vars && penumbra_vars.currentUserKey)
                || s.unityid || s.unity || '').trim();
        } catch (e) { }
        return uid;
    }

    // Save the rows currently in view as a SERVER snapshot, so the owner opens
    // exactly the data the sender was looking at rather than whatever the query
    // returns later. Reuses doCreateServerSnapshot(), which already handles the
    // encrypted-report case, the 50-per-report cap and its own toasts.
    //
    // Calls back with null on EVERY failure path: a freeze that cannot happen
    // must not cost the user their message - the feedback still sends, and the
    // email simply carries no snapshot link.
    function penumbraFreezeForFeedback(labelBase, doneCb) {
        const finish = (typeof doneCb === 'function') ? doneCb : function () { };
        let rid = '';
        try { rid = new URLSearchParams(window.location.search).get('id') || ''; } catch (e) { }
        // An unsaved report has nowhere to hang a server snapshot.
        if (!rid || typeof doCreateServerSnapshot !== 'function') { finish(null); return; }

        const $rows = $('#groupedResultsContainer').is(':visible')
            ? $("#groupedResultsContainer tbody tr:not(.search-hidden):not(.journal-note-child)")
            : $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)");
        if (!$rows.length) { finish(null); return; }

        // The timestamp is what makes the name unique, which is what lets
        // manage_snapshots.php resolve the new row's id by name.
        let name = (labelBase || 'Feedback freeze') + ' - ' + new Date().toLocaleString();
        if (name.length > 255) { name = name.slice(0, 255); }

        const who = penumbraFeedbackAuthorLabel();
        const note = who
            ? ('Frozen from the feedback form by: ' + who)
            : 'Frozen from the feedback form.';

        try {
            doCreateServerSnapshot(name, note, rid, $rows, function (resp) {
                const okSave = resp && resp.status === 'success' && resp.snap_id;
                finish(okSave ? { snap_id: String(resp.snap_id) } : null);
            });
        } catch (e) {
            finish(null);
        }
    }

    // A snapshot of everything about the CURRENT VIEW that could have changed by
    // the time the owner opens the report. This is the difference between "the
    // total looks wrong" and a reproducible report: without it the owner opens
    // the same URL, sees a different filter/sort/pivot, and cannot verify a
    // thing. Deliberately NOT rendered as form fields - it is context to carry,
    // not something the sender should have to fill in or curate.
    //
    // Built from the helpers the EXPORT-AUDIT path already uses
    // (_penumbraExportContext / _penumbraViewMode / _penumbraExportDims) plus the
    // shared penumbraDataLookup(), so it cannot drift from what data() reports
    // or from what an export records. Every read is individually guarded: a
    // failure here must never stop someone sending feedback.
    function penumbraFeedbackViewState() {
        const rows = [];
        const push = (label, value) => {
            let v = String(value == null ? '' : value).replace(/\s+/g, ' ').trim();
            if (v === '' || rows.length >= 20) return;
            if (v.length > 300) { v = v.slice(0, 300) + '...'; }
            rows.push({ label: label, value: v });
        };
        const look = (key) => {
            try { const r = penumbraDataLookup(key); return (r && r.v != null) ? r.v : ''; }
            catch (e) { return ''; }
        };

        let ctx = { prompts: '', search: '' };
        try { ctx = _penumbraExportContext() || ctx; } catch (e) { }
        let vm = { mode: 'flat', snap: false };
        try { vm = _penumbraViewMode() || vm; } catch (e) { }

        // --- View type, with enough detail to rebuild it ---
        let viewLabel = 'Standard table';
        if (vm.mode === 'pivot') {
            const bits = [];
            try {
                const ps = currentPivotSettings;
                if (ps) {
                    if (ps.rows && ps.rows.length) { bits.push('rows: ' + ps.rows.join(', ')); }
                    if (ps.cols && ps.cols.length) { bits.push('columns: ' + ps.cols.join(', ')); }
                    if (ps.vals) { bits.push('values: ' + ps.vals); }
                    if (ps.agg && ps.agg.length) { bits.push('aggregate: ' + ps.agg.join(', ')); }
                }
            } catch (e) { }
            viewLabel = 'Pivot' + (bits.length ? ' (' + bits.join('; ') + ')' : '');
        } else if (vm.mode === 'group') {
            let gc = '';
            // Friendly form: a bucket grouping is stored as its token, and
            // "Grouped by AWARD_DATE:fy" is not a sentence anyone should read.
            try { gc = currentGroupingColumn ? pivotFieldDisplayLabel(currentGroupingColumn) : ''; } catch (e) { }
            viewLabel = 'Grouped' + (gc ? ' by ' + gc : '');
        }
        push('View', viewLabel);
        // Orthogonal to the view mode, and the single most misleading thing to
        // omit: the owner would otherwise compare against live data.
        if (vm.snap) { push('Data shown', 'A SNAPSHOT, not the live query'); }

        // --- Filter / sort / prompts: reported even when ABSENT, because
        // "there was no filter" is as much a fact as the filter itself. ---
        push('Search filter', ctx.search || '(none)');

        let sortTxt = '';
        try {
            if (Array.isArray(sortCriteria) && sortCriteria.length) {
                sortTxt = sortCriteria.map(c => (c.colIdentifier || '') + ' ' + (c.direction || '')).join(', ');
            }
        } catch (e) { }
        push('Sort order', sortTxt || '(report default)');

        push('Prompt answers', ctx.prompts || '(none)');

        // --- The rest only earns a line when it has something to say ---
        try {
            const dims = _penumbraExportDims();
            if (dims && dims.rows != null) { push('Rows in view', String(dims.rows)); }
        } catch (e) { }

        // Columns are reported separately and in full - see
        // penumbraFeedbackColumnReport() - rather than as a "hidden columns" line.
        if (String(look('rowexpand')) === 'true') { push('Row height', 'Expanded'); }
        if (String(look('rowlimit')) === 'true') { push('Row limit', 'Active'); }
        push('Data retrieved', look('timestamp'));

        return rows;
    }

    // Compile a TYPESPEC into a penumbra_forms.js definition object.
    function penumbraBuildFeedbackForm(spec, linkLabel) {
        const routed = penumbraExtractFeedbackDirectives(spec);
        let types = penumbraParseFeedbackSpec(routed.rest);
        if (!types.length) {
            // No spec = the generic three-way form, the same shape as the app's
            // own feedback dialog.
            types = [{ label: 'Bug', questions: [] },
                     { label: 'Question', questions: [] },
                     { label: 'Suggestion', questions: [] }];
        }
        const ctx = penumbraFeedbackReportContext();
        let viewJson = '';
        try { viewJson = JSON.stringify(penumbraFeedbackViewState()); } catch (e) { viewJson = ''; }
        let colsJson = '';
        try { colsJson = JSON.stringify(penumbraFeedbackColumnReport()); } catch (e) { colsJson = ''; }
        const fields = [{ kind: 'identity' }];

        // The option VALUE is the label text itself: it is what the e-mail should
        // show, and showWhen matches on it directly.
        fields.push({
            name: 'type', label: 'Type', control: 'select',
            options: types.map(t => [t.label, t.label])
        });

        const anyQuestions = types.some(t => t.questions.length > 0);
        if (!anyQuestions) {
            fields.push({
                name: 'what', label: "What happened, or what you'd like to see",
                control: 'textarea', rows: 3, required: true, q: true
            });
        } else {
            for (let i = 0; i < types.length; i++) {
                // A type with no questions of its own still needs somewhere to
                // type, or picking it would leave an empty form.
                const qs = types[i].questions.length
                    ? types[i].questions
                    : [{ label: 'Details', required: true, choices: null }];
                for (let j = 0; j < qs.length; j++) {
                    const q = qs[j];
                    const f = {
                        name: 't' + i + '_q' + j, label: q.label, required: !!q.required,
                        q: true, showWhen: { field: 'type', value: types[i].label }
                    };
                    if (q.choices) {
                        f.control = 'select';
                        // Blank first option so a dropdown answer is a deliberate
                        // choice - otherwise `required` is satisfied by default.
                        f.options = [['', '- select -']].concat(q.choices.map(c => [c, c]));
                    } else {
                        f.control = 'textarea';
                        f.rows = 2;
                    }
                    fields.push(f);
                }
            }
        }

        // Offered only when there is a SAVED report to hang a server snapshot on
        // - on an unsaved report the box could never do anything but fail.
        // Unchecked by default: it writes shared data and consumes the report's
        // 50-snapshot budget, so it should be a deliberate act, not a default.
        const canFreeze = routed.freeze && !!ctx.id;
        if (canFreeze) {
            fields.push({
                name: 'freeze',
                control: 'checkbox',
                label: 'Freeze a copy of this dataset for review',
                hint: 'Saves the rows you are looking at as a server snapshot and links it in the email, so they see this exact data even if the report changes.'
            });
        }

        // Context is COLLECTED but not displayed. Five locked boxes made the
        // sender scroll past a wall of read-only text to find the one question
        // that was actually theirs to answer, and they could not edit any of it
        // anyway - so it becomes one plain-language disclosure instead. The POST
        // field names are unchanged, so the server side is untouched.
        fields.push({
            kind: 'notice',
            text: 'Other details are sent with this message: your browser, this '
                + "report's current settings (search, sort, columns and prompt answers), "
                + 'and your display preferences.'
        });
        fields.push({
            kind: 'silent', name: 'report',
            value: ctx.id ? ((ctx.title || 'Untitled') + ' [' + ctx.id + ']') : (ctx.title || '(unsaved report)')
        });
        fields.push({ kind: 'silent', name: 'page', value: String(window.location.href || '') });
        fields.push({ kind: 'silent', name: 'browser', source: 'useragent' });
        fields.push({ kind: 'silent', name: 'theme', source: 'theme' });
        fields.push({ kind: 'silent', name: 'density', source: 'density' });

        const def = {
            formId: 'reportfeedback',
            postForm: 'report_feedback',
            title: linkLabel || 'Send feedback',
            // Deliberately does NOT name the routed person: the client cannot
            // know whether the server will accept the `to:` request, so promising
            // a specific recipient here could be a lie. "contact" covers both the
            // accepted target and the fall-back-to-owner case.
            intro: routed.to
                ? 'Goes to the contact for this report.'
                : (ctx.id ? 'Goes to the owner of this report.' : 'Goes to Penumbra support.'),
            submitLabel: 'Send',
            successMsg: 'Thanks! Your message was sent.',
            // Captured at OPEN, which is also when the sender decided something
            // looked wrong - and the dialog is modal, so the view cannot move
            // underneath it. Rides in `extra` precisely because `extra` is
            // posted but never rendered as a field.
            extra: { report_id: ctx.id, to: routed.to, viewstate: viewJson, columns: colsJson },
            fields: fields
        };

        if (canFreeze) {
            // Writing a snapshot is a real round trip on top of the send, so the
            // request budget has to grow or a large dataset would trip the
            // "timed out" path after succeeding.
            def.timeoutMs = 45000;
            def.beforeSubmit = function (state, proceed) {
                if (!state || !state.values || !state.values.freeze) { proceed(null); return; }
                penumbraFreezeForFeedback(
                    routed.freezeLabel || ('Feedback - ' + (ctx.title || ctx.id)),
                    proceed
                );
            };
        }

        return def;
    }

