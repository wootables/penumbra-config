                    newCfg.legend, newCfg.values, newCfg.legendPos, newCfg.valuePos,
                    newCfg.animate, newCfg.stacked, newCfg.horizontal, newCfg.titlePos,
                    newCfg.isCurrency, newCfg.normalize, newCfg.subtitle,
                    newCfg.xAxisLabel, newCfg.yAxisLabel, newCfg.logScale,
                    newCfg.yMin, newCfg.yMax, null, false, newCfg.referenceLine);
            } catch (e) {
                console.error('renderSnippetChart failed during in-place drill:', e);
            }
