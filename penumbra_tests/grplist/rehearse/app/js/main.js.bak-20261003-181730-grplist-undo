            if (!snapshot) { _ctxFail('This chart has no configuration to share as a preset.'); return; }
            var rid = api.getReportId();
            var defaultName = (snapshot.title && snapshot.title.trim())
                ? snapshot.title.trim()
                : ('Preset ' + (P.shared.rows(rid, P.NS.VIZ).length + 1));
            var name = window.prompt('Share this chart with everyone who can see the report, as:', defaultName);
            if (name === null) return;
            name = name.trim();
            if (name === '') { _ctxFail('Preset name cannot be empty.'); return; }
            if (P.shared.find(rid, P.NS.VIZ, name)
                && !window.confirm('A shared preset named "' + name + '" already exists. Overwrite it for everyone?')) return;
            P.shared.save(rid, P.NS.VIZ, name, snapshot, function (err) {
                if (err) { _ctxFail('Could not share preset: ' + err); return; }
                api.setLoaded(name, 'shared');
                _ctxSay("Shared chart preset “" + _escHtml(name) + "” with everyone who can see this report.");
                _ctxRefreshShared();
            });
        });
        // Copy a shared preset into your own store; the pin variant also makes
        // the copy the run-on-load preset (the engine's pin only ever names a
        // local preset).
        $menu.on('click', '.ctx-presets-copy-shared, .ctx-presets-pin-shared', function (e) {
            e.stopPropagation();
            $menu.hide();
            var P = window.PenumbraPresets, api = window._penumbraVizAutoRun;
            if (!P || !api) return;
            var name = $(this).attr('data-preset-name');
            var pin = $(this).hasClass('ctx-presets-pin-shared');
            var row = _ctxSharedVizRow(name);
            if (!row) { _ctxFail('Shared preset "' + name + '" is no longer available.'); return; }
            var cur = api.get(name);
            if (cur !== null && JSON.stringify(cur) !== JSON.stringify(row.data)
                && !window.confirm('You already have a preset named "' + name + '". Replace it with the shared version?')) return;
            if (!api.save(name, row.data)) { _ctxFail('Could not copy preset - browser storage may be full or unavailable.'); return; }
            if (pin && !api.setName(name)) { _ctxFail('Could not save the run-on-load preference - browser storage may be full.'); return; }
            _ctxSay(pin
                ? "Preset “" + _escHtml(name) + "” was copied to your presets and will run when this report loads."
                : "Copied “" + _escHtml(name) + "” to your presets.");
            api.refresh();
        });
        $menu.on('click', '.ctx-presets-delete-shared', function (e) {
            e.stopPropagation();
            $menu.hide();
            var P = window.PenumbraPresets, api = window._penumbraVizAutoRun;
            if (!P || !P.shared || !api) return;
            var name = $(this).attr('data-preset-name');
            if (!name) return;
            if (!window.confirm('Delete shared preset "' + name + '" for everyone who can see this report? This cannot be undone.')) return;
            P.shared.remove(api.getReportId(), P.NS.VIZ, name, function (err) {
                if (err) { _ctxFail('Could not delete shared preset: ' + err); return; }
                _ctxSay("Deleted shared preset “" + _escHtml(name) + "” for everyone.");
                _ctxRefreshShared();
            });
        });

        // Flip submenus that would overflow the right viewport edge to
        // open leftward instead. Measured on first hover so cascading
        // levels (X-entry submenu → column-leaf submenu) each get
        // their own placement based on where the parent ended up.
        $menu.on('mouseenter', '.ctx-has-submenu', function () {
            var $sub = $(this).children('.ctx-submenu');
            if (!$sub.length) return;
            $sub.removeClass('ctx-submenu-flip');

            // Case A: the scrollable drill category list (.ctx-submenu-x). It is
            // capped + scrolls, but when opened near the viewport bottom the
            // (up to 440px) box would still run off-screen, so clamp its top up
            // to fit. Adjust `top` (NOT transform) so position:fixed children in
            // Case B aren't re-based onto a transformed ancestor.
            if ($sub.hasClass('ctx-submenu-x')) {
                $sub.css('top', '');
                var ra = $sub[0].getBoundingClientRect();
                if (ra.right > window.innerWidth - 8) $sub.addClass('ctx-submenu-flip');
                var rb = $sub[0].getBoundingClientRect();
                if (rb.bottom > window.innerHeight - 8) {
                    var over = rb.bottom - (window.innerHeight - 8);
                    var curTop = parseFloat($sub.css('top')) || 0;
                    $sub.css('top', (curTop - over) + 'px');
                }
                return;
            }

            // Case B: a category row INSIDE the scrollable list. Its nested
            // column submenu (left:100%) would be clipped by the parent's
            // overflow:auto, so re-anchor it to the viewport (position:fixed),
            // flipping/clamping to stay on-screen. fixed escapes overflow clip.
            if ($(this).parent().hasClass('ctx-submenu-x')) {
                var ir = this.getBoundingClientRect();
                $sub.css({ position: 'fixed', left: ir.right + 'px', right: 'auto', top: Math.max(8, ir.top - 5) + 'px', bottom: 'auto' });
                var sr = $sub[0].getBoundingClientRect();
                if (sr.right > window.innerWidth - 8) {
                    $sub.css({ left: 'auto', right: Math.max(8, window.innerWidth - ir.left) + 'px' });
                }
                if (sr.bottom > window.innerHeight - 8) {
                    $sub.css({ top: Math.max(8, window.innerHeight - 8 - sr.height) + 'px' });
                }
                return;
            }

            var r = $sub[0].getBoundingClientRect();
            if (r.right > window.innerWidth - 8) {
                $sub.addClass('ctx-submenu-flip');
            }
        });
    })();

    // ─── Right-click submenu population + helpers ─────────────────────

    // Resolve the chart's current vizConfig from the canvas (preview
    // chart falls back to lastVisConfig). Returns null when nothing is
    // available (preview before first generate, etc.).
    function _getCanvasVizConfig(canvas) {
        var cfg = $(canvas).data('vizConfig');
        if (!cfg && canvas && canvas.id === 'vizChart') {
            cfg = (typeof lastVisConfig !== 'undefined' && lastVisConfig) ? lastVisConfig : null;
        }
        return cfg || null;
    }

    // Build the X-entry → drill-column nested submenu under the
    // "Drill into" item. X entries come from the chart's currently
    // displayed labels (so they reflect any limit / sort the user has
    // already applied); drill columns from _getDrillCandidateColumns.
    // One menu node is reused by every canvas on the page, so the Sorting
    // submenu has to be retargeted per chart. On a GANTT the "Value" entries
    // sort by START DATE - the Builder already renames the option, but the
    // context menu still said "Value", which is how a Gantt ends up looking
    // sorted by nothing in particular: the bars move, the day counts on them
    // do not. Name it Start Date here too, and reveal the Duration pair that
    // actually ranks by bar length.
    function _populateContextMenuSortLabels($menu, canvas) {
        var type = '';
        if (canvas && canvas.id === 'vizChart') {
            // The live tile beats lastVisConfig, which lags the type the user
            // has selected but not yet generated.
            type = $('.viz-type-option.active').data('type') || '';
        }
        if (!type) {
            var cfg = _getCanvasVizConfig(canvas);
            type = (cfg && cfg.type) || '';
        }
        var isGantt = (String(type) === 'gantt');
        var $val = $menu.find('li[data-action="sort"][data-sortby="value"]');
        $val.filter('[data-sortdir="desc"]').html('<span class="ctx-icon">&#x2193;</span> Sort by ' +
            (isGantt ? 'Start Date (newest \u2192 oldest)' : 'Value (high \u2192 low)'));
        $val.filter('[data-sortdir="asc"]').html('<span class="ctx-icon">&#x2191;</span> Sort by ' +
            (isGantt ? 'Start Date (oldest \u2192 newest)' : 'Value (low \u2192 high)'));
        $menu.find('li.ctx-gantt-sort').toggle(isGantt);
    }

    // Mark the currently-applied sort in the chart's right-click menu
    // so the user can see which sort is live at a glance. Reads from
    // the canvas's vizConfig (or the live preview selects for vizChart)
    // and toggles a .ctx-active class on the matching sort <li>.
    function _markActiveSortInContextMenu($menu, canvas) {
        var sortBy = null, sortDir = null;
        if (canvas && canvas.id === 'vizChart') {
            sortBy = $('#vizSortBy').val();
            sortDir = $('#vizSortDir').val();
        } else {
            var cfg = $(canvas).data('vizConfig');
            if (cfg) {
                sortBy = cfg.sortBy || 'value';
                sortDir = cfg.sortDir || 'desc';
            }
        }
        $menu.find('li[data-action="sort"]').each(function () {
            var $li = $(this);
            var match = (String($li.data('sortby')) === String(sortBy)
                      && String($li.data('sortdir')) === String(sortDir));
            $li.toggleClass('ctx-active', match);
        });
    }

    // Show / hide the stack-order entries inside the Sorting submenu based
    // on whether stacking + groupBy are active (stack order is meaningless
    // otherwise - there are no stacks to reorder).  Builder preview reads
    // from the live form; rendered charts read from vizConfig.
    function _populateContextMenuStackOrder($menu, canvas) {
        var stacked = false, hasGroup = false;
        if (canvas && canvas.id === 'vizChart') {
            stacked = $('#vizStacked').is(':checked');
            hasGroup = !!($('#vizGroupBy').val() && $('#vizGroupBy').val() !== 'none');
        } else {
            var cfg = $(canvas).data('vizConfig');
            if (cfg) {
                stacked = cfg.stacked === true;
                hasGroup = !!(cfg.groupBy && cfg.groupBy !== 'none');
            }
        }
        var show = stacked && hasGroup;
        $menu.find('.ctx-stack-order-divider').toggle(show);
        $menu.find('.ctx-stack-order-item').toggle(show);
    }

    // Mark the currently-applied stack order in the menu so the user can
    // see which option is live.  Reads the live form on the preview chart,
    // the canvas's vizConfig on rendered charts.
    function _markActiveStackOrderInContextMenu($menu, canvas) {
        var stackOrder = null;
        if (canvas && canvas.id === 'vizChart') {
            stackOrder = $('#vizStackOrder').val() || 'default';
        } else {
            var cfg = $(canvas).data('vizConfig');
            if (cfg) stackOrder = cfg.stackOrder || 'default';
        }
        $menu.find('li[data-action="stackorder"]').each(function () {
            var $li = $(this);
            var match = String($li.data('stackorder')) === String(stackOrder);
            $li.toggleClass('ctx-active', match);
        });
    }

    // Show / hide the Filtering parent menu item.  Visible when at least
    // one filter child (X-axis filter, Group filter, Backfill, Clear-all,
    // Sync-to-table) is itself shown.  Run AFTER the individual filter
    // populate functions so it reads their final state.
    //
    // NOTE: jQuery's :visible selector returns false when ANY ancestor is
    // display:none - and this function runs before the menu itself is
    // shown.  We must read inline `display` directly so the parent's
    // hidden state doesn't poison the per-child check.
    function _populateContextMenuFilteringRoot($menu) {
        var $root = $menu.find('.ctx-filtering-root');
        var selectors = [
            '.ctx-filter-x-root',
            '.ctx-filter-g-root',
            '.ctx-backfill-root',
            '.ctx-clear-filters-root',
            '.ctx-sync-to-table-root'
        ];
        var anyShown = false;
        selectors.forEach(function (sel) {
            $menu.find(sel).each(function () {
                if (this.style.display !== 'none') { anyShown = true; }
            });
        });
        $root.toggle(anyShown);
    }

    // Apply a stack-order change to a chart and re-render in place.
    // Mirrors _applySortToChart but flips cfg.stackOrder.  No-op when the
    // chart has no source rows cached (preview-before-render).
    function _applyStackOrderToChart(canvas, stackOrder) {
        if (!canvas || !stackOrder) return;
        var $c = $(canvas);
        if (canvas.id === 'vizChart') {
            $('#vizStackOrder').val(stackOrder);
            if (typeof window.vizRunLiveUpdate === 'function') window.vizRunLiveUpdate();
            return;
        }
        var cfg = $c.data('vizConfig');
        if (!cfg) return;
        var sourceRows = _getChartCanvasSourceRows(canvas);
        if (!sourceRows || !sourceRows.length) return;
        cfg.stackOrder = stackOrder;
        try {
            var chartData = generateChartDataFromMaps(
                sourceRows, cfg.xAxis, cfg.yAxis, cfg.groupBy || null,
                cfg.agg, cfg.limit, cfg.type,
                cfg.sortBy, cfg.sortDir, cfg.stackOrder,
                cfg.normalize, cfg.otherBucket,
                cfg.comboSeries || null, cfg.funnelMode, cfg
            );
            var existing = (typeof Chart !== 'undefined' && Chart.getChart) ? Chart.getChart(canvas) : null;
            if (existing) { try { existing.destroy(); } catch (e) { } }
            if (cfg.trendLine && cfg.trendLine !== 'none' && typeof injectTrendDataset === 'function') {
                injectTrendDataset(chartData, cfg.trendLine);
            }
            if (typeof renderSnippetChart === 'function') {
                renderSnippetChart(canvas.id, cfg.type, chartData, cfg.title || '',
                    cfg.legend, cfg.values, cfg.legendPos, cfg.valuePos,
                    cfg.animate, cfg.stacked, cfg.horizontal, cfg.titlePos,
                    cfg.isCurrency, cfg.normalize, cfg.subtitle,
                    cfg.xAxisLabel, cfg.yAxisLabel, cfg.logScale,
                    cfg.yMin, cfg.yMax, cfg.comboSeries || null, cfg.comboFill, cfg.referenceLine);
                $c.data('vizConfig', cfg);
            }
        } catch (e) {
            console.error('Stack order apply failed:', e);
        }
    }

    function _populateContextMenuDrill($menu, canvas) {
        var $sub = $menu.find('.ctx-submenu-x');
        $sub.empty();

        var cfg = _getCanvasVizConfig(canvas);
        var sourceRows = _getChartCanvasSourceRows(canvas) || [];
        var chart = (typeof Chart !== 'undefined' && Chart.getChart) ? Chart.getChart(canvas) : null;
        var labels = (chart && chart.data && Array.isArray(chart.data.labels)) ? chart.data.labels : [];

        // Disable the parent item if there's nothing to drill into. Scatter and
        // histogram can't be drilled (their x labels are point coords / bin ranges,
        // not discrete row values) - match the left-click guard (typeBlocksDrill in
        // _handleChartElementClick) so the menu doesn't offer a drill that would
        // filter every row out and yield an empty child chart.
        var disabled = !cfg || !sourceRows.length || !labels.length || !cfg.xAxis
            || cfg.type === 'scatter' || cfg.type === 'histogram';
        $menu.find('.ctx-drill-root').toggleClass('ctx-disabled', disabled);
        if (disabled) {
            $sub.append('<li class="ctx-empty">Nothing to drill</li>');
            return;
        }

        var drillPath = $(canvas).data('drillPath') || [];
        var candidates = _getDrillCandidateColumns(sourceRows, cfg, drillPath);
        if (candidates.length === 0) {
            $sub.append('<li class="ctx-empty">No more columns to drill into</li>');
            return;
        }

        // For each visible X label, build a leaf submenu of candidate
        // columns. Skip "Other" / synthetic entries since they can't
        // be expressed as a single equality filter.
        labels.forEach(function (lbl) {
            var displayLbl = String(lbl == null ? '' : lbl);
            var cleanLbl = _chartDrillCleanLabel(lbl);
            if (cleanLbl === 'Other' || cleanLbl === '(Other)') return;

            var leafHtml = candidates.map(function (col) {
                var glyph = (typeof getColumnTypeGlyph === 'function') ? getColumnTypeGlyph(col) : '';
                var glyphHtml = glyph ? '<span class="ctx-col-glyph">' + escapeHtml(glyph) + '</span> ' : '';
                return '<li class="ctx-drill-leaf" data-x-val="' + escapeHtml(cleanLbl) + '" data-col="' + escapeHtml(col) + '">'
                     + glyphHtml + escapeHtml(col)
                     + '</li>';
            }).join('');
            leafHtml += '<li class="ctx-divider"></li>';
            leafHtml += '<li class="ctx-drill-show-rows" data-x-val="' + escapeHtml(cleanLbl) + '">Show source rows</li>';

            $sub.append(
                '<li class="ctx-has-submenu ctx-drill-cat">'
                +   '<span class="ctx-cat-label">' + escapeHtml(displayLbl) + '</span>'
                +   '<span class="ctx-arrow">\u25B8</span>'
                +   '<ul class="ctx-submenu ctx-submenu-cols">' + leafHtml + '</ul>'
                + '</li>'
            );
        });
    }

    // Populate the Filter X-Axis / Filter Groups submenus from the
    // chart's existing filter panel. We don't duplicate any state -
    // the submenus are a different surface onto the exact same
    // `.chart-filter-item` checkboxes managed by buildChartFilterPanel,
    // so a change made via the right-click menu is indistinguishable
    // from a check toggled in the panel itself.
    //
    // Visibility rule: a section is shown only when (a) its vizConfig
    // flag (filterXAxis / filterGroup) is on and (b) the chart actually
    // has filter items for that column. Both conditions together avoid
    // empty submenus on charts where the flag is set but no values
    // exist yet (e.g. the chart is still rendering).
    function _populateContextMenuFilters($menu, canvas) {
        var $xRoot = $menu.find('.ctx-filter-x-root');
        var $gRoot = $menu.find('.ctx-filter-g-root');
        var $div   = $menu.find('.ctx-filter-divider');
        var $xSub  = $menu.find('.ctx-submenu-filter-x');
        var $gSub  = $menu.find('.ctx-submenu-filter-g');
        $xSub.empty(); $gSub.empty();
        $xRoot.hide(); $gRoot.hide(); $div.hide();

        var cfg = _getCanvasVizConfig(canvas);
        if (!cfg) return;
        var $wrapper = $(canvas).closest('.penumbra-chart-filter-wrapper');
        if (!$wrapper.length) return;

        var $items = $wrapper.find('.chart-filter-item');
        if (!$items.length) return;

        var xColU = cfg.xAxis ? String(cfg.xAxis).toUpperCase() : '';
        var gColU = (cfg.groupBy && cfg.groupBy !== 'none') ? String(cfg.groupBy).toUpperCase() : '';

        // Rewrite the submenu header labels to show the actual column being
        // filtered plus its type glyph (e.g. "Filter [abc] COLLEGE" instead
        // of the generic "Filter X-Axis").  Preserves the submenu <ul> and
        // arrow so hover-to-open still works.
        function _setFilterRootLabel($root, columnName) {
            if (!columnName) return;
            var glyph = (typeof getColumnTypeGlyph === 'function') ? getColumnTypeGlyph(columnName) : '';
            var icon = $root.children('.ctx-icon').first();
            if (icon.length) icon.text(glyph || '\u25A3');
            // Replace just the text node between the icon and the arrow.
            var arrow = $root.children('.ctx-arrow').first();
            var node = icon[0] && icon[0].nextSibling;
            var labelText = ' Filter ' + columnName + ' ';
            if (node && node.nodeType === 3) {
                node.nodeValue = labelText;
            } else {
                icon.after(document.createTextNode(labelText));
            }
            void arrow; // keep arrow reference alive; nothing else to do
        }
        _setFilterRootLabel($xRoot, cfg.xAxis);
        _setFilterRootLabel($gRoot, (cfg.groupBy && cfg.groupBy !== 'none') ? cfg.groupBy : '');

        // Bucket items by their data-column. Each item becomes a leaf
        // row with a live checkmark reflecting its current state.
        function appendLeaf($sub, col, val, isChecked) {
            $sub.append(
                '<li class="ctx-filter-leaf" data-col="' + escapeHtml(col) + '" data-val="' + escapeHtml(val) + '">'
                +   '<span class="ctx-check" style="width:12px; display:inline-block;">' + (isChecked ? '\u2713' : '') + '</span>'
                +   escapeHtml(val)
                + '</li>'
            );
        }

        var anyX = false, anyG = false;
        $items.each(function () {
            var $it = $(this);
            var col = String($it.data('column') || '');
            var val = String($it.data('value') || '');
            var checked = $it.find('input[type="checkbox"]').is(':checked');
            var colU = col.toUpperCase();
            if (cfg.filterXAxis && colU === xColU) {
                appendLeaf($xSub, col, val, checked); anyX = true;
            } else if (cfg.filterGroup && colU === gColU) {
                appendLeaf($gSub, col, val, checked); anyG = true;
            }
            // __combo_series__ filter items aren't surfaced in the
            // right-click menu for now - combo-series toggling is
            // uncommon and the filter panel handles it directly.
        });

        if (anyX) $xRoot.show();
        if (anyG) $gRoot.show();
        if (anyX || anyG) $div.show();
    }

    // Populate the Backfill toggle state.  The menu entry is only shown
    // when the chart has a finite limit AND the filter wrapper exposes a
    // hidden backfill checkbox (which buildChartFilterPanel only emits
    // when there are actual filter items to backfill).
    function _populateContextMenuBackfill($menu, canvas) {
        var $root = $menu.find('.ctx-backfill-root');
        $root.hide();
        var cfg = _getCanvasVizConfig(canvas);
        if (!cfg || !cfg.limit || cfg.limit >= 9999) return;
        var $wrapper = $(canvas).closest('.penumbra-chart-filter-wrapper');
        if (!$wrapper.length) return;
        var $cb = $wrapper.find('.chart-filter-backfill-cb');
        if (!$cb.length) return;
        var on = $cb.is(':checked');
        $root.find('.ctx-backfill-check').html(on ? '\u2713' : '&nbsp;');
        $root.show();
    }

    // Builds a short human-readable summary string describing the chart's
    // current view: category (label) count, source-row count, and any
    // limit-hit indicator.  Shared between the preview data-summary and
    // the chart context menu.  Returns an HTML fragment so callers can
    // style the separator / warn spans via CSS.
    function formatChartDataSummaryHtml(labelsCount, sourceCount, cfg) {
        var parts = [];
        if (labelsCount > 0) {
            parts.push(labelsCount.toLocaleString() + ' categor' + (labelsCount === 1 ? 'y' : 'ies'));
        }
        // "N source rows" intentionally omitted - it added noise to the summary
        // line and confused users re-configuring an existing chart (sourceCount
        // is still accepted for signature compatibility / callers).
        var limit = cfg && cfg.limit;
        var limitHit = limit && limit < 9999 && labelsCount >= limit;
        if (limitHit) {
            parts.push('<span class="viz-summary-warn">limit: ' + limit + '</span>');
        }
        if (!parts.length) return '';
        return parts.join('<span class="viz-summary-sep">\u00B7</span>');
    }

    // Refresh the #vizDataSummary line under the preview chart.  Reads the
    // live Chart.js instance + the global vizCachedData slice used to build
    // it.  No-op when the preview is closed or the chart hasn't rendered.
    //
    // CURRENTLY INERT BY DESIGN (2026-08-27): #vizDataSummary was removed from
    // the markup. In the fixed-height preview it rendered as a horizontal band
    // across the bottom of the chart and read as part of the chart itself. The
    // guard below makes this a clean no-op. Kept, rather than deleted, because
    // the counts themselves are useful - re-add the element somewhere less
    // intrusive (the tab strip, say) and this starts working again unchanged.
    // Do NOT "fix" it by putting the div back inside #vizPreviewContainer.
    function updateVizPreviewDataSummary() {
        var $summary = $('#vizDataSummary');
        if (!$summary.length) return;
        var canvasEl = document.getElementById('vizChart');
        var chart = (canvasEl && typeof Chart !== 'undefined' && Chart.getChart) ? Chart.getChart(canvasEl) : null;
        if (!chart) { $summary.hide().empty(); return; }
        var labelsCount = (chart.data && chart.data.labels) ? chart.data.labels.length : 0;
        var sourceCount = Array.isArray(window.vizCachedData) ? window.vizCachedData.length : 0;
        var cfg = $(canvasEl).data('vizConfig') || (typeof lastVisConfig !== 'undefined' ? lastVisConfig : null);
        var html = formatChartDataSummaryHtml(labelsCount, sourceCount, cfg);
        if (!html) { $summary.hide().empty(); return; }
        $summary.html(html).css('display', 'block');
    }
    window.updateVizPreviewDataSummary = updateVizPreviewDataSummary;

    // Populate the non-interactive summary row at the top of the chart
    // context menu.  Reads the clicked canvas's live chart + cached source
    // rows.  Hidden when no useful numbers are available (e.g. preview
    // before first render).
    function _populateContextMenuSummary($menu, canvas) {
        var $root = $menu.find('.ctx-summary-root');
        $root.hide().empty();
        if (!canvas) return;
        var chart = (typeof Chart !== 'undefined' && Chart.getChart) ? Chart.getChart(canvas) : null;
        if (!chart) return;
        var labelsCount = (chart.data && chart.data.labels) ? chart.data.labels.length : 0;
        var sourceRows = _getChartCanvasSourceRows(canvas);
        var sourceCount = sourceRows ? sourceRows.length : 0;
        var cfg = _getCanvasVizConfig(canvas);
        var html = formatChartDataSummaryHtml(labelsCount, sourceCount, cfg);
        if (!html) return;
        $root.html(html).show();
    }

    // Show the "Clear all filters" + "Sync to table" entries whenever at
    // least one filter value is currently unchecked.  The filter-divider
    // below them is already shown by _populateContextMenuFilters when
    // filter submenus are populated; we additionally show it here so these
    // entries have a visible separator even on charts where no specific
    // submenu section is active.
    function _populateContextMenuClearFilters($menu, canvas) {
        var $clearRoot = $menu.find('.ctx-clear-filters-root');
        var $syncRoot  = $menu.find('.ctx-sync-to-table-root');
        $clearRoot.hide();
