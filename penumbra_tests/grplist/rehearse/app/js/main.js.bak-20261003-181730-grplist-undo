        // (count / distinct / running_count) produce row-counts, not
        // monetary sums, so they should NEVER be formatted with $ even
        // when the Y column itself is a currency column. Mirrors the
        // logic in runLiveUpdate (line ~2635).
        var _cp = $("#resultsTable").data('columnProperties');
        var _cni = $("#resultsTable").data('columnNameToOriginalIndex');
        var _countAggs = ['count', 'distinct', 'running_count'];
        newCfg.isCurrency = false;
        if (newCfg.yAxis && _cp && _cni && _countAggs.indexOf(newCfg.agg) === -1) {
            var _cid = _cni[String(newCfg.yAxis).toUpperCase()];
            if (_cid !== undefined && _cp[_cid] && _cp[_cid].isCurrency) newCfg.isCurrency = true;
        }

        var chartData;
        try {
            chartData = generateChartDataFromMaps(
                filteredRows, newCfg.xAxis, newCfg.yAxis, newCfg.groupBy || null,
                newCfg.agg, newCfg.limit, newCfg.type,
                newCfg.sortBy, newCfg.sortDir, newCfg.stackOrder,
                newCfg.normalize, newCfg.otherBucket, null, newCfg.funnelMode, newCfg
            );
        } catch (e) {
            console.error('generateChartDataFromMaps failed during in-place drill:', e);
