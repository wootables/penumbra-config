        // --- 1. DETERMINE CONTEXT & VIRTUAL SCOPE ---
        let virtualSQL = fullQuery;
        let textBeforeCursorInScope = "";
        let insideTag = false;

        const textPreCursor = fullQuery.substring(0, cursorIndex);
        const lastOpenBracket = textPreCursor.lastIndexOf('[');
        const lastCloseBracket = textPreCursor.lastIndexOf(']');

        // ZOMBIE TAG CHECK:
        let insideImportTag = false;
        let importTagFromPos = null;
        let importTagToPos = null;
        if (lastOpenBracket !== -1 && lastOpenBracket > lastCloseBracket) {
            const tagPreamble = fullQuery.substring(lastOpenBracket, cursorIndex);
            if (/^\[\s*(CTE_)?SUBQUERY/i.test(tagPreamble)) {
                const nextCloseBracket = fullQuery.indexOf(']', cursorIndex);
                if (nextCloseBracket !== -1) {
                    const queryParamMatch = tagPreamble.match(/query=/i);
                    if (queryParamMatch) {
                        insideTag = true;
                        const queryStartIndex = lastOpenBracket + queryParamMatch.index + queryParamMatch[0].length;
                        virtualSQL = fullQuery.substring(queryStartIndex, nextCloseBracket);
                        const localCursorPos = cursorIndex - queryStartIndex;
                        textBeforeCursorInScope = virtualSQL.substring(0, localCursorPos);
                    }
                }
            } else {
                // Check import tag using the REAL editor value, not the modified
                // fullQuery. When a word inside the tag is selected (e.g. double-
                // clicking "IMPORT"), the selection handler replaces it with a space,
                // which breaks regex matching on the modified string. Also, the
                // cursor may be at the START of the selection (before "IMPORT"),
                // so we scan from the opening bracket to the closing bracket to
                // detect the full tag pattern.
                const realEditorValue = editor.getValue();
                const nextCloseBracket = realEditorValue.indexOf(']', lastOpenBracket + 1);
                if (nextCloseBracket !== -1) {
                    const realFullTag = realEditorValue.substring(lastOpenBracket, nextCloseBracket + 1);
                    if (/^\[\s*IMPORT\s*;/i.test(realFullTag)) {
                        insideImportTag = true;
                        importTagFromPos = editor.posFromIndex(lastOpenBracket);
                        importTagToPos = editor.posFromIndex(nextCloseBracket + 1); // include the ]
                    }
                }
            }
        }

        // --- HELPER: ROBUST CLEANER WITH BRACKET MASKING ---
        function cleanSqlContent(inputSQL, keepInnerQuery = false) {
            // Strip SQL strings handling doubled-quote escaping ('O''Brien' → removed entirely),
            // then block comments, then line comments.
            let temp = inputSQL.replace(/'(?:''|[^'])*'/g, '').replace(/\/\*[\s\S]*?\*\//g, '').replace(/--.*/g, '');

            temp = temp.replace(/\[(?!\s*(?:PROMPT|SUBQUERY|CTE_SUBQUERY))([^\]]+)\]/gi, '__BR_$1_BR__');

            let tagMatch;
            const tagRegex = /\[\s*(PROMPT|SUBQUERY|CTE_SUBQUERY)/i;

            while ((tagMatch = temp.match(tagRegex))) {
                const startIndex = tagMatch.index;
                let openCount = 1;
                let currentIndex = startIndex + tagMatch[0].length;
                let inQuote = false;
                let quoteChar = '';

                while (openCount > 0 && currentIndex < temp.length) {
                    const ch = temp[currentIndex];
                    if (inQuote) {
                        if (ch === quoteChar) inQuote = false;
                    } else if (ch === "'" || ch === '"') {
                        inQuote = true;
                        quoteChar = ch;
                    } else if (ch === '[') {
                        openCount++;
                    } else if (ch === ']') {
                        openCount--;
                    }
                    currentIndex++;
                }

                if (openCount === 0) {
                    const fullTag = temp.substring(startIndex, currentIndex);
                    let replacement = '';
                    if (keepInnerQuery && tagMatch[1].toUpperCase() === 'CTE_SUBQUERY') {
                        const qIdx = fullTag.toLowerCase().indexOf('query=');
                        if (qIdx !== -1) {
                            replacement = fullTag.substring(qIdx + 6, fullTag.length - 1);
                        }
                    }
                    temp = temp.substring(0, startIndex) + " " + replacement + " " + temp.substring(currentIndex);
                } else {
                    temp = temp.substring(0, startIndex) + " " + temp.substring(startIndex + 1);
                }
            }
            return temp.replace(/__BR_(.*?)_BR__/g, '[$1]');
        }

        if (!insideTag) {
            virtualSQL = cleanSqlContent(fullQuery, true);
            // Use the range from (0,0) to 'cursor' (start of selection) to get prefix
            const rawTextBefore = editor.getRange({
                line: 0,
                ch: 0
            }, cursor);
            textBeforeCursorInScope = cleanSqlContent(rawTextBefore, false);
        }

        // --- 2. PARSE TABLES & CTES ---
        const ctes = findAllCTEsInQuery(virtualSQL);
        const tables = findAllTablesInQueryV17(virtualSQL, ctes);

        // --- 2b. IDENTIFY LOCAL SCOPE (Prioritize tables in the current SELECT block) ---
        const localTableNames = new Set();
        try {
            // Scan backwards from cursor to find the start of the current SELECT statement
            let balance = 0;
            let startOfScope = 0;

            // Limit scan to 5000 chars back for performance
            const lookbackLimit = Math.max(0, cursorIndex - 5000);
            const upperVirtualSQL = virtualSQL.toUpperCase();

            for (let i = cursorIndex - 1; i >= lookbackLimit; i--) {
                const char = virtualSQL[i];
                if (char === ')')
                    balance++;
                else if (char === '(')
                    balance--;

                // If we hit a SELECT and we are balanced (or in a top-level unbalanced state implied by CTEs)
                // We assume this is our start.
                if (balance <= 0) {
                    // Check for "SELECT" keyword ending at i
                    if (upperVirtualSQL.substring(i - 6, i) === 'SELECT') {
                        startOfScope = i - 6;
                        break;
                    }
                }
            }

            // Scan forwards to find the end (FROM clause, WHERE, or closing paren)
            // We really just need to grab enough text to capture the FROM/JOINs.
            // Let's grab the next 2000 chars or until a semi-colon/closing paren that closes the scope.
            let endOfScope = virtualSQL.length;
            balance = 0;

            for (let i = cursorIndex; i < virtualSQL.length; i++) {
                const char = virtualSQL[i];
                if (char === '(')
                    balance++;
                else if (char === ')') {
                    balance--;
                    if (balance < 0) {
                        // We closed the CTE/Subquery
                        endOfScope = i;
                        break;
                    }
                } else if (char === ';') {
                    endOfScope = i;
                    break;
                }
            }

            // Extract the local query block (e.g., the inside of the CTE)
            const localQueryBlock = virtualSQL.substring(startOfScope, endOfScope);

            // Parse tables JUST from this block
            const localTablesRaw = findAllTablesInQueryV17(localQueryBlock, ctes);
            localTablesRaw.forEach(t => {
                localTableNames.add(t.name.toUpperCase());
                if (t.alias)
                    localTableNames.add(t.alias.toUpperCase());
            }
            );

        } catch (e) {
            console.warn("Scope detection failed", e);
        }

        // --- 3. DETERMINE AUTO-COMPLETE CONTEXT ---
        const cleanTextBefore = textBeforeCursorInScope;

        // A. Alias/Table Dot Lookup
        const tableDotMatch = cleanTextBefore.match(/(?:^|[^a-zA-Z0-9_\]"])(?:([a-zA-Z0-9_]+)|\[([^\]]+)\])\.\s*(\[?)([a-zA-Z0-9_]*)$/);

        if (tableDotMatch) {
            const aliasName = tableDotMatch[1] || tableDotMatch[2];
            const hasBracket = tableDotMatch[3];
            const columnFragment = tableDotMatch[4];
            let columns = [];

            const sourceMatch = tables.find(t => (t.alias && t.alias.toLowerCase() === aliasName.toLowerCase()) || (!t.alias && t.name.toLowerCase() === aliasName.toLowerCase()));

            if (sourceMatch) {
                // FIX: Use recursive resolver to handle nested CTEs and wildcards
                columns = await resolveSourceColumns(sourceMatch.name, ctes);
            }

            // CRITICAL FIX: Use selection for sorting, pass true to keep all options
            const filterText = hasSelection ? editor.getSelection() : columnFragment;
            // CHANGE: Use new cylinder icon for columns
            const list = applyContainsFilter(columns, filterText, 'cm-hint-data-cylinder', hasSelection);

            if (list.length > 0) {
                list.push(htmlLinkItem);

                if (hasSelection) {
                    // Overwrite the selection
                    return {
                        list,
                        from: cursor,
                        to: selectionEnd
                    };
                } else {
                    // Standard insert
                    const offset = columnFragment.length + (hasBracket ? 1 : 0);
                    return {
                        list,
                        from: CodeMirror.Pos(cursor.line, cursor.ch - offset),
                        to: cursor
                    };
                }
            }

        }

        // B. Value Lookup (Distinct)
        // REGEX UPDATE: Matches IN/NOT IN, LIKE/NOT LIKE, and handles parenthesized lists and spaces.
        // const valueHintMatch = cleanTextBefore.match(/\b([a-zA-Z0-9_.]+)\s*(=|!=|<>|(?:NOT\s+)?LIKE|(?:NOT\s+)?IN)\s*(\((?:[^)]*?)?)?\s*(?:(')([^']*)?|([^\s'"]+)?)$/i);
        const valueHintMatch = cleanTextBefore.match(/\b([a-zA-Z0-9_.]+)(?:\s*\))?\s*(=|!=|<>|(?:NOT\s+)?LIKE|(?:NOT\s+)?IN)\s*(\((?:[^)]*?)?)?\s*(?:(')([^']*)?|([^\s'"]+)?)$/i);
        if (valueHintMatch) {
            // --- 1. SHOW LOADING INDICATOR (JS POSITIONING) ---
            $('body').addClass('cm-autocomplete-loading');

            // Calculate exact cursor/selection position
            const coords = editor.cursorCoords(true, 'page');

            let $badge = $('#cm-loading-badge');
            if ($badge.length === 0) {
                $badge = $('<div id="cm-loading-badge"></div>').appendTo('body');
            }

            // Set initial text and position
            $badge.text('Loading Values...');
            $badge.css({
                top: coords.top - 2,
                left: coords.right + 15,
                display: 'block'
            });

            try {
                let column = valueHintMatch[1];
                const operator = valueHintMatch[2].toUpperCase();
                const hasParen = !!valueHintMatch[3];

                let valueFragment;
                if (hasSelection) {
                    valueFragment = editor.getSelection();
                } else {
                    valueFragment = (valueHintMatch[5] || valueHintMatch[6] || '');
                }

                valueFragment = valueFragment.replace(/^['"%]+|['"%]+$/g, '');

                let table;

                // --- LINEAGE RESOLVER FUNCTION (Updated for CASE & Complex Expr) ---
                const resolveCteLineage = async (cteName, colName, depth = 0) => {
                    if (depth > 10)
                        return null;
                    // Prevent infinite loops
                    const upperCteName = cteName.toUpperCase();

                    if (!ctes.has(upperCteName)) {
                        // It's not a CTE, assume it's a real table
                        return {
                            table: cteName,
                            column: colName
                        };
                    }

                    const cteSql = ctes.get(upperCteName);

                    // 1. Parse the SELECT list of this CTE
                    // Regex now handles newlines/tabs inside the SELECT block more gracefully
                    const selectMatch = cteSql.match(/^\s*SELECT\s+(?:DISTINCT\s+)?([\s\S]*?)(\sFROM\s)/i);
                    if (!selectMatch)
                        return null;

                    const selectList = selectMatch[1];

                    // Split columns robustly
                    let balance = 0;
                    let start = 0;
                    const cols = [];
                    for (let i = 0; i < selectList.length; i++) {
                        const char = selectList[i];
                        if (char === '(')
                            balance++;
                        else if (char === ')')
                            balance--;
                        else if (char === ',' && balance === 0) {
                            cols.push(selectList.substring(start, i).trim());
                            start = i + 1;
                        }
                    }
                    cols.push(selectList.substring(start).trim());

                    // 2. Find the expression that defines our target column
                    let sourceExpression = null;

                    for (const colDef of cols) {
                        // Check for "AS Alias" (Case-Insensitive, handling newlines)
                        const asMatch = colDef.match(/([\s\S]*?)\s+AS\s+([a-zA-Z0-9_]+)$/i);
                        if (asMatch) {
                            if (asMatch[2].toUpperCase() === colName.toUpperCase()) {
                                sourceExpression = asMatch[1].trim();
                                break;
                            }
                        } else {
                            // Implicit alias or simple column "table.col"
                            // Remove comments/newlines to clean up the check
                            const cleanDef = colDef.replace(/--.*$/gm, '').trim();
                            const parts = cleanDef.split('.');
                            const simpleName = parts[parts.length - 1].replace(/[\[\]]/g, '');

                            if (simpleName.toUpperCase() === colName.toUpperCase()) {
                                sourceExpression = cleanDef;
                                break;
                            }
                        }
                    }

                    // 3. Handle "SELECT *" Pass-through
                    if (!sourceExpression && selectList.includes('*')) {
                        const internalTables = findAllTablesInQueryV17(cteSql, ctes);
                        for (const src of internalTables) {
                            const check = await resolveCteLineage(src.name, colName, depth + 1);
                            if (check && check.table && allTableNames.some(t => t.toUpperCase() === check.table.toUpperCase())) {
                                return check;
                            } else if (check && check.table) {
                                // If it resolves to a real table, optimistically return it
                                const realCols = await getTableColumns(check.table);
                                if (realCols && realCols.includes(check.column.toUpperCase())) {
                                    return check;
                                }
                            }
                        }
                        return null;
                    }

                    if (!sourceExpression)
                        return null;

                    // 4. Resolve the Source Expression
                    // STRATEGY: Extract the "best guess" column reference from the expression.

                    let bestGuessRef = null;

                    // A. Handle CASE statements (Look for ELSE first, then THEN)
                    if (sourceExpression.toUpperCase().startsWith('CASE')) {
                        // Try to find ELSE <col>
                        const elseMatch = sourceExpression.match(/\sELSE\s+([a-zA-Z0-9_.]+)/i);
                        if (elseMatch) {
                            bestGuessRef = elseMatch[1];
                        } else {
                            // Fallback: Find the first simple column reference inside the CASE
                            // Excludes string literals and numbers
                            const firstColMatch = sourceExpression.match(/(?:THEN|WHEN|ELSE)\s+([a-zA-Z0-9_]+(?:\.[a-zA-Z0-9_]+)?)/i);
                            if (firstColMatch)
                                bestGuessRef = firstColMatch[1];
                        }
                    }// B. Handle Simple Reference (alias.col or col)
                    else {
                        // Strip functions like MAX(col), TRIM(col), etc. by extracting the inner identifier
                        // This regex looks for "table.col" or "col" avoiding keywords
                        const simpleMatch = sourceExpression.match(/([a-zA-Z0-9_\[\]]+\.[a-zA-Z0-9_\[\]]+)|([a-zA-Z0-9_]+)/);
                        if (simpleMatch)
                            bestGuessRef = simpleMatch[0];
                    }

                    if (bestGuessRef) {
                        // Parse the reference: "r.RoleId" -> alias="r", col="RoleId"
                        const refParts = bestGuessRef.split('.');
                        let nextTableAlias = null;
                        let nextCol = null;

                        if (refParts.length === 2) {
                            nextTableAlias = refParts[0].replace(/[\[\]]/g, '');
                            nextCol = refParts[1].replace(/[\[\]]/g, '');
                        } else {
                            nextCol = refParts[0].replace(/[\[\]]/g, '');
                        }

                        const internalTables = findAllTablesInQueryV17(cteSql, ctes);
                        let nextSourceTable = null;

                        if (nextTableAlias) {
                            const t = internalTables.find(t => (t.alias || t.name).toUpperCase() === nextTableAlias.toUpperCase());
                            if (t)
                                nextSourceTable = t.name;
                        } else if (internalTables.length === 1) {
                            // Ambiguous column with only one source -> assume that source
                            nextSourceTable = internalTables[0].name;
                        } else {
                            // Ambiguous column with multiple sources -> check all
                            for (const src of internalTables) {
                                const check = await resolveCteLineage(src.name, nextCol, depth + 1);
                                if (check)
                                    return check;
                            }
                        }

                        if (nextSourceTable) {
                            return await resolveCteLineage(nextSourceTable, nextCol, depth + 1);
                        }
                    }

                    return null;
                }
                    ;

                if (column.includes('.')) {
                    // CASE A: Explicit Alias (e.g., fl.red_system)
                    let [alias, colName] = column.split('.');
                    const aliasMatch = tables.find(t => t.alias && t.alias.toLowerCase() === alias.toLowerCase());

                    if (aliasMatch) {
                        if (aliasMatch.isCte) {
                            const result = await resolveCteLineage(aliasMatch.name, colName);
                            if (result) {
                                table = result.table;
                                column = result.column;
                            }
                        } else {
                            table = aliasMatch.name;
                            column = colName;
                        }
                    }
                } else {
                    // CASE B: Implicit / No Alias (e.g., red_system)
                    // We must search ALL tables in scope (Real Tables AND CTEs)

                    // 1. Search Real Tables directly
                    const realTables = tables.filter(t => !t.isCte).map(t => t.name);
                    const foundReal = await findTableForColumn(realTables, column);

                    if (foundReal) {
                        table = foundReal;
                    } else {
                        // 2. Search CTEs if not found in real tables
                        const cteTables = tables.filter(t => t.isCte);
                        for (const cte of cteTables) {
                            // Try to resolve this column in this CTE
                            const result = await resolveCteLineage(cte.name, column);

                            // If it resolved to a known real table, we found it!
                            if (result && result.table && allTableNames.some(t => t.toUpperCase() === result.table.toUpperCase())) {
                                table = result.table;
                                column = result.column;
                                break;
                                // Stop after first match
                            }
                        }
                    }
                }

                const isKnownTable = table && allTableNames.some(t => t.toUpperCase() === table.toUpperCase());

                if (isKnownTable) {
                    const cacheKey = `${table.toUpperCase()}.${column.toUpperCase()}`;
                    let allValues = [];

                    if (distinctValueCache.has(cacheKey)) {
                        allValues = distinctValueCache.get(cacheKey);
                    } else {
                        // --- 2. RE-ASSERT BADGE & TEXT ---
                        // findTableForColumn() changed the text to "Loading Columns..." and hid the badge.
                        // We must re-show it and force the text back to "Loading Values...".
                        $badge.text('Loading Values...').show();
                        $('body').addClass('cm-autocomplete-loading');

                        try {
                            const fetchedValues = await $.ajax({
                                url: 'get_distinct_values.php',
                                data: {
                                    table: table,
                                    column: column,
                                    term: '',
                                    short_id: new URLSearchParams(window.location.search).get('id') || ''
                                },
                                dataType: 'json'
                            });
                            if (fetchedValues && Array.isArray(fetchedValues)) {
                                allValues = fetchedValues;
                                distinctValueCache.set(cacheKey, allValues);
                            }
                        } catch (e) {/* ignore */
                        }
                    }

                    if (allValues.length > 0) {
                        const startsWith = [];
                        const contains = [];
                        const others = [];
                        const searchFrag = valueFragment.toLowerCase();

                        allValues.forEach(v => {
                            const valLower = v.toLowerCase();
                            if (valLower.startsWith(searchFrag)) {
                                startsWith.push(v);
                            } else if (valLower.includes(searchFrag)) {
                                contains.push(v);
                            } else {
                                others.push(v);
                            }
                        }
                        );

                        startsWith.sort((a, b) => a.localeCompare(b));
                        contains.sort((a, b) => a.localeCompare(b));
                        others.sort((a, b) => a.localeCompare(b));

                        const sortedValues = [...startsWith, ...contains, ...others];

                        if (sortedValues.length > 0) {
                            const isInOperator = operator.includes('IN');

                            let fromPos, toPos;
                            if (hasSelection) {
                                fromPos = cursor;
                                toPos = selectionEnd;
                            } else {
                                fromPos = CodeMirror.Pos(cursor.line, cursor.ch - valueFragment.length);
                                toPos = cursor;
                            }

                            // 1. SMART QUOTE & WILDCARD DETECTION
                            const leadingChar = editor.getRange(CodeMirror.Pos(fromPos.line, fromPos.ch - 1), fromPos);
                            const trailingChar = editor.getRange(toPos, CodeMirror.Pos(toPos.line, toPos.ch + 1));

                            const isQuoteOrWildcard = (ch) => ch === "'" || ch === "%";
                            let hasLeadingQuote = isQuoteOrWildcard(leadingChar);
                            let hasTrailingQuote = isQuoteOrWildcard(trailingChar);

                            // FIX: Boundary Detection
                            // If 'leadingChar' is a quote, check if it is a CLOSING quote of a previous item.
                            // If the char before the quote is NOT a delimiter (space, comma, paren), it's a closing quote.
                            if (hasLeadingQuote) {
                                const charBeforeLeading = editor.getRange(CodeMirror.Pos(fromPos.line, fromPos.ch - 2), CodeMirror.Pos(fromPos.line, fromPos.ch - 1));
                                // If char before quote is alphanum or another quote, the leadingChar is actually closing the previous string.
                                if (charBeforeLeading && !/[\s,(\[]/.test(charBeforeLeading)) {
                                    hasLeadingQuote = false;
                                    // We are outside the previous string
                                }
                            }

                            // 2. CONTEXT AWARENESS (Delimiter Check)
                            // If the character before us is a delimiter, we are starting a NEW value. 
                            // We shouldn't steal the trailing char as "our" closing quote.
                            const isDelimiter = (ch) => /[\s,(\[]/.test(ch);

                            // If we aren't inside a quote, and we follow a delimiter, ignore trailing quote (it belongs to neighbor)
                            if (!hasLeadingQuote && isDelimiter(leadingChar)) {
                                hasTrailingQuote = false;
                            }

                            // 3. INTELLIGENT COMMA INSERTION
                            let prependComma = false;
                            let appendComma = false;

                            if (isInOperator && hasParen) {
                                // A. Leading Comma Check
                                if (!hasLeadingQuote) {
                                    const lookBehind = editor.getRange(CodeMirror.Pos(fromPos.line, fromPos.ch - 50), fromPos);
                                    // Regex handles optional spacing
                                    const prevIsValue = /(?:'|\d|[a-zA-Z])\s*$/.test(lookBehind);
                                    const prevIsComma = /,\s*$/.test(lookBehind);
                                    const prevIsParen = /\(\s*$/.test(lookBehind);

                                    if (prevIsValue && !prevIsComma && !prevIsParen) {
                                        prependComma = true;
                                    }
                                }

                                // B. Trailing Comma Check
                                if (!hasTrailingQuote) {
                                    const lookAhead = editor.getRange(toPos, CodeMirror.Pos(toPos.line, toPos.ch + 50));
                                    const nextIsValue = /^\s*(?:'|\d|[a-zA-Z])/.test(lookAhead);
                                    const nextIsComma = /^\s*,/.test(lookAhead);

                                    if (nextIsValue && !nextIsComma) {
                                        appendComma = true;
                                    }
                                }
                            }

                            const resultList = sortedValues.map(v => {
                                let text = v;
                                if (isInOperator && !hasParen) {
                                    text = `('${v}')`;
                                } else {
                                    if (!hasLeadingQuote)
                                        text = "'" + text;
                                    if (!hasTrailingQuote)
                                        text = text + "'";

                                    if (prependComma)
                                        text = ", " + text;
                                    if (appendComma)
                                        text = text + ",";
                                }

                                const valLower = v.toLowerCase();
                                const isMatch = valLower.includes(searchFrag);

                                return {
                                    text: text,
                                    displayText: v,
                                    className: isMatch ? 'cm-hint-value' : 'cm-hint-value cm-hint-dimmed'
                                };
                            }
                            );

                            return {
                                list: resultList,
                                from: fromPos,
                                to: toPos
                            };
                        }
                    }
                }
            } finally {
                // --- 3. CLEANUP ---
                $('body').removeClass('cm-autocomplete-loading');
                $('#cm-loading-badge').hide();
            }
        }

        // C. General Context Logic
        const lastKeywordMatch = cleanTextBefore.trim().match(/\b(SELECT|FROM|JOIN|ON|WHERE|GROUP BY|ORDER BY|SET|UPDATE|INTO|VALUES)$/i);
        const lastKeyword = lastKeywordMatch ? lastKeywordMatch[1].toUpperCase().replace(/\sBY/, '_BY') : null;

        // --- 1. DETERMINE FRAGMENT AND BRACKET CONTEXT ---
        const wordBefore = cleanTextBefore.match(/([a-zA-Z0-9_.]*)$/);
        // If text is selected, use that as the fragment. Otherwise use the word before cursor.
        let currentFragment = hasSelection ? editor.getSelection() : (wordBefore ? wordBefore[1] : '');

        // Check if there is an opening bracket immediately before the current word
        // e.g. text is "WHERE [PR" -> currentFragment is "PR", hasOpenBracket is true
        const charBeforeFragment = cleanTextBefore.charAt(cleanTextBefore.length - currentFragment.length - 1);
        const hasOpenBracket = (charBeforeFragment === '[');

        // If we found a bracket, the user is typing a Tag. We must adjust the search term
        // to include the bracket (e.g. search for "[PR") so filtering works correctly.
        if (hasOpenBracket) {
            currentFragment = '[' + currentFragment;
        }

        const sqlKeywords = ['SELECT', 'FROM', 'WHERE', 'JOIN', 'LEFT JOIN', 'RIGHT JOIN', 'ON', 'GROUP BY', 'ORDER BY', 'AND', 'OR', 'AS', 'DISTINCT'];
        const sqlFunctions = ['COUNT()', 'SUM()', 'AVG()', 'MIN()', 'MAX()'];
        let suggestions = [];
        let contextType = lastKeyword || 'GENERAL';

        if (contextType === 'SELECT' && tables.length === 0) {
            contextType = 'SELECT_NO_TABLES';
        }

        // --- NEW: Detect Explicit Alias Prefix (e.g. "p.") for General Context ---
        const dotContextMatch = cleanTextBefore.match(/([a-zA-Z0-9_]+)\.\s*$/);
        const explicitAlias = dotContextMatch ? dotContextMatch[1].toUpperCase() : null;

        // Collect all known import names for autocomplete
