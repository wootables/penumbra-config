    }

    /**
     * Safely evaluates a simple "A [op] B" condition string.
     * This version supports logical AND/OR operators by masking quoted strings
     * to ensure we only split on top-level operators.
     * @param {string} condition - The condition string.
     * @returns {boolean} - The result of the evaluation.
     */
    function safeEvaluate(condition) {
        // Unwrap \x02 number-guards (round()/fixed()/date-fn results in engine
        // B) and strip their thousands commas so a guarded operand compares as
        // its real value - '\x021,234\x02 = 1234' must be true. Same per-span
        // normalization as engine C's _snippet_case_eval_truthy.
        if (condition && condition.indexOf('\x02') !== -1) {
            condition = condition.replace(/\x02([^\x02]*)\x02/g, (m, inner) => inner.replace(/,/g, ''));
            condition = condition.replace(/\x02/g, '');
        }
        // --- START: NEW LOGIC SUPPORT (AND / OR) ---

        // 1. Create a "masked" version of the string where quoted content is replaced by underscores.
        //    This allows us to find operators like " OR " without matching text inside quotes.
        //    Regex handles escaped single quotes inside strings as well.
        const maskQuotes = (str) => str.replace(/'([^'\\]*(?:\\.[^'\\]*)*)'|"[^"]*"/g, m => '_'.repeat(m.length));
        const masked = maskQuotes(condition);

        // 2. Check for OR (Recursively)
        //    We search the MASKED string for the operator, but split the ORIGINAL string.
        const orMatch = masked.match(/\s+OR\s+/i);
        if (orMatch) {
            const index = orMatch.index;
            const left = condition.substring(0, index).trim();
            // Use the length of the match (e.g. " OR ") to find the start of the right side
            const right = condition.substring(index + orMatch[0].length).trim();
            return safeEvaluate(left) || safeEvaluate(right);
        }

        // 3. Check for AND (Recursively)
        const andMatch = masked.match(/\s+AND\s+/i);
        if (andMatch) {
            const index = andMatch.index;
            const left = condition.substring(0, index).trim();
            const right = condition.substring(index + andMatch[0].length).trim();
            return safeEvaluate(left) && safeEvaluate(right);
        }
        // --- END: NEW LOGIC SUPPORT ---

        // This regex looks for a regex literal on the RIGHT side.
        // It captures: (1: Left Side), (2: Operator), (3: Regex Literal)
        const regexComparisonMatch = condition.match(/^\s*(.+?)\s*([<>=!]+)\s*(\/(?:\\\/|[^\/])+\/[iI]?)\s*$/);

        // This regex looks for a regex literal on the LEFT side.
        // It captures: (1: Regex Literal), (2: Operator), (3: Right Side)
        const regexComparisonMatchReversed = condition.match(/^\s*(\/(?:\\\/|[^\/])+\/[iI]?)\s*([<>=!]+)\s*(.+?)\s*$/);

        const match = regexComparisonMatch || regexComparisonMatchReversed;
        let left_raw, op, right_raw, leftIsRegex, rightIsRegex;

        if (match) {
            // A regex literal was found. Use the new parser.
            left_raw = match[1];
            op = match[2];
            right_raw = match[3];
            leftIsRegex = !!regexComparisonMatchReversed;
            // True if the reversed regex matched
            rightIsRegex = !!regexComparisonMatch;
            // True if the normal regex matched
        } else {
            // No regex literal found. Locate the comparison operator in the
            // MASKED condition so operators inside quoted strings (e.g.
            // data(search) returning a value containing '=' or '!=') aren't
            // mistaken for the comparator.
            const opIndexMatch = masked.match(/[<>=!]+/);
            if (!opIndexMatch)
                return false;

            const opStart = opIndexMatch.index;
            op = opIndexMatch[0];
            left_raw = condition.substring(0, opStart);
            right_raw = condition.substring(opStart + op.length);
            leftIsRegex = false;
            rightIsRegex = false;
        }

        // Clean up the raw values
        left_raw = left_raw.trim();
        right_raw = right_raw.trim();
        if (left_raw.toLowerCase() === 'empty')
            left_raw = "''";
        if (right_raw.toLowerCase() === 'empty')
            right_raw = "''";

        // --- START: REGEX LOGIC ---

        // Strip quotes from non-regex values - matched pair ONLY, so an operand that
        // merely ENDS in an apostrophe (`= Sailors'`) keeps it instead of being
        // silently truncated. Both sides are pure string/number comparands below,
        // so the helper's extra "..." support just makes double-quoted literals work.
        //
        // A \' inside a SINGLE-quoted operand is an escaped apostrophe, same rule
        // as parseFunctionArgs - un-escape it or the comparand carries a literal
        // backslash and never matches. `NAME = 'O\'Brien'` was always false, both
        // hand-authored and after a prompt answer is escaped into the condition
        // (see penumbraEscapeSnippetValue). Double-quoted operands keep their \"
        // for the same reason parseFunctionArgs does. Twin: PHP
        // _snippet_case_literal_value in schedule_runner.php.
        const stripOperand = (raw) => {
            const s = stripWrappingQuotePair(raw);
            return (s !== raw && raw.charAt(0) === "'") ? s.replace(/\\'/g, "'") : s;
        };
        const left = leftIsRegex ? left_raw : stripOperand(left_raw);
        const right = rightIsRegex ? right_raw : stripOperand(right_raw);

        if (leftIsRegex || rightIsRegex) {
            try {
                // Determine which value is the regex and which is the string to test
                const regexString = leftIsRegex ? left : right;
                const testString = leftIsRegex ? right : left;

                const regexParts = regexString.match(/^\/(.*?)\/([iI])?$/);

                if (!regexParts)
                    return false;
                // Malformed regex

                const pattern = regexParts[1];
                // Absent flag = case-insensitive; UPPERCASE I = case-SENSITIVE,
                // matching the row-condition engines on both sides. ('I' is an
                // invalid JS RegExp flag, so it used to throw here and make the
                // whole condition permanently false.)
                const flags = (regexParts[2] === 'I') ? '' : 'i';
                // Default to case-insensitive
                const re = new RegExp(pattern, flags);

                const result = re.test(testString);

                if (op === '=' || op === '==') {
                    return result;
                }
                if (op === '!=' || op === '<>') {
                    return !result;
                }
                // Other operators (>, <) are not valid for regex
                return false;

            } catch (e) {
                return false;
                // Invalid regex pattern
            }
        }
        // --- END: REGEX LOGIC ---

        // If not a regex, proceed with the original simple string/number comparison
        // Parse both sides as numbers if possible so >, <, >=, <= use numeric ordering
        const leftNum = parseAccountingNumber(left);
        const rightNum = parseAccountingNumber(right);
        const bothNumeric = !isNaN(leftNum) && !isNaN(rightNum);

        switch (op) {
            case '==':
            case '=':
                // MODIFIED: Case-insensitive comparison
                return String(left).toLowerCase() === String(right).toLowerCase();
            case '!=':
            case '<>':
                // MODIFIED: Case-insensitive comparison
                return String(left).toLowerCase() !== String(right).toLowerCase();
            case '>':
                return bothNumeric ? leftNum > rightNum : left > right;
            case '<':
                return bothNumeric ? leftNum < rightNum : left < right;
            case '>=':
                return bothNumeric ? leftNum >= rightNum : left >= right;
            case '<=':
                return bothNumeric ? leftNum <= rightNum : left <= right;
        }
        return false;
    }

    /**
 * A robust parser for snippet function arguments that correctly handles
 * single-quoted arguments containing commas and nested parentheses.
 * @param {string} argString - The raw string of arguments from inside a function's parentheses.
 * @returns {string[]} An array of the parsed arguments.
 */
    function parseFunctionArgs(argString) {
        const args = [];
        let currentArg = '';
        let parenCount = 0;
        let inQuote = false;
        let quoteChar = '';
        let inGuard = false; // inside a \x02...\x02 pre-formatted-number guard

        for (let i = 0; i < argString.length; i++) {
            const char = argString[i];

            if (char === '\x02') {
                // A guarded number like \x021,234\x02 (round()/fixed() output)
                // is atomic: its thousands comma must not split the argument
                // list of an enclosing call. Twin of parse_format_args in
                // schedule_runner.php.
                inGuard = !inGuard;
            } else if (!inQuote && (char === "'" || char === '"')) {
                inQuote = true;
                quoteChar = char;
            } else if (inQuote && char === quoteChar && argString[i - 1] !== '\\') {
                inQuote = false;
                quoteChar = '';
            } else if (char === '(' && !inQuote) {
                parenCount++;
            } else if (char === ')' && !inQuote) {
                parenCount--;
            }

            if (char === ',' && !inQuote && !inGuard && parenCount === 0) {
                args.push(currentArg.trim());
                currentArg = '';
            } else {
                currentArg += char;
            }
        }
        args.push(currentArg.trim());

        // Final pass to remove the outer quotes (single or double) from arguments that were quoted.
        //
        // Single-quoted args also drop the backslash from \' - the loop above
        // already treated it as an escaped quote, so it is noise once the wrapping
        // quotes are gone, and leaving it in is why a dialog-authored apostrophe
        // used to render as `Sponsor\'s Board`. This was written and reverted once
        // (2026-08-11) because the real apostrophe it delivers then tripped the
        // whole-snippet render abort in the syntax guard; that guard is now a
        // proper quote-aware scan (penumbraSnippetSyntaxLooksComplete) and
        // htmlEncode escapes ' so the engines' own re-scan passes stay sane.
        //
        // Double-quoted args are deliberately left alone: the \" inside an
        // `action(infobox, ..., "raw|...")` payload is load-bearing for the nested
        // re-parse of that payload. Twin of parse_format_args in schedule_runner.php.
        // Strip only when the argument IS one quoted literal - i.e. the first
        // UNESCAPED closing quote is the final character. The old test (first
        // char and last char are the same quote) also fired on an argument that
        // merely begins and ends with quotes, which silently corrupted every
        // quoted case() condition: `'Smith' = 'Smith'` came back as
        // `Smith' = 'Smith`, whose comparison operator is then inside a masked
        // quote span, so safeEvaluate found no operator and returned false -
        // `case('A' = 'A', …)` had never once taken its true branch.
        // This is a strict NARROWING: the only arguments that stop being
        // stripped are the ones the strip was mangling.
        const isWholeQuotedLiteral = (s, qc) => {
            for (let i = 1; i < s.length; i++) {
                if (s.charAt(i) === qc && s.charAt(i - 1) !== '\\') return i === s.length - 1;
            }
            return false;
        };
        return args.map(arg => {
            if (arg.length >= 2) {
                const qc = arg.charAt(0);
                if ((qc === "'" || qc === '"') && isWholeQuotedLiteral(arg, qc)) {
                    const inner = arg.slice(1, -1);
                    return qc === "'" ? inner.replace(/\\'/g, "'") : inner;
                }
            }
            return arg;
        }
        );
    }

    /**
     * "Does this snippet look syntactically complete enough to render?" - the
     * live-edit guard that keeps a half-typed call from painting garbage.
     * Returns false ONLY while parens are unbalanced or a quoted string is still
     * open. Callers pass comment-stripped text.
     *
     * Replaces the old pair of character counts (`count of ( === count of )` plus
     * `count of ' is even`). That test aborted the ENTIRE render on any odd number
     * of apostrophes anywhere in the snippet, with no error, no console warning
     * and no DOM write - so the output silently kept its previous content. A
     * label like "Ann's CSV" carries 3 apostrophes counting its neighbours'
     * quotes, so `action(trigger, "Ann's CSV", 'download_csv')` simply returned
     * and the report showed stale output forever. Any author who typed an
     * apostrophe into a button label hit it, in every action type at once.
     *
     * The scan uses parseFunctionArgs' EXACT quote rule (open on ' or ", close on
     * the same char when the preceding char is not a backslash) so the guard and
     * the parser can never disagree about where a literal ends. Two deliberate
     * refinements over a naive scan:
     *   - Quotes only open inside an argument list (depth > 0). At depth 0 an
     *     apostrophe is prose - "Don't forget" is a complete snippet, not an
     *     unterminated literal.
     *   - Parens inside a quoted string do not count toward depth, so a label
     *     such as 'Rate (%' no longer unbalances the whole snippet.
     */
    function penumbraSnippetSyntaxLooksComplete(text) {
        if (!text) return true;
        var st = penumbraSnippetQuoteState(text);
        return !st.wentNegative && st.depth === 0 && !st.inQuote;
    }

    /**
     * The scan behind penumbraSnippetSyntaxLooksComplete, exposed as STATE so
     * callers can ask "if I appended text right here, what would it land inside?"
     * Returns { depth, inQuote, quoteChar, wentNegative }.
     *
     * Used by prompt substitution to escape a value for the context it is about
     * to be dropped into - see penumbraEscapeSnippetValue.
     */
    function penumbraSnippetQuoteState(text) {
        var depth = 0;
        var inQuote = false;
        var quoteChar = '';
        var wentNegative = false;
        for (var i = 0; i < text.length; i++) {
            var ch = text.charAt(i);
            if (inQuote) {
                // Lookbehind escape test, not a skip-the-next-char one: this is
                // what parseFunctionArgs does, and the two must agree.
                if (ch === quoteChar && text.charAt(i - 1) !== '\\') {
                    inQuote = false;
                    quoteChar = '';
                }
                continue;
            }
            if ((ch === "'" || ch === '"') && depth > 0) {
                inQuote = true;
                quoteChar = ch;
            } else if (ch === '(') {
                depth++;
            } else if (ch === ')') {
                depth--;
                // Clamp rather than bail so the state stays usable for the
                // escaping caller; the guard treats wentNegative as incomplete.
                if (depth < 0) { wentNegative = true; depth = 0; }
            }
        }
        return { depth: depth, inQuote: inQuote, quoteChar: quoteChar, wentNegative: wentNegative };
    }

    /**
     * Escape a value that is about to be substituted into snippet text, for the
     * quote context it lands in (from penumbraSnippetQuoteState on everything
     * emitted so far). Without this a prompt answer of `O'Brien` dropped into
     * `action(trigger, '[PROMPT…]', 'download_csv')` closed the label early:
     * argument boundaries shifted and the syntax guard then aborted the whole
     * render, leaving stale output with no error - the same silent failure the
     * literal-apostrophe bug produced.
     *
     *   inside '…'  -> escape ' as \' (parseFunctionArgs un-escapes it back)
     *   inside "…"  -> escape " as \" (left escaped by the parser on purpose:
     *                  the "raw|…" infobox payload's \" is load-bearing)
     *   bare, depth > 0 and the value CONTAINS a quote -> wrap the whole value in
     *                  single quotes, because an unquoted argument has no escape
     *                  form at all. Only fires when it must, so numbers and dates
     *                  (which never contain a quote) are never re-typed as strings,
     *                  and a quoted literal is what safeEvaluate wants anyway.
     *   depth 0     -> prose; an apostrophe there is just an apostrophe.
     */
    function penumbraEscapeSnippetValue(value, st) {
        var s = String(value);
        if (st.inQuote && st.quoteChar === "'") return s.replace(/'/g, "\\'");
        if (st.inQuote && st.quoteChar === '"') return s.replace(/"/g, '\\"');
        if (st.depth > 0 && /['"]/.test(s)) return "'" + s.replace(/'/g, "\\'") + "'";
        return s;
    }

    // Quick regex scan of snippet text for an action(trigger, fullscreen, ..., autoload=true, ...)
    // call. Used to pre-hide the report body BEFORE charts render, so autoload
    // "dashboard mode" doesn't flash the underlying table on first load.  The
    // parser below is the authoritative source of truth - this is just a fast
    // heuristic so we can apply the hiding body class before DOM work starts.
    function _snippetHasAutoloadFullscreen(text) {
        if (!text || text.indexOf('fullscreen') === -1) return false;
        var re = /action\s*\(\s*trigger\s*,\s*['"]?fullscreen['"]?\s*,([^)]*)\)/gi;
        var m;
        while ((m = re.exec(text))) {
            var inner = m[1];
            // Split on top-level commas only - quoted strings may contain commas,
            // and `\'` is an escaped quote rather than the end of the string
            // (same rule as parseFunctionArgs). Without the escape check a title
            // like "A's, B's" split mid-value and shifted parts[3] off the
            // autoload flag, so the pre-hide never fired and the report flashed.
            var parts = [];
            var cur = '';
            var inStr = null;
            for (var i = 0; i < inner.length; i++) {
                var ch = inner.charAt(i);
                if (inStr) {
                    if (ch === inStr && inner.charAt(i - 1) !== '\\') inStr = null;
                    cur += ch;
                } else if (ch === "'" || ch === '"') {
                    inStr = ch;
                    cur += ch;
                } else if (ch === ',') {
                    parts.push(cur.trim());
                    cur = '';
                } else {
                    cur += ch;
                }
            }
            if (cur) parts.push(cur.trim());
            // Arg layout after `trigger, fullscreen,`:
            //   0=link title, 1=fs title, 2=fs subtitle, 3=autoload, 4=animate, 5=chartnumber, 6=interval(s)
            if (parts.length > 3) {
                var al = parts[3].replace(/^['"]|['"]$/g, '').toLowerCase().trim();
                if (al === 'true') return true;
            }
        }
        return false;
    }

    // The ONE definition of "how a snippet renders a number", shared by both
    // engines. Engine A (renderReportSnippet) calls it from its final
    // number-format post-pass; engine B (resolveInfoboxSnippet) calls it at each
    // numeric handler return, because B has NO post-pass - by the time B is done
    // its output is already-assembled HTML, and a global pass there would rewrite
    // hex colors, canvas width/height, inline px and URLs.
    //
    // Before this existed the two engines disagreed on every number: avg() showed
    // "1,234.57" in the snippet area but "1234.5666666666666" in an infobox or a
    // report subtitle. See the divergence notes in project memory.
    //
    // places omitted -> engine A's long-standing display rule (thousands
    // separators, at most 2 decimals, trailing zeros dropped). places given ->
    // thousands separators + EXACTLY that many decimals, for round()/fixed().
    // Resolve engine A's placeholder tokens inside a CONDITION or numeric-arg
    // string, so nested now()/me()/data()/round()/fixed()/backtick values reach
    // parseAdvancedQuery / safeEvaluate / parseFloat as real text instead of
    // token names (which compare lexicographically and match nothing). ONE
    // source of truth for every condition-taking handler: the generic
    // aggregates, count, case, lookup, rank, percentile, progress_bar, vis.
    // ctx = { stringLiterals, datePlaceholders, unformattedLiterals,
    //         protectedStrings, quote }
    // - unformatted literals substitute COMMA-STRIPPED (numeric compare needs
    //   1234, not 1,234 - calc() set this precedent).
    // - quote:true wraps string/date/backtick substitutions in single quotes
    //   (escaped) for safeEvaluate, whose operator scan masks quoted content;
    //   parseAdvancedQuery callers leave it off (raw substitution, its
    //   tokenizer handles bare text).
    // - backtick masks ARE safe to restore here: the resolved text feeds a
    //   comparator and is never re-scanned by the dispatch regex (unlike
    //   action() params, where early restore was tried and reverted).
    // - replacements use FUNCTION form: String.replace with a plain string
    //   applies $-substitution patterns, so a cell value containing $& or $$
    //   would corrupt the output or re-leak the token.
    function penumbraResolveSnippetTokens(s, ctx) {
        if (!s) return s;
        ctx = ctx || {};
        let out = String(s);
        const sub = (rx, arr, mapFn) => {
            if (!arr) return;
            while (true) {
                const m = out.match(rx);
                if (m && arr[m[1]] !== undefined) {
                    const v = mapFn ? mapFn(String(arr[m[1]])) : String(arr[m[1]]);
                    out = out.replace(m[0], () => v);
                } else break;
            }
        };
        const q = ctx.quote ? (v) => "'" + v.replace(/'/g, "\\'") + "'" : null;
        sub(/__DATE_PLACEHOLDER_(\d+)__/, ctx.datePlaceholders, q);
        sub(/__PENUMBRA_STRING_LITERAL_(\d+)__/, ctx.stringLiterals, q);
        sub(/__UNFORMATTED_LITERAL_(\d+)__/, ctx.unformattedLiterals, (v) => v.replace(/,/g, ''));
        sub(/__PROTECTED_STRING_(\d+)__/, ctx.protectedStrings, q);
        return out;
    }

    // Backtick masks for text that LEAVES an engine before its final restore
    // pass: an action(infobox) payload stored for click time, a toast shown at
    // once. The masks only come back over the engine's own output, so the stored
    // or shown copy printed "__PROTECTED_STRING_0__" (2026-09-27: ?id=fycompawd's
    // Things to Know, where `2027` was meant to stop "2,027"). keepBackticks:
    // true for a payload engine B renders later (it protects the text again and
    // consumes the backticks), false for text nothing else will process (a tile
    // spec, a toast). Function-form replace: see penumbraResolveSnippetTokens.
    function penumbraUnmaskBackticks(text, protectedStrings, keepBackticks) {
        if (text === null || text === undefined || !protectedStrings || !protectedStrings.length) return text;
        return String(text).replace(/__PROTECTED_STRING_(\d+)__/g, function (m, i) {
            if (protectedStrings[i] === undefined) return m;
            return keepBackticks ? '`' + protectedStrings[i] + '`' : String(protectedStrings[i]);
        });
    }

    function penumbraFormatSnippetNumber(value, places) {
        var n = (typeof value === 'number') ? value : parseFloat(value);
        if (!isFinite(n)) return String(value);
        if (places === undefined || places === null) {
            return n.toLocaleString(undefined, { maximumFractionDigits: 2 });
        }
        var p = parseInt(places, 10);
        if (isNaN(p)) p = 0;
        // toLocaleString throws RangeError past 20 decimals.
        p = Math.max(0, Math.min(20, p));
        return n.toLocaleString(undefined, { minimumFractionDigits: p, maximumFractionDigits: p });
    }

    // parseFloat that tolerates our OWN formatted output. Both engines resolve
    // nested calls by substituting the inner result back into the snippet text
    // and re-scanning, so as soon as a handler returns a grouped number the
    // enclosing call parses it: round(avg(AMT), 1) hands "1,234.57" to a bare
    // parseFloat, which stops at the comma and silently yields 1. Every numeric
    // ARGUMENT read must go through this. (Column VALUES keep using
    // parseAccountingNumber - that handles currency/parens too.)
    function penumbraParseSnippetNumber(s) {
        return parseFloat(String(s === undefined || s === null ? '' : s).replace(/[,\x02]/g, '').trim());
    }

    // Engine B's equivalent of engine A's whole-output number-format pass, and
    // the reason B could not simply format at each handler return: formatting
    // early destroys precision for every ENCLOSING call, because both engines
    // resolve nesting by substituting the inner result back into the text. With
    // handler-site formatting, round(avg(AMT), 3) sees avg's already-rounded
    // "1.67" and yields 1.670 instead of 1.667, and calc(avg(X)*3) comes out
    // silently wrong. So B - like A - keeps raw numbers through the whole
    // resolution loop and formats exactly once, here, at the very end.
    //
    // B's output is assembled HTML by then, so the pass must skip:
    //   - anything inside a tag (attributes carry hex colors, canvas
    //     width/height, inline px values and URLs),
    //   - the CSS/JS text inside <style>/<script> blocks,
    //   - spans wrapped in \x02 guards - round()/fixed(), whose EXACT decimals
    //     must survive the max-2-decimals rule. Same guard trick the PHP email
    //     engine uses for fixed(); parseAccountingNumber tolerates \x02 so a
    //     guarded value still compares numerically inside case()/conditions.
    function penumbraFormatNumbersInHtml(html) {
        var s = String(html == null ? '' : html);
        // Comma/dot boundary guards (engine C's step-2 pass has the same):
        // without them the tail of a typed '1,384.50' matched alone as '384.50'
        // and re-rounded to '384.5'.
        var NUM = /(?<![a-zA-Z\d_#/,.])(-?\d*\.?\d+)(?![a-zA-Z\d_/]|[,.]\d)/g;
        var out = s.replace(/\x02[^\x02]*\x02|<(style|script)\b[^>]*>[\s\S]*?<\/\1>|<[^>]*>|[^<\x02]+/gi, function (seg) {
            // Guarded literal: unwrap, never reformat.
            if (seg.charAt(0) === '\x02') return seg.slice(1, -1);
            // Tag, or a whole <style>/<script> block: leave byte-for-byte.
            if (seg.charAt(0) === '<') return seg;
            return seg.replace(NUM, function (m, numStr) {
                try {
                    return penumbraFormatSnippetNumber(numStr);
                } catch (e) { }
                return numStr;
            });
        });
        // An unbalanced guard must never reach the DOM.
        return out.replace(/\x02/g, '');
    }

    // Column-count for data(coltotal, CATEGORY?, VISIBILITY?). Reads only global
    // table/DOM state (independent of any snippet row context), so BOTH the main
    // snippet engine (renderReportSnippet) and the infobox/subtitle engine
    // (resolveInfoboxSnippet) call it - one source of truth instead of a copy.
    // colParam = 2nd data() arg (raw or A's pre-cleaned value), arg2 = 3rd.
    // ════════════════════════════════════════════════════════════════════
    //  sparkline(COLUMN, GROUPCOL?, COLOR?)
    //
    //  ONE implementation for engines A and B, the same arrangement
    //  _penumbraColTotal uses - the three snippet engines drift precisely
    //  because per-function logic gets hand-copied, so anything non-trivial
    //  gets extracted instead. Engine C (PHP) is a deliberate port and is held
    //  to it by the parity harness.
    //
    //  COLUMN BARS, NOT A LINE. The same snippet has to render in a scheduled
    //  email and in TCPDF, and neither can draw a line: TCPDF's writeHTML has
    //  no inline <svg>, and Outlook's Word engine has neither SVG nor canvas.
    //  Bars survive both as nested tables. One snippet, one shape everywhere,
    //  rather than a chart on screen and a hole in the emailed copy.
    // ════════════════════════════════════════════════════════════════════

    /** Longest series we will draw. Past this the bars are thinner than the gaps
     *  between them and the shape stops being readable - and on a 30k-row report
     *  the markup alone would dwarf the email. Longer input is averaged down into
     *  this many buckets, which preserves the trend rather than truncating it. */
    var PENUMBRA_SPARK_MAX_POINTS = 40;
    var PENUMBRA_SPARK_HEIGHT = 20;      // px; matches progress_bar's bar height

    /** Pull the numeric series out of the row maps.
     *  No group column: the column's own values, in row order.
     *  With one: the column SUMMED per group, groups in first-seen order (that
     *  is the report's current sort, so the reader gets the order they can see). */
    function _penumbraSparklineSeries(rowMaps, colName, groupCol) {
        var COL = String(colName || '').trim().toUpperCase();
        var GRP = String(groupCol || '').trim().toUpperCase();
        var vals = [];
        if (!COL || !rowMaps || !rowMaps.length) return vals;

        if (GRP) {
            // Object.create(null), not {}: a group literally named __proto__
            // silently discards its writes on a plain object.
            var sums = Object.create(null), order = [];
            rowMaps.forEach(function (m) {
                var k = m.get(GRP);
                k = (k == null ? '' : String(k)).trim();
                if (!k) return;
                var n = parseAccountingNumber(m.get(COL));
                if (!isFinite(n)) n = 0;
                if (!(k in sums)) { sums[k] = 0; order.push(k); }
                sums[k] += n;
            });
            order.forEach(function (k) { vals.push(sums[k]); });
        } else {
            rowMaps.forEach(function (m) {
                var n = parseAccountingNumber(m.get(COL));
                // A blank or non-numeric cell is skipped, not zeroed: a gap in
                // the data is not a measured zero, and drawing it as one invents
                // a dip that is not in the report.
                if (isFinite(n)) vals.push(n);
            });
        }
        return vals;
    }

    /** Average a long series down to at most `maxPoints` buckets. */
    function _penumbraSparklineBucket(vals, maxPoints) {
        if (!vals || vals.length <= maxPoints) return vals || [];
        var out = [], per = vals.length / maxPoints;
        for (var i = 0; i < maxPoints; i++) {
            var a = Math.floor(i * per), b = Math.floor((i + 1) * per);
            if (b <= a) b = a + 1;
            var sum = 0, n = 0;
            for (var j = a; j < b && j < vals.length; j++) { sum += vals[j]; n++; }
            out.push(n ? sum / n : 0);
        }
        return out;
    }

    /** Total drawn width in px, and the widest a single bar may get.
     *  160 is chosen so 40 points - the bucket cap - still yields the original
     *  3px bar: the long case looks exactly as it always did, and only SHORT
     *  series change, which is the whole point of fitting the width. */
    var PENUMBRA_SPARK_TOTAL_W = 160;
    var PENUMBRA_SPARK_MAX_BAR_W = 24;
    var PENUMBRA_SPARK_GAP = 1;

    /** Bar width for n points inside a total width. Few points get FAT bars
     *  instead of a short stub floating in a wide cell; the cap stops two points
     *  from becoming a pair of slabs that no longer read as a sparkline. */
    function _penumbraSparklineBarWidth(n, totalW, uncapped) {
        if (!(n > 0)) return 3;
        var w = Math.floor(((totalW || PENUMBRA_SPARK_TOTAL_W) - (n - 1) * PENUMBRA_SPARK_GAP) / n);
        // The cap keeps two points from becoming a pair of slabs at the DEFAULT
        // width. An explicit width= is the author asking for a size, so it wins -
        // otherwise width=300 on a short series silently does nothing.
        if (!uncapped && w > PENUMBRA_SPARK_MAX_BAR_W) w = PENUMBRA_SPARK_MAX_BAR_W;
        if (w < 2) w = 2;
        return w;
    }

    /** Height fraction 0..1 for one value, honouring the curve.
     *  log uses log1p so a zero stays a zero and a negative keeps its magnitude -
     *  a bare log() is -Infinity at 0 and undefined below it. */
    function _penumbraSparklineFrac(v, maxAbs, curve) {
        var a = Math.abs(v);
        if (!(maxAbs > 0)) return 0;
        if (curve === 'log') return Math.log(1 + a) / Math.log(1 + maxAbs);
        if (curve === 'sqrt') return Math.sqrt(a) / Math.sqrt(maxAbs);
        return a / maxAbs;
    }

    /**
     * style=line / style=area - a smooth curve instead of bars.
     *
     * BROWSER ONLY, and that is a deliberate, documented asymmetry rather than an
     * oversight. TCPDF's writeHTML cannot parse inline <svg> and Outlook's Word
     * engine has neither SVG nor canvas, so engine C keeps drawing bars for these
     * styles. The fallback is the SAME DATA on the same scale - not a blank space -
     * which is what makes the trade acceptable. (Verified: the app's two DOMPurify
     * sinks pass svg/path/circle with d, stroke and viewBox intact.)
     *
     * The curve is Catmull-Rom converted to cubic beziers, with the control points
     * clamped to the box: an unclamped spline overshoots on a spiky series and the
     * line escapes its own 20px strip.
     */
    function _penumbraSparklineLineSvg(vals, opts) {
        var H = PENUMBRA_SPARK_HEIGHT;
        var W = opts.totalW || PENUMBRA_SPARK_TOTAL_W;
        var color = opts.color || 'var(--brand-primary, #007bff)';
        var pad = 2;                       // room for the stroke and the end dot
        var n = vals.length;

        // A line spans its own min..max, floored at zero, rather than the bars'
        // magnitude-from-baseline. That way an all-positive series draws the same
        // shape as the bars, and a series with negatives actually dips below the
        // zero line instead of being folded up by an absolute value.
        var lo = 0, hi = (opts.maxAbs > 0) ? opts.maxAbs : 0;
        for (var i = 0; i < n; i++) {
            var v = isFinite(vals[i]) ? vals[i] : 0;
            if (v < lo) lo = v;
            if (v > hi) hi = v;
        }
        if (hi === lo) hi = lo + 1;
        var span = hi - lo;
        var innerH = H - pad * 2;

        function px(i) { return (n === 1) ? W / 2 : (i * (W - 1)) / (n - 1); }
        function py(v) {
            var t = (((isFinite(v) ? v : 0) - lo) / span);
            if (t < 0) t = 0; else if (t > 1) t = 1;
            return pad + (1 - t) * innerH;
        }

        var P = [];
        for (var k = 0; k < n; k++) P.push([px(k), py(vals[k])]);

        var svgOpen = '<svg class="pnb-spark-svg" viewBox="0 0 ' + W + ' ' + H + '" width="' + W +
                      '" height="' + H + '" preserveAspectRatio="none" aria-hidden="true">';
        // Under a shared scale a small row is a flat line on the floor. Drawing the
        // floor makes that legible as a real measurement instead of an empty cell.
        var track = (opts.maxAbs > 0)
            ? '<line x1="0" y1="' + (H - pad).toFixed(1) + '" x2="' + W + '" y2="' + (H - pad).toFixed(1) +
              '" stroke="currentColor" stroke-opacity="0.25" stroke-width="1"/>'
            : '';
        var spanCls = 'pnb-spark' + ((opts.maxAbs > 0) ? ' pnb-spark--tracked' : '');

        if (n === 1) {
            return '<span class="' + spanCls + '" style="height:' + H + 'px;">' + svgOpen + track +
                   '<circle cx="' + P[0][0].toFixed(1) + '" cy="' + P[0][1].toFixed(1) +
                   '" r="2" fill="' + color + '"/></svg></span>';
        }

        function clampY(y) { return Math.max(0, Math.min(H, y)); }
        var d = 'M' + P[0][0].toFixed(1) + ',' + P[0][1].toFixed(1);
        for (var s = 0; s < n - 1; s++) {
            var p0 = P[s > 0 ? s - 1 : 0], p1 = P[s], p2 = P[s + 1], p3 = P[s + 2 < n ? s + 2 : n - 1];
            var c1x = p1[0] + (p2[0] - p0[0]) / 6, c1y = clampY(p1[1] + (p2[1] - p0[1]) / 6);
            var c2x = p2[0] - (p3[0] - p1[0]) / 6, c2y = clampY(p2[1] - (p3[1] - p1[1]) / 6);
            d += ' C' + c1x.toFixed(1) + ',' + c1y.toFixed(1) +
                 ' ' + c2x.toFixed(1) + ',' + c2y.toFixed(1) +
                 ' ' + p2[0].toFixed(1) + ',' + p2[1].toFixed(1);
        }

        var body = '';
        if (opts.style === 'area') {
            // Close the same path down to the baseline. Painted first so the
            // stroke sits on top of its own fill.
            body += '<path d="' + d + ' L' + P[n - 1][0].toFixed(1) + ',' + (H - pad).toFixed(1) +
                    ' L' + P[0][0].toFixed(1) + ',' + (H - pad).toFixed(1) + ' Z" fill="' + color +
                    '" fill-opacity="0.18" stroke="none"/>';
        }
        body += '<path d="' + d + '" fill="none" stroke="' + color +
                '" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"' +
                ' vector-effect="non-scaling-stroke"/>';
        // A dot on the last point: with a bare line it is hard to see which end is
        // "now", and that is usually the whole question.
        body += '<circle cx="' + P[n - 1][0].toFixed(1) + '" cy="' + P[n - 1][1].toFixed(1) +
                '" r="1.8" fill="' + color + '"/>';

        return '<span class="' + spanCls + '" style="height:' + H + 'px;">' + svgOpen + track + body + '</svg></span>';
    }

    /**
     * Render the series as class-based bars. Engine C emits pixel-sized tables
     * that look the same - the identical split progress_bar() already makes.
     *
     * opts: { color, curve, totalW, maxAbs }
     *   maxAbs - an EXTERNAL maximum. That is how scale=shared works: every row
     *            is drawn against one number instead of against its own peak.
     */
    function _penumbraSparklineHtml(vals, opts) {
        if (!vals || !vals.length) return '[No Sparkline Data]';
        // Back-compat: this used to take a bare colour string.
        if (typeof opts === 'string') opts = { color: opts };
        opts = opts || {};
        var H = PENUMBRA_SPARK_HEIGHT;
        var color = opts.color || 'var(--brand-primary, #007bff)';
        var curve = opts.curve || 'linear';
        var totalW = opts.totalW || PENUMBRA_SPARK_TOTAL_W;

        var maxAbs = opts.maxAbs;
        if (!(maxAbs > 0)) {
            maxAbs = 0;
            for (var i = 0; i < vals.length; i++) {
                var a = Math.abs(vals[i]);
                if (isFinite(a) && a > maxAbs) maxAbs = a;
            }
        }
        // An all-zero series is legitimate data. Scale off 1 so every bar draws
        // as the 1px stub instead of dividing by zero.
        if (!(maxAbs > 0)) maxAbs = 1;

        // style=line / style=area hand off to the SVG renderer, which needs the
        // resolved maximum, so this sits AFTER the maxAbs block above.
        if (opts.style === 'line' || opts.style === 'area') {
            return _penumbraSparklineLineSvg(vals, {
                color: color, totalW: totalW, style: opts.style,
                maxAbs: (opts.maxAbs > 0) ? opts.maxAbs : 0
            });
        }

        var barW = _penumbraSparklineBarWidth(vals.length, totalW, !!opts.widthSet);
        var parts = [];
        for (var k = 0; k < vals.length; k++) {
            var v = isFinite(vals[k]) ? vals[k] : 0;
            var h = Math.max(1, Math.round(_penumbraSparklineFrac(v, maxAbs, curve) * H));
            if (h > H) h = H;   // a value above an external shared max is clamped, not overdrawn
            parts.push('<i class="pnb-spark-bar' + (v < 0 ? ' is-neg' : '') +
                       '" style="height:' + h + 'px;width:' + barW + 'px;background-color:' + color + ';"></i>');
        }
        // A shared scale means most rows can legitimately sit near the floor.
        // The track makes that read as "measured, and small" rather than "empty" -
        // without it, scale=shared on skewed data looks like a broken sparkline.
        var cls = 'pnb-spark' + ((opts.maxAbs > 0) ? ' pnb-spark--tracked' : '');
        return '<span class="' + cls + '" style="height:' + H + 'px;width:' + totalW + 'px;">' +
               parts.join('') + '</span>';
    }

    /** Parse the trailing key=value modifiers both sparkline forms accept. Same
     *  order-independent idiom heatmap() uses, so a new knob never shifts an
     *  existing call's positional arguments. */
    function _penumbraSparklineOpts(args, startAt) {
        var o = { curve: 'linear', scale: 'row', style: 'bar', totalW: PENUMBRA_SPARK_TOTAL_W, color: '', widthSet: false };
        for (var i = startAt; i < (args || []).length; i++) {
            var raw = String(args[i] == null ? '' : args[i]).replace(/'/g, '').trim();
            if (!raw) continue;
            var eq = raw.indexOf('=');
            if (eq === -1) {
                // A bare token in a modifier slot is the COLOUR - that is what it
                // meant before modifiers existed, and old calls must keep working.
                if (!o.color) o.color = raw;
                continue;
            }
            var k = raw.slice(0, eq).trim().toLowerCase();
            var v = raw.slice(eq + 1).trim();
            var vl = v.toLowerCase();
            if (k === 'style' && ['bar', 'line', 'area'].indexOf(vl) !== -1) o.style = vl;
            else if (k === 'curve' && ['linear', 'log', 'sqrt'].indexOf(vl) !== -1) o.curve = vl;
            else if (k === 'scale' && ['row', 'shared'].indexOf(vl) !== -1) o.scale = vl;
            else if (k === 'width') {
                var w = parseInt(vl, 10);
                if (isFinite(w) && w >= 20 && w <= 600) { o.totalW = w; o.widthSet = true; }
            } else if (k === 'color' || k === 'colour') o.color = v;
        }
        return o;
    }

    /**
     * PER-ROW series: one row read ACROSS several named columns (FY22|FY23|FY24).
     * This is what sparkline_cell() plots - a sparkline in every cell of a target
     * column, which is the form Excel calls a sparkline.
     *
     * A blank or non-numeric cell here becomes ZERO, which is the exact opposite
     * of the down-a-column rule above, and deliberately so: these positions are
     * FIXED and meaningful. Dropping a blank FY23 would slide FY24 into its slot
     * and draw a series that never happened. Down a column there are no fixed
     * positions, so a gap is just an absent point.
     */
    /** Read `palette` off the vis() options object. Unknown or absent -> 'auto',
     *  so a typo degrades to the theme-derived default rather than blanking the
     *  chart - the same rule every other option here follows. */
    function _vizParsePalette(raw) {
        var o = _vizParseVizOptions(raw);
        var p = String((o && o.palette) || '').trim().toLowerCase();
        return (PENUMBRA_PALETTE_NAMES.indexOf(p) !== -1) ? p : 'auto';
    }

    function _penumbraSparklineRowSeries(rowMap, cols) {
        var vals = [];
        if (!rowMap || !cols) return vals;
        for (var i = 0; i < cols.length; i++) {
            var key = String(cols[i] || '').trim().toUpperCase();
            if (!key) continue;
            var n = parseAccountingNumber(rowMap.get(key));
            vals.push(isFinite(n) ? n : 0);
        }
        return vals;
    }

    /** Normalise a sparkline colour argument. Shared so the inline form and the
     *  per-cell form cannot default differently. */
    function _penumbraSparklineColor(color) {
        var c = (color == null || String(color).trim() === '')
            ? 'var(--brand-primary, #007bff)'
            : String(color).replace(/'/g, '').trim();
        c = c.replace(/[^a-zA-Z0-9#(),.\s%-]/g, '');
        return c === '' ? 'var(--brand-primary, #007bff)' : c;
    }

    /** The whole function, from row maps to markup. Both engines call THIS.
     *  `rest` is every argument from slot 3 on: the old bare COLOR, and/or the
     *  key=value modifiers. */
    function _penumbraSparkline(rowMaps, colName, groupCol, rest) {
        var series = _penumbraSparklineBucket(
            _penumbraSparklineSeries(rowMaps, colName, groupCol),
            PENUMBRA_SPARK_MAX_POINTS
