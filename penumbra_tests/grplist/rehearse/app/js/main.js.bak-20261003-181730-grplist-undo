    // Reserved URL params a prompt name must not collide with when building a
    // comparison share link - mirrors the scheduler's $_cmpReserved list
    // (schedule_runner.php), plus the download-link set. Embedding a prompt
    // under one of these names would corrupt the link.
    var _CMP_RESERVED_PARAMS = {
        id: 1, state: 1, snap: 1, snapcmp: 1, snapab: 1, snapkeys: 1, snapview: 1, livecmp: 1, search: 1, dsearch: 1, sort: 1,
        download: 1, dltpl: 1, theme: 1, fstheme: 1, fspages: 1, fstitle: 1, via: 1, density: 1, fullscreen: 1, rowheight: 1,
        deeplink: 1, rowlimit: 1, debug: 1, json: 1, noadm: 1, console: 1
    };

    /**
     * Builds the shareable deep link for the comparison currently on screen -
     * the SAME ?snapcmp= URL the scheduler's change-analysis emails carry, so
     * the recipient's boot (autoCompareSnapshotFromUrl) reproduces this exact
     * live-vs-baseline diff. Returns {url, search, keys, prompts} or {error}.
     */
    function _buildComparisonShareUrl(evergreenToken) {
        // evergreenToken (optional): a selector token (latest /
        // latest-scheduler / pinned / ...) substituted for the baseline
        // snapshot's id in the vs-live form, producing a link that re-resolves
        // its baseline every time it's opened. Only meaningful for the
        // ?snapcmp= branch; A-vs-B and live-vs-live branches ignore it.
        var reportId = new URLSearchParams(window.location.search).get('id') || '';
        if (!reportId && _activeCompareAb) {
            // A-vs-B has no live side, so the id is only the shell the recipient boots
            // in - the snapshots' own report serves for a tab that has none (a
            // home-screen A-vs-B). Every other comparison genuinely needs THIS
            // report's id, because its current side is this report's live data.
            reportId = (_activeCompareAb.snapA && _activeCompareAb.snapA.reportShortId)
                    || (_activeCompareAb.snapB && _activeCompareAb.snapB.reportShortId) || '';
        }
        if (!reportId) {
            return { error: 'Save this report to the server first so it has a shareable id, then re-run the comparison.' };
        }
        // A-vs-B: both sides are frozen server snapshots -> ?snapab=idA,idB
        // (boots via autoCompareABFromUrl). The most deterministic share in
        // the system - no live side, so no drift and no prompt params; the
        // only decay is a snapshot being deleted or rotating out, which the
        // boot degrades with a toast + live fallback.
        if (_activeCompareAb) {
            var abA = _activeCompareAb.snapA, abB = _activeCompareAb.snapB;
            if (!abA || !abB) {
                return { error: 'No active comparison to link to.' };
            }
            if (abA.serverId == null || abB.serverId == null) {
                return { error: 'This A-vs-B comparison includes a <strong>browser-local</strong> snapshot, which only exists on this computer. Open the snapshot dialog, select it, click <strong>&uarr; Copy to server</strong>, then compare the server copies to get a shareable link.' };
            }
            var abUrl = window.location.origin + window.location.pathname
                    + '?id=' + encodeURIComponent(reportId)
                    + '&snapab=' + encodeURIComponent(abA.serverId + ',' + abB.serverId);
            var abKeys = (_activeCompareAb.customKeys && _activeCompareAb.customKeys.length)
                ? _activeCompareAb.customKeys : null;
            if (abKeys) abUrl += '&snapkeys=' + encodeURIComponent(abKeys.join(','));
            // Carry the on-screen search so the recipient sees the same row
            // subset (view-only __SNAP_TYPE group clauses stripped, as ever).
            var abSearch = _stripSnapTypeClauses(($('#tableSearch').val() || '').trim());
            if (abSearch) abUrl += '&search=' + encodeURIComponent(abSearch);
            return { url: abUrl, search: abSearch, keys: abKeys, prompts: 0 };
        }
        var snap = _activeCompareSnapshot && _activeCompareSnapshot.snapshot;
        if (!snap) {
            return { error: 'No active comparison to link to.' };
        }
        // Live-vs-live (?livecmp=): the against side is a fresh fetch, not a
        // stored snapshot - emit the livecmp form (with its against-side
        // lcp_ prompt params) so the recipient re-runs the same drift view.
        if (snap.liveCmp && snap.liveCmp.report) {
            var lcUrl = window.location.origin + window.location.pathname
                    + '?id=' + encodeURIComponent(reportId)
                    + '&livecmp=' + encodeURIComponent(snap.liveCmp.report);
            var lcpObj = snap.liveCmp.prompts || {};
            Object.keys(lcpObj).forEach(function (nm) {
                lcUrl += '&lcp_' + encodeURIComponent(nm) + '=' + encodeURIComponent(lcpObj[nm]);
            });
            var lcKeys2 = (_activeCompareSnapshot.customKeys && _activeCompareSnapshot.customKeys.length)
                ? _activeCompareSnapshot.customKeys : null;
            if (lcKeys2) lcUrl += '&snapkeys=' + encodeURIComponent(lcKeys2.join(','));
            var lcSearch = _stripSnapTypeClauses(($('#tableSearch').val() || '').trim());
            if (lcSearch) lcUrl += '&search=' + encodeURIComponent(lcSearch);
            // Pre-answer THIS report's named prompts too (the current side).
            var lcEmbedded = 0;
            try {
                var lcCurrent = getCurrentPromptParams() || {};
                Object.keys(lcCurrent).forEach(function (nm) {
                    var v = lcCurrent[nm];
                    if (v === null || v === undefined || v === '') return;
                    if (_CMP_RESERVED_PARAMS[String(nm).toLowerCase()]) return;
                    if (/^lcp_/i.test(nm)) return;
                    if (lcUrl.length > 1800) return;
                    lcUrl += '&' + encodeURIComponent(nm) + '=' + encodeURIComponent(v);
                    lcEmbedded++;
                });
            } catch (e) { /* prompts are a nicety - never block the link */ }
            return { url: lcUrl, search: lcSearch, keys: lcKeys2, prompts: lcEmbedded };
        }
        // Local snapshots live in THIS browser's storage - a link to one would
        // resolve to nothing for anyone else (and on any other machine).
        if (snap.serverId == null) {
            return { error: 'This comparison uses a <strong>browser-local</strong> snapshot, which only exists on this computer. Open the snapshot dialog, select it, click <strong>&uarr; Copy to server</strong>, then compare against that server copy to get a shareable link.' };
        }

        var url = window.location.origin + window.location.pathname
                + '?id=' + encodeURIComponent(reportId)
                + '&snapcmp=' + encodeURIComponent(evergreenToken || snap.serverId);

        // Custom key columns: rows pair on these instead of whole-row identity.
        var keys = (_activeCompareSnapshot.customKeys && _activeCompareSnapshot.customKeys.length)
            ? _activeCompareSnapshot.customKeys : null;
        if (keys) url += '&snapkeys=' + encodeURIComponent(keys.join(','));

        // The diff reads the live side through the search filter, so carry it -
        // without it the recipient's comparison would cover a different row set.
        // __SNAP_TYPE group clauses (the group-header X buttons) are view-only
        // and meaningless on a fresh boot, so strip them first.
        var search = _stripSnapTypeClauses(($('#tableSearch').val() || '').trim());
        if (search) url += '&search=' + encodeURIComponent(search);

        // Pre-answer named prompts so the link doesn't re-prompt - a URL param
        // named after the prompt is the client's highest-priority source (the
        // same channel the emailed link uses). Unnamed/hidden prompts have no
        // URL channel and will still ask.
        var embedded = 0;
        try {
            var current = getCurrentPromptParams() || {};
            Object.keys(current).forEach(function (nm) {
                var v = current[nm];
                if (v === null || v === undefined || v === '') return;
                if (_CMP_RESERVED_PARAMS[String(nm).toLowerCase()]) return;
                if (url.length > 1800) return; // same cap the runner applies
                url += '&' + encodeURIComponent(nm) + '=' + encodeURIComponent(v);
                embedded++;
            });
        } catch (e) { /* prompts are a nicety - never block the link */ }

        return { url: url, search: search, keys: keys, prompts: embedded };
    }

    // Shows the banner's "Copy link" button for comparisons that HAVE a URL
    // form - vs-live (?snapcmp=, pass the snapshot) AND A-vs-B (?snapab=,
    // pass true). Local-snapshot and unsaved-report cases stay visible on
    // purpose - clicking explains what to do instead of leaving the user
    // wondering where the share affordance went.
    function _syncCompareShareLink(snapshot) {
        $('#snapAnalysisDock .snap-banner-link').toggle(!!snapshot);
        // Evergreen variant: only for vs-live compares against a SERVER
        // snapshot. A-vs-B passes `true` (no single baseline to track), local
        // snapshots have no serverId (nothing server-side to re-resolve), and
        // a live-vs-live compare is already evergreen through its own
        // ?livecmp= URL.
        var _ever = !!snapshot && snapshot !== true && snapshot.serverId != null && !snapshot.liveCmp;
        $('#snapAnalysisDock .snap-banner-link-evergreen').toggle(_ever);
    }

