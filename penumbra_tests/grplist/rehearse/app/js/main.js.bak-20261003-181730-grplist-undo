                case 'rename-state':
                    {
                        // Use a block to scope variables
                        const oldName = stateData.name;
                        let newName = prompt("Enter the new name for this state:", oldName);

                        // 1. Validate the new name
                        if (!newName || newName.trim() === '') {
                            menu.remove();
                            // User cancelled or entered nothing
                            return;
                        }
                        newName = newName.trim();
                        if (newName.toLowerCase() === oldName.toLowerCase()) {
                            menu.remove();
                            // Name is the same, do nothing
                            return;
                        }

                        // 2. Check for duplicates
                        let savedQueries = JSON.parse(localStorage.getItem("savedQueries") || "[]");
                        const isDuplicate = savedQueries.some(state => state.name.toLowerCase() === newName.toLowerCase());

                        if (isDuplicate) {
                            alert(`Error: A state named "${newName}" already exists. Please choose a different name.`);
                            menu.remove();
                            return;
                        }

                        // 3. Update the name in localStorage
                        const stateIndexToUpdate = savedQueries.findIndex(state => state.name === oldName);
                        if (stateIndexToUpdate > -1) {
                            savedQueries[stateIndexToUpdate].name = newName;
                            localStorage.setItem("savedQueries", JSON.stringify(savedQueries));

                            // Also update favorite if it exists
                            const favKey = "penumbra_favorite_states";
                            let favorites = new Set(JSON.parse(localStorage.getItem(favKey) || "[]"));
                            if (favorites.has(oldName)) {
                                favorites.delete(oldName);
                                favorites.add(newName);
                                localStorage.setItem(favKey, JSON.stringify(Array.from(favorites)));
                            }

                            // 4. Update UI and provide feedback
                            if (currentLoadedStateName === oldName) {
                                currentLoadedStateName = newName;
                            }
                            populateSelectorBox();
                            show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Renamed "${escapeHtml(oldName)}" to "${escapeHtml(newName)}".</p>`);
                        }
                    }
                    menu.remove();
                    break;
                case 'duplicate-state':
                    {
                        const originalName = stateData.name;
                        const originalUrl = stateData.url;

                        let savedQueries = JSON.parse(localStorage.getItem("savedQueries") || "[]");
                        const allNames = new Set(savedQueries.map(s => s.name.toLowerCase()));

                        // 1. Find the base name, stripping any existing "(#)" suffix
                        const baseNameMatch = originalName.match(/^(.+?)(?: \(\d+\))?$/);
                        const baseName = baseNameMatch ? baseNameMatch[1].trim() : originalName;

                        // 2. Find the next available number in the sequence
                        let counter = 2;
                        let newName = `${baseName} (${counter})`;
                        while (allNames.has(newName.toLowerCase())) {
                            counter++;
                            newName = `${baseName} (${counter})`;
                        }

                        // 3. Create the new state and add it to the array
                        const newState = {
                            name: newName,
                            url: originalUrl
                        };
                        savedQueries.push(newState);
                        localStorage.setItem("savedQueries", JSON.stringify(savedQueries));

                        // 4. Update UI and provide feedback
                        populateSelectorBox();
                        show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Duplicated "${escapeHtml(originalName)}" as "${escapeHtml(newName)}".</p>`);
                    }
                    menu.remove();
                    break;
                case 'delete-state':
                    if (confirm(`Are you sure you want to delete the saved state: "${stateData.name}"?`)) {
                        show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Saved state "${escapeHtml(stateData.name)}" deleted</span>`);

                        const stateNameToDelete = stateData.name;
                        let savedQueries = JSON.parse(localStorage.getItem("savedQueries") || "[]");

                        // Filter out the state by its name instead of using splice() with an index
                        const updatedQueries = savedQueries.filter(state => state.name !== stateNameToDelete);

                        localStorage.setItem("savedQueries", JSON.stringify(updatedQueries));
                        populateSelectorBox();
                        // Refresh the list
                    }
                    menu.remove();
                    break;
            }

            menu.remove();
        });

        window._pnbBodyFor(e).append(menu); // PiP-aware: menu renders in the window that spawned it

        // Close menu when clicking elsewhere
        setTimeout(() => {
            $(document).one('click', () => menu.remove());
        }
            , 0);
    }

    // Show additional import options (icon click or right-click)
    function showImportMoreOptions(triggerElement, $item, e) {
        $('.context-submenu').remove();
        var importName = $item.data('value');
        if (!importName) return;

        var meta = window._penumbraImportMeta[importName];
        var rowCount = 0;
        if (window._penumbraImportedData[importName]) {
            rowCount = window._penumbraImportedData[importName].length;
        } else if (meta) {
            rowCount = meta.row_count || 0;
        }
        var tag = '[IMPORT; name=' + importName + ']';

        var menu = $(`
        <div class="context-submenu">
            <div class="submenu-item disabled-menu-item">${escapeHtml(importName)} <small style="opacity:0.6">(${rowCount} rows)</small></div>
            <div class="submenu-divider"></div>
            <div class="submenu-item" data-action="import-open">Open Here (dblclick)</div>
            <div class="submenu-item" data-action="import-open-new">Open in New Tab (shift+click)</div>
            <div class="submenu-divider"></div>
            <div class="submenu-item" data-action="import-copy-name">Copy Name</div>
            <div class="submenu-item" data-action="import-copy-tag">Copy Tag</div>
            <div class="submenu-item" data-action="import-insert-tag">Insert Tag at Cursor</div>
            <div class="submenu-divider"></div>
            <div class="submenu-item" data-action="import-show-raw">Show Raw Data</div>
            <div class="submenu-item" data-action="import-view-ddl">View DDL Cache</div>
            <div class="submenu-divider"></div>
            <div class="submenu-item" data-action="import-rename">Rename</div>
            <div class="submenu-item" data-action="import-duplicate">Duplicate</div>
            <div class="submenu-item" data-action="import-delete" style="color: var(--accent-danger, #c82333);">Delete</div>
        </div>
        `);

        menu.css({
            left: (e.pageX + 5) + 'px',
            top: (e.pageY + 5) + 'px'
        });

        menu.on('click', '.submenu-item', function () {
            var action = $(this).data('action');
            // The clicked item, captured while `this` still means it - the menu is
            // hosted through _pnbBodyFor, so popped out it lives in the console
            // window and only that window can open a tab (see _pnbOpenTab).
            var _srcItem = this;

            switch (action) {
                case 'import-open':
                    performClearAllAction(importName, 'SELECT * FROM ' + tag);
                    break;

                case 'import-open-new':
                    var adminState = {
                        query: 'SELECT * FROM ' + tag,
                        noLimit: false
                    };
                    var adminEncoded = compressString(JSON.stringify(adminState));
                    var adminUrl = window.location.href.split("?")[0] + "?state=" + adminEncoded;
                    window._pnbOpenTabOrNotice(_srcItem, adminUrl, 'use <strong>Open Here</strong> to load the import in this view');
                    break;

                case 'import-copy-name':
                    window._pnbCopyText(importName, "Copied \"" + escapeHtml(importName) + "\" to clipboard.");
                    break;

                case 'import-copy-tag':
                    window._pnbCopyText(tag, "Copied <code>" + escapeHtml(tag) + "</code> to clipboard.");
                    break;

                case 'import-insert-tag':
                    if (typeof editor !== 'undefined' && editor.replaceSelection) {
                        editor.replaceSelection(tag);
                        editor.focus();
                    }
                    show_text("<p id='undo_text'><span style='color: lightgreen'>INSERTED:</span> <code>" + escapeHtml(tag) + "</code> into SQL editor.</p>");
                    break;

                case 'import-show-raw':
                    showImportRawData(importName);
                    break;

                case 'import-view-ddl':
                    showDdlCache(importName, 'imported');
                    break;

                case 'import-rename':
                    var oldName = importName;
                    var newName = prompt('Enter a new name for this import:', oldName);
                    if (!newName || newName.trim() === '') { menu.remove(); return; }
                    newName = newName.trim().replace(/[^A-Za-z0-9_]/g, '_').replace(/_+/g, '_').replace(/^_|_$/g, '').toUpperCase();
                    if (!newName) { menu.remove(); return; }
                    if (newName === oldName) { menu.remove(); return; }
                    if (window._penumbraImportedData[newName] || window._penumbraImportMeta[newName]) {
                        alert('An import named "' + newName + '" already exists.');
                        menu.remove();
                        return;
                    }
                    // Rename in all client registries
                    if (window._penumbraImportedData[oldName]) {
                        window._penumbraImportedData[newName] = window._penumbraImportedData[oldName];
                        delete window._penumbraImportedData[oldName];
                    }
                    if (window._penumbraImportIds[oldName]) {
                        window._penumbraImportIds[newName] = window._penumbraImportIds[oldName];
                        delete window._penumbraImportIds[oldName];
                    }
                    if (window._penumbraImportMeta[oldName]) {
                        window._penumbraImportMeta[newName] = window._penumbraImportMeta[oldName];
                        delete window._penumbraImportMeta[oldName];
                    }
                    // Update on server if persisted
                    var _renameId = window._penumbraImportIds[newName];
                    if (_renameId) {
                        $.ajax({
                            url: 'manage_imports.php',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ action: 'rename', id: _renameId, new_name: newName }),
                            dataType: 'json',
                            error: function (xhr) {
                                if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                                var msg = 'Failed to rename import on server.';
                                try { msg = JSON.parse(xhr.responseText).message || msg; } catch (ignore) {}
                                show_text('<p id="undo_text"><span style="color: red">ERROR:</span> ' + escapeHtml(msg) + '</p>');
                            }
                        });
                    }
                    populateSelectorBox();
                    show_text('<p id="undo_text"><span style="color: lightgreen">SUCCESS:</span> Renamed "' + escapeHtml(oldName) + '" to "' + escapeHtml(newName) + '".</p>');
                    break;

                case 'import-duplicate':
                    {
                        // Find a unique name: ORIGINAL_2, ORIGINAL_3, etc.
                        var baseMatch = importName.match(/^(.+?)(?:_(\d+))?$/);
                        var baseName = baseMatch ? baseMatch[1] : importName;
                        var allImportKeys = Object.keys(window._penumbraImportedData || {}).concat(Object.keys(window._penumbraImportMeta || {}));
                        var allNamesSet = {};
                        allImportKeys.forEach(function (k) { allNamesSet[k.toUpperCase()] = true; });

                        var dupCounter = 2;
                        var dupName = baseName + '_' + dupCounter;
                        while (allNamesSet[dupName.toUpperCase()]) {
                            dupCounter++;
                            dupName = baseName + '_' + dupCounter;
                        }
                        dupName = dupName.toUpperCase();

                        // Duplicate server-side (copies CLOB data directly in the DB)
                        var _srcId = window._penumbraImportIds[importName] ||
                                     (meta && meta.id);
                        if (_srcId) {
                            $.ajax({
                                url: 'manage_imports.php',
                                type: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify({ action: 'duplicate', id: _srcId, new_name: dupName }),
                                dataType: 'json',
                                success: function (resp) {
                                    if (resp && resp.status === 'success' && resp.id) {
                                        window._penumbraImportIds[dupName] = resp.id;
                                        window._penumbraImportMeta[dupName] = {
                                            id: resp.id,
                                            filename: resp.filename || dupName,
                                            row_count: resp.row_count || rowCount
                                        };
                                        // Also copy client-side data if available
                                        if (window._penumbraImportedData[importName]) {
                                            window._penumbraImportedData[dupName] = JSON.parse(JSON.stringify(window._penumbraImportedData[importName]));
                                        }
                                        populateSelectorBox();
                                    }
                                },
                                error: function (xhr) {
                                    if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                                    var msg = 'Failed to duplicate import.';
                                    try { msg = JSON.parse(xhr.responseText).message || msg; } catch (ignore) {}
                                    show_text('<p id="undo_text"><span style="color: red">ERROR:</span> ' + escapeHtml(msg) + '</p>');
                                }
                            });
                        }

                        // Optimistic UI update
                        window._penumbraImportMeta[dupName] = {
                            id: null,
                            filename: (meta && meta.filename) ? meta.filename : dupName,
                            row_count: rowCount
                        };
                        if (window._penumbraImportedData[importName]) {
                            window._penumbraImportedData[dupName] = JSON.parse(JSON.stringify(window._penumbraImportedData[importName]));
                        }

                        populateSelectorBox();
                        show_text('<p id="undo_text"><span style="color: lightgreen">SUCCESS:</span> Duplicated "' + escapeHtml(importName) + '" as "' + escapeHtml(dupName) + '".</p>');
                    }
                    break;

                case 'import-delete':
                    if (!confirm('Delete imported data source "' + importName + '"? This cannot be undone.')) {
                        menu.remove();
                        return;
                    }
                    var _delId = window._penumbraImportIds[importName] ||
                                 (window._penumbraImportMeta[importName] && window._penumbraImportMeta[importName].id);
                    if (_delId) {
                        $.ajax({
                            url: 'manage_imports.php',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ action: 'delete', id: _delId }),
                            dataType: 'json',
                            error: function (xhr) {
                                if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                                var msg = 'Failed to delete import on server.';
                                try { msg = JSON.parse(xhr.responseText).message || msg; } catch (ignore) {}
                                show_text('<p id="undo_text"><span style="color: red">ERROR:</span> ' + escapeHtml(msg) + '</p>');
                            }
                        });
                    }
                    delete window._penumbraImportedData[importName];
                    delete window._penumbraImportIds[importName];
                    delete window._penumbraImportMeta[importName];
                    populateSelectorBox();
                    show_text("<p id='undo_text'><span style='color: orange'>REMOVED:</span> Imported data source <code>" + escapeHtml(importName) + "</code>.</p>");
                    break;
            }

            menu.remove();
        });

        window._pnbBodyFor(e).append(menu); // PiP-aware: menu renders in the window that spawned it

        setTimeout(function () {
            $(document).one('click', function () { menu.remove(); });
        }, 0);
    }

    /**
     * Shows an infobox dialog previewing the raw spreadsheet data for an import.
     * This is the dedicated entry-point for import data previews - call it from
     * the context menu, keyboard shortcuts, or any future UI that needs a
     * quick look at import contents.
     *
     * @param {string} importName - The key in _penumbraImportedData / _penumbraImportMeta
     */
    function showImportRawData(importName) {
        var meta = window._penumbraImportMeta[importName];
        var importId = (window._penumbraImportIds || {})[importName]
                    || (meta && meta.id);
        if (!importId) {
            show_text('<p id="undo_text"><span style="color: orange">INFO:</span> No data found for "' + escapeHtml(importName) + '".</p>');
            return;
        }

        // Show a loading toast while fetching
        show_text('<p id="undo_text"><span style="color: #5bc0de">LOADING:</span> Fetching data for "' + escapeHtml(importName) + '" from server\u2026</p>', 15000);

        $.ajax({
            url: 'manage_imports.php?action=load&id=' + encodeURIComponent(importId),
            type: 'GET',
            dataType: 'json',
            timeout: 60000,
            success: function (resp) {
                // show_text() may have raised this toast in the popped-out
                // console's own dock (see _pnbToastEls); dismissLoading()
                // closes loading-kind cards in BOTH windows without touching
                // any other toast that raced in.
                show_text.dismissLoading();  // dismiss loading toast
                if (resp && resp.status === 'success' && resp.import_data) {
                    var rows;
                    try {
                        rows = typeof resp.import_data === 'string'
                            ? JSON.parse(resp.import_data)
                            : resp.import_data;
                    } catch (e) {
                        show_text('<p id="undo_text"><span style="color: red">ERROR:</span> Failed to parse import data.</p>');
                        return;
                    }
                    if (!Array.isArray(rows) || rows.length === 0) {
                        show_text('<p id="undo_text"><span style="color: orange">INFO:</span> Import "' + escapeHtml(importName) + '" has no rows.</p>');
                        return;
                    }
                    // Cache in memory for future use
                    window._penumbraImportedData[importName] = rows;

                    _openImportRawDialog(importName, rows, {
                        filename:   resp.filename   || (meta && meta.filename) || '',
                        created_by: resp.created_by || '',
                        created_at: resp.created_at || '',
                        last_used:  resp.last_used  || ''
                    });
                } else {
                    var msg = (resp && resp.message) ? resp.message : 'Unknown error loading import data.';
                    show_text('<p id="undo_text"><span style="color: red">ERROR:</span> ' + escapeHtml(msg) + '</p>');
                }
            },
            error: function (xhr) {
                show_text.dismissLoading();  // dismiss loading toast (either window)
                if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                var msg = 'Failed to load import data from server.';
                try { msg = JSON.parse(xhr.responseText).message || msg; } catch (ignore) {}
                show_text('<p id="undo_text"><span style="color: red">ERROR:</span> ' + escapeHtml(msg) + '</p>');
            }
        });
    }

    /**
     * Opens the raw-data infobox for an import, showing metadata header + data table.
     * Separated so both the client-cached and server-fetched paths can reuse it.
     *
     * @param {string}   importName - Display name
     * @param {Object[]} rows       - Array of row objects
     * @param {Object}   info       - { filename, created_by, created_at, last_used }
     */
    function _openImportRawDialog(importName, rows, info) {
        var colCount = Object.keys(rows[0]).length;
        var title = importName + '  (' + rows.length + ' rows \u00D7 ' + colCount + ' cols)';

        // Build a small metadata header above the data table
        var metaParts = [];
        if (info.filename)   metaParts.push('<b>File:</b> '       + escapeHtml(info.filename));
        if (info.created_by) metaParts.push('<b>Created by:</b> ' + escapeHtml(info.created_by));
        if (info.created_at) metaParts.push('<b>Created:</b> '    + escapeHtml(info.created_at));
        if (info.last_used)  metaParts.push('<b>Last used:</b> '  + escapeHtml(info.last_used));

        var metaHtml = metaParts.length > 0
            ? '<div style="font-size:12px;color:var(--text-muted,#888);margin-bottom:8px;line-height:1.7;">'
              + metaParts.join(' &nbsp;\u2022&nbsp; ')
              + '</div>'
            : '';

        // Use raw mode so we can prepend the metadata header, then embed the
        // jsontable output ourselves via createTableFromJson.
        var tableHtml = createTableFromJson(rows, '');

        showInfoboxDialog({
            title: title,
            content: metaHtml + tableHtml,
            mode: 'raw'
        });
    }

    // =========================================================================
    // Table Info Dialog - Tabbed infobox (Columns, Permissions, DDL, FK/Constraints,
