        }
    }

    // Render a lightweight context-menu popup near the click location
    // listing candidate columns to drill into. One drill per click -
    // picking a column invokes opts.onDrill; the secondary "Show source
    // rows" link invokes opts.onShowRows. Clicking outside the popup,
    // pressing Escape, or scrolling the page dismisses it. Only one
    // popup exists at a time - older popups are removed on open.
    function _showDrillChoicePopup(coords, opts) {
        $('.chart-drill-popup').remove();

        var titleParts = opts.titleParts || [];
        var candidates = opts.candidates || [];
        var matchingCount = opts.matchingCount || 0;
        var criterionHtml = titleParts.map(function (tp) {
            return '<div class="chart-drill-popup-crit">' + escapeHtml(tp) + '</div>';
        }).join('');

        var html = '<div class="chart-drill-popup" role="menu" tabindex="-1">';
        html += '<div class="chart-drill-popup-header">'
              +   '<div class="chart-drill-popup-scope">Scope (' + matchingCount + ' row' + (matchingCount !== 1 ? 's' : '') + ')</div>'
              +   criterionHtml
              + '</div>';
        html += '<div class="chart-drill-popup-section-label">Drill into column</div>';
        // Scrollable list: a report with many columns produced a popup taller
        // than the viewport whose items ran past the menu background. Capping the
        // item list (CSS max-height + overflow-y) keeps the header and the
        // footer actions (Show source rows / Cancel) always visible.
        html += '<div class="chart-drill-popup-items">';
        candidates.forEach(function (c) {
            var glyph = (typeof getColumnTypeGlyph === 'function') ? getColumnTypeGlyph(c) : '';
            var glyphHtml = glyph ? '<span class="chart-drill-popup-glyph">' + escapeHtml(glyph) + '</span> ' : '';
            html += '<div class="chart-drill-popup-item" data-col="' + escapeHtml(c) + '" role="menuitem" tabindex="0">'
                  +   '<span class="chart-drill-popup-arrow">\u25B8</span> '
                  +   glyphHtml
                  +   escapeHtml(c)
                  + '</div>';
        });
        html += '</div>';
        html += '<div class="chart-drill-popup-divider"></div>';
        html += '<div class="chart-drill-popup-secondary" data-action="rows" role="menuitem" tabindex="0">Show source rows instead\u2026</div>';
        // "Chart Configuration" replaces the removed double-click-to-edit
        // shortcut.  Hidden for the viz-builder preview canvas (it has no
        // saved vizConfig to open) and when the end-user Visualizations
        // UI option is off (handled via body.restrict-viz in CSS).
        if (opts.canEditChart) {
            html += '<div class="chart-drill-popup-secondary" data-action="editChart" role="menuitem" tabindex="0">Chart Configuration\u2026</div>';
        }
        html += '<div class="chart-drill-popup-secondary" data-action="cancel" role="menuitem" tabindex="0">Cancel</div>';
        html += '</div>';

        var $p = $(html).appendTo('body');

        // Freshly minted row, so it needs the "users don't get this" mark applied
        // here rather than by the boot-time pass. Viewers who cannot edit the
        // report never see the row at all (body.restrict-viz), which is exactly
        // what the mark announces.
        penumbraMarkUserHiddenFor('viewOptionViz', $p.find('[data-action="editChart"]'));

        // Position near the click, flipping to stay on-screen. Fall back
        // to viewport centre when no click coords were supplied (keyboard
        // invocation, etc.).
        var vw = $(window).width();
        var vh = $(window).height();
        var pw = $p.outerWidth();
        var ph = $p.outerHeight();
        var cx = (coords && coords.clientX) || Math.max(0, (vw - pw) / 2);
        var cy = (coords && coords.clientY) || Math.max(0, (vh - ph) / 2);
        var left = cx + 6;
        var top = cy + 6;
        if (left + pw > vw - 8) left = Math.max(8, cx - pw - 6);
        if (top + ph > vh - 8) top = Math.max(8, vh - ph - 8);
        $p.css({ left: left + 'px', top: top + 'px' });

        function closePopup() {
            $p.remove();
            $(document).off('.chartDrillPopup');
            $(window).off('.chartDrillPopup');
        }

        $p.on('click', '.chart-drill-popup-item', function (e) {
            e.stopPropagation();
            var col = $(this).attr('data-col');
            closePopup();
            if (col && typeof opts.onDrill === 'function') opts.onDrill(col);
        });
        $p.on('click', '.chart-drill-popup-secondary', function (e) {
            e.stopPropagation();
            var action = $(this).attr('data-action');
            closePopup();
            if (action === 'rows' && typeof opts.onShowRows === 'function') opts.onShowRows();
            else if (action === 'editChart' && typeof opts.onEditChart === 'function') opts.onEditChart();
        });
        $p.on('click', function (e) { e.stopPropagation(); });

        // Dismiss on outside click, Escape, or scroll. Using namespaced
        // handlers keeps cleanup trivial in closePopup.
        setTimeout(function () {
            $(document).on('click.chartDrillPopup', closePopup);
            $(document).on('keydown.chartDrillPopup', function (e) { if (e.key === 'Escape') closePopup(); });
            $(window).on('scroll.chartDrillPopup', closePopup);
        }, 0);
    }

    // ═══════════════════════════════════════════════════════════════
    //  IN-PLACE DRILL
    //  Instead of opening a new infobox with the drilled chart, the
    //  existing chart is replaced in-place on the same canvas and an
    //  interactive breadcrumb bar is inserted above it. Each
    //  breadcrumb step is a dropdown of distinct values for that
    //  column - changing any step truncates the drill path to that
    //  depth, updates the filter, and redraws. An "\u00d7 Exit drill"
    //  control returns the chart to its pre-drill state.
    //
    //  Drill state lives on the canvas via $.data('drillState') and
    //  survives until either the user exits the drill or the chart is
    //  externally re-rendered (createVisualization / renderSnippetChart
    //  call _wipeDrillState as their first act so form-driven updates
    //  in the builder or snippet re-runs cleanly reset everything).
    // ═══════════════════════════════════════════════════════════════

    // Clear all drill adornments for a canvas. Called when an external
    // re-render is about to overwrite the chart (form edit, snippet
    // re-run, etc.) so stale breadcrumbs don't persist.
    function _wipeDrillState(canvas) {
        if (!canvas) return;
        var $c = $(canvas);
        $c.removeData('drillState');
        $c.removeData('drillPath');
        // Breadcrumb sits inside a centering container as a sibling of
        // the canvas in whatever wrapper (filter wrapper / sizer /
        // plain parent) the chart lives in.
        var $parent = $c.parent();
        if ($parent && $parent.length) {
            $parent.find('.chart-drill-breadcrumb-container').remove();
            // Also clean up any legacy bar left outside a container
            // (from pre-wrapper versions of this code).
            $parent.find('.chart-drill-breadcrumb-bar').remove();
        }
    }
    window._wipeChartDrillState = _wipeDrillState;

    // Filter a row array by a drill path, up to (but not including) the
    // step at `untilIdx`. Used both by the main redraw and by the
    // per-breadcrumb option builder (which needs the ancestor-only
    // filter to compute distinct values for its own level).
    function _filterRowsByPath(rows, path, untilIdx) {
        var stop = (typeof untilIdx === 'number') ? Math.min(untilIdx, path.length) : path.length;
        if (stop <= 0) return rows;
        return rows.filter(function (row) {
            for (var i = 0; i < stop; i++) {
                var step = path[i];
                var col = String(step.col).toUpperCase();
                if (_chartDrillCleanLabel(row.get(col)) !== step.val) return false;
            }
            return true;
        });
    }

    // Compute distinct values of `col` in `rows`, cleaned the same way
    // chart labels are cleaned. Sorted case-insensitively for a stable
    // dropdown order.
    function _distinctColValues(rows, col) {
        var seen = {};
        var out = [];
        var colUp = String(col).toUpperCase();
        for (var i = 0; i < rows.length; i++) {
            var v = _chartDrillCleanLabel(rows[i].get(colUp));
            if (!seen[v]) { seen[v] = true; out.push(v); }
        }
        out.sort(function (a, b) { return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }); });
        return out;
    }

    // Build the in-place breadcrumb bar HTML for a given drillState.
    // Each step renders as "COL: [value \u25be]" with a real <select>
    // whose options are the distinct values at that level given all
    // ancestor filters. The final entry is a plain label identifying
    // the current X axis.
    function _buildDrillBreadcrumbHtml(state) {
        var path = state.path || [];
        var parts = [];
        parts.push('<button type="button" class="chart-drill-exit" title="Exit drill-down and restore the original chart">&times;</button>');
        path.forEach(function (step, i) {
