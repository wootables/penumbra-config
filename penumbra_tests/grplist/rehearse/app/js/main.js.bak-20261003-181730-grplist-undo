    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        // textContent → innerHTML escapes <, >, &, but leaves " and ' alone.
        // Escape them too so the result is safe inside attribute values
        // (e.g. data-raw-prompt="..." for a PROMPT containing template="").
        return div.innerHTML.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    /**
