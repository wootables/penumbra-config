        }
        tabBarHtml += '</div>';

        // Build panels
        var panelsHtml = '';
        for (var pi = 0; pi < tabs.length; pi++) {
            var p = tabs[pi];
            panelsHtml += '<div class="table-info-panel' + (p.id === initialTab ? ' active' : '') + '" data-panel="' + p.id + '">' +
                '<div class="ti-loading"><span class="infobox-spinner"></span> Loading...</div>' +
                '</div>';
        }

        var dialogHtml = '<div id="' + dialogId + '" class="modal-prompt-overlay infobox-overlay">' +
            '<div class="modal-prompt-box infobox-dialog table-info-dialog">' +
                '<h3>' + iconSvg + ' ' + escapeHtml(tableName) + ' <span style="font-weight:400;font-size:12px;opacity:0.6;">(' + escapeHtml(db.toUpperCase()) + ')</span></h3>' +
                tabBarHtml +
                '<div class="modal-prompt-content infobox-content" style="max-height:calc(85vh - 180px);">' +
                    '<div class="infobox-body">' + panelsHtml + '</div>' +
