                    show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Copied ${langLabel} API snippet to clipboard.</p>`);
                }, () => {
                    show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to copy API snippet.</p>");
                });
                break;
            }
            case 'php_stub':
                const sqlQuery = editor.getValue();
                const themeName = $('body').attr('class').split(' ').find(cls => cls.startsWith('theme-')) || 'theme-default';
                const reportTitle = stripHtml(getReportTitle());

                // Determine view mode (pivot/group/standard)
                let viewMode = 'standard';
                if ($('#pivot-output-container').is(':visible')) {
                    viewMode = 'pivot';
                } else if ($('#groupedResultsContainer').is(':visible')) {
                    viewMode = 'group';
                }

                // Determine Live Link
                const urlParams = new URLSearchParams(window.location.search);
                let liveLinkUrl;
                if (urlParams.has('id')) {
                    liveLinkUrl = window.location.href;
                } else {
                    liveLinkUrl = buildViewStateURL();
                }

                // Prepare Payload
                const payload = {
                    sql_query: sqlQuery,
                    theme_name: themeName,
                    email: penumbra_vars.shibboleth.email,
                    subject: reportTitle.replace(/\n/g, ' '),
                    live_link_url: liveLinkUrl ? liveLinkUrl : '',
                    user_fullname: (penumbra_vars.shibboleth.fname || '') + ' ' + (penumbra_vars.shibboleth.lname || ''),
