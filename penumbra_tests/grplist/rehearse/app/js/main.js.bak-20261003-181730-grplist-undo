    async function processPrompts(query, showPrompts = true, secureMode = true) {
        allResolvedPrompts = [];
        // Storage keys already given a data(promptN) slot in THIS pass: the
        // same tag written twice (a UNION) is one prompt, so one slot.
        const _seenPromptKeys = new Set();
        const promptAnswers = new Map();
        // Track answers for dependencies

        // --- START: URL Smart Cleaner ---
        let rawQuery = window.location.search;
        rawQuery = rawQuery.replace(/%20&%20/g, '%20%26%20');
        rawQuery = rawQuery.replace(/\+&\+/g, '+%26+');
        // FIX: Only replace semicolons acting as parameter SEPARATORS, not those within values.
        // A separator semicolon appears between key=value pairs (e.g., "id=foo;name=bar").
        // Semicolons inside values are percent-encoded (%3B) by browsers and are safe.
        // Pattern: replace ; only when followed by a URL parameter key (word chars + '=')
        rawQuery = rawQuery.replace(/;(?=[A-Za-z0-9_]+=)/g, '&');
        const urlParams = new URLSearchParams(rawQuery);
        // --- END: URL Smart Cleaner ---

        const currentReportId = urlParams.get('id') || null;
        let anyPromptWasInteractive = false;
        const promptRegex = /\[\s*PROMPT[^\]]*\]/gi
        const prompts = [];
        let match;

        while ((match = promptRegex.exec(query)) !== null) {
            prompts.push({
                fullMatch: match[0],
                index: match.index
            });
        }

        if (prompts.length === 0) {
            return secureMode ? {
                query_template: query,
                params: [],
                anyPromptWasInteractive: false
            } : query;
        }
        let finalQuery = "";
        let lastIndex = 0;
        const params = [];

        // The comparison a multi-select tag stands in: the operator at the END of
        // the SQL in front of the tag and the operand in front of that, so
        // `c <op> [PROMPT]` can become `(c <op> :p1 OR c <op> :p2)` or
        // `c IN (:p1, :p2)`. null, or { text: operand..end of s, operand, operator },
        // the operator one of = != <> LIKE, NOT LIKE, IN, NOT IN. The operand is an
        // identifier chain - c, t.c, "My Col", t."My Col", [My Col] - or a
        // parenthesised group with its function name in front, glued or a space
        // away: UPPER(c), UPPER (c), pkg.fn(a, 'x)'), (a + b). This replaced a pattern that read plain column
        // names only: NOT LIKE came out as the column NOT with the operator LIKE,
        // "My Col" = as Col", and UPPER(c) = / c=[PROMPT] not at all. A PROMPT tag
        // inside the operand is refused. Twin of penumbraPromptOperatorBefore() in
        // shared_logic.php - keep the two in step (suite promptparity).
        const readOperatorBefore = (s) => {
            const isWs = p => p >= 0 && ' \t\r\n\f\v'.indexOf(s.charAt(p)) >= 0;
            const isWord = p => p >= 0 && /[A-Za-z0-9_$#]/.test(s.charAt(p));
            let i = s.length;
            while (isWs(i - 1)) i--;

            // ---- the operator
            let operator;
            const two = (i >= 2) ? s.substring(i - 2, i) : '';
            if (two === '!=' || two === '<>') {
                operator = two;
                i -= 2;
            } else if (i >= 1 && s.charAt(i - 1) === '=') {
                if (i >= 2 && '<>!:^~'.indexOf(s.charAt(i - 2)) >= 0) return null;   // <= >= := ^= ~= are not ours
                operator = '=';
                i -= 1;
            } else {
                const w = /(?:^|[^A-Za-z0-9_$#])(LIKE|IN)$/i.exec(s.substring(0, i));
                if (!w) return null;
                operator = w[1].toUpperCase();
                i -= w[1].length;
                let k = i;
                while (isWs(k - 1)) k--;
                if (k < i && k >= 3 && s.substring(k - 3, k).toUpperCase() === 'NOT' && !isWord(k - 4)) {
                    operator = 'NOT ' + operator;
                    i = k - 3;
                }
                // A word operator is set off from its operand (c LIKE, UPPER(c)LIKE).
                if (!isWs(i - 1) && (i < 1 || ')"]'.indexOf(s.charAt(i - 1)) < 0)) return null;
            }

            // ---- the operand, read backwards
            let j = i;
            while (isWs(j - 1)) j--;
            const operandEnd = j;
            // One name part ending at pos: "quoted", [bracketed] or a bare word. Its start, or -1.
            const readName = (pos) => {
                if (pos < 1) return -1;
                const ch = s.charAt(pos - 1);
                if (ch === '"' || ch === ']') {
                    const open = (ch === '"') ? '"' : '[';
                    for (let p = pos - 2; p >= 0; p--) {
                        if (s.charAt(p) === open) {
                            const inner = s.substring(p + 1, pos - 1);
                            if (inner === '') return -1;
                            // [PROMPT;...] and the other bracket tags are not identifiers.
                            if (ch === ']' && (/[\[;]/.test(inner) || /^\s*PROMPT\b/i.test(inner))) return -1;
                            return p;
                        }
                    }
                    return -1;
                }
                let p = pos;
                while (isWord(p - 1)) p--;
                return (p < pos) ? p : -1;
            };
            let start;
            if (j >= 1 && s.charAt(j - 1) === ')') {
                // Back to the matching '(', stepping over 'literals' and "names" whole.
                let depth = 0, p;
                for (p = j - 1; p >= 0; p--) {
                    const ch = s.charAt(p);
                    if (ch === "'" || ch === '"') {
                        let q = p - 1;
                        while (q >= 0 && s.charAt(q) !== ch) q--;
                        if (q < 0) return null;
                        p = q;
                        continue;
                    }
                    if (ch === ')') depth++;
                    else if (ch === '(') { depth--; if (depth === 0) break; }
                }
                if (p < 0) return null;
                start = p;
                // A function name in front of the '(' belongs to it - glued, UPPER(c), or a
                // space away, UPPER (c) - unless it is a keyword: x AND (c) = [PROMPT]
                // compares (c), not AND (c).
                let q = p;
                while (isWs(q - 1)) q--;
                const nameStart = readName(q);
                if (nameStart >= 0 && !/^(AND|OR|NOT|WHERE|ON|WHEN|THEN|ELSE|HAVING|IN|IS|EXISTS|SELECT|BY|LIKE|BETWEEN|CASE|RETURN|FROM|JOIN|DISTINCT|AS|WITH|UNION|ALL|ANY|SOME|SET|VALUES|USING|INTO|ESCAPE)$/i.test(s.substring(nameStart, q))) {
                    start = nameStart;
                }
            } else {
                start = readName(j);
                if (start < 0) return null;
            }
            // Qualifiers in front: t.c, s.t."My Col", pkg.fn(...).
            for (;;) {
                let d = start;
                while (isWs(d - 1)) d--;
                if (d < 1 || s.charAt(d - 1) !== '.') break;
                let e = d - 1;
                while (isWs(e - 1)) e--;
                const q = readName(e);
                if (q < 0) break;
                start = q;
            }
            const operand = s.substring(start, operandEnd);
            if (/\[\s*PROMPT/i.test(operand)) return null;
            return { text: s.substring(start), operand: operand, operator: operator };
        };

        // The per-value SQL pieces of a prompt whose picked options carry their own
        // templates (options=Display:Value::Template), joined: ONE piece exactly as it
        // is; several grouped, with a leading AND / OR once OUTSIDE the group - the
        // prompt template's own, or, with no prompt template, the pieces' - and off
        // every piece inside it. It used to come off the prompt-template pieces only and
        // never go back, so fi-epa's `All::and c.code_desc like '%'` with another status
        // ran as `(and c.code_desc like '%' OR c.code_desc = :p2)`: invalid SQL.
        // Twin of penumbraPromptJoinPieces() in shared_logic.php.
        const joinOptionPieces = (pieces, promptTpl, joiner) => {
            if (pieces.length === 0) return '';
            if (pieces.length === 1) return pieces[0];
            const lead = /^\s*(AND|OR)\s+/i;
            let prefix = '';
            if (promptTpl !== null && promptTpl !== undefined && promptTpl !== '') {
                const m = lead.exec(promptTpl);
                if (m) prefix = m[0];
            } else {
                for (const p of pieces) {
                    const m = lead.exec(p);
                    if (m) { prefix = m[0]; break; }
                }
            }
            return prefix + '(' + pieces.map(p => p.replace(lead, '')).join(joiner) + ')';
        };

        for (const prompt of prompts) {
            const parsedPrompt = parsePrompt(prompt.fullMatch);
            const storageKey = getPromptStorageKey(prompt.fullMatch);

            // --- START: NEW CONDITIONAL LOGIC ---
            if (parsedPrompt.resultif) {
                const parentName = parsedPrompt.resultif.parentName;
                let expectedValue = parsedPrompt.resultif.expectedValue;
                let conditionMet = false;

                // Negation support: "resultif=parent:!value" inverts the match
                let negate = false;
                if (expectedValue.startsWith('!')) {
                    negate = true;
                    expectedValue = expectedValue.substring(1);
                }

                if (promptAnswers.has(parentName)) {
                    const parentVal = promptAnswers.get(parentName);

                    // Detect if expectedValue is a regex (e.g., /pattern/flags)
                    const regexMatch = expectedValue.match(/^\/(.*?)\/([a-z]*)$/);

                    if (regexMatch) {
                        try {
                            const re = new RegExp(regexMatch[1], regexMatch[2]);
                            if (Array.isArray(parentVal)) {
                                conditionMet = parentVal.some(val => re.test(String(val)));
                            } else {
                                conditionMet = re.test(String(parentVal));
                            }
                        } catch (e) {
                            console.error("Invalid Regex in resultif:", expectedValue);
                        }
                    } else {
                        // Standard Exact Match Mode (supports pipe-delimited multi-value: "val1|val2")
                        const expectedValues = expectedValue.split('|');
                        if (Array.isArray(parentVal)) {
                            conditionMet = parentVal.some(pv => expectedValues.includes(String(pv)));
                        } else {
                            conditionMet = expectedValues.includes(String(parentVal));
                        }
                    }

                    // Apply negation after evaluation
                    if (negate) conditionMet = !conditionMet;
                } else {
                    // FIX: Forward-reference warning - the parent prompt hasn't been processed yet.
                    // This means the resultif will always silently evaluate to false.
                    console.warn(`[Penumbra] resultif references prompt '${parentName}' which has not been answered yet. ` +
                        `Ensure the parent prompt appears BEFORE the dependent prompt in the SQL query. ` +
                        `The condition will evaluate to false.`);
                }

                if (!conditionMet) {
                    // Condition failed: Skip this prompt entirely.

                    // --- CLEANUP FIX: Delete stale data ---
                    // If the condition is not met, the saved answer is invalid.
                    // We must delete it so it doesn't appear in the prompt list.
                    localStorage.removeItem(storageKey);
                    // -------------------------------------

                    // When a resultif condition fails, also strip a *common* preceding
                    // SQL clause fragment so the query stays valid.
                    //
                    // INTENTIONALLY NARROW - only the two patterns below are handled:
                    //   1. `AND/OR col OP`  (op: = != <> < > <= >= LIKE IN BETWEEN IS / IS NOT, optional NOT, schema-qualified `s.col` OK)
                    //   2. `WHERE col OP`   (rewritten to `WHERE 1=1` to preserve trailing AND/OR clauses)
                    //
                    // NOT handled (and by design - don't expand the regex chasing edge cases):
                    //   - Function-wrapped columns: TRUNC(col), UPPER(col), ...
                    //   - Arithmetic / parenthesized expressions: col + 1, (a OR b), ...
                    //   - HAVING clauses, subquery contexts, dialect-specific operators
                    //
                    // Authors hitting the unhandled shapes should put the entire clause inside
                    // `template="..."` so the prompt's expansion is self-contained and disappears
                    // cleanly when resultif fails - no string-surgery required. The decision-tree
                    // tooltip (help_content.php data-tip="resultif") documents this pattern as the
                    // recommended approach.
                    //
                    // SAME REGEX lives in schedule_runner.php and index.php - keep them in sync.
                    let textBeforePrompt = query.substring(lastIndex, prompt.index);

                    const clausePattern = /\s+(AND|OR)\s+(?:[\w."]+\s*\.\s*)?[\w."]+\s*(?:NOT\s+)?(?:>=|<=|!=|<>|>|<|=|LIKE|IN|BETWEEN|IS(?:\s+NOT)?)\s*$/i;
                    let clauseMatch = textBeforePrompt.match(clausePattern);

                    if (!clauseMatch) {
                        const whereClausePattern = /\s+(WHERE)\s+(?:[\w."]+\s*\.\s*)?[\w."]+\s*(?:NOT\s+)?(?:>=|<=|!=|<>|>|<|=|LIKE|IN|BETWEEN|IS(?:\s+NOT)?)\s*$/i;
                        const whereMatch = textBeforePrompt.match(whereClausePattern);
                        if (whereMatch) {
                            // Replace "WHERE col op" with "WHERE 1=1" to keep SQL valid
                            textBeforePrompt = textBeforePrompt.substring(0, textBeforePrompt.length - whereMatch[0].length) + ' WHERE 1=1';
                        }
                    } else {
                        // AND/OR clause matched - strip it entirely
                        textBeforePrompt = textBeforePrompt.substring(0, textBeforePrompt.length - clauseMatch[0].length);
                    }

                    finalQuery += textBeforePrompt;
                    lastIndex = prompt.index + prompt.fullMatch.length;
                    continue;
                    // Skip the rest of the loop for this prompt
                }
            }
            // --- END: NEW CONDITIONAL LOGIC ---

            // --- Dynamic date-range prompts: resolve MIN/MAX bounds + keywords ---
            // Only on paths that actually consume the defaults/bounds: skipped
            // when a URL param supplies the value (no dialog, defaults unused)
            // and when a saved answer will be reused. {name} tokens resolve from
            // the answers of prompts processed earlier in the SQL.
            if (parsedPrompt.type === 'date' && parsedPrompt.autofill) {
                const hasUrlVal = !!(parsedPrompt.name && urlParams.has(parsedPrompt.name));
                const fdWillApply = parsedPrompt.forcedefault !== null && !_forceDefaultApplied.has(storageKey);
                const hasStored = !!localStorage.getItem(storageKey);
                const dialogMayOpen = showPrompts && !hasUrlVal && !fdWillApply && !hasStored;
                const needsRange = !hasUrlVal && (
                    (fdWillApply && _isRangeKeyword(parsedPrompt.forcedefaultRaw))
                    || dialogMayOpen
                    || (!fdWillApply && !hasStored && _isRangeKeyword(parsedPrompt.defaultRaw)));
                if (needsRange) {
                    await resolvePromptDateRange(parsedPrompt, n => promptAnswers.has(n) ? promptAnswers.get(n) : null);
                }
            }

            // type=date-range with an autofill= source: the same MIN/MAX lookup,
            // with one difference - the min/max keyword can be EITHER half of a
            // "<from>..<to>" answer, and it can arrive from any source (the tag's
            // defaults, a saved answer, the URL). Resolved here, before the
            // priority logic, so every path below sees real bounds; the lookup is
            // cached per condition, so asking early costs at most one request.
            const _isDrPrompt = penumbraIsDateRangeType(parsedPrompt.type);
            if (_isDrPrompt && parsedPrompt.autofill) {
                const drHasUrl = !!(parsedPrompt.name && urlParams.has(parsedPrompt.name));
                const drFdWillApply = parsedPrompt.forcedefault !== null && !_forceDefaultApplied.has(storageKey);
                let drStoredRaw = null;
                try {
                    const drStoredObj = JSON.parse(localStorage.getItem(storageKey) || 'null');
                    if (drStoredObj && drStoredObj.value !== undefined) drStoredRaw = drStoredObj.value;
                } catch (e) { }
                const drDialogMayOpen = showPrompts && !drHasUrl && !drFdWillApply && drStoredRaw === null;
                const drKeywordInPlay = [
                    drHasUrl ? urlParams.get(parsedPrompt.name) : null,
                    parsedPrompt.forcedefaultRaw, parsedPrompt.defaultRaw, drStoredRaw
                ].some(v => penumbraRangeHasKeywordEnd(v));
                if (drDialogMayOpen || drKeywordInPlay) {
                    await resolvePromptDateRange(parsedPrompt, n => promptAnswers.has(n) ? promptAnswers.get(n) : null);
                }
            }

            let dataForQuery = null;
            let valueSource = 'none';
            // 'url', 'forced', 'stored', 'interactive'
            let urlValue = null;

            let finalValues;
            let isEmptyMultiSelect = false;

            // --- START: PRIORITY LOGIC ---

            // 1. Check for URL parameter (Highest Priority)
            if (parsedPrompt.name && urlParams.has(parsedPrompt.name)) {
                urlValue = urlParams.get(parsedPrompt.name);
                valueSource = 'url';

                // --- NEW: Preserve Existing Saved Value for Conflict Detection ---
                let existingUserValue = null;
                const existingStoredStr = localStorage.getItem(storageKey);
                if (existingStoredStr) {
                    try {
                        const existing = JSON.parse(existingStoredStr);
                        // If we already have a savedUserValue (from a previous run), keep it. 
                        // Otherwise, treat the current 'value' as the user's saved preference.
                        if (existing.savedUserValue !== undefined) {
                            existingUserValue = existing.savedUserValue;
                        } else if (existing.value !== undefined) {
                            existingUserValue = existing.value;
                        }
                    } catch (e) { }
                }
                // -----------------------------------------------------------------

                if (parsedPrompt.type === 'multi-select') {
                    const values = parseMultiSelectDefault(urlValue);
                    for (const val of values) {
                        const validationError = validatePromptInput(val, parsedPrompt);
                        if (validationError) {
                            throw new Error(`Invalid URL parameter for '${parsedPrompt.name}': ${validationError}`);
                        }
                    }
                    dataForQuery = values.map(val => ({
                        value: val,
                        display: val
                    }));
                } else if (_isDrPrompt) {
                    // ?name=<from>..<to> - both halves resolved and checked NOW so a
                    // bad link fails here, naming the parameter, not in the database.
                    // The RAW text is what gets stored: a link carrying
                    // "first day of last month..last day of last month" keeps rolling.
                    const drUrl = penumbraResolveDateRange(urlValue, parsedPrompt);
                    if (drUrl.error) {
                        throw new Error(`Invalid URL parameter for '${parsedPrompt.name}': ${drUrl.error} Write it as ${parsedPrompt.name}=<from>..<to>, for example ${parsedPrompt.name}=01-JUL-25..30-JUN-26.`);
                    }
                    dataForQuery = {
                        value: urlValue,
                        display: penumbraDateRangeLabel(urlValue)
                    };
                } else {
                    const validationError = validatePromptInput(urlValue, parsedPrompt);
                    if (validationError) {
                        throw new Error(`Invalid URL parameter for '${parsedPrompt.name}': ${validationError}`);
                    }
                    dataForQuery = {
                        value: urlValue,
                        display: urlValue
                    };
                }

                if (!parsedPrompt.hidden) {
                    const dataToSave = (Array.isArray(dataForQuery)) ? {
                        message: parsedPrompt.message,
                        values: dataForQuery,
                        reportId: currentReportId
                    } : {
                        ...dataForQuery,
                        message: parsedPrompt.message,
                        reportId: currentReportId
                    };

                    if (parsedPrompt.nosave)
                        dataToSave.nosave = true;

                    // --- NEW: Save the preserved user value into the object ---
                    if (existingUserValue !== null) {
                        dataToSave.savedUserValue = existingUserValue;
                    }
                    // ----------------------------------------------------------

                    localStorage.setItem(storageKey, JSON.stringify(dataToSave));
                }

                // A URL answer OUTRANKS the forced default, so the forced default is
                // spent for this page session exactly as if it had been applied.
                // Without this, unlocking the prompt (which deletes the URL param and
                // re-runs) left forcedefault "not yet applied", so priority 2 below
                // refused to read localStorage and the forced default silently
                // replaced whatever the user just typed. A page RELOAD still clears
                // this Set, so forcedefault re-asserts on a fresh load as designed.
                _forceDefaultApplied.add(storageKey);
            }// 2. Check local storage (Second Priority)
            // FIX: Skip saved value when forcedefault is set on FIRST page-load run.
            // After forcedefault is applied once this session, allow localStorage reads
            // so the user can interactively change the value within the same session.
            // On page reload, _forceDefaultApplied resets and forcedefault re-applies.
            else if (parsedPrompt.forcedefault === null || _forceDefaultApplied.has(storageKey)) {
                const storedDataString = localStorage.getItem(storageKey);
                if (storedDataString) {
                    try {
                        const storedData = JSON.parse(storedDataString);

                        // --- FIX START: Force-Sync 'nosave' flag ---
                        // If the code definition says 'nosave', ensure the stored data has the flag.
                        // This fixes "zombie" prompts that were saved before the flag was added.
                        if (parsedPrompt.nosave && !storedData.nosave) {
                            storedData.nosave = true;
                            localStorage.setItem(storageKey, JSON.stringify(storedData));
                        }
                        // --- FIX END ---

                        if (!Array.isArray(storedData) && storedData.values !== undefined) {
                            dataForQuery = storedData.values;
                        } else if (storedData.message !== undefined && storedData.value !== undefined) {
                            dataForQuery = storedData;
                        } else {
                            dataForQuery = storedData;
                        }
                        valueSource = 'stored';
                    } catch (e) {
                        localStorage.removeItem(storageKey);
                    }
                }
            }
            // --- END: PRIORITY LOGIC ---

            // A STORED date-range answer that no longer resolves (hand-edited
            // storage, or a tag whose validate= was tightened after the answer was
            // saved) is dropped, so the prompt simply asks again. Left in place it
            // would fail every run on an error the user has no dialog to fix.
            if (_isDrPrompt && valueSource === 'stored') {
                const drStoredVal = (dataForQuery && typeof dataForQuery === 'object' && !Array.isArray(dataForQuery))
                    ? dataForQuery.value : dataForQuery;
                if (penumbraResolveDateRange(drStoredVal, parsedPrompt).error) {
                    localStorage.removeItem(storageKey);
                    dataForQuery = null;
                    valueSource = 'none';
                }
            }

            // 3. Check if we need to show an interactive prompt (Last Resort)
            if (showPrompts && valueSource === 'none') {
                anyPromptWasInteractive = true;
                valueSource = 'interactive';
            }

            // 4. Show the interactive prompt (if needed)
            if (valueSource === 'interactive') {
                if (parsedPrompt.forcedefault !== null) {
                    valueSource = 'forced';
                    anyPromptWasInteractive = false;
                    if (parsedPrompt.type === 'multi-select') {
                        const defaultValues = parseMultiSelectDefault(parsedPrompt.forcedefault);
                        for (const val of defaultValues) {
                            const validationError = validatePromptInput(val, parsedPrompt);
                            if (validationError) {
                                const friendlyName = parsedPrompt.message || parsedPrompt.name;
                                renderReportSnippet();
                                throw new Error(`Invalid value for '${friendlyName}': ${validationError}`);
                            }
                        }
                        dataForQuery = defaultValues.map(val => ({
                            value: val,
                            display: val
                        }));
                    } else if (_isDrPrompt) {
                        // The author's expression goes into storage AS WRITTEN (for a
                        // range parsePrompt leaves it alone - no single-date grammar
                        // matches "<from>..<to>"), so the scheduler form and the chip
                        // both see the rolling range, never two dates frozen today.
                        const drForcedRaw = penumbraDateRangeRawDefault(parsedPrompt);
                        const drForced = penumbraResolveDateRange(drForcedRaw, parsedPrompt);
                        if (drForced.error) {
                            const friendlyName = parsedPrompt.message || parsedPrompt.name;
                            renderReportSnippet();
                            throw new Error(`Invalid value for '${friendlyName}': ${drForced.error}`);
                        }
                        dataForQuery = {
                            value: drForcedRaw,
                            display: penumbraDateRangeLabel(drForcedRaw)
                        };
                    } else {
                        const defaultValue = String(parsedPrompt.forcedefault);
                        const validationError = validatePromptInput(defaultValue, parsedPrompt);
                        if (validationError) {
                            const friendlyName = parsedPrompt.message || parsedPrompt.name;
                            renderReportSnippet();
                            throw new Error(`Invalid value for '${friendlyName}': ${validationError}`);
                        }
                        dataForQuery = {
                            value: defaultValue,
                            display: defaultValue
                        };
                    }

                    if (!parsedPrompt.hidden) {
                        const dataToSave = (Array.isArray(dataForQuery)) ? {
                            message: parsedPrompt.message,
                            values: dataForQuery,
                            reportId: currentReportId
                        } : {
                            ...dataForQuery,
                            message: parsedPrompt.message,
                            reportId: currentReportId
                        };
                        if (parsedPrompt.nosave)
                            dataToSave.nosave = true;
                        localStorage.setItem(storageKey, JSON.stringify(dataToSave));
                    }

                    // Mark this forcedefault as applied for this page session.
                    // On subsequent processPrompts calls (e.g. user changes the value),
                    // localStorage will be read instead of re-applying forcedefault.
                    _forceDefaultApplied.add(storageKey);

                } else {
                    anyPromptWasInteractive = true;
                    const userInput = await showPromptDialog(parsedPrompt);

                    if (userInput === null) {
                        if (parsedPrompt.default !== null && parsedPrompt.default !== undefined) {
                            // FIX: Use parseMultiSelectDefault() for multi-select (entity-aware parsing)
                            // and validate default values, matching the forcedefault code path.
                            if (parsedPrompt.type === 'multi-select') {
                                const defaultValues = parseMultiSelectDefault(parsedPrompt.default);
                                for (const val of defaultValues) {
                                    const validationError = validatePromptInput(val, parsedPrompt);
                                    if (validationError) {
                                        const friendlyName = parsedPrompt.message || parsedPrompt.name || 'prompt';
                                        throw new Error(`Invalid default value for '${friendlyName}': ${validationError}`);
                                    }
                                }
                                dataForQuery = defaultValues.map(val => ({
                                    value: val,
                                    display: val
                                }));
                            } else if (_isDrPrompt) {
                                const drDefaultRaw = penumbraDateRangeRawDefault(parsedPrompt);
                                const drDefault = penumbraResolveDateRange(drDefaultRaw, parsedPrompt);
                                if (drDefault.error) {
                                    const friendlyName = parsedPrompt.message || parsedPrompt.name || 'prompt';
                                    throw new Error(`Invalid default value for '${friendlyName}': ${drDefault.error}`);
                                }
                                dataForQuery = {
                                    value: drDefaultRaw,
                                    display: penumbraDateRangeLabel(drDefaultRaw)
                                };
                            } else {
                                const defaultValue = String(parsedPrompt.default);
                                const validationError = validatePromptInput(defaultValue, parsedPrompt);
                                if (validationError) {
                                    const friendlyName = parsedPrompt.message || parsedPrompt.name || 'prompt';
                                    throw new Error(`Invalid default value for '${friendlyName}': ${validationError}`);
                                }
                                dataForQuery = {
                                    value: defaultValue,
                                    display: defaultValue
                                };
                            }
                            const dataToSave = (Array.isArray(dataForQuery)) ? {
                                message: parsedPrompt.message,
                                values: dataForQuery,
                                reportId: currentReportId
                            } : {
                                ...dataForQuery,
                                message: parsedPrompt.message,
                                reportId: currentReportId
                            };
                            localStorage.setItem(storageKey, JSON.stringify(dataToSave));
                        } else {
                            if (secureMode) {
                                throw new Error(`PROMPT_REQUIRED:${parsedPrompt.message || 'A value is required'}`);
                            } else {
                                let dataToSave;
                                if (parsedPrompt.type === 'multi-select') {
                                    dataForQuery = [];
                                } else {
                                    dataForQuery = {
                                        value: null,
                                        display: null
                                    };
                                }
                            }
                        }
                    } else {
                        if (!parsedPrompt.hidden) {
                            const dataToSave = (Array.isArray(userInput)) ? {
                                message: parsedPrompt.message,
                                values: userInput,
                                reportId: currentReportId
                            } : {
                                ...userInput,
                                message: parsedPrompt.message,
                                reportId: currentReportId
                            };
                            if (parsedPrompt.nosave)
                                dataToSave.nosave = true;
                            localStorage.setItem(storageKey, JSON.stringify(dataToSave));
                        }
                        dataForQuery = userInput;
                    }
                }
            }

            // --- START: TRACK ANSWER FOR DEPENDENCIES ---
            if (parsedPrompt.name) {
                let actualVal = null;
                if (Array.isArray(dataForQuery)) {
                    actualVal = dataForQuery.map(item => item.value);
                } else if (dataForQuery && typeof dataForQuery === 'object') {
                    actualVal = dataForQuery.value;
                } else {
                    actualVal = dataForQuery;
                }
                promptAnswers.set(parsedPrompt.name, actualVal);
            }
            // --- END: TRACK ANSWER ---

            // --- 6. Prepare values for SQL ---
            if (Array.isArray(dataForQuery)) {
                finalValues = dataForQuery.map(item => item.value);
                if (finalValues.length === 0) {
                    isEmptyMultiSelect = true;
                }
            } else {
                if (dataForQuery == null) {
                    finalValues = [null];
                } else {
                    let val;
                    if (typeof dataForQuery === 'object' && dataForQuery.value !== undefined) {
                        val = dataForQuery.value;
                    } else {
                        val = dataForQuery;
                    }
                    finalValues = [String(val)];
                }
            }

            // --- 6b. type=date-range: resolve the two dates ---
            // ONE place, whatever the source was. The stored value stays the RAW
            // "<from>..<to>" text; what is computed here is only what THIS run
            // sends, so tomorrow's run resolves the same answer afresh.
            let drRange = null;
            if (_isDrPrompt) {
                const drRaw = (dataForQuery && typeof dataForQuery === 'object' && !Array.isArray(dataForQuery))
                    ? dataForQuery.value : dataForQuery;
                if (drRaw !== null && drRaw !== undefined && String(drRaw).trim() !== '') {
                    drRange = penumbraResolveDateRange(drRaw, parsedPrompt);
                    if (drRange.error) {
                        throw new Error(`Invalid value for '${parsedPrompt.message || parsedPrompt.name || 'date range'}': ${drRange.error}`);
                    }
                } else if (secureMode && parsedPrompt.template !== '') {
                    // Both ends are required. Every other type binds NULL for a
                    // missing answer; here that is `BETWEEN NULL AND NULL` - zero
                    // rows and no explanation.
                    throw new Error(`PROMPT_REQUIRED:${parsedPrompt.message || 'A date range is required'}`);
                }
            }

            // --- 7. Append to query ---
            finalQuery += query.substring(lastIndex, prompt.index);

            // HELPER: Apply Template if exists
            // NOTE: template === '' (empty string) means "control prompt" - output nothing to SQL.
            // This is distinct from template === null/undefined which means "no template, output value directly".
            const applyTemplate = (val, template) => {
                if (template === null || template === undefined)
                    return val;
                // Replace :val with the actual value (or placeholder).
                // Function-form replacement: a plain replacement string applies
                // $-substitution patterns, so a value containing $& re-injected
                // the token and $' spliced in the text after the match - both
                // reachable from an ordinary typed answer.
                return template.replace(/:val/g, () => val);
            }
                ;

            // Non-secure (snippet) twin of applyTemplate. Same substitution, but
            // each :val is escaped for the quote context it actually lands in -
            // `prefix` is everything emitted before the template, and the offset
            // of the :val gives us the template's own text in between (so a
            // template like "':val'" is recognised as a quoted context even
            // though the quote is not in finalQuery). Secure mode does not need
            // this: its values travel as bind params, never as SQL text.
            const applyTemplateNs = (val, template, prefix) => {
                if (template === null || template === undefined)
                    return penumbraEscapeSnippetValue(val, penumbraSnippetQuoteState(prefix));
                return template.replace(/:val/g, (m, offset) =>
                    penumbraEscapeSnippetValue(val, penumbraSnippetQuoteState(prefix + template.substring(0, offset))));
            };

            // HELPER: Look up a per-option template (set via `options=Display:Value::Template`).
            // Returns the option's template string when the chosen value matches an entry in
            // parsedPrompt.options, otherwise null. Matched by value, so an autofill row whose
            // value happens to coincide with an options= entry will resolve to the option's
            // template - by design, since the author opted in to that collision.
            const getPerOptionTemplate = (val) => {
                if (!parsedPrompt.options || parsedPrompt.options.length === 0) return null;
                const match = parsedPrompt.options.find(opt => String(opt.value) === String(val));
                return (match && match.template !== null && match.template !== undefined) ? match.template : null;
            };
            // HELPER: Pick the template to apply for a given value - per-option override wins,
            // falls back to the prompt-level template. Used everywhere a template is applied.
            const chooseTemplate = (val) => {
                const perOpt = getPerOptionTemplate(val);
                return perOpt !== null ? perOpt : parsedPrompt.template;
            };

            // In secure mode, bind parameters (e.g. :p1) must NOT be inside quotes.
            // If the query author wrote '[PROMPT;...]' (with surrounding single quotes),
            // strip them so the bind placeholder sits outside: :p1 instead of ':p1'.
            // This is safe because bind parameters are never interpreted as SQL.
            let strippedTrailingQuote = false;
            if (secureMode && !parsedPrompt.noquote) {
                const charAfterPrompt = query[prompt.index + prompt.fullMatch.length];
                if (finalQuery.endsWith("'") && charAfterPrompt === "'") {
                    finalQuery = finalQuery.slice(0, -1);
                    strippedTrailingQuote = true;
                }
            }

            // Compute per-option-template applicability once. Used to override the
            // control-prompt (template==="") skip when any picked value has its
            // own per-option template that DOES emit SQL.
            const anyPerOptionTplTop = !isEmptyMultiSelect && Array.isArray(finalValues) && finalValues.some(v => getPerOptionTemplate(v) !== null);

            // Normalized purely for the noquote TYPE gate below. The strict
            // comparisons in the branches themselves are left untouched, so an
            // oddly-cased `type=Select` keeps its current (bind-path) behavior
            // rather than silently changing meaning on the back of a bug fix.
            const promptTypeNorm = String(parsedPrompt.type || '').trim().toLowerCase();

            if (secureMode) {
                if (parsedPrompt.template === '' && !anyPerOptionTplTop) {
                    // Pure control prompt: value drives resultif logic only, nothing
                    // is injected into SQL. Skip param creation entirely to avoid
                    // dangling bind placeholders (e.g. @P1 with no SQL context).
                } else if (parsedPrompt.noquote && (parsedPrompt.type === 'select' || parsedPrompt.type === 'boolean')) {
                    // No quote: Insert value directly into SQL (for column names, sort directions, etc.)
                    // SECURITY: Block 'text' type with noquote - free-text SQL concatenation is an injection risk.
                    // Validate that the value is from the allowed options list or matches safe-identifier pattern.
                    // NOTE: Validation runs for ALL value sources (url, stored, interactive, forced)
                    // because even interactive values can be tampered with via browser devtools.
                    const rawVal = finalValues[0] || '';
                    let isAllowed = false;
                    if (parsedPrompt.type === 'boolean') {
                        // Boolean: only the defined yes/no values are allowed
                        const yesVal = parsedPrompt.yesOption ? parsedPrompt.yesOption.value : '1';
                        const noVal = parsedPrompt.noOption ? parsedPrompt.noOption.value : '0';
                        isAllowed = (rawVal === yesVal || rawVal === noVal);
                    } else {
                        // Value passes if EITHER it's in the static options list
                        // OR it matches the safe-identifier pattern used for autofill rows.
                        // Both checks may apply when a prompt mixes autofill= with options=
                        // (e.g. `options=None:IS NULL;autofill=TBL.X`): the special option's
                        // value (`IS NULL`) is whitelisted via options, while autofill row
                        // values like `Smith, John` clear the safe-identifier regex.
                        const inStaticOptions = parsedPrompt.options && parsedPrompt.options.length > 0
                            && parsedPrompt.options.some(opt => String(opt.value) === rawVal);
                        // Autofill regex: allows column names, table names, sort directions, numbers,
                        // and common name punctuation - blocks SQL operators and keywords.
                        const safeChars = /^[A-Za-z0-9_.\-\s]+$/.test(rawVal);
                        const sqlKeywords = /\b(UNION|SELECT|INSERT|UPDATE|DELETE|DROP|ALTER|CREATE|EXEC|EXECUTE|INTO|FROM|WHERE|HAVING|ORDER|GROUP|TRUNCATE|GRANT|REVOKE)\b/i;
                        const passesAutofillCheck = !!parsedPrompt.autofill && safeChars && !sqlKeywords.test(rawVal);
                        isAllowed = inStaticOptions || passesAutofillCheck;
                    }
                    if (!isAllowed) {
                        throw new Error(`Invalid value for noquote prompt '${parsedPrompt.message || parsedPrompt.name}': value not in allowed options.`);
                    }
                    // Apply template if set (e.g. template="OR DEPARTMENT = :val").
                    // The empty-template "control prompt" case is already handled above.
                    // chooseTemplate() prefers a per-option override (`Display:Value::Template`)
                    // when the picked value matches a static options entry - useful for
                    // "All" / "None" entries that need different SQL shapes than autofill rows.
                    finalQuery += applyTemplate(rawVal, chooseTemplate(rawVal));
                } else if (parsedPrompt.noquote && promptTypeNorm !== 'select' && promptTypeNorm !== 'boolean') {
                    // noquote is only HONORED by the branch above. On every other type
                    // it used to be dropped in silence and the answer fell through to
                    // the bind path below - harmless in a value slot, fatal in an
                    // identifier slot, and impossible to diagnose from the symptom:
                    // `FROM :p1` reaches the driver as `FROM @P1` and MS-SQL reports
                    // 1087 "Must declare the table variable @P1" (Oracle: ORA-00903).
                    // Neither error mentions the prompt, the type, or noquote.
                    //
                    // The builder dialog already disables the No Quote checkbox for
                    // these types, so this only fires for tags hand-written in the SQL
                    // editor. Mirrored server-side by penumbraNoQuoteTypeError()
                    // (shared_logic.php) for the ?json=1 and scheduler engines - keep
                    // the three messages in sync.
                    throw new Error(`Prompt '${parsedPrompt.message || parsedPrompt.name || '?'}' uses noquote with type=${promptTypeNorm || 'text'}, which is not supported. A noquote answer is spliced into the SQL unquoted, so it only works with type=select or type=boolean - types whose allowed values are fixed by the report author and can be checked before the splice. Fix: change the prompt to type=select with an options= list (e.g. options=COLLEGES,DEPARTMENT_CENTER), or remove noquote so the answer binds as a value. Note that a bound value can never be a table or column name - only a value.`);
                } else if (_isDrPrompt) {
                    // TWO binds from one prompt. Bare, the tag becomes ":pA AND :pB"
                    // so the author's own BETWEEN completes; a template places
                    // :from / :to itself (:val = the bare pair). The values are the
                    // resolved DD-MON-YY literals - query.php reformats each bind
                    // for the connection it lands on, exactly as for type=date.
                    params.push(drRange.from);
                    const drFromTok = `:p${params.length}`;
                    params.push(drRange.to);
                    const drToTok = `:p${params.length}`;
                    finalQuery += penumbraApplyDateRangeTemplate(parsedPrompt.template, drFromTok, drToTok);
                } else {
                    const placeholders = [];

                    if (isEmptyMultiSelect) {
                        params.push(null);
                        placeholders.push(`:p${params.length}`);
                    } else {
                        finalValues.forEach(val => {
                            params.push(val);
                            placeholders.push(`:p${params.length}`);
                        }
                        );
                    }

                    if (parsedPrompt.type === 'multi-select') {
                        const beforePrompt = query.substring(0, prompt.index);
                        // <operand> <operator> in front of the tag (readOperatorBefore,
                        // above). Read from the query as written but cut off finalQuery by
                        // LENGTH below - the same text, because the reader refuses an
                        // operand that holds an earlier (already resolved) tag. Without the
                        // opening quote of a pair stripped above: c = '[PROMPT]' reads like
                        // c = [PROMPT] (it ran as c = :p1, :p2), as finalQuery already does.
                        const operatorMatch = readOperatorBefore(strippedTrailingQuote ? beforePrompt.slice(0, -1) : beforePrompt);
                        // Look ahead to see if IS NULL / IS NOT NULL follows the prompt -
                        // past the closing quote of a pair stripped above: '[PROMPT]' IS NULL.
                        const afterPrompt = query.substring(prompt.index + prompt.fullMatch.length + (strippedTrailingQuote ? 1 : 0));
                        const isNullCheck = /^\s*IS\s+(?:NOT\s+)?NULL\b/i.test(afterPrompt);
                        // If ANY picked value carries a per-option template, the homogeneous
                        // shortcuts below (operatorMatch shortcut + prompt-level prefix
                        // hoisting) don't fit - different values may produce different SQL
                        // shapes. Bypass to a per-value template loop.
                        const anyPerOptionTpl = !isEmptyMultiSelect && finalValues.some(v => getPerOptionTemplate(v) !== null);
                        if (operatorMatch && !isEmptyMultiSelect && !anyPerOptionTpl) {
                            const fullColumn = operatorMatch.operand;
                            const operator = operatorMatch.operator;
                            // AND after != / <> / NOT LIKE - joined with OR, a list of
                            // exclusions is true for every row - else OR; an explicit
                            // logic=and / logic=or wins (NOT LIKE + logic=or = "not both").
                            // Twin of penumbraPromptJoin() in shared_logic.php.
                            const negated = operator === '!=' || operator === '<>' || operator === 'NOT LIKE';
                            const connector = parsedPrompt.logic === 'and' ? ' AND '
                                : (parsedPrompt.logic === 'or' ? ' OR ' : (negated ? ' AND ' : ' OR '));
                            let replacement;

                            if (operator === 'IN' || operator === 'NOT IN') {
                                // KEEP the operand. operatorMatch[0] - cut off the end of
                                // finalQuery below - is "<column> IN ", so putting back only
                                // "IN (...)" dropped the column: WHERE c IN [PROMPT] ran as
                                // WHERE IN (:p1, :p2) (ORA-00936), and WHERE c NOT IN [PROMPT]
                                // - where the pattern reads NOT as the "column" - ran as
                                // WHERE c IN (...): the OPPOSITE filter, and no error at all.
                                // Both PHP engines always re-emitted it; this is the form the
                                // SQL help and the AI grounding show. (NOT IN is read as the
                                // operator itself now, so it is written back whole.)
                                replacement = `${fullColumn} ${operator} (${placeholders.join(', ')})`;
                            } else {
                                const conditions = placeholders.map(p => `${fullColumn} ${operator} ${p}`);
                                replacement = `(${conditions.join(connector)})`;
                            }
                            finalQuery = finalQuery.substring(0, finalQuery.length - operatorMatch.text.length) + replacement;
                        } else if (isNullCheck && !anyPerOptionTpl) {
                            // If checking IS NULL, only use the first placeholder.
                            // :p1 IS NULL is valid. :p1, :p2 IS NULL is invalid syntax.
                            finalQuery += applyTemplate(placeholders[0], parsedPrompt.template);
                        } else if (anyPerOptionTpl) {
                            // Per-option template path: each picked value renders with its
                            // own template (or the prompt-level fallback), and the pieces are
                            // joined by joinOptionPieces (above): one as it is, several in
                            // parens with a leading AND/OR once in front of the group - that
                            // connector belongs outside it, not on each piece (otherwise
                            // `(1=1 OR AND col = :p2)`). No pieces (every per-option template
                            // empty) emits nothing.
                            const connector = parsedPrompt.logic === 'and' ? ' AND ' : ' OR ';
                            const perValue = placeholders.map((p, i) => applyTemplate(p, chooseTemplate(finalValues[i])))
                                .filter(s => s !== '');
                            finalQuery += joinOptionPieces(perValue, parsedPrompt.template, connector);
                        } else {
                            // FIX: Multi-select with template containing :val - apply template
                            // per value to avoid producing invalid SQL.
                            // e.g., template="AND col = :val" with 3 values would produce the
                            // broken "AND col = :p1, :p2, :p3". Instead we expand to:
                            // "AND (col = :p1 OR col = :p2 OR col = :p3)"
                            if (parsedPrompt.template && placeholders.length > 1 && parsedPrompt.template.indexOf(':val') >= 0) {
                                const connector = parsedPrompt.logic === 'and' ? ' AND ' : ' OR ';
                                // Strip leading SQL connector (AND/OR) - it applies once to the whole group
                                const connMatch = parsedPrompt.template.match(/^\s*(AND|OR)\s+/i);
                                let condPart = parsedPrompt.template;
                                let sqlPrefix = '';
                                if (connMatch) {
                                    sqlPrefix = connMatch[0];
                                    condPart = parsedPrompt.template.substring(connMatch[0].length);
                                }
                                const perValue = placeholders.map(p => condPart.replace(/:val/g, p));
                                finalQuery += sqlPrefix + '(' + perValue.join(connector) + ')';
                            } else if (!parsedPrompt.template && /\bIN\s*$/i.test(finalQuery)) {
                                // Straight after IN with no parenthesis opened, the tag owes
                                // the list its own. Reached when the operand could not be read
                                // (c IN '[PROMPT]': the quote in front hides the IN from
                                // readOperatorBefore) or when nothing was picked (c IN :p1).
                                // Twin of penumbraPromptFollowsBareIn() in shared_logic.php.
                                // finalQuery, not beforePrompt: it is the SQL as it will
                                // stand, already without the opening quote of c IN '[PROMPT]'
                                // (strippedTrailingQuote, above).
                                finalQuery += '(' + placeholders.join(', ') + ')';
                            } else {
                                finalQuery += applyTemplate(placeholders.join(', '), parsedPrompt.template);
                            }
                        }
                    } else {
                        // Single-select / text / date: one placeholder, one value.
                        // chooseTemplate() picks per-option override when finalValues[0] matches
                        // an options= entry that defined `::Template`.
                        finalQuery += applyTemplate(placeholders[0], chooseTemplate(finalValues[0]));
                    }
                }
            } else {
                // Non-secure mode mirrors secure-mode handling: per-option templates
                // override the control-prompt skip, and fallback templates have
                // leading AND/OR stripped inside the per-value join.
                const nsValuesToJoin = finalValues.map(v => v === null ? 'NULL' : String(v));
                const anyPerOptionTplNs = nsValuesToJoin.some(v => getPerOptionTemplate(v) !== null);
                if (_isDrPrompt) {
                    // Snippet text is for READING, so a bare range prints as
                    // "A to B" (not the SQL pair); a template still places
                    // :from / :to, with :val = "A to B". Unanswered or a control
                    // prompt: print nothing.
                    if (drRange && parsedPrompt.template !== '') {
                        const drEsc = v => penumbraEscapeSnippetValue(v, penumbraSnippetQuoteState(finalQuery));
                        finalQuery += penumbraApplyDateRangeTemplate(parsedPrompt.template,
                            drEsc(drRange.from), drEsc(drRange.to), drEsc(drRange.from + ' to ' + drRange.to));
                    }
                } else if (parsedPrompt.template !== '' || anyPerOptionTplNs) {
                    const valuesToJoin = nsValuesToJoin;
                    const anyPerOptionTpl = anyPerOptionTplNs;
                    if (parsedPrompt.type === 'multi-select' && valuesToJoin.length > 1 && anyPerOptionTpl) {
                        // Per-option template path (mirror of secure-mode logic above).
                        // Template LOOKUPS use the raw value (an options= entry is
                        // matched by its literal value); only the substituted text is
                        // escaped. Context prefix is finalQuery for every element - the
                        // connector/paren text woven between them cannot open a quote.
                        const connector = parsedPrompt.logic === 'and' ? ' AND ' : ' OR ';
                        const perValue = valuesToJoin.map(v => applyTemplateNs(v, chooseTemplate(v), finalQuery))
                            .filter(s => s !== '');
                        finalQuery += joinOptionPieces(perValue, parsedPrompt.template, connector);
                    } else if (parsedPrompt.type === 'multi-select' && valuesToJoin.length > 1 && parsedPrompt.template && parsedPrompt.template.indexOf(':val') >= 0) {
                        // FIX: Multi-select with template - per-value expansion (mirrors secure mode fix)
                        const connector = parsedPrompt.logic === 'and' ? ' AND ' : ' OR ';
                        const connMatch = parsedPrompt.template.match(/^\s*(AND|OR)\s+/i);
                        let condPart = parsedPrompt.template;
                        let sqlPrefix = '';
                        if (connMatch) {
                            sqlPrefix = connMatch[0];
                            condPart = parsedPrompt.template.substring(connMatch[0].length);
                        }
                        const perValue = valuesToJoin.map(v => applyTemplateNs(v, condPart, finalQuery));
                        finalQuery += sqlPrefix + '(' + perValue.join(connector) + ')';
                    } else {
                        // Single value (or unified template fallback): use chooseTemplate so a
                        // per-option override on the sole picked value still applies. Each
                        // value is escaped for its landing context BEFORE the join, so the
                        // ', ' separators stay real separators.
                        const tpl = (valuesToJoin.length === 1) ? chooseTemplate(valuesToJoin[0]) : parsedPrompt.template;
                        if (valuesToJoin.length === 1) {
                            finalQuery += applyTemplateNs(valuesToJoin[0], tpl, finalQuery);
                        } else {
                            const st = penumbraSnippetQuoteState(finalQuery);
                            const joined = valuesToJoin.map(v => penumbraEscapeSnippetValue(v, st)).join(', ');
                            // Values are pre-escaped, so pass the joined text through
                            // the plain (non-escaping) template applier.
                            finalQuery += applyTemplate(joined, tpl);
                        }
                    }
                }
                // else: empty template control prompt - skip injection in non-secure mode too
            }

            // --- Store resolved value for data(promptN) ---
            let finalDisplayValue = 'undefined';
            if (Array.isArray(dataForQuery)) {
                finalDisplayValue = dataForQuery.map(item => item.display || item.value).join(', ');
            } else if (dataForQuery && dataForQuery.display !== null && dataForQuery.display !== undefined) {
                finalDisplayValue = dataForQuery.display;
            } else if (dataForQuery && dataForQuery.value !== null && dataForQuery.value !== undefined) {
                finalDisplayValue = dataForQuery.value;
            }
            // data(promptN) is POSITIONAL: one slot per prompt, in SQL order.
            // The same tag written twice (a UNION) is ONE prompt - one dialog,
            // one pill - so one slot, at its first place; a second copy used to
            // push a second slot here and shift every later number on screen
            // only (the scheduler never did). A date range takes TWO slots, From
            // then To - the two date prompts it replaces - so a snippet written
            // for those (date_diff(data(prompt2), data(prompt1), days)) keeps
            // working unchanged after the swap, and every later prompt keeps its
            // number. Its pill still reads "A to B", the dates that RAN, not the
            // label: a header saying "Last month" means nothing in November.
            // Scheduler twin: $resolvedList in process_scheduler_prompts().
            if (!_seenPromptKeys.has(storageKey)) {
                _seenPromptKeys.add(storageKey);
                if (drRange) {
                    allResolvedPrompts.push(drRange.from, drRange.to);
                } else {
                    allResolvedPrompts.push(finalDisplayValue);
                }
            }

            lastIndex = prompt.index + prompt.fullMatch.length;
            // If we stripped the leading quote before the prompt, also skip the trailing quote after it
            if (strippedTrailingQuote) {
                lastIndex += 1;
            }
        }

        finalQuery += query.substring(lastIndex);
        return secureMode ? {
            query_template: finalQuery,
            params: params,
            anyPromptWasInteractive: anyPromptWasInteractive
        } : finalQuery;
    }

