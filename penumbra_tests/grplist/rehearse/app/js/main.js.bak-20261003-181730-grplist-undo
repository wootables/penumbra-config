    // --- Real-time validation for the Server Short ID input ---
    let serverIdCheckTimeout;
    $(document).on('input', '#serverSaveIdInput', function () {
        clearTimeout(serverIdCheckTimeout);
        const $input = $(this);
        const $statusBox = $('#serverSaveStatus');
        const $overwriteContainer = $('#serverSaveOverwriteContainer');
        const $overwriteCheckbox = $('#serverSaveOverwriteCheckbox');
        const $saveButton = $('#confirmServerSaveBtn');

        const shortId = $input.val().trim();

        // Get the ID the page was loaded with, if any
        const urlParams = new URLSearchParams(window.location.search);
        const currentId = urlParams.get('id');

        $statusBox.hide().empty().removeClass('save-success save-error');
        $input.removeAttr('aria-invalid');
        if ($input.attr('aria-describedby') === 'serverSaveStatus') $input.removeAttr('aria-describedby');

        // The copy banner names one specific reserved id, so hand-editing this field
        // would make it lie: drop back to a normal save and let the checks below run.
        // (Only real typing reaches here - jQuery .val() fires no input event, so
        // arming copy mode doesn't trip this.)
        if (_serverSaveCopyMode) _serverSaveSetCopyMode(false);

        if (!shortId) {
            $saveButton.prop('disabled', true);
            $overwriteContainer.hide();
            return;
        }

        // --- Simple client-side validation for URL safety ---
        if (!/^[a-z0-9-_]+$/i.test(shortId)) {
            $statusBox.text('Error: Short ID can only contain letters, numbers, hyphens (-), and underscores (_).').addClass('save-error').show();
            $input.attr('aria-invalid', 'true').attr('aria-describedby', 'serverSaveStatus');
            $saveButton.prop('disabled', true);
            $overwriteContainer.hide();
            return;
        }

        $saveButton.prop('disabled', true);
        // Disable while checking
        $statusBox.text('Checking availability...').removeClass('save-error save-success').show();

        serverIdCheckTimeout = setTimeout(async () => {
            const data = await checkServerId(shortId);

            if (data.error) {
                $statusBox.text(`Error: ${data.error}`).addClass('save-error').show();
                $input.attr('aria-invalid', 'true').attr('aria-describedby', 'serverSaveStatus');
                return;
            }

            if (data.exists) {
                // ID exists. Is it the one we are currently editing?
                if (currentId && shortId.toLowerCase() === currentId.toLowerCase()) {
                    $statusBox.text('This will update the current report.').addClass('save-success').show();
                    $overwriteContainer.find('strong').text(currentId);
                    $overwriteContainer.show();
                    $overwriteCheckbox.prop('checked', true);
                    // Default to overwrite
                    $saveButton.prop('disabled', false);
                    // Allow saving
                } else {
                    // It's a different, existing report
                    $statusBox.text('This ID is already in use. Confirm Overwrite.').addClass('save-error').show();
                    $overwriteContainer.find('strong').text(shortId);
