                    }

                    // Badge class + label maps live at module scope now (the
                    // Changes list and Pulse action-mix share them).
                    const actionBadgeClass = _auditBadgeClass;
                    const actionLabel = _auditActionLabel;

                    let tableHtml = '<table class="audit-log-table">';
                    tableHtml += `<thead>
                    <tr>
                        <th scope="col" tabindex="0" aria-sort="none" data-sort-type="time" style="width: 122px;">Time <span class="sort-icon" aria-hidden="true">&#9650;&#9660;</span></th>
                        <th scope="col" tabindex="0" aria-sort="none" data-sort-type="text" style="width: 120px;">Action <span class="sort-icon" aria-hidden="true">&#9650;&#9660;</span></th>
                        <th scope="col" tabindex="0" aria-sort="none" data-sort-type="text" style="width: 95px;">User <span class="sort-icon" aria-hidden="true">&#9650;&#9660;</span></th>
                        <th scope="col" tabindex="0" aria-sort="none" data-sort-type="text">What happened <span class="sort-icon" aria-hidden="true">&#9650;&#9660;</span></th>
                    </tr>
                </thead>`;
                    tableHtml += '<tbody>';

                    response.data.forEach(log => {
                        let sourceInfo = '<span style="opacity:0.4;">-</span>';
                        let sourceSortKey = '';
                        const ctxChips = [];   // {t, title} - IP / browser / referrer context
                        let ipVal = '';

                        if (log.SOURCE_DATA) {
                            if (log.SOURCE_DATA.error) {
                                sourceInfo = `<span class="audit-msg-err" style="font-family: monospace; font-size: 10px;">${escapeHtml(log.SOURCE_DATA.message)}</span>`;
                                sourceSortKey = log.SOURCE_DATA.message || '';
                            } else if (log.ACTION.startsWith('SCHEDULE')) {
                                const msg = log.SOURCE_DATA.message || '';
                                const d = log.SOURCE_DATA;
                                const parts = [];

