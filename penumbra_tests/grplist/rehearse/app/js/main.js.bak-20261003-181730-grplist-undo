    /**
     * Split a raw recipient string into individual address tokens.
     *
     * Covers every shape the recipients box can end up holding: a semicolon
     * list (Outlook habit), a comma list (Gmail habit), a newline-separated
     * paste out of a spreadsheet column, and the "Name <addr>" form - whose
     * internal spaces have to survive, which is why the whitespace split only
     * runs on chunks with no angle bracket in them.
     */
    function splitRecipientTokens(raw) {
        const out = [];
        String(raw == null ? '' : raw).split(/[;\r\n]+/).forEach(function (chunk) {
            // A display name can itself contain a comma ("Doe, John <a@x.edu>"),
            // so ',' only separates in chunks carrying no angle-bracket address.
            // Splitting on ',' up front shatters exactly those names. Mirrors
            // the same rule in share.php.
            const pieces = chunk.indexOf('<') !== -1 ? [chunk] : chunk.split(',');
            pieces.forEach(function (piece) {
                piece = piece.trim();
                if (!piece) return;
                if (piece.indexOf('<') !== -1) { out.push(piece); return; }
                piece.split(/\s+/).forEach(function (tok) { if (tok) out.push(tok); });
            });
        });
        return out;
    }

    /**
     * Does this look like an address share.php's filter_var pass will accept?
     *
     * Deliberately STRICTER than the loose "has @ and has ." test the tokenizer
     * uses. The two answer different questions: the tokenizer decides whether
     * typed text becomes a capsule at all, this decides whether that capsule
     * will survive the server - and a capsule that does not survive is the
     * silently-dropped recipient we are trying to make impossible.
     */
    /**
     * Would the SCHEDULER accept this recipient? Mirrors
     * penumbraParseSchedulerRecipients() in db_connection.php, which mirrors
     * schedule_runner.php.
     *
     * Deliberately LOOSER than penumbraLooksLikeEmail(): the scheduler resolves a
     * bare ALPHANUMERIC Unity ID to <id>@ncsu.edu at send time, so 'bplimon' is a
     * real recipient there and share.php's path would reject it. Saved tasks load
     * those straight into capsules, so validating the scheduler with the stricter
     * rule would flag recipients that have been working for months.
     */
    function penumbraSchedulerRecipientOk(addr) {
        const a = String(addr == null ? '' : addr).trim();
        if (/^[a-zA-Z0-9]+$/.test(a)) return true;
        return penumbraLooksLikeEmail(a);
    }

    function penumbraLooksLikeEmail(addr) {
        return /^[^\s@<>,;]+@[^\s@<>,;.]+(\.[^\s@<>,;.]+)+$/.test(String(addr == null ? '' : addr).trim());
    }

    /**
     * Commit whatever the user typed but never turned into a capsule.
     *
     * The recipients box only ever SENT capsules: syncEmailHiddenInput() and the
     * scheduler's save handler both read `.email-capsule`, so text still sitting
     * in the input at send/save time was dropped without a word. Nothing
     * surfaced it either - your own address is added as a capsule when the
     * dialog opens, so the "at least one recipient" guard still passed, and the
     * success toast named the first recipient, which is always you.
     *
     * Called from blur, from paste, and again from the send/save handlers -
     * focus may not be in the input at all when the button is clicked.
     *
     * Returns the leftover text that did NOT look like an address; it is left in
     * the input so the user can see it was not accepted.
     */
    function commitPendingRecipients(inputSel, containerSel) {
        const $input = $(inputSel);
        if (!$input.length) return '';
        const raw = ($input.val() || '').trim();
        if (!raw) return '';
        const leftover = [];
        splitRecipientTokens(raw).forEach(function (tok) {
            // Same loose shape test the keydown tokenizer applies, so typing an
            // address and blurring behaves exactly like typing it and pressing
            // Enter. Anything malformed that gets past it is caught by the
            // stricter check in the send handler, before the dialog closes.
            if (tok.indexOf('@') !== -1 && tok.indexOf('.') !== -1) {
                addEmailCapsule(tok, null, containerSel, inputSel);
            } else {
                leftover.push(tok);
            }
        });
        const rest = leftover.join(' ');
        $input.val(rest);
        return rest;
    }
    window.commitPendingRecipients = commitPendingRecipients;

    // Tokenize on blur as well as on the separator keys. Clicking Send (or the
    // scheduler's Save) blurs the input first, so this is what rescues an
    // address that was typed and never had Enter pressed on it. Clicking a
    // jQuery UI autocomplete suggestion does NOT blur the input - the widget
    // preventDefaults its menu mousedown to keep focus - so this cannot race
    // the select handler.
    $(document).on('blur.recipcommit', '#emailInputReal', function () {
