    /**
 * Checks for visible columns and toggles the results table or a placeholder.
 * This FINAL version uses the unified isAdmin flag from the server.
 */
    function toggleNoColumnsMessage() {
        // If the user is NOT an admin, ensure the correct elements are visible and exit.
        if (!penumbra_vars.isAdmin) {
            $('#resultsPlaceholder').hide();
            $('#resultsHeader').show();
            // FIX: Ensure wrapper is visible for users
            $('#results-wrapper').show();
            if ($('#groupActionsContainer').is(':visible')) {
                $('#groupedResultsContainer').show();
                $('#resultsTable').hide();
            } else {
                $('#resultsTable').show();
                $('#groupedResultsContainer').hide();
            }
            return;
        }

        // Check inline style instead of :visible - :visible fails when a parent (e.g. #resultsTable)
        // is temporarily hidden during state loading (grouped/pivot modes), returning 0 even though
        // columns ARE selected. This matches the pattern at line ~22857.
        const visibleColumnCount = $('#tableHeader th[data-colname]').not('[data-column="#"]').filter(function() { return this.style.display !== 'none'; }).length;
        const $placeholder = $('#resultsPlaceholder');
        const $resultsTable = $('#resultsTable');
        const $groupedContainer = $('#groupedResultsContainer');
        const $resultsHeader = $('#resultsHeader');
        const $wrapper = $('#results-wrapper');
        // <--- FIX: Target the wrapper

        if (visibleColumnCount === 0) {
            $resultsTable.hide();
            $groupedContainer.hide();
            $resultsHeader.hide();
            $wrapper.hide();
            // <--- FIX: Hide wrapper to prevent scrollbars
            $placeholder.show();
        } else {
            $placeholder.hide();
            $resultsHeader.show();
            $wrapper.show();
            // <--- FIX: Restore wrapper

            if ($('#groupActionsContainer').is(':visible')) {
                $groupedContainer.show();
                $resultsTable.hide();
            } else {
                $resultsTable.show();
                $groupedContainer.hide();
            }
        }
    }
    /**
 * Decodes HTML entities in a string (e.g., '&amp;' becomes '&').
 * PERF: Uses a static lookup map instead of document.createElement('textarea').
 * The old approach created a new DOM element per call - catastrophic at 1M+ calls
 * during search/filter on large tables. This regex approach is ~100x faster.
 * @param {string} text The string to decode.
 * @returns {string} The decoded string.
 */
    const _entityMap = {'amp':'&','lt':'<','gt':'>','quot':'"','apos':"'",'nbsp':' '};
    function decodeHtmlEntities(text) {
        if (typeof text !== 'string')
            return text;
        // Fast path: skip regex if no ampersand (vast majority of cells)
        if (text.indexOf('&') === -1)
            return text;
        return text.replace(/&(amp|lt|gt|quot|apos|nbsp|#(\d+)|#x([0-9a-fA-F]+));/g, function(match, name, dec, hex) {
            if (dec) return String.fromCharCode(parseInt(dec, 10));
            if (hex) return String.fromCharCode(parseInt(hex, 16));
            return _entityMap[name] || match;
        });
    }

    /**
 * Retrieves the full object and context (index/URL) for any item clicked 
 * in the Favorites list by looking up its type and name in the original source arrays.
 * * @param {string} type - The original type ('table', 'state', 'server-report').
 * @param {string} name - The unique name/short_id of the item.
 * @returns {object|null} The original data object plus relevant context properties.
 */
    function getFavoriteItemData(type, name) {
        // FIX: Re-sort or fetch original arrays to find index/data reliably.
        const savedQueries = JSON.parse(localStorage.getItem("savedQueries") || "[]");
        const orderedStates = savedQueries.sort((a, b) => a.name.localeCompare(b.name));

        switch (type) {
            case 'table':
                // Tables don't need extra data, just their name and type are enough to pass to handlers.
                return {
                    name,
                    type
                };

            case 'state':
                const localStateData = orderedStates.find(sq => sq.name === name);
                if (localStateData) {
                    const originalIndex = savedQueries.findIndex(sq => sq.name === name);
                    return {
                        ...localStateData,
                        type,
                        originalIndex
                    };
                }
                return null;

            case 'server-report':
                // For server reports, we assume the name (Short ID) is the unique identifier
                // and we need to fetch the full data (title) for the tooltip/display.

                // NOTE: A full server report lookup is too heavy for a simple hover.
                // For now, we only return the name, and the tooltip will show the name.
                return {
                    name,
                    type,
                    url: window.location.href.split("?")[0] + `?id=${name}`
                };

            default:
                return null;
        }
    }

