        $dialog.on('click', function(ev) {
            if ($(ev.target).hasClass('infobox-overlay')) closeDialog();
        });

        // Tab switching
        $dialog.on('click', '.table-info-tab', function() {
            var tabId = $(this).data('tab');
            $dialog.find('.table-info-tab').removeClass('active');
            $(this).addClass('active');
            $dialog.find('.table-info-panel').removeClass('active');
            $dialog.find('.table-info-panel[data-panel="' + tabId + '"]').addClass('active');
            loadTab(tabId);
        });

        // Render a result table matching the infobox drill-down table structure (with sorting)
        function renderResultTable(columns, rows) {
            if (!columns || columns.length === 0) {
                return '<div class="ti-empty">No data found.</div>';
            }

            var thStyle = 'text-align:left; padding:6px 10px; border-bottom:2px solid var(--border-color); white-space:nowrap; cursor:pointer; user-select:none;';
            var html = '<table class="infobox-drill-table" style="width:100%; border-collapse:collapse; font-size:13px; color:var(--text-main);">';
            html += '<thead><tr>';
            for (var ci = 0; ci < columns.length; ci++) {
                // Determine sort type - detect numeric columns by checking first non-null value
                var sortType = 'text';
                for (var si = 0; si < rows.length; si++) {
                    var sample = rows[si][columns[ci]];
                    if (sample != null && String(sample).trim() !== '') {
                        var stripped = String(sample).replace(/[,$%\s]/g, '');
                        if (!isNaN(parseFloat(stripped)) && isFinite(stripped)) {
                            sortType = 'number';
                        }
                        break;
                    }
                }
                html += '<th scope="col" style="' + thStyle + '" data-sort-type="' + sortType + '">' + escapeHtml(columns[ci]) + ' <span class="sort-icon" aria-hidden="true">&#9650;&#9660;</span></th>';
            }
            html += '</tr></thead><tbody>';

            for (var ri = 0; ri < rows.length; ri++) {
                html += '<tr>';
                for (var ci2 = 0; ci2 < columns.length; ci2++) {
                    var val = rows[ri][columns[ci2]];
                    var displayVal = escapeHtml(val == null ? '' : String(val));
                    var tdStyle = 'padding:5px 10px; border-bottom:1px solid var(--border-color); white-space:nowrap;';

                    // Compute sort value
                    var sortVal;
                    var plainText = String(val == null ? '' : val).trim();
                    var stripped2 = plainText.replace(/[,$%\s]/g, '');
                    if (!isNaN(parseFloat(stripped2)) && isFinite(stripped2)) {
                        sortVal = String(parseFloat(stripped2));
                    } else {
                        sortVal = plainText;
                    }

                    html += '<td style="' + tdStyle + '" data-sort-val="' + escapeHtml(sortVal) + '">' + displayVal + '</td>';
                }
                html += '</tr>';
            }

            html += '</tbody></table>';
            html += '<div class="ti-row-count">' + rows.length + ' row' + (rows.length !== 1 ? 's' : '') + '</div>';
            return html;
        }

        // Render the Details panel: the table-level comment/description shown
        // prominently (this is where the PENUMBRA_DBDUMP ownership marker appears
        // on Oracle DB_DUMP tables), followed by a property/value metadata table.
        function renderDetails(comment, properties) {
            var html = '<div class="ti-details-section">';
            html += '<div class="ti-details-label">Table Comment</div>';
            if (comment != null && String(comment).trim() !== '') {
                html += '<pre class="ti-comment">' + escapeHtml(String(comment)) + '</pre>';
            } else {
                html += '<div class="ti-empty" style="padding:8px 0; margin:0;">No comment / description set on this table.</div>';
            }
            html += '</div>';

            if (properties && properties.length) {
                html += '<table class="ti-details-table">';
                html += '<tbody>';
                for (var i = 0; i < properties.length; i++) {
                    var p = properties[i];
                    var val = (p.value == null || String(p.value).trim() === '') ? '-' : String(p.value);
                    html += '<tr>';
                    html += '<th>' + escapeHtml(p.label) + '</th>';
                    html += '<td>' + escapeHtml(val) + '</td>';
                    html += '</tr>';
                }
                html += '</tbody></table>';
            }
            return html;
        }

        // Cache original rows and bind sort handler after a table renders in a panel
        function initTableSort($panel) {
            setTimeout(function() {
                $panel.find('.infobox-drill-table').each(function() {
                    var $tb = $(this).find('tbody');
                    if (!$tb.data('original-rows')) {
                        $tb.data('original-rows', $tb.find('tr').get());
                    }
                });
            }, 50);
        }

        // Self-contained sort handler scoped to this dialog
        $dialog.on('click', '.infobox-drill-table thead th', function(e) {
            // Shared engine with the document-level drill delegate. This local
            // binding exists because the dialog can follow the admin console into
            // its pop-out window, where document-level delegates from the main
            // document never fire. stopPropagation so that when the dialog IS in
            // the main document, the document-level delegate doesn't also fire
            // and advance the sort a second step per click.
            e.stopPropagation();
            penumbraDrillTableSort($(this), !!e.shiftKey);
        });
        // Local twin of the document-level shift-selection guard, for the same
        // pop-out reason as the click delegate above.
        $dialog.on('mousedown', '.infobox-drill-table thead th', function(e) {
            if (e.shiftKey) e.preventDefault();
        });

        // Load tab data
        function loadTab(tabId) {
            if (loadedTabs[tabId]) return; // already loaded
            loadedTabs[tabId] = true;

            var $panel = $dialog.find('.table-info-panel[data-panel="' + tabId + '"]');

            if (tabId === 'ddl') {
                $.ajax({
                    url: 'manage_table_info.php',
                    data: { action: 'ddl', table: tableName, db: db },
                    type: 'GET',
                    dataType: 'json',
                    timeout: 30000,
                    success: function(resp) {
                        if (resp.status === 'ok' && resp.ddl) {
                            $panel.html('<pre class="ti-ddl">' + escapeHtml(resp.ddl) + '</pre>');
                        } else {
                            $panel.html('<div class="ti-empty">' + escapeHtml(resp.message || 'No DDL cache entry found.') + '</div>');
                        }
                    },
                    error: function(xhr) {
                        if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                        $panel.html('<div class="ti-error">Failed to load DDL cache.</div>');
                    }
                });
            } else if (tabId === 'details') {
                $.ajax({
                    url: 'manage_table_info.php',
                    data: { action: 'details', table: tableName, db: db },
                    type: 'GET',
                    dataType: 'json',
                    timeout: 30000,
                    success: function(resp) {
                        if (resp.status === 'ok') {
                            $panel.html(renderDetails(resp.comment, resp.properties));
                        } else {
                            $panel.html('<div class="ti-error">' + escapeHtml(resp.message || 'An error occurred.') + '</div>');
                        }
                    },
                    error: function(xhr) {
                        if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                        $panel.html('<div class="ti-error">Failed to load details. Server returned status ' + xhr.status + '.</div>');
                    }
                });
            } else {
                // stats, permissions, constraints, indexes - all return columns+rows
                $.ajax({
                    url: 'manage_table_info.php',
                    data: { action: tabId, table: tableName, db: db },
                    type: 'GET',
                    dataType: 'json',
                    timeout: 30000,
                    success: function(resp) {
                        if (resp.status === 'ok') {
                            if (!resp.columns || resp.columns.length === 0) {
                                var emptyMsg = (tabId === 'referencedby')
                                    ? 'No other tables reference this table (no inbound foreign keys).'
                                    : 'No ' + tabId + ' data found for this table.';
                                $panel.html('<div class="ti-empty">' + emptyMsg + '</div>');
                            } else {
                                $panel.html(renderResultTable(resp.columns, resp.rows));
                                initTableSort($panel);
                            }
                        } else {
                            $panel.html('<div class="ti-error">' + escapeHtml(resp.message || 'An error occurred.') + '</div>');
                        }
                    },
                    error: function(xhr) {
                        if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                        $panel.html('<div class="ti-error">Failed to load ' + tabId + ' data. Server returned status ' + xhr.status + '.</div>');
                    }
                });
            }
        }

        // Load the initial tab
        loadTab(initialTab);
    }

    /**
     * Shows the cached DDL (CREATE TABLE statement) for a table or import in
     * an infobox dialog. For Oracle / MS-SQL tables it fetches the relevant
     * cache/ddl_*.txt file and extracts the block for the requested table.
     * For imported data sources it synthesises a pseudo-DDL from the in-memory
     * (or server-fetched) row data.
     *
     * @param {string} name      - Table or import name
     * @param {string} sourceType - 'oracle' | 'mssql' | 'imported'
     */
    function showDdlCache(name, sourceType) {
        if (sourceType === 'imported') {
            _showImportDdl(name);
            return;
        }

        // Determine cache file
        var cacheFile = (sourceType === 'mssql') ? 'cache/ddl_mssql.txt' : 'cache/ddl_oracle.txt';

        $.ajax({
            url: cacheFile,
            type: 'GET',
            dataType: 'text',
            cache: true,
            timeout: 15000,
            success: function (text) {
                var ddl = _extractTableDdl(text, name);
                if (!ddl) {
                    show_text('<p id="undo_text"><span style="color: orange">INFO:</span> No DDL cache entry found for "' + escapeHtml(name) + '".</p>');
                    return;
                }
                showInfoboxDialog({
                    title: 'DDL Cache - ' + name,
                    content: '<pre style="white-space:pre-wrap;word-break:break-word;font-size:12px;line-height:1.5;margin:0;">' + escapeHtml(ddl) + '</pre>',
                    mode: 'raw'
                });
            },
            error: function (xhr) {
                if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                show_text('<p id="undo_text"><span style="color: red">ERROR:</span> Failed to load DDL cache file.</p>');
            }
        });
    }

    /**
     * Extracts a single CREATE TABLE block from the full DDL cache text.
     * Each block starts with "-- Table: NAME" and ends just before the next
     * "-- Table:" line (or end-of-file).
     *
     * @param {string} fullText  - Entire cache file content
     * @param {string} tableName - Table to find (case-insensitive)
     * @returns {string|null}    - The DDL block or null if not found
     */
    function _extractTableDdl(fullText, tableName) {
        var upper = tableName.toUpperCase();
        var lines = fullText.split('\n');
        var capturing = false;
        var result = [];

        for (var i = 0; i < lines.length; i++) {
            var line = lines[i];
            // Match "-- Table: NAME" or "-- Table: SCHEMA.NAME"
            var marker = line.match(/^--\s*Table:\s*(.+)/i);
            if (marker) {
                if (capturing) break; // hit the next table - stop
                var markerName = marker[1].trim().toUpperCase();
                // Match full name or just the part after schema dot
                if (markerName === upper || markerName.split('.').pop() === upper) {
                    capturing = true;
                }
            }
            if (capturing) {
                result.push(line);
            }
        }
        return result.length > 0 ? result.join('\n').trim() : null;
    }

    /**
     * Generates a pseudo-DDL for an imported data source by inspecting
     * column names and sampling values to infer types.
     */
    function _showImportDdl(importName) {
        // Try client-side data first (case-insensitive)
        var rows = window._penumbraImportedData[importName];
        if (!rows) {
            var upperName = importName.toUpperCase();
            var keys = Object.keys(window._penumbraImportedData || {});
            for (var ki = 0; ki < keys.length; ki++) {
                if (keys[ki].toUpperCase() === upperName) { rows = window._penumbraImportedData[keys[ki]]; break; }
            }
        }

        if (rows && rows.length > 0) {
            _renderImportDdl(importName, rows);
            return;
        }

        // Fetch from server
        var meta = window._penumbraImportMeta[importName];
        var importId = (window._penumbraImportIds || {})[importName] || (meta && meta.id);
        if (!importId) {
            show_text('<p id="undo_text"><span style="color: orange">INFO:</span> No data found for "' + escapeHtml(importName) + '".</p>');
            return;
        }

        $.ajax({
            url: 'manage_imports.php?action=load&id=' + encodeURIComponent(importId),
            type: 'GET',
            dataType: 'json',
            timeout: 60000,
            success: function (resp) {
                if (resp && resp.status === 'success' && resp.import_data) {
                    var serverRows;
                    try {
                        serverRows = typeof resp.import_data === 'string'
                            ? JSON.parse(resp.import_data) : resp.import_data;
                    } catch (e) {
                        show_text('<p id="undo_text"><span style="color: red">ERROR:</span> Failed to parse import data.</p>');
                        return;
                    }
                    if (Array.isArray(serverRows) && serverRows.length > 0) {
                        window._penumbraImportedData[importName] = serverRows;
                        _renderImportDdl(importName, serverRows);
                    } else {
                        show_text('<p id="undo_text"><span style="color: orange">INFO:</span> Import "' + escapeHtml(importName) + '" has no rows.</p>');
                    }
                }
            },
            error: function (xhr) {
                if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                show_text('<p id="undo_text"><span style="color: red">ERROR:</span> Failed to load import data.</p>');
            }
        });
    }

    /**
     * Renders a pseudo-DDL for imported data by inspecting columns + sampling
     * the first 100 rows to infer types and max lengths.
     */
    function _renderImportDdl(importName, rows) {
        var cols = Object.keys(rows[0]);
        var sampleSize = Math.min(rows.length, 100);
        var colDefs = [];

        for (var ci = 0; ci < cols.length; ci++) {
            var col = cols[ci];
            var maxLen = 0;
            var allNumeric = true;
            var allInt = true;
            var hasDecimal = false;
            var allEmpty = true;

            for (var ri = 0; ri < sampleSize; ri++) {
                var val = rows[ri][col];
                if (val === null || val === undefined || val === '') continue;
                allEmpty = false;
                var s = String(val);
                if (s.length > maxLen) maxLen = s.length;
                if (allNumeric && isNaN(Number(s))) allNumeric = false;
                if (allNumeric && s.indexOf('.') !== -1) { allInt = false; hasDecimal = true; }
            }

            var typeDef;
            if (allEmpty) {
                typeDef = 'VARCHAR2(' + (maxLen || 255) + ')';
            } else if (allNumeric && allInt) {
                typeDef = 'NUMBER';
            } else if (allNumeric && hasDecimal) {
                typeDef = 'NUMBER(*, 2)';
            } else {
                typeDef = 'VARCHAR2(' + Math.max(maxLen, 1) + ')';
            }
            colDefs.push('    ' + col + ' ' + typeDef);
        }

        var ddl = '-- Imported Data Source: ' + importName
            + '\n-- Rows: ' + rows.length + '  |  Columns: ' + cols.length
            + '\n-- (Types inferred from first ' + sampleSize + ' rows)'
            + '\nCREATE TABLE ' + importName + ' (\n'
            + colDefs.join(',\n')
            + '\n);';

        showInfoboxDialog({
            title: 'DDL - ' + importName + ' (Import)',
            content: '<pre style="white-space:pre-wrap;word-break:break-word;font-size:12px;line-height:1.5;margin:0;">' + escapeHtml(ddl) + '</pre>',
            mode: 'raw'
        });
    }

    /**
 * Routes actions originating from the "All Favorites" list.
 */
    function handleFavoriteAction(action, itemElement, e) {
        const $item = $(itemElement);
        const type = $item.data('type');
        const name = $item.data('name');
        const fullData = getFavoriteItemData(type, name);

        if (!fullData) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Favorite data is corrupt or not found in source.</p>");
            return;
        }

        // --- 1. Normalize "Open" actions based on clicks ---
        if (action === 'open-state' || action === 'open-server-report') {
            if (e && e.shiftKey) {
                action = 'open-new';
            } else if (e && e.type === 'dblclick') {
                action = 'open-here';
            } else {
                action = 'open-here';
            }
        }

        // --- 2. DELETION LOGIC ---
        if (action === 'delete-favorite') {
            if (type === 'server-report') {
                let rawFavs = JSON.parse(localStorage.getItem("penumbra_favorite_server_reports") || "[]");
                const newFavs = rawFavs.filter(item => {
                    const id = (typeof item === 'object') ? item.id : item;
                    return id !== name;
                }
                );
                localStorage.setItem("penumbra_favorite_server_reports", JSON.stringify(newFavs));
            } else if (type === 'state') {
                let favorites = new Set(JSON.parse(localStorage.getItem("penumbra_favorite_states") || "[]"));
                favorites.delete(name);
                localStorage.setItem("penumbra_favorite_states", JSON.stringify(Array.from(favorites)));
            } else if (type === 'table') {
                // FIXED: Added "penumbra_favorite_hr_tables" to the keys array
                const keys = ["penumbra_favorite_tables", "penumbra_favorite_pins_tables", "penumbra_favorite_infoed_tables", "penumbra_favorite_hr_tables", "penumbra_favorite_fin_tables"];
                keys.forEach(key => {
                    let favs = new Set(JSON.parse(localStorage.getItem(key) || "[]"));
                    if (favs.has(name)) {
                        favs.delete(name);
                        localStorage.setItem(key, JSON.stringify(Array.from(favs)));
                    }
                }
                );
            }
            refreshConsoleFavoriteViews();
            dispatchFavoritesChanged('console');
            show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Removed from favorites.</p>`);
            return;
        }

        // --- 3. ROUTING LOGIC ---
        if (action === 'favorite-more-options') {
            showFavoriteMoreOptions(itemElement, $item, fullData, e);
            return;
        }

        switch (type) {
            case 'table':
                if (action === 'open-here' || action === 'open-state' || action === 'clear-all') {
                    performClearAllAction(name);
                } else if (action === 'open-new') {
                    const adminState = {
                        query: `SELECT * FROM ${name}`,
                        noLimit: false
                    };
                    const adminEncoded = compressString(JSON.stringify(adminState));
                    const adminUrl = window.location.href.split("?")[0] + "?state=" + adminEncoded;
                    window._pnbOpenTabOrNotice(itemElement, adminUrl, 'double-click the favorite to load it here');
                } else if (action === 'view-table-info') {
                    activeSystemQueryTable = name;
                    handleTableAction('view-table-info', itemElement, e);
                }
                break;

            case 'state':
                if (action === 'open-here' || action === 'open-state') {
                    if ((editor.getValue().trim() !== "" || snippetEditor.getValue().trim() !== "" || $("#reportTitle").val().trim() !== "" || $("#reportSubtitle").val().trim() !== "") && !confirm("This action will replace the current query and all options by loading a saved state. Do you want to continue?")) {
                        return;
                    }
                    window.location.href = fullData.url;
                } else if (action === 'open-new' || action === 'open-state-new') {
                    // fullData.url is relative; _pnbOpenTabOrNotice absolutises it.
                    window._pnbOpenTabOrNotice(itemElement, fullData.url, 'double-click the favorite to load it here');
                } else if (action.startsWith('copy-')) {
                    // fullData.url is stored relative; share it absolute.
                    window._pnbCopyText(window._pnbAbsUrl(fullData.url), "Link copied.");
                } else if (action === 'edit-json') {
                    handleEditJsonState(fullData);
                }
                break;

            case 'server-report':
                const reportUrl = window.location.href.split("?")[0] + `?id=${name}`;
                if (action === 'open-here' || action === 'open-state') {
                    window.location.href = reportUrl;
                } else if (action === 'open-new') {
                    window._pnbOpenTabOrNotice(itemElement, reportUrl, 'double-click the favorite to load it here');
                } else if (action === 'copy-link') {
                    window._pnbCopyText(reportUrl, "Server link copied.");
                } else if (action === 'view-audit-log') {
                    // Open the Audit Log report, passing this report's ID as 'report_name'
                    // We use 'report_name' to avoid conflict with the main '?id=' routing parameter
                    const auditUrl = window.location.href.split("?")[0] + `?id=penumbra_log&console=0&report_name=${name}`;
                    window._pnbOpenTabOrNotice(itemElement, auditUrl);
                }
                break;
        }
    }

