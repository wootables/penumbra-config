            delete hit.pinnedReportId;
        }
        try {
            localStorage.setItem(SNAPSHOT_STORAGE_KEY, JSON.stringify(snapshots));
        } catch (e) {
            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> Could not save the pin - browser storage is full.</p>", 8000);
            return null;
        }
