                    // Generate simple HTML 
                    snippetChartsHtml += `
                        <div style="margin: 15px 0; text-align: center;">
                            <img src="cid:${cid}" style="max-width: 100%; height: auto; border: 1px solid #eee; display: block; margin: 0 auto;">
                        </div>`;
