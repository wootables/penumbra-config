    // memory, which is what keeps a 90K-row footer as cheap as the old
    // sum-only loop it replaces.
    // True for a journal toggle column, whose cells are the strings '1'/'0'.
    // Accepts either the column NAME or its data-column id - for these columns
    // they are the same string.
    function penumbraIsToggleColumn(nameOrId) {
        return String(nameOrId || '').toUpperCase().indexOf('__JOURNAL_TOGGLE__') === 0;
    }

    // isToggle: this column holds '1'/'0' checkbox states. It changes ONLY the
    // two counting types, so that "Count Non-Blank" means CHECKED and "Count
    // Blank" means UNCHECKED - which is what those labels obviously promise on a
    // checkbox column. Left alone, '0' is a perfectly non-blank string and both
    // counts degenerate (every row, and none).
    //
    // Deliberately scoped to those two types: the raw value stays '1'/'0' for
    // everything else, so Total still gives the checked count, Average the
    // proportion, Count Unique 2, and Mode the majority state - and the stored
    // value continues to match the server's journalExportToggleRowValues().
    // colName: the column this accumulator is for. Used to decide the toggle
    // rule above and to look up a custom formula - passing the NAME rather than
    // a pre-computed flag keeps every call site to one argument.
    function penumbraSummaryAccumulator(type, colName) {
        const def = PENUMBRA_SUMMARY_TYPES[type] || {};
        const toggleBlankZero = penumbraIsToggleColumn(colName) &&
                                (type === 'count_filled' || type === 'count_blank');
        // A formula needs every aggregate available at finish(), so it retains
        // the same values median and count-unique do.
        const formulaAst = (type === 'formula')
            ? (penumbraParseSummaryFormula(penumbraResolveSummaryFormula(colName)).ast || null)
            : null;
        const st = {
            n: 0, filled: 0, blank: 0,
            sum: 0, mean: 0, m2: 0, numN: 0, min: null, max: null,
            decimals: 0, isCurrency: false, isPercent: false,
            vals: null, freq: null, order: null, uniq: null,
            dateOk: def.dateAware === true, dateBest: null, dateText: null, dateSeen: 0
