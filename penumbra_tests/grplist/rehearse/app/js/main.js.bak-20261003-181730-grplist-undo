                        }
                    }
                }
                if (slideIdx === 0) break;
            }

            // Extract the vis() call text from the ORIGINAL (unmasked) text for arg parsing
            var visCallText = rawText.substring(startIdx, endIdx);
            var argsStr = visCallText.substring(visCallText.indexOf('(') + 1, visCallText.lastIndexOf(')'));
            var args;
            try { args = parseFunctionArgs(argsStr); } catch (e) { cursor = endIdx; continue; }

            // Matched-pair strip: a chart title/subtitle can legitimately END with a
            // quote (e.g. `Spend by "Region"`) without starting with one.
            var clean = function (a) { return stripWrappingQuotePair(a || ''); };
            var bool = function (a) { return String(a).trim() === 'true'; };
            var chartType = clean(args[0]) || 'bar';
            var chartTitle = clean(args[6]) || '';

            // Build label: "Type: Title" or "Type Chart (line N)"
            var typeLabel = chartType.charAt(0).toUpperCase() + chartType.slice(1);
            var label;
            if (chartTitle) {
                label = typeLabel + ': ' + chartTitle;
            } else {
                label = typeLabel + ' Chart (line ' + (from.line + 1) + ')';
            }
            if (isInfobox) label = '\uD83D\uDCE6 ' + label;

            // Parse full config for form restoration
            var config = {
                type: chartType,
                xAxis: clean(args[1]),
                yAxis: clean(args[2]) === 'none' ? '' : clean(args[2]),
                groupBy: clean(args[3]) === 'none' ? '' : clean(args[3]),
                agg: clean(args[4]) || 'count',
                limit: parseInt(args[5]) || 10,
                title: chartTitle,
                legend: bool(args[7]),
                values: bool(args[8]),
                width: clean(args[9]) || '800',
                height: clean(args[10]) || '180',
                legendPos: clean(args[11]) || 'top',
                valuePos: clean(args[12]) || 'end',
                animate: bool(args[13]),
                stacked: bool(args[14]),
                horizontal: bool(args[15]),
                titlePos: clean(args[16]) || 'top',
                sortBy: clean(args[17]) || 'value',
                sortDir: clean(args[18]) || 'desc',
                stackOrder: clean(args[19]) || 'default',
                normalize: bool(args[20]),
                subtitle: clean(args[21]) || '',
                xAxisLabel: clean(args[22]) || '',
                yAxisLabel: clean(args[23]) || '',
                otherBucket: bool(args[24]),
                filterXAxis: bool(args[25]),
                filterGroup: bool(args[26]),
                logScale: bool(args[27]),
                yMin: clean(args[28]) || '',
                yMax: clean(args[29]) || '',
                comboSeries: (function () {
                    try {
                        var cs = clean(args[30]);
                        if (!cs) return null;
                        // Reverse JS-string escapes that the outer vis() arg quoting introduced (\' always; \" only when infobox-wrapped).
                        cs = cs.replace(/\\'/g, "'");
                        if (isInfobox) cs = cs.replace(/\\"/g, '"');
                        return JSON.parse(cs);
                    } catch (e) { return null; }
                })(),
                trendLine: clean(args[31]) || 'none',
                comboFill: bool(args[32]),
                // showSettings defaults to true when arg[33] is missing so
                // pre-existing vis() calls keep their cog icon.
                showSettings: (args[33] === undefined || clean(args[33]) === '') ? true : bool(args[33]),
                filterExpression: clean(args[34]) || '',
                referenceLine: clean(args[35]) || '',
                // arg[36]: funnel stage measure, 'conversion' | 'duration[|unit]'
                funnelMode: clean(args[36]) || '',
                // arg[37]: gauge/bullet qualitative bands, ascending '50|80'
                bands: clean(args[37]) || '',
                // arg[38]: box-plot whisker rule, 'tukey' (default) | 'minmax'
                boxWhiskers: clean(args[38]) || '',
                // arg[39]: combo Pareto mode - rescales the cumulative line to %
                pareto: (args[39] !== undefined) && (clean(args[39]) === 'true'),
                // arg[40]: NAMED OPTIONS object - all future per-type settings
                // live in here rather than growing the positional list.
                vizOptions: clean(args[40]) || ''
            };

            results.push({
                index: chartIdx,
                type: chartType,
                title: chartTitle,
                line: from.line + 1,
                from: from,
                to: to,
                isInfobox: isInfobox,
                wrapperFrom: wrapperFrom,
                wrapperTo: wrapperTo,
                inSlide: inSlide,
                slideFrom: slideFrom,
                slideTo: slideTo,
                config: config,
                label: label
            });
            chartIdx++;
            cursor = endIdx;
        }

        return results;
    }

    /**
     * Rebuilds the #vizChartDropdown from current editor state.
     * @param {string} [selectValue] - '__new__', or an index string to select after refresh.
     *   If omitted, auto-detects from window.vizUpdateRange.
     */
    function refreshVizChartDropdown(selectValue) {
        var charts = enumerateVisCallsInEditor();
        window._vizChartList = charts;

        var $dd = $('#vizChartDropdown');
        $dd.empty().append('<option value="__new__">&#x2795; Add as new chart</option>');

        for (var i = 0; i < charts.length; i++) {
            var c = charts[i];
            var $opt = $('<option></option>').val(String(c.index)).text(c.label);
            $opt.data('entry', c);
            $dd.append($opt);
        }

        // Determine which option to select
        if (typeof selectValue === 'string' || typeof selectValue === 'number') {
            $dd.val(String(selectValue));
        } else if (window.vizUpdateRange) {
            // Match by CodeMirror positions
            var matched = false;
            for (var j = 0; j < charts.length; j++) {
                var entry = charts[j];
                if (entry.from.line === window.vizUpdateRange.from.line &&
                    entry.from.ch === window.vizUpdateRange.from.ch) {
                    $dd.val(String(entry.index));
                    matched = true;
                    break;
                }
            }
            if (!matched) $dd.val('__new__');
        } else {
            $dd.val('__new__');
        }

        updateVizAdminButtons();
    }

    /**
     * Finds the #vizChartDropdown entry that a rendered config came from.
     *
     * When the Builder opens straight off a report render, lastVisConfig holds the
     * LAST vis() the snippet engine drew, so the live preview shows that chart - but
     * nothing had told the dropdown, which stayed on "Add as new chart" and hid the
     * Update button for the very chart on screen. Match on structural args only:
     * the snippet renderer resolves string-literal tokens in title/subtitle
     * (_resolveTok) while the editor enumerator keeps the raw text, so those two can
     * legitimately differ for the same chart. Last match wins, mirroring
     * lastVisConfig itself being the last render.
     * @returns {object|null} the matching _vizChartList entry
     */
    function findVizChartEntryForConfig(cfg) {
        var list = window._vizChartList || [];
        if (!cfg || !list.length) return null;
        var norm = function (v) {
            if (v === null || v === undefined || v === 'none') return '';
            if (typeof v === 'boolean') return v ? 'true' : 'false';
            return String(v).trim().toLowerCase();
        };
        var keys = ['type', 'xAxis', 'yAxis', 'groupBy', 'agg', 'limit',
                    'stacked', 'horizontal', 'normalize'];
        var match = null;
        for (var i = 0; i < list.length; i++) {
            var c = list[i].config;
            if (!c) continue;
            var same = true;
            for (var k = 0; k < keys.length; k++) {
                if (norm(c[keys[k]]) !== norm(cfg[keys[k]])) { same = false; break; }
            }
            if (same) match = list[i];
        }
        return match;
    }

    /**
     * Shows/hides admin buttons based on the chart dropdown selection.
     */
    function updateVizAdminButtons() {
        var val = $('#vizChartDropdown').val();
        var hasCode = !!currentVizSnippetCode;

        if (val === '__new__') {
            // "Add new" mode
            $('#copyVizSnippetBtn').toggle(hasCode);
            $('#injectVizInfoboxBtn').toggle(hasCode);
            $('#copyVizClipboardBtn').toggle(hasCode);
            $('#updateVizSnippetBtn').hide();
            $('#removeVizSnippetBtn').hide();
            $('#vizMoveToInfoboxBtn').hide();   // nothing placed yet to move
            $('#vizMoveToSlideBtn').hide();     // same - nothing placed yet
            window.vizUpdateRange = null;
        } else {
            // Existing chart selected
            var entry = window._vizChartList && window._vizChartList[parseInt(val)];
            if (entry) {
                window.vizUpdateRange = { from: entry.from, to: entry.to };
            }
            $('#copyVizSnippetBtn').hide();
            $('#injectVizInfoboxBtn').hide();
            $('#copyVizClipboardBtn').hide();
            $('#updateVizSnippetBtn').toggle(hasCode);
            $('#removeVizSnippetBtn').show();
            // "Move inside an infobox" only means something for a chart that is
            // currently INLINE - one already wrapped has nowhere to move to.
            // A chart inside a slide() counts as wrapped: an infobox is a
            // click-to-open popup and a carousel slide is a static frame with
            // its interactivity deliberately stripped, so the two do not nest.
            $('#vizMoveToInfoboxBtn').toggle(!!entry && !entry.isInfobox && !entry.inSlide);
            // Same rule, other direction. Inline charts only for now: an
            // infobox-wrapped chart would need its wrapper removed and its
            // escaped payload un-escaped before it could be re-wrapped.
            $('#vizMoveToSlideBtn').toggle(!!entry && !entry.isInfobox && !entry.inSlide);
        }
        // Four of the buttons above now live in the Actions menu, so the menu's
        // own trigger has to follow their combined visibility. This is the one
        // funnel every caller goes through, so it is the only hook needed.
        vizSyncActionsMenu();
    }

