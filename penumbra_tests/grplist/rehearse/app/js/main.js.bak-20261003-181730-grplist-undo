            menuItems.push('<div class="submenu-divider"></div>');
            menuItems.push(`<div class="submenu-item" data-action="rename-state">Rename</div>`);
            menuItems.push(`<div class="submenu-item" data-action="duplicate-state">Duplicate</div>`);
        } else if (fullData.type === 'server-report') {
