        let headersFromGroupView = [];

        if (isGrouped) {
            let rowsFromAllVisibleGroups = [];
            let $firstGroupHeaders = null;
            // Iterate all visible groups to get flat list of rows. Strict child-chain
            // traversal + hard semantic filter (compare mode only) so each wrapper
            // contributes only rows whose hidden __SNAP_TYPE matches its data-group-key.
            const _csvIsCompare = $('#snapshotComparisonContainer').is(':visible');
            $("#groupedResultsContainer .group-wrapper.group-leaf").not('.search-hidden').each(function () {
                var $thisGroup = $(this);
                var $thisTable = $thisGroup.children('.group-content').children('table');
                var thisGroupKey = $thisGroup.attr('data-group-key') || '';
                $thisTable.children('tbody').children('tr').not('.search-hidden').not('.journal-note-child').each(function () {
                    if (_csvIsCompare && thisGroupKey) {
