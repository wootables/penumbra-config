    // Click-to-Filter is a display behavior rather than a restriction, so unlike
    // the hide* options it has to reach admins too -- and admins never run
    // applyUserViewRestrictions. Driven by the state value, never by the
    // checkbox: the View Options UI isn't present in a non-admin's DOM.
    function applyClickToFilter(enabled) {
        $('body').toggleClass('pnb-click-filter', !!enabled || _pnbDashHosted());   // hosted by a dashboard: always on (2026-09-30)
    }

    // ----- SPLIT HEADER LAYOUT (2026-09-18) ---------------------------------
    // The third Header Layout. The header stays the NORMAL title area
    // (breadcrumb, title, subtitle, prompts) and #reportSnippetOutput is
    // re-hosted into #pnbSplitPane - the right half of #pnbSplitStage, beside
    // #table-view-container. Browser-only like the other two layouts: the
    // runner, email and PDF engines never read headerLayout.
    //
    // Three rules this has to keep:
    //  1. The snippet node is MOVED, never rebuilt. Its Chart.js canvases, its
    //     handlers and the % chart ResizeObserver (which watches
    //     #reportSnippetOutput ITSELF) all belong to that one node; a copy
    //     would arrive blank and unobserved.
    //  2. The stage is NEVER a scroll container. The grouped view is
    //     deliberately un-containerized because its bands stick to the
    //     VIEWPORT (see applyContainerization); an overflow box around it
    //     brings that bug back. The pane is sticky and scrolls itself instead.
    //  3. Section embeds (&eview=header|table) show ONE half of the page, so
    //     the snippet has to stay with the header there: split stands down.
    var _splitHome = null;   // comment node holding the snippet's place in the header

    function _splitAllowed() {
        var cl = document.body.classList;
        return !(cl.contains('embed-only-header') || cl.contains('embed-only-table'));
    }

    // index.php ships the stage; this only builds one for a page that lacks it
    // (a test harness, or a page served before the markup deployed).
    function _splitEnsureStage() {
        var stage = document.getElementById('pnbSplitStage');
        var tvc = document.getElementById('table-view-container');
        if (!stage) {
            if (!tvc || !tvc.parentNode) return null;
            stage = document.createElement('div');
            stage.id = 'pnbSplitStage';
            tvc.parentNode.insertBefore(stage, tvc);
            stage.appendChild(tvc);
        }
        if (!document.getElementById('pnbSplitPane')) {
            var pane = document.createElement('aside');
            pane.id = 'pnbSplitPane';
            pane.setAttribute('aria-label', 'Report snippets');
            pane.hidden = true;
            stage.appendChild(pane);
        }
        return stage;
    }

    // A report with no snippet - or one whose snippet is only format() /
    // rewrite() rules, which render to whitespace - must not leave an empty
    // frame over half the page. :empty cannot see that second case, so the
    // stage gets .is-split-empty from here. Structural on purpose: the pane is
    // display:none while empty, so nothing inside it can be MEASURED.
    function _splitSnippetHasContent(snip) {
        for (var n = snip.firstChild; n; n = n.nextSibling) {
            if (n.nodeType === 3) {
                if (/\S/.test(n.nodeValue)) return true;
            } else if (n.nodeType === 1) {
                var tag = n.nodeName.toLowerCase();
                if (tag === 'style' || tag === 'script' || tag === 'br') continue;
                if (n.hidden || n.style.display === 'none') continue;
                return true;
            }
        }
        return false;
    }

    var _splitMO = null;
    function _splitMarkEmpty() {
        var stage = document.getElementById('pnbSplitStage');
        var snip = document.getElementById('reportSnippetOutput');
        if (!stage || !snip) return;
        stage.classList.toggle('is-split-empty',
            stage.classList.contains('is-split') && !_splitSnippetHasContent(snip));
    }

    function _splitSetActive(on) {
        var hdr = document.getElementById('reportHeaderContainer');
        var snip = document.getElementById('reportSnippetOutput');
        if (!hdr || !snip) return;
        var stage = on ? _splitEnsureStage() : document.getElementById('pnbSplitStage');
        var pane = document.getElementById('pnbSplitPane');
        if (on && (!stage || !pane)) on = false;

        if (on) {
            if (snip.parentNode !== pane) {
                if (!_splitHome) _splitHome = document.createComment('pnbSplitHome');
                snip.parentNode.insertBefore(_splitHome, snip);
                pane.appendChild(snip);
            }
            pane.hidden = false;
            // The pane owns a scrollbar, and a plain box ignores the keyboard
            // (WCAG 2.1.1) - the same treatment #results-wrapper gets.
            pane.setAttribute('tabindex', '0');
            // Top-level writes only (.empty() / .html()): a chart drawing into
            // its canvas is not a reason to re-decide.
            if (!_splitMO && window.MutationObserver) {
                _splitMO = new MutationObserver(_splitMarkEmpty);
                _splitMO.observe(snip, { childList: true });
            }
        } else if (pane) {
            if (_splitMO) { _splitMO.disconnect(); _splitMO = null; }
            if (snip.parentNode === pane) {
                if (_splitHome && _splitHome.parentNode) {
                    _splitHome.parentNode.insertBefore(snip, _splitHome);
                } else {
                    hdr.appendChild(snip);
                }
            }
            if (_splitHome && _splitHome.parentNode) _splitHome.parentNode.removeChild(_splitHome);
            pane.hidden = true;
        }
        if (stage) stage.classList.toggle('is-split', on);
        hdr.classList.toggle('layout-split', on);
        document.body.classList.toggle('pnb-layout-split', on);
        _splitMarkEmpty();
    }

    // Where the pane sticks, and how tall it may grow. The same three chrome
    // inputs, in the same order, as updateStickyHeaderOffset() and
    // _groupSyncStickyOffsets() - the three must agree on where "below the
    // chrome" is. The controls bar's bottom margin is added so the pane's
    // stuck position is its resting position (no jump when the grouped page
    // starts to scroll).
    //
    // Height: beside a containerized table (flat, pivot) the pane takes
    // #results-wrapper's OWN cap, so the two boxes end on one line whatever
    // sits above them - an open admin console pushes both down alike. Only the
    // grouped view, which has no wrapper, falls back to the chrome arithmetic.
    function penumbraSplitSync() {
        var stage = document.getElementById('pnbSplitStage');
        if (!stage || !stage.classList.contains('is-split')) return;
        var top = 0;
        ['#reportHeaderContainer', '#snapAnalysisDock', '#resultsHeader'].forEach(function (sel) {
            var $el = $(sel);
            if ($el.length && $el.is(':visible')) top += $el.outerHeight() || 0;
        });
        var $rh = $('#resultsHeader');
        if ($rh.length && $rh.is(':visible')) top += parseFloat($rh.css('margin-bottom')) || 0;
        top = Math.round(top);
        var $sb = $('#pnbStatusBar');
        var foot = ($sb.length && $sb.is(':visible')) ? Math.round($sb.outerHeight() || 0) : 0;
        var h = Math.max(250, window.innerHeight - top - 2 - foot);
        var $wrap = $('#results-wrapper');
        if ($wrap.length && $wrap.is(':visible')) {
            var wrapCap = parseFloat($wrap.css('max-height'));
            if (wrapCap > 0) h = wrapCap;
        }
        stage.style.setProperty('--pnb-split-top', top + 'px');
        stage.style.setProperty('--pnb-split-h', h + 'px');
    }

    function applyHeaderLayout(mode) {
        var $hdr = $('#reportHeaderContainer');
        var $breadcrumb = $('#dashboardBreadcrumb');
        var $tsRow = $('#dashboardTimestampRow');
        $hdr.removeClass('layout-dashboard');
        // Split differs from Default only BELOW the header, so it takes the
        // Default branch here and is engaged (or released) at the tail.
        var wantSplit = (mode === 'split') && _splitAllowed();

        // Dashboard AND Split (2026-10-03) park the breadcrumb strip in the
        // header's upper right corner instead of on a row of its own above
        // the title. One element, one id (#dashboardBreadcrumb - the name is
        // historical): the Bare header and narrow-frame rules find the moved
        // strip by it, whichever of the two layouts moved it.
        if (mode === 'dashboard' || wantSplit) {
            // Move breadcrumb out of reportInfoPanel into its own grid item.
            // (The LAYOUT1 -> LAYOUT2 text swap that lived here is gone as of
            // 2026-09-09: the strip is now the shared "Penumbra > Reports >
            // <short id>" trail from penumbra_crumb.php and carries no layout
            // tag. Only the MOVE remains.)
            if (!$breadcrumb.length) {
                var $orig = $('#reportInfoPanel > div:first-child');
                if ($orig.length) {
                    $orig.attr('id', 'dashboardBreadcrumb');
                    $hdr.prepend($orig);
                }
            }
        } else if ($breadcrumb.length) {
            // Move breadcrumb back into reportInfoPanel
            var $panel = $('#reportInfoPanel');
            // Restore original LAYOUT1 text
            var origHtml = $breadcrumb.data('origHtml');
            if (origHtml) $breadcrumb.html(origHtml);
            $breadcrumb.removeAttr('id');
            $panel.prepend($breadcrumb);
        }

        if (mode === 'dashboard') {
            $hdr.addClass('layout-dashboard');

            // Wrap timestamps into a single inline row
            if (!$tsRow.length) {
                $tsRow = $('<div id="dashboardTimestampRow"></div>');
                var $ts = $('#dataLoadedTimestamp');
                var $imp = $('#importTimestamps');
                $ts.before($tsRow);
                $tsRow.append($ts).append($imp);
            }
        } else {
            // Unwrap timestamps back to their original positions
            if ($tsRow.length) {
                var $ts = $('#dataLoadedTimestamp');
                var $imp = $('#importTimestamps');
                $tsRow.before($ts);
                $ts.after($imp);
                $tsRow.remove();
            }
        }

        // Entering or leaving split changes the header's height AND the table's
        // width in one go. The observers on both would catch up a frame later;
        // re-anchoring here keeps the controls bar, the table's scroll box and
        // the frozen columns from painting one frame against the old geometry.
        var wasSplit = $hdr.hasClass('layout-split');
        _splitSetActive(wantSplit);
        if (wasSplit !== wantSplit) {
            if (typeof window.stackHeaders === 'function') window.stackHeaders();
            updateContainerHeight();
            if (typeof penumbraFlatFreezeSync === 'function') penumbraFlatFreezeSync();
        }
        penumbraSplitSync();
    }

    // ----- BARE HEADER (2026-09-25) -------------------------------------------
    // View Options > Header Layout > "Bare header" strips the header's CHROME in
    // whichever layout is picked: the breadcrumb strips (the report's own,
    // Dashboard's moved copy, the snapshot band's), the card (background,
    // border, accent stripe, shadow, rounded corners), the theme watermark, and
    // the F2 tab while the header is open. What the header SAYS stays: title,
    // subtitle, prompts, snippets, the Subscribe pill, the snapshot band. All of
    // that is CSS on body.pnb-bare-header.
    //
    // Everyone gets it, authors included, the way they get Header Layout: it is
    // how the report looks, not a feature withheld from viewers, so it is driven
    // by the saved state (a viewer has no View Options DOM) and never marked.
    // Re-anchored here for the same reason applyHeaderLayout() re-anchors: the
    // header's height is what the sticky controls bar, the table's height cap
    // and the split pane are all measured from. Browser-only like headerLayout -
    // the runner, email and PDF engines never read it.
    function applyBareHeader(on) {
        on = !!on;
        if (document.body.classList.contains('pnb-bare-header') === on) return;
        document.body.classList.toggle('pnb-bare-header', on);
        if (typeof window.stackHeaders === 'function') window.stackHeaders();
        updateContainerHeight();   // ends in penumbraSplitSync()
        if (typeof penumbraFlatFreezeSync === 'function') penumbraFlatFreezeSync();
    }

    // ----- "Hidden from users" markers (EDITORS ONLY) -------------------------
    // A View Option that is OFF takes the control away from viewers who cannot
    // edit the report: applyUserViewRestrictions() below hides it outright.
    // Editors (penumbra_vars.isAdmin: admins, the report's owner, report-grant
    // holders; nobody under &noadm) keep the control -- they need it to author
    // the report -- but with nothing on screen to say so, an author cannot tell
    // which buttons their readers actually get. "Admins" below means editors.
    //
    // The live View Options toggle used to .hide() the button for admins too, so
    // the toolbar looked one way while toggling and another way after a refresh
    // (a refresh restores it, because admins never run applyUserViewRestrictions).
    // Both paths now converge on penumbraRefreshUserHiddenMarkers(): admins ALWAYS
    // see the button, wearing an amber dashed-stroke marker plus a tooltip suffix.
    // Viewers are untouched -- they still lose the button entirely.
    //
    // The value is a full jQuery selector, not a single id: most options take
    // MORE than one control away from a user, and every one of them has to
    // carry the marker or the toolbar tells the author a half-truth. The list
    // below is the exact mirror of what applyUserViewRestrictions() hides plus
    // what the body.restrict-* rules hide in CSS -- keep the three in step.
    var PNB_USER_HIDDEN_TARGETS = {
        // Search Bar: the box and its builder / run / clear controls
        // (restrict-search in main.css hides the same wrapper).
        viewOptionSearch:     '#tableSearchContainer .search-wrapper',
        // Snapshots also owns the two status-bar popover buttons that reopen the
        // manager / comparison editor (see the restrict-snapshots CSS).
        viewOptionSnapshots:  '#snapshotBtn, #sbSnapManager, #sbSnapModify',
        viewOptionEmail:      '#emailTableBtn',
        // Grouping takes three things: the toolbar button, the "Remove
        // Grouping" link on the grouped view, and the status-bar chip that is
        // a second door into the grouping popover.
        // #removeGroupingSep rides along with the link: hiding the link alone
        // left its bullet separator floating after "Collapse All".
        // #configureGroupingBtn is the grouped view's second door into the same
        // dialog #groupTableBtn opens, so it MUST hide with the rest - leaving it
        // behind would let a viewer with Grouping hidden reopen the builder.
        viewOptionGrouping:   '#groupTableBtn, #configureGroupingBtn, #removeGroupingLink, #removeGroupingSep, #sbGroup',
        viewOptionClipboard:  '#copyActionsBtn',
        viewOptionExport:     '#downloadBtn',
        // Pivot likewise, plus Modify Pivot Table / Restore Transaction List --
        // the pair whose absence makes leaving a pivot a one-way trip for a
        // restricted viewer (see penumbraDrillExitBlocked).
        viewOptionPivot:      '#pivotBtn, #modifyPivotBtn, #exitPivotModeBtn, #sbPivot',
        viewOptionViz:        '#visualizeBtn',
        viewOptionPagination: '#paginationControls'
    };
    // Not in the map, handled elsewhere for good reasons:
    //   Journal -- its live toggle drives window._penumbraJournalHidden, which
    //     the load path re-applies for editors too (updateJournalButtonVisibility),
    //     so it never had the live-vs-refresh drift this fixes. While it is off
    //     an editor gets the journal peek instead, and journalRemark() marks the
    //     J button with this same note.
    //   Column Organization -- no button to mark; the whole settings-panel
    //     SECTION is what a user loses, so it is marked (ring + its admin note)
    //     at the bottom of penumbraRefreshUserHiddenMarkers, without a title.
    //   Visualizations' "Chart Configuration" rows -- built as HTML at
    //     menu-open time, so they are marked at their render sites through
    //     penumbraMarkUserHiddenFor().
    var PNB_USER_HIDDEN_NOTE = 'EDITORS ONLY: View Options hide this from this report\'s viewers.';
    var PNB_USER_HIDDEN_ARIA = ' (hidden from viewers)';
    // Matches the note in EITHER form it can appear in: appended to a control
    // that already had a title (" -- NOTE"), or standing alone on one that
    // didn't (#paginationControls, Modify Pivot Table, Remove Grouping).
    var PNB_USER_HIDDEN_STRIP = new RegExp('(\\s*--\\s*)?' +
        PNB_USER_HIDDEN_NOTE.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*$');

    function penumbraMarkUserHidden($el, hidden) {
        if (!$el || !$el.length) return;
        $el.each(function () {
            var $t = $(this);
            // Derive the base title from what is on the element RIGHT NOW, never
            // from a cached copy. The status-bar chips rewrite their own titles on
            // every refreshAll() to report the live pivot shape / grouping column,
            // so a cached base would go stale and then get written back OVER the
            // real text the moment the option was re-enabled. Deriving it also
            // makes re-marking idempotent: the strip runs first, so the note can
            // never stack up however many times this is called.
            // jQuery UI's tooltip MOVES the title onto data('ui-tooltip-title')
            // for as long as a tooltip is open, hence the fallback.
            var cur = $t.attr('title');
            if (!cur) cur = $t.data('ui-tooltip-title') || '';
            var base = String(cur).replace(PNB_USER_HIDDEN_STRIP, '');
            var aria = String($t.attr('aria-label') || '');
            if (aria.slice(-PNB_USER_HIDDEN_ARIA.length) === PNB_USER_HIDDEN_ARIA) {
                aria = aria.slice(0, -PNB_USER_HIDDEN_ARIA.length);
            }

            $t.toggleClass('pnb-user-hidden', !!hidden);
            if (hidden) {
                $t.attr('title', base ? base + ' -- ' + PNB_USER_HIDDEN_NOTE : PNB_USER_HIDDEN_NOTE);
                if (aria) $t.attr('aria-label', aria + PNB_USER_HIDDEN_ARIA);
            } else {
                if (base) $t.attr('title', base); else $t.removeAttr('title');
                if (aria) $t.attr('aria-label', aria);
            }
        });
    }

    // Re-sync every marker from the View Options checkboxes. Idempotent, and it
    // is the ONE path both the report load and the live toggle go through --
    // which is exactly what keeps the two views identical.
    function penumbraRefreshUserHiddenMarkers() {
        // Editors-only surface. Viewers have no View Options DOM and lose the
        // controls outright, and `&noadm` is an admin or owner PREVIEWING the
        // user view (the server already clears isAdmin there; the isNoAdmView
        // test holds on its own), so that has to stay faithful: no markers in
        // either case.
        if (!penumbra_vars.isAdmin || isNoAdmView) return;
        Object.keys(PNB_USER_HIDDEN_TARGETS).forEach(function (optId) {
            penumbraMarkUserHiddenFor(optId, $(PNB_USER_HIDDEN_TARGETS[optId]));
        });
        // Column Organization is the odd one out: there is no button, the whole
        // Columns section of the settings panel is what a user loses. It gets
        // the ring and its #spColumnsAdminNote legend, but NO title -- a tooltip
        // spanning a panel section would fire everywhere inside it.
        var $colsCb = $('#viewOptionColumns');
        if ($colsCb.length) {
            $('.sp-columns-section').toggleClass('pnb-user-hidden', !$colsCb.is(':checked'));
            // The status bar's frozen-columns chip is a second door into that
            // section's Freeze control, so it is marked like the pivot and
            // grouping chips - title included, being one small chip.
            penumbraMarkUserHidden($('#sbFrozen'), !$colsCb.is(':checked'));
        }
    }

    // Mark a node against one option's checkbox. Split out of the loop above so
    // surfaces that are BUILT ON DEMAND (the context menu and chart drill popup
    // both mint a fresh "Chart Configuration" row every time they open) can mark
    // themselves from the same source of truth instead of re-deriving it.
    function penumbraMarkUserHiddenFor(optionId, $el) {
        if (!$el || !$el.length) return;
        if (!penumbra_vars.isAdmin || isNoAdmView) return;
        var $cb = $('#' + optionId);
        if (!$cb.length) return;
        penumbraMarkUserHidden($el, !$cb.is(':checked'));
    }

    function applyUserViewRestrictions(viewOptions) {
        if (!viewOptions)
            return;
        // No restrictions to apply

        if (viewOptions.headerLayout) {
            applyHeaderLayout(viewOptions.headerLayout);
        }

        if (viewOptions.hideSearch) {
            // CSS takes the box unless a search is active - restrict-search in
            // main.css. Not .hide(): the container is shown again on every data
            // load.
            $('body').addClass('restrict-search');
        }
        if (viewOptions.hideSnapshots) {
            $('#snapshotBtn').hide();
            // The toolbar button is not the only door: the status-bar snapshot
            // popover (shown whenever a viewer lands on ?snap= data) offers
            // "Open snapshot manager" and "Modify comparison", both of which
            // reopen the very dialog this option withholds. Same shape as
            // restrict-pivot / restrict-grouping. The chip itself and "Restore
            // live data" deliberately STAY: telling someone they are looking at
            // stale data, and letting them get back to live, is not the feature
            // being restricted.
            $('body').addClass('restrict-snapshots');
        }
        if (viewOptions.hideEmail) {
            $('#emailTableBtn').hide();
        }
        if (viewOptions.hideGrouping) {
            $('#groupTableBtn').hide();
            $('body').addClass('restrict-grouping');
        }
        if (viewOptions.hideClipboard) {
            $('#copyActionsBtn').hide();
            // Charts carry their own copy/download menu (right-click > Image /
            // Data), which duplicated the Clipboard and Export features and was
            // never gated - any report with a chart handed a restricted viewer
            // "Copy Data (CSV)" regardless of these options.
            $('body').addClass('restrict-clipboard');
        }
        if (viewOptions.hideExport) {
            $('#downloadBtn').hide();
            $('body').addClass('restrict-export');
        }
        if (viewOptions.hidePivot) {
            $('#pivotBtn').hide();
            $('body').addClass('restrict-pivot');
        }
        if (viewOptions.hideViz) {
            $('#visualizeBtn').hide();
            // restrict-viz body class hides every "Chart Configuration" entry
            // (right-click context menu + chart drill popup) via CSS so a
            // user who disabled the Visualizations UI option can't launch
            // the editor on pre-existing charts. Matched pattern with
            // restrict-pivot + restrict-grouping.
            $('body').addClass('restrict-viz');
        }
        if (viewOptions.hidePagination) {
            $('#paginationControls').css('visibility', 'hidden');
            // Set the value WITHOUT triggering 'change': the change handler runs a
            // full applyPagination() pass, and the boot sequence calls
            // applyPagination() itself right after this function returns - the
            // trigger made every hidePagination report pay the whole pagination +
            // formatting pipeline an extra time. 2026-08-01
            $('#rowsPerPageSelector').val('all');
        }

        window._penumbraHideColumns = !!viewOptions.hideColumns;

        // Every control-bar option off (Column Organization and Bare Header put
        // nothing in the bar): the bar may go - penumbraSyncControlBar decides.
        _pnbBarAllOff = !!(viewOptions.hideSearch && viewOptions.hideSnapshots && viewOptions.hideEmail &&
            viewOptions.hideGrouping && viewOptions.hideClipboard && viewOptions.hideExport &&
            viewOptions.hidePivot && viewOptions.hideViz && viewOptions.hidePagination && !viewOptions.journalEnabled);
        penumbraSyncControlBar();
    }

    // ----- An empty control bar gives its row back (Search Bar, 2026-09-25) ---
    // A viewer whose View Options take away the search box AND every other
    // control in #resultsHeader (Snapshots, Email, Grouping, Clipboard, Export,
    // Pivot, Visualizations, Pagination, Journal) has an empty bar: it goes, and
    // the table moves up (body.pnb-no-controlbar, main.css). Admins always keep
    // it - they author from it; an admin previewing with &noadm sees what a
    // viewer sees. Two conditions, both needed: the flags
    // (_pnbBarAllOff, set by applyUserViewRestrictions) - without them a data
    // reload, which hides the icons for a moment, would flicker the bar away -
    // and what is actually VISIBLE, so the controls a restricted viewer still
    // gets keep it: a grouped report's Expand / Collapse All, a pivot's collapse
    // bar, an active search (restrict-search brings the box back).
    var _pnbBarAllOff = false, _pnbBarObserver = null, _pnbBarQueued = false;
    function _pnbBarItemVisible(el, root) {
        // Walk up to (not including) the bar: its own display is what we decide.
        for (var n = el; n && n !== root; n = n.parentElement) {
            if (n.hidden) return false;
            var cs = window.getComputedStyle(n);
            if (cs.display === 'none' || cs.visibility === 'hidden') return false;
        }
        return true;
    }
    function penumbraSyncControlBar() {
        var rh = document.getElementById('resultsHeader');
        if (!rh) return;
        // &noadm with the View Options on the page: the flags are its checkboxes
        // as they stand, so a live toggle there counts at once. (Since 2026-10-01
        // &noadm renders no View Options, owners included: only the harness.)
        if (isNoAdmView && document.getElementById('viewOptionSearch')) _pnbBarAllOff = _pnbBarFlagsFromCheckboxes();
        var collapse = false;
        if ((!penumbra_vars.isAdmin || isNoAdmView) && _pnbBarAllOff) {
            collapse = true;
            var items = rh.querySelectorAll('input, select, button, a[href], [role="button"]');
            for (var i = 0; i < items.length; i++) {
                if (_pnbBarItemVisible(items[i], rh)) { collapse = false; break; }
            }
            if (!_pnbBarObserver && window.MutationObserver) {
                // The bar's contents change on their own (a grouping or a pivot
                // renders, a search starts): re-decide on each change, once a frame.
                _pnbBarObserver = new MutationObserver(function () {
                    if (_pnbBarQueued) return;
                    _pnbBarQueued = true;
                    requestAnimationFrame(function () { _pnbBarQueued = false; penumbraSyncControlBar(); });
                });
                _pnbBarObserver.observe(rh, { attributes: true, attributeFilter: ['style', 'class', 'hidden'], childList: true, subtree: true });
            }
        }
        if (document.body.classList.contains('pnb-no-controlbar') === collapse) return;
        document.body.classList.toggle('pnb-no-controlbar', collapse);
        // Everything stacked on the bar re-anchors to its new height.
        if (typeof window.stackHeaders === 'function') window.stackHeaders();
        updateStickyHeaderOffset();
        updateContainerHeight();
    }
    // Every control-bar option unchecked in the View Options (the &noadm preview).
    function _pnbBarFlagsFromCheckboxes() {
        var off = function (id) { var cb = document.getElementById(id); return !!cb && !cb.checked; };
        return off('viewOptionSearch') && off('viewOptionSnapshots') && off('viewOptionEmail') && off('viewOptionGrouping') &&
            off('viewOptionClipboard') && off('viewOptionExport') && off('viewOptionPivot') && off('viewOptionViz') &&
            off('viewOptionPagination') && off('viewOptionJournal');
    }
    // &noadm: an End-User option toggled live does what applyUserViewRestrictions
    // does on a reload - the control goes (or comes back) and the restrict-*
    // class flips - instead of painting the admin marker the preview must not show.
    // Unreachable in production since 2026-10-01 (see penumbraSyncControlBar);
    // kept, with its harness, for the day &noadm carries View Options again.
    var PNB_PREVIEW_ICON = { viewOptionSnapshots: '#snapshotBtn', viewOptionEmail: '#emailTableBtn', viewOptionGrouping: '#groupTableBtn',
        viewOptionClipboard: '#copyActionsBtn', viewOptionExport: '#downloadBtn', viewOptionPivot: '#pivotBtn', viewOptionViz: '#visualizeBtn' };
    var PNB_PREVIEW_CLASS = { viewOptionSearch: 'restrict-search', viewOptionSnapshots: 'restrict-snapshots', viewOptionGrouping: 'restrict-grouping',
        viewOptionClipboard: 'restrict-clipboard', viewOptionExport: 'restrict-export', viewOptionPivot: 'restrict-pivot', viewOptionViz: 'restrict-viz' };
