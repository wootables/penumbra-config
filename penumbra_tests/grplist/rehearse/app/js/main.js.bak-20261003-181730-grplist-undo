                    if (excl && excl.uncheckedByCol) {
                        var keys2 = Object.keys(excl.uncheckedByCol);
                        originalForDrill = sourceRows.filter(function (rowMap) {
                            for (var ci = 0; ci < keys2.length; ci++) {
                                var col = keys2[ci];
                                var rv = _chartDrillCleanCellVal(rowMap.get ? rowMap.get(col) : '');
