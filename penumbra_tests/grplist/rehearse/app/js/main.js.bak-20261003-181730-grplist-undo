    $(document).on('paste.recipcommit', '#emailInputReal, #schedEmailInput', function () {
        const isSched = this.id === 'schedEmailInput';
        const inputSel = isSched ? '#schedEmailInput' : '#emailInputReal';
        const containerSel = isSched ? '#schedEmailContainer' : '#emailRecipientContainer';
