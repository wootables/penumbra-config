                }
                );
            }
            // Note: We cannot easily populate autofill values without running a query, 
            // so for autofill parents, the datalist will remain empty but the input is still editable.
        }
    });

    /**
     * Re-prompts the user for all prompt values in a transactional way.
     * @param {string} [sectionKey] section= key (promptSectionKey) - review only
     *   that section's prompts ('' = the unsectioned ones). Omitted = every prompt.
     */
    async function reconfigureAllPrompts(sectionKey) {
        const query = getQuery();
        const snippetQuery = getSnippet();
        const allQueries = query + "\n" + snippetQuery;

        // Allow whitespace in detection
        if (!/\[\s*PROMPT/i.test(allQueries)) {
            show_text("<p id='undo_text'>No prompts found in the current query.</p>");
            return;
        }

        const promptRegex = /\[\s*PROMPT[^\]]*\]/gi;
        // De-dupe by storage key, keeping first-occurrence order. A tag repeated
        // in the SQL (UNION branches, a subquery + the outer WHERE) or echoed in
        // the snippet matches once per occurrence, and this loop is TRANSACTIONAL
        // - nothing is written until every dialog is answered - so it has none of
        // the incidental suppression processPrompts gets from its mid-loop
        // localStorage.setItem. Without this filter the user is re-asked once per
        // copy: 3 prompts x 2 branches = 6 dialogs. Duplicates hash to the same
        // key (getPromptStorageKey), so the save loop below collapses them anyway.
        const _seenPromptKeys = new Set();
        const allPrompts = (allQueries.match(promptRegex) || []).filter(ps => {
            const k = getPromptStorageKey(ps);
            if (_seenPromptKeys.has(k)) return false;
            _seenPromptKeys.add(k);
            return true;
        });
        let prompts = allPrompts;

        // section= : a section's button reviews that section only. It is THIS
        // list that is filtered, not just which dialogs open - the save loop
        // below clears every listed key before it writes, so another section's
        // prompt left in the list would lose its answer.
        if (sectionKey !== undefined && sectionKey !== null) {
            const _want = promptSectionKey(sectionKey);
            const _sectionOf = promptSectionMap(allQueries);
            prompts = allPrompts.filter(ps => (_sectionOf.get(getPromptStorageKey(ps)) || '') === _want);
            if (prompts.length === 0) {
                show_text("<p id='undo_text'>No prompts found in this section of the current query.</p>");
                return;
            }
        }

        const newPromptValues = new Map();
        // Track raw answers to evaluate conditions locally during this loop
        const sessionAnswers = new Map();
        let wasCancelled = false;
        // A section's review does not ask the other sections' prompts, but their
        // answers still decide resultif: a child with a section of its own is
        // judged against its parent's SAVED answer here, never against nothing.
        if (prompts !== allPrompts) {
            const _asked = new Set(prompts.map(ps => getPromptStorageKey(ps)));
            allPrompts.forEach(ps => {
                const k = getPromptStorageKey(ps);
                if (_asked.has(k)) return;
                let p = null, saved = null;
                try { p = parsePrompt(ps); saved = JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return; }
                if (!p || !p.name || !saved || typeof saved !== 'object' || sessionAnswers.has(p.name)) return;
                const v = Array.isArray(saved.values) ? saved.values.map(x => x.value) : saved.value;
                if (v !== undefined && v !== null) sessionAnswers.set(p.name, v);
            });
        }
        // Prompts this review cannot judge - the parent was neither answered here
        // nor has a saved answer (a hidden parent, one written after them in the
        // SQL): not asked, and their saved answers left exactly as they are, for
        // the re-run to decide as any run does. They used to be DELETED here, so
        // the re-run asked them again from nothing.
        const keepAsIs = new Set();

        try {
            for (const promptString of prompts) {
                const parsedPrompt = parsePrompt(promptString);

                if (parsedPrompt.hidden) {
                    continue;
                }

                // --- NEW: Check Condition against sessionAnswers ---
                // Same matching rules as processPrompts: "!value" negates, "a|b"
                // matches any of them, "/re/flags" is a regex. This loop used to
                // know only the regex and ONE exact value, so a negated or
                // multi-value child counted as failed here - never asked, and its
                // saved answer deleted - although a normal run shows it.
                if (parsedPrompt.resultif) {
                    const parentName = parsedPrompt.resultif.parentName;
                    let expectedValue = parsedPrompt.resultif.expectedValue;
                    let conditionMet = false;
                    let rifNegate = false;
                    if (expectedValue.startsWith('!')) {
                        rifNegate = true;
                        expectedValue = expectedValue.substring(1);
                    }

                    if (sessionAnswers.has(parentName)) {
                        const parentVal = sessionAnswers.get(parentName);

                        // Detect if expectedValue is a regex (e.g., /pattern/flags)
                        const regexMatch = expectedValue.match(/^\/(.*?)\/([a-z]*)$/);

                        if (regexMatch) {
                            try {
                                const re = new RegExp(regexMatch[1], regexMatch[2]);
                                if (Array.isArray(parentVal)) {
                                    conditionMet = parentVal.some(val => re.test(String(val)));
                                } else {
                                    conditionMet = re.test(String(parentVal));
                                }
                            } catch (e) {
                                console.error("Invalid Regex in resultif:", expectedValue);
                            }
                        } else {
                            // Exact match, pipe-delimited multi-value ("val1|val2")
                            const rifValues = expectedValue.split('|');
                            if (Array.isArray(parentVal)) {
                                conditionMet = parentVal.some(pv => rifValues.includes(String(pv)));
                            } else {
                                conditionMet = rifValues.includes(String(parentVal));
                            }
                        }

                        // Negation applies only to an answered parent, as in processPrompts
                        if (rifNegate) conditionMet = !conditionMet;
                    } else {
                        // No answer to judge it by (see keepAsIs above).
                        keepAsIs.add(getPromptStorageKey(promptString));
                        continue;
                    }

                    if (!conditionMet) {
                        // Condition failed based on NEW answers. 
                        // Do not ask. Also mark to delete old storage.
                        const storageKey = getPromptStorageKey(promptString);
                        // We set it to 'DELETE_ME' so the cleanup loop below removes it
                        newPromptValues.set(storageKey, 'DELETE_ME');
                        continue;
                    }
                }
                // --- END: NEW CHECK ---

                // --- Fetch currently saved value ---
                const storageKey = getPromptStorageKey(promptString);
                const storedDataString = localStorage.getItem(storageKey);
                let prefillValue = null;
                if (storedDataString) {
                    try {
                        const storedData = JSON.parse(storedDataString);
                        // [FIX] Ensure it's not an array before checking .values
                        if (!Array.isArray(storedData) && storedData.values !== undefined) {
                            prefillValue = storedData.values.map(v => v.value);
                        } else if (storedData.value !== undefined) {
                            // Pair display + value back together so autofill
                            // text/textarea prompts re-open with the friendly
                            // label visible and the underlying key restored.
                            if (storedData.display !== undefined && storedData.display !== storedData.value) {
                                prefillValue = { value: storedData.value, display: storedData.display };
                            } else {
                                prefillValue = storedData.value;
                            }
                        } else if (Array.isArray(storedData)) {
                            prefillValue = storedData.map(v => v.value || v);
                        } else {
                            prefillValue = storedData;
                        }
                    } catch (e) { }
                }
                // --- END ---

                // Pass prefillValue
                const userInput = await showPromptDialog(parsedPrompt, prefillValue);

                if (userInput !== null) {
                    const urlParams = new URLSearchParams(window.location.search);
                    const currentReportId = urlParams.get('id') || null;
                    const dataToSave = (Array.isArray(userInput)) ? {
                        message: parsedPrompt.message,
                        values: userInput,
                        reportId: currentReportId
                    } : {
                        ...userInput,
                        message: parsedPrompt.message,
                        reportId: currentReportId
                    };
                    newPromptValues.set(storageKey, dataToSave);

                    // --- NEW: Track answer for dependencies ---
                    if (parsedPrompt.name) {
                        let actualVal = Array.isArray(userInput) ? userInput.map(u => u.value) : userInput.value;
                        sessionAnswers.set(parsedPrompt.name, actualVal);
                    }

                } else {
                    if (parsedPrompt.default !== null && parsedPrompt.default !== undefined) {
                        // Logic for defaults on cancel... (Keep existing logic here)
                        let dataForQuery;
                        if (parsedPrompt.type === 'multi-select') {
                            const defaultValues = parseMultiSelectDefault(parsedPrompt.default);
                            dataForQuery = defaultValues.map(val => ({
                                value: val,
                                display: val
                            }));
                        } else {
                            dataForQuery = {
                                value: parsedPrompt.default,
                                // a date range reads as its label on the chip ("Last
                                // month"), never as the raw "<from>..<to>" text
                                display: penumbraIsDateRangeType(parsedPrompt.type)
                                    ? penumbraDateRangeLabel(parsedPrompt.default) : parsedPrompt.default
                            };
                        }
                        const urlParams = new URLSearchParams(window.location.search);
                        const currentReportId = urlParams.get('id') || null;
                        const dataToSave = (Array.isArray(dataForQuery)) ? {
                            message: parsedPrompt.message,
                            values: dataForQuery,
                            reportId: currentReportId
                        } : {
                            ...dataForQuery,
                            message: parsedPrompt.message,
                            reportId: currentReportId
                        };
                        newPromptValues.set(storageKey, dataToSave);

                        // --- NEW: Track answer for dependencies ---
                        if (parsedPrompt.name) {
                            let actualVal = Array.isArray(dataForQuery) ? dataForQuery.map(u => u.value) : dataForQuery.value;
                            sessionAnswers.set(parsedPrompt.name, actualVal);
                        }

                    } else {
                        wasCancelled = true;
                        break;
                    }
                }
            }
        } catch (e) {
            console.error("Error during prompt reconfiguration:", e);
            show_text(`<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> ${e.message}</p>`);
            return;
        }

        if (wasCancelled) {
            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> Prompt reconfiguration cancelled. No changes were saved.</p>");
        } else {
            prompts.forEach(promptString => {
                const storageKey = getPromptStorageKey(promptString);
                // Could not be judged here: left exactly as it was.
                if (keepAsIs.has(storageKey)) return;
                // Remove existing first
                localStorage.removeItem(storageKey);

                if (newPromptValues.has(storageKey)) {
                    const newValue = newPromptValues.get(storageKey);
                    // If marked for deletion (skipped via resultif), we just leave it removed.
                    if (newValue !== 'DELETE_ME') {
                        try {
                            const parsed = parsePrompt(promptString);
                            if (!parsed.hidden) {
                                // Preserve nosave flag
                                if (parsed.nosave)
                                    newValue.nosave = true;
                                localStorage.setItem(storageKey, JSON.stringify(newValue));
                            }
                        } catch (e) {
                            localStorage.setItem(storageKey, JSON.stringify(newValue));
                        }
                    }
                }
            }
            );
            $("#executeQuery").click();
        }
    }

        /**
         * Resolves snippet functions (count, sum, case, vis, data, now, calc, etc.) inside a text string.
         * Uses the same function regex as the main snippet engine.
         * @param {string} text - Raw snippet text potentially containing function calls
         * @param {Map[]} rowDataMaps - Row data for aggregation functions
         * @param {string[]} columns - Visible column names
         * @returns {{ html: string, vizTasks: Array }} Resolved HTML and any deferred chart tasks
         */
    function resolveInfoboxSnippet(text, rowDataMaps, columns) {
            // \b keeps fn names from matching inside longer words - mirrors engine A.
            // Body also allows one level of bare non-call parens so an enclosing
            // call still matches once an inner one has resolved into text carrying
            // parens (e.g. an action() link labelled "Swap (crosstab)"). Twin of
            // engine A's regex - see the long comment there.
            // noweb sits ahead of web only for readability - `\b` already makes
            // `web(` unmatchable inside `noweb(` (the preceding char is a word
            // char), so neither ordering can shadow the other.
            const fnNameList = 'noweb|web|filter_strip|layout_switch|toggle_switch|info|vis|calc|progress_bar|sparkline|count|sum|avg|min|max|distinct|action|chain|median|mode|now|rank|percentile|stddev|lookup|date_diff|date_format|round|abs|floor|ceil|mod|fixed|me|data|string|case';
            const fnNameGuard = '\\b' + fnNameList.replace(/\|/g, '|\\b');
            const fnRegex = new RegExp(
                '\\b(' + fnNameList + ')\\('
                + '((?:"[^"]*"|\'[^\']*\'|(?<!' + fnNameGuard + ')\\((?:"[^"]*"|\'[^\']*\'|[^()])*\\)|[^()])*)'
                + '\\)', 'gi');
            const vizTasks = [];
            let result = text;

            // --- BACKTICK PROTECTION (parity with engines A and C) ------------
            // `text in backticks` is the author's "leave this alone" marker: the
            // backticks are CONSUMED and their contents are shielded from the
            // number-format pass, so a subtitle reading `FY 2026` stays "FY 2026"
            // instead of becoming "FY 2,026".
            // Engine B previously had no protection pipeline at all, so it did
            // NEITHER - it printed the literal backticks AND comma-formatted the
            // contents, while the same snippet in a scheduled email (engine C)
            // came out clean. Mirrors engine A (main.js ~27856 protect / ~29818
            // restore); restoration must happen AFTER penumbraFormatNumbersInHtml
            // for the shielding to mean anything.
            const protectedStrings = [];
            result = result.replace(/`([^`]+)`/g, (match, content) => {
                protectedStrings.push(content);
                return `__PROTECTED_STRING_${protectedStrings.length - 1}__`;
            });
            // format()/rewrite()/heatmap() define TABLE rules - they render nothing.
            // Engine A extracts-and-removes them and engine C strips them from
            // every email surface (including plain-mode subtitles); B used to
            // leave the raw call text visible in subtitles/infoboxes. Same
            // adjacent-paren + quote-aware balanced-scan removal as the twins.
            // sparkline_cell joins them: it is a TABLE rule too, so a subtitle or
            // infobox carrying one must swallow it rather than print the call.
            // Listed AFTER the others and matched with the same word-boundary
            // scan, so it can never be mistaken for the inline sparkline().
            ['format', 'rewrite', 'heatmap', 'sparkline_cell'].forEach(function (rfName) {
                var rfGuard = 0;
                while (rfGuard++ < 50) {
                    var rfLower = result.toLowerCase();
                    var rfFrom = 0, rfAt = -1;
                    while (true) {
                        var rfCand = rfLower.indexOf(rfName, rfFrom);
                        if (rfCand === -1) break;
                        var rfPrev = rfCand > 0 ? rfLower.charAt(rfCand - 1) : '';
                        if (!/[a-z0-9_]/.test(rfPrev) && rfLower.charAt(rfCand + rfName.length) === '(') { rfAt = rfCand; break; }
                        rfFrom = rfCand + rfName.length;
                    }
                    if (rfAt === -1) break;
                    var rfOpen = rfAt + rfName.length, rfDepth = 0, rfInQ = false, rfQc = '', rfEnd = -1;
                    for (var rfCi = rfOpen; rfCi < result.length; rfCi++) {
                        var rfCh = result.charAt(rfCi);
                        if (rfInQ) { if (rfCh === rfQc) rfInQ = false; continue; }
                        if (rfCh === '"' || rfCh === "'") { rfInQ = true; rfQc = rfCh; continue; }
                        if (rfCh === '(') rfDepth++;
                        else if (rfCh === ')') { rfDepth--; if (rfDepth === 0) { rfEnd = rfCi; break; } }
                    }
                    if (rfEnd === -1) break;
                    result = result.substring(0, rfAt) + result.substring(rfEnd + 1);
                }
            });
            let iterations = 0;

