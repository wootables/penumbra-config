    // --- File Import: Full-page drag overlay ---
    var _importDragCounter = 0;
    // Reset the counter and hide the overlay. The dragenter/dragleave counter can
    // desync if the browser drops an event (e.g. a drag that ends outside the window
    // without firing 'drop', or the tab losing focus mid-drag), leaving the overlay
    // stuck. dragend + window blur give us a guaranteed reset path.
    function _resetImportDragOverlay() {
        _importDragCounter = 0;
        $('#importDragOverlay').fadeOut(150);
    }
    $(document).on('dragenter', function (e) {
        e.preventDefault();
        _importDragCounter++;
