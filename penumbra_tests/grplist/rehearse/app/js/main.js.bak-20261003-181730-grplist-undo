        $('#snapColumnSyncOnlySnap').html(onlyInSnapshot.length > 0 ? escapeHtml(onlyInSnapshot.join(', ')) : '<em style="color: var(--text-muted);">none</em>');

        // Rebind fresh each invocation so the captured doCompareFn closure
