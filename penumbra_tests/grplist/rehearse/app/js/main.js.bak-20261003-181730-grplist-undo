        else if (name === 'changes') _auditRenderChanges(shortId);
        else if (name === 'health') _auditRenderHealth(shortId);
    }

    // ---- Pulse segment: stat tiles + charts + ranked lists -----------------
    function _auditBarsSvg(data, w, h, titleFn) {
        if (!data || !data.length) return '';
        var W = w || 300, H = h || 60, P = 2, mx = 1, i;
        for (i = 0; i < data.length; i++) if (data[i] > mx) mx = data[i];
        var n = data.length, gap = 2;
        var bw = Math.max(1.5, (W - 2 * P - gap * (n - 1)) / n);
        var rects = '';
        for (i = 0; i < n; i++) {
            if (!(data[i] > 0)) continue;
            var bh = Math.max(1.5, (data[i] / mx) * (H - 2 * P));
            rects += '<rect class="audit-spark-bar" x="' + (P + i * (bw + gap)).toFixed(1) + '" y="' + (H - P - bh).toFixed(1) +
                     '" width="' + bw.toFixed(1) + '" height="' + bh.toFixed(1) + '" rx="1"><title>' +
                     escapeHtml(titleFn ? titleFn(i, data[i]) : (i + ': ' + data[i])) + '</title></rect>';
        }
        return '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none" role="img">' + rects + '</svg>';
    }

    function _auditRankHtml(items, labelFn) {
        if (!items || !items.length) return '<div class="audit-diff-note">No data yet.</div>';
        var mx = 1, i;
        for (i = 0; i < items.length; i++) if (items[i].n > mx) mx = items[i].n;
        return items.map(function (it) {
            var pct = Math.max(2, Math.round((it.n / mx) * 100));
            var label = labelFn(it);
            return '<div class="audit-rank-row"><span class="audit-rank-name" title="' + escapeHtml(label) + '">' + escapeHtml(label) + '</span>' +
                   '<span class="audit-rank-bar"><i style="width:' + pct + '%"></i></span>' +
                   '<span class="audit-rank-n">' + it.n.toLocaleString() + '</span></div>';
        }).join('');
    }

    function renderAuditSegPulse(kpis) {
        var $p = $('#auditSegPulse');
        if (!$p.length) return;
        if (!kpis) { $p.html('<div class="audit-empty-note">Metrics are unavailable right now - refresh the log to retry.</div>'); return; }
        var fmt = function (n) {
            n = (typeof n === 'number' && isFinite(n)) ? n : 0;
            if (n >= 100000) return Math.round(n / 1000).toLocaleString() + 'k';
            return n.toLocaleString();
        };
        // A tile that leads somewhere is a BUTTON (2026-09-25): `go` = the attribute
        // of the delegate it rides - data-audit-goto-events="<family>" (switch to
        // Events, pre-filtered) or data-audit-goto-seg="<segment>", the same ones
        // the ribbon and the Health cards use. `#auditSegPulse button.audit-tile`
        // (main.css) makes it look exactly like the plain tiles.
        var tile = function (label, val, sub, warn, tip, go) {
            if (go) {
                return '<button type="button" class="audit-tile audit-tile-go' + (warn ? ' warn' : '') + '" ' + go + (tip ? ' title="' + escapeHtml(tip) + '"' : '') + '>' +
                       '<span class="audit-tile-k">' + label + '</span><span class="audit-tile-v">' + val + '</span>' +
                       '<span class="audit-tile-d">' + sub + '</span></button>';
            }
            return '<div class="audit-tile' + (warn ? ' warn' : '') + '"' + (tip ? ' title="' + escapeHtml(tip) + '"' : '') + '>' +
                   '<div class="audit-tile-k">' + label + '</div><div class="audit-tile-v">' + val + '</div>' +
                   '<div class="audit-tile-d">' + sub + '</div></div>';
        };
        var html = '<div class="audit-tiles">';
        html += tile('Total views', fmt(kpis.total_views), (kpis.total_views_today > 0 ? '+' + fmt(kpis.total_views_today) : '0') + ' today', false,
                     'Report opens, all time. Click to list them in Events.', 'data-audit-goto-events="view"');
        html += tile('Unique viewers', fmt(kpis.unique_viewers), fmt(kpis.unique_viewers_today) + ' today', false, 'Distinct viewers, all time');
        html += tile('Departments', fmt(kpis.depts), 'directory-matched', false, 'Departments among viewers the directory can attribute');
        html += tile('Exports', fmt(kpis.exports), kpis.exports_today > 0 ? '+' + fmt(kpis.exports_today) + ' today' : (kpis.exp_last ? 'last: ' + escapeHtml(kpis.exp_last) : 'none yet'), false, 'Downloads, all time');
        html += tile('Updates', fmt(kpis.updates), kpis.updates_today > 0 ? '+' + fmt(kpis.updates_today) + ' today' : (kpis.upd_last ? 'last: ' + escapeHtml(kpis.upd_last) : 'none yet'), false,
                     'Report state edits, all time. Click to see them in Changes.', 'data-audit-goto-seg="changes"');
        // Errors: with the last error's date when there is none today, as Exports /
        // Updates do; the tooltip names every type it counts (it used to name four).
        var errSub = kpis.errors_today > 0 ? fmt(kpis.errors_today) + ' today' : (kpis.err_last ? 'last: ' + escapeHtml(kpis.err_last) : 'none yet');
        html += tile('Errors', fmt(kpis.errors), errSub, kpis.errors > 0,
                     'All time: bad passwords, access denials, failed emails and scheduled runs, query timeouts, too-big results and browser errors. Click to list them in Events.',
                     'data-audit-goto-events="bad"');
        html += '</div>';

        html += '<div class="audit-duo">';
        if (kpis.trend && kpis.trend.length) {
            var total30 = 0, mxT = 0, pkI = 0, i;
            for (i = 0; i < kpis.trend.length; i++) {
                total30 += kpis.trend[i];
                if (kpis.trend[i] >= mxT) { mxT = kpis.trend[i]; pkI = i; } // >= keeps the most RECENT peak day
            }
            // Server sends real bucket dates (trend_labels, oldest first); fall
            // back to relative wording if a stale PHP response lacks them.
            var tl = (kpis.trend_labels && kpis.trend_labels.length === kpis.trend.length) ? kpis.trend_labels : null;
            html += '<div class="audit-chartbox"><div class="audit-chartbox-k">Views over time <span>&middot; last 30 days &middot; ' + total30.toLocaleString() + ' opens</span></div>' +
                    '<div class="audit-chartgrid"><div class="audit-ylab" aria-hidden="true"><span>' + fmt(mxT) + '</span><span>0</span></div>' +
                    _auditSparkSvg(kpis.trend, 300, 84, function (idx, v) {
                        return (tl ? tl[idx] : (kpis.trend.length - 1 - idx) + ' days ago') + ' · ' + v.toLocaleString() + (v === 1 ? ' open' : ' opens');
                    }) +
                    '<div class="audit-axis" aria-hidden="true"><span>' + escapeHtml(tl ? tl[0] : (kpis.trend.length - 1) + ' days ago') + '</span>' +
                    '<span>' + (mxT > 0 ? 'peak ' + fmt(mxT) + (tl ? ' &middot; ' + escapeHtml(tl[pkI]) : '') : '') + '</span>' +
                    '<span>today</span></div></div></div>';
        }
        if (kpis.hours && kpis.hours.length) {
            var mxH = 0;
            for (i = 0; i < kpis.hours.length; i++) if (kpis.hours[i] > mxH) mxH = kpis.hours[i];
            html += '<div class="audit-chartbox"><div class="audit-chartbox-k">Busiest hours <span>&middot; opens by hour &middot; all time</span></div>' +
                    '<div class="audit-chartgrid"><div class="audit-ylab" aria-hidden="true"><span>' + fmt(mxH) + '</span><span>0</span></div>' +
                    _auditBarsSvg(kpis.hours, 300, 84, function (hr, v) { return ('0' + hr).slice(-2) + ':00 · ' + v + (v === 1 ? ' view' : ' views'); }) +
                    // Tick captions match the bars' hover format (24h HH:00).
                    '<div class="audit-axis" aria-hidden="true"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>23:00</span></div></div></div>';
        }
        if (kpis.top_viewers && kpis.top_viewers.length) {
            html += '<div class="audit-chartbox"><div class="audit-chartbox-k">Top viewers <span>&middot; opens, all time</span></div>' +
                    _auditRankHtml(kpis.top_viewers, function (it) { return String(it.u || ''); }) + '</div>';
        }
        if (kpis.action_mix && kpis.action_mix.length) {
            html += '<div class="audit-chartbox"><div class="audit-chartbox-k">Action mix <span>&middot; all events, all time</span></div>' +
                    _auditRankHtml(kpis.action_mix, function (it) { return _auditActionLabel(String(it.a || '')); }) + '</div>';
        }
        html += '</div>';
        // (No footer note: the segment bar already carries the "View report
        //  metrics" link, and the extra line pushed Pulse into a scrollbar.)
        $p.html(html);
    }

    // ---- Changes segment: version list + snapshot diff ---------------------
    // (Its "Pop out" is on the Auditor banner - see renderAuditSegBar.)

    // ---- Version-list sub-badges -------------------------------------------
    // UPDATE/ROLLBACK rows carry (or lazily learn) a compact summary of what the
    // save touched: {cats:['sql','code','title','access'], state:N, keys:[...]}.
    // New saves store it server-side in SOURCE_DATA.changed (computed at save
    // time from the two snapshots already in hand - the list pays nothing);
    // older rows are back-filled by _auditPaintDiff the first time their diff
    // is computed. Category logic mirrors penumbraAuditChangeSummary() in
    // db_connection.php - change one, check the other.
    function _auditVerTagsHtml(e) {
        var ch = e && e.SOURCE_DATA && e.SOURCE_DATA.changed;
        if (!ch || (e.ACTION !== 'UPDATE' && e.ACTION !== 'ROLLBACK')) return '';
        var lab = { sql: 'SQL', code: 'code', title: 'title', access: 'access' };
        var tags = [];
        (ch.cats || []).forEach(function (c) {
            if (lab[c]) tags.push('<span class="audit-ver-tag" data-audit-tagcat="' + c + '" title="' + lab[c] + ' changed in this save - click to open the diff at it">' + lab[c] + '</span>');
        });
        var n = parseInt(ch.state, 10) || 0;
        if (n > 0) tags.push('<span class="audit-ver-tag" data-audit-tagcat="state" title="' + n + ' other setting' + (n === 1 ? '' : 's') + ' changed - click to open the diff summary">+' + n + ' setting' + (n === 1 ? '' : 's') + '</span>');
        if (!tags.length) tags.push('<span class="audit-ver-tag tag-noop">no changes</span>');
        var tip = (ch.keys && ch.keys.length)
            ? 'Changed: ' + ch.keys.join(', ')
            : 'This save stored an effectively identical state.';
        return '<span class="audit-ver-t" title="' + escapeHtml(tip) + '">' + tags.join('') + '</span>';
    }

    // Write a freshly computed summary back onto the row (it lives in
    // _auditChangesCache, so later repaints keep it) and its list entry in the
    // surface that was clicked - historical rows grow their sub-badges as
    // their diffs are viewed.
    function _auditStampVerTags(row, sum, $root) {
        if (!row || (row.ACTION !== 'UPDATE' && row.ACTION !== 'ROLLBACK')) return;
        if (!row.SOURCE_DATA || typeof row.SOURCE_DATA !== 'object') row.SOURCE_DATA = {};
        row.SOURCE_DATA.changed = sum;
        var $v = $root.find('.audit-ver[data-audit-ver="' + row.ID + '"]');
        if (!$v.length) return;
        $v.find('.audit-ver-t').remove();
        var html = _auditVerTagsHtml(row);
        if (html) $v.append(html);
    }

    // ---- Version-list filter (category / user) -----------------------------
    // View-only: non-matching rows are hidden, never removed, so selection and
    // the diff pane survive any filter change.
    function _auditVerFilterMatch(row) {
        var vf = _auditVerFilter;
        if (vf.user && String(row.USER_ID || '') !== vf.user) return false;
        if (!vf.cat) return true;
        var isSched = String(row.ACTION).indexOf('SCHEDULE') === 0;
        if (vf.cat === 'report') return !isSched;
        if (vf.cat === 'task') return isSched;
        // Category filters ask "did this save CHANGE that thing" - rows without
        // a summary (creates, deletes, task rows, giant unhealed snapshots)
        // can't answer yes.
        var ch = row.SOURCE_DATA && row.SOURCE_DATA.changed;
        if (!ch) return false;
        var stateN = parseInt(ch.state, 10) || 0;
        if (vf.cat === 'settings') return stateN > 0;
        if (vf.cat === 'noop') return (!ch.cats || !ch.cats.length) && stateN === 0;
        return !!(ch.cats && ch.cats.indexOf(vf.cat) > -1);
    }

    function _auditApplyVerFilter($root) {
        if (!$root || !$root.length) return;
        var byId = {};
        (_auditChangesCache || []).forEach(function (r) { byId[String(r.ID)] = r; });
        var vis = 0, tot = 0;
        $root.find('.audit-ver').each(function () {
            var row = byId[String($(this).attr('data-audit-ver'))];
            tot++;
            var show = row ? _auditVerFilterMatch(row) : true;
            $(this).toggleClass('audit-ver-hidden', !show);
            if (show) vis++;
        });
        var filtered = !!(_auditVerFilter.cat || _auditVerFilter.user);
        var $cnt = $root.find('.audit-vf-count');
        if ($cnt.length) $cnt.text(filtered ? 'Showing ' + vis + ' of ' + tot + ' entries' : '');
        $root.find('.audit-vf-none').toggle(filtered && vis === 0);
    }

    function _auditVerFilterBarHtml() {
        var vf = _auditVerFilter;
        var users = [], seenU = {};
        (_auditChangesCache || []).forEach(function (e) {
            var u = e.USER_ID || '';
            if (u && !seenU[u]) { seenU[u] = 1; users.push(u); }
        });
        users.sort();
        var opt = function (v, label) {
            return '<option value="' + v + '"' + (vf.cat === v ? ' selected' : '') + '>' + label + '</option>';
        };
        return '<div class="audit-verfilter">' +
            '<select class="audit-vf-cat" aria-label="Filter versions by what changed" title="Show only versions of a given type, or that touched a given part of the report">' +
            '<option value="">All entries</option>' +
            '<optgroup label="Type">' + opt('report', 'Report saves') + opt('task', 'Task changes') + '</optgroup>' +
            '<optgroup label="Touched">' + opt('sql', 'SQL') + opt('code', 'Custom code') + opt('title', 'Title') +
            opt('access', 'Access list') + opt('settings', 'Other settings') + opt('noop', 'No-op saves') + '</optgroup>' +
            '</select>' +
            '<select class="audit-vf-user" aria-label="Filter versions by user" title="Show only versions saved by one person">' +
            '<option value="">Everyone</option>' +
            users.map(function (u) {
                var eu = escapeHtml(u);
                return '<option value="' + eu + '"' + (vf.user === u ? ' selected' : '') + '>' + eu + '</option>';
            }).join('') +
            // "Showing X of N entries" while a filter is on (_auditApplyVerFilter):
            // sticky with the selects, so it stays in view as the list scrolls, and
            // a status, so a screen reader hears the new count.
            '</select><span class="audit-vf-count" role="status"></span></div>';
    }

    // root: container to render into, defaulting to the admin Auditor's pane. Each
    // surface CLAIMS the root as it renders, so there is no teardown to forget when
    // the Version History dialog closes.
    // remote: this render is showing a report OTHER than the one loaded in this tab
    // (the repository's per-row Version History link). Claimed on every render, like
    // the root, so no surface has to remember to clear it. The restore handler reads
    // it to decide whether reloading the page would show the restored report or an
    // unrelated one.
    function _auditRenderChanges(shortId, root, remote) {
        _auditChangesRoot = root || '#auditSegChanges';
        _auditChangesRemote = !!remote;
        // A different report's history: the old category/user filter would
        // silently empty the new list, and the cache below would paint the PREVIOUS
        // report's versions under the new id (the repository can open this renderer
        // on any report, so the two ids genuinely differ now).
        if (shortId && _auditChangesShortId && shortId !== _auditChangesShortId) {
            _auditVerFilter = { cat: '', user: '' };
            _auditChangesCache = null;
            _auditDiffCache = {};
            _auditChangesLimit = 100;   // "load older" belongs to the report it was clicked on
        }
        _auditChangesShortId = shortId || _auditChangesShortId;
        var $c = $(_auditChangesRoot);
        if (!$c.length) return;
        if (_auditChangesCache) { _auditPaintChanges(); return; }
        $c.html('<div class="audit-empty-note">Loading version history&hellip;</div>');
        $.ajax({
            url: 'get_audit_log.php', type: 'GET', dataType: 'json',
            data: { id: shortId, fam: 'change', limit: _auditChangesLimit, lite: 1 },
            success: function (r) {
                if (!r || r.status !== 'success' || !r.data) {
                    $c.html('<div class="audit-error-note">' + escapeHtml((r && r.message) || 'Failed to load version history.') + '</div>');
                    return;
                }
                // Rows as fetched, BEFORE the lifecycle filter below - the
                // filter is what makes the visible count smaller than the limit,
                // so only this number can say whether the server truncated.
                _auditChangesFetched = r.data.length;
                // Only the lifecycle actions carry BEFORE/AFTER snapshots (the
                // change family also holds SNAPSHOT_* rows - not versions).
                // SCHEDULE_* lifecycle rows are task versions: same snapshots,
                // same diff, task-flavored restore.
                _auditChangesCache = r.data.filter(function (e) {
                    // RENAME carries a BEFORE/AFTER of {short_id}, so the existing
                    // top-key differ paints it as a plain "short_id: old -> new" chip.
                    // It belongs here rather than only in Events: "what happened to
                    // this report" is the question this view answers.
                    return e.ACTION === 'RENAME' ||
                           e.ACTION === 'UPDATE' || e.ACTION === 'ROLLBACK' || e.ACTION === 'CREATE' || e.ACTION === 'DELETE' ||
                           e.ACTION === 'SCHEDULE_NEW' || e.ACTION === 'SCHEDULE_UPDATE' || e.ACTION === 'SCHEDULE_ENABLE' ||
                           e.ACTION === 'SCHEDULE_DISABLE' || e.ACTION === 'SCHEDULE_DELETE' || e.ACTION === 'SCHEDULE_RESTORE';
                });
                _auditPaintChanges();
            },
            error: function (xhr) {
                if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
                $c.html('<div class="audit-error-note">Failed to load version history.</div>');
            }
        });
    }

    function _auditPaintChanges() {
        var $c = $(_auditChangesRoot);
        var rows = _auditChangesCache || [];
        // Consume the one-shot preselect whether or not it can be honored, so a
        // stale carry-over can never leak into an unrelated later paint.
        var pre = _auditVerPreselect;
        _auditVerPreselect = null;
        if (!rows.length) {
            $c.html('<div class="audit-empty-note">No saved versions yet - report saves and scheduled-task changes will appear here with side-by-side diffs.</div>');
            return;
        }
        var list = rows.map(function (e) {
            var m = moment(e.AUDIT_TIME, 'DD-MMM-YYYY hh:mm:ss A');
            var when = m.isValid() ? m.format('MMM D, YYYY') + ' · ' + m.format('h:mm A') : e.AUDIT_TIME;
            // Scheduler rows carry a server-derived task summary (type +
            // subject) in SOURCE_DATA - ride it on the meta line so "which
            // task?" is answerable from the list alone.
            var meta = e.USER_ID || '';
            if (String(e.ACTION).indexOf('SCHEDULE') === 0 && e.SOURCE_DATA && e.SOURCE_DATA.message) {
                meta += (meta ? ' · ' : '') + _auditTrunc(String(e.SOURCE_DATA.message), 44);
            }
            return '<button type="button" class="audit-ver" data-audit-ver="' + e.ID + '" aria-pressed="false">' +
                   '<span class="audit-ver-h"><span>' + escapeHtml(when) + '</span>' +
                   '<span class="audit-action-badge ' + _auditBadgeClass(e.ACTION) + '">' + _auditActionLabel(e.ACTION) + '</span></span>' +
                   '<span class="audit-ver-m">' + escapeHtml(meta) + '</span>' + _auditVerTagsHtml(e) + '</button>';
        }).join('');
        // Class-only hooks (no ids): the same markup is rendered into either the
        // Auditor pane or the Version History dialog, and duplicate ids across the
        // two would make the diff lookups ambiguous. CSS already targets the classes.
        // The filter bar rides INSIDE the scrolling list as a sticky first child
        // (same trick as the diff's .audit-statechips-sticky) - no layout
        // changes for the surrounding flex row. role=listbox stays on the row
        // wrapper so the filter's selects aren't listbox children.
        // No footer line under the two panes (2026-09-28): it took ~32px of a
        // ~276px docked pane from the list and the diff (56 once it wrapped).
        // What it carried moved to where it is used - the filter count into the
        // filter bar, "Load older versions" to the end of the list it extends,
        // Pop out to the Auditor banner - and its hints were already on screen
        // (Compare to...'s tooltip names Ctrl+click) or are in help (diffs come
        // from the BEFORE/AFTER snapshots every save stores).
        // Say so when the fetch hit its ceiling, where the list runs out: a
        // silently truncated list reads as "this is the whole history".
        var more = _auditChangesFetched >= _auditChangesLimit
            ? '<div class="audit-vermore-row"><span class="audit-vf-capped">The history is longer than the ' + _auditChangesLimit.toLocaleString() +
              ' entries fetched.</span> <button type="button" class="audit-mini-btn" data-audit-vermore="1">Load older versions</button></div>'
            : '';
        $c.html('<div class="audit-chg"><div class="audit-verlist">' + _auditVerFilterBarHtml() +
                '<div class="audit-verrows" role="listbox" aria-label="Restore points">' + list + '</div>' +
                '<div class="audit-vf-none audit-empty-note" style="display:none;">No versions match the filter.</div>' + more + '</div>' +
                '<div class="audit-diff"><div class="audit-diff-head"><span style="color: var(--text-muted, #666);">Select a version</span></div>' +
                '<div class="audit-diff-body"><div class="audit-diff-note">Pick an entry on the left to see exactly what that save changed.</div></div></div></div>');
        _auditCmpAnchor = null;
        _auditCmpArm = null;
        _auditApplyVerFilter($c);
        // Resume on the carried-over entry when one was handed across (pop-out
        // passes the entry being viewed); otherwise select the newest VISIBLE row.
        var $pick = pre ? $c.find('.audit-ver[data-audit-ver="' + pre + '"]').first() : $();
        var carried = $pick.length > 0;
        if (!carried) $pick = $c.find('.audit-ver:not(.audit-ver-hidden)').first();
        if ($pick.length) {
            $pick.trigger('click');
            // Only a carried entry can sit below the fold of the list.
            if (carried && $pick[0].scrollIntoView) $pick[0].scrollIntoView({ block: 'nearest' });
        }
    }

    // $chg = the .audit-chg block to paint into. Passing it in (rather than reading
    // the module-level root) keeps a click in one surface from painting into the
    // other when both the Auditor pane and the Version History dialog are rendered.
    function _auditLoadDiff(row, $chg) {
        var $root = ($chg && $chg.length) ? $chg : $(_auditChangesRoot);
        var $b = $root.find('.audit-diff-body'), $h = $root.find('.audit-diff-head');
        if (!$b.length || !row) return;
        var m = moment(row.AUDIT_TIME, 'DD-MMM-YYYY hh:mm:ss A');
        var when = m.isValid() ? m.format('MMM D, YYYY') + ' · ' + m.format('h:mm A') : row.AUDIT_TIME;
        var acts = '';
        var isSchedRow = String(row.ACTION).indexOf('SCHEDULE') === 0;
        // Comparing two versions has always worked (Ctrl+click a second entry)
        // but nothing on screen said so, so nobody found it. Same code path.
        var cmpBtn = '<button type="button" class="audit-mini-btn" data-audit-cmp-arm="' + row.ID +
                     '" title="Compare this version against another one: click here, then pick the other version in the list. Ctrl+click a version does the same thing.">Compare to&hellip;</button>' +
                     '<button type="button" class="audit-mini-btn" data-audit-verlink="' + row.ID +
                     '" data-audit-verlink-sid="' + escapeHtml(_auditChangesShortId || '') +
                     '" title="Copy a link that opens this exact version. Anyone who can already edit the report can follow it.">Copy link</button>';
        // "Open as of" boots the REPORT with this version's definition (?asof=),
        // where Copy link points at this DIFF (?vh=&ver=). Two different questions,
        // so two buttons rather than one overloaded one. Report states only - a
        // scheduler row's snapshot is a task, not something index.php can boot.
        // The report id is stamped at RENDER time for the same reason Copy link
        // stamps it: _auditChangesShortId belongs to whichever surface rendered
        // last, and reading it at click time builds a URL to the wrong report.
        var asofBtn = '<button type="button" class="audit-mini-btn" data-audit-asof="' + row.ID +
                      '" data-audit-asof-sid="' + escapeHtml(_auditChangesShortId || '') +
                      '" title="Open the report itself with this version\'s query, custom code and settings in place, as a read-only preview. Nothing is written and saving stays switched off until you return to the live report.">Open as of this version</button>';
        if (row.ACTION === 'UPDATE' || row.ACTION === 'ROLLBACK' || row.ACTION === 'CREATE') {
            acts = '<span class="audit-diff-acts">' + cmpBtn + asofBtn + '<a href="#" class="audit-restore-link audit-btn-primary" data-restore-audit-id="' + row.ID + '" title="Writes this entry\'s captured state back as the live report. The current state is logged first (always reversible) and the page reloads when done.">&#8634; Restore this version</a></span>';
        } else if (isSchedRow) {
            // Task versions: restore goes through manage_schedule.php (the
            // snapshot never travels through the browser). DELETE re-creates;
            // NEW restores the initial settings; the rest restore the BEFORE side.
            var schedVerb = row.ACTION === 'SCHEDULE_DELETE' ? 'Re-create this task'
                          : (row.ACTION === 'SCHEDULE_NEW' ? 'Restore initial settings' : 'Restore this version');
            acts = '<span class="audit-diff-acts">' + cmpBtn + '<a href="#" class="audit-restore-link audit-btn-primary" data-sched-restore-audit-id="' + row.ID + '" title="Writes this entry\'s captured task settings back as the live scheduled task. A deleted task is re-created (new task id); a restore that lands active gets a freshly computed next-run. The restore logs its own SCHED RESTORE entry, so it is always reversible.">&#8634; ' + schedVerb + '</a></span>';
        } else {
