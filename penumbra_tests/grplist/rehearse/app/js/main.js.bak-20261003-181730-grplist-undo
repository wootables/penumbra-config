                                }
                                sourceSortKey = msg;
                            } else {
                                const d = log.SOURCE_DATA;
                                const msg = d.message || '';
                                ipVal = d.ip_address || '';

                                if (msg) sourceInfo = escapeHtml(msg);
                                // Context chips replace the old stacked IP/Ref/UA
                                // lines: same data, one line, full value in the
                                // chip's title (hover to read it).
                                if (ipVal) ctxChips.push({ t: ipVal, title: 'IP address: ' + ipVal + ' — click to filter the log to it', q: ipVal });
                                if (d.browser) {
                                    const uaShort = _auditParseUa(d.browser);
                                    ctxChips.push({ t: uaShort || 'UA', title: d.browser });
                                }
                                if (d.referrer) {
                                    const refLabel = _auditRefLabel(d.referrer);
                                    if (refLabel) ctxChips.push({ t: refLabel, title: d.referrer });
                                }
                                sourceSortKey = `${msg} ${ipVal} ${d.referrer || ''}`;
                            }
                        }
                        // Run size on OPEN rows. The columns ride in on the SAME
                        // audit query (get_audit_log.php selects them from the row
                        // it is already reading) - no extra request, no join.
                        // Absent for OPENs recorded before the columns existed, and
                        // for reports that error before returning, so it is only
                        // added when there is a real measurement.
                        if (log.ROW_COUNT !== null && typeof log.ROW_COUNT !== 'undefined' && log.ROW_COUNT !== '') {
                            const _rcRows = Number(log.ROW_COUNT) || 0;
                            const _rcCols = Number(log.COL_COUNT) || 0;
                            const _rcMs   = Number(log.QUERY_MS)  || 0;
                            const _rcCells = _rcRows * _rcCols;
                            const _rcTime = _rcMs >= 1000 ? (_rcMs / 1000).toFixed(1) + 's' : _rcMs + 'ms';
                            ctxChips.push({
                                t: _rcRows.toLocaleString() + '×' + _rcCols + ' · ' + _rcTime,
                                title: _rcRows.toLocaleString() + ' rows × ' + _rcCols + ' columns = '
                                     + _rcCells.toLocaleString() + ' cells, query took ' + _rcTime
                                     + (_rcCells >= 500000 ? ' - large enough to be slow to display'
