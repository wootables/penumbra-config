            // This regex now greedily captures the entire value part after the operator.
            const contextRegex = /\b([a-zA-Z0-9_.]+)\s*(?:LIKE|IN|=)\s*(.*)$/i;
            const match = textBefore.match(contextRegex);

            if (!match) {
                return resolve(null);
            }

            const fullColumnIdentifier = match[1];
            const valuePart = match[2];
            // This captures everything the user is typing, e.g., "'OAK " or "OAK"

            // This correctly extracts the term to search for, stripping quotes and spaces.
            // DELIBERATELY ASYMMETRIC - do NOT convert to stripWrappingQuotePair. valuePart
