        h += '<a class="pnb-crumb-home' + (opts.homeClass ? ' ' + esc(opts.homeClass) : '') + '" href="index.php" title="Go To PENUMBRA Home">' +
             '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false">' +
             '<path d="M3 11 12 3l9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg><span>Penumbra</span></a>';
        if (opts.afterHome) { h += opts.afterHome; }
