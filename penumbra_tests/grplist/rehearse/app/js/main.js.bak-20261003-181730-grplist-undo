    // --- Large-render expectation notice -----------------------------------
    // Building the results table is a SYNCHRONOUS DOM build: from the first
    // createElement to the last appendChild the main thread is blocked solid.
    // In that window the rotating tips stop, and #stopQueryBtn cannot dispatch
    // its click (the event just queues until the build has already finished).
    // The page is therefore indistinguishable from a hang - which is exactly how
    // users report it.
    //
    // Measured 2026-08-20: cost tracks CELLS (rows x columns), ~18 us each and
    // roughly linear to ~2M cells. 25,000 rows of an 83-column report is ~45 s.
    // Since 2026-09-30 a HIDDEN column's cells are built empty (see
    // penumbraFillLazyColumns): ~2 us each, so they count as a tenth of a cell
    // (_PNB_EMPTY_CELL_WEIGHT) and hiding columns does help. The guidance is
    // AUTHOR-ONLY; see penumbraBigRenderNotice() below.
    //
    // This sets expectations only. It deliberately offers NO cancel: there is
    // nothing honest to cancel once the build starts, so Stop is disabled for the
    // duration rather than left sitting there appearing to work.
    const PENUMBRA_BIG_RENDER_CELLS = 250000;        // ~4.5 s measured, ~7 s as quoted
    const _PNB_RENDER_RATE_KEY = 'penumbraRenderRateSamples';
    const _PNB_RENDER_RATE_FALLBACK_US = 18;         // measured 2026-08-20

    // Padding applied to the QUOTED estimate only, never to a recorded sample
    // (2026-08-21). The measured rate is honest about what it times, but the
    // clock stops inside hideLoading(), which runs before the browser has
    // finished laying out and painting a quarter-million-cell DOM - so the wait
    // a user actually sits through has always been longer than the figure we
    // quoted. Padding at display time fixes every machine at once, including
    // ones already carrying low samples in localStorage; padding inside
    // _pnbRecordRenderRate() instead would compound 1.5x per sample and run away.
    const _PNB_RENDER_ESTIMATE_PAD = 1.50;
    // What one EMPTY hidden-column cell costs next to a built one (measured
    // 2026-09-30: ~2 us vs ~18 us). Counted in the estimate AND in the recorded
    // rate, so the two stay in the same unit.
    const _PNB_EMPTY_CELL_WEIGHT = 0.1;
    let _pnbPendingRenderCells = 0;

    function _pnbReadRenderSamples() {
        try {
            const raw = localStorage.getItem(_PNB_RENDER_RATE_KEY);
            if (!raw) return [];
            const parsed = JSON.parse(raw);
            if (!Array.isArray(parsed)) return [];
            return parsed.filter(n => typeof n === 'number' && isFinite(n) && n > 0);
        } catch (e) {
            return [];   // private mode / quota / corrupt value - use the default
        }
    }

    function _pnbRenderRateUsPerCell() {
        const s = _pnbReadRenderSamples();
        if (!s.length) return _PNB_RENDER_RATE_FALLBACK_US;
        // Median, not mean: one run in a backgrounded tab (where the browser
        // throttles timers hard) would otherwise poison the estimate for good.
        s.sort((a, b) => a - b);
        return s[Math.floor(s.length / 2)];
    }

    function _pnbRecordRenderRate(cells, seconds) {
        if (!cells || !(seconds > 0)) return;
        const us = (seconds * 1000000) / cells;
        if (!isFinite(us) || us <= 0 || us > 1000) return;   // implausible - drop it
        try {
            let s = _pnbReadRenderSamples();
            s.push(us);
            if (s.length > 5) s = s.slice(-5);
            localStorage.setItem(_PNB_RENDER_RATE_KEY, JSON.stringify(s));
        } catch (e) { /* never fail a render over a telemetry write */ }
    }

    function _pnbFormatRenderEstimate(secs) {
        if (secs < 45) return 'about ' + Math.max(5, Math.round(secs / 5) * 5) + ' seconds';
        if (secs < 90) return 'about a minute';
        return 'about ' + Math.round(secs / 60) + ' minutes';
    }

    /**
     * Warn before a long synchronous table build.
     * @returns {boolean} true if a notice was shown - the caller MUST then await
     *          penumbraYieldToPaint() so the browser can paint it before the main
     *          thread locks up, or the message never reaches the screen.
     */
    function penumbraBigRenderNotice(rowCount, colCount, emptyColCount, eagerRowCount) {
        const rows = rowCount || 0;
        const cols = colCount || 0;
        // Built cells in full, EMPTY (hidden-column) cells at their weight; +1
        // for the always-built '#' column. Lazy rows (past eagerRowCount) are
        // their '#' cell plus EMPTY cells.
        const empty = Math.min(cols, emptyColCount || 0);
        const eager = (typeof eagerRowCount === 'number') ? Math.min(rows, Math.max(0, eagerRowCount)) : rows;
        const cells = Math.round(eager * ((cols - empty + 1) + empty * _PNB_EMPTY_CELL_WEIGHT)
                                 + (rows - eager) * (1 + cols * _PNB_EMPTY_CELL_WEIGHT));
        if (cells < PENUMBRA_BIG_RENDER_CELLS) return false;

        _pnbPendingRenderCells = cells;

        // Stop the rotator FIRST: it would otherwise overwrite the guidance line
        // during the yield below, and a tip frozen mid-build reads as a hang.
        try { _stopLoadingTips(); } catch (e) { /* non-fatal */ }

        $('#loadingOverlay > p').text(
            'Building the table: ' + rows.toLocaleString() + ' rows by ' +
            cols.toLocaleString() + ' columns. This takes ' +
            _pnbFormatRenderEstimate(
                (cells * _pnbRenderRateUsPerCell() * _PNB_RENDER_ESTIMATE_PAD) / 1000000
            ) +
            ', and the page will not respond until it finishes.'
        );
        // Remediation is AUTHOR-ONLY (2026-08-21). "Narrow the report" and
        // "hide columns" both describe edits to the report
        // DEFINITION; a plain viewer cannot make either, so the line only
        // implies a slow render is somehow their doing. Viewers keep the factual
        // sentence above and get nothing else - _stopLoadingTips() ran a few
        // lines up and already emptied #loadingTip, so skipping this leaves it
        // correctly blank rather than freezing whatever tip was mid-rotation.
        //
        // canEditReport is the same server value as penumbra_vars.isAdmin (both
        // are $canEditLoadedReport) but named for what is actually being asked.
        if (penumbra_vars.canEditReport) {
            // #loadingTip is aria-live="polite", so the guidance is announced too.
            $('#loadingTip')
                .text('To make this faster, narrow the report to fewer rows with a filter or a date range, or hide columns nobody needs.')
                .addClass('is-visible');
        }
        // HIDDEN, not just disabled: a greyed-out Stop still reads as "there is
        // something here you could press", and there genuinely is not - the click
        // cannot be handled until the build it would cancel has already finished.
        // The message above already tells the user the page will not respond.
        $('#stopQueryBtn').hide();
        return true;
    }

    /** Restore Stop after a build. Safe to call when no notice was shown. */
    function penumbraClearBigRenderNotice() {
