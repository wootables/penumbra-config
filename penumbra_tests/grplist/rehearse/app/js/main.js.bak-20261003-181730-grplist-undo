    // up. _pivotFieldIsNumericColumn() samples the first non-blank value, so a
    // 0/1 flag, a small status code or any other low-cardinality number reads
    // as numeric and would sprout "by Bins" children that merely reproduce the
    // raw values one bucket per value. The pivot can afford to offer those (its
    // caret is a deliberate click on a pill you already placed); a dropdown
    // listing every column cannot - it is pure noise there.
    var _groupBinWorthCache = {};
