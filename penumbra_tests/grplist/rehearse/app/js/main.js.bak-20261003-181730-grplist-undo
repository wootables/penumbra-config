$(document).ready(function () {
    // Snappier default UI animations. The dialogs that felt laggy on open all
    // call jQuery .fadeIn() with NO duration → jQuery's 400ms default. Lower the
    // default so those opens feel quick; calls with explicit durations
    // ('fast'/150/200/…) are unaffected. (The prompt/infobox backdrop blur was
    // also lightened — see .modal-prompt-overlay.)
    $.fx.speeds._default = 130;

    // CSRF: tag every same-origin AJAX request with a custom header that the
    // server requires on state-changing endpoints. A cross-site page cannot set a
    // custom header (it would need a CORS preflight the app never grants), so this
    // is what distinguishes our own requests from a forged cross-site one.
    $.ajaxSetup({ headers: { 'X-Penumbra-Csrf': '1' } });
    $("#editorTabs").fadeIn('fast');
    let currentLoadedStateName = null;
    let sortCriteria = [];

    // Max rows in a single [IMPORT] data source. MUST equal
    // PENUMBRA_IMPORT_MAX_ROWS in db_connection.php - the server rejects anything
    // over it, so a client-side copy that drifted high would only turn a clear
    // message into an opaque 400. Drifting LOW is the damaging direction: this
    // copy refuses the upload before the server ever sees it, so a raise here
    // must land with the raise there (both went 20,000 -> 50,000 on 2026-09-10).
    // Declared up here (not beside either consumer) because it is read from two
    // far-apart places: the inline-data fallback in the query POST builder, and
    // the snapshot "Copy to imports" pre-flight.
    var PENUMBRA_IMPORT_MAX_ROWS = 50000;

    // ===== THEME REGISTRY HELPERS ========================================
    // The theme registry is emitted by themes_config.php into
    // window.PENUMBRA_THEMES (+ _THEME_IDS, _THEME_ALIASES) BEFORE this bundle
    // loads. These helpers are the SINGLE read-path for theme data - nothing
    // below should enumerate theme names by hand (no more
    // hasClass('theme-dark-blue') || hasClass('theme-charcoal-gold') || ...).
    var PENUMBRA_THEMES = window.PENUMBRA_THEMES || {};
    var PENUMBRA_THEME_IDS = window.PENUMBRA_THEME_IDS || [];
    var PENUMBRA_THEME_ALIASES = window.PENUMBRA_THEME_ALIASES || {};

    // The registry row for a theme id (falls back to theme-default, then {}).
    function penumbraTheme(themeId) {
        return PENUMBRA_THEMES[themeId] || PENUMBRA_THEMES['theme-default'] || {};
    }
    // True if the given theme id is a registered dark theme.
    function themeIsDark(themeId) {
        var t = PENUMBRA_THEMES[themeId];
        return !!(t && t.isDark);
    }
    // The active theme id. Prefers the data-theme attr applyTheme() stamps,
    // then falls back to scanning the body class list against known ids.
    function currentThemeId() {
        var b = document.body;
        if (!b) return 'theme-default';
        var attr = b.getAttribute('data-theme');
        if (attr && PENUMBRA_THEMES[attr]) return attr;
        var cls = ' ' + (b.className || '') + ' ';
        for (var i = 0; i < PENUMBRA_THEME_IDS.length; i++) {
            var id = PENUMBRA_THEME_IDS[i];
            if (id !== 'theme-default' && cls.indexOf(' ' + id + ' ') !== -1) return id;
        }
        return 'theme-default';
    }
    // True if the active theme is dark. Replaces the old per-name hasClass
    // enumerations scattered through the file.
    function bodyIsDark() {
        return themeIsDark(currentThemeId());
    }
    // Print-clone header/footer palette for the active (or given) theme.
    function getThemePrint(themeId) {
        var p = penumbraTheme(themeId || currentThemeId()).print;
        return p || {};
    }
    // Grouped-email card palette for the active (or given) theme.
    function getThemeEmailGroup(themeId) {
        var g = penumbraTheme(themeId || currentThemeId()).emailGroup;
        return g || {};
    }
    // Excel (ARGB) palette for the active (or given) theme.
    function getThemeExcel(themeId) {
        var x = penumbraTheme(themeId || currentThemeId()).excel;
        return x || {};
    }
    /**
     * Resolve a user-supplied theme name to a registered, non-legacy theme id,
     * or '' when it names no theme (or explicitly asks to inherit).
     *
     * Accepts every spelling an author might reach for: the full id
     * ('theme-midnight'), the bare suffix ('midnight'), a registry alias
     * ('oled'), or the display label ('Midnight (OLED)'). The words
     * 'report' / 'inherit' / 'none' / 'default' mean "leave the active theme
     * alone" and resolve to '' - NOT to theme-default, which is a real theme
     * an author can also pick by name ('light' / 'default-light').
     *
     * Shared by the ?theme= URL override path's sibling checks, the fullscreen
     * action parser, and the Fullscreen Dashboard Action dialog so all three
     * accept exactly the same spellings.
     */
    function penumbraNormalizeThemeId(raw) {
        if (raw == null) return '';
        var s = String(raw).trim().toLowerCase();
        if (!s) return '';
        if (s === 'report' || s === 'inherit' || s === 'none' || s === 'default') return '';
        function _ok(id) {
            var t = PENUMBRA_THEMES[id];
            return (t && !t.legacy) ? id : '';
        }
        if (_ok(s)) return s;
        if (s.indexOf('theme-') !== 0 && _ok('theme-' + s)) return 'theme-' + s;
        if (PENUMBRA_THEME_ALIASES[s] && _ok(PENUMBRA_THEME_ALIASES[s])) return PENUMBRA_THEME_ALIASES[s];
        for (var id in PENUMBRA_THEMES) {
            if (!PENUMBRA_THEMES.hasOwnProperty(id)) continue;
            if (String(PENUMBRA_THEMES[id].label || '').toLowerCase() === s) return _ok(id);
        }
        return '';
    }
    // =====================================================================

    /**
     * Strips a SINGLE matched pair of wrapping quotes (' or ") from a string.
     *
     * Replaces the existing `.replace(/^['"]|['"]$/g, '')` pattern that's scattered
     * across the file - that regex strips a leading-quote OR a trailing-quote
     * INDEPENDENTLY, which corrupts values that contain a legitimate quote at one
     * end only. Example failure: `case_status = 'Active'` starts with `c` (no leading
     * strip) but ends with `'` (trailing strip), yielding `case_status = 'Active`
     * - a syntactically broken search query.
     *
     * The intent of the original regex was clearly "if the user wrote 'value'
     * with outer quotes wrapping the entire arg, drop them" - this helper does
     * exactly that, and only that.
     */
    function stripWrappingQuotePair(s) {
        if (s == null) return s;
        var str = String(s);
        if (str.length < 2) return str;
        var first = str.charAt(0);
        var last = str.charAt(str.length - 1);
        if ((first === "'" && last === "'") || (first === '"' && last === '"')) {
            return str.slice(1, -1);
        }
        return str;
    }

    /**
     * Drops ONE matched quote pair wrapping an infobox payload - the
     * `raw|"...content..."` form, where the quotes sit AFTER the mode prefix
     * instead of around the whole argument.
     *
     * Both forms have to work. parseFunctionArgs honours either when splitting
     * on commas, so authors reach for the inner form whenever the content holds
     * a comma - and it USED to leak its opening quote into the rendered dialog,
     * because the handlers stripped quotes off the argument BEFORE splitting on
     * the pipe, with a regex that ate the trailing quote and left the leading
     * one (see stripWrappingQuotePair above for that regex's failure mode).
     *
     * Whitespace-tolerant around the pair (`raw| "x"` is the same intent), but
     * the INNER content is returned byte-for-byte: a raw| payload's leading
     * newline and indentation are real HTML whitespace.
     *
     * Twins: the action(infobox…) handler in engine A and the one in engine B
     * (resolveInfoboxSnippet). Engine C (schedule_runner.php) strips action()
     * wholesale for email, so it has no copy of this.
     */
    function stripInfoboxPayloadQuotes(s) {
        if (s == null) return s;
        var str = String(s);
        var trimmed = str.trim();
        var stripped = stripWrappingQuotePair(trimmed);
        return stripped === trimmed ? str : stripped;
    }

    let customSortOrders = {};
    let statsQueryWasRun = false;
    let activeSystemQueryTable = null;
    let isClearAllAction = false;
    // True when #reportTitle was auto-populated from a single-table query's table
    // name (rather than typed by the user or loaded from a saved report). Drives the
    // "edit title" pencil and lets a later single-table query refresh the auto-title.
    let titleIsAuto = false;
    // True when an untitled multi-table query returned results: the header shows the
    // generic "Your Report Data" placeholder (display-only, field stays empty) with
    // the same edit pencil. Mutually exclusive with titleIsAuto.
    let autoGenericTitle = false;
    // --- Server Save "copy mode" (see #saveAsCopyBtn, far below) ---------------
    // Armed when the user chooses "Save as Copy": the save writes a freshly minted
    // SHORT_ID instead of the loaded report's, leaving the original untouched.
    // While armed, _serverSaveCopyTitle owns the dialog's Title field and the live
    // #reportTitle is deliberately NOT written - a cancelled dialog must not leave
    // a stray "(copy)" in the report header. Declared up here with the other
    // module-level state because handlers registered near the top of the file
    // (the Title reverse-sync) read them alongside the save code at the bottom.
    let _serverSaveCopyMode = false;
    let _serverSaveCopyTitle = null;
    let _serverSaveCopySourceId = '';
    let timerInterval = null;
    let currentAjaxRequest = null;
    let activeColumnList = [];
    let snippetFunctionMarkers = [];
    let snippetHighlightTimeout;
    let currentUserId = penumbra_vars.currentUserKey;
    let timer = null;
    let isNoAdmView = penumbra_vars.noadm;
    let currentPage = 1;
    let snippetRenderTimeout = null;
    let conditionalFormattingRules = [];
    let rewriteRules = [];
    let masterRowData = [];
    // Rows the report's query last returned on this page (null = no live result:
    // not run yet, an error, a snapshot-only tab). masterRowData is no stand-in -
    // grouping, snapshot and import views swap it. Sizes the scheduler's
    // row-limit banner (updateSchedRowLimitWarning).
    let liveQueryRowCount = null;
    let prePivotSearchTerm = '';
    let emailSettingsInitialized = false;
    let currentPivotSettings = null;
    let currentPivotSourceData = null;
    // Parallel to currentPivotSettings.agg - pre-parsed formula ASTs populated by
    // validatePivotFormulas() before generate, null entries for non-formula rows.
    // Read by generatePivotTable in the second-pass and totals branches.
    let _pivotFormulaASTs = null;
    let pendingPivotSettings = null;
    let _pivotDeferredLoading = false;
    // Mirrors _pivotDeferredLoading for the fullscreen-autoload path: keeps the
    // loading overlay visible through the end-of-render hideLoading so there's
    // no brief flash of the table between the spinner and the carousel mount.
    // Cleared (and a real hideLoading issued) only after openChartCarousel runs
    // or the autoload path bails (e.g. no charts rendered).
    let _fsAutoloadDeferredLoading = false;
    let pendingGroupByColumn = null;
    let pendingGroupAgg = null;
    // One-shot armed by a multi-worksheet file import (_importArmSheetGrouping):
    // the next query start groups by this column in place of the view it would
    // otherwise stash - see the stash in the #executeQuery handler.
    let pendingImportSheetGroup = null;
    // Column sort carried across a re-query (a changed prompt answer, or Run
    // after an SQL edit). The view stash in the query handler already preserves
    // grouping + pivot settings; sort is view state too, so it rides along -
    // but it is re-resolved by NAME against the new headers, so a column that
    // disappeared drops its criterion instead of sorting by a stale index.
    let pendingSortCriteria = null;
    // True when sortCriteria came from somewhere that must be re-applied to the
    // freshly rendered view: a saved report state, a ?sort= override, or the
    // carry-over above. Read by all three on-load view branches (pivot, grouped,
    // flat) - they each apply the sort themselves, so all three must agree.
    let _pnbApplySortOnLoad = false;
    let isStateLoading = false;
    let currentChart = null;
    let snippetChartInstances = [];
    let staleSnippetImages = [];
    let currentVizSnippetCode = '';
    let currentVizChartType = '';
    let currentVizChartTitle = '';
    let lastVisConfig = null;
    let wasSearchTriggeredByLink = false;
    let isContainerized = false;
    let isRowExpandActive = true;
    let originalMasterRowData = null;
    // Grouping level stack (2026-08-29). currentGroupingColumns is AUTHORITATIVE:
    // 0..PENUMBRA_MAX_GROUP_LEVELS tokens, outermost first. currentGroupingColumn
    // is a strict mirror of level 0, written only by setGroupingColumns(), and it
    // still means exactly what it always meant - "the outermost grouping column" -
    // so every existing reader (status bar, snippet resolver, chart reader,
    // compare capture, sort re-render) keeps working unchanged. Nothing reads the
    // mirror to decide DEPTH; that is always currentGroupingColumns.length.
    let currentGroupingColumn = null;
    let currentGroupingColumns = [];
    let currentGroupAgg = null; // {column, type} or null

    // Three, because every level is a sticky header band: nested .group-header
    // rules stack at cumulative top offsets, and three of those plus the table's
    // own thead plus the report header is already most of the vertical budget on
    // a laptop. The tree below is depth-agnostic, so this is a ceiling, not an
    // architectural limit. (Pivot stays the unlimited-depth tool.)
    const PENUMBRA_MAX_GROUP_LEVELS = 3;

    /**
     * Level 0 of a grouping value that may be a whole stack ("COLLEGE,DEPT").
     * Every "does this column still exist?" guard wants this, never the raw
     * value: a saved two-level grouping is one comma-joined string, and testing
     * it whole would decide the column had been removed and silently drop the
     * grouping. Pair it with pivotParseFieldToken().base to also strip a bucket
     * suffix.
     */
    function groupLevel0Of(v) {
        return String(v === null || v === undefined ? '' : v).split(',')[0].trim();
    }

    /**
     * Does a grouping token name one of the report's journal TOGGLE columns
     * (2026-10-02)? A toggle's marks live outside the row data, so no row
     * lookup ever has its name: every "is this grouping's column still in the
     * query?" guard has to ask the journal as well, or a report saved grouped
     * by its toggle came back flat with "the column was removed".
     */
    function groupIsJournalToggle(token) {
        return !!(window.Penumbra && window.Penumbra.journalToggleGroupLabel
            && window.Penumbra.journalToggleGroupLabel(String(token === null || token === undefined ? '' : token).toUpperCase()));
    }

    /**
     * The ONLY writer for the grouping stack. Accepts an array, a single string
     * or null/'' so every existing call shape keeps working, normalises away
     * blanks, and enforces the level ceiling.
     */
    function setGroupingColumns(cols) {
        // A STRING is split on commas, which is what makes the level stack
        // round-trip through every place that already carries a grouping as one
        // string - state.groupBy, pendingGroupByColumn, _svGroupBy, share links,
        // the group| snippet. Comma is the same separator the pivot uses for
        // multiple row fields, and it cannot collide with a bucket token
        // (those split on ':').
        var arr = Array.isArray(cols) ? cols.slice(0)
            : ((cols === null || cols === undefined || cols === '') ? [] : String(cols).split(','));
        arr = arr.map(function (c) { return (c === null || c === undefined) ? '' : String(c).trim(); });
        arr = arr.filter(function (c) { return c !== ''; });
        if (arr.length > PENUMBRA_MAX_GROUP_LEVELS) arr.length = PENUMBRA_MAX_GROUP_LEVELS;
        currentGroupingColumns = arr;
        currentGroupingColumn = arr.length ? arr[0] : null;
        // A new grouping is a fresh outline, so the "start expanded to" default
        // gets one more chance to apply. This is the ONLY writer for the level
        // stack, which makes it the one place that cannot be missed.
        _groupStartDepthApplied = false;
    }

    /**
     * Open the outermost N levels of a freshly rendered grouping.
     *
     * Depth semantics: a wrapper is opened when its OWN depth is < N, so N=1
     * opens the outer bands and reveals their (still closed) children. N=0 is
     * the historical all-collapsed behaviour. Anything >= the level count opens
     * everything.
     *
     * No animation: this runs on the initial render of what can be 716 bands,
     * and jQuery's slideDown would queue an effect per wrapper - the same thing
     * that made Expand All freeze the tab before it was rewritten.
     */
    function _groupApplyStartDepth(depth) {
        if (!depth || depth < 1) return 0;
        var els = document.querySelectorAll('#groupedResultsContainer .group-wrapper[data-group-depth]');
        var n = 0;
        for (var i = 0; i < els.length; i++) {
            var w = els[i];
            if (parseInt(w.getAttribute('data-group-depth'), 10) >= depth) continue;
            w.classList.add('open');
            var c = w.querySelector(':scope > .group-content');
            if (c) c.style.display = 'block';
            n++;
        }
        return n;
    }
    // Strict moment() formats for detecting date columns in group-aggregation Min/Max.
    // SHARED by both aggregation engines: the initial group-render builder in
    // rebuildGroupedView() and the search-time recalculateGroupAggregation(). Keep the
    // two Min/Max date branches in parity - add any new date format HERE only so both
    // engines pick it up. The trailing entries carry a time component (SQL Server
    // datetime with milliseconds, ISO-8601 'T' separator) so date columns that aren't
    // bare YYYY-MM-DD are still recognized as dates rather than parsed to a bare year.
    const PENUMBRA_GROUP_AGG_DATE_FORMATS = [
        'MM/DD/YYYY', 'M/D/YYYY', 'YYYY-MM-DD', 'DD-MMM-YYYY', 'DD-MMM-YY',
        'MMM DD, YYYY', 'MMMM DD, YYYY', 'MM/DD/YYYY HH:mm:ss', 'YYYY-MM-DD HH:mm:ss',
        'MM-DD-YYYY', 'M-D-YYYY',
        'YYYY-MM-DD HH:mm:ss.SSS', 'YYYY-MM-DDTHH:mm:ss', 'YYYY-MM-DDTHH:mm:ss.SSS'
    ];

    // ===== USER-DEFINED COLUMN SUMMARIES =================================
    // The report footer used to be a hard-coded SUM over any column the global
    // `total_exemptions` whitelist (or a '$' sniff) called numeric. It is now a
    // per-column, user-choosable summary. Effective type for one column, first
    // hit wins:
    //
    //   1. user override   localStorage penumbra_column_prefs[report].summaries
    //   2. report default  STATE_DATA .columnSummaries  (set by the report author)
    //   3. global default  currency-or-whitelist => 'sum', otherwise none
    //
    // The layers stay separate rather than being baked into columnProperties at
    // load time, so a report with nothing saved at layers 1-2 renders EXACTLY
    // what it always did.
    //
    // TO ADD A SUMMARY TYPE: add one entry to PENUMBRA_SUMMARY_TYPES below and
    // one to penumbra_summary_types() in schedule_runner.php. Everything else -
    // the settings-panel menu, the badges, the footer keyword, and the
    // email/PDF/XLSX output - is generated from the registry.
    //
    //   label     menu text and badge tooltip
    //   badge     short chip rendered next to the value
    //   header    footer keyword when EVERY summarized column uses this type
    //   numeric   true if the type only makes sense on numbers (menu hint only,
    //             never a hard block - the whitelist misses plenty of real
    //             numeric columns and users must be able to sum those)
    //   dateAware min/max on a date column compare by timestamp but display the
    //             original cell text, mirroring the group-summary engine
    const PENUMBRA_SUMMARY_TYPES = {
        sum:          { label: 'Total',                   badge: 'SUM',   header: 'TOTALS',    numeric: true },
        avg:          { label: 'Average',                  badge: 'AVG',   header: 'AVERAGES',  numeric: true },
        median:       { label: 'Median',                   badge: 'MED',   header: 'MEDIANS',   numeric: true },
        min:          { label: 'Minimum',                  badge: 'MIN',   header: 'MINIMUMS',  numeric: true, dateAware: true },
        max:          { label: 'Maximum',                  badge: 'MAX',   header: 'MAXIMUMS',  numeric: true, dateAware: true },
        range:        { label: 'Range (max - min)',    badge: 'RANGE', header: 'RANGES',    numeric: true },
        stddev:       { label: 'Std Deviation',            badge: 'STDEV', header: 'STD DEVS',  numeric: true },
        count:        { label: 'Count (all rows)',         badge: 'CNT',   header: 'COUNTS',    numeric: false },
        count_filled: { label: 'Count Non-Blank',          badge: 'FILL',  header: 'NON-BLANK', numeric: false },
        count_blank:  { label: 'Count Blank',              badge: 'BLANK', header: 'BLANKS',    numeric: false },
        count_unique: { label: 'Count Unique',             badge: 'UNIQ',  header: 'UNIQUE',    numeric: false },
        mode:         { label: 'Mode (most common)',       badge: 'MODE',  header: 'MODES',     numeric: false },
        antimode:     { label: 'Antimode (least common)',  badge: 'ANTI',  header: 'ANTIMODES', numeric: false },
        formula:      { label: 'Custom Formula',           badge: 'FX',    header: 'FORMULAS',  numeric: true }
    };

    // Variables a custom formula can reference, as {name}. They are all
    // aggregates of THIS column - a formula never reaches across columns. That
    // is deliberate: cross-column arithmetic already exists in the snippet
    // engine (calc(sum(A)/count()) and friends, which also render in scheduled
    // email), and keeping it out of here means no evaluation ordering, no
    // dependency graph and no cycle detection anywhere in the summary engine.
    const PENUMBRA_FORMULA_VARS = [
        'sum', 'count', 'filled', 'blank', 'unique',
        'min', 'max', 'avg', 'median', 'range', 'stddev'
    ];
    // Menu order. Numeric families first, then the counting family, then the
    // frequency pair - matches how people reach for them.
    const PENUMBRA_SUMMARY_ORDER = [
        'sum', 'avg', 'median', 'min', 'max', 'range', 'stddev',
        'count', 'count_filled', 'count_blank', 'count_unique', 'mode', 'antimode',
        'formula'
    ];

    // Registry lookup that cannot be fooled by an inherited Object property.
    // PENUMBRA_SUMMARY_TYPES is an object literal, so a plain
    // `PENUMBRA_SUMMARY_TYPES['constructor']` is TRUTHY - which let a type
    // string of "constructor"/"toString"/"__proto__" pass every validity check
    // and then render the footer keyword as the literal "undefined". Use this
    // everywhere a type string arrives from stored state or the DOM.
    function penumbraSummaryDef(type) {
        return Object.prototype.hasOwnProperty.call(PENUMBRA_SUMMARY_TYPES, type)
            ? PENUMBRA_SUMMARY_TYPES[type]
            : null;
    }

    // Per-report summary config authored by the report owner and stored in
    // STATE_DATA.columnSummaries. Column-NAME keyed (uppercase), exactly like
    // customSortOrders - names survive a re-query, positional colIds do not.
    let reportColumnSummaries = {};

    // The viewer's own overrides, LIVE for this page session.
    //
    // Deliberately not read straight out of localStorage on every resolve: an
    // ad-hoc query that was never saved has no currentLoadedStateName, so
    // saveColumnPrefs()/persistColumnSummaries() correctly refuse to store
    // anything for it - and a resolver that only consulted storage would then
    // silently throw away the summary the user just picked. Column LAYOUT does
    // not have this problem because it is applied directly to the DOM. So the
    // in-memory map is the source of truth for rendering, and localStorage is
    // only the mechanism that carries it across reloads for SAVED reports.
    let userColumnSummaries = {};
    // Which report the live map belongs to, so a re-run of the SAME report keeps
    // the user's unsaved picks while switching reports drops them.
    let _userSummariesKey;

    // TRANSIENT overrides from clicking a badge in the summary row itself.
    //
    // Highest priority, and deliberately never persisted anywhere: this is the
    // "try a different summary right now" affordance, so it evaporates on
    // reload. It sits above the user layer rather than writing to it, which is
    // what lets it work even for a viewer whose column settings the admin has
    // disabled - nothing is being saved, so there is nothing to gate.
    //
    // It does NOT reach anything that saves. The settings panel and the report
    // save resolve through penumbraResolveSummaryPersisted(), so a badge pick
    // is never written into a column layout, a saved report or a ?state= link.
    // A formula typed into a badge's formula box lives beside it, in
    // transientColumnSummaryFormulas.
    let transientColumnSummaries = {};

    // Whether summary type badges render at all. Same layering as the summaries
    // themselves: a user override wins, else the report's setting, else on.
    // The report-level value is what scheduled email/PDF/XLSX can see.
    let reportSummaryBadges = true;
    let userSummaryBadges = null;   // null = inherit from the report
    function penumbraSummaryBadgesOn() {
        // A badge is now an interactive control - click it to change the summary
        // - so when the report author has switched column customization off for
        // non-admins, the badges go with it. Leaving them would advertise an
        // action that surface is not allowed to take.
        //
        // Browser-only: scheduled email/PDF badges are inert labels, not
        // controls, and a mailed report has no "viewer" to be a non-admin.
        if (!penumbra_vars.isAdmin && window._penumbraHideColumns) return false;
        if (typeof userSummaryBadges === 'boolean') return userSummaryBadges;
        return reportSummaryBadges !== false;
    }

    // Frozen leading columns of the FLAT table. Same two layers as the badge
    // toggle above: the viewer's own pick wins, else the report's saved count,
    // else none. The report-level value is what scheduled XLSX can see.
    //
    // It is a COUNT - "the first N VISIBLE columns, whatever they are", a
    // visible '#' row-number column included - and deliberately not a
    // per-column flag. A flag can say "freeze column 7 but not 1-6", which
    // neither position:sticky nor an Excel pane can express; a count cannot.
    // The pivot's cap of 3 comes from its three hard-coded sticky classes. There
    // is no such limit here, so the cap is just a sanity bound - what actually
    // protects a narrow window is the width guard in _frzApply().
    const PENUMBRA_FROZEN_COLS_MAX = 5;
    let reportFrozenCols = 0;
    let userFrozenCols = null;      // null = inherit from the report
    // Twin of penumbra_flat_frozen_cols() in schedule_runner.php - keep the two
    // in LOCKSTEP. visibleCount 0 means "not known yet" (no table): cap only.
    function penumbraClampFrozenCols(n, visibleCount) {
        n = parseInt(n, 10);
        if (isNaN(n) || n < 0) n = 0;
        if (n > PENUMBRA_FROZEN_COLS_MAX) n = PENUMBRA_FROZEN_COLS_MAX;
        // Never freeze every column - at least one has to scroll.
        if (visibleCount > 0 && n >= visibleCount) n = visibleCount - 1;
        return n < 0 ? 0 : n;
    }
    function penumbraFrozenColsWanted() {
        if (typeof userFrozenCols === 'number') return penumbraClampFrozenCols(userFrozenCols, 0);
        return penumbraClampFrozenCols(reportFrozenCols, 0);
    }

    // Column widths of the FLAT table (2026-09-24). js/penumbra_colwidths.js
    // owns everything you can see or touch - the header grips, the + / - / 0
    // keys and the generated width stylesheet. This is only the STATE, kept
    // here so it outlives that module being switched off
    // (js/penumbra_colwidths.off): a report saved meanwhile still carries the
    // widths its author set.
    //
    // Two layers, the frozen count's rule above: the viewer's pick wins, else
    // the report's saved width, else the column sizes to its content exactly
    // as it always has. Keyed by UPPERCASE column NAME like columnSummaries, so
    // moving, hiding or renaming a column never points a width at the wrong
    // one - a name the query no longer returns simply matches nothing.
    const PENUMBRA_COLW_MIN = 40, PENUMBRA_COLW_MAX = 2000;
