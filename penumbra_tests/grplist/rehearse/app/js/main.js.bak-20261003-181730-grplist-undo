            if (aggResult !== null) {
                let formatted;
                if (aggResultText) {
                    formatted = aggResultText;          // date text, or a mode/antimode winner
                } else if (_rcaRes.kind === 'int') {
                    formatted = aggResult.toLocaleString();
                } else {
                    // avg/stddev want at least 2 decimals; the rest follow the
                    // column's own precision, exactly as before.
                    const _dec = (aggType === 'avg' || aggType === 'stddev')
                        ? Math.max(_rcaRes.decimals || 0, 2) : (_rcaRes.decimals || 0);
                    formatted = aggResult.toLocaleString(undefined,
                        { minimumFractionDigits: _dec, maximumFractionDigits: _dec });
                    if (_rcaRes.isCurrency) formatted = '$' + formatted;
                    if (_rcaRes.isPercent) formatted = formatted + '%';
                }
                const $aggSpan = $('<span class="group-agg-summary"></span>');
                $aggSpan.append($('<span class="group-agg-label"></span>')
                    .text((_GROUP_AGG_LABELS[aggType] || aggType) + ' of ' + currentGroupAgg.column + ': '));
                $aggSpan.append($('<span class="group-agg-value"></span>').text(formatted));
                $groupHeader.append($aggSpan);
                // Raw value so the search bar can filter groups by summary.
                $groupWrapper.attr('data-agg-value', aggResult);
                if (_rcaRes.kind === 'date') $groupWrapper.attr('data-agg-isdate', '1');
            }
        }

        // Every wrapper at every depth. A leaf's find() reaches its own rows; a
        // BRANCH's reaches every row beneath it, so a nested level totals its
        // whole subtree without any extra bookkeeping.
        //
        // children('.group-header'), NOT find(): find() on a branch also matches
        // every descendant band, and jQuery's append() to a multi-element set
        // CLONES the node - the branch's total would be stamped onto all of its
        // children's headers as well as its own.
        // Native collection: a Sizzle `tr:not(.search-hidden):not(...)` scan per
        // wrapper is a full subtree walk with two negation filters, and with
        // nesting every row sits under several wrappers. querySelectorAll +
        // classList is the same answer without the selector engine.
        function _rcaRowsIn(el) {
            var all = el.querySelectorAll('tbody tr'), out = [];
            for (var i = 0; i < all.length; i++) {
                var cl = all[i].classList;
                if (!cl.contains('search-hidden') && !cl.contains('journal-note-child')) out.push(all[i]);
            }
            return out;
        }

        var _rcaWrappers = document.querySelectorAll('#groupedResultsContainer .group-wrapper');
        for (var _wi = 0; _wi < _rcaWrappers.length; _wi++) {
            var _w = _rcaWrappers[_wi];
            var $w = $(_w);
            var $h = $w.children('.group-header');
            $h.children('.group-agg-summary').remove();
            $w.removeAttr('data-agg-value').removeAttr('data-agg-isdate');
            var _rows = _rcaRowsIn(_w);
            if (!_rows.length) continue;
            _rcaApply($w, _rows, _w.getAttribute('data-group-key') || '', $h);
        }

        _groupRenderGrandTotal(_rcaApply, _rcaRowsIn);
        _groupRenderShares();
    }

    /**
     * "% of total" and "% of parent" on each band (2026-08-30).
     *
     * Pure arithmetic over the values the pass above already stamped as
     * data-agg-value - nothing is re-aggregated, so this cannot disagree with
     * the numbers it annotates and costs one walk of the wrappers.
     *
     * ONLY for sum and count. Those are the two configured types whose parts
     * genuinely add up to the whole, so a share is a true share. A percentage of
     * an avg, a min or a max is meaningless; and for count_distinct the
     * children's shares do NOT total 100% (one person can appear under several
     * departments), which reads as an error in the data rather than a property
     * of the measure. Better to show nothing than a number that invites a wrong
     * conclusion.
     */
    function _groupRenderShares() {
        var root = document.getElementById('groupedResultsContainer');
        if (!root) return;
        var old = root.querySelectorAll('.group-agg-share');
        for (var oi = 0; oi < old.length; oi++) old[oi].parentNode.removeChild(old[oi]);
        if (!currentGroupAgg) return;
        var type = currentGroupAgg.type;
        // ALLOW-list, deliberately: a share only means something when the
        // siblings' parts add up to the parent. Blank counts do (2026-08-30);
        // median/range/stddev/mode/antimode and the distinct count do not, so
        // the new vocabulary is silently excluded by not being listed.
        if (type !== 'sum' && type !== 'count' && type !== 'count_blank') return;

        var bar = root.querySelector(':scope > .group-grand-total');
        var totalRaw = bar ? parseFloat(bar.getAttribute('data-agg-value')) : NaN;
        if (!isFinite(totalRaw) || totalRaw === 0) return;   // no denominator, no share

        function pct(part, whole) {
            var v = (part / whole) * 100;
            if (!isFinite(v)) return null;
            // A share that merely ROUNDS to zero is not zero. On a report with
            // 248 departments most bands are a fraction of a percent, and
            // printing "0% of total" next to a band that plainly has rows reads
            // as a bug rather than as a small number. Below the display
            // precision, say that instead.
            if (v !== 0 && Math.abs(v) < 0.05) return (v < 0 ? '>-0.1%' : '<0.1%');
            // One decimal, but never a trailing ".0" - "38%" beats "38.0%".
            return v.toFixed(1).replace(/\.0$/, '') + '%';
        }

        var wrappers = root.querySelectorAll('.group-wrapper');
        for (var i = 0; i < wrappers.length; i++) {
            var w = wrappers[i];
            var val = parseFloat(w.getAttribute('data-agg-value'));
            if (!isFinite(val)) continue;
            var summary = w.querySelector(':scope > .group-header > .group-agg-summary');
            if (!summary) continue;
            var bits = [];
            // % of PARENT only when there is a parent band. At depth 0 the parent
            // IS the whole set, so the two figures would be the same number
            // printed twice.
            var parent = w.parentElement ? w.parentElement.closest('.group-wrapper') : null;
            if (parent) {
                var pv = parseFloat(parent.getAttribute('data-agg-value'));
                if (isFinite(pv) && pv !== 0) {
                    var p = pct(val, pv);
                    if (p) bits.push(p + ' of parent');
                }
            }
            var t = pct(val, totalRaw);
            if (t) bits.push(t + ' of total');
            if (!bits.length) continue;
            var span = document.createElement('span');
            span.className = 'group-agg-share';
            span.textContent = bits.join(' · ');
            summary.appendChild(span);
        }
    }

    /**
     * The grand total bar: the same aggregate over EVERY visible row, pinned to
     * the bottom of the grouped view (2026-08-30). Without it the per-group
     * numbers have nothing to be a share OF, and nobody can check that the parts
     * sum to the whole without leaving the view.
     *
     * Rendered only when a per-group summary is configured - the status bar
     * already carries the row and group counts, so an empty bar would just be
     * another line saying what is already on screen.
     *
     * `applyFn` is recalculateGroupAggregation()'s own inner computation, passed
     * in rather than reimplemented so the total and the groups can never drift.
     */
    function _groupRenderGrandTotal(applyFn, rowsInFn) {
        var $c = $('#groupedResultsContainer');
        $c.children('.group-grand-total').remove();
        if (!currentGroupAgg || !$c.length || !$c.is(':visible')) return;
        // Rows live only in LEAF tables, so one container-wide sweep counts each
        // row exactly once however many levels are stacked above it.
        var $rows = rowsInFn(document.getElementById('groupedResultsContainer'));
        if (!$rows.length) return;
        var $bar = $('<div class="group-grand-total"></div>');
        var $hdr = $('<div class="group-header ggt-header"></div>');
        $hdr.append($('<span class="group-name"></span>').text('All groups'));
        $hdr.append($('<span class="group-count"></span>').text($rows.length.toLocaleString()));
        $bar.append($hdr);
        // null, not '': tells the computation there is no single group key to
        // correlate a nested @@JSON value against.
        applyFn($bar, $rows, null, $hdr);
        $c.append($bar);
    }

    function generateTotalRow(rowDataMaps, visibleColumnOrder, showPaginationLink = true) {
        const mainColumnProperties = $("#resultsTable").data('columnProperties');
        const columnNameToOriginalIndex = $("#resultsTable").data('columnNameToOriginalIndex');

        if (!rowDataMaps || rowDataMaps.length === 0 || !mainColumnProperties || !columnNameToOriginalIndex) {
            return null;
        }

        // Per-column summary types, same three-layer resolution the flat footer
        // uses - so a group footer and the flat footer never disagree about what
        // a column means.
        const summaryTypes = penumbraResolveSummaries();
        const visibleColumnSet = new Set(visibleColumnOrder); // O(1) per-cell lookups below
        const accs = {};
        visibleColumnOrder.forEach(colId => {
            const type = summaryTypes[colId];
            // The accumulator resolves the toggle rule and any custom formula
            // from the column NAME, so map the positional id back to it.
            if (type) accs[colId] = penumbraSummaryAccumulator(type,
                $('#tableHeader th[data-column="' + colId + '"]').attr('data-colname') || colId);
        });
        if (Object.keys(accs).length === 0) {
            return null;
        }

        rowDataMaps.forEach(rowMap => {
            for (const [colName, cellVal] of rowMap.entries()) {
                const colId = columnNameToOriginalIndex[colName];
                if (colId === undefined)
                    continue;

                if (!visibleColumnSet.has(colId))
                    continue;

                if (accs[colId]) accs[colId].push(cellVal);
            }
        }
        );

        const totals = {};
        const typesShown = [];
        Object.keys(accs).forEach(colId => {
            const res = accs[colId].finish();
            if (res === null) return;
            totals[colId] = res;
            typesShown.push(summaryTypes[colId]);
        });

        // An all-zero footer is noise, and suppressing it is long-standing
        // behaviour here (the flat footer does not do this). Only NUMERIC
        // results count toward "all zero" - a legitimate count/mode result keeps
        // the footer alive.
        const numericResults = Object.keys(totals)
            .map(k => totals[k])
            .filter(r => r.kind === 'num');
        if (typesShown.length === 0 ||
            (numericResults.length === Object.keys(totals).length &&
             numericResults.every(r => r.value === 0))) {
            return null;
        }

        const footerLabel = penumbraSummaryHeaderLabel(typesShown);
        const isMixed = (footerLabel === 'SUMMARY');

        const $tfoot = $('<tfoot>');
        const $totalDataTr = $('<tr class="total-row-data">');
        // Row for the numbers
        const $totalLinkTr = $('<tr class="total-row-link">');
        // Row for the link

        let totalsLabelPlaced = false;
        visibleColumnOrder.forEach(colId => {
            const $td = $('<td>').attr('data-column', colId);
            // Journal columns keep their class here too (see updateTotalRow):
            // the HTML copy / email embed drop the Notes column by class.
            if (String(colId).indexOf('__JOURNAL_TOGGLE') === 0) $td.addClass('journal-toggle-col');
            else if (colId === '__JOURNAL_NOTES') $td.addClass('journal-notes-col');
            if (colId === '#') {
                $td.addClass('pnb-sum-label').html('<strong>' + escapeHtml(footerLabel) + '</strong>');
                totalsLabelPlaced = true;
            } else if (!totalsLabelPlaced && totals[colId] === undefined) {
                // Place the keyword in the first unsummarized column if # wasn't visible
                $td.addClass('pnb-sum-label').html('<strong>' + escapeHtml(footerLabel) + '</strong>');
                totalsLabelPlaced = true;
            } else if (totals[colId] !== undefined) {
                const type = summaryTypes[colId];
                const props = mainColumnProperties[colId];
                const formattedTotal = penumbraFormatSummary(totals[colId], type, {
                    isCurrency: props ? !!props.isCurrency : undefined
                });
                // See generateComparisonTotalRow: the type is stamped so an
                // in-place recompute re-runs this summary rather than a sum.
                $td.attr('data-sum-type', type);
                var _cn = $('#tableHeader th[data-column="' + colId + '"]').attr('data-colname');
                if (_cn) $td.attr('data-sum-col', _cn);
                $td.html('<strong>' + escapeHtml(formattedTotal) + '</strong>' +
                         penumbraSummaryBadgeHtml(type, isMixed, _cn));
            }
            $totalDataTr.append($td);
        }
        );

        // Create the new link row with a cell spanning all visible columns
        const colspan = visibleColumnOrder.length;
        $tfoot.append($totalDataTr);
        // Append the data row once, outside the condition.

        // This now correctly makes the link row OPTIONAL
        if (showPaginationLink) {
            const colspan = visibleColumnOrder.length;
            const $totalLinkTr = $('<tr class="total-row-link">');
            $totalLinkTr.append(`<td colspan="${colspan}"><a href="#" id="viewLastPageLink">View Last Page to see the summary row</a></td>`);
            $tfoot.append($totalLinkTr);
        }

        return $tfoot;

    }

    /**
 * Generates a tfoot total row specifically for the snapshot comparison view.
 * This version does not rely on the main table's metadata and instead derives
 * numeric columns directly from the data provided. It now correctly uses the
 * global totalExemptionList.
 * @param {Map<string, string>[]} rowDataMaps - An array of Map objects for the rows in the group.
 * @param {string[]} columnList - The ordered list of column names for the table.
 * @returns {jQuery|null} A jQuery object for the tfoot element, or null if no totals can be calculated.
 */
    // True when the user has hidden the "#" (row number) column on the flat table.
    // The snapshot-comparison renderers mirror that instead of always forcing "#"
    // visible, so the diff's columns match the rest of the app. The cell/header is
    // still emitted (just display:none) because row lookups, totals and exports all
    // read [data-column="#"].
    function _isNumColHidden() {
        var th = document.querySelector('#tableHeader th[data-column="#"]');
        return !!th && th.style.display === 'none';
    }

    function generateComparisonTotalRow(rowDataMaps, columnList) {
        if (!rowDataMaps || rowDataMaps.length === 0) {
            return null;
        }

        // Per-column summary types. This renderer has no columnProperties to
        // consult, so the global layer resolves off the raw whitelist - the same
        // test this function used inline before. User and report overrides still
        // apply, so a diff footer agrees with the flat footer.
        const summaryTypes = new Map();
        const accs = new Map();
        columnList.forEach(colName => {
            if (colName === '#') return;
            const type = penumbraResolveSummaryForName(colName, null);
            if (!type) return;
            summaryTypes.set(colName, type);
            accs.set(colName, penumbraSummaryAccumulator(type, colName));
        });

        rowDataMaps.forEach(rowMap => {
            accs.forEach((acc, colName) => {
                acc.push(rowMap.get(colName));
            });
        }
        );

        const totals = new Map();
        const typesShown = [];
        accs.forEach((acc, colName) => {
            const res = acc.finish();
            if (res === null) return;
            totals.set(colName, res);
            typesShown.push(summaryTypes.get(colName));
        });

        // If nothing summarized, don't create a footer.
        if (totals.size === 0) {
            return null;
        }

        const footerLabel = penumbraSummaryHeaderLabel(typesShown);
        const isMixed = (footerLabel === 'SUMMARY');

        // Build the tfoot HTML
        const $tfoot = $('<tfoot>');
        const $tr = $('<tr>');

        // The "#" cell normally carries the keyword, but it's hidden when the
        // user has hidden the row-number column - keep the cell (row/export lookups
        // read td[data-column="#"]) and move the label to the first non-numeric
        // column instead, mirroring generateTotalRow() for the flat table.
        const numHidden = _isNumColHidden();
        let totalsLabelPlaced = !numHidden;
        $tr.append('<td data-column="#" class="pnb-sum-label"' + (numHidden ? ' style="display:none"' : '') + '>'
            + (numHidden ? '' : '<strong>' + escapeHtml(footerLabel) + '</strong>') + '</td>');

        // Iterate through the master column list to maintain order. Each cell
        // carries the POSITIONAL data-column id the comparison body cells use -
        // without it, recomputeWrapperTotals' td[data-column=...] lookup matched
        // nothing and a search over an A-vs-B diff rewrote every total to 0.
        columnList.forEach((colName, index) => {
            if (colName === '#')
                return;

            const $td = $('<td>').attr('data-column', index);
            if (totals.has(colName)) {
                const type = summaryTypes.get(colName);
                // No columnProperties here (this footer is built from a bare
                // column list), so the formatter falls back to its own '$' sniff.
                const formattedTotal = penumbraFormatSummary(totals.get(colName), type);
                // Stamp the type + source column so a later in-place recompute
                // (recomputeWrapperTotals, on every search) can re-run the SAME
                // summary instead of blind-summing the cell back to a total.
                $td.attr('data-sum-type', type).attr('data-sum-col', colName);
                $td.html('<strong>' + escapeHtml(formattedTotal) + '</strong>' +
                         penumbraSummaryBadgeHtml(type, isMixed, colName));
            } else if (!totalsLabelPlaced) {
                $td.addClass('pnb-sum-label').html('<strong>' + escapeHtml(footerLabel) + '</strong>');
                totalsLabelPlaced = true;
            }
            $tr.append($td);
        }
        );

        $tfoot.append($tr);
        return $tfoot;
    }

    // Navigation Safety Check (Breadcrumb Links). .safe-home-link = the trail's
    // home step (always index.php); .safe-nav-link (2026-09-09) = the trail's
    // short-ID reload link, same unsaved-work confirm, navigates to its own
    // href. Modifier/middle clicks open a new tab and leave this page intact,
    // so they pass through untouched.
    $(document).on('click', '.safe-home-link, .safe-nav-link', function (e) {
        // Non admins cant make changes
        if (!penumbra_vars.isAdmin) {
            return;
        }
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.which === 2) {
            return;
        }

        // Prevent immediate navigation so we can check for unsaved work
        e.preventDefault();

        const isHome = $(this).hasClass('safe-home-link');
        const target = isHome ? 'index.php' : ($(this).attr('href') || 'index.php');

        // Check if there is content in the editors or title box
        const hasContent = getQuery().trim() !== "" || getSnippet().trim() !== "" || $("#reportTitle").val().trim() !== "" || $("#reportSubtitle").val().trim() !== "";

        // If there is content, confirm with the user
        const msg = isHome
            ? "Return to Home Screen? Any unsaved changes will be lost."
            : "Reload this report? Any unsaved changes will be lost.";
        if (hasContent && !confirm(msg)) {
            return;
        }

        window.location.href = target;
    });

