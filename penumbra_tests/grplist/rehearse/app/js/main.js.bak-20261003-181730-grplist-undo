    // (Removed: dead pre-unified #snapUseAllCols / #snapCustomKeySelector toggle handlers + updateSnapColumnWarning - they drove the old two-tab key picker, now replaced by the unified column panel.)
    /**
     * Returns the snapshot's column names (uppercase, no "#") - works for
     * both local-storage snapshots (which carry `columnNames` in metadata)
     * and server snapshotObjs built in the compare handler (which only carry
     * `compressedData`, requiring a decompress pass).
     */
    // Journal-column context for the comparison column-set logic. The live
    // headers carry the raw sentinel (__JOURNAL_TOGGLE__done / __JOURNAL_NOTES)
    // while snapshots store the friendly name (DONE), so a naive set-diff reported
    // the SAME toggle as "only in current" (sentinel) AND "only in snapshot"
    // (friendly), plus Notes as a phantom "only in current". These normalize both
    // sides through the one authoritative map so the warning / sync prompt only
    // fire on REAL differences.
    function _journalCompareToggleInfo() {
        var map = (window.Penumbra && window.Penumbra.journalToggleColumnMap) ? window.Penumbra.journalToggleColumnMap() : [];
        var sentinelToName = {}, nameSet = {};
        map.forEach(function (e) {
            sentinelToName[String(e.sentinel).toUpperCase()] = String(e.name).toUpperCase();
            nameSet[String(e.name).toUpperCase()] = true;
        });
        return {
            sentinelToName: sentinelToName,
            nameSet: nameSet,
            isNotes: (window.Penumbra && window.Penumbra.journalIsNotesCol) ? window.Penumbra.journalIsNotesCol : function () { return false; },
            include: $('#snapIncludeToggles').is(':checked')
        };
    }
    // Drop toggle column names from a snapshot's column list when the user is NOT
    // comparing toggles - so a captured DONE column doesn't read as a difference.
    function _stripTogglesIfOff(cols) {
        if (!cols) return cols;
        var info = _journalCompareToggleInfo();
        if (info.include) return cols;
        return cols.filter(function (c) { return !info.nameSet[String(c).toUpperCase()]; });
    }

    function _getSnapshotColumnNames(snapshot) {
        if (snapshot && snapshot.columnNames && snapshot.columnNames.length > 0) {
            return snapshot.columnNames.slice();
        }
        if (!snapshot || !snapshot.compressedData) return null;
        try {
            var tmpData = JSON.parse(decompressString(snapshot.compressedData));
            if (tmpData.length > 0 && tmpData[0].rowData) {
                var cols = [];
                for (var k in tmpData[0].rowData) {
                    if (tmpData[0].rowData.hasOwnProperty(k)) {
                        var u = k.toUpperCase();
                        if (u !== '#') cols.push(u);
                    }
                }
                cols.sort();
                return cols;
            }
        } catch (e) {}
        return null;
    }

    /**
     * Reads the current live view's column names (uppercase, no "#") from
     * the visible table header. Used by the column-sync prompt to compute
     * the intersection with the snapshot's column set.
