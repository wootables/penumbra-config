    // Pulls the visible "#resultCount" text but expands the "*" tooltip that
    // pivot mode renders into an inline parenthetical. The live UI shows the
    // source-transaction breakdown on hover via a title attribute; a static
    // artifact (an email body, an XLSX header block) can't surface a hover
    // tooltip, so we splice the tooltip text inline - otherwise the reader
    // gets a bare, meaningless "*". Same treatment the footer status bar
    // applies for on-screen display (updateRows). Returns plain text for
    // direct embedding (callers still escape if injecting into HTML).
    function getExpandedResultCount() {
        const $rc = $('#resultCount');
        if (!$rc.length) return '';
        const $clone = $rc.clone();
        $clone.find('span[title]').each(function () {
            const t = ($(this).attr('title') || '').trim();
            if (t) {
                // Use a text node so any HTML chars in the tooltip are treated as text.
                this.parentNode.replaceChild(document.createTextNode(' (' + t + ')'), this);
            } else {
                this.parentNode.removeChild(this);
            }
        });
        return $clone.text().replace(/\s+/g, ' ').trim();
    }

    // Effective value of a query-prompt chip (#promptInfoList li a) for static
    // exports (email header pills, PDF cover, XLSX header). For standard chips
    // the anchor's title attr holds the FULL value (the visible <strong> text
    // is truncated at 50 chars), so prefer it. URL-locked chips
    // (.is-url-conflict / .is-url-overridden) repurpose the title as an
    // explanatory tooltip ("Value locked by URL parameter..."), so those must
    // fall back to the displayed <strong> text - otherwise exports embed the
    // tooltip text as the prompt's value.
    function promptChipExportValue($link) {
        const shown = $link.find('strong').first().text().trim();
        if ($link.hasClass('is-url-conflict') || $link.hasClass('is-url-overridden')) {
            return shown;
        }
        return ($link.attr('title') || '').trim() || shown;
    }

    // Renders the prompt list (#promptInfoList) as themed pills. Mirrors
    // _render_param_pills() in schedule_runner.php (same 50-char truncation
    // with full value on hover via title attr, same pill chrome).
    function renderEmailParamPills(theme) {
        const pairs = [];
        $('#promptInfoList li a').each(function () {
            const $link = $(this);
            const value = promptChipExportValue($link);
            // The chip's <em> text already ends with ":" (see the prompt-list
            // builder) and the pill template below appends its own - strip the
            // chip's so the email doesn't read "PI:: value". Same treatment as
            // _penumbraExportContext.
            const label = $link.find('em').text().replace(/:\s*$/, '').trim();
            if (label && value) pairs.push({ label, value });
        });
        if (pairs.length === 0) return '';

        const pillStyle = `display: inline-block; background-color: ${theme.pillBg}; border: 1px solid ${theme.pillBorder}; border-radius: 20px; padding: 3px 10px; margin: 0 4px 4px 0; font-size: 12px; font-family: Verdana, sans-serif;`;
        let html = `<div style="margin: 8px 0 0; line-height: 2.4;">`;
        pairs.forEach(({ label, value }) => {
            const truncated = value.length > 50;
            const displayValue = truncated ? value.substring(0, 50) + '...' : value;
            const titleAttr = truncated ? ` title="${escapeHtml(value)}"` : '';
            html += `<span style="${pillStyle}">`
                + `<span style="color: ${theme.pillLabel}; font-weight: 500;">${escapeHtml(label)}:</span> `
                + `<strong style="color: ${theme.pillValue};"${titleAttr}>${escapeHtml(displayValue)}</strong>`
                + `</span> `;
        });
        html += `</div>`;
        return html;
    }

