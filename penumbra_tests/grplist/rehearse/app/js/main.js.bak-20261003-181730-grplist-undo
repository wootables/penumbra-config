            // third level to go, and silently dropping it would misrepresent
            // the view the reader is looking at.
            warn.push('This grouping has ' + _gLevels.length + ' levels, but a chart has room for '
                + 'an X axis and one series. Level 1 became the X axis and level 2 the series; '
                + 'the deeper level' + (_gLevels.length > 3 ? 's are' : ' is') + ' not plotted.');
