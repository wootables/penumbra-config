                    // saved values may no longer match the new parent value.
                    // We do NOT touch unrelated 'nosave' prompts (especially the
                    // parent of the prompt we just edited), otherwise editing a
                    // child would force the parent dialog open again on rerun.
                    const editedName = parsedPrompt.name;
                    if (editedName) {
                        const otherPromptsRegex = /\[\s*PROMPT[^\]]*\]/gi;
                        let otherMatch;
                        while ((otherMatch = otherPromptsRegex.exec(allQueries)) !== null) {
                            const otherKey = getPromptStorageKey(otherMatch[0]);
                            if (otherKey === storageKey)
