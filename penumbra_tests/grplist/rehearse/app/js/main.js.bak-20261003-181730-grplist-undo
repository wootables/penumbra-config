    // --- Helper: Replicate PHP's cron check logic exactly ---
    function checkCronPart(pattern, value) {
        if (pattern === '*')
            return true;

        // Step syntax (e.g., */5 or 5/15)
        if (pattern.includes('/')) {
            const [base, step] = pattern.split('/');
            const stepNum = parseInt(step, 10);
            if (base === '*') {
                return (value % stepNum) === 0;
            }
            const baseNum = parseInt(base, 10);
            return (value >= baseNum) && ((value - baseNum) % stepNum) === 0;
        }

        // List syntax (e.g., 1,2,3)
        if (pattern.includes(',')) {
            return pattern.split(',').some(p => parseInt(p, 10) === value);
        }

        // Range syntax (e.g., 1-5)
        if (pattern.includes('-')) {
            const [min, max] = pattern.split('-');
            return value >= parseInt(min, 10) && value <= parseInt(max, 10);
        }

        // Exact match
        return parseInt(pattern, 10) === value;
    }

    // --- Helper: Find the next valid run date ---
    function calculateNextCronRun(expression) {
        const parts = expression.trim().split(/\s+/);
        if (parts.length !== 5)
            return null;

        const now = new Date();
        const oneYearInMinutes = 525600;

        let pointer = new Date(now.getTime());
        pointer.setSeconds(0, 0);

        // 1. Jump ahead to the NEXT 5-minute boundary to start the search
        // (e.g. 4:02 -> start searching at 4:05)
        const remainder = pointer.getMinutes() % 5;
        const minutesToAdd = 5 - remainder;
        pointer.setMinutes(pointer.getMinutes() + minutesToAdd);

        // 2. Loop minute-by-minute (i += 1) so we don't miss specific minutes like '13'
        for (let i = 0; i < oneYearInMinutes; i++) {
            const min = pointer.getMinutes();
            const hour = pointer.getHours();
            const day = pointer.getDate();
            const mon = pointer.getMonth() + 1;
            const dow = pointer.getDay();

            // Day-of-week 7 = Sunday (standard cron; getDay() is 0-6), matching
            // validateCronExpression and both server parsers. Without this the
            // preview called `0 9 * * 7` invalid while the save accepted it.
            if (checkCronPart(parts[0], min) && checkCronPart(parts[1], hour) && checkCronPart(parts[2], day) && checkCronPart(parts[3], mon) && (checkCronPart(parts[4], dow) || (dow === 0 && checkCronPart(parts[4], 7)))) {

                return pointer;
            }

            // Increment by 1 minute
            pointer.setMinutes(pointer.getMinutes() + 1);
        }
        return null;
    }

