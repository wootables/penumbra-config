    // --- SUBQUERY GENERATOR LOGIC ---
    // Tag Type and Row Transport are radio CARDS (both descriptions visible at
    // once, 2026-08-21). The small helpers below read/write the checked radio
    // so the rest of this section never cares about the control type. Every
    // handler here is bound DIRECTLY on its element (not delegated) so it
    // survives the dialog being moved into the console's pop-out window.

    const SUBQUERY_MSSQL_DBS = { pins: true, infoed: true };
    // Dialect the inner SQL must be written in: the db= target's engine
    // (pins/infoed are MS-SQL; ieprd/hr/fin are Oracle).
    function subqueryDbDialect(db) {
        return SUBQUERY_MSSQL_DBS[String(db || '').toLowerCase()] ? 'mssql' : 'oracle';
    }
    function getSubqueryType() {
        return $('input[name="subqueryType"]:checked').val() || 'in';
