    }
    // Expose so renderSnippetChart (defined later in the same closure)
    // and any external callers can install the handler.
    window._attachChartDrillOptions = _attachChartDrillOptions;

    // Download chart as PNG
    $('#downloadChart').on('click', function () {
        if (!currentChart) {
            return;
        }

        // 1. Determine background color
        const $body = $('body');
        const isDark = bodyIsDark();
        const bgColor = isDark ? '#1a1a1a' : '#ffffff';

        // 2. Create composite canvas
        const sourceCanvas = currentChart.canvas;
        const tempCanvas = document.createElement('canvas');
        tempCanvas.width = sourceCanvas.width;
        tempCanvas.height = sourceCanvas.height;
        const ctx = tempCanvas.getContext('2d');

