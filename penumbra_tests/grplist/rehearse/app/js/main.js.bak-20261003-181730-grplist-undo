    /**
     * Simple markdown-to-HTML converter for AI responses.
     * Handles: code blocks, inline code, bold, italic, lists, line breaks.
     */
    function renderAiMarkdown(text) {
        // Extract code blocks FIRST (before HTML escaping) to preserve raw content
        var codeBlocks = [];
        var placeholder = '\u200B\u200BCODEBLOCK_';
        var withPlaceholders = text.replace(/```(\w*)\s*\n?([\s\S]*?)```/g, function (match, lang, code) {
            var trimmedCode = code.replace(/\n$/, '');
            // Store raw code as base64 - this is the UNESCAPED original text
            var rawEncoded = btoa(unescape(encodeURIComponent(trimmedCode)));
            var idx = codeBlocks.length;
            // HTML-escape the code for display only
            var displayCode = trimmedCode
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
            var langClass = lang ? ' data-lang="' + lang.toLowerCase() + '"' : '';
            var isSnippet = lang && (lang.toLowerCase() === 'text' || lang.toLowerCase() === 'snippet');
            var targetLabel = isSnippet ? 'Custom Code' : 'SQL Editor';
            codeBlocks.push('<pre data-raw-code="' + rawEncoded + '"' + langClass + '><code>' + displayCode + '</code>' +
                '<div class="ai-code-actions">' +
                '<button class="ai-copy-btn" title="Copy to clipboard">Copy</button>' +
                '<button class="ai-apply-btn" title="Apply to ' + targetLabel + '">Apply to ' + targetLabel + '</button>' +
                '</div></pre>');
            return placeholder + idx + '%%';
        });

        // Now HTML-escape everything else
        var html = withPlaceholders
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');

        // Restore code blocks from placeholders (use split/join to replace ALL occurrences)
        for (var i = 0; i < codeBlocks.length; i++) {
            html = html.split(placeholder + i + '%%').join(codeBlocks[i]);
        }

        // Inline code: `...`
        html = html.replace(/`([^`]+)`/g, '<code>$1</code>');

        // Bold: **...**
        html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

        // Italic: *...*
        html = html.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g, '<em>$1</em>');

        // Unordered lists: lines starting with - or *
        html = html.replace(/((?:^|\n)[*\-]\s+.+(?:\n[*\-]\s+.+)*)/g, function (block) {
            var items = block.trim().split(/\n/).map(function (line) {
                return '<li>' + line.replace(/^[*\-]\s+/, '') + '</li>';
            }).join('');
            return '<ul>' + items + '</ul>';
        });

        // Ordered lists: lines starting with N.
        html = html.replace(/((?:^|\n)\d+\.\s+.+(?:\n\d+\.\s+.+)*)/g, function (block) {
            var items = block.trim().split(/\n/).map(function (line) {
                return '<li>' + line.replace(/^\d+\.\s+/, '') + '</li>';
            }).join('');
            return '<ol>' + items + '</ol>';
        });

        // Paragraphs (double newlines)
        html = html.replace(/\n\n+/g, '</p><p>');

        // Single newlines → <br> (but not inside pre/code)
        html = html.replace(/\n/g, '<br>');

        // Wrap in paragraphs
        html = '<p>' + html + '</p>';

        // Clean up empty paragraphs
        html = html.replace(/<p>\s*<\/p>/g, '');

        return html;
    }

    /**
     * Append a message bubble to the chat panel.
     */
    function appendAiMessage(role, text) {
        var $container = $('#aiChatMessages');
        if (!$container.length) return;

        // Remove welcome message on first real message
        $container.find('.ai-welcome-msg').remove();

        var $msg = $('<div class="ai-msg"></div>').addClass(role);

        if (role === 'assistant') {
            $msg.html(renderAiMarkdown(text));
        } else {
            // User messages: plain text, escape HTML
            var escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            $msg.html('<p>' + escaped.replace(/\n/g, '<br>') + '</p>');
        }

        $container.append($msg);

        // Store in conversation history (without the editor SQL context)
        aiConversation.push({ role: role, content: text });

        scrollAiToBottom();
    }

    /**
     * Send a message to the AI assistant.
     */
    function sendAiMessage() {
        if (aiRequestInFlight) return;

        var $input = $('#aiChatInput');
        var text = $input.val().trim();
        if (!text) return;

        var dbType = detectCurrentDbType();

        // Show user message
        appendAiMessage('user', text);
        $input.val('').css('height', 'auto');
        $('#aiSendBtn').prop('disabled', true);
        aiRequestInFlight = true;

        // Show typing indicator + disable input area for clear visual feedback
        var $typing = $('<div class="ai-msg assistant ai-typing-indicator"><span></span><span></span><span></span><em>Thinking\u2026</em></div>');
        $('#aiChatMessages').append($typing);
        scrollAiToBottom();
        $('#aiChatInput').prop('disabled', true).attr('placeholder', 'Waiting for AI response\u2026');
        $('#aiSendBtn').addClass('ai-btn-loading');

        // Build context block with SQL, snippet code, DB type, and active tab
        var contextParts = [];

        // Database type. Label the ENGINE GROUPS correctly for the AI: PINS and
        // InfoEd are the MS-SQL connections; the main reporting DB, HR and FIN
        // are Oracle. (The old label put HR/Fin under MS-SQL and called Oracle
        // "IEPrd", which reads like "InfoEd" and misled the assistant about
        // cross-db subquery dialects.) This describes the MAIN query only - SQL
        // inside [SUBQUERY]/[CTE_SUBQUERY] tags follows its db= target instead.
        var dbLabel = dbType === 'mssql'
            ? 'MS-SQL - main query tables are on PINS or InfoEd'
            : 'Oracle - main query tables are on the Oracle reporting DB (or HR/FIN)';
        contextParts.push('[Database type]: ' + dbLabel + '. Outer SQL must use this dialect; SQL inside [SUBQUERY]/[CTE_SUBQUERY] tags uses the db= target\'s dialect.');

        // Active tab
        var activeTab = $('#editorTabs').tabs('option', 'active');
        var tabNames = ['SQL Editor', 'Custom Code', 'View Options', 'Scheduler', 'Auditor'];
        contextParts.push('[Active tab]: ' + (tabNames[activeTab] || 'Unknown'));

        // SQL editor content
        if (editor) {
            var currentSql = editor.getValue().substring(0, 24000);
            if (currentSql.trim()) {
                contextParts.push('[Current SQL query]:\n' + currentSql);
            }
        }

        // Snippet (Custom Code) editor content
        if (snippetEditor) {
            var currentSnippet = snippetEditor.getValue().substring(0, 8000);
            if (currentSnippet.trim()) {
                contextParts.push('[Current Custom Code snippet]:\n' + currentSnippet);
            }
        }

        // Report title
        var title = getReportTitle();
        if (title && title !== 'Your Report Data') {
            contextParts.push('[Report title]: ' + title);
        }

        // Result column names (so the AI knows the data shape)
        if (masterRowData.length > 0) {
            var colNames = Array.from(masterRowData[0].keys());
            contextParts.push('[Result columns]: ' + colNames.join(', '));
        }

        // Last query error (if error box is visible)
        var errorBoxText = $('#errorBox').text().trim();
        if (errorBoxText && $('#errorBox').is(':visible')) {
            contextParts.push('[Last query error]: ' + errorBoxText.substring(0, 2000));
        }

        // Build messages array for API
        var messages = getAiConversationHistory();
        // The last message in aiConversation is the user's text we just added.
        // Append the context block to it for the API only (not displayed in chat).
        if (messages.length > 0 && contextParts.length > 0) {
            var lastMsg = messages[messages.length - 1];
            if (lastMsg.role === 'user') {
                messages[messages.length - 1] = {
                    role: 'user',
                    content: lastMsg.content + '\n\n---\n' + contextParts.join('\n')
                };
            }
        }

        $.ajax({
            url: penumbra_vars.aiProxyUrl,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ messages: messages, dbType: dbType }),
            dataType: 'json',
            timeout: 90000,
            success: function (resp) {
                $typing.remove();
                aiRequestInFlight = false;
                $('#aiSendBtn').prop('disabled', false).removeClass('ai-btn-loading');
                $('#aiChatInput').prop('disabled', false).attr('placeholder', 'Ask about SQL, snippets, charts...').focus();
                if (resp.status === 'success') {
                    appendAiMessage('assistant', resp.reply);
                } else {
                    appendAiMessage('assistant', 'Error: ' + (resp.message || 'Unknown error'));
                }
            },
            error: function (xhr) {
                $typing.remove();
                aiRequestInFlight = false;
                $('#aiSendBtn').prop('disabled', false).removeClass('ai-btn-loading');
                $('#aiChatInput').prop('disabled', false).attr('placeholder', 'Ask about SQL, snippets, charts...').focus();
                if (xhr.status === 0 || xhr.status === 403) {
                    handleSessionExpiredError();
                } else if (xhr.statusText === 'timeout') {
                    appendAiMessage('assistant', 'The request timed out. Please try again with a simpler question.');
                } else {
                    // Try to extract the server-side error message
                    var errMsg = 'Failed to reach AI service. (HTTP ' + xhr.status + ')';
                    try {
                        var errResp = JSON.parse(xhr.responseText);
                        if (errResp && errResp.message) errMsg = errResp.message;
                    } catch (ignored) {}
                    appendAiMessage('assistant', errMsg);
                }
            }
        });
    }

