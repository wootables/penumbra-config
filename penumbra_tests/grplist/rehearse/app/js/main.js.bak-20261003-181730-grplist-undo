        } else {
            const rr = penumbraResolveDateRange(pair, null);
            if (rr.error) {
                note = rr.error;
                bad = true;
            } else if (penumbraRangeHasKeywordEnd(pair)) {
                note = 'min / max are looked up from the Data Source every time the report runs.';
            } else if (f.toUpperCase() !== rr.from || t.toUpperCase() !== rr.to) {
                note = 'Today this is ' + rr.from + ' to ' + rr.to + '. It is saved as written, so it is worked out again every time the report runs.';
