            // global body.restrict-viz CSS rule additionally hides it when
            // the end-user Visualizations UI option is off.
            var _canEditChart = canvas && canvas.id !== 'vizChart'
                && !!$(canvas).data('vizConfig');
            _showDrillChoicePopup(coords, {
                titleParts: ctx.titleParts,
                candidates: candidates,
                matchingCount: matchingRows.length,
                canEditChart: _canEditChart,
                onEditChart: function () {
                    if (typeof _openChartEditorFromCanvas === 'function') {
                        _openChartEditorFromCanvas(canvas);
                    }
                },
                onDrill: function (nextCol) {
                    // originalRows for the drill state = pre-click
                    // rows with filter-panel exclusions already applied.
                    // Click criteria are NOT pre-applied because the
                    // drill state itself encodes them via .path, and
                    // they need to be editable via the breadcrumb
                    // dropdowns (they wouldn't be if baked in).
