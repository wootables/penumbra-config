    function prefillPromptGenerator(config) {
        resetPromptForm();

        $('#promptType').val(config.type || 'text');
        $('#promptMessage').val(config.message || '');
        $('#promptLabel').val(config.label || '');
        $('#promptTitle').val(config.title || '');
        $('#promptName').val(config.name || '');
        // Blank on a Decision Tree child = its parent's section (placeholder set at the end).
        $('#promptSection').val(config.section || '');

        // Deconstruct the validation string
        const validateString = config.validate || '';
        let regexRule = validateString;

        // Extract range(min,max)
        const rangeMatch = validateString.match(/range\((\d+),(\d+)\)/);
        if (rangeMatch) {
            $('#promptRangeMin').val(rangeMatch[1]);
            $('#promptRangeMax').val(rangeMatch[2]);
            regexRule = regexRule.replace(rangeMatch[0], '');
        }

        // Extract min_date(...)
        const minDateMatch = validateString.match(/min_date\(([^)]+)\)/);
        if (minDateMatch) {
            const uiDate = moment(minDateMatch[1], 'YYYY-MM-DD').format('DD-MMM-YY').toUpperCase();
            $('#promptMinDate').val(uiDate);
            regexRule = regexRule.replace(minDateMatch[0], '');
        }

        // Extract max_date(...)
        const maxDateMatch = validateString.match(/max_date\(([^)]+)\)/);
        if (maxDateMatch) {
            const uiDate = moment(maxDateMatch[1], 'YYYY-MM-DD').format('DD-MMM-YY').toUpperCase();
            $('#promptMaxDate').val(uiDate);
            regexRule = regexRule.replace(maxDateMatch[0], '');
        }

        $('#promptValidate').val(regexRule.replace(/,,/g, ',').replace(/^,|,$/g, '').trim());
        $('#promptVErrorMessage').val(config.verrormessage || '');
        $('#promptStyle').val(config.style || '');
        $('#promptNoQuote').prop('checked', config.noquote || false);
        $('#promptNoSave').prop('checked', config.nosave || false);
        $('#promptHidden').prop('checked', config.hidden || false);
        $('#promptShare').prop('checked', config.share || false);

        // Prefill the AUTHOR'S text, not the resolved value. parsePrompt() runs
        // resolveDynamicValues() over default= / forcedefault=, so `TODAY-30`,
        // `first day of last month` and `me(unityid)` arrive here ALREADY
        // collapsed to a literal - and this form serializes #promptDefault
        // straight back into the tag ("Overwrite Prompt"), so prefilling the
        // resolved value silently froze the author's expression into a one-off
        // date/identity. *Raw is the pre-resolution text parsePrompt keeps for
        // exactly this. Same reason the live preview must show it: the preview
        // reads this field too.
        const authorText = (raw, resolved) =>
            (raw === null || raw === undefined) ? (resolved || '') : raw;
        if (config.forcedefault) {
            // A bare `forcedefault` (no `=`) parses as boolean true and means
            // "force the default=", so its text still comes from default.
            $('#promptDefault').val(config.forcedefault === true
                ? authorText(config.defaultRaw, config.default)
                : authorText(config.forcedefaultRaw, config.forcedefault));
            $('#promptForceDefault').prop('checked', true);
        } else {
            $('#promptDefault').val(authorText(config.defaultRaw, config.default));
            $('#promptForceDefault').prop('checked', false);
        }

        if (config.autofill) {
            $('#promptAutofill').prop('checked', true);
            $('#promptAutofillTable').val(config.autofill.table).trigger('change');
            $('#promptAutofillColumn').val(config.autofill.column);
            $('#promptAutofillValueColumn').val(config.autofill.valueColumn || '');
            $('#promptAutofillCondition').val(config.autofill.condition || '');
        } else if (config.options && config.options.length > 0) {
            const optionsString = config.options.map(opt => {
                const base = (opt.display === opt.value) ? opt.value : `${opt.display}:${opt.value}`;
                if (opt.template !== null && opt.template !== undefined) {
                    // Wrap the template in quotes so commas / `::` inside it survive
                    // the comma-split on serialization. Prefer double quotes; fall
                    // back to single quotes if the template itself contains `"`.
                    const wrap = (opt.template.indexOf('"') < 0)
                        ? `"${opt.template}"`
                        : `'${opt.template}'`;
                    return `${base}::${wrap}`;
                }
                return base;
            }
            ).join('\n');
            $('#promptOptions').val(optionsString);
        }

        if (config.type === 'multi-select') {
            // '' = Automatic (no logic= written). An explicit logic=or has to come
            // back as OR, not as the default: after != / NOT LIKE the two differ.
            $('#promptLogic').val(config.logic === 'and' || config.logic === 'or' ? config.logic : '');
            $('#promptMin').val(config.min || '');
            $('#promptMax').val(config.max || '');
        }

        if (config.type === 'boolean') {
            if (config.yesOption)
                $('#promptTrue').val(`${config.yesOption.display}:${config.yesOption.value}`);
            if (config.noOption)
                $('#promptFalse').val(`${config.noOption.display}:${config.noOption.value}`);
            // Restore okonly state. Triggering `change` re-runs the dim/disable
            // logic above so the False Option + swap button match the flag.
            $('#promptOkOnly').prop('checked', !!config.okonly).trigger('change');
        }

        // --- NEW: Fill the Template Field ---
        $('#promptTemplate').val(config.template || '');

        if (config.resultif) {
            $('#promptResultIfName').val(config.resultif.parentName || '');
            $('#promptResultIfValue').val(config.resultif.expectedValue || '');
        }

        // --- NEW: Auto-Expand Advanced Section ---
        const hasAdvancedRegex = $('#promptValidate').val().trim() !== '';
        const hasAdvancedSettings = !!(config.template || config.resultif || hasAdvancedRegex || config.verrormessage || config.title || config.style || config.noquote);

        $('#promptAdvancedDetails').prop('open', hasAdvancedSettings);

        // UI Updates
        $('#promptType').trigger('change');
        $('#promptAutofill').trigger('change');
        updateAutofillHelperLink();
        updateParentDisabledState();
        syncPromptSectionForParent();
    }

    /**
