        (attachments || []).forEach(function (a) {
            // .content is already base64 for every attachment this dialog builds.
            var n = (a && typeof a.content === 'string') ? a.content.length : 0;
            attachWire += n + Math.ceil(n / 76);   // chunk_split newlines
        });
        // The body is measured RAW here but travels ENCODED: share.php weighs
        // the assembled message, where quoted-printable adds escapes plus a soft
        // line break every 76 characters, and MIME adds boundaries and headers.
        // Budgeting the raw size against the wire ceiling produced a body that
        // truncated correctly to 9.03 MB and was then refused at 9.4 MB encoded
        // against a 9.28 MB relay limit - right answer, wrong unit. Measured
        // inflation on that send was ~4%; 12% leaves room for a wider table
        // with more escapable characters. (2026-08-30)
        var budget = (max - attachWire - PENUMBRA_EMAIL_SHELL_RESERVE)
