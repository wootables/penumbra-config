        const _rcsResetCellCss = { 'background-color': '', 'color': '', 'font-weight': '', 'font-style': '', 'border': '' };
        const _rcsProcessRows = (rowList, byPos, getIdx) => {
            for (let _ri = 0; _ri < rowList.length; _ri++) {
                const rowEl = rowList[_ri];
                let rowMap = null, mapResolved = false;
                for (let _ci = 0; _ci < rowEl.cells.length; _ci++) {
                    const cell = rowEl.cells[_ci];
                    const originalHtml = cell.dataset.originalHtml;
