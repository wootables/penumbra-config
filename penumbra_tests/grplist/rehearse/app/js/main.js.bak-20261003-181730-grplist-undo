    // --- Click-to-Filter -----------------------------------------------------
    // A cell rendered from @@JSON holds a nested table, and its textContent is
    // every sub-row run together plus the hidden .raw-json-data blob -- never a
    // value worth searching for. The searchable unit there is the SUB-cell: the
    // search engine exposes each key of the cell's root array as a virtual
    // column (see getVirtualColumnsForRow), so "SUBCOL = //value//" is a real
    // condition. Returns { col, value }, or null whenever the click should do nothing.
    function _nestedCellFilterQuery(td, target) {
        // Only the OUTERMOST data-grid shape has addressable columns: virtual
        // columns are Object.keys(jsonData[0]) of the cell's ROOT array, so a
        // key-value object, a joined simple array, and any table one level
        // deeper carry no name the query language could reference.
        const root = td.firstElementChild;
        if (!root || !root.classList || !root.classList.contains('nested-json-container')
            || !root.classList.contains('data-grid-table'))
            return null;

        const sub = (target && target.closest) ? target.closest('.nested-json-cell') : null;
        if (!sub)
            return null;                                  // clicked the cell around the sub-table
        const subRow = sub.parentElement;
        if (!subRow || subRow.parentElement !== root)
            return null;                                  // a sub-cell of a DEEPER nested table
        if (!subRow.classList.contains('nested-json-row'))
            return null;                                  // .nested-json-header -- that click sorts
        if (subRow.classList.contains('nested-total-row'))
            return null;                                  // a computed sum, never a stored value
        // A sub-cell owning a link or control keeps its own behaviour, and so
        // does the blank space beside it -- a resolver-link sub-column must not
        // filter at all, not just when the anchor itself is hit.
        if (sub.querySelector('a, button, input, select, textarea, .nested-json-container'))
            return null;

        // The sub-column name is the header cell in the same position. Same
        // scrape the nested sort handler uses: the label minus its icons.
        const header = root.firstElementChild;
        if (!header || !header.classList.contains('nested-json-header'))
            return null;
        const headerCell = header.children[Array.prototype.indexOf.call(subRow.children, sub)];
        if (!headerCell)
            return null;
        const colName = $(headerCell).clone().find('.sort-icon, .col-sort-icon').remove().end().text().trim();
