    // True when the SQL ends INSIDE a -- line comment (no newline after it).
    // Same state machine as extractBalancedTags / extractSubqueryTags: quotes
    // and block comments are honoured, so '--' inside a literal or a closed
    // block comment does not count. Used by buildSubqueryTag: the Generate
    // handler trims the editor text, so "SELECT 1 -- note" would otherwise be
    // emitted as "...-- note]" - and both scanners read that ']' as comment
    // text and drop the tag as unbalanced (the server then runs the raw tag
    // text as SQL). Pure function, no DOM.
    function sqlEndsInLineComment(sql) {
        let inQuote = false, quoteChar = '', inLine = false, inBlock = false;
        for (let i = 0; i < sql.length; i++) {
            const ch = sql[i];
            const next = (i + 1 < sql.length) ? sql[i + 1] : '';
            if (inLine) {
                if (ch === '\n') inLine = false;
            } else if (inBlock) {
                if (ch === '*' && next === '/') { inBlock = false; i++; }
            } else if (inQuote) {
                if (ch === quoteChar) inQuote = false;
            } else if (ch === '-' && next === '-') {
                inLine = true; i++;
            } else if (ch === '/' && next === '*') {
                inBlock = true; i++;
            } else if (ch === "'" || ch === '"') {
                inQuote = true; quoteChar = ch;
            }
        }
        return inLine;
    }

    // Assemble the tag in the ONE order extractSubqueryTags (shared_logic.php)
    // parses: db= first, optional transport= second, query= last (the SQL runs
    // to the closing bracket, so nothing may follow it). A trailing -- comment
    // gets a newline before the ']' so the bracket is never swallowed by it.
    function buildSubqueryTag(sql) {
        const tagName = getSubqueryType() === 'cte' ? 'CTE_SUBQUERY' : 'SUBQUERY';
        const transport = getSubqueryTransport() === 'json' ? 'transport=json;' : '';
        const tail = sqlEndsInLineComment(sql) ? '\n' : '';
        return '[' + tagName + ';db=' + $('#subqueryDb').val() + ';' + transport + 'query=' + sql + tail + ']';
    }

    // 1. Live dialect hint, JSON-transport caveat, and the footer preview.
    // The dialect rule (inner SQL in the db= target's dialect, outer SQL in the
    // main query's, rows-only crossover) is THE thing new authors trip on, so
    // it is spelled out next to the database picker every time it changes.
    function refreshSubqueryHints() {
        const db = String($('#subqueryDb').val() || 'ieprd');
        const inner = subqueryDbDialect(db);
        const outer = detectCurrentDbType();
        const dbLabel = $('#subqueryDb option:selected').text() || db;
        const dialectName = function (d) { return d === 'mssql' ? 'MS-SQL' : 'Oracle'; };
        const syntax = {
            mssql: 'MS-SQL syntax: <code>CHARINDEX</code>, <code>SUBSTRING</code>, <code>+</code>, <code>GETDATE()</code>, <code>TOP n</code>, <code>ISNULL</code>',
            oracle: 'Oracle syntax: <code>INSTR</code>, <code>SUBSTR</code>, <code>||</code>, <code>SYSDATE</code>, <code>FETCH FIRST n ROWS ONLY</code>, <code>NVL</code>'
        };
        let html = '<strong>Write the SQL below in ' + dialectName(inner) + ' syntax</strong> - it runs as-is on '
            + escapeHtml(dbLabel) + '. ' + syntax[inner] + '.';
        if (outer !== inner) {
            html += ' Your main query looks like <strong>' + dialectName(outer) + '</strong>: everything outside the tag keeps that dialect. Only the rows cross over; nothing is translated.';
        } else {
            html += ' Your main query is on the same kind of database, so the two dialects match.';
