                    case 'range':
                        return values.reduce((a, b) => a > b ? a : b) - values.reduce((a, b) => a < b ? a : b);
                    case 'mode':
                        const freq = Object.create(null);   // "__proto__"-safe
                        let mF = 0;
                        let mode = "N/A";
