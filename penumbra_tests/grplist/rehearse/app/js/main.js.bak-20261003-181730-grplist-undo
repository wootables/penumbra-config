    // ============================================================
    // Table-list slide toggle
    // The slim handle (#toggleTableListBtn, left of the report-list
    // button) collapses the #tableSelector sidebar horizontally so a
    // tab can use the full editor width. Per-tab defaults: SQL Editor &
    // Custom Code start expanded; View Options, Scheduler & Auditor start
    // collapsed (none needs table names - the Auditor gets full width for the
    // log table + longer detail strings). Manual toggles are remembered per
    // tab for the session.
    // ============================================================
    (function () {
        var $btn = $('#toggleTableListBtn');
        var $ts = $('#tableSelector');
        if (!$btn.length || !$ts.length) return;

        // Tab order matches the <ul> in #editorTabs (same ordering as
        // the tabNames array used by the AI context builder).
        var TAB_IDS = ['sql-editor-tab', 'report-options-tab', 'view-options-tab', 'scheduler-tab', 'auditor-tab'];
        var DEFAULT_EXPANDED = {
            'sql-editor-tab': true,
            // Custom Code starts collapsed: table names are a SQL Editor concern,
            // and #snippetHelperPanel takes this slot there instead. Expanding it
            // by hand still works - the two panels are peers and coexist.
            'report-options-tab': false,
            'view-options-tab': false, // full width for the title/subtitle + option grids
            'scheduler-tab': false,    // full width for the task editor
            'auditor-tab': false       // full width for the log table + longer detail strings
        };
        // Per-tab state remembered for this session (seeded lazily from
        // DEFAULT_EXPANDED the first time each tab is shown).
        var stateByTab = {};

        function activeTabId() {
            var idx = 0;
            try { idx = $('#editorTabs').tabs('option', 'active') || 0; } catch (e) { idx = 0; }
            return TAB_IDS[idx] || 'sql-editor-tab';
        }

        function isExpanded() {
            return !$ts.hasClass('tablelist-collapsed');
        }

        function refreshEditors() {
            // The editor area width changed; reflow CodeMirror once the
            // width transition has settled.
            setTimeout(function () {
                if (typeof editor !== 'undefined' && editor) editor.refresh();
                if (typeof snippetEditor !== 'undefined' && snippetEditor) snippetEditor.refresh();
            }, 280);
        }

        // Apply expanded/collapsed to the sidebar + button. `animate`
        // adds the width transition only for this change so the
        // resizable east-drag is never throttled by a transition.
        function applyState(expanded, animate) {
            if (animate) {
                $ts.addClass('tablelist-animating');
                setTimeout(function () { $ts.removeClass('tablelist-animating'); }, 340);
            }
            $ts.toggleClass('tablelist-collapsed', !expanded);

            $btn.toggleClass('is-collapsed-accent', !expanded);
            $btn.attr('aria-pressed', expanded ? 'true' : 'false');
            $btn.attr('title', expanded
                ? 'Hide table list (full width)'
                : 'Show table list');

            if (!expanded && animate) {
                $btn.addClass('is-nudging');
                setTimeout(function () { $btn.removeClass('is-nudging'); }, 1300);
            } else {
                $btn.removeClass('is-nudging');
            }

            if (animate) refreshEditors();
        }

        // Set + remember the state for the currently active tab.
        function setActiveTabState(expanded) {
            stateByTab[activeTabId()] = expanded;
            applyState(expanded, true);
        }

        $btn.on('click', function () {
            // If the AI assistant is occupying the sidebar slot, closing
            // it is what "show the list" means here.
            if ($('#aiAssistPanel').is(':visible')) {
                $('#aiClosePanel').click();
                setActiveTabState(true);
                return;
            }
            setActiveTabState(!isExpanded());
        });

        // Clicking the collapsed slide bar itself re-opens the list.
        $ts.on('click', function (e) {
            if (!isExpanded()) {
                e.preventDefault();
                setActiveTabState(true);
            }
        });

        // Apply each tab's remembered (or default) state on activation.
        $('#editorTabs').on('tabsactivate', function (event, ui) {
            var id = ui.newPanel.attr('id');
            if (!(id in DEFAULT_EXPANDED)) return;
            var expanded = (id in stateByTab) ? stateByTab[id] : DEFAULT_EXPANDED[id];
            applyState(expanded, true);
        });

        // Seed the tab shown on load (SQL Editor by default -> expanded);
        // no animation on first paint.
        var initId = activeTabId();
        var initExpanded = (initId in DEFAULT_EXPANDED) ? DEFAULT_EXPANDED[initId] : true;
        stateByTab[initId] = initExpanded;
        applyState(initExpanded, false);
    })();

    // ============================================================
    // Custom Code helper panel (#snippetHelperPanel)
