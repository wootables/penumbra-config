        var cni = $('#resultsTable').data('columnNameToOriginalIndex') || {};
        var id = cni[String(colName)];
        if (id === undefined || id === null) id = cni[String(colName).toUpperCase()];
        return (id !== undefined && id !== null) ? (cp[id] || null) : null;
    }

