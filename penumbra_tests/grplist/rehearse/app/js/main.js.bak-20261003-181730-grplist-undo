    // populateVisualizationColumns applies, so auto-build can never pick a
    // column the X-axis dropdown does not offer.
    function _vizChartableCols() {
        var cols = [];
        $('#resultsTable thead th[data-colname]').each(function () {
            var c = $(this).data('colname');
            if (!c || c === '#') return;
            if (window.Penumbra && window.Penumbra.journalFriendlyCol
                && window.Penumbra.journalFriendlyCol(c)) return;
            cols.push(c);
        });
        return cols;
    }

    // Distinct non-empty values of a column across the rows the builder cached,
    // capped so a 200k-row report does not stall the click. Returns -1 when
    // there is nothing cached to count.
