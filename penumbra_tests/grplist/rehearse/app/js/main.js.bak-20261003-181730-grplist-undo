            multiActions += '<button class="snap-drawer-delete" data-snap-action="delete-selected" title="Delete every deletable selected snapshot. Pinned snapshots are always skipped (unpin first), as are server snapshots you didn\'t create (unless you\'re an admin).">Delete selected (' + sel.length + ')</button>';
            pairHtml += '<div class="snap-drawer-actions">' + multiActions + '</div>';
            $drawer.html(pairHtml);
