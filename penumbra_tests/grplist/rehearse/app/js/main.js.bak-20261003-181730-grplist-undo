        _rcsProcessRows(
            document.querySelectorAll('#resultsTable tbody tr'),
            _rcsHeaderMap(_rcsFlatThs),
            (rowEl) => parseInt(rowEl.cells[0] ? rowEl.cells[0].textContent : '', 10) - 1
        );
        const _rcsGrpFirstThead = document.querySelector('#groupedResultsContainer .group-wrapper thead');
        if (_rcsGrpFirstThead) {
            _rcsProcessRows(
                document.querySelectorAll('#groupedResultsContainer tbody tr'),
                _rcsHeaderMap(_rcsGrpFirstThead.querySelectorAll('th')),
                (rowEl) => {
