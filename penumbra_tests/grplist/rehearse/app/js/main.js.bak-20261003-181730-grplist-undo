    // ===============================================================
    // ===== END: REVISED PROMPT GENERATOR LIGHTBOX FUNCTIONALITY =====
    // ===============================================================

    // 1. Single Click Handler - opens context menu (same as right-click), plus Shift+Click for new tab
    //    Debounced: waits 250ms so a rapid double-click doesn't open the context menu first.
    var _selectorClickTimer = null;
    $(document).on('click', '.selector-item:not(.disabled)', function (e) {
        // Don't intercept if clicking on action icons or item-icons with actions
        if ($(e.target).closest('.action-icon').length || $(e.target).closest('.item-icon[data-action]').length)
            return;

        const $item = $(this);
        const type = $item.data('type');

        // --- Handle Shift+Click for New Tab (no debounce needed) ---
        if (e.shiftKey) {
            e.preventDefault();
            if ($item.closest('#all-favorites').length || $item.data('from-favorites')) {
                handleFavoriteAction('open-new', this, e);
            } else {
                if (type === 'table')
                    handleTableAction('open-new', this, e);
                else if (type === 'state')
                    handleStateAction('open-state-new', this, e);
                else if (type === 'imported') {
                    var _impName = $(this).data('value');
                    if (_impName) {
                        var _impState = { query: 'SELECT * FROM [IMPORT; name=' + _impName + ']', noLimit: false };
                        var _impUrl = window.location.href.split("?")[0] + "?state=" + compressString(JSON.stringify(_impState));
                        window._pnbOpenTabOrNotice(this, _impUrl, 'double-click the import to load it here');
                    }
                }
            }
            return;
        }

        // --- Debounced Left-Click: delay so double-click can cancel it ---
        clearTimeout(_selectorClickTimer);
        var el = this;
        _selectorClickTimer = setTimeout(function () {
            var $icon = $item.find('.item-icon[data-action]');
            if ($icon.length) {
                var action = $icon.data('action');
                if ($item.closest('#all-favorites').length || $item.data('from-favorites')) {
                    handleFavoriteAction(action, el, e);
                } else if (type === 'table') {
                    handleTableAction(action, el, e);
                } else if (type === 'state') {
                    handleStateAction(action, el, e);
                } else if (type === 'imported') {
                    handleImportedAction(action, el, e);
                }
            }
        }, 250);
    });

    // 2. Double Click Handler (for opening the item)
    $(document).on('dblclick', '.selector-item:not(.disabled)', function (e) {
        // Cancel any pending single-click context menu
        clearTimeout(_selectorClickTimer);

        if ($(e.target).closest('.action-icon').length)
            return;

        const $item = $(this);
        const type = $item.data('type');

        if ($item.closest('#all-favorites').length || $item.data('from-favorites')) {
            handleFavoriteAction('open-state', this, e);
        } else if (type === 'table') {
            // Non-favorite table: double-click defaults to SELECT * (clear-all)
            handleTableAction('clear-all', this);
        } else if (type === 'state') {
            // Non-favorite local save: double-click defaults to opening the state
            handleStateAction('open-state', this);
        } else if (type === 'imported') {
            // Imported file: double-click writes SELECT * FROM [IMPORT; name=X]
            var importName = $(this).data('value');
            if (importName) {
                performClearAllAction(importName, 'SELECT * FROM [IMPORT; name=' + importName + ']');
            }
        }
    });

    // 3. Action Icon Handler (for menus and shortcuts)
    $(document).on('click', '.action-icon, .item-icon[data-action]', function (e) {
        e.stopPropagation();
        // Prevent item selection

        const action = $(this).data('action');
        const $item = $(this).closest('.selector-item');
        const type = $item.data('type');

        // --- Route Favorites (in favorites panel OR cloned search results) ---
        if ($item.closest('#all-favorites').length || $item.data('from-favorites')) {
            handleFavoriteAction(action, $item[0], e);
            return;
        }

        // --- Original Logic for Non-Favorite Tables/States ---
        if (type === 'table') {
            handleTableAction(action, $item[0], e);
        } else if (type === 'state') {
            handleStateAction(action, $item[0], e);
        } else if (type === 'imported') {
            handleImportedAction(action, $item[0], e);
        }
    });

    // 4. Right Click Handler (Context Menu) - Mimics clicking the item's icon
    $(document).on('contextmenu', '.selector-item:not(.disabled)', function (e) {
        e.preventDefault();
        // Prevent native browser context menu

        // 1. Find the main icon within this row to get the correct action
        const $icon = $(this).find('.item-icon[data-action]');

        if ($icon.length) {
            const action = $icon.data('action');
            const $item = $(this);
            const type = $item.data('type');

            // 2. Route to the appropriate handler
            if ($item.closest('#all-favorites').length || $item.data('from-favorites')) {
                handleFavoriteAction(action, this, e);
            } else if (type === 'table') {
                handleTableAction(action, this, e);
            } else if (type === 'state') {
                handleStateAction(action, this, e);
            } else if (type === 'imported') {
                handleImportedAction(action, this, e);
            }
        }
    });

    // Handle table actions
    function handleTableAction(action, itemElement, e) {
        const $item = $(itemElement);
        const tableName = $item.data('value') || $item.data('name');
        if (!tableName)
            return;

        // --- Determine Connection Hint ---
        const upperTableName = tableName.toUpperCase();
        let connectionHint = 'IEPrd';
        if (pinsTableNames.some(t => t.toUpperCase() === upperTableName))
            connectionHint = 'PINS';
        else if (infoEdTableNames.some(t => t.toUpperCase() === upperTableName))
            connectionHint = 'InfoEd';
        else if (hrTableNames.some(t => t.toUpperCase() === upperTableName))
            connectionHint = 'HR';
        else if (finTableNames.some(t => t.toUpperCase() === upperTableName))
            connectionHint = 'Fin';

        switch (action) {
            case 'insert-subquery':
                {
                    const dbTag = getDbTagForTable(tableName);
                    const tag = `[SUBQUERY;db=${dbTag};query=SELECT COLUMN FROM ${tableName}]`;
                    editor.replaceSelection(tag);
                    editor.focus();
                }
                break;
            case 'insert-cte':
                {
                    const dbTag = getDbTagForTable(tableName);
                    const tag = `WITH CTE_${tableName} AS (\n    [CTE_SUBQUERY;db=${dbTag};query=SELECT COLUMN1, COLUMN2 FROM ${tableName}]\n)\n`;
                    editor.setCursor(0, 0);
                    editor.replaceSelection(tag);
                    editor.focus();
                }
                break;
            case 'clear-all':
                //if (editor.getValue().trim() !== "" && !confirm("This action will replace the content of your SQL editor. Do you want to continue?")) {
                //    return;
                //}
                performClearAllAction(tableName);
                break;

            case 'open-new':
                const adminState = {
                    query: `SELECT * FROM ${tableName}`,
                    noLimit: false
                };
                const adminEncoded = compressString(JSON.stringify(adminState));
                const adminUrl = window.location.href.split("?")[0] + "?state=" + adminEncoded;
                window._pnbOpenTabOrNotice(itemElement, adminUrl, 'double-click the table to load it here');
                break;

            case 'view-table-info':
                showTableInfoDialog(tableName);
                break;

            case 'table-more-options':
                showTableMoreOptions(itemElement, $item, e);
                break;
        }
    }

    // Handle state actions
    function handleStateAction(action, itemElement, e) {
        const $item = $(itemElement);
        const stateIndex = $item.data('index');
        const savedQueries = JSON.parse(localStorage.getItem("savedQueries") || "[]").sort((a, b) => a.name.localeCompare(b.name));
        const stateData = savedQueries[stateIndex];

        if (!stateData)
            return;

        switch (action) {
            case 'open-state':
                if ((editor.getValue().trim() !== "" || snippetEditor.getValue().trim() !== "" || $("#reportTitle").val().trim() !== "" || $("#reportSubtitle").val().trim() !== "") && !confirm("This action will replace the current query and all options by loading a saved state. Do you want to continue?")) {
                    return;
                }
                window.location.href = stateData.url;
                break;

            case 'open-state-new':
                // stateData.url is relative; _pnbOpenTabOrNotice absolutises it.
                window._pnbOpenTabOrNotice(itemElement, stateData.url, 'double-click the state to load it here');
                break;

            case 'copy-link-admin':
                // _pnbAbsUrl: stateData.url is stored relative, and a relative
                // link is dead the moment it is pasted anywhere else.
                window._pnbCopyText(window._pnbAbsUrl(stateData.url), "Sharable link copied to clipboard.");
                break;

            case 'state-more-options':
                showStateMoreOptions(itemElement, $item, stateData, e);
                break;
        }
    }

    // Handle imported file actions in table selector
    function handleImportedAction(action, itemElement, e) {
        var $item = $(itemElement);
        var importName = $item.data('value');
        if (!importName) return;

        switch (action) {
            case 'insert-import-tag':
                // Insert the IMPORT tag at cursor position in the SQL editor
                var tag = '[IMPORT; name=' + importName + ']';
                if (typeof editor !== 'undefined' && editor.replaceSelection) {
                    editor.replaceSelection(tag);
                    editor.focus();
                }
                show_text("<p id='undo_text'><span style='color: lightgreen'>INSERTED:</span> <code>" + escapeHtml(tag) + "</code> into SQL editor.</p>");
                break;

            case 'remove-import':
                if (!confirm('Delete imported data source "' + importName + '"? This cannot be undone.')) return;
                // Delete from server if persisted, then clean up client state
                var _delId = window._penumbraImportIds[importName] ||
                             (window._penumbraImportMeta[importName] && window._penumbraImportMeta[importName].id);
                var _cleanupImport = function () {
                    delete window._penumbraImportedData[importName];
                    delete window._penumbraImportIds[importName];
                    delete window._penumbraImportMeta[importName];
                    populateSelectorBox();
                    show_text("<p id='undo_text'><span style='color: orange'>REMOVED:</span> Imported data source <code>" + escapeHtml(importName) + "</code>.</p>");
                };
                if (_delId) {
                    $.ajax({
                        url: 'manage_imports.php',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ action: 'delete', id: _delId }),
                        dataType: 'json',
                        success: function () { _cleanupImport(); },
                        error: function () {
                            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to delete import from server. Please try again.</p>");
                        }
                    });
                } else {
                    _cleanupImport();
                }
                break;

            case 'import-more-options':
                showImportMoreOptions(itemElement, $item, e);
                break;
        }
    }

    // Show additional table options
    function showTableMoreOptions(triggerElement, $item, e) {
        $('.context-submenu').remove();
        const tableName = $item.data('value');

        // Determine the database name for context
        let dbName = '';
        const upperTableName = tableName.toUpperCase();
        if (oracleTableSet.has(upperTableName)) {
            dbName = '[IEPrd]';
        } else if (pinsTableSet.has(upperTableName)) {
            dbName = '[PINS]';
        } else if (infoEdTableSet.has(upperTableName)) {
            dbName = '[INFOED]';
        } else if (hrTableSet.has(upperTableName)) {
            dbName = '[HR]';
        } else if (finTableSet.has(upperTableName)) {
            dbName = '[FIN]';
        }

        // --- Favorites Logic - Handle both Oracle and MS-SQL ---
        let favorites, favoriteStorageKey, isFavorite;

        // Determine which MS-SQL group the table belongs to
        const isPinsTable = pinsTableNames.some(table => table.toUpperCase() === tableName.toUpperCase());
        const isInfoEdTable = infoEdTableNames.some(table => table.toUpperCase() === tableName.toUpperCase());
        const isHrTable = hrTableNames.some(table => table.toUpperCase() === tableName.toUpperCase());
        const isFinTable = finTableNames.some(table => table.toUpperCase() === tableName.toUpperCase());

        if (isPinsTable) {
            favoriteStorageKey = "penumbra_favorite_pins_tables";
            favorites = new Set(JSON.parse(localStorage.getItem(favoriteStorageKey) || "[]"));
        } else if (isInfoEdTable) {
            favoriteStorageKey = "penumbra_favorite_infoed_tables";
            favorites = new Set(JSON.parse(localStorage.getItem(favoriteStorageKey) || "[]"));
        } else if (isHrTable) {
            favoriteStorageKey = "penumbra_favorite_hr_tables"
            favorites = new Set(JSON.parse(localStorage.getItem(favoriteStorageKey) || "[]"));
        } else if (isFinTable) {
            favoriteStorageKey = "penumbra_favorite_fin_tables";
            favorites = new Set(JSON.parse(localStorage.getItem(favoriteStorageKey) || "[]"));
        } else {
            // It's an Oracle table
            favoriteStorageKey = "penumbra_favorite_tables";
            favorites = new Set(JSON.parse(localStorage.getItem(favoriteStorageKey) || "[]"));
        }

        isFavorite = favorites.has(tableName);
        const favoriteAction = isFavorite ? 'remove-favorite' : 'add-favorite';
        const favoriteText = isFavorite ? 'Remove from Favorites' : 'Add to Favorites';
        const favoriteMenuItem = `<div class="submenu-item" data-action="${favoriteAction}">${favoriteText}</div>`;

        const menu = $(`
        <div class="context-submenu">
            <div class="submenu-item disabled-menu-item">${dbName} ${tableName}</div>
            <div class="submenu-divider"></div>
            <div class="submenu-item" data-action="clear-sql">Open Here (dblclick)</div>
            <div class="submenu-item" data-action="open-new">Open in New Tab (shift+click)</div>
            <div class="submenu-divider"></div>
            ${favoriteMenuItem}
            <div class="submenu-divider"></div>
            <div class="submenu-item" data-action="copy-text">Copy Name</div>
            <div class="submenu-item" data-action="insert-text">Insert Name at Cursor</div>
            <div class="submenu-item" data-action="insert-subquery">Insert Generic Subquery (drag)</div>
            <div class="submenu-item" data-action="insert-cte">Insert Generic CTE (drag to line 1)</div>            
            <div class="submenu-divider"></div>
            <div class="submenu-item" data-action="view-table-info">Table Info</div>
        </div>
        `);

        menu.css({
            left: (e.pageX + 5) + 'px',
            top: (e.pageY + 5) + 'px'
        });

        menu.on('click', '.submenu-item', function () {
            const action = $(this).data('action');
            // The clicked item, captured while `this` still means it. _pnbOpenTab
            // needs an element in the ORIGINATING document: this menu is appended
            // through _pnbBodyFor, so while the console is popped out it renders in
            // THAT window - and only that window holds the transient user activation
            // the popup blocker checks (see window._pnbOpenTab).
            const _srcItem = this;
            // Delegate these actions back to the main handler
            if (action === 'insert-subquery' || action === 'insert-cte' || action === 'view-table-info') {
                activeSystemQueryTable = tableName;
                handleTableAction(action, triggerElement, e);
                menu.remove();
                return;
            }
            switch (action) {
                case 'add-favorite':
                    {
                        const favs = Array.from(new Set(JSON.parse(localStorage.getItem(favoriteStorageKey) || "[]")));
                        favs.push(tableName);
                        localStorage.setItem(favoriteStorageKey, JSON.stringify(favs));
