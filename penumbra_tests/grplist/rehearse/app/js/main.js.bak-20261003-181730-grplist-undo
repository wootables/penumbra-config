        if (!entry) return;

        window.vizUpdateRange = { from: entry.from, to: entry.to };
        lastVisConfig = entry.config;

        // Identify the rendered canvas that corresponds to this snippet
        // entry so Save Preset can pull live drill state off it.  The Nth
        // non-infobox entry in enumerateVisCallsInEditor matches the Nth
        // rendered canvas in #reportSnippetOutput (both walk snippet order),
