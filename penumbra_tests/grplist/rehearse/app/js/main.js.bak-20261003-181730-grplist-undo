    // --- Reset Update Mode on Manual Open ---
    $('#visualizeBtn').on('mousedown', function () {
        window.vizUpdateRange = null;
        _vizEditingCanvas = null;
    });

    // --- Close lightbox: clear update range ---
    $('#visualizationLightbox .close-lightbox').on('click', function () {
        window.vizUpdateRange = null;
        _vizEditingCanvas = null;
    });

    // Get chart colors - light themes use darkened colors for better white-text contrast
    // --- TREND LINE HELPERS ---
    function computeMovingAvg(data, n) {
        var result = [];
        for (var i = 0; i < data.length; i++) {
            if (i < n - 1) { result.push(null); continue; }
            var sum = 0;
            for (var j = i - n + 1; j <= i; j++) sum += (data[j] || 0);
            result.push(sum / n);
        }
        return result;
    }

    function computeLinearRegression(data) {
        var n = data.length;
        if (n < 2) return data.slice();
        var sumX = 0, sumY = 0, sumXY = 0, sumX2 = 0;
        for (var i = 0; i < n; i++) {
            var y = data[i] || 0;
            sumX += i; sumY += y; sumXY += i * y; sumX2 += i * i;
        }
        var m = (n * sumXY - sumX * sumY) / (n * sumX2 - sumX * sumX);
        var b = (sumY - m * sumX) / n;
        var result = [];
        for (var i = 0; i < n; i++) result.push(m * i + b);
        return result;
    }

    // Percentage-of-total for proportional (pie) charts. Returns '' when not
    // applicable (non-pie, non-numeric, zero/blank total). Shared by data labels
    // and tooltips so a pie slice reads "value (23%)". Passive - no vis() option.
    function _penumbraSliceSharePct(chartType, value, dataArr) {
        if (chartType !== 'pie' && chartType !== 'doughnut') return '';
        if (typeof value !== 'number' || !isFinite(value)) return '';
        if (!Array.isArray(dataArr)) return '';
        var total = 0;
        for (var i = 0; i < dataArr.length; i++) {
            var v = dataArr[i];
            if (v && typeof v === 'object') v = (v.y != null ? v.y : (v.v != null ? v.v : 0));
            total += Math.abs(+v || 0);
        }
        if (total <= 0) return '';
        var pct = Math.abs(value) / total * 100;
        if (pct < 0.05) return '';
        return (pct >= 10 ? pct.toFixed(0) : pct.toFixed(1)).replace(/\.0$/, '') + '%';
    }

    // Build a CSV string from a rendered chart's aggregated data (labels x
    // series), skipping the trend-line/synthetic datasets. Reads the live
    // Chart.js instance so the export matches exactly what's on screen. Used by
    // the right-click "Data" export (feature: expose the numbers behind a chart).
    function _penumbraChartToCsv(canvas) {
        var chart = (typeof Chart !== 'undefined' && Chart.getChart) ? Chart.getChart(canvas) : null;
        if (!chart || !chart.data) return '';
        var labels = chart.data.labels || [];
        var datasets = (chart.data.datasets || []).filter(function (ds) { return ds && !ds._isTrendLine; });
        var cfg = $(canvas).data('vizConfig') || {};
        function cell(s) {
            s = (s == null) ? '' : String(s);
            if (s.indexOf('@@HTML') === 0 || s.indexOf('@@JSON') === 0) s = s.substring(6);
            s = s.replace(/<[^>]*>/g, '');
            if (/[",\r\n]/.test(s)) s = '"' + s.replace(/"/g, '""') + '"';
            return s;
        }
        function num(v) {
            if (v && typeof v === 'object') v = (v.y != null ? v.y : (v.v != null ? v.v : ''));
            return (v == null) ? '' : v;
        }
        var head = [cell(cfg.xAxisLabel || cfg.xAxis || 'Category')];
        datasets.forEach(function (ds, di) { head.push(cell(ds.label || ('Series ' + (di + 1)))); });
        var rows = [head.join(',')];
        for (var i = 0; i < labels.length; i++) {
            var row = [cell(labels[i])];
            datasets.forEach(function (ds) { row.push(cell(num((ds.data || [])[i]))); });
            rows.push(row.join(','));
        }
        return rows.join('\r\n');
    }

    function injectTrendDataset(chartData, trendType) {
        if (!trendType || trendType === 'none' || !chartData || !chartData.datasets || chartData.datasets.length === 0) return;
        // Non-cartesian charts (pie/radar/polarArea/treemap) have no x/y scales, so a
        // line trend dataset injected into them makes Chart.js throw at render. Via the
        // shared deferred-render try/catch that previously blanked EVERY chart on the page.
        // The Visualization Builder already forbids trend on these types (noTrendTypes);
        // enforce the same for hand-written / AI-written vis(). _chartType is stamped on
        // the data object by generateChartDataFromMaps.
        var _trendCt = chartData._chartType;
        if (_trendCt && ['pie', 'doughnut', 'radar', 'polarArea', 'treemap', 'funnel', 'gauge', 'bullet', 'map'].indexOf(_trendCt) !== -1) return;
        // Find the first bar or non-line dataset to base the trend on; fallback to first dataset
        var sourceDs = chartData.datasets[0];
        for (var i = 0; i < chartData.datasets.length; i++) {
            if (!chartData.datasets[i].type || chartData.datasets[i].type === 'bar') { sourceDs = chartData.datasets[i]; break; }
        }
        var sourceData = sourceDs.data;
        if (!sourceData || sourceData.length < 2) return;
        // Extract numeric values (handle {x,y} objects for scatter)
        var values = sourceData.map(function (v) { return typeof v === 'object' ? (v.y || 0) : (v || 0); });

        var trendValues, trendLabel;
        if (trendType === 'regression') {
            trendValues = computeLinearRegression(values);
            trendLabel = 'Linear Trend';
        } else {
            var n = parseInt(trendType.replace('ma', '')) || 3;
            trendValues = computeMovingAvg(values, n);
            trendLabel = n + '-Period Avg';
        }

        chartData.datasets.push({
            label: trendLabel,
            data: trendValues,
            type: 'line',
            order: 0,
            fill: false,
            borderColor: 'rgba(128, 128, 128, 0.6)',
            borderDash: [6, 3],
            borderWidth: 1.5,
            pointRadius: 0,
            pointStyle: 'dash',
            tension: 0.3,
            datalabels: { display: false },
            _isTrendLine: true
        });
    }

    // ════════════════════════════════════════════════════════════════════
    //  CHART PALETTE
    //
    //  The old palette was ten hard-coded Chart.js-ish colours with exactly one
    //  theme input - a 15% darken on light themes. On the strongly-coloured
    //  themes (Matrix, Neon Pulse) that put generic blue/red/teal on a green or
    //  magenta ground, which is what prompted this.
    //
    //  `auto` derives the series colours from the ACTIVE theme's --brand-primary
    //  by rotating hue in Oklab, reusing PenumbraHeat's engine so a heatmap and a
    //  bar chart on the same report cannot disagree about the same rotation.
    //
    //  BROWSER ONLY, and legitimately so: vis() is stripped server-side and there
    //  is no chart code in schedule_runner.php or the PDF generator, so there is
    //  no second engine to keep in step here.
    // ════════════════════════════════════════════════════════════════════

    /** Minimum Oklab chroma for a DERIVED series colour.
     *
     *  Measured, not guessed. A hue rotation preserves chroma, so rotating a
     *  low-chroma brand just yields more muddy mid-tones: the default theme's
     *  #336699 scored a minimum separation of 0.069 across five series - the
     *  WORST of every theme tested, and it is the theme most reports use.
     *  Lifting derived colours to this floor takes it to 0.145 and turns
     *  blue/brown/mauve/olive into blue/red/green/purple. High-chroma themes
     *  (Matrix 0.19, Neon Pulse 0.25) are already above it and are untouched. */
    var PENUMBRA_PALETTE_CHROMA_FLOOR = 0.20;

    /** Perceptual distance, lightness weighted up because two colours that differ
     *  only in lightness are harder to tell apart on a small bar than two that
     *  differ in hue. */
    function _penumbraPaletteDist(a, b) {
        var H = window.PenumbraHeat;
        var la = H.rgbToOklab(a), lb = H.rgbToOklab(b);
        var dl = la[0] - lb[0], da = la[1] - lb[1], db = la[2] - lb[2];
        return Math.sqrt(dl * dl * 2.5 + da * da + db * db);
    }

    /** Today's ten colours, kept verbatim so `palette=classic` pins the look a
     *  report had before `auto` existed. Do not "tidy" these values. */
    var PENUMBRA_PALETTE_CLASSIC = [
        [51, 102, 153], [255, 99, 132], [75, 192, 192], [255, 205, 86], [153, 102, 255],
        [255, 159, 64], [199, 199, 199], [83, 102, 255], [255, 99, 255], [99, 255, 132]
    ];

    /** The palette in force for the chart currently being BUILT. Set from
     *  data._palette at each renderer's entry (the same payload channel _fmt
     *  uses) rather than threaded through getChartColor's 37 call sites.
     *  Chart building is synchronous, so there is no interleaving. */
    var _penumbraActivePalette = 'auto';

    var PENUMBRA_PALETTE_NAMES = ['auto', 'classic', 'warm', 'cool', 'mono'];

    /** Built palettes, keyed brand+name. A chart asks for a colour once per
     *  series per render, and the greedy search below is ~36x10 distance
     *  calculations - cheap, but not cheap enough to redo per bar. */
    var _penumbraPaletteCache = {};

    var PENUMBRA_PALETTE_SIZE = 10;

    /**
     * Build a categorical palette from the theme's brand colour.
     *
     * GREEDY MAX-MIN over a hue grid, not fixed offsets. Fixed offsets looked
     * fine in the abstract and failed in practice: rotating Matrix's #00ff41 by
     * 45 and 90 degrees put series 3 and 5 both in cyan. Choosing each next hue
     * to be as far as possible from everything already picked adapts to whatever
     * the theme's brand happens to be, and roughly doubled the worst-case
     * separation on every theme measured.
     *
     * Series 1 is ALWAYS the brand colour untouched - that is what anchors the
     * chart to the theme. Only derived colours get the chroma floor.
     */
    function _penumbraBuildPalette(name, brandRgb) {
        var H = window.PenumbraHeat;
        var out = [H.rotateHue(brandRgb, 0)];

        if (name === 'mono') {
            // One hue, stepped lightness. For "same measure, different slice"
            // rather than "different measures" - and for anyone printing.
            //
            // The range is CLAMPED FIRST and then divided - not scaled and then
            // clamped per step. Scaling the brand lightness and clamping each
            // step individually collapsed everything past the ceiling onto the
            // same 0.88, and `m % 6` wrapped before ten slots were filled, so a
            // mono palette shipped duplicate colours - the one thing a
            // CATEGORICAL palette must never do.
            var lab0 = H.rgbToOklab(brandRgb);

            // The ladder sits entirely on ONE SIDE of the brand, with a gap.
            // Spanning THROUGH the brand's lightness puts a rung right beside
            // it, and at the bright end sRGB clipping then collapses the two
            // together: on Matrix that measured 0.0217 apart, a repeat in all
            // but name. Below the brand for a light brand, above for a dark one.
            var GAP = 0.10, lo, hi;
            if (lab0[0] > 0.55) { hi = lab0[0] - GAP; lo = Math.max(0.28, hi - 0.48); }
            else { lo = lab0[0] + GAP; hi = Math.min(0.92, lo + 0.48); }
            // A brand pinned against either end leaves too little room to step
            // through; take a fixed printable range rather than nine shades
            // nobody can tell apart.
            if (hi - lo < 0.24) { lo = 0.32; hi = 0.80; }

            var steps = PENUMBRA_PALETTE_SIZE - 1;
            var ladder = [];
            for (var m = 0; m < steps; m++) ladder.push(lo + (hi - lo) * (m / (steps - 1)));

            // Deal the rungs by GREEDY MAX-MIN - the same rule the hue palette
            // uses, just in one dimension: whichever rung sits farthest from
            // every rung already dealt goes next, and the first goes farthest
            // from the brand. Handing them out IN ORDER instead gave a
            // three-series chart three neighbouring shades (#009c00 beside
            // #00aa00 on Matrix); this way three series get the two ends and
            // the middle, which is the whole range.
            var picked = [];
            while (picked.length < ladder.length) {
                var bestI = -1, bestScore = -1;
                for (var i2 = 0; i2 < ladder.length; i2++) {
                    if (picked.indexOf(i2) !== -1) continue;
                    var worst;
                    if (picked.length === 0) {
                        worst = Math.abs(ladder[i2] - lab0[0]);
                    } else {
                        worst = Infinity;
                        for (var j2 = 0; j2 < picked.length; j2++) {
                            var dd2 = Math.abs(ladder[i2] - ladder[picked[j2]]);
                            if (dd2 < worst) worst = dd2;
                        }
                    }
                    if (worst > bestScore) { bestScore = worst; bestI = i2; }
                }
                picked.push(bestI);
            }
            for (var p2 = 0; p2 < picked.length; p2++) {
                out.push(H.oklabToRgb([ladder[picked[p2]], lab0[1], lab0[2]]));
            }
            return out;
        }

        function liftChroma(rgb) {
            var lab = H.rgbToOklab(rgb);
            var c = Math.sqrt(lab[1] * lab[1] + lab[2] * lab[2]);
            if (c >= PENUMBRA_PALETTE_CHROMA_FLOOR || c < 1e-6) return rgb;
            var k = PENUMBRA_PALETTE_CHROMA_FLOOR / c;
            return H.oklabToRgb([lab[0], lab[1] * k, lab[2] * k]);
        }

        var cand = [];
        for (var d = 10; d < 360; d += 10) cand.push({ d: d, rgb: liftChroma(H.rotateHue(brandRgb, d)) });

        while (out.length < PENUMBRA_PALETTE_SIZE && cand.length) {
            var best = -1, bestScore = -1;
            for (var i = 0; i < cand.length; i++) {
                var worst = Infinity;
                for (var j = 0; j < out.length; j++) {
                    var dd = _penumbraPaletteDist(cand[i].rgb, out[j]);
                    if (dd < worst) worst = dd;
                }
                if (worst > bestScore) { bestScore = worst; best = i; }
            }
            out.push(cand[best].rgb);
            cand.splice(best, 1);
        }

        // warm / cool tilt the DERIVED colours toward or away from the brand by
        // the same +/-35 the heatmap ramps use, so the two features share a
        // vocabulary. The rotation is uniform, so it preserves Oklab distance -
        // but the result is then CLIPPED back into sRGB, and that clipping is
        // not distance-preserving. Measured on Matrix green the ten-colour
        // minimum separation goes 0.104 (auto) -> 0.090 (warm) -> 0.054 (cool):
        // mostly held, not held exactly. Do not tighten this into a guarantee.
        var bias = (name === 'warm') ? 35 : (name === 'cool') ? -35 : 0;
        if (bias) {
            // Re-flooring after the rotation was tried and made it WORSE:
            // lifting chroma on colours that are already against the gamut
            // boundary pushes them into it together, and cool fell from 0.054
            // to 0.035. Rotate and leave it alone.
            for (var k2 = 1; k2 < out.length; k2++) out[k2] = H.rotateHue(out[k2], bias);
        }
        return out;
    }

    /** A theme switch changes --brand-primary, so every derived palette is stale.
     *  Cheaper and more obviously correct than trying to detect it per lookup. */
    function penumbraResetPaletteCache() { _penumbraPaletteCache = {}; }

    function _penumbraPaletteRgb(name, index) {
        var H = window.PenumbraHeat;
        if (name === 'classic' || !H || typeof H.rotateHue !== 'function') {
            return PENUMBRA_PALETTE_CLASSIC[index % PENUMBRA_PALETTE_CLASSIC.length];
        }
        var brandCss = H.themeVar('--brand-primary', '#336699');
        var key = name + '|' + brandCss;
        if (!_penumbraPaletteCache[key]) {
            var primary = H.parseColor(brandCss) || [51, 102, 153];
            try {
                _penumbraPaletteCache[key] = _penumbraBuildPalette(name, primary);
            } catch (e) {
                // Never let a colour failure take a chart down.
                _penumbraPaletteCache[key] = PENUMBRA_PALETTE_CLASSIC;
            }
        }
        var pal = _penumbraPaletteCache[key];
        return pal[index % pal.length];
    }

    /** One series colour. `name` defaults to the palette in force. */
    function penumbraPaletteColor(index, alpha, name) {
        var pal = name || _penumbraActivePalette || 'auto';
        if (PENUMBRA_PALETTE_NAMES.indexOf(pal) === -1) pal = 'auto';
        var rgb = _penumbraPaletteRgb(pal, index) || [51, 102, 153];
        // Preserved from the original: on a LIGHT theme a translucent fill needs
        // darkening or the white value labels drawn on top stop being readable.
        var isLightTheme = !bodyIsDark();
        var d = (isLightTheme && alpha < 1) ? 0.85 : 1;
        return 'rgba(' + Math.round(rgb[0] * d) + ', ' + Math.round(rgb[1] * d) + ', ' +
               Math.round(rgb[2] * d) + ', ' + alpha + ')';
    }

    /** One series colour as #rrggbb. The combo and butterfly rows seed their
     *  <input type="color"> from this, and those inputs cannot take rgba(). */
    function _penumbraPaletteHex(index, name) {
        var pal = name || _penumbraActivePalette || 'auto';
        if (PENUMBRA_PALETTE_NAMES.indexOf(pal) === -1) pal = 'auto';
        var rgb = _penumbraPaletteRgb(pal, index) || [51, 102, 153];
        function h(v) {
            var s = Math.max(0, Math.min(255, Math.round(v))).toString(16);
            return s.length < 2 ? '0' + s : s;
        }
        return '#' + h(rgb[0]) + h(rgb[1]) + h(rgb[2]);
    }

    /** "auto" series colours (2026-09-26). A combo series saved with
     *  "color":"auto" takes the chart Palette's colour for its SLOT, and the auto
     *  series that share a filter share a slot - so one fiscal year's bar and
     *  line match. Slots go, in series order, to the distinct filters of the
     *  AUTO series only (trimmed, case-insensitive); a series with no filter
     *  gets a slot of its own. One slot per series, -1 for a fixed colour. The
     *  renderer and the builder's swatches both ask this, so they agree. */
    function penumbraComboAutoSlots(series) {
        var slots = [], seen = Object.create(null), next = 0;
        (series || []).forEach(function (s, i) {
            if (!s || String(s.color || '').trim().toLowerCase() !== 'auto') { slots.push(-1); return; }
            var fe = String(s.filterExpression || '').trim().toUpperCase();
            var key = fe ? 'f:' + fe : 'i:' + i;
            if (!(key in seen)) seen[key] = next++;
            slots.push(seen[key]);
        });
        return slots;
    }

    /** The colour an "auto" butterfly side takes: palette slots 0 and 1, and on
     *  `classic` the historic blue / red pair the builder has always seeded. */
    function penumbraButterflyAutoColor(side, paletteName) {
        var pal = paletteName || _penumbraActivePalette || 'auto';
        if (pal === 'classic') return side === 'L' ? '#336699' : '#c0392b';
        return _penumbraPaletteHex(side === 'L' ? 0 : 1, pal);
    }

    function getChartColor(index, alpha = 1) {
        return penumbraPaletteColor(index, alpha, null);
    }

    /** The pre-palette implementation, kept ONLY as the reference `classic`
     *  values above are checked against in the test suite. Not called. */
    function _getChartColorLegacy(index, alpha = 1) {
        var b = $('body');
        var isLightTheme = !bodyIsDark();
        // Darken RGB values by 15% in light themes so white labels are readable on colored bars
        var d = (isLightTheme && alpha < 1) ? 0.85 : 1;
        const colors = [
            `rgba(${Math.round(51*d)}, ${Math.round(102*d)}, ${Math.round(153*d)}, ${alpha})`,   // Blue
            `rgba(${Math.round(255*d)}, ${Math.round(99*d)}, ${Math.round(132*d)}, ${alpha})`,    // Red
            `rgba(${Math.round(75*d)}, ${Math.round(192*d)}, ${Math.round(192*d)}, ${alpha})`,    // Teal
            `rgba(${Math.round(255*d)}, ${Math.round(205*d)}, ${Math.round(86*d)}, ${alpha})`,    // Yellow
            `rgba(${Math.round(153*d)}, ${Math.round(102*d)}, ${Math.round(255*d)}, ${alpha})`,   // Purple
            `rgba(${Math.round(255*d)}, ${Math.round(159*d)}, ${Math.round(64*d)}, ${alpha})`,    // Orange
            `rgba(${Math.round(199*d)}, ${Math.round(199*d)}, ${Math.round(199*d)}, ${alpha})`,   // Grey
            `rgba(${Math.round(83*d)}, ${Math.round(102*d)}, ${Math.round(255*d)}, ${alpha})`,    // Indigo
            `rgba(${Math.round(255*d)}, ${Math.round(99*d)}, ${Math.round(255*d)}, ${alpha})`,    // Pink
            `rgba(${Math.round(99*d)}, ${Math.round(255*d)}, ${Math.round(132*d)}, ${alpha})`     // Green
        ];
        return colors[index % colors.length];
    }

    // Helper: Darken an RGBA color string by a factor (0-1)
    function darkenRgba(rgbaStr, factor) {
        var m = rgbaStr.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
        if (!m) return rgbaStr;
        var r = Math.max(0, Math.round(parseInt(m[1]) * (1 - factor)));
        var g = Math.max(0, Math.round(parseInt(m[2]) * (1 - factor)));
        var b = Math.max(0, Math.round(parseInt(m[3]) * (1 - factor)));
        return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + (m[4] || '1') + ')';
    }

    // Lighten an rgba colour toward white by `factor` (0..1). Used for
    // the highlight stop in the 3-stop bar gradient so colours pop
    // without changing the perceived base hue.
    function lightenRgba(rgbaStr, factor) {
        var m = rgbaStr.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
        if (!m) return rgbaStr;
        var r = Math.min(255, Math.round(parseInt(m[1]) + (255 - parseInt(m[1])) * factor));
        var g = Math.min(255, Math.round(parseInt(m[2]) + (255 - parseInt(m[2])) * factor));
        var b = Math.min(255, Math.round(parseInt(m[3]) + (255 - parseInt(m[3])) * factor));
        return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + (m[4] || '1') + ')';
    }

    // Helper: Convert any color string (rgba or hex) to rgba with a specified alpha
    function hexToRgba(colorStr, alpha) {
        if (!colorStr) return colorStr;
        // Already rgba - just replace the alpha component
        var m = colorStr.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*[\d.]+)?\)/);
        if (m) {
            return 'rgba(' + m[1] + ', ' + m[2] + ', ' + m[3] + ', ' + alpha + ')';
        }
        // Hex (#RGB, #RRGGBB)
        var hex = colorStr.replace(/^#/, '');
        if (hex.length === 3) hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
        if (hex.length === 6) {
            var r = parseInt(hex.substring(0, 2), 16);
            var g = parseInt(hex.substring(2, 4), 16);
            var b = parseInt(hex.substring(4, 6), 16);
            return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + alpha + ')';
        }
        return colorStr;
    }

    // Helper: Get a darker border color for contrasting chart borders
    function getChartBorderColor(index) {
        return darkenRgba(getChartColor(index, 1), 0.3);
    }

    // Chart.js plugin: Apply gradient fills to bar/pie datasets
    // Uses _baseColors stored on each dataset; recalculates on every layout (handles resize)
    // Chart.js plugin builder: a value-axis reference/marker line (vis arg #36).
    // Returns a per-chart plugin object, or null when the option is unset or the
    // chart type has no straight value axis (pie/radar/treemap/waterfall/butterfly).
    // Drawn as a plugin (not a dataset) so it stays out of the legend, tooltips,
    // and auto-scaling. Shared by renderSnippetChart (inline/infobox/carousel) and
    // createVisualization (Builder preview) so every render matches.
    function buildReferenceLinePlugin(referenceLine, chartType, horizontal, isDark, chartTheme, fsBoost) {
        var raw = (referenceLine == null ? '' : String(referenceLine)).trim();
        if (!raw) return null;
        // gauge/bullet are excluded here even though they DO honour the arg:
        // for them it is the TARGET, drawn by their own decor plugins as an
