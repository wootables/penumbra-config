        if (!col) { show_text('Pick a column first.'); return; }
        var found = _csDistinctDataValues(col);
        if (found.length === 0) {
            show_text('No values found for ' + escapeHtml(col) + ' in the current results.');
            return;
        }
        found.sort(function(a, b) { return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }); });

        var values = getCSValuesFromList();
        var have = Object.create(null);
        for (var h = 0; h < values.length; h++) have[String(values[h]).trim().toLowerCase()] = true;
        var added = 0;
        for (var f = 0; f < found.length; f++) {
            var k = found[f].trim().toLowerCase();
            if (k in have) continue;
            have[k] = true;
            values.push(found[f]);
            added++;
