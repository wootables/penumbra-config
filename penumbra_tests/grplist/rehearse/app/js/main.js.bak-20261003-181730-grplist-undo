    /**
     * Returns the raw concatenated row-signature hash for the currently visible rows.
     * Matches the format stored as `dataSignature` on local snapshots.
     * Returns '' if no rows are visible.
     */
    /**
     * Captures the current resolved prompt answers for every [PROMPT...] referenced
     * in the active query + snippet. Returns an array of { name, value } pairs
     * suitable to embed in snapshot metadata for later display & mismatch checks.
     *
     * Resolution mirrors updatePromptDisplay() at js/main.js:34909 - pulls each
     * prompt's stored value from localStorage by definition-hash, falls back to
     * forcedefault, then default, then '' if nothing is set. Hidden prompts and
     * duplicates by storage key are skipped.
     */
    function _captureCurrentPrompts() {
        var query = '';
        var snippetQuery = '';
        try { query = getQuery(); } catch (e) {}
        try { snippetQuery = getSnippet(); } catch (e) {}
        var allQueries = (query || '') + "\n" + (snippetQuery || '');

        var promptRegex = /\[\s*PROMPT[^\]]*\]/gi;
        var seen = new Set();
        var captured = [];
        var match;

        while ((match = promptRegex.exec(allQueries)) !== null) {
            try {
                var parsed = parsePrompt(match[0]);
                if (!parsed || parsed.hidden) continue;
                var storageKey = getPromptStorageKey(match[0]);
                if (seen.has(storageKey)) continue;
                seen.add(storageKey);

                var displayValue = null;
                var storedRaw = localStorage.getItem(storageKey);
