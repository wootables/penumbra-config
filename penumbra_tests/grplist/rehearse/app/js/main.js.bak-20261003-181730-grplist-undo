        // binned or date-split row field carries over whole, and so does a
        // bucketed column field.
        var xAxis = P.rowFields.length ? P.rowFields[0] : '';
        var groupBy = 'none';
        if (P.colFields.length >= 1) {
            groupBy = P.colFields[0];
            if (P.colFields.length > 1) {
                warn.push('Only the first column field (' + pivotFieldBase(groupBy) + ') became the chart series; the pivot nests ' + P.colFields.length + '.');
            }
            if (P.rowFields.length > 1) {
                warn.push('A chart has one X axis, so only ' + pivotFieldBase(xAxis) + ' came across - the pivot nests ' + P.rowFields.length + ' row fields.');
            }
        } else if (P.rowFields.length > 1) {
            // No column field, nested rows: the second row field is exactly what
            // a series is for. Dropping it (the pre-2026-09-04 behaviour) threw
            // away the split the pivot was built to show.
            groupBy = P.rowFields[1];
            warn.push('A chart has one X axis, so ' + pivotFieldBase(xAxis) + ' became the X axis and the second row field, '
                + pivotFieldBase(groupBy) + ', became the series'
