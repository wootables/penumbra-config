        // column: re-run that sort so the new comparator is used. The only way in
        // is the header click handler, whose state machine for a column ALREADY in
        // the chain is asc -> desc -> off. There is no transition that lands back
        // on asc, so the direction we need decides how to drive it (a naive
        // "flip then click" silently DELETED the sort whenever it was ascending -
        // caught in live testing, the table just reverted to unsorted order).
        // Every synthetic click carries shiftKey so the handler stays in
        // multi-sort mode and never wipes the rest of the chain.
        var idx = -1;
        for (var i = 0; i < sortCriteria.length; i++) {
