        });
    });

    // --- Clear Report Storage ---
    $('#spClearStorage').on('click', function() {
        // The button reads "...For This Report", which is true of the six
        // preference types below but NOT of step 5 (prompt answers are keyed by
        // question hash, so there is no per-report bucket) or step 6 (the floating
        // pad position is global by design). The confirm is the last gate before
        // an unundoable wipe, so it says so rather than leaning on the label.
        if (!confirm(
                'Clear the preferences saved in this browser for this report?\n\n' +
                'Column layout and order, column summaries, theme, density, rows per page, ' +
                'consistent row height and deep link vendor codes.\n\n' +
                'Two of these are NOT limited to this report and will be cleared everywhere: ' +
                'every saved prompt answer in this browser, and the floating pad position.\n\n' +
                'Your global default theme and density are kept, so are other reports\' ' +
                'settings, and so is anything saved to the server.')) return;

        // With no report loaded this clears the landing-page pseudo-report
        var reportName = _spPrefKey();

        // 1. Report preferences (rows per page)
        try {
            var prefs = _spPrefMap(REPORT_PREFS_KEY);
            delete prefs[reportName];
            localStorage.setItem(REPORT_PREFS_KEY, JSON.stringify(prefs));
        } catch(e) {}

        // 2. Row expand prefs
        try {
            var expandPrefs = _spPrefMap('penumbra_pref_rowExpand');
            delete expandPrefs[reportName];
            localStorage.setItem('penumbra_pref_rowExpand', JSON.stringify(expandPrefs));
        } catch(e) {}

        // 3. Column layout prefs
        try {
            var colPrefs = _spPrefMap('penumbra_column_prefs');
            delete colPrefs[reportName];
            localStorage.setItem('penumbra_column_prefs', JSON.stringify(colPrefs));
        } catch(e) {}

        // 4. Resolver link prefs
        try {
            var resolverPrefs = _spPrefMap('penumbra_resolver_prefs');
            delete resolverPrefs[reportName];
            localStorage.setItem('penumbra_resolver_prefs', JSON.stringify(resolverPrefs));
        } catch(e) {}

        // 4a. Theme prefs
        try {
            var themePrefsClr = _spPrefMap('penumbra_pref_theme');
            delete themePrefsClr[reportName];
            localStorage.setItem('penumbra_pref_theme', JSON.stringify(themePrefsClr));
        } catch(e) {}

        // 4b. Density prefs
        try {
            var densityPrefsClr = _spPrefMap('penumbra_pref_density');
            delete densityPrefsClr[reportName];
            localStorage.setItem('penumbra_pref_density', JSON.stringify(densityPrefsClr));
        } catch(e) {}

        // 5. Prompt answers (keyed by hash)
        for (var i = localStorage.length - 1; i >= 0; i--) {
            var key = localStorage.key(i);
            if (key && key.indexOf('penumbra_prompt_') === 0) {
                localStorage.removeItem(key);
            }
        }


        // 5a. Local presets for this report - ASKED FOR SEPARATELY, never assumed.
        //
        // Presets are authored work, not a preference: someone who wants their
        // column layout reset rarely means "and throw away the six pivot views I
        // built". So this is a second, opt-in confirm, and it is skipped entirely
        // when there is nothing to ask about.
        //
        // KEY TRAP: presets do NOT key on _spPrefKey(). That returns the loaded
        // STATE NAME (or '__landing__'); the preset engine keys on the ?id= report
        // id (or '__adhoc__'). Reusing the pref key here would silently match no
        // presets and the prompt would never appear. Always ask the engine.
        //
        // Server-side presets are untouched by any branch below - they are shared
        // with everyone who opens the report, and one person clearing their own
        // browser preferences is not a decision about other people's data.
        try {
            if (window.PenumbraPresets && typeof window.PenumbraPresets.localScopes === 'function') {
                var _clrRid = window.PenumbraPresets.reportId();
                var _clrScopes = [], _clrCount = 0;
                window.PenumbraPresets.localScopes().forEach(function (sc) {
                    if (sc.id !== _clrRid) { return; }
                    var items = window.PenumbraPresets.list(sc.ns, sc.id);
                    if (items.length) { _clrScopes.push({ ns: sc.ns, items: items }); _clrCount += items.length; }
                });
                if (_clrCount > 0) {
                    var _clrNoun = _clrCount === 1 ? 'preset' : 'presets';
                    if (confirm('Also delete the ' + _clrCount + ' ' + _clrNoun +
                                ' saved in this browser for this report?\n\n' +
                                'That covers pivot and group layouts, visualizations, searches and templates.\n\n' +
                                'Presets saved to the server are shared with everyone and are NOT affected either way.\n\n' +
                                'OK = delete them too.      Cancel = keep them.')) {
                        _clrScopes.forEach(function (sc) {
                            sc.items.forEach(function (p) {
                                window.PenumbraPresets.remove(sc.ns, _clrRid, p.name);
                            });
                        });
                    }
                }
            }
        } catch (e) { /* engine absent on this page - nothing local to clear */ }

        // 6. Floating button position + rail orientation (global - reset in
        // case it drifted off-screen)
        localStorage.removeItem(FLOATING_BTN_POS_KEY);
        localStorage.removeItem('penumbra_floating_btn_orient');

        show_text("<p id='undo_text'><span style='color: lightgreen'>CLEARED:</span> All saved preferences for this report have been cleared. Reloading...</p>", 2000);
        closeSettingsPanel();
        setTimeout(function() { location.reload(); }, 1500);
    });

