 * Decompresses a URL-safe string that was compressed with the function above.
 * This version correctly reconstructs a Uint8Array before passing it to pako.
 * @param {string} encodedStr - The string from the URL to decompress.
 * @returns {string} The original, decompressed string.
 */
    function decompressString(encodedStr) {
