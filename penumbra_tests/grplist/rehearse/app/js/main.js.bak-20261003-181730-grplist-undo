    /**
     * Parses a string that may contain currency symbols, commas, or accounting-style
     * negative parentheses (e.g. "($100.00)") into a valid float number.
     */
    function parseAccountingNumber(val) {
        if (val === null || val === undefined || val === '')
            return NaN;
        let str = String(val).trim();
        // Check for (123) format
        const isNegative = str.startsWith('(') && str.endsWith(')');
        // Remove $, ,, (, ), % - and \x02, the guard the infobox/subtitle engine
        // wraps round()/fixed() output in, so a guarded value still compares
        // numerically inside case()/format() conditions.
        const clean = str.replace(/[$,()%\x02]/g, '').trim();
        // Validate the ENTIRE cleaned string is a valid number (not a partial match like "2014-0685" → 2014)
        if (!/^[-+]?(\d+(\.\d*)?|\.\d+)$/.test(clean))
            return NaN;
        const num = parseFloat(clean);
        if (isNaN(num))
            return NaN;
        return isNegative ? -num : num;
    }

