    // ===== Admin: "Copy Snippet for Action(trigger)" =====
    // Builds the action(trigger, 'Label', 'cmd|args') line matching the
    // current copy dialog state so an admin can paste it into the report's
    // Custom Code snippet area. Mirrors the pivot/viz "Copy Snippet" pattern
    // (#copyPivotSnippetBtn at js/main.js:13137). Quoting picks single or
    // double quotes based on the value's contents; values with both fall
    // back to substituting the inner-quote with a backtick (rare in
    // practice - typically column names, table names, language identifiers,
    // or simple templates).
    function _copyQuoteForAction(s) {
        const str = String(s);
        const hasSingle = str.indexOf("'") !== -1;
        const hasDouble = str.indexOf('"') !== -1;
        if (!hasSingle) return "'" + str + "'";
        if (!hasDouble) return '"' + str + '"';
        return "'" + str.replace(/'/g, '`') + "'";
    }
    function _buildCopySnippet() {
        const fmt = $('input[name="copyFormat"]:checked').val();
        let cmd = '';
        let label = 'Copy';
        switch (fmt) {
            case 'html':
                cmd = 'copy_html'; label = 'Copy as HTML'; break;
            case 'csv': {
                const flatten = $('input[name="csvCopyNestedOption"]:checked').val() === 'flatten';
                cmd = flatten ? 'copy_csv|flatten' : 'copy_csv';
                label = flatten ? 'Copy as CSV (flatten nested)' : 'Copy as CSV';
                break;
            }
            case 'tsv': {
                const flatten = $('input[name="tsvCopyNestedOption"]:checked').val() === 'flatten';
                cmd = flatten ? 'copy_tsv|flatten' : 'copy_tsv';
                label = flatten ? 'Copy as TSV (flatten nested)' : 'Copy as TSV';
                break;
            }
            case 'json':
                cmd = 'copy_json'; label = 'Copy as JSON'; break;
            case 'single_col': {
                const col = $('#copyColumnSelector').val();
                if (!col) return { error: 'Pick a column first, then try again.' };
                const delim = $('#copyDelimiterInput').val();
                // Only include the delimiter arg when it differs from the default ';'
                cmd = (delim && delim !== ';') ? 'copy_distinct|' + col + '|' + delim : 'copy_distinct|' + col;
                label = 'Copy unique ' + col;
                break;
            }
            case 'sql': {
                const tableName = $('#sqlTableNameInput').val().trim();
                if (!tableName) return { error: 'Enter a table name first, then try again.' };
                cmd = 'copy_sql|' + tableName;
                label = 'Generate ' + tableName + ' INSERTs';
                break;
            }
            case 'custom': {
                let tpl = $('#customTemplateInput').val();
                if (!tpl.trim()) return { error: 'Enter a template first, then try again.' };
                // Round-trip safety: a literal tab inside an action() arg is
                // unreadable. Convert real tabs back to \t - the copy_template
                // handler converts \t escapes back to actual tabs at runtime.
                tpl = tpl.replace(/\t/g, '\\t');
                // Backtick-wrap so the snippet engine stores the template
                // VERBATIM instead of pre-evaluating any string() calls (and
                // comma-formatting bare numbers) at render time - the click
                // handler strips the wrapping pair. Skip if the template
                // itself contains a backtick (nesting would end protection
                // early); such templates round-trip only if they avoid
                // render-time evaluation triggers.
                cmd = 'copy_template|' + (tpl.indexOf('`') === -1 ? '`' + tpl + '`' : tpl);
                label = 'Copy with template';
                break;
            }
            case 'api_snippet': {
                if (currentReportIsEncrypted) {
                    return { error: 'API connection string is disabled for encrypted reports - no trigger snippet to generate.' };
                }
                const lang = $('#apiSnippetLanguage').val() || 'python';
                cmd = 'copy_api_snippet|' + lang;
                label = 'Copy API snippet (' + lang + ')';
                break;
            }
            case 'php_stub':
                return { error: 'PHP Stub has no action(trigger) equivalent - it generates a full standalone script, not a clipboard copy.' };
            default:
                return { error: 'Unknown copy format.' };
        }
        return { snippet: 'action(trigger, ' + _copyQuoteForAction(label) + ', ' + _copyQuoteForAction(cmd) + ')' };
    }

    $(document).on('click', '#copyCopySnippetBtn', function () {
        const result = _buildCopySnippet();
        if (result.error) {
            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> " + escapeHtml(result.error) + "</p>");
            return;
        }
        navigator.clipboard.writeText(result.snippet).then(function () {
            show_text("<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Snippet copied to clipboard.</p>");
            $('#copyActionsLightbox').fadeOut();
        }, function () {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to copy snippet to clipboard.</p>");
        });
    });
    // ===== END: Copy Snippet for Action(trigger) =====

    // ===== Custom Template authoring helpers =====
    // Insert-at-caret, click-to-insert placeholders, double-click autocomplete,
    // and per-report localStorage template presets.

    // Active template field (the last-focused of the copy / download template
    // boxes, all marked .pnb-tpl-field) + its caret, so click-to-insert and
    // autocomplete land in the right box. Only one of the copy/download dialogs
    // is open at a time, so a single global active-field is unambiguous.
    var _tplActiveField = null;
    var _tplActiveSel = { s: 0, e: 0 };
    $(document).on('keyup click focus select', '.pnb-tpl-field', function () {
        _tplActiveField = this;
        _tplActiveSel = { s: this.selectionStart, e: this.selectionEnd };
    });

    // Insert text at the caret of the given field (defaults to the active field).
    // Appends at the end if the field was never focused.
    function _tplInsertAtCaret(text, taEl) {
        var ta = taEl || _tplActiveField;
        if (!ta) return;
        var sameAsActive = (ta === _tplActiveField);
        var sel = sameAsActive ? _tplActiveSel : { s: ta.value.length, e: ta.value.length };
        var s = Math.min(sel.s, ta.value.length), e = Math.min(sel.e, ta.value.length);
        ta.value = ta.value.slice(0, s) + text + ta.value.slice(e);
        var pos = s + text.length;
        ta.focus();
        ta.setSelectionRange(pos, pos);
        _tplActiveField = ta;
        _tplActiveSel = { s: pos, e: pos };
    }

    // Click a placeholder chip to insert it. Goes to the active field when one
    // is focused/visible; otherwise the list's own default field (data-tpl-default).
    $(document).on('click', '.pnb-tpl-placeholders code', function () {
        var defaultSel = $(this).closest('.pnb-tpl-placeholders').data('tpl-default');
        var target = (_tplActiveField && _tplActiveField.offsetParent !== null) ? _tplActiveField
            : (defaultSel ? document.querySelector(defaultSel) : null);
        _tplInsertAtCaret($(this).text(), target);
    });

    // Builds the "Available Placeholders" HTML (visible columns + nested
    // {Parent-Sub}) shared by the copy and download custom-template panels.
    function _tplBuildPlaceholderHtml() {
        var headers;
        if ($('#pivot-output-container').is(':visible')) {
            headers = getFlatPivotHeaders();
        } else {
            headers = $("#resultsTable > thead > tr#tableHeader th[data-colname]").map(function () {
                return $(this).data('colname');
            }).get();
        }
        // \t is a chip like any other so the "(click to insert)" label is true for
        // everything in the list - it was previously bare text and the only entry
        // clicking did nothing for.
        var html = '<strong>Available Placeholders</strong> (click to insert): '
            + '<code title="Click to insert a tab at the cursor">\\t</code> (tab), '
            + headers.map(function (h) { var fh = (window.Penumbra && window.Penumbra.journalFriendlyCol && window.Penumbra.journalFriendlyCol(h)) || h; return '<code title="Click to insert at the cursor">{' + fh + '}</code>'; }).join(', ');
        var nested = [];
        try { nested = getNestedColumnPlan(); } catch (e) { nested = []; }
        if (nested.length > 0) {
            var codes = [];
            nested.forEach(function (p) {
                p.subNames.forEach(function (sub) {
                    codes.push('<code title="Click to insert at the cursor">{' + p.parentName + '-' + sub + '}</code>');
                });
            });
            html += '<br><strong>Nested sub-columns:</strong> ' + codes.join(', ')
                + '<br><small style="color: #555;">Using any nested sub-column placeholder expands each row into one line per nested entry.</small>';
        }
        return html;
    }

    // --- Suggestion list for the double-click autocomplete ---
    // Columns (incl. pivot + nested {Parent-Sub}), data() keys (fixed keys +
    // this report's prompt names), and string() op stubs.
    function _tplBuildSuggestions() {
        var items = [];
        var headers;
        if ($('#pivot-output-container').is(':visible')) {
            headers = getFlatPivotHeaders();
        } else {
            headers = $("#resultsTable > thead > tr#tableHeader th[data-colname]").map(function () {
                return $(this).data('colname');
            }).get();
        }
        headers.forEach(function (h) { var fh = (window.Penumbra && window.Penumbra.journalFriendlyCol && window.Penumbra.journalFriendlyCol(h)) || h; items.push({ label: '{' + fh + '}', value: '{' + fh + '}' }); });
        try {
            getNestedColumnPlan().forEach(function (p) {
                p.subNames.forEach(function (sub) {
                    items.push({ label: '{' + p.parentName + '-' + sub + '}', value: '{' + p.parentName + '-' + sub + '}' });
                });
            });
        } catch (e) { }
        try {
            Object.keys(getCurrentPromptParams()).forEach(function (n) {
                items.push({ label: 'data(' + n + ')  - prompt answer', value: 'data(' + n + ')' });
            });
        } catch (e) { }
        ['title', 'subtitle', 'search', 'theme', 'density', 'count', 'timestamp', 'url', 'prompts',
            'prompt1', 'prompt2', 'prompt3', 'prompt4', 'prompt5', 'prompt6'].forEach(function (k) {
            items.push({ label: 'data(' + k + ')', value: 'data(' + k + ')' });
        });
        ['uppercase', 'lowercase', 'titlecase', 'trim', 'ltrim', 'rtrim', 'replace', 'regex_replace',
            'split', 'substr', 'concat', 'padstart', 'length'].forEach(function (op) {
            items.push({ label: 'string(' + op + ', …)', value: 'string(' + op + ', ' });
        });
        return items;
    }

    // The token at the caret, for filter + replace-on-select.
    // A double-click hands us the browser's WORD selection, and { } ( ) are not
    // word characters - so the most natural gesture (double-click an existing
    // {PLACEHOLDER} to swap it for another) used to select only the inner word
    // and nest a second pair of braces inside the old one: {PROJ} picking
    // {PROJECT_ID} produced "{{PROJECT_ID}}". Re-anchor the START of a selection
    // with the same grammar the typed path uses, so a leading "{" / "data(" is
    // pulled into the token; the trailing closer is absorbed at select time
    // (it depends on which suggestion is picked). A dblclick that lands on a
    // separator (a space, a "|") now yields an empty token - i.e. the full
    // suggestion list at the caret - instead of substring-matching junk.
    function _tplTokenAtCaret(ta) {
        var s = ta.selectionStart || 0, e = ta.selectionEnd || 0;
        var anchor = (e > s) ? e : s;
        var m = ta.value.slice(0, anchor).match(/[A-Za-z0-9_\-{(]*$/);
        var w = m ? m[0] : '';
        return { word: w, start: anchor - w.length, end: anchor };
    }

    // Manual-only jQuery UI autocomplete: typing alone never opens it (the
    // source returns nothing until a double-click arms it), but once open it
    // live-filters as you type. Escape dismisses only the menu (the global
    // capture-phase handler already knows jQuery UI autocompletes).
    // Render the custom-download HEADER line once. Bare {COL} placeholders emit
    // the column NAME (header label, not row data); data()/string() resolve
    // run-scoped values. Mirrors the flat-render path of generateTemplateOutput
    // but with resolveRef returning the column name.
    function _tplRenderHeaderLine(headerStr) {
        headerStr = String(headerStr == null ? '' : headerStr);
        if (!headerStr) return '';
        var names = {};
        var cols;
        if ($('#pivot-output-container').is(':visible')) {
            cols = getFlatPivotHeaders();
        } else {
            cols = $("#resultsTable > thead > tr#tableHeader th[data-colname]").map(function () {
                return $(this).data('colname');
            }).get();
        }
        cols.forEach(function (c) {
            if (c == null) return;
            // Journal columns: a {Done} token (and the legacy {__JOURNAL_TOGGLE__done}
            // token, kept for any template saved before this fix) both render "Done".
            var f = (window.Penumbra && window.Penumbra.journalFriendlyCol && window.Penumbra.journalFriendlyCol(c)) || null;
            if (f) { names[String(c).toUpperCase()] = f; names[String(f).toUpperCase()] = f; }
            else { names[String(c).toUpperCase()] = String(c); }
        });
        try {
            getNestedColumnPlan().forEach(function (p) {
                p.subNames.forEach(function (sub) {
                    names[(p.parentName + '-' + sub).toUpperCase()] = p.parentName + '-' + sub;
                });
            });
        } catch (e) { }
        var resolveHeaderRef = function (name) {
            var k = String(name).toUpperCase();
            return Object.prototype.hasOwnProperty.call(names, k) ? names[k] : null;
        };
        if (typeof PenumbraTemplate === 'undefined') return headerStr;
        var resolveData = function (argVals) {
            var dataType = String(argVals[0] || 'search').toLowerCase().trim();
            var colParam = argVals[1] ? stripWrappingQuotePair(String(argVals[1]).toUpperCase()).trim() : null;
            var dv = penumbraDataLookup(dataType, colParam, argVals[2]);
            return String(dv.v);
        };
        var segs = PenumbraTemplate.parse(headerStr);
        return segs.map(function (s) {
            if (s.type === 'text') {
                return s.value.replace(/{[^}]+}/g, function (m) {
                    var v = resolveHeaderRef(m.slice(1, -1));
                    return v == null ? m : v;
                });
            }
            return PenumbraTemplate.evalNode(s, resolveHeaderRef, resolveData);
        }).join('');
    }

    // Build the full custom-template file text: optional header line (always its
    // own line 1) + the per-row body. cfg (from a ?dltpl= link) overrides the
    // dialog fields when present: { header, body, newline }.
    function _buildCustomDownloadText(cfg) {
        var headerStr = (cfg && typeof cfg.header !== 'undefined') ? cfg.header : $('#dlCustomHeaderInput').val();
        var bodyStr = (cfg && typeof cfg.body !== 'undefined') ? cfg.body : $('#dlCustomTemplateInput').val();
        var nl = (cfg && typeof cfg.newline !== 'undefined') ? !!cfg.newline : $('#dlCustomTemplateNewline').is(':checked');
        var body = generateTemplateOutput(String(bodyStr).replace(/\\t/g, '\t'));
        var joinChar = nl ? '\n' : '';
        var header = _tplRenderHeaderLine(String(headerStr).replace(/\\t/g, '\t'));
        var text = body.join(joinChar);
        if (header) text = header + '\n' + text;
        return { text: text, rows: body.length, hasContent: body.length > 0 };
    }

    // Generate + trigger the custom-template Blob download. cfg overrides the
    // dialog fields (used by the ?download=custom direct-link path); pass null
    // for the interactive "Download Selected" button. Returns false on no data.
    function _fireCustomDownload(cfg) {
        // An empty row template renders as one BLANK line per row, so without
        // this the user gets a file of nothing (or a lone header line) with no
        // hint that anything was wrong. "Create direct download link" already
        // refuses to build such a link; guard the fire path too so both
        // "Download Selected" and an old/hand-edited ?dltpl= link are covered.
        var tplBody = (cfg && typeof cfg.body !== 'undefined') ? cfg.body : $('#dlCustomTemplateInput').val();
        if (!String(tplBody == null ? '' : tplBody).trim()) {
            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> Enter a row template before downloading - an empty template produces a file of blank lines.</p>");
            return false;
        }
        var built = _buildCustomDownloadText(cfg);
        if (!built.hasContent) {
            show_text("<p id='undo_text'><span style='color: orange'>NOTICE:</span> No visible rows to generate the file from.</p>");
            return false;
        }
        var ext = String((cfg && cfg.ext) || $('#dlCustomExtSelect').val() || 'txt').toLowerCase();
        // Only whitelisted extensions (the dropdown set) - a link param can't
        // smuggle an arbitrary extension into the saved filename.
        if (['txt', 'csv', 'tsv', 'md', 'json', 'xml', 'cstm'].indexOf(ext) === -1) ext = 'txt';
        // Prepend a UTF-8 BOM for every text format EXCEPT json (the JSON spec
        // says not to emit one). Without it, Windows tools - Notepad's
        // IsTextUnicode heuristic especially - can misdetect a short ASCII file
        // as UTF-16 and render it as CJK/"Japanese" mojibake ("Bush hid the
        // facts"). The bytes are already correct UTF-8; the BOM just makes the
        // encoding unambiguous. (csv/tsv always needed it for Excel anyway.)
        var bom = (ext === 'json') ? '' : '﻿';
        var blob = new Blob([bom + built.text], { type: _tplExtMime(ext) });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = getReportFilename(ext);
        document.body.appendChild(a);
        a.click();
        URL.revokeObjectURL(a.href);
        document.body.removeChild(a);
        penumbraLogExport('custom');
        return true;
    }

    // Header default = the visible columns as placeholders ({C1},{C2},...),
    // which render to the column NAMES on line 1. Prefilled on dialog open, but
    // only until the user edits the header (so "clear it for no header" sticks,
    // and a loaded preset's header is never overwritten).
    var _dlHeaderTouched = false;
    $(document).on('input', '#dlCustomHeaderInput', function () { _dlHeaderTouched = true; });
    function _dlDefaultHeader() {
        var cols;
        if ($('#pivot-output-container').is(':visible')) {
            cols = getFlatPivotHeaders();
        } else {
            cols = $("#resultsTable > thead > tr#tableHeader th[data-colname]").map(function () {
                return $(this).data('colname');
            }).get();
        }
        return cols.map(function (c) { var fc = (window.Penumbra && window.Penumbra.journalFriendlyCol && window.Penumbra.journalFriendlyCol(c)) || c; return '{' + fc + '}'; }).join(',');
    }
    function _dlMaybePrefillHeader() {
        if (_dlHeaderTouched) return;
        if (!$('#dlCustomHeaderInput').val()) $('#dlCustomHeaderInput').val(_dlDefaultHeader());
    }

    // MIME type for a custom-template extension (client Blob download; the
    // extension is a filename suffix, never a server Content-Type).
    function _tplExtMime(ext) {
        switch (String(ext || '').toLowerCase()) {
            case 'csv': return 'text/csv;charset=utf-8;';
            case 'tsv': return 'text/tab-separated-values;charset=utf-8;';
            case 'json': return 'application/json;charset=utf-8;';
            case 'xml': return 'application/xml;charset=utf-8;';
            case 'md': return 'text/markdown;charset=utf-8;';
            default: return 'text/plain;charset=utf-8;';
        }
    }

    // Manual-only jQuery UI autocomplete, wired to each template field. Typing
    // alone never opens it (the source returns nothing until a double-click
    // arms it), but once open it live-filters as you type. Escape dismisses
    // only the menu (the global capture-phase handler already knows
    // jQuery UI autocompletes).
    var _tplAcArmed = false;
    function _tplOpenAutocomplete(taEl) {
        taEl = taEl || _tplActiveField;
        if (!taEl) return;
        _tplAcArmed = true;
        $(taEl).autocomplete('search', '');
    }
    function _tplWireAutocomplete(sel) {
        var el = document.querySelector(sel);
        if (!el) return;
        $(el).autocomplete({
            minLength: 0,
            delay: 0,
            // Append to <body> (jQuery UI default, and where every other
            // autocomplete in the app lives). Appending inside the dialog
            // collapsed the menu items to zero height under the dialog's CSS;
            // the z-index bump in open() keeps the body-level menu above the
            // lightbox.
            source: function (req, resp) {
                if (!_tplAcArmed) { resp([]); return; }
                var ta = this.element[0];
                var tok = _tplTokenAtCaret(ta).word.toLowerCase().replace(/^[{(]/, '');
                var items = _tplBuildSuggestions().filter(function (it) {
                    return !tok || it.label.toLowerCase().indexOf(tok) !== -1;
                });
                resp(items.slice(0, 50));
            },
            focus: function () { return false; }, // don't clobber the field while arrowing
