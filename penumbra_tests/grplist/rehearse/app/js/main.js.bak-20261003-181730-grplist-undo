    // --- Key-column uniqueness check (shared by the scheduler change-analysis
    // card and the snapshot lightbox "Key" mode) ------------------------------
    // A row key should identify each row uniquely; rows that share a key tuple
    // are paired by position in the diff, which can misreport Modified rows.
    // Evaluated against masterRowData (includes HIDDEN columns - the same
    // column set the scheduler diffs via rawData and the client analysis
    // walks), using generateRowSignature so "duplicate" means exactly what the
    // diff's pairing will see. Returns null when there is nothing to evaluate,
    // else { rows, unique, dupRows, blankRows } where dupRows counts rows
    // sharing their key with at least one other row.
    function evaluateKeyColumnUniqueness(keyColumns) {
        if (!keyColumns || keyColumns.length === 0) return null;
        if (typeof masterRowData === 'undefined' || !masterRowData || masterRowData.length === 0) return null;
        var upper = [];
        for (var c = 0; c < keyColumns.length; c++) upper.push(String(keyColumns[c]).toUpperCase());
        var counts = Object.create(null); // keyed by a row signature - never {}
