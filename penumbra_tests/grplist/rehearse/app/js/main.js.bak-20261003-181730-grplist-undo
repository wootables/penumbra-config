    // Exposed for the home-screen "Jump Back In" list (pinned_reports.js): open a
    // favorited table by re-running SELECT * FROM <table> through the normal
    // ?state= load path (which suppresses the landing page and auto-titles it).
    // Ensures pako is loaded first, since the landing page lazy-loads it.
    window.penumbraOpenTableFromFavorite = function (tableName) {
        var safe = String(tableName || '').replace(/[^A-Za-z0-9_.$#]/g, '');
        if (!safe) return;
        var go = function () {
            var enc = compressString(JSON.stringify({ query: 'SELECT * FROM ' + safe, noLimit: false }));
            if (!enc) return;
            window.location.href = window.location.href.split('?')[0] + '?state=' + enc;
        };
