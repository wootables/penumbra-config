            // 1:1 with the source view, so a footer would be misleading.
            return { content: content, rowCount: flatBody.length };
        }

        // Header
        let headerArray = visibleColumnInfo.map(info => escapeCsvCell(info.name, delim));
        content += headerArray.join(delim) + "\n";

        // Body
        let bodyRows = [];
        $sourceRows.each(function (index) {
            const $row = $(this);
            let rowData = visibleColumnInfo.map(info => {
                const cellNode = cellOf($row[0], info.id);
                const $cell = [cellNode];   // getCleanText reads [0]
