            var m = rows[i];
            if (!m || !m.get) continue;
            var v = String(m.get(key) == null ? '' : m.get(key)).trim();
            if (!v) continue;
            if (!seen[v]) { seen[v] = 1; n++; if (cap && n > cap) return n; }
        }
        return n;
    }

    // ---- Reader: grouped view ------------------------------------------
    function groupsToVizConfig() {
        var col = currentGroupingColumn;
        if (!col || col === '__SNAP_TYPE') return null;
        var warn = [];
        var agg = 'count', yAxis = '';

        // A NESTED grouping has a natural chart shape: level 1 is the X axis and
        // level 2 is the SERIES. Reading only currentGroupingColumn (level 0)
        // charted a two-level grouping as though it were flat, silently dropping
        // the inner split. (2026-08-30)
        //
        // A bucket token (AWARD_DATE:fy) passes through untouched in EITHER
        // slot: the X axis has accepted them since 08-27 and the series slot
        // since 09-04 (before that a bucketed level 2 had no Group By option to
        // land on and vanished).
