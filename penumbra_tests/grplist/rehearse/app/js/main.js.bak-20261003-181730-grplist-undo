        var win = hostDoc.defaultView || window;
        // Flip up when the menu would run off the bottom of the viewport.
        var top = (r.bottom + mh > win.innerHeight - 8) ? Math.max(8, r.top - mh - 4) : r.bottom + 4;
        $menu.css({ top: top + 'px', left: Math.max(8, Math.min(r.right - mw, win.innerWidth - mw - 8)) + 'px' });
    });

    $(document).on('click', '.sp-sumtype-opt', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var type = $(this).attr('data-type');

        // Two possible openers: the panel's type button, or a badge in the
        // summary row itself (which is transient and re-renders in place).
        var $badge = $('.pnb-sum-badge.is-open');
        if ($badge.length) {
            var colName = $badge.attr('data-sum-col');
            if (colName) {
                // Custom Formula needs an expression: from a badge it opens the
                // formula box in this same popover instead of applying.
                if (type === 'formula') {
                    _spOpenBadgeFormula($(this).closest('.sp-sumtype-menu'), $badge[0], colName);
                    return;
                }
                _spCommitBadgePick(colName, type);
                return;
            }
        }

        var $btn = $('#spColumnList .sp-col-sumtype.is-open');
        if ($btn.length) _spSetSummaryType($btn.closest('.sp-col-item'), type);
        _spCloseSummaryMenu();
        updateApplyResetState();
    });

    // ---- SHOW toggle: badges on/off everywhere ---------------------------
    // Applies immediately (it is a display switch, not a pending layout change)
    // and persists for this report. The REPORT-level value is what scheduled
    // email/PDF/XLSX read, so an author saving the report carries it outward;
    // a plain viewer's toggle only affects their own browser and exports.
    $(document).on('click', '#spBadgeToggle', function(e) {
        e.preventDefault();
        userSummaryBadges = !penumbraSummaryBadgesOn();
        // Label = the next action, matching #spHideUnchecked.
        $(this).attr('title', 'Type badges (SUM, AVG, ...) next to each summary value are currently ' +
                     (userSummaryBadges ? 'shown' : 'hidden') + '. Click to ' +
                     (userSummaryBadges ? 'hide' : 'show') +
                     ' them everywhere - table, exports, PDF and scheduled email.')
               .text(userSummaryBadges ? 'Hide badges' : 'Show badges');
        persistSummaryBadgePref(userSummaryBadges);
        penumbraRefreshSummaryFooters();
        penumbraRefreshDrillFooters();
    });

    // ---- Click a badge in the summary row to change that column's summary --
    // Transient by design: recalculates in place, saves nothing. That is also
    // why it stays available when the admin has disabled column customization -
    // there is no stored preference for that setting to gate.
    $(document).on('click keydown', '.pnb-sum-badge', function(e) {
        if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        e.stopPropagation();

        var $badge = $(this);
        if ($badge.hasClass('is-open')) { _spCloseSummaryMenu(); return; }
        _spCloseSummaryMenu();

        // Resolve which COLUMN this badge belongs to - every summary layer is
        // keyed by NAME. The cell's own data-sum-col is authoritative and is the
        // only thing that works in a breakdown table, whose cells have no
        // data-column and whose headers have no data-colname. The header lookups
        // are fallbacks for any footer rendered before this build stamped it.
        var $td = $badge.closest('td');
        var colId = $td.attr('data-column');
        var colName = $td.attr('data-sum-col') ||
                      $('#tableHeader th[data-column="' + colId + '"]').attr('data-colname') ||
                      $badge.closest('table').find('thead th').eq($td.index()).attr('data-colname') || '';
        if (!colName) return;
        $badge.attr('data-sum-col', colName).addClass('is-open');

        var current = $badge.attr('data-sum-type');
        if (colId === undefined) {
            colId = ($("#resultsTable").data('columnNameToOriginalIndex') || {})[colName];
        }
        var props = ($("#resultsTable").data('columnProperties') || {})[colId];
        var looksNumeric = !!(props && (props.isNumeric || props.isCurrency) && !props.isBoolean);

        // Every type is offered, Custom Formula included: picking it opens a
        // formula box in this popover (_spOpenBadgeFormula). Until 2026-10-02
        // there was no box, so the type was listed only for a column that
        // already had a formula - otherwise it could only give an empty cell.
        var html = '<div class="sp-sumtype-menu" role="menu">';
        PENUMBRA_SUMMARY_ORDER.forEach(function(key) {
            var def = PENUMBRA_SUMMARY_TYPES[key];
            if (!def) return;
            html += '<button type="button" role="menuitemradio" class="sp-sumtype-opt' +
                    (key === current ? ' is-current' : '') +
                    (def.numeric && !looksNumeric ? ' is-nonnumeric' : '') + '"' +
                    ' data-type="' + escapeHtml(key) + '">' +
                    '<span class="sp-sumtype-badge">' + escapeHtml(def.badge) + '</span>' +
                    '<span class="sp-sumtype-label">' + escapeHtml(def.label) + '</span>' +
                    (def.numeric && !looksNumeric ? '<span class="sr-only"> (does not look numeric)</span>' : '') +
                    '</button>';
        });
        html += '</div>';

        var hostDoc = this.ownerDocument || document;
        var $menu = $(html).appendTo(hostDoc.body);
        var r = this.getBoundingClientRect();
        var mh = $menu.outerHeight(), mw = $menu.outerWidth();
        var win = hostDoc.defaultView || window;
        // The footer sits at the BOTTOM of the table, so this almost always
        // flips upward.
        var top = (r.bottom + mh > win.innerHeight - 8) ? Math.max(8, r.top - mh - 4) : r.bottom + 4;
        $menu.css({ top: top + 'px', left: Math.max(8, Math.min(r.left, win.innerWidth - mw - 8)) + 'px' });
    });

    // Apply a pick made in a footer badge's popover. Transient layer only: the
    // footers recalculate in place and nothing is saved. `formula` comes with a
    // pick from the formula box.
    function _spCommitBadgePick(colName, type, formula) {
        var key = String(colName).toUpperCase();
        if (formula !== undefined) transientColumnSummaryFormulas[key] = formula;
        transientColumnSummaries[key] = type;
        // Keyboard focus follows the pick back to the badge - the NEW one, as
        // the rebuild below replaces the cell (see _spKbdFocusIn).
        var table = _spKbdFocusIn(document.querySelector('.sp-sumtype-menu'))
            ? ($('.pnb-sum-badge.is-open').closest('table')[0] || null) : null;
        _spCloseSummaryMenu();
        penumbraRefreshSummaryFooters();
        // ...and any breakdown table currently on screen, which is very
        // likely the surface the click came FROM.
        penumbraRefreshDrillFooters();
        // The panel is deliberately NOT repopulated. It shows the
        // persisted truth, not this preview, and repopulating would
        // reset spInitialState and silently discard whatever unsaved
        // changes the user already had staged in it.
        if (table) _spFocusSumBadge(table, colName);
    }

    // Focus `colName`'s badge in `table` once its footer has been rebuilt.
    // Matched on data-sum-col by plain comparison, not a selector: a column
    // name can contain any character.
    function _spFocusSumBadge(table, colName) {
        if (!table.isConnected) return;
        var cells = table.querySelectorAll('tfoot td[data-sum-col]');
        for (var i = 0; i < cells.length; i++) {
            if (cells[i].getAttribute('data-sum-col') !== colName) continue;
            var b = cells[i].querySelector('.pnb-sum-badge');
            if (b) { try { b.focus({ preventScroll: true }); } catch (e) { } }
            return;
        }
    }

    // ---- Custom Formula from a footer badge (2026-10-02) -----------------
    // Picking Custom Formula in a badge's menu turns the open popover into a
    // small formula box: prefilled with the formula in effect, checked by the
    // parser the footer itself uses, Enter or Apply to use it, Escape or Cancel
    // to leave the column as it was. Like any badge pick it is a preview in the
    // transient layer, never saved. To keep it the user picks Custom Formula in
    // the settings panel, whose box then starts from this text
    // (_spFormulaBoxText).
    var _spSumFxSeq = 0;
    var _spSumFxTimer = null;
    function _spOpenBadgeFormula($menu, badgeEl, colName) {
        if (!$menu.length) return;
        var friendly = (window.Penumbra && window.Penumbra.journalFriendlyCol &&
                        window.Penumbra.journalFriendlyCol(colName)) || colName;
        var id = 'pnbSumFx' + (++_spSumFxSeq);
        var vars = PENUMBRA_FORMULA_VARS.map(function (v) { return '<code>{' + v + '}</code>'; }).join(' ');
        // role menu -> dialog: it now holds a form, not menu items. It is still
        // the .sp-sumtype-menu box, so every existing close path (outside click,
        // Escape, another badge, the settings panel closing) covers it as is.
        $menu.attr({ role: 'dialog', 'aria-label': 'Custom formula for ' + friendly, 'data-sumfx-col': colName })
            .addClass('sp-sumfx')
            .html(
                '<label class="sp-sumfx-title" for="' + id + '">Custom formula for <strong>' + escapeHtml(friendly) + '</strong></label>' +
                '<input type="text" id="' + id + '" class="sp-sumfx-input" spellcheck="false" autocomplete="off"' +
                    ' placeholder="{sum}/{count}" aria-describedby="' + id + 'Msg ' + id + 'Help"' +
                    ' value="' + escapeHtml(penumbraResolveSummaryFormula(colName)) + '">' +
                '<div class="sp-sumfx-msg" id="' + id + 'Msg"></div>' +
                '<div class="sp-sumfx-help" id="' + id + 'Help">Works on this column&#39;s own values: ' + vars +
                    ', with + - * / and parentheses.</div>' +
                '<div class="sp-sumfx-actions">' +
                    '<button type="button" class="pnb-btn pnb-btn-sm pnb-btn-primary sp-sumfx-apply">Apply</button>' +
                    '<button type="button" class="pnb-btn pnb-btn-sm pnb-btn-secondary sp-sumfx-cancel">Cancel</button>' +
                '</div>' +
                '<div class="sp-sumfx-note">Not saved. To keep it, choose Custom Formula for this column in the Settings panel.</div>'
            );
        _spPlaceSumFx($menu[0], badgeEl);
        var input = $menu.find('.sp-sumfx-input')[0];
        try { input.focus({ preventScroll: true }); } catch (e) { input.focus(); }
        try { input.setSelectionRange(input.value.length, input.value.length); } catch (e) { }
    }

    // Below the badge when it fits, else above it - anchored there by its
    // BOTTOM edge (the usual case, the footer being at the bottom of the
    // table), so a message appearing under the field grows the box away from
    // the badge instead of down over it.
    function _spPlaceSumFx(menu, anchor) {
        var win = menu.ownerDocument.defaultView || window;
        var r = anchor.getBoundingClientRect();
        var mh = menu.offsetHeight, mw = menu.offsetWidth, vh = win.innerHeight;
        var below = vh - r.bottom - 12, above = r.top - 12;
        var left = Math.max(8, Math.min(r.left, win.innerWidth - mw - 8)) + 'px';
        // Clamped into the viewport either way, in case the badge itself is not
        // fully in view.
        if (mh <= below || below >= above) {
            $(menu).css({ top: Math.max(8, Math.min(r.bottom + 4, vh - mh - 8)) + 'px', bottom: 'auto',
                          left: left, maxHeight: Math.max(120, below) + 'px' });
        } else {
            $(menu).css({ top: 'auto', bottom: Math.max(8, Math.min(vh - r.top + 4, vh - mh - 8)) + 'px',
                          left: left, maxHeight: Math.max(120, above) + 'px' });
        }
    }

    // Check the box. A clean parse clears the message at once; an error waits
    // for a pause in typing, so "{sum}/" on its way to "{sum}/{count}" does not
    // flash an error at every keystroke. now = Enter / Apply: the message shows
    // at once, as an alert, and an EMPTY box counts as an error too.
    function _spSumFxCheck($menu, now) {
        clearTimeout(_spSumFxTimer);
        var $in = $menu.find('.sp-sumfx-input');
        var expr = String($in.val() || '').trim();
        var err = expr ? (penumbraParseSummaryFormula(expr).error || '')
                       : 'Type a formula first, for example {sum}/{count}';
        // The names are listed right under the field; the parser's own list of
        // them ("Unknown value {x}. Available: ...") would only repeat it.
        err = err.replace(/\.\s*Available:.*$/, '.');
        var $msg = $menu.find('.sp-sumfx-msg').removeAttr('role');
        $in.attr('aria-invalid', (err && (expr || now)) ? 'true' : 'false');
        if (!err) { $msg.text(''); return true; }
        if (now) { $msg.attr('role', 'alert').text(err); return false; }
        if (!expr) { $msg.text(''); return false; }
        _spSumFxTimer = setTimeout(function () { $msg.text(err); }, 600);
        return false;
    }

    function _spSumFxApply($menu) {
        if (!_spSumFxCheck($menu, true)) {
            $menu.find('.sp-sumfx-input').trigger('focus');
            return;
        }
        _spCommitBadgePick($menu.attr('data-sumfx-col'), 'formula',
                           String($menu.find('.sp-sumfx-input').val() || '').trim());
    }

    $(document).on('input', '.sp-sumfx-input', function () {
        _spSumFxCheck($(this).closest('.sp-sumtype-menu'), false);
    });
    // Escape needs no handler here: A0.7 in the capture-phase key handler
    // closes the popover (and puts focus back on the badge).
    $(document).on('keydown', '.sp-sumfx-input', function (e) {
        if (e.key !== 'Enter' || e.shiftKey || e.ctrlKey || e.altKey || e.metaKey || e.isComposing) return;
        e.preventDefault();
        e.stopPropagation();
        _spSumFxApply($(this).closest('.sp-sumtype-menu'));
    });
    $(document).on('click', '.sp-sumfx-apply', function (e) {
        e.preventDefault();
        e.stopPropagation();
        _spSumFxApply($(this).closest('.sp-sumtype-menu'));
    });
    $(document).on('click', '.sp-sumfx-cancel', function (e) {
        e.preventDefault();
        e.stopPropagation();
        _spCloseSummaryMenu(true);
    });

    // Rebuild the summary footers in place after a transient change or a badge
    // visibility flip. Mirrors postColumnToggle()'s dispatch.
    function penumbraRefreshSummaryFooters() {
        if ($('body').hasClass('snapshot-comparison-active')) {
            // The diff's footers come from generateComparisonTotalRow over
            // snapshot data that recalculateGroupTotals() cannot reconstruct, so
            // recompute each wrapper's cells in place from its own visible rows
            // instead - the same thing a search does to them.
            $('#snapshotComparisonContainer .group-wrapper, #groupedResultsContainer .group-wrapper').each(function () {
                _penumbraRecomputeFooterInPlace($(this));
            });
            return;
        }
        if ($('#groupedResultsContainer').is(':visible')) {
            recalculateGroupTotals();
            return;
        }
        updateTotalRow();
        // MUST follow updateTotalRow(). It rebuilds BOTH tfoot rows - the summary
        // row and the "view last page" link - at default visibility, and it is
        // applyPagination() that decides which of the two belongs on the current
        // page. Every other updateTotalRow() caller pairs them; skipping it here
        // showed the summary row AND the link simultaneously on a non-final page.
        applyPagination();
    }

    // Recompute the footer of every breakdown table currently on screen.
    //
    // A drill table is static HTML inside an infobox - there is no builder to
    // re-run - so its cells are recomputed in place from its own <tbody>. Only
    // the TYPE can change this way (you can only click a badge that already
    // exists), so the set of summarized columns is fixed and cell indexes stay
    // valid.
    function penumbraRefreshDrillFooters() {
        var mainProps = $("#resultsTable").data('columnProperties') || {};
        var nameToId = $("#resultsTable").data('columnNameToOriginalIndex') || {};
        $('.infobox-drill-table').each(function () {
            var $t = $(this);
            var $cells = $t.find('tfoot td[data-sum-col]');
            if (!$cells.length) return;
            var typesShown = [];
            $cells.each(function () {
                var $td = $(this);
                var col = $td.attr('data-sum-col');
                var colId = nameToId[col];
                var props = (colId !== undefined) ? mainProps[colId] : null;
                var type = penumbraResolveSummaryForName(col, props);
                if (!type) {
                    // Summary switched off for this column - clear the cell
                    // rather than leaving the previous value and badge sitting
                    // there looking current.
                    $td.removeAttr('data-sum-type').empty();
                    return;
                }
                // Footer cells and body cells both iterate drillCols, so the
                // sibling index lines them up.
                var idx = $td.index();
                var acc = penumbraSummaryAccumulator(type, col);
                // children(), NOT find(): a drill cell can itself contain a
                // <table> (formatCellContent renders @@JSON that way), and a
                // descendant search swept those nested rows into the summary.
                $t.children('tbody').children('tr').each(function () {
                    var cell = this.children[idx];
                    if (cell) acc.push(penumbraReadCellForSummary(cell));
                });
                var res = acc.finish();
                var val = (res === null) ? '' : penumbraFormatSummary(res, type, {
                    isCurrency: props ? !!props.isCurrency : undefined
                });
                $td.attr('data-sum-type', type)
                   .html(escapeHtml(val) + penumbraSummaryBadgeHtml(type, true, col));
                typesShown.push(type);
            });
            if (typesShown.length) {
                $t.find('tfoot .pnb-sum-label').text(penumbraSummaryHeaderLabel(typesShown));
            }
        });
    }

    function _penumbraRecomputeFooterInPlace($wrapper) {
        var typesShown = [];
        $wrapper.find('tfoot td').each(function () {
            var $td = $(this);
            var colId = $td.attr('data-column');
            if (colId === '#' || colId === '__SNAP_TYPE' || $td.hasClass('pnb-sum-label')) return;
            var $strong = $td.find('strong');
            if (!$strong.length) return;
            // The column NAME is the cell's own data-sum-col, stamped by
            // generateComparisonTotalRow - NOT the header at this cell's index.
            // The diff's <thead> carries a hidden __SNAP_TYPE column its <tfoot>
            // has no cell for, so that header is the column to the LEFT: every
            // cell took its neighbour's summary type. (2026-09-30)
            var colName = $td.attr('data-sum-col') || '';
            var type = colName ? penumbraResolveSummaryForName(colName, null) : $td.attr('data-sum-type');
            if (!type) return;
            var acc = penumbraSummaryAccumulator(type, colName);
            // Through _readComparisonCellText, as the search's recompute reads
            // them: a modified cell holds its was AND now views, and its raw text
            // (the two run together) parses as NaN - the cell dropped out.
            $wrapper.find('tbody tr:not(.search-hidden):not(.journal-note-child) td[data-column="' + colId + '"]')
                .each(function () { acc.push(_readComparisonCellText(this)); });
            var res = acc.finish();
            $strong.text(res === null ? '' : penumbraFormatSummary(res, type));
            $td.attr('data-sum-type', type);
            $td.find('.pnb-sum-badge').remove();
            $td.append(penumbraSummaryBadgeHtml(type, true, colName));
            typesShown.push(type);
        });
        // The keyword follows the types, as a fresh render writes it: a badge
        // pick turns TOTALS into SUMMARY (and back).
        if (typesShown.length) {
            $wrapper.find('tfoot td.pnb-sum-label strong').text(penumbraSummaryHeaderLabel(typesShown));
        }
    }

    // Dismiss on outside click / Escape. Both bail on a cheap native check first
    // - these are document-wide handlers and must cost nothing on the 99.9% of
    // events that happen with no menu open.
    //
    // The capture-phase Escape handler owns real modals and may swallow the key
    // before this bubbling one sees it, so closeSettingsPanel() also calls
    // _spCloseSummaryMenu(); this is the belt to that braces.
    $(document).on('mousedown', function(e) {
        if (!document.querySelector('.sp-sumtype-menu')) return;
        if ($(e.target).closest('.sp-sumtype-menu, .sp-col-sumtype, .pnb-sum-badge').length) return;
        _spCloseSummaryMenu();
    });
    // Escape is handled by the app's single capture-phase handler (section A0.7)
    // - it stopImmediatePropagation()s in every branch, so a bubbling listener
    // here would be dead code.

    // Move buttons
    $('#spMoveTop').on('click', function() {
        var $sel = $('#spColumnList .sp-col-item.sp-selected');
        if (!$sel.length || $sel.hasClass('sp-col-fixed')) return;
        // No-op if already the topmost VISIBLE movable item — otherwise the item
        // would jump over hidden items, changing DOM order (and the change
        // counter) without any visible movement.
        if (!$sel.prevAll('.sp-col-item:not(.sp-col-fixed):visible').length) return;
        // Insert after the fixed '#' row or at top
        var $fixed = $('#spColumnList .sp-col-fixed');
        if ($fixed.length) { $sel.insertAfter($fixed.last()); }
        else { $('#spColumnList').prepend($sel); }
        $sel[0].scrollIntoView({ block: 'nearest' });
        clearHeaderSort();
        updateApplyResetState();
    });
    $('#spMoveUp').on('click', function() {
        var $sel = $('#spColumnList .sp-col-item.sp-selected');
        if (!$sel.length || $sel.hasClass('sp-col-fixed')) return;
        // Only consider VISIBLE neighbors — items hidden by "hide unchecked"
        // (.sp-col-hidden) or by the column search filter (inline display:none)
        // must be skipped, otherwise the item lands next to an invisible
        // neighbor: the DOM order changes (bumping the change counter) but
        // nothing appears to move.
        var $prev = $sel.prevAll('.sp-col-item:not(.sp-col-fixed):visible').first();
        if ($prev.length) { $sel.insertBefore($prev); }
        $sel[0].scrollIntoView({ block: 'nearest' });
        clearHeaderSort();
        updateApplyResetState();
    });
    $('#spMoveDown').on('click', function() {
        var $sel = $('#spColumnList .sp-col-item.sp-selected');
        if (!$sel.length || $sel.hasClass('sp-col-fixed')) return;
        // Only consider VISIBLE neighbors (see spMoveUp note above).
        var $next = $sel.nextAll('.sp-col-item:visible').first();
        if ($next.length) { $sel.insertAfter($next); }
        $sel[0].scrollIntoView({ block: 'nearest' });
        clearHeaderSort();
        updateApplyResetState();
    });
    $('#spMoveBottom').on('click', function() {
        var $sel = $('#spColumnList .sp-col-item.sp-selected');
        if (!$sel.length || $sel.hasClass('sp-col-fixed')) return;
        // No-op if already the bottommost VISIBLE item (see spMoveTop note above).
        if (!$sel.nextAll('.sp-col-item:visible').length) return;
        $('#spColumnList').append($sel);
        $sel[0].scrollIntoView({ block: 'nearest' });
        clearHeaderSort();
        updateApplyResetState();
    });

    // Checkbox change detection
    $(document).on('change', '.sp-col-check', function() {
        updateApplyResetState();
        // If hide-unchecked mode is active, hide newly-unchecked items
        if (spHideUncheckedActive && !this.checked) {
            $(this).closest('.sp-col-item').addClass('sp-col-hidden');
        }
        // Checking an item also selects it, so the move buttons / drag act on
        // it immediately — one less click before reordering. Only on check:
        // an unchecked row may be hidden by hide-unchecked mode, so selecting
        // it would be pointless.
        if (this.checked) {
            var $item = $(this).closest('.sp-col-item');
            if (!$item.hasClass('sp-col-fixed')) {
                $('#spColumnList .sp-col-item').removeClass('sp-selected');
                $item.addClass('sp-selected');
            }
        }
    });

    // Apply / Reset (with loading animation)
    $('#spApply').on('click', function() {
        // Close panel, show loading, apply after a tick so the overlay renders
        closeSettingsPanel();
        showLoading('Saving column layout...');
        setTimeout(function() {
            // When the layout change triggers a snapshot-comparison re-render, that
            // work is async and owns the overlay from here (it swaps in its own
            // "Running comparison..." message and hides it when the diff is on
            // screen). Hiding it here would flash the overlay off mid-render and
            // let the user click a half-built diff.
            if (!applyColumnChanges()) hideLoading();
        }, 50);
    });
    $('#spReset').on('click', function() {
        resetPanelState();
        // Also reset hide-unchecked state
        _spSetHideUnchecked(false);
        $('#spColumnList .sp-col-item').removeClass('sp-col-hidden');
    });

    // --- Drag & Drop Reordering (HTML5 native) ---
    (function() {
        var dragSrcEl = null;

        $(document).on('dragstart', '.sp-col-item:not(.sp-col-fixed)', function(e) {
            dragSrcEl = this;
            $(this).addClass('sp-dragging');
            e.originalEvent.dataTransfer.effectAllowed = 'move';
            e.originalEvent.dataTransfer.setData('text/plain', '');
        });

        $(document).on('dragover', '.sp-col-item:not(.sp-col-fixed)', function(e) {
            e.preventDefault();
            e.originalEvent.dataTransfer.dropEffect = 'move';
            if (this === dragSrcEl) return;

            // Clear all indicators
            $('#spColumnList .sp-col-item').removeClass('sp-drag-over-top sp-drag-over-bottom');

            // Determine if above or below midpoint
            var rect = this.getBoundingClientRect();
            var midY = rect.top + rect.height / 2;
            if (e.originalEvent.clientY < midY) {
                $(this).addClass('sp-drag-over-top');
            } else {
                $(this).addClass('sp-drag-over-bottom');
            }
        });

        $(document).on('dragleave', '.sp-col-item', function() {
            $(this).removeClass('sp-drag-over-top sp-drag-over-bottom');
        });

        $(document).on('drop', '.sp-col-item:not(.sp-col-fixed)', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (!dragSrcEl || this === dragSrcEl) return;

            var $target = $(this);
            var $src = $(dragSrcEl);

            // Determine placement
            var rect = this.getBoundingClientRect();
            var midY = rect.top + rect.height / 2;
