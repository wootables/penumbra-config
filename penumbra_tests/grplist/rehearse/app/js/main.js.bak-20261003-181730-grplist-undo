    // ========================================================================
    // Rich hover tooltips - shared between the Tag Generator and the
    // Visualization Builder. Tooltip copy lives in help_content.php under
    // #builder-tips-storage (prompt builder) and #viz-tips-storage (viz UI),
    // lazy-loaded via ensureHelpLoaded() so authors can edit copy without
    // touching this file. Inline data-tip text (e.g. on .viz-chip toggles or
    // a runtime-injected "Disabled - ..." reason) is rendered as plain text
    // via the fallback path.
    // ========================================================================
    let _helpPopoverInited = false;
    function initHelpPopover() {
        if (_helpPopoverInited) return;
        _helpPopoverInited = true;

        // Prefetch the help document so tooltip lookups succeed on first hover.
        try { ensureHelpLoaded(function () {}); } catch (e) {}

        // One floating popover element shared by every help-icon hover.
        const $pop = $('<div class="bld-help-pop"></div>').appendTo('body');
        let hoverIcon = null;
        let hideTimer = null;

        function positionPop(iconEl) {
            // One popover element is created up front in the main document, but a
            // help icon can sit in the console's pop-out window (Tag Generator,
            // snapshot dialogs). Re-home it beside the icon and measure against
            // THAT window - otherwise it is positioned with the wrong viewport
            // and painted in the window the user isn't looking at.
            const iconDoc = iconEl.ownerDocument;
            const iconWin = iconDoc.defaultView || window;
            if ($pop[0].ownerDocument !== iconDoc && iconDoc.body) iconDoc.body.appendChild($pop[0]);

            const r = iconEl.getBoundingClientRect();
            const margin = 8;
            const vw = iconWin.innerWidth;
            const vh = iconWin.innerHeight;

            // Reset any previously-applied height cap so the popover's natural
            // height is measured first (then we may re-cap below if needed).
            $pop.css({ maxHeight: '', overflowY: '' });
            const popW = $pop.outerWidth() || 360;
            let popH = $pop.outerHeight() || 200;

            // If the popover is taller than the viewport itself, cap it and
            // let it scroll. Without this, a very tall tip (e.g. the
            // snap-browse-all entry on a short laptop screen) would be
            // clipped at one edge no matter which side we placed it on.
            const maxAllowedH = vh - 2 * margin;
            if (popH > maxAllowedH) {
                $pop.css({ maxHeight: maxAllowedH + 'px', overflowY: 'auto' });
                popH = maxAllowedH;
            }

            // Vertical placement: prefer above (matches existing behavior),
            // fall back to below if above doesn't fit. If NEITHER side fits
            // (popover taller than remaining space on either side), pick the
            // larger side and clamp the popover edge to the viewport - the
            // height cap above guarantees this clamp lands inside the screen.
            const spaceAbove = r.top - margin;
            const spaceBelow = vh - r.bottom - margin;
            let top;
            if (popH <= spaceAbove) {
                top = r.top - popH - margin;        // above (fits)
            } else if (popH <= spaceBelow) {
                top = r.bottom + margin;            // below (fits)
            } else if (spaceAbove >= spaceBelow) {
                top = margin;                       // clamp to top of viewport
            } else {
                top = vh - popH - margin;           // clamp so bottom edge is in viewport
            }

            // Horizontal centering with viewport clamping.
            let left = r.left + (r.width / 2) - (popW / 2);
            if (left < margin) left = margin;
            if (left + popW > vw - margin) left = vw - popW - margin;

            $pop.css({ top: top + 'px', left: left + 'px' });
        }
        // Plain-text fallback: any data-tip value that isn't a registered key
        // is rendered as a <p>, preserving newlines as <br>. Used by chip
        // toggles whose tip text lives inline, and by runtime "Disabled - ..."
        // reason strings injected by _disableTip().
        function renderPlainText(text) {
            const esc = String(text)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/\n/g, '<br>');
            return '<p>' + esc + '</p>';
        }
        function showPop(iconEl, tipKey) {
            clearTimeout(hideTimer);
            // Try registered help content first.
            const $src = $('#helpContentContainer [data-tip="' + tipKey + '"]');
            if ($src.length) {
                $pop.html($src.html());
                positionPop(iconEl);
                $pop.addClass('open');
                return;
            }
            // If help content hasn't been fetched yet, load it and retry once
            // - but only when the tip looks like a key (short, no spaces).
            // Long sentences are treated as inline text immediately.
            const looksLikeKey = tipKey.length < 40 && !/\s/.test(tipKey);
            if (looksLikeKey) {
                try {
                    ensureHelpLoaded(function () {
                        const $src2 = $('#helpContentContainer [data-tip="' + tipKey + '"]');
                        if (hoverIcon !== iconEl) return;
                        if ($src2.length) {
                            $pop.html($src2.html());
                        } else {
                            // Still nothing - fall back to text rendering.
                            $pop.html(renderPlainText(tipKey));
                        }
                        positionPop(iconEl);
                        $pop.addClass('open');
                    });
                } catch (e) {}
                return;
            }
            // Inline-text path (chips, _disableTip reasons, etc.)
            $pop.html(renderPlainText(tipKey));
            positionPop(iconEl);
            $pop.addClass('open');
        }
        function hidePop() {
            hideTimer = setTimeout(function () {
                $pop.removeClass('open');
                hoverIcon = null;
            }, 140);
        }

        // Help-icon triggers (prompt generator + viz builder + anywhere else).
        // A .tab-help-icon "?" that ALSO carries data-tip (snapshot manager's
        // Load / Compare / A-vs-B) pops the quick tip on hover and still opens
        // the full topic on click - one icon, both affordances.
        const _iconHoverSel = '.bld-help-icon, .tab-help-icon[data-tip]';
        $(document).on('mouseenter', _iconHoverSel, function () {
            const tip = $(this).data('tip');
            if (!tip) return;
            hoverIcon = this;
            showPop(this, tip);
        });
        $(document).on('mouseleave', _iconHoverSel, hidePop);
        $(document).on('click', '.tab-help-icon[data-tip]', function () {
            clearTimeout(hideTimer);
            $pop.removeClass('open');
            hoverIcon = null;
        });
        // Chip-style whole-element hover affordance - the entire element is
        // the hover target, popping the rich popover instead of a native
        // title= tooltip. Used by viz chips (the pill-shaped toggles in the
        // viz builder). The snapshot UI's snap-bar-toggle labels used to
        // share this pattern but moved to a trailing ?-icon (consistent
        // with form labels elsewhere, and stops the tooltip from popping
        // up over the checkbox the user is trying to click).
        const _chipHoverSel = '.viz-chip[data-tip], .viz-combo-add-btn[data-tip]';
        $(document).on('mouseenter', _chipHoverSel, function () {
            const tip = $(this).attr('data-tip');
            if (!tip) return;
            hoverIcon = this;
            showPop(this, tip);
        });
        $(document).on('mouseleave', _chipHoverSel, hidePop);

        // Help icons inside <button> elements (e.g. snapshot UI) are pure
        // hover-discoverability adornments - clicks on them should still fire
        // the parent button (so the whole button area remains clickable, no
        // 13×13 dead zone at the right edge). The CSS overrides cursor: help
        // to cursor: pointer inside buttons so the affordance reads as "click
        // anywhere = act" rather than "click = help."
        $pop.on('mouseenter', function () { clearTimeout(hideTimer); });
        $pop.on('mouseleave', hidePop);

