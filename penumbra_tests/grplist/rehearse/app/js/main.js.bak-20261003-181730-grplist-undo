            cmInstance.operation(function () {
                const rangeFinder = cmInstance.getOption("foldGutter").rangeFinder;
                for (var i = cmInstance.firstLine(); i <= cmInstance.lastLine(); ++i) {
                    cmInstance.foldCode(CodeMirror.Pos(i, 0), {
