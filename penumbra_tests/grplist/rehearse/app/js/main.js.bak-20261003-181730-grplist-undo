    // Migrate old totalColAgg/totalRowAgg (string) to new totalColAggs/totalRowAggs (array) format
    function migrateOldTotalSettings(settings) {
        if (!settings) return settings;
        // Migrate old single-string totalColAgg to per-position array
        if (settings.hasOwnProperty('totalColAgg') && !settings.hasOwnProperty('totalColAggs')) {
            if (settings.totalColAgg) {
                var aggCount = (Array.isArray(settings.agg) ? settings.agg : [settings.agg]).length;
                settings.totalColAggs = [];
                for (var i = 0; i < aggCount; i++) {
                    settings.totalColAggs.push(settings.totalColAgg);
                }
            } else {
                settings.totalColAggs = null;
            }
            delete settings.totalColAgg;
        }
        // Migrate old single-string totalRowAgg to array
        if (settings.hasOwnProperty('totalRowAgg') && !settings.hasOwnProperty('totalRowAggs')) {
            if (settings.totalRowAgg) {
                settings.totalRowAggs = [settings.totalRowAgg];
            } else {
                settings.totalRowAggs = null;
            }
            delete settings.totalRowAgg;
        }
        return settings;
    }

    /**
 * Reads the settings from the currently active pivot table and uses them
 * to repopulate the pivot configuration lightbox for easy editing.
 */
    function repopulatePivotLightboxFromCurrentState() {
        // ===== START: THIS IS THE FIX =====
        // Read from the persistent global variable, not the volatile .data() attribute.
        const settings = currentPivotSettings;
        if (!settings) {
            console.error("Could not repopulate lightbox: currentPivotSettings not found.");
            return;
        }
        // ===== END: THIS IS THE FIX =====

        // Clear the lightbox drop zones and source list
        $('#pivot-rows .pivot-column-item, #pivot-cols .pivot-column-item, #pivot-vals .pivot-column-item').remove();
        const $sourceList = $('#pivot-source-columns').empty();

        // Restore the column tiles to their previous zones
        settings.rows.forEach(field => {
            _pivotAppendZonePill($('#pivot-rows'), field);
        });
        settings.cols.forEach(field => {
            _pivotAppendZonePill($('#pivot-cols'), field);
        });

        // Restore the aggregation table rows
        $('#pivot-agg-table-body').empty();
        if (Array.isArray(settings.agg)) {
            settings.agg.forEach(function (aggType, i) {
                var customLbl = (settings.aggLabels && settings.aggLabels[i]) ? settings.aggLabels[i] : null;
                var sourceCol = (settings.aggColOverrides && settings.aggColOverrides[i])
                    ? settings.aggColOverrides[i]
                    : (settings.vals || '');
                var flt = (settings.aggFilters && settings.aggFilters[i]) ? settings.aggFilters[i] : null;
                var frm = (settings.aggFormulas && settings.aggFormulas[i]) ? settings.aggFormulas[i] : null;
                addAggregationRow(aggType, sourceCol, customLbl, flt, frm);
            });
            refreshAggTokenLabels();
        } else if (settings.agg) {
            // Legacy single aggregation
            addAggregationRow(settings.agg, settings.vals || '', null);
        }

        // Restore layout selections (migrate deprecated values)
        // 'drilldown' → 'nested' (collapsible)
        // Old 'nested' without legacy startCollapsed → 'nested-static' (preserve old behavior)
        // Old 'nested' with legacy startCollapsed → 'nested' (they were already using collapse)
        // (This gate reads the LEGACY startCollapsed key on purpose - pre-collapsible
        // configs never carry startExpanded, and v2+ configs are excluded by the stamp.)
        // v2-stamped settings (generate/preset-save set v:2) are post-collapsible:
        // their 'nested' genuinely means collapsible - never downgrade those.
        var restoredRowLayout = settings.rowLayout;
        if (restoredRowLayout === 'drilldown') {
            restoredRowLayout = 'nested';
        } else if (restoredRowLayout === 'nested' && !settings.startCollapsed && !settings.v) {
            restoredRowLayout = 'nested-static';
        }
        var restoredColLayout = (settings.colLayout === 'drilldown') ? 'nested' : settings.colLayout;
        $('#pivot-rows-layout-select').val(restoredRowLayout);
        $('#pivot-cols-layout-select').val(restoredColLayout);

        // Restore sort order dropdown
        if (settings.sortOrder) {
            $('#pivot-sort-order').val(settings.sortOrder);
        }

        // Restore sticky column count
        $('#pivot-sticky-cols').val(typeof settings.stickyColCount === 'number' ? settings.stickyColCount : 3);

        // Migrate old single-value total settings to new array schema
        migrateOldTotalSettings(settings);

        // Restore Column Total overrides - write onto each agg row
        if (settings.totalColAggs && Array.isArray(settings.totalColAggs)) {
            $('#pivot-agg-table-body tr').each(function (idx) {
                var v = (idx < settings.totalColAggs.length) ? (settings.totalColAggs[idx] || '') : '';
                if (!v) return;
                var $tr = $(this);
                $tr.attr('data-col-total-override', v);
                _renderColTotalCell($tr);
            });
        }

        // Restore Row Total tokens (grouped by value)
        if (Array.isArray(settings.totalRowAggs) && settings.totalRowAggs.length === 0) {
            // Saved with every box cleared: no Grand Total column. Show the boxes
            // empty, override on, so the author sees why and can add one back.
            $('#pivot-row-total-override-toggle').prop('checked', true);
            $('#pivot-row-total-override-container').show();
            $('#pivot-row-total-slots').removeAttr('data-rt-pristine').find('.pivot-row-total-token').remove();
            rebuildRowTotalSlots();
        } else if (settings.totalRowAggs && Array.isArray(settings.totalRowAggs) && settings.totalRowAggs.length > 0) {
            $('#pivot-row-total-override-toggle').prop('checked', true);
            $('#pivot-row-total-override-container').show();
            // Clear any existing tokens before rebuilding, then build grouped slots (empty)
            $('#pivot-row-total-slots').removeAttr('data-rt-pristine').find('.pivot-row-total-token').remove();
            rebuildRowTotalSlots();
            // Resolve base indices - use explicit if available, otherwise heuristic
            var _restoreBaseIdx = settings.totalRowAggBaseIdx || null;
            if (!_restoreBaseIdx || !Array.isArray(_restoreBaseIdx) || _restoreBaseIdx.length !== settings.totalRowAggs.length) {
                _restoreBaseIdx = resolveRowTotalBaseIndices(settings.totalRowAggs, getAggregationTokens());
            }
            settings.totalRowAggs.forEach(function (aggType, idx) {
                var label = getAggregationLabel(aggType);
                var customLabel = (settings.totalRowAggLabels && settings.totalRowAggLabels[idx]) || null;
                var baseIdx = (_restoreBaseIdx && idx < _restoreBaseIdx.length) ? _restoreBaseIdx[idx] : 0;
                addRowTotalToken(aggType, label, customLabel, baseIdx);
            });
        } else {
            $('#pivot-row-total-override-toggle').prop('checked', false);
            $('#pivot-row-total-override-container').hide();
            $('#pivot-row-total-slots').removeAttr('data-rt-pristine').empty();
        }

        const usedColumns = new Set([...settings.rows, ...settings.cols, settings.vals].filter(Boolean));
        // Values chips live in #pivot-vals now - pull their columns from the agg table
        // so we don't also list them in the Fields sidebar.
        $('#pivot-vals .pivot-column-item').each(function () {
            var c = ($(this).attr('data-field') || $(this).text()).trim();
            if (c) usedColumns.add(c);
        });

        if (masterRowData.length > 0) {
            const allColumns = Array.from(masterRowData[0].keys());
            const _repopJsonCols = _detectJsonColumns();
            allColumns.forEach(colName => {
                if (!usedColumns.has(colName) && !_repopJsonCols.has(colName.toUpperCase())) {
                    $sourceList.append(`<div class="pivot-column-item" draggable="true" data-field="${escapeHtml(colName)}">${escapeHtml(colName)}</div>`);
                }
            }
            );

            const items = $sourceList.children('.pivot-column-item');
            items.sort((a, b) => ($(a).attr('data-field') || $(a).text()).localeCompare($(b).attr('data-field') || $(b).text()));
            $sourceList.append(items);
        }

        // Restore Rank (Top N / Bottom N) settings
        if (settings.rankDir && settings.rankDir !== 'none' && settings.rankN) {
            $('#pivot-rank-dir').val(settings.rankDir);
            $('#pivot-rank-n').val(settings.rankN).prop('disabled', false);
            syncRankAggDropdown();
            if (settings.rankAgg) {
                $('#pivot-rank-agg').val(settings.rankAgg);
            }
            $('#pivot-rank-agg').prop('disabled', false);
            $('#pivot-rank-other').prop('checked', settings.rankOther !== false).prop('disabled', false);
            $('#pivot-rank-other-label').css('opacity', 1);
            // Scope applies via _pivotSyncRankScopeOptions once the Rows pills exist.
            $('#pivot-rank-scope').data('pnbPendingScope', settings.rankScope || '');
        } else {
            $('#pivot-rank-dir').val('none');
            $('#pivot-rank-n').val(10).prop('disabled', true);
            syncRankAggDropdown();
            $('#pivot-rank-scope').data('pnbPendingScope', '');
            $('#pivot-rank-agg').prop('disabled', true);
            $('#pivot-rank-other').prop('checked', true).prop('disabled', true);
            $('#pivot-rank-other-label').css('opacity', 0.5);
        }

        // Restore breakdown links setting
        $('#pivot-no-breakdown').prop('checked', settings.noBreakdown === true);

        // Restore "hide empty rows and columns". Strict === true so a saved
        // report or preset from before this option existed (the key is absent)
        // lands on OFF rather than on whatever the builder was last left at.
        $('#pivot-hide-empty').prop('checked', settings.hideEmpty === true);

        // Restore "start expanded" setting. Only an explicit startExpanded:true
        // checks the box - legacy startCollapsed saves (either value) fall into
        // the collapsed default, matching how they now render.
        $('#pivot-start-expanded').prop('checked', pivotStartsExpanded(settings));

        updatePivotLayoutOptions();
    }

    $('#generatePivotBtn').on('click', function () {
