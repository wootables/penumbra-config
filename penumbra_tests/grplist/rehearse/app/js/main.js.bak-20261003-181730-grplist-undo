                        // box) - Restore lives in the Changes view now.
                        const badgeClass = actionBadgeClass(log.ACTION);
                        const userAttrs = log.USER_ID
                            ? ` role="button" tabindex="0" data-audit-filter-q="${escapeHtml(log.USER_ID)}" title="Click to filter the log to ${escapeHtml(log.USER_ID)}"`
                            : '';

                        tableHtml += `
                        <tr>
                            <td class="audit-td-time" data-sort-val="${timeSortVal}">${timeDisplay}</td>
                            <td role="button" tabindex="0" data-sort-val="${escapeHtml(log.ACTION)}" data-audit-filter-q="${escapeHtml(log.ACTION)}" title="Click to filter the log to ${escapeHtml(log.ACTION)} events"><span class="audit-action-badge ${badgeClass}">${actionLabel(log.ACTION)}</span></td>
                            <td class="audit-td-user" data-sort-val="${escapeHtml(log.USER_ID || '')}"${userAttrs}>${escapeHtml(log.USER_ID || '—')}</td>
                            <td class="source-cell" data-sort-val="${escapeHtml(sourceSortKey)}">${sourceInfo}${chipsHtml ? ' ' + chipsHtml : ''}</td>
                        </tr>`;
                    });

                    tableHtml += '</tbody></table>';

                    // "Load older": a full page back means there may be more history.
                    if (response.data.length >= _auditLogLimit && _auditLogLimit < 500) {
                        tableHtml += '<div class="audit-loadmore"><button type="button" id="auditLoadOlderBtn">Load older entries</button></div>';
                    }

                    // --- FIX 1: Render table and immediately cache the default order for sorting ---
                    syncAuditLogHeight();
                    $container.html(tableHtml).show();
                    const $tbody = $container.find('table tbody');
                    $tbody.data('original-rows', $tbody.find('tr').get());
