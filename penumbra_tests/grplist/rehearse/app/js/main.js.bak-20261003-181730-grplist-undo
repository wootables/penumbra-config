    // --- Access List: lazy directory resolution for the rich hover tooltip ---
    // Fresh autocomplete picks carry their directory data (the select handler
    // builds it), but the AUTHORIZED column stores only the raw "Name <email>"
    // text - so pills rebuilt from a SAVED report, and manually typed ones, had
    // no data behind the email-recipients-style hover. Resolve each NCSU pill's
    // email against get_email_recipients.php (the same directory source the
    // autocomplete and the scheduler preview use), cache per session, and
    // synthesize the current user's own pill from the Shibboleth vars already
    // on the page (no AJAX). External addresses are skipped - the directory is
    // NCSU-only, so their pills keep the plain title, same as the email dialog.
    var _accessVarsCache = {}; // email(lower) -> vars object | null (miss) | 'pending'
    function _resolveAccessCapsuleVars($capsule) {
        if ($capsule.data('user-vars')) return;
        if ((($capsule.data('type') || '') + '') !== 'ncsu') return;
        var raw = ($capsule.data('value') || '') + '';
        var m = raw.match(/<([^>]+)>/);
        var email = (m ? m[1] : raw).trim().toLowerCase();
        if (!email || email.indexOf('@') === -1) return;

        var selfEmail = ((penumbra_vars.shibboleth && penumbra_vars.shibboleth.email) || (penumbra_vars.currentUserKey + '@ncsu.edu')).toLowerCase();
        if (email === selfEmail) {
            $capsule.data('user-vars', buildCurrentUserVars()).addClass('has-user-vars');
            return;
        }

        var cached = _accessVarsCache[email];
        if (cached === 'pending' || cached === null) return; // in flight / known directory miss
        if (cached) {
            $capsule.data('user-vars', cached).addClass('has-user-vars');
            return;
        }
        _accessVarsCache[email] = 'pending';
        $.ajax({ url: 'get_email_recipients.php', dataType: 'json', data: { term: email } })
            .done(function (items) {
                var hit = null;
                (items || []).forEach(function (it) {
                    if (((it.value || '') + '').toLowerCase() === email) hit = it;
                });
                if (!hit) { _accessVarsCache[email] = null; return; }
