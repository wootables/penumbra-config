     * Races a timeout because requestAnimationFrame does NOT fire in a
     * backgrounded tab (or headless). A hung promise here would mean the table
     * never renders at all, so this can never be allowed to wait forever.
     */
    function penumbraYieldToPaint() {
        return new Promise(function (resolve) {
            let settled = false;
            const fin = function () { if (!settled) { settled = true; resolve(); } };
            setTimeout(fin, 250);
            if (window.requestAnimationFrame) {
