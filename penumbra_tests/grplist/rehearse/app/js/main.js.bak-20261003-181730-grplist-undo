    /**
 * Applies all parsed cell content rewrite rules. If the number of rows is large,
 * it displays a loading screen to provide user feedback during the slow operation.
 */
    function applyRewriteRules(skipLoadingScreen) {
        if (rewriteRules.length === 0 || masterRowData.length === 0) {
            return;
        }
        // Snapshot comparison: SKIP. Rewrite rules resolve a row by its '#' cell
        // (`masterRowData[rowNum - 1]` below), but the comparison renumbers '#'
        // sequentially across the whole diff, so it is not a masterRowData index
        // there - every rewritten cell would show an unrelated row's values (and
        // "Removed" rows have no live source row at all, being snapshot-only).
        // Leaving values un-rewritten is correct-but-plain; rewriting them from
        // the wrong row is silently wrong data, which also propagates to exports.
        if ($('#snapshotComparisonContainer').is(':visible')) {
            return;
        }

        // Scope to the ACTIVE container only (2026-08-01): during group mode the
        // old two-container selector rewrote the hidden flat table too (~2x rows).
        // Rewrites are idempotent (output derives from masterRowData, never from
        // current cell content), and every return to a hidden container re-runs
        // this via applyPagination()/rebuildGroupedView(), so the hidden side
        // catches up the moment it becomes visible.
