    // ===================================================================
    // Scheduler DRAFT events  (2026-08-31)
    // "Add" no longer opens a blank form with a type dropdown at the top of it.
    // The type is picked in the rail (#schedNewEventType) FIRST, then Add drops
    // a draft card into the events list - highlighted, sitting where the saved
    // event will sit - and opens the form on it. The draft is DOM-only: nothing
    // reaches manage_schedule.php until Save, so Cancel, Refresh and a browser
    // reload all simply lose it.
    // _schedDraftType is the single source of truth for "a draft is open". It
    // must be cleared BEFORE any loadSchedulerTaskList() that is meant to
    // discard the draft, because the loader re-appends it otherwise.
    // ===================================================================
    var _schedDraftType = null;
    var SCHED_TYPE_LABELS = {
        EMAIL: 'Email Report',
        SNAPSHOT: 'Take a Snapshot',
        DROP_FILE: 'Drop a File',
        DB_DUMP: 'Dump to DB Table',
        WEBHOOK: 'Webhook'
    };

    // Append (or replace) the draft card at the end of the events list. The raw
    // TASK_TYPE is the headline, matching the saved cards above it rather than
    // the friendlier rail wording, so the list reads as one column of events.
    function renderSchedDraftCard(type) {
        var $list = $('#scheduledTasksList');
        if (!$list.length) return;
        $list.find('.sched-task-draft').remove();
        // "No events scheduled." / the error notice are placeholder <li>s, not
        // events - drop them so the draft isn't listed underneath a claim that
        // the list is empty. loadSchedulerTaskList() puts them back on reload.
        $list.find('li').not('.sched-task-item').remove();
        var $li = $('<li class="sched-task-item sched-task-draft selected-task" aria-current="true" style="padding: 10px; border-bottom: 1px solid #eee;">'
            + '<div style="display:flex; justify-content:space-between; gap:6px;">'
            + '<strong class="sched-draft-type"></strong>'
            + '<span class="sched-draft-pill">Draft</span>'
            + '</div>'
            + '<div class="sched-draft-note">Unsaved &mdash; not scheduled yet</div>'
            + '</li>');
        $li.find('.sched-draft-type').text(type || '');
        $list.append($li);
    }

    // Re-point the list at whatever the config panel currently holds. Called
    // after every list repaint: the <li>s are rebuilt from scratch, so both the
    // draft card and the open event's highlight have to be re-established.
    // (Before this existed, toggling any status dot - which reloads the list -
    // silently un-highlighted the event open in the form.)
    function syncSchedulerListSelection() {
        if (!$('.scheduler-config-panel').is(':visible')) return;
        var openId = $('#schedTaskId').val();
        if (!openId) {
            if (_schedDraftType !== null) renderSchedDraftCard(_schedDraftType);
            return;
        }
        $('#scheduledTasksList .sched-task-item[data-task-id="' + openId + '"]').addClass('selected-task').attr('aria-current', 'true');
    }

    // Back to "nothing open": drop any draft, close the config panel, re-fetch
    // the list and re-probe the runner. Shared by the rail's Refresh and the
    // form's Cancel so the two can never drift apart.
    function resetSchedulerView() {
        _schedDraftType = null;
        loadSchedulerTaskList();
        $('.scheduler-config-panel').hide();
        $('#schedulerPlaceholder').show();
        $('.sched-task-item').removeClass('selected-task').removeAttr('aria-current');
        $('#scheduledTasksList .sched-task-draft').remove();
