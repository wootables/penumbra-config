    // ============================================================
    //  FILE DATA IMPORT (CSV / JSON / TSV → Table Display)
    // ============================================================

    /**
     * Parses a CSV string into an array of plain objects with UPPERCASE keys.
     * Handles: quoted fields, embedded commas, embedded newlines, escaped quotes ("").
     * @param {string} csvText - Raw CSV file content
     * @param {string} [delimiter] - Field delimiter. Omit to auto-detect (CSV vs TSV).
     * @returns {Array<Object>} Array of {COL_NAME: "value", ...} objects
     */
    function parseCSVToObjects(csvText, delimiter) {
        if (!delimiter) {
            const firstLine = csvText.split('\n')[0];
            if ((firstLine.match(/\t/g) || []).length > (firstLine.match(/,/g) || []).length) {
                delimiter = '\t';
            } else {
                delimiter = ',';
            }
        }

        const rows = [];
        let currentRow = [];
        let currentField = '';
        let inQuotes = false;
        let i = 0;

        while (i < csvText.length) {
            const ch = csvText[i];

            if (inQuotes) {
                if (ch === '"') {
                    if (i + 1 < csvText.length && csvText[i + 1] === '"') {
                        currentField += '"';
                        i += 2;
                        continue;
                    } else {
                        inQuotes = false;
                        i++;
                        continue;
                    }
                } else {
                    currentField += ch;
                    i++;
                    continue;
                }
            }

            if (ch === '"') {
                inQuotes = true;
                i++;
            } else if (ch === delimiter) {
                currentRow.push(currentField.trim());
                currentField = '';
                i++;
            } else if (ch === '\r' && csvText[i + 1] === '\n') {
                currentRow.push(currentField.trim());
                currentField = '';
                rows.push(currentRow);
                currentRow = [];
                i += 2;
            } else if (ch === '\n') {
                currentRow.push(currentField.trim());
                currentField = '';
                rows.push(currentRow);
                currentRow = [];
                i++;
            } else {
                currentField += ch;
                i++;
            }
        }

        if (currentField || currentRow.length > 0) {
            currentRow.push(currentField.trim());
            rows.push(currentRow);
        }

        const filteredRows = rows.filter(function (r) { return r.some(function (cell) { return cell !== ''; }); });

        if (filteredRows.length < 2) {
            throw new Error('CSV file must contain at least a header row and one data row.');
        }

        // The parser above already drops real CSV quoting; this is the belt-and-braces
        // pass for unquoted fields. Matched pair only, so a header that legitimately
        // ends in an inch mark (`Size 6"`) is not silently renamed to `SIZE 6`.
        const rawHeaders = filteredRows[0].map(function (h) { return stripWrappingQuotePair(h).trim().toUpperCase(); });

        // Deduplicate header names
        const headerCounts = {};
        const headers = rawHeaders.map(function (h) {
            if (!h) h = 'COLUMN';
            if (headerCounts[h] === undefined) {
                headerCounts[h] = 1;
                return h;
            } else {
                headerCounts[h]++;
                return h + '_' + headerCounts[h];
            }
        });

        var headerCount = headers.length;
        var dataRows = filteredRows.slice(1);

        // Filter out grand total / summary rows:
        // 1. Rows with fewer fields than headers (column-shifted totals from Excel exports)
        // 2. Last row(s) where the first cell contains common total keywords
        var totalPattern = /^(grand\s+)?total[s]?$/i;
        dataRows = dataRows.filter(function (row) {
            // Skip rows with fewer fields than headers (column shift)
            if (row.length < headerCount) return false;
            // Skip rows where first cell is a total keyword and most other cells are empty
            if (totalPattern.test((row[0] || '').trim())) {
                var filledCells = row.filter(function (c) { return c !== ''; }).length;
                if (filledCells < headerCount * 0.5) return false;
            }
            return true;
        });

        return dataRows.map(function (row) {
            var obj = {};
            headers.forEach(function (header, idx) {
                obj[header] = (idx < row.length) ? row[idx] : '';
            });
            return obj;
        });
    }

    /**
     * Parses a JSON string into an array of plain objects with UPPERCASE keys.
     * Supports: standard [{col:val},...], and Penumbra snapshot format [{rowData:{...}},...].
     * @param {string} jsonText - Raw JSON file content
     * @returns {Array<Object>} Array of {COL_NAME: "value", ...} objects
     */
    function parseJSONToObjects(jsonText) {
        var parsed = JSON.parse(jsonText);

        if (!Array.isArray(parsed)) {
            throw new Error('JSON file must contain a top-level array of objects.');
        }
        if (parsed.length === 0) {
            throw new Error('JSON file contains an empty array.');
        }

        var firstItem = parsed[0];
        var sourceArray;

        if (firstItem.rowData && typeof firstItem.rowData === 'object') {
            sourceArray = parsed.map(function (item) { return item.rowData; });
        } else if (typeof firstItem === 'object' && !Array.isArray(firstItem)) {
            sourceArray = parsed;
        } else {
            throw new Error('JSON must be an array of objects (e.g., [{"COL": "val"}, ...]).');
        }

        return sourceArray.map(function (row) {
            var obj = {};
            for (var key in row) {
                // .call: this is the file's own row, keys not yet uppercased - a
                // column named hasOwnProperty in the JSON shadows the method.
                if (Object.prototype.hasOwnProperty.call(row, key)) {
                    var val = row[key];
                    if (val === null || val === undefined) {
                        obj[key.toUpperCase()] = '';
                    } else if (typeof val === 'object') {
                        // Nested objects/arrays → prefix with @@JSON for subtable rendering
                        obj[key.toUpperCase()] = '@@JSON' + JSON.stringify(val);
                    } else {
                        obj[key.toUpperCase()] = String(val);
                    }
                }
            }
            return obj;
        });
    }

    /**
     * Lazy-loads the SheetJS (xlsx.js) library on demand.
     * Caches load state so subsequent calls resolve immediately.
     * @param {Function} callback - Called when XLSX global is available
     */
    var _xlsxLoadState = 'idle'; // 'idle' | 'loading' | 'loaded'
    var _xlsxCallbacks = [];
    function ensureXLSXLoaded(callback) {
        if (_xlsxLoadState === 'loaded' || window.XLSX) {
            _xlsxLoadState = 'loaded';
            callback();
            return;
        }
        _xlsxCallbacks.push(callback);
        if (_xlsxLoadState === 'loading') return; // already loading, just queue
        _xlsxLoadState = 'loading';
        var script = document.createElement('script');
        script.src = 'js/xlsx.full.min.js';
        script.onload = function () {
            _xlsxLoadState = 'loaded';
            var cbs = _xlsxCallbacks.slice();
            _xlsxCallbacks = [];
            cbs.forEach(function (cb) { cb(); });
        };
        script.onerror = function () {
            _xlsxLoadState = 'idle';
            _xlsxCallbacks = [];
            hideLoading();
            penumbraProbeAssetForExpiry(script.src).then(function (expired) {
                // Expired session: the sign-in dialog is up, and "check your
                // network connection" would send the user chasing the wrong fix.
                if (!expired) {
                    show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to load spreadsheet parser library. Check your network connection and try again.</p>");
                }
            });
        };
        document.head.appendChild(script);
    }

    // The column a multi-worksheet import adds, holding each row's tab name.
    // TWIN: PENUMBRA_IMPORT_SHEET_COLUMN in shared_logic.php, whose imports/
    // folder parser must stack a workbook exactly as this one does - otherwise
    // the folder's auto-refresh rewrites a stacked import into another shape.
    var PENUMBRA_IMPORT_SHEET_COLUMN = 'WORKSHEET';

    /**
     * Parses a spreadsheet file (XLS/XLSX/ODS) ArrayBuffer into plain objects with UPPERCASE keys.
     * Uses SheetJS (must be loaded first via ensureXLSXLoaded).
     *
     * Every VISIBLE worksheet holding a header row and a data row is read
     * (2026-10-02). One such sheet comes back exactly as the first-sheet-only
     * parser returned it; none falls back to that parser outright (first sheet,
     * hidden or not, and its own error). Two or more are STACKED in tab order:
     * the tab name in a WORKSHEET column first, then the union of the sheets'
     * columns in first-seen order. Every row carries every column, blank where
     * its own sheet has none - the [IMPORT] resolver takes its column list from
     * the FIRST row alone, so a column missing there would silently vanish.
     * @param {ArrayBuffer} arrayBuffer - Raw file content
     * @returns {{rows: Array<Object>, sheets: Array<{name: string, rows: number}>,
     *            skipped: Array<{name: string, reason: string}>, sheetColumn: ?string}}
     *          rows = {COL_NAME: "value", ...} objects; sheetColumn is null unless sheets were stacked.
     */
    function parseXLSXToObjects(arrayBuffer) {
        var wb = XLSX.read(arrayBuffer, { type: 'array' });
        if (!wb.SheetNames || wb.SheetNames.length === 0) {
            throw new Error('Spreadsheet file contains no sheets.');
        }
        var sheetRows = function (name) {
            return XLSX.utils.sheet_to_json(wb.Sheets[name], { header: 1, defval: '' });
        };

        // Hidden: 1 = hidden, 2 = very hidden. A tab its author hid is lookup or
        // scratch data, not a section of the table.
        var props = (wb.Workbook && wb.Workbook.Sheets) || [];
        var found = [], skipped = [];
        for (var si = 0; si < wb.SheetNames.length; si++) {
            var name = wb.SheetNames[si];
            if (props[si] && props[si].Hidden) {
                skipped.push({ name: name, reason: 'hidden' });
                continue;
            }
            try {
                if (!wb.Sheets[name]) throw new Error('no sheet data');   // e.g. a chart sheet
                var parsed = _xlsxSheetToObjects(sheetRows(name));
                found.push({ name: name, headers: parsed.headers, rows: parsed.rows });
            } catch (e) {
                skipped.push({ name: name, reason: 'no data' });
            }
        }
        if (found.length === 0) {
            var first = _xlsxSheetToObjects(sheetRows(wb.SheetNames[0]));   // throws its own message
            return { rows: first.rows, sheets: [{ name: wb.SheetNames[0], rows: first.rows.length }], skipped: [], sheetColumn: null };
        }
        var sheets = found.map(function (s) { return { name: s.name, rows: s.rows.length }; });
        if (found.length === 1) {
            return { rows: found[0].rows, sheets: sheets, skipped: skipped, sheetColumn: null };
        }

        // Keys are UPPERCASE already, so "Amount" on one tab and "AMOUNT" on the
        // next are the same column.
        var columns = [];
        var seen = Object.create(null);
        found.forEach(function (s) {
            s.headers.forEach(function (h) {
                if (!(h in seen)) { seen[h] = true; columns.push(h); }
            });
        });
        // A tab with its own WORKSHEET column keeps it; ours takes the next free
        // name, the way a duplicate header would (WORKSHEET_2, _3, ...).
        var sheetColumn = PENUMBRA_IMPORT_SHEET_COLUMN;
        for (var n = 2; sheetColumn in seen; n++) sheetColumn = PENUMBRA_IMPORT_SHEET_COLUMN + '_' + n;

        var rows = [];
        found.forEach(function (s) {
            s.rows.forEach(function (r) {
                var obj = {};
                obj[sheetColumn] = s.name;
                for (var c = 0; c < columns.length; c++) {
                    obj[columns[c]] = Object.prototype.hasOwnProperty.call(r, columns[c]) ? r[columns[c]] : '';
                }
                rows.push(obj);
            });
        });
        return { rows: rows, sheets: sheets, skipped: skipped, sheetColumn: sheetColumn };
    }

    /**
     * One worksheet's SheetJS rows (header:1 arrays) -> {headers, rows}, rows being
     * plain objects with UPPERCASE keys. Throws for a sheet without a header row
     * or a data row - the messages a one-sheet workbook has always reported.
     * @param {Array<Array>} rawRows
     * @returns {{headers: Array<string>, rows: Array<Object>}}
     */
    function _xlsxSheetToObjects(rawRows) {
        if (!rawRows || rawRows.length < 2) {
            throw new Error('Spreadsheet must have a header row and at least one data row.');
        }

        // First row = headers
        var rawHeaders = rawRows[0].map(function (h) {
            return String(h).trim().toUpperCase();
        });

        // Deduplicate header names (same logic as parseCSVToObjects)
        var headerCounts = {};
        var headers = rawHeaders.map(function (h) {
            if (!h) h = 'COLUMN';
            if (headerCounts[h] === undefined) {
                headerCounts[h] = 1;
                return h;
            } else {
                headerCounts[h]++;
                return h + '_' + headerCounts[h];
            }
        });

        // Data rows (skip header)
        var dataRows = rawRows.slice(1);

        // Filter empty rows
        dataRows = dataRows.filter(function (row) {
            return row.some(function (cell) { return cell !== '' && cell !== null && cell !== undefined; });
        });

        // Filter grand total rows (same logic as CSV parser)
        var headerCount = headers.length;
        var totalPattern = /^(grand\s+)?total[s]?$/i;
        dataRows = dataRows.filter(function (row) {
            var firstCell = String(row[0] || '').trim();
            if (totalPattern.test(firstCell)) {
                var filledCells = row.filter(function (c) { return c !== '' && c !== null && c !== undefined; }).length;
                if (filledCells < headerCount * 0.5) return false;
            }
            return true;
        });

        if (dataRows.length === 0) {
            throw new Error('Spreadsheet has headers but no data rows.');
        }

        return { headers: headers, rows: dataRows.map(function (row) {
            var obj = {};
            headers.forEach(function (header, idx) {
                var val = (idx < row.length) ? row[idx] : '';
                if (val === null || val === undefined) {
                    obj[header] = '';
                } else if (typeof val === 'object') {
                    obj[header] = '@@JSON' + JSON.stringify(val);
                } else {
                    obj[header] = String(val);
                }
            });
            return obj;
        }) };
    }

    /**
     * Imports parsed file data into the Penumbra results table.
     * Mirrors the snapshot loading flow: parse → masterRowData → rebuildTableFromMasterData.
     * @param {Array<Object>} parsedData - Array of {COL: "val"} objects
     * @param {string} fileName - Original file name for display
     * @param {Object} [book] - parseXLSXToObjects() result, passed only when it stacked
     *        several worksheets (book.sheetColumn set); the import then opens grouped by them.
     */
    function importFileData(parsedData, fileName, book) {
        if (!parsedData || parsedData.length === 0) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> No data rows found in file.</p>");
            return;
        }

        // Pre-flight the row cap, as the snapshot "Copy to imports" paths do. The
        // server refuses an oversize save, and that refusal used to reach the user
        // only as a console warning ahead of a second failure at query time - or,
        // over an existing import of the same name, as the OLD rows. Stacked
        // worksheets make the cap much easier to reach.
        if (parsedData.length > PENUMBRA_IMPORT_MAX_ROWS) {
            show_text("<p id='undo_text'><span style='color:var(--accent-danger,#cc0000)'>ERROR:</span> " + escapeHtml(fileName) + " has "
                + parsedData.length.toLocaleString() + " rows" + (book ? " across " + book.sheets.length + " worksheets" : "")
                + ", over the " + PENUMBRA_IMPORT_MAX_ROWS.toLocaleString() + "-row import limit.</p>", 11000);
            return;
        }

        // Strip the '#' column if present - Penumbra exports include a synthetic
        // row-number column named '#' which collides with the hardcoded '#' row-
        // number column that the table renderer always creates.  Keeping it would
        // produce a duplicate '#' header/cell and cause state save/load mismatches
        // (visibleColumns stores '#' as a string for the row-number toggle while
        // columnOrder stores the numeric index 0 for the data column).  The values
        // are also stale the moment the data is filtered, sorted, or re-queried.
        if (parsedData[0] && parsedData[0].hasOwnProperty('#')) {
            parsedData = parsedData.map(function (row) {
                var cleaned = {};
                for (var key in row) {
                    if (row.hasOwnProperty(key) && key !== '#') {
                        cleaned[key] = row[key];
                    }
                }
                return cleaned;
            });
        }

        // Derive a safe import name from the filename
        var safeName = fileName.replace(/\.[^.]+$/, '').replace(/[^A-Za-z0-9_]/g, '_').replace(/_+/g, '_').replace(/^_|_$/g, '').toUpperCase();
        if (!safeName) safeName = 'IMPORTED_DATA';

        // Check if an import with this name already exists - prompt to overwrite
        var alreadyExists = window._penumbraImportedData.hasOwnProperty(safeName)
            || window._penumbraImportMeta.hasOwnProperty(safeName);
        if (alreadyExists) {
            var existingMeta = window._penumbraImportMeta[safeName];
            var existingRows = existingMeta ? (existingMeta.row_count || '?') : '?';
            // Say when the new data is STACKED: re-uploading a workbook that used to
            // import as its first sheet alone now brings every sheet plus a column.
            var newDesc = parsedData.length + ' rows' + (book
                ? ' from ' + book.sheets.length + ' worksheets, stacked with a ' + book.sheetColumn + ' column'
                : '');
            if (!confirm('An import named "' + safeName + '" already exists (' + existingRows + ' rows).\n\nOverwrite with new data (' + newDesc + ')?')) {
                return;
            }
        }

        // Register the file in the queryable data source registry
        window._penumbraImportedData[safeName] = parsedData;

        // Persist to server, then auto-execute query once server ID is available
        $.ajax({
            url: 'manage_imports.php',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                action: 'save',
                import_name: safeName,
                filename: fileName,
                import_data: JSON.stringify(parsedData),
                row_count: parsedData.length
            }),
            dataType: 'json',
            success: function (resp) {
                if (resp && resp.status === 'success' && resp.id) {
                    window._penumbraImportIds[safeName] = resp.id;
                    window._penumbraImportMeta[safeName] = {
                        id: resp.id,
                        filename: fileName,
                        row_count: parsedData.length
                    };
                }
            },
            error: function (xhr) {
                // The query sends a name's STORED id ahead of the session's rows
                // (#executeQuery: _penumbraImportIds, then _penumbraImportMeta's id,
                // then _penumbraImportedData), so a refused save over an existing
                // import ran on the PREVIOUS upload with no sign that anything had
                // failed. Forget the id: the query then sends the rows just parsed,
                // which query.php reads as its inline fallback.
                delete window._penumbraImportIds[safeName];
                if (window._penumbraImportMeta[safeName]) delete window._penumbraImportMeta[safeName].id;
                var why = '';
                try {
                    var j = xhr && xhr.responseJSON;
                    if (!j && xhr && xhr.responseText) j = JSON.parse(xhr.responseText);
                    why = (j && (j.message || j.error)) || '';
                } catch (e) { /* non-JSON error body: no reason to add */ }
                console.warn('Failed to persist import "' + safeName + '" to server. Data available in session only.');
                show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> <strong>" + escapeHtml(fileName)
                    + "</strong> could not be saved as the import <code>" + escapeHtml(safeName) + "</code>, so it is available for this session only."
                    + (why ? " " + escapeHtml(String(why)) : "") + "</p>", 11000);
            },
            complete: function () {
                // Auto-execute after save completes (success or failure - inline fallback still works)
                if (book) _importArmSheetGrouping(book, fileName);
                performClearAllAction(safeName, 'SELECT * FROM [IMPORT; name=' + safeName + ']');
            }
        });

        // Refresh table selector if admin
        if (typeof populateSelectorBox === 'function' && document.getElementById('tableSelectorContent')) {
            populateSelectorBox();
            // Expand "Imported Files" group for focus after import
            $('[data-target="imported-files"]').removeClass('collapsed');
            $('#imported-files').removeClass('collapsed');
        }

        // Hide landing page sections ("Jump Back In", "Why Penumbra") and open admin console
        $('.landing-container').hide();
        if (typeof toggleSmartAdminView === 'function') {
            toggleSmartAdminView(true);
        }
    }

    /**
     * Arms the view a stacked multi-worksheet import opens in: grouped by its
     * sheet column, one band per tab, in TAB order. Group label sort reads the
     * column's custom sort order (getCustomSortComparator), so the tab order is
     * written there - where a reader's own order for the column would live, so
     * it is saved with the report and editable like any other. The grouping is
     * a one-shot the next query start consumes (pendingImportSheetGroup).
     * @param {Object} book - parseXLSXToObjects() result with sheetColumn set
     * @param {string} fileName - Original file name for the notice
     */
    function _importArmSheetGrouping(book, fileName) {
        _csDeleteOrder(book.sheetColumn);
        customSortOrders[book.sheetColumn] = {
            values: book.sheets.map(function (s) { return s.name; }),
            preset: null
        };
        _csInvalidateComparators();
        renderCustomSortOrderCards();
        pendingImportSheetGroup = book.sheetColumn;

        var listOf = function (items, label) {
            var MAX = 8;
            var txt = items.slice(0, MAX).map(function (s) {
                return escapeHtml(s.name) + ' (' + label(s) + ')';
            }).join(', ');
            return items.length > MAX ? txt + ' and ' + (items.length - MAX) + ' more' : txt;
        };
        var skippedTxt = book.skipped.length
            ? ' Skipped: ' + listOf(book.skipped, function (s) { return s.reason; }) + '.'
            : '';
        show_text("<p id='undo_text'><span style='color: lightgreen'>IMPORTED:</span> " + book.sheets.length
            + " worksheets from <strong>" + escapeHtml(fileName) + "</strong> as one table, grouped by <code>"
            + escapeHtml(book.sheetColumn) + "</code> in tab order: "
            + listOf(book.sheets, function (s) { return s.rows.toLocaleString() + (s.rows === 1 ? ' row' : ' rows'); })
            + "." + skippedTxt + "</p>", 10000);
    }

    /**
     * Reads a File object and routes to the appropriate parser.
     * @param {File} file - The file from input or drop event
     */
    function processImportFile(file) {
        var maxSize = 50 * 1024 * 1024; // 50 MB
        if (file.size > maxSize) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> File is too large (" +
                (file.size / 1024 / 1024).toFixed(1) + " MB). Maximum is 50 MB.</p>");
            return;
        }

        var extension = file.name.split('.').pop().toLowerCase();
        if (['csv', 'json', 'tsv', 'xls', 'xlsx', 'ods', 'txt'].indexOf(extension) === -1) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Unsupported file type '." +
                escapeHtml(extension) + "'. Supported: .csv, .tsv, .json, .xls, .xlsx, .ods, .txt</p>");
            return;
        }

        // Spreadsheet files need the SheetJS library (lazy-loaded) and ArrayBuffer reading
        if (extension === 'xls' || extension === 'xlsx' || extension === 'ods') {
            showLoading("Loading spreadsheet parser...");
            ensureXLSXLoaded(function () {
                var reader = new FileReader();
                reader.onload = function (event) {
                    try {
                        var book = parseXLSXToObjects(event.target.result);
                        importFileData(book.rows, file.name, book.sheetColumn ? book : null);
                    } catch (e) {
                        console.error("Parse error:", e);
                        show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>PARSE ERROR:</span> " + escapeHtml(e.message) + "</p>");
                    } finally {
                        hideLoading();
                    }
                };
                reader.onerror = function () {
                    hideLoading();
                    show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Could not read file.</p>");
                };
                reader.readAsArrayBuffer(file);
            });
            return;
        }

        // Text-based formats (CSV, TSV, JSON)
        var reader = new FileReader();
        reader.onload = function (event) {
            var content = event.target.result;
            try {
                var parsedData;
                if (extension === 'json') {
                    parsedData = parseJSONToObjects(content);
                } else {
                    var delim = (extension === 'tsv') ? '\t' : undefined;
                    parsedData = parseCSVToObjects(content, delim);
                }
                importFileData(parsedData, file.name);
            } catch (e) {
                console.error("Parse error:", e);
                show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>PARSE ERROR:</span> " + escapeHtml(e.message) + "</p>");
            }
        };
        reader.onerror = function () {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Could not read file.</p>");
        };
        reader.readAsText(file);
    }

