    // opts.scoped: this load only rearranges the data (Restore Transaction
    // List, Remove Grouping, a sort), so it veils the data region like a
    // switch-driven change does. A change a switch started is scoped anyway.
    function showLoading(message, showTimer = false, opts = null) {
        // Direct-child `> p` only: #loadingOverlay also contains the
        // #execution-timer <p> (nested in a div), which must NOT be overwritten
        // with the message text or the footer "Loaded in" stat reads it back as
        // garbage on fast responses.
        $("#loadingOverlay > p").text(message);
