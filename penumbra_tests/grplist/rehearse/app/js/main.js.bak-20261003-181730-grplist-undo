            let allKnownColumns = Array.from(masterRowData[0].keys());
            // Journal toggle/notes columns, so a rewrite rule can condition on them.
            if (window.Penumbra && window.Penumbra.journalMergeCols) {
                allKnownColumns = window.Penumbra.journalMergeCols(allKnownColumns);
            }
