        // the blur (via body.pnb-heavy-dom). Under the threshold keep the snappy
        // 130ms fade + blur(2px). Tune the 1500 here.
        var _pnbHeavyDom = totalRowCount > 1500;
        $.fx.speeds._default = _pnbHeavyDom ? 0 : 130;
