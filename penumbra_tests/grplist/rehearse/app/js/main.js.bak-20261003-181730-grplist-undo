    /**
     * Given a term from the access list input (after the last comma), strip any
     * leading non-name tokens (OUCs, reserved keywords, email addresses) that were
     * already present in the field. Returns the remaining name fragment to search,
     * or null if nothing searchable remains.
     */
    function extractNameTerm(term) {
        if (!term) return null;
        // Pure non-name term: all digits (OUC), contains @ (email), or is exactly a keyword
        if (/^\d+$/.test(term)) return null;
        if (term.indexOf('@') !== -1) return null;
        if (/^(public|adminonly)$/i.test(term)) return null;

        // If the term has spaces, strip any leading words that are non-name tokens
        // e.g. "public rusty" → strip "public" → "rusty"
        // e.g. "John Smith" → "John" is not a reserved word → keep "John Smith"
        if (term.indexOf(' ') !== -1) {
            var words = term.split(/\s+/);
            // Walk forward, dropping words that are OUCs or reserved keywords
            while (words.length > 1) {
                var first = words[0];
                if (/^\d+$/.test(first) || /^(public|adminonly)$/i.test(first)) {
                    words.shift();
                } else {
                    break;
                }
            }
            term = words.join(' ');
            // After stripping, re-check
            if (/^\d+$/.test(term) || /^(public|adminonly)$/i.test(term)) return null;
        }

        return term.length >= 3 ? term : null;
    }

