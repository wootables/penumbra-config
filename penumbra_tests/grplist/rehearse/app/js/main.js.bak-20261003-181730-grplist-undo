                $(this).attr('aria-expanded', open ? 'true' : 'false');
            })
            // Picking an item closes the menu. Deliberately NOT preventing the
            // event: it keeps bubbling to the buttons' own document-level
            // handlers, which is what actually performs the action.
            .on('click.vizActions', '#vizActionsPanel button', function () {
                vizCloseActionsMenu();
            })
            .on('click.vizActions', function (e) {
                if (!$(e.target).closest('#vizActionsMenu').length) vizCloseActionsMenu();
            })
            // NO Escape handler here, deliberately. The app closes dialogs from a
            // single CAPTURE-phase Escape listener on document, which runs before
            // any bubble-phase delegated handler can see the key - verified live:
            // Escape with this menu open closes the whole Builder and the
            // delegated handler never fires. Rather than race that listener, the
            // menu closes on outside-click, on picking an item, and on the
            // trigger. See [[escape_key_handling]].
            // Left/Right move the SELECTION (not just the scroll) by triggering
            // a real click, so all the existing per-type wiring runs unchanged.
            .on('keydown.vizCarou', '#vizTypeSelector', function (e) {
                var step = e.key === 'ArrowRight' ? 1 : (e.key === 'ArrowLeft' ? -1 : 0);
                if (!step && e.key !== 'Home' && e.key !== 'End') return;
                var $all = $('#vizTypeSelector .viz-type-option');
                if (!$all.length) return;
                var cur = $all.index($all.filter('.active'));
                var next;
                if (e.key === 'Home') next = 0;
                else if (e.key === 'End') next = $all.length - 1;
                else next = Math.min($all.length - 1, Math.max(0, (cur < 0 ? 0 : cur) + step));
                e.preventDefault();
                $all.eq(next).trigger('click');
            });
    });

    // WCAG 4.1.2: #vizTypeSelector is a listbox, so its tiles are options with
    // a selected state, and the listbox names the active one. Mirrors .active
    // from every path that sets it (click, preset restore, reset).
    (function () {
        var sel = document.getElementById('vizTypeSelector');
        if (!sel || !window.MutationObserver) return;
        function sync() {
            var opts = sel.querySelectorAll('.viz-type-option'), activeId = '';
            for (var i = 0; i < opts.length; i++) {
                var o = opts[i], on = o.classList.contains('active');
                if (!o.id) o.id = 'vizTypeOpt-' + (o.getAttribute('data-type') || i);
                if (o.getAttribute('role') !== 'option') o.setAttribute('role', 'option');
                o.setAttribute('aria-selected', on ? 'true' : 'false');
                if (on) activeId = o.id;
            }
            if (activeId) sel.setAttribute('aria-activedescendant', activeId);
            else sel.removeAttribute('aria-activedescendant');
