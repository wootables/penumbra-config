                // Added readonly to force modal usage, and data-raw-prompt to pass configuration.
                // data-stored-value carries the underlying value for autofill prompts whose
                // display differs from the value (e.g. "Limon, Bruce (4095)" → unique_id GUID).
                // Initially equal to the visible value; the click handler updates both after
                // the dialog returns a {value, display} pair.
                const inputHtml = `
                    <div class="form-row" style="margin-bottom: 8px;">
                        <label style="font-size: 11px; display:block;">${labelHtml}</label>
                        <input type="text" class="sched-prompt-input"
                               data-name="${escapeHtml(p.name)}"
                               data-raw-prompt="${escapeHtml(p.rawString)}"
                               data-stored-value="${escapeHtml(String(val))}"
                               value="${escapeHtml(schedShownVal)}"
                               style="${inputStyle} cursor: pointer;"
                               readonly
                               ${disabledAttr}>
                        ${helperText}
                    </div>`;
                $('#schedPromptsContainer').append(inputHtml);
            }
            );

            // Check for empty prompts on load and show warning immediately.
            // Skip prompts that have a `resultif` condition - those are child
            // prompts whose emptiness depends on the parent's value; an empty
            // child is expected when the parent's value doesn't match the
            // resultif, so warning would be a false positive.
            if (!hasInvalidPrompts) {
                const loadEmptyPrompts = [];
                prompts.forEach(p => {
                    const $inp = $('.sched-prompt-input[data-name="' + p.name + '"]');
                    const curVal = $inp.length ? $inp.val().trim() : '';
                    if ((!curVal || curVal === '') && p.forcedefault === null && !p.hidden && !p.resultif) {
                        loadEmptyPrompts.push(p.message || p.label || p.name);
                    }
                });
                if (loadEmptyPrompts.length > 0) {
                    $('#schedMsgContainer').html('<span style="color: var(--accent-warning, #b58900);">\u26A0\uFE0F Warning: Empty prompt' + (loadEmptyPrompts.length > 1 ? 's' : '') + ': ' + loadEmptyPrompts.map(function(n) { return '"' + n + '"'; }).join(', ') + '. The query may receive NULL values.</span>').show();
                }
            }
        } else {
            $('#saveTaskBtn').prop('disabled', false).css('opacity', 1).removeAttr('title');
            $('#schedPromptsRow').hide()
        }

        // ------------------------------
        // me() values (scheduler-resolved). A scheduled run has no logged-in
        // user, so any me(...) in the report's SQL would resolve to '' server-
        // side. Surface one field per distinct me() token so the admin supplies
        // an explicit value: a literal, or a recipient variable like {OUC} to use
        // each recipient's own value on per-recipient email tasks.
        const meTokens = extractMeTokensForScheduler();
        let savedMeMap = {};
        if (task && task.OPTIONS) {
            try { savedMeMap = JSON.parse(task.OPTIONS).me_map || {}; } catch (e) { }
        }
        if (meTokens.length > 0) {
            $('#schedMeRow').show();
            $('#schedMeContainer').empty().show();
            // Suggested recipient variable per me() key (placeholder/hint only).
            const meVarSuggest = {
                '': '{USERNAME}', 'unityid': '{USERNAME}', 'unity': '{USERNAME}', 'username': '{USERNAME}',
                'ouc': '{OUC}', 'ouc2d': '{OUC2D}', 'ouc4d': '{OUC4D}', 'ouc6d': '{OUC6D}',
                'dept': '{DEPT}', 'department': '{DEPT}', 'email': '{EMAIL}',
                'fname': '{FNAME}', 'lname': '{LNAME}', 'emplid': '{EMPL_ID}',
                'emplid4': '{EMPL_ID4}'
            };
            meTokens.forEach(t => {
                const savedVal = (savedMeMap[t.key] !== undefined && savedMeMap[t.key] !== null) ? String(savedMeMap[t.key]) : '';
                const suggest = meVarSuggest[t.key] || '{OUC}';
                const inputHtml = `
                    <div class="form-row" style="margin-bottom: 8px;">
                        <label style="font-size: 11px; display:block;"><code>${escapeHtml(t.token)}</code> resolves to:</label>
                        <input type="text" class="sched-me-input"
                               data-me-key="${escapeHtml(t.key)}"
                               value="${escapeHtml(savedVal)}"
                               placeholder="${escapeHtml(suggest)}"
                               style="width: 100%; text-align: left; padding: 4px; font-size: 11px;">
                        <div style="font-size:9px; margin-top:1px; opacity:0.75;">Fixed value, or a recipient variable like <code>${escapeHtml(suggest)}</code> (per-recipient email tasks). Blank = sent empty.</div>
                    </div>`;
                $('#schedMeContainer').append(inputHtml);
            });
            // Warn about any currently-blank me() tokens (they will send empty).
            const blankMe = meTokens.filter(t => {
                const sv = (savedMeMap[t.key] !== undefined && savedMeMap[t.key] !== null) ? String(savedMeMap[t.key]).trim() : '';
                return sv === '';
            });
            if (blankMe.length > 0) {
                $('#schedMeContainer').append('<div style="font-size:9px; color: var(--accent-warning, #b58900); margin-top:2px;">⚠️ Unset me() ' + (blankMe.length > 1 ? 'macros' : 'macro') + ' (' + blankMe.map(t => t.token).join(', ') + ') will be sent as empty in scheduled runs.</div>');
            }
        } else {
            $('#schedMeRow').hide();
        }
        // ------------------------------

        if (task) {
            // Edit Mode (button colors are theme-driven via .sched-btn-* classes)
            $('#saveTaskBtn').text('Update Scheduled Task');

            $('#schedTaskId').val(task.ID);
            $('#schedEventType').val(task.TASK_TYPE);
            applyTaskTypeUI(task.TASK_TYPE);
            setEventTypeLocked(true);   // saved task: lock the event type
            $('#schedSubject').val(stripHtml(task.SUBJECT));
            $('#schedCron').val(task.CRON_EXPRESSION);
            // Track active state via data attribute (checkbox removed from UI)
            $('#saveTaskBtn').data('task-is-active', parseInt(task.IS_ACTIVE) === 1);
            $('#deleteTaskBtn').show();
            $('#cancelTaskBtn').hide();   // Delete owns the left slot for saved events
            $('#testRunTaskBtn').show();

            let options = {};
            try {
                options = JSON.parse(task.OPTIONS || '{}');
            } catch (e) { }

            // Reflect a queued one-time Test Run: disable the button so it can't
            // be double-queued. The runner clears _test_run_pending after it runs,
            // so a later list refresh restores the button automatically.
            if (options && options._test_run_pending) {
                $('#testRunTaskBtn').prop('disabled', true).addClass('test-run-pending')
                    .html('&#10003;&nbsp;Test Run Queued')
                    .attr('title', 'A test run is already queued for this task. It will run on the next scheduler cycle (within ~5 min), then clear automatically.');
            } else {
                $('#testRunTaskBtn').prop('disabled', false).removeClass('test-run-pending')
                    .html('&#9658;&nbsp;Test Run')
                    .attr('title', "Queue a one-time run on the next scheduler cycle (within ~5 min). Does not change the task's schedule.");
            }

            // On Completion card (shared). Migrate from legacy email_on_success /
            // notify_recipients for tasks saved before this card; default both on,
            // recipients = the owner's email.
            var ocOwner = (task.OWNER_ID ? task.OWNER_ID + '@ncsu.edu' : (window.schedOwnerEmailDefault ? window.schedOwnerEmailDefault() : ''));
            var ocLegacy = (window.schedLegacyNotifyToEmails ? window.schedLegacyNotifyToEmails(options.notify_recipients, ocOwner) : '');
            var ocSuccessOn = (options.notify_success !== undefined) ? (options.notify_success !== false)
                              : (options.email_on_success !== undefined ? (options.email_on_success !== false) : true);
            var ocFailureOn = (options.notify_failure !== undefined) ? (options.notify_failure !== false) : true;
            $('#schedNotifySuccess').prop('checked', ocSuccessOn);
            $('#schedNotifyFailure').prop('checked', ocFailureOn);
            $('#schedNotifySuccessEmails').val(options.notify_success_recipients || ocLegacy || ocOwner);
            $('#schedNotifyFailureEmails').val(options.notify_failure_recipients || ocLegacy || ocOwner);
            if (window.updateOnCompletionDisabled) window.updateOnCompletionDisabled();

            var $ssf = $('#schedSearchFilter');
            $ssf.val(options.search_filter || '');
            // Close any open autocomplete menu (don't trigger 'input' which re-opens it)
            if ($ssf.data('ui-autocomplete')) $ssf.autocomplete('close');
            // Manually fire the hint update
            clearTimeout(schedFilterTimer);
            schedFilterTimer = setTimeout(updateSchedFilterHint, 100);
            $('#schedAttachCsv').prop('checked', options.attach_csv);
            $('#schedAttachXlsx').prop('checked', options.attach_xlsx);
            $('#schedAttachPdf').prop('checked', options.attach_pdf === true);
            $('#schedIncludeBody').prop('checked', !options.no_body);
            $('#schedIncludeLink').prop('checked', options.include_link !== false);
            $('#schedStripLinks').prop('checked', options.no_links === true);
            $('#schedSkipEmpty').prop('checked', options.skip_empty === true);
            // skip_if_missed_min: minutes, 0/absent = off (the checkbox writes 60).
            // Shared across every task type, so the SNAPSHOT/DROP_FILE re-set
            // blocks below don't need to touch it - this one line is the loader.
            $('#schedSkipMissed').prop('checked', (parseInt(options.skip_if_missed_min, 10) || 0) > 0);
            // skip_no_change is disabled in the UI but preserve the saved state
            $('#schedSkipNoChange').prop('checked', options.skip_no_change === true);
            $('#schedSkipCustomCondition').prop('checked', options.skip_custom_condition === true);
            $('#schedCustomConditionExpr').val(options.custom_condition_expr || '');
            // Show/hide the custom condition box based on checkbox state
            $('#schedCustomConditionBox').toggle(options.skip_custom_condition === true);
            if (options.skip_custom_condition === true) {
                validateCustomConditionExpr();
            }
            // Include Snippet defaults to checked for backwards compat
            $('#schedIncludeSnippet').prop('checked', options.include_snippet !== false);

            // Subscriptions card (EMAIL delivery option; inert for other types).
            // The subscriber list is display-only here - it is server-owned
            // (manage_subscription.php) and never round-trips through a save.
            $('#schedSubsEnable').prop('checked', options.subscriptions_enabled === true);
            // Encrypted reports can't offer self-service subscriptions (the
            // scheduler decrypts with the stored password, so a subscription
            // would bypass it); manage_subscription.php enforces this too.
            $('#schedSubsEnable').prop('disabled', isEncrypted)
                .attr('title', isEncrypted ? 'Unavailable for password-protected reports - emailed copies would bypass the password. Add recipients directly instead.' : null);
            $('#schedSubsNotify').prop('checked', options.subscriptions_notify !== false);
            // "Allow only on custom condition": checked exactly when a condition is stored.
            var _subCondSaved = (typeof options.subscriptions_condition === 'string') ? options.subscriptions_condition : '';
            _schedSubsCondReset();
            $('#schedSubsCondEnable').prop('checked', _subCondSaved !== '');
            $('#schedSubsCondExpr').val(_subCondSaved);
            _schedCurrentSubscribers = Array.isArray(options.subscribers) ? options.subscribers : [];
            _schedCurrentSuppressed = Array.isArray(options.suppressed) ? options.suppressed : [];
            _schedSubsCollapsed = true;
            updateSubscriptionCardUI();
            // Show the owner who matches (and who the next send would remove) on open.
            if (_subCondSaved !== '' && options.subscriptions_enabled === true && task.TASK_TYPE === 'EMAIL') _schedSubsCondSchedule(0);

            // Restore snapshot-specific options (shared skip keys with backwards compat from old snap_* keys)
            if (task.TASK_TYPE === 'SNAPSHOT') {
                $('#schedSkipEmpty').prop('checked', (options.skip_empty !== undefined ? options.skip_empty : options.snap_skip_empty) !== false);
                $('#schedSkipNoChange').prop('checked', options.skip_no_change === true || options.snap_skip_no_change === true);
                $('#schedSkipCustomCondition').prop('checked', options.skip_custom_condition === true);
                $('#schedCustomConditionExpr').val(options.custom_condition_expr || '');
                $('#schedCustomConditionBox').toggle(options.skip_custom_condition === true);
                if (options.skip_custom_condition === true) { validateCustomConditionExpr(); }
                $('#schedSnapMaxKeep').val(options.snap_max_keep || 50);
            }

            // Restore DROP_FILE-specific options
            if (task.TASK_TYPE === 'DROP_FILE') {
                $('#schedDropProtocol').val(options.drop_protocol || 'unc');
                applyDropProtocolUI(options.drop_protocol || 'unc');
                $('#schedDropHost').val(options.drop_host || '');
                $('#schedDropPort').val(options.drop_port || '');
                $('#schedDropPath').val(options.drop_path || '');
                $('#schedDropUsername').val(options.drop_username || '');
                $('#schedDropPassword').val('');
                $('#schedDropFilenamePattern').val(options.drop_filename_pattern || '{TITLE}_{DATE}');
                $('#schedDropFormatCsv').prop('checked', options.drop_format_csv !== false);
                $('#schedDropFormatXlsx').prop('checked', options.drop_format_xlsx === true);
                $('#schedDropFormatPdf').prop('checked', options.drop_format_pdf === true);
                $('#schedDropFormatJson').prop('checked', options.drop_format_json === true);
                // Custom Template: the task's OWN copy of the four fields (never a
                // preset name - presets are browser-local and the runner cannot see them).
                $('#schedDropFormatCustom').prop('checked', options.drop_format_custom === true);
                $('#schedDropCustomHeader').val(options.drop_custom_header || '');
                $('#schedDropCustomTemplate').val(options.drop_custom_template || '');
                $('#schedDropCustomExt').val(options.drop_custom_ext || 'txt');
                if (!$('#schedDropCustomExt').val()) $('#schedDropCustomExt').val('txt');
                $('#schedDropCustomNewline').prop('checked', options.drop_custom_newline !== false);
                // A task that already carries a template keeps its header exactly as
                // saved - "cleared on purpose" included. Only a task that never had
                // one gets the column-name default when Custom is first ticked.
                _schedDropTplHeaderTouched = options.drop_format_custom === true
                    || !!options.drop_custom_header || !!options.drop_custom_template;
                applyDropCustomTemplateUI();
                $('#schedDropPassiveMode').prop('checked', options.drop_passive_mode !== false);
                $('#schedDropUseFtps').prop('checked', options.drop_use_ftps === true);
                $('#schedDropSftpKey').val(options.drop_sftp_key || '');
                // Shared skip options (with backwards compat from old drop_skip_empty key)
                $('#schedSkipEmpty').prop('checked', (options.skip_empty !== undefined ? options.skip_empty : options.drop_skip_empty) !== false);
                $('#schedSkipNoChange').prop('checked', options.skip_no_change === true);
                $('#schedSkipCustomCondition').prop('checked', options.skip_custom_condition === true);
                $('#schedCustomConditionExpr').val(options.custom_condition_expr || '');
                $('#schedCustomConditionBox').toggle(options.skip_custom_condition === true);
                if (options.skip_custom_condition === true) { validateCustomConditionExpr(); }

                // S3 fields
                $('#schedDropS3Bucket').val(options.drop_s3_bucket || '');
                $('#schedDropS3Region').val(options.drop_s3_region || 'us-east-1');
                $('#schedDropS3Endpoint').val(options.drop_s3_endpoint || '');
                $('#schedDropS3AccessKey').val('');
                $('#schedDropS3SecretKey').val('');

                // Show "password saved" notices for encrypted fields
                if (options.has_drop_password) {
                    $('#schedDropPasswordNotice').show();
                }
                if (options.has_drop_s3_access_key) {
                    $('#schedDropS3AccessKeyNotice').show();
                }
                if (options.has_drop_s3_secret_key) {
                    $('#schedDropS3SecretKeyNotice').show();
                }
            }

            // Restore DB_DUMP-specific options
            if (task.TASK_TYPE === 'DB_DUMP') {
                var dumpSchema = (options.destination_schema || '').toUpperCase();
                var dumpTable  = (options.destination_table  || '').toUpperCase();
                $('#schedDbDumpSchema').val(dumpSchema);
                $('#schedDbDumpSchemaDisplay').text(dumpSchema || '(your schema)');
                $('#schedDbDumpTable').val(dumpTable);

                // Restore Options card state. The column list was already
                // populated by applyTaskTypeUI → populateDbDumpColumnSelector()
                // (defaulting to the report's shown columns). If this task has a
                // saved column list, apply it exactly: clear the default set,
                // then re-check the saved columns.
                if (Array.isArray(options.dbdump_columns_custom) && options.dbdump_columns_custom.length > 0) {
                    $('#schedDbDumpColumnSelector input[type=checkbox]').prop('checked', false);
                    options.dbdump_columns_custom.forEach(function (col) {
                        $('#schedDbDumpColumnSelector input[type=checkbox][value="' + String(col).toUpperCase() + '"]').prop('checked', true);
                    });
                }
                // Saved names that match nothing above have just vanished from
                // this card without a trace. Say so.
                renderDbDumpColumnDrift(options.dbdump_columns_custom);
                $('#schedDbDumpStripHtml').prop('checked', options.dbdump_strip_html === true);

                // Restore the row-limit choice. Absent (legacy/new task) → keep
                // the limiter-derived default set by initDbDumpRowLimitDefault().
                if (options.dbdump_row_mode === 'all' || options.dbdump_row_mode === 'enforce') {
                    var rlMode = options.dbdump_row_mode;
                    $('input[name="schedDbDumpRowMode"][value="' + rlMode + '"]').prop('checked', true);
                    var savedLimit = parseInt(options.dbdump_row_limit, 10);
                    if (!isNaN(savedLimit) && savedLimit > 0) {
                        $('#schedDbDumpRowLimit').val(savedLimit);
                    }
                    $('#schedDbDumpRowLimitInputWrap').toggle(rlMode === 'enforce');
                }

                // Restore reload mode (default 'recreate' for absent/legacy tasks).
                var reloadMode = (options.dbdump_reload_mode === 'truncate') ? 'truncate' : 'recreate';
                $('input[name="schedDbDumpReloadMode"][value="' + reloadMode + '"]').prop('checked', true);

                // Collision warning: only the server can detect cross-task collisions
                // (it returns collision_info on the LIST response). If present, expand
                // the override section pre-checked + reason filled iff a prior override
                // is already recorded on this task.
                var collision = Array.isArray(options.collision_info) ? options.collision_info : null;
                if (collision && collision.length > 0) {
                    var first = collision[0];
                    var detail = 'Currently also targeted by task #' + first.task_id
                        + ' (owner: ' + (first.owner_id || 'unknown')
                        + (first.last_run ? ', last run: ' + first.last_run : '')
                        + ')'
                        + (collision.length > 1 ? ' and ' + (collision.length - 1) + ' other task(s)' : '')
                        + '.';
                    $('#schedDbDumpCollisionDetail').text(detail);
                    $('#schedDbDumpCollisionBox').show();
                } else {
                    $('#schedDbDumpCollisionBox').hide();
                }

                // Re-check the override box only if a prior override was recorded
                // AND a current collision still exists. Otherwise the override flag
                // is stale (the conflict is gone) and shouldn't be re-applied.
                var hadOverride = !!(options.override_applied && (collision && collision.length > 0));
                $('#schedDbDumpOverride').prop('checked', hadOverride);
                $('#schedDbDumpOverrideReasonRow').toggle(hadOverride);
                $('#schedDbDumpOverrideReason').val(hadOverride && options.override_applied ? (options.override_applied.reason || '') : '');
            }

            // Restore shared change detection options (with backwards compat from old snap_change_* keys)
            var changeMode = options.change_mode || options.snap_change_mode || 'all';
            var changeColumns = options.change_columns || options.snap_change_columns || null;
            $('input[name="schedChangeMode"][value="' + changeMode + '"]').prop('checked', true);
            if (changeMode === 'custom') {
                $('#schedColumnSelector').show();
                if (changeColumns && Array.isArray(changeColumns)) {
                    changeColumns.forEach(function (col) {
                        $('#schedColumnSelector input[value="' + col.toUpperCase() + '"]').prop('checked', true);
                    });
                }
            } else {
                $('input[name="schedChangeMode"][value="all"]').prop('checked', true);
            }
            // "Send as Change Analysis" (EMAIL delivery option; inert for other
            // types). Restored BEFORE the visibility sync below - the change
            // detection card must appear for analysis-only tasks too.
            $('#schedChangesOnly').prop('checked', options.changes_only === true);

            // Show/hide the shared change mode row based on the active options
            updateChangeModeVisibility();

            // Load saved preamble
            $('#schedBodyPreamble').val(options.body_preamble || '');

            $('#schedThemeOverride').val(options.theme_override || '');

            $('#schedReportPassword').val('');
            if (options.has_password && isEncrypted) {
                $('#schedPasswordNotice').show();
            }

            if (task.RECIPIENTS) {
                var savedRecipientVars = options.recipient_vars || {};
                const entries = task.RECIPIENTS.split(';');
                entries.forEach(entry => {
                    entry = entry.trim();
                    if (!entry) return;
                    // Parse "First Last <email>" format
                    const match = entry.match(/^(.+?)\s*<([^>]+)>$/);
                    var recipEmail, recipName;
                    if (match) {
                        recipEmail = match[2].trim();
                        recipName = match[1].trim();
                    } else {
                        recipEmail = entry;
                        recipName = null;
                    }
                    // Restore rich user variable data from saved options (for tooltip)
                    var ud = savedRecipientVars[recipEmail.toLowerCase()] || null;
                    addEmailCapsule(recipEmail, recipName, '#schedEmailContainer', '#schedEmailInput', ud);
                });
            }
        } else {
            // New Mode (button colors are theme-driven via .sched-btn-* classes)
            $('#saveTaskBtn').text('Add New Scheduled Task');

            $('#schedTaskId').val('');
            // FIRST pass, always on EMAIL: this returns every type-specific card
            // to its base state before the reset block below re-defaults the
            // fields. The type actually chosen in the rail is applied in a SECOND
            // pass at the end of this branch - see the note there.
            $('#schedEventType').val('EMAIL');
            applyTaskTypeUI('EMAIL');
            setEventTypeLocked(false);  // new event: event type is selectable
            $('#schedSubject').val(stripHtml(getReportTitle()) + ' ({ROW_COUNT})');
            $('#schedBodyPreamble').val('');
            $('#schedCron').val('');
            $('#schedSearchFilter').val('');
            $('#schedSearchFilterHint').text('Optional. Filters query results before processing.').css('color', '');
            // Track active state via data attribute (checkbox removed from UI)
            $('#saveTaskBtn').data('task-is-active', true);
            $('#deleteTaskBtn').hide();
            $('#cancelTaskBtn').show();   // nothing to delete yet - Cancel takes the slot
            // Test Run is available for unsaved drafts too: it saves the form as
            // a hidden transient task (test_once=1) the runner executes once and
            // deletes - nothing is added to the events list.
            $('#testRunTaskBtn').show().prop('disabled', false).removeClass('test-run-pending')
                .html('&#9658;&nbsp;Test Run')
                .attr('title', SCHED_TEST_DRAFT_TITLE);

            $('#schedAttachCsv').prop('checked', true);
            $('#schedAttachXlsx').prop('checked', false);
            $('#schedAttachPdf').prop('checked', false);
            $('#schedIncludeBody').prop('checked', true);
            $('#schedIncludeLink').prop('checked', true);
            $('#schedStripLinks').prop('checked', false);
            $('#schedSkipEmpty').prop('checked', false);
            $('#schedSkipNoChange').prop('checked', false);
            $('#schedSkipCustomCondition').prop('checked', false);
            $('#schedSkipMissed').prop('checked', false);
            $('#schedCustomConditionExpr').val('');
            $('#schedCustomConditionBox').hide();
            $('#schedCustomConditionWarning').hide();
            $('#schedIncludeSnippet').prop('checked', false);
            const currentTheme = $('body').attr('class').split(' ').find(c => c.startsWith('theme-')) || 'theme-default';
            $('#schedThemeOverride').val(currentTheme);
            $('#schedReportPassword').val('');

            // Reset snapshot options to defaults
            $('#schedSnapMaxKeep').val(50);

            // Reset DROP_FILE options to defaults
            $('#schedDropProtocol').val('unc');
            applyDropProtocolUI('unc');
            $('#schedDropHost, #schedDropUsername, #schedDropPassword, #schedDropSftpKey').val('');
            $('#schedDropPort').val('');
            $('#schedDropPath').val('');
            $('#schedDropFilenamePattern').val('{TITLE}_{DATE}');
            $('#schedDropFormatCsv').prop('checked', true);
            // JSON was missing from this reset: a new draft opened after editing a
            // JSON task inherited its ticked JSON box.
            $('#schedDropFormatXlsx, #schedDropFormatPdf, #schedDropFormatJson, #schedDropFormatCustom').prop('checked', false);
            $('#schedDropCustomHeader, #schedDropCustomTemplate').val('');
            $('#schedDropCustomExt').val('txt');
            $('#schedDropCustomNewline').prop('checked', true);
            _schedDropTplHeaderTouched = false;
            applyDropCustomTemplateUI();
            $('#schedDropPassiveMode').prop('checked', true);
            $('#schedDropUseFtps').prop('checked', false);
            $('#schedDropS3Bucket, #schedDropS3AccessKey, #schedDropS3SecretKey, #schedDropS3Endpoint').val('');
            $('#schedDropS3Region').val('us-east-1');
            $('#schedDropPasswordNotice, #schedDropS3AccessKeyNotice, #schedDropS3SecretKeyNotice').hide();

            // Reset DB_DUMP options to defaults - leave schema blank so the server
            // resolves it to the current Oracle user at save time (v1 behavior).
            $('#schedDbDumpSchema').val('');
            $('#schedDbDumpSchemaDisplay').text('(your schema)');
            $('#schedDbDumpTable').val('');
            $('#schedDbDumpCollisionBox').hide();
            $('#schedDbDumpCollisionDetail').text('');
            $('#schedDbDumpOverride').prop('checked', false);
            $('#schedDbDumpOverrideReasonRow').hide();
            $('#schedDbDumpOverrideReason').val('');
            // Options card defaults. Empty the column list so the next render
            // (applyTaskTypeUI → populateDbDumpColumnSelector when DB_DUMP is
            // selected) re-applies the default checked set: report-shown columns
            // checked, report-hidden ones italic + unchecked. Row-limit controls
            // are (re)applied by initDbDumpRowLimitDefault when DB_DUMP is picked,
            // but reset them here too so no stale value lingers.
            $('#schedDbDumpColumnSelector').empty();
            $('#schedDbDumpColumnDrift').hide().empty(); // no saved list on a new task
            // Default ON for NEW tasks (2026-08-26). A DB dump writes a DATA
            // table for SQL consumers, and query.php's display layer wraps
