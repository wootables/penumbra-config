            const expr = parseExpression();
            if (expr && expr.value && expr.value.trim() !== '') {
                queryTree.push(expr);
            }
            if (i < tokens.length && (tokens[i].toLowerCase() === 'and' || tokens[i].toLowerCase() === 'or')) {
                queryTree.push({
                    type: 'logical',
                    op: tokens[i].toLowerCase()
                });
                i++;
            } else if (i < tokens.length && queryTree.length > 0 && queryTree[queryTree.length - 1].type !== 'logical') {
                // FIX: Implicit AND - when two conditions are adjacent with no
                // explicit AND/OR keyword, default to AND logic. This makes
                // "apple banana" behave as "apple AND banana" (match both terms).
                queryTree.push({ type: 'logical', op: 'and' });
            }
        }
        return queryTree;
    }

    /**
     * Helper to resolve dynamic keywords like SYSDATE() or me().
     * Supports offsets like SYSDATE()-7 and user attributes like me(unityid) or me(lname).
     */
    function resolveDynamicValues(val) {
        if (!val || typeof val !== 'string')
            return val;

        let processed = val;

        // 1. Resolve me() functions (Case-insensitive global replace)
        if (/me\(/i.test(processed)) {
            // \b so 'me(' cannot match inside longer words - a prompt default
            // like 'RESUME(email)' was being partially substituted. The PHP
            // twin (schedule_runner prompt block) has the same guard.
            processed = processed.replace(/\bme\(([^)]*)\)/gi, (match, arg) => {
                let rawKey = arg.trim();
                let key = rawKey.toLowerCase();

                // Default to 'fname' if empty parens: me()
                if (!key)
                    key = 'fname';

                if (typeof penumbra_vars !== 'undefined' && penumbra_vars.shibboleth) {

                    // A. Check Common Aliases
                    if (key === 'unity' || key === 'unityid')
                        return penumbra_vars.shibboleth.unityid || '';
                    if (key === 'emplid')
                        return penumbra_vars.shibboleth.emplid || '';
                    // Last 4 of the employee ID - the disambiguating suffix an
                    // autofill label like "Lastname, Firstname (1234)" carries, so a
                    // forcedefault can produce the SAME string the autocomplete does.
                    // Derived, never stored, so it cannot disagree with me(emplid).
                    if (key === 'emplid4')
                        return String(penumbra_vars.shibboleth.emplid || '').slice(-4);
                    if (key === 'ouc')
                        return penumbra_vars.shibboleth.ouc || '';
                    if (key === 'ouc2d')
                        return (penumbra_vars.shibboleth.ouc || '').substring(0, 2);
                    if (key === 'ouc4d')
                        return (penumbra_vars.shibboleth.ouc || '').substring(0, 4);
                    if (key === 'ouc6d')
                        return penumbra_vars.shibboleth.ouc || '';
                    if (key === 'dept' || key === 'department')
                        return penumbra_vars.shibboleth.dept || penumbra_vars.shibboleth.department || '';
                    if (key === 'email')
                        return penumbra_vars.shibboleth.email || '';

                    // B. Direct/Exact Match
                    if (penumbra_vars.shibboleth[rawKey] !== undefined) {
                        return penumbra_vars.shibboleth[rawKey];
                    }
                    if (penumbra_vars.shibboleth[key] !== undefined) {
                        return penumbra_vars.shibboleth[key];
                    }

                    // C. Case-Insensitive Search (Ensures ALL variables resolve)
                    const shibKeys = Object.keys(penumbra_vars.shibboleth);
                    const matchingKey = shibKeys.find(k => k.toLowerCase() === key);
                    if (matchingKey) {
                        return penumbra_vars.shibboleth[matchingKey];
                    }
                }
                return match;
                // Return original string if not resolved
            }
            );
        }

        // 2-3. Dates. Split out so the SEARCH engine can reach the same
        // vocabulary without also substituting me() - see resolveDynamicDate.
        return resolveDynamicDate(processed);
    }

    /**
     * Resolves a relative DATE expression to a concrete `DD-MMM-YY` string (or,
     * for a bare fiscal-year reference, the FY number). Returns the input
     * unchanged when it is not a relative date expression.
     *
     * Extracted from resolveDynamicValues 2026-08-30 so table search can resolve
     * dates too. Deliberately does NOT do me() substitution: a search is
     * evaluated for whoever is looking at it (and, in a scheduled task, for
     * whoever the runner happens to be), so silently binding a query to an
     * identity is a different feature with different semantics. Prompt defaults
     * still get both, via resolveDynamicValues.
     *
     * PHP twin: _sr_resolve_relative_date() in schedule_runner.php - keep the
     * grammars in step or a scheduled email filters differently from the screen.
     */
    /**
     * The keyword date form ONLY: TODAY / NOW / SYSDATE, optional (), optional
     * +/- N days. Returns `DD-MMM-YY` or null.
     *
     * Split out from resolveDynamicDate 2026-08-31 so SEARCH can take this form
     * and nothing else. It is one whitespace-free token, so the search bar's
     * tokenizer cannot break it - which is exactly what disqualified the English
     * phrases (see resolveRelativeSearchDate).
     */
    function resolveKeywordDate(raw) {
        if (!raw || typeof raw !== 'string') return null;
        const match = raw.toUpperCase().trim().match(/^(?:SYSDATE|NOW|TODAY)(?:\(\))?(\s*[+-]\s*\d+)?$/);
        if (!match) return null;
        const m = moment();
        if (match[1]) {
            m.add(parseInt(match[1].replace(/\s/g, ''), 10), 'days');
        }
        // The standard Penumbra/Oracle format
        return m.format('DD-MMM-YY').toUpperCase();
    }

    function resolveDynamicDate(processed) {
        if (!processed || typeof processed !== 'string') return processed;

        // 2. Resolve Dates (SYSDATE, NOW, TODAY)
        const kw = resolveKeywordDate(processed);
        if (kw) return kw;

        // 3. Natural Language Date Phrases
        // Mirrors PHP strtotime() for the most common patterns so that
        // forcedefault="first day of last month" resolves to a real date.
        const lower = processed.toLowerCase().trim();

        // Fiscal year (NC State: FY runs Jul 1 -> Jun 30, labeled by the calendar
        // year it ENDS). Grammar: optional "first|last day of" + a FY reference
        // ("this|last|next fiscal year", "N fiscal years ago|from now|ahead", or
        // bare "fiscal year" = this). With a "... day of" prefix it returns the
        // start (01-JUL-YY) or end (30-JUN-YY) date; without one it returns just
        // the fiscal-year NUMBER (e.g. 2025). Checked before the generic "year"
        // rule below since that pattern only matches "last|this|next year".
        var fyMatch = lower.match(/^(?:(first|last)\s+day\s+of\s+)?(?:(this|last|next)\s+|(\d+)\s+)?fiscal\s+years?(?:\s+(ago|from\s+now|ahead))?$/);
        if (fyMatch) {
            var FY_START_MONTH = 7; // July (1-12)
            var nowFy = moment();
            // The calendar year in which the CURRENT fiscal year began.
            var curFYStartYear = (nowFy.month() + 1) >= FY_START_MONTH ? nowFy.year() : nowFy.year() - 1;
            var fyRel = 0;
            if (fyMatch[2]) {
                fyRel = fyMatch[2] === 'last' ? -1 : (fyMatch[2] === 'next' ? 1 : 0);
            } else if (fyMatch[3]) {
                var fyN = parseInt(fyMatch[3], 10);
                // "N fiscal years" with no direction defaults to "ago" (past).
                fyRel = (fyMatch[4] && fyMatch[4] !== 'ago') ? fyN : -fyN;
            }
            var fyStartYear = curFYStartYear + fyRel;
            if (fyMatch[1] === 'first') {
                return moment({ year: fyStartYear, month: FY_START_MONTH - 1, day: 1 }).format('DD-MMM-YY').toUpperCase();
            } else if (fyMatch[1] === 'last') {
                // Last day = the day before the NEXT fiscal year starts (e.g. 30-JUN).
                return moment({ year: fyStartYear + 1, month: FY_START_MONTH - 1, day: 1 }).subtract(1, 'day').format('DD-MMM-YY').toUpperCase();
            }
            // No "... day of" prefix -> the fiscal-year number (ending-year convention).
            return String(fyStartYear + 1);
        }

        // "yesterday" / "tomorrow"
        if (lower === 'yesterday') return moment().subtract(1, 'day').format('DD-MMM-YY').toUpperCase();
        if (lower === 'tomorrow') return moment().add(1, 'day').format('DD-MMM-YY').toUpperCase();

        // "first/last day of [last|this|next] [month|year|quarter]"
        var natMatch = lower.match(/^(first|last)\s+day\s+of\s+(last|this|next)\s+(month|year|quarter)$/);
        if (natMatch) {
            var m2 = moment();
            var rel = natMatch[2], unit = natMatch[3];
            if (rel === 'last') m2 = m2.subtract(1, unit === 'quarter' ? 'quarter' : unit);
            else if (rel === 'next') m2 = m2.add(1, unit === 'quarter' ? 'quarter' : unit);
            m2 = natMatch[1] === 'first' ? m2.startOf(unit === 'quarter' ? 'quarter' : unit) : m2.endOf(unit === 'quarter' ? 'quarter' : unit);
            return m2.format('DD-MMM-YY').toUpperCase();
        }

        // "N days/weeks/months/years ago [from today/now]"
        natMatch = lower.match(/^(\d+)\s+(days?|weeks?|months?|years?)\s+ago(?:\s+from\s+(?:today|now))?$/);
        if (natMatch) {
            return moment().subtract(parseInt(natMatch[1], 10), natMatch[2].replace(/s$/, '')).format('DD-MMM-YY').toUpperCase();
        }

        // "N days/weeks/months/years from now/today/ahead"
        natMatch = lower.match(/^(\d+)\s+(days?|weeks?|months?|years?)\s+(?:from\s+(?:now|today)|ahead)$/);
        if (natMatch) {
            return moment().add(parseInt(natMatch[1], 10), natMatch[2].replace(/s$/, '')).format('DD-MMM-YY').toUpperCase();
        }

        // "last/next [weekday]"
        var weekdays = {sunday:0, monday:1, tuesday:2, wednesday:3, thursday:4, friday:5, saturday:6};
        natMatch = lower.match(/^(last|next)\s+(sunday|monday|tuesday|wednesday|thursday|friday|saturday)$/);
        if (natMatch) {
            var m3 = moment();
            var targetDay = weekdays[natMatch[2]];
            if (natMatch[1] === 'last') {
                m3 = m3.subtract(1, 'week').day(targetDay);
            } else {
                m3 = m3.add(1, 'week').day(targetDay);
            }
            return m3.format('DD-MMM-YY').toUpperCase();
        }

        return processed;
    }

    // =====================================================================
    // DATE-RANGE PROMPTS  ([PROMPT;type=date-range;...])
    // =====================================================================
    // ONE prompt, TWO dates. The answer is stored as a single raw string
    // "<from>..<to>"; each half is anything a type=date prompt accepts - a
    // literal date, TODAY-30, "first day of last month", or min/max when the
    // prompt has an autofill= source. One string means localStorage, URL
    // parameters, the scheduler's prompt_answers and audit/restore carry it
    // with no new plumbing. RAW means a rolling window keeps rolling: the
    // halves are resolved when the report RUNS, never when the answer was
    // given - so nothing here can repeat the frozen-default bug of 08-31.
    //
    // SQL. The author writes the operator, the engine supplies two binds:
    //     col BETWEEN [PROMPT;type=date-range;...]     ->  col BETWEEN :p1 AND :p2
    //     template="AND col >= :from AND col <= :to"   ->  explicit placement
    //     (:val inside a template is the bare ":p1 AND :p2" pair)
    // Dialect never enters into it: BETWEEN is ANSI, and query.php formats
    // every bind per connection (resolveParamDateExpression).
    //
    // Both ends are REQUIRED and From must not be after To. BETWEEN with
    // reversed bounds is not an error in either database - it is zero rows,
    // silently - so all three engines refuse it out loud instead.
    //
    // SERVER TWINS: penumbraDateRange*() in shared_logic.php, used by
    // index.php (?json=1) and schedule_runner.php - keep the three in step.
    var PNB_DATE_RANGE_SEP = '..';

    function penumbraIsDateRangeType(type) {
        return String(type === null || type === undefined ? '' : type).trim().toLowerCase() === 'date-range';
    }

    /**
     * Splits a raw "<from>..<to>" answer into its two halves.
     * Returns { fromRaw, toRaw }, or null unless there are exactly two
     * non-empty halves.
     */
    function penumbraSplitDateRange(raw) {
        if (raw === null || raw === undefined || Array.isArray(raw) || typeof raw === 'object') return null;
        var s = String(raw);
        var i = s.indexOf(PNB_DATE_RANGE_SEP);
        if (i < 0) return null;
        var a = s.substring(0, i).trim();
        var b = s.substring(i + PNB_DATE_RANGE_SEP.length).trim();
        if (a === '' || b === '' || b.indexOf(PNB_DATE_RANGE_SEP) >= 0) return null;
        return { fromRaw: a, toRaw: b };
    }

    function penumbraJoinDateRange(fromRaw, toRaw) {
        return String(fromRaw).trim() + PNB_DATE_RANGE_SEP + String(toRaw).trim();
    }

    /** Is either half of this raw answer the min / max keyword? */
    function penumbraRangeHasKeywordEnd(raw) {
        var parts = penumbraSplitDateRange(raw);
        return !!parts && (_isRangeKeyword(parts.fromRaw) || _isRangeKeyword(parts.toRaw));
    }

    /**
     * Parses ONE already-resolved range end into a moment, or null.
     *
     * Two-digit years follow Oracle's RR window (50-99 -> 19xx, 00-49 -> 20xx),
     * NOT moment's 68/69 pivot: the literal this engine emits is read back by
     * the database, so the ordering check has to agree with what the database
     * will do. A value carrying a time is refused - this type is dates only.
     */
    function penumbraParseRangeEnd(str) {
        var s = String(str === null || str === undefined ? '' : str).trim();
        if (s === '') return null;
        var MON = { JAN: 0, FEB: 1, MAR: 2, APR: 3, MAY: 4, JUN: 5, JUL: 6, AUG: 7, SEP: 8, OCT: 9, NOV: 10, DEC: 11 };
        var m, y, mo, d;
        if ((m = s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{2}|\d{4})$/))) {
            mo = MON[m[2].toUpperCase()];
            if (mo === undefined) return null;
            d = parseInt(m[1], 10);
            y = parseInt(m[3], 10);
            if (m[3].length === 2) y += (y >= 50 ? 1900 : 2000);
        } else if ((m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/))) {
            y = parseInt(m[1], 10);
            mo = parseInt(m[2], 10) - 1;
            d = parseInt(m[3], 10);
        } else if ((m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})$/))) {
            mo = parseInt(m[1], 10) - 1;
            d = parseInt(m[2], 10);
            y = parseInt(m[3], 10);
            if (m[3].length === 2) y += (y >= 50 ? 1900 : 2000);
        } else {
            return null;
        }
        if (mo < 0 || mo > 11 || d < 1) return null;
        var out = moment({ year: y, month: mo, day: d });
        // moment rolls an impossible day forward in object form on some
        // versions; insist the parts came back unchanged.
        return (out.isValid() && out.date() === d && out.month() === mo && out.year() === y) ? out : null;
    }

    /**
     * Formats a moment as the DD-MON-YY literal the SQL receives. A year outside
     * the RR window keeps all four digits so it cannot be re-read into the wrong
     * century (both databases accept either width).
     */
    function penumbraFormatRangeEnd(m) {
        var MONS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
        var y = m.year();
        var dd = (m.date() < 10 ? '0' : '') + m.date();
        var yy = (y >= 1950 && y <= 2049) ? ((y % 100 < 10 ? '0' : '') + (y % 100)) : String(y);
        return dd + '-' + MONS[m.month()] + '-' + yy;
    }

    /**
     * The date a min / max keyword stands for. Bounds are stamped on the config
     * by resolvePromptDateRange() (an awaited lookup); without them - no
     * autofill=, or a lookup that could not run - the range WIDENS to
     * 01-JAN-70 / today, never empties. Same fallback the single-date keywords use.
     */
    function penumbraRangeKeywordDate(kw, config) {
        var isMin = /min/i.test(kw);
        var iso = config ? (isMin ? config._rangeMinIso : config._rangeMaxIso) : null;
        if (iso) {
            var m = moment(iso, 'YYYY-MM-DD', true);
            if (m.isValid()) return penumbraFormatRangeEnd(m);
        }
        return isMin ? '01-JAN-70' : penumbraFormatRangeEnd(moment());
    }

    /**
     * Resolves ONE raw half to a moment (or null): keyword -> date, then the
     * shared relative-date grammar, then a strict parse.
     */
    function penumbraResolveRangeEnd(endRaw, config) {
        var v = String(endRaw === null || endRaw === undefined ? '' : endRaw).trim();
        if (v === '') return null;
        if (_isRangeKeyword(v)) v = penumbraRangeKeywordDate(v, config);
        return penumbraParseRangeEnd(resolveDynamicValues(v));
    }

    /**
     * Resolves a raw "<from>..<to>" answer to two concrete dates.
     *
     * Returns { from, to, fromM, toM, fromRaw, toRaw } - from/to are the
     * DD-MON-YY literals the SQL receives - or { error: '<message>' }.
     *
     * An author's validate=min_date()/max_date() rule is applied to BOTH ends.
     * The bounds resolvePromptDateRange() INJECTS from an autofill= lookup are
     * not: they exist to fence a single date inside the data, and a range that
     * merely overhangs the data ("Last 30 days" past the newest row) is a
     * perfectly good filter.
     */
    function penumbraResolveDateRange(raw, config) {
        var parts = penumbraSplitDateRange(raw);
        // `end` says which half an error is about (0 From, 1 To) so the dialog
        // can mark and focus the right field.
        if (!parts) return { error: 'A date range needs both a From and a To date.', end: 0 };
        var ends = [parts.fromRaw, parts.toRaw];
        var ms = [];
        for (var i = 0; i < 2; i++) {
            var m = penumbraResolveRangeEnd(ends[i], config);
            if (!m) return { error: "'" + ends[i] + "' is not a date. Use a date such as 01-JUL-26, or an expression such as TODAY-30 or first day of last month.", end: i };
            ms.push(m);
        }
        if (ms[0].isAfter(ms[1], 'day')) return { error: 'The From date must be on or before the To date.', end: 1 };
        var out = {
            from: penumbraFormatRangeEnd(ms[0]), to: penumbraFormatRangeEnd(ms[1]),
            fromM: ms[0], toM: ms[1], fromRaw: parts.fromRaw, toRaw: parts.toRaw
        };
        if (config && config.validate && !config._validateInjected) {
            var e1 = validatePromptInput(out.from, config);
            if (e1) return { error: e1, end: 0 };
            var e2 = validatePromptInput(out.to, config);
            if (e2) return { error: e2, end: 1 };
        }
        return out;
    }

    /**
     * Builds the SQL a date-range prompt is replaced with. fromTok / toTok are
     * bind markers in secure mode and display text in snippet mode.
     */
    function penumbraApplyDateRangeTemplate(template, fromTok, toTok, pairText) {
        var pair = (pairText !== undefined && pairText !== null) ? pairText : (fromTok + ' AND ' + toTok);
        if (template === null || template === undefined) return pair;
        // Function form: a plain replacement string would give `$&` inside a
        // value a meaning (same reason applyTemplate uses one).
        return template.replace(/:(from|to|val)\b/g, function (m0, which) {
            return which === 'from' ? fromTok : (which === 'to' ? toTok : pair);
        });
    }

    /**
     * The quick ranges the dialog offers. FIXED and built in on purpose - no
     * presets= parameter. Each one is just a PAIR OF EXPRESSIONS the relative
     * date grammar already understands (no new vocabulary, and the two server
     * engines resolve them identically), so picking one stores a rolling range,
     * not a pair of dates frozen on the day it was picked.
     * `needsSource` entries appear only when the prompt has an autofill= source.
     */
    function penumbraDateRangePresets() {
        return [
            { label: 'Last 7 days',         from: 'TODAY-7',  to: 'TODAY' },
            { label: 'Last 30 days',        from: 'TODAY-30', to: 'TODAY' },
            { label: 'This month',          from: 'first day of this month',        to: 'last day of this month' },
            { label: 'Last month',          from: 'first day of last month',        to: 'last day of last month' },
            { label: 'This quarter',        from: 'first day of this quarter',      to: 'last day of this quarter' },
            { label: 'Last quarter',        from: 'first day of last quarter',      to: 'last day of last quarter' },
            { label: 'This fiscal year',    from: 'first day of this fiscal year',  to: 'last day of this fiscal year' },
            { label: 'Last fiscal year',    from: 'first day of last fiscal year',  to: 'last day of last fiscal year' },
            { label: 'Fiscal year to date', from: 'first day of this fiscal year',  to: 'TODAY' },
            { label: 'This calendar year',  from: 'first day of this year',         to: 'last day of this year' },
            { label: 'Last calendar year',  from: 'first day of last year',         to: 'last day of last year' },
            { label: 'All dates',           from: 'min', to: 'max', needsSource: true }
        ];
    }

    /** The preset a raw answer IS, or null. Case and spacing do not matter. */
    function penumbraDateRangePresetFor(raw) {
        var parts = penumbraSplitDateRange(raw);
        if (!parts) return null;
        var norm = function (s) { return String(s).trim().replace(/\s+/g, ' ').toLowerCase(); };
        var f = norm(parts.fromRaw), t = norm(parts.toRaw);
        var all = penumbraDateRangePresets();
        for (var i = 0; i < all.length; i++) {
            if (norm(all[i].from) === f && norm(all[i].to) === t) return all[i];
        }
        return null;
    }

    /**
     * How a stored answer reads on a chip or in a scheduler field: the preset's
     * name when it is one, otherwise "<from> to <to>" AS WRITTEN. Never the
     * resolved dates - a label saved today must still be true next month.
     */
    function penumbraDateRangeLabel(raw) {
        var parts = penumbraSplitDateRange(raw);
        if (!parts) return String(raw === null || raw === undefined ? '' : raw);
        var preset = penumbraDateRangePresetFor(raw);
        return preset ? preset.label : (parts.fromRaw + ' to ' + parts.toRaw);
    }

    /**
     * The concrete dates a stored answer stands for RIGHT NOW, as "A to B", or
     * '' when that cannot be known synchronously (a min/max end needs a lookup)
     * or the answer does not resolve.
     */
    function penumbraDateRangeResolvedText(raw, config) {
        if (penumbraRangeHasKeywordEnd(raw) && !(config && config._rangeMinIso && config._rangeMaxIso)) return '';
        var rr = penumbraResolveDateRange(raw, config ? Object.assign({}, config, { validate: null }) : null);
        return rr.error ? '' : (rr.from + ' to ' + rr.to);
    }

    /**
     * A date-range prompt's default AS THE AUTHOR WROTE IT - never parsePrompt's
     * resolved copy. For a well-formed "<from>..<to>" the two are the same text
     * (no single-date grammar matches a pair), but a default written for a
     * single date ("TODAY-30", no "..") IS resolved by parsePrompt, and the
     * fields and storage of this type hold expressions, not today's date. Also
     * reads a bare `forcedefault` flag the way the scheduler does: its text
     * lives in default=.
     */
    function penumbraDateRangeRawDefault(config) {
        if (!config) return '';
        var forced = (config.forcedefault !== null && config.forcedefault !== undefined && config.forcedefault !== true);
        var raw = forced
            ? ((config.forcedefaultRaw !== null && config.forcedefaultRaw !== undefined) ? config.forcedefaultRaw : config.forcedefault)
            : ((config.defaultRaw !== null && config.defaultRaw !== undefined) ? config.defaultRaw : config.default);
        return (raw === null || raw === undefined) ? '' : String(raw);
    }

    // =====================================================================
    // RELATIVE DATES IN SEARCH
    // =====================================================================
    // Before 2026-08-30 `LOG_DATE > TODAY-30` matched NOTHING: resolveDynamicValues
    // was only ever wired to prompt default/forcedefault, so search compared the
    // literal text "TODAY-30" against a date and fell through to a text compare.
    // There was no rolling-window filter anywhere in the app - and the date picker
    // in the Visual Search Builder pins an ABSOLUTE date, which is exactly wrong
    // for a scheduled task that re-runs every week.

    // SEARCH TAKES THE KEYWORD FORM ONLY - no English phrases. Rolled back
    // 2026-08-31 after they proved to be a silent-zero trap in the search bar:
    // the bar tokenizes on whitespace, so `LOG_DATE >= first day of this month`
    // shattered into a value of "first" plus four stray terms and returned 0
    // with no warning. Quoting fixed it, but requiring quotes to avoid silently
    // wrong results is the same failure this work set out to remove. The
    // keyword form has no such trap: TODAY-30 is one token and cannot shatter.
    // resolveDynamicDate keeps the full English grammar for prompt defaults,
    // where the value is a whole field and never goes through the tokenizer.
    const _REL_DATE_HINT = /^(?:sysdate|now|today)/i;

    let _relDateCache = Object.create(null);
    let _relDateCacheDay = '';

    /**
     * Resolves a relative date expression for the SEARCH side, memoized.
     * Returns null when the text is not a relative date.
     *
     * The cache is keyed on the raw text and dropped when the calendar day rolls
     * over, so a dashboard left open overnight starts answering with the new
     * "today" instead of yesterday's cached answer.
     */
    function resolveRelativeSearchDate(raw) {
        const s = String(raw).trim();
        if (!_REL_DATE_HINT.test(s)) return null;

        const day = new Date().toDateString();
        if (day !== _relDateCacheDay) {
            _relDateCache = Object.create(null);
            _relDateCacheDay = day;
        }
        if (s in _relDateCache) return _relDateCache[s];

        // resolveKeywordDate, NOT resolveDynamicDate - search deliberately does
        // not get the English phrases.
        return (_relDateCache[s] = resolveKeywordDate(s));
    }

    /**
     * parseDate for a SEARCH value: a real date first, then a relative expression.
     *
     * Only ever applied to the search side, never to cell text - a cell that
     * literally reads "yesterday" is data, not an instruction. And because this
     * returns null for anything unrecognised, `NOTES = TODAY` on a non-date
     * column still falls through to the text comparison with the original text
     * intact, matching the literal word.
     */
    function parseSearchDate(v) {
        const direct = parseDate(v);
        if (direct) return direct;
        const rel = resolveRelativeSearchDate(v);
        return rel ? parseDate(rel) : null;
    }

    /**
     * Parses prompt syntax and returns structured data.
     * This parser is robust and handles semicolons within parameter values.
     * @param {string} promptString - The full prompt string including brackets
     * @returns {object} Parsed prompt data
     */
    function parsePrompt(promptString) {
        // Remove the brackets [PROMPT;...] using Regex to handle variable whitespace/newlines
        const content = promptString.replace(/^\[\s*PROMPT\s*;?/i, '').replace(/\]$/, '');

        const result = {
            type: null,
            title: null,
            label: null,
            message: null,
            default: null,
            forcedefault: null,
            // Pre-resolution text of default/forcedefault (e.g. "first day of
            // last month"), kept alongside the resolved value purely so UI can
            // show the author's dynamic expression. Never used for resolution.
            defaultRaw: null,
            forcedefaultRaw: null,
            // logic=and / logic=or, lower-cased; null = not given, which is NOT the
            // same as or: after != / <> / NOT LIKE a multi-select joins with AND
            // unless the author said logic=or (processPrompts' connector).
            logic: null,
            // options[] is the flat union of optionsBefore + optionsAfter (kept for
            // backwards-compat with noquote validation, builder roundtrip, etc.).
            // optionsBefore/optionsAfter preserve token order relative to autofill=
            // so rendering can interleave special entries (e.g. "None":"IS NULL")
            // around DB-autofilled rows.
            options: [],
            optionsBefore: [],
            optionsAfter: [],
            validate: null,
            verrormessage: null,
            min: null,
            max: null,
            noquote: false,
            nosave: false,
            hidden: false,
            // okonly: boolean-prompt-only flag - hides the Cancel button so the
            // dialog acts as an attestation / acknowledgement ("I Understand").
            okonly: false,
            // share: when true, the user's answer is saved to a globally-scoped
            // localStorage key (the legacy `penumbra_prompt_<hash>` format), so
            // any other report containing an identical prompt tag picks it up.
            // When false (default), answers scope to the current report's id so
            // unrelated reports don't accidentally cross-contaminate state.
            share: false,
            yesOption: null,
            noOption: null,
            name: null,
            style: null,
            autofill: null,
            resultif: null,
            template: null,
            // section: DISPLAY ONLY - which review button the prompt's chip sits
            // under in the answered-prompts bar (promptSectionMap). Never part of
            // the answer key (getPromptStorageKey) and never read by an SQL engine.
            section: null
        };

        // Tracks whether autofill= has been encountered yet in the token stream.
        // Each options= group is routed to optionsBefore or optionsAfter based on
        // this flag at the moment the group is parsed.
        let seenAutofill = false;

        // This regex finds all parameter blocks.
        const paramRegex = /([a-zA-Z0-9_-]+)=([^;]*(?:;(?!\s*[a-zA-Z0-9_-]+=|\s*\bhidden\b|\s*\bnoquote\b|\s*\bforcedefault\b|\s*\bnosave\b|\s*\bokonly\b|\s*\bshare\b)[^;]*)*)/g;

        let match;
        while ((match = paramRegex.exec(content)) !== null) {
            const key = match[1].trim().toLowerCase();
            const value = match[2];

            switch (key) {
                case 'type':
                    result.type = value;
                    break;
                case 'title':
                    result.title = value;
                    break;
                case 'label':
                    result.label = value;
                    break;
                case 'message':
                    result.message = value;
                    break;
                case 'default':
                    // --- UPDATE: Resolve dynamic dates here ---
                    result.defaultRaw = value;
                    result.default = resolveDynamicValues(value);
                    break;
                case 'forcedefault':
                    // --- UPDATE: Resolve dynamic dates here ---
                    result.forcedefaultRaw = value;
                    result.forcedefault = resolveDynamicValues(value);
                    break;
                case 'logic':
                    // Case and spaces as the PHP engines read it: logic=AND used to
                    // join with OR here and with AND in a scheduled run.
                    result.logic = value.trim().toLowerCase() || null;
                    break;
                case 'validate':
                    result.validate = value;
                    break;
                case 'verrormessage':
                    result.verrormessage = value;
                    break;
                case 'name':
                    result.name = value;
                    break;
                case 'style':
                    result.style = value;
                    break;
                case 'section':
                    // An id, compared without case (promptSectionKey); '' = none.
                    result.section = value.trim() || null;
                    break;
                case 'template':
                    let tVal = value.trim();
                    if ((tVal.startsWith('"') && tVal.endsWith('"')) || (tVal.startsWith("'") && tVal.endsWith("'"))) {
                        tVal = tVal.substring(1, tVal.length - 1);
                    }
                    result.template = tVal;
                    break;
                case 'resultif':
                    const parts = value.split(':');
                    if (parts.length >= 2) {
                        result.resultif = {
                            parentName: parts[0].trim(),
                            expectedValue: parts.slice(1).join(':').trim()
                        };
                    }
                    break;
                case 'min':
                    result.min = parseInt(value, 10);
                    break;
                case 'max':
                    result.max = parseInt(value, 10);
                    break;
                case 'yes':
                    {
                        // First-colon split so colons inside the value survive
                        // (e.g. yes=Save by 5:30 PM:Y → display="Save by 5:30 PM", value="Y").
                        // Mirrors the options= parser's first-colon convention.
                        const yIdx = value.indexOf(':');
                        result.yesOption = yIdx > -1
                            ? { display: value.substring(0, yIdx), value: value.substring(yIdx + 1) }
                            : { display: value, value: value };
                        break;
                    }
                case 'no':
                    {
                        const nIdx = value.indexOf(':');
                        result.noOption = nIdx > -1
                            ? { display: value.substring(0, nIdx), value: value.substring(nIdx + 1) }
                            : { display: value, value: value };
                        break;
                    }
                case 'autofill':
                    {
                        // Mark that subsequent options= groups belong after the
                        // autofill rows. Token order in the prompt drives layout.
                        seenAutofill = true;
                        // First-pipe split so pipes inside the WHERE condition
                        // (regex alternation, IN lists with embedded pipes, etc.)
                        // survive intact. Old code did value.split('|') and only
                        // kept [0] and [1] - dropping anything after the second pipe.
                        const pipeIdx = value.indexOf('|');
                        const mainPart = pipeIdx > -1 ? value.substring(0, pipeIdx) : value;
                        const condition = pipeIdx > -1 ? value.substring(pipeIdx + 1) : null;

                        // FIX: Allow dots in the table name group (first group) to support schemas
                        // e.g., INFORMATION_SCHEMA.COLUMNS (Table) . COLUMN_NAME (Column)
                        const displayValueMatch = mainPart.match(/^([a-zA-Z0-9_.]+)\.([a-zA-Z0-9_]+):([a-zA-Z0-9_]+)$/);
                        const singleColumnMatch = mainPart.match(/^([a-zA-Z0-9_.]+)\.([a-zA-Z0-9_]+)$/);

                        if (displayValueMatch) {
                            result.autofill = {
                                table: displayValueMatch[1],
                                column: displayValueMatch[2],
                                valueColumn: displayValueMatch[3],
                                condition: condition
                            };
                        } else if (singleColumnMatch) {
                            result.autofill = {
                                table: singleColumnMatch[1],
                                column: singleColumnMatch[2],
                                valueColumn: null,
                                condition: condition
                            };
                        } else if (mainPart.indexOf('(') > 0) {
                            // Expression mode: e.g. faculty.CONCAT(lname, ', ', fname):unique_id
                            // Find the last dot BEFORE the first parenthesis - that separates table from expression
                            const firstParen = mainPart.indexOf('(');
                            const beforeParen = mainPart.substring(0, firstParen);
                            const lastDot = beforeParen.lastIndexOf('.');

                            if (lastDot > 0) {
                                const table = mainPart.substring(0, lastDot);
                                const rest = mainPart.substring(lastDot + 1);

                                // Find valueColumn: last colon NOT inside parentheses
                                let valueColumn = null;
                                let columnExpr = rest;
                                let parenDepth = 0;
                                let lastOuterColon = -1;

                                for (let i = 0; i < rest.length; i++) {
                                    if (rest[i] === '(') parenDepth++;
                                    else if (rest[i] === ')') parenDepth--;
                                    else if (rest[i] === ':' && parenDepth === 0) lastOuterColon = i;
                                }

                                if (lastOuterColon > 0) {
                                    const potentialValueCol = rest.substring(lastOuterColon + 1).trim();
                                    if (/^[a-zA-Z0-9_]+$/.test(potentialValueCol)) {
                                        valueColumn = potentialValueCol;
                                        columnExpr = rest.substring(0, lastOuterColon);
                                    }
                                }

                                if (/^[a-zA-Z0-9_.]+$/.test(table)) {
                                    result.autofill = {
                                        table: table,
                                        column: columnExpr.trim(),
                                        valueColumn: valueColumn,
                                        condition: condition,
                                        isExpression: true
                                    };
                                }
                            }
                        }
                        break;
                    }
                case 'options':
                    {
                        const optionParts = [];
                        let currentPart = '';
                        let inSingle = false;
                        let inDouble = false;

                        for (let i = 0; i < value.length; i++) {
                            const char = value[i];
                            if (char === "'" && !inDouble) {
                                inSingle = !inSingle;
                                currentPart += char;
                            } else if (char === '"' && !inSingle) {
                                inDouble = !inDouble;
                                currentPart += char;
                            } else if (char === ',' && !inSingle && !inDouble) {
                                optionParts.push(currentPart);
                                currentPart = '';
                            } else {
                                currentPart += char;
                            }
                        }
                        if (currentPart)
                            optionParts.push(currentPart);

                        optionParts.forEach(part => {
                            const trimmed = part.trim();
                            if (!trimmed)
                                return;

                            // First pass: scan for unquoted `::` (per-option template separator).
                            // If present, the entry is 3-segment: Display:Value::Template.
                            // The template part may itself contain `:val` placeholders, so we
                            // peel it off before scanning the rest for the Display:Value colon.
                            let mainPart = trimmed;
                            let perOptionTemplate = null;
                            {
                                let tInSingle = false;
                                let tInDouble = false;
                                for (let k = 0; k < trimmed.length - 1; k++) {
                                    const c = trimmed[k];
                                    if (c === "'" && !tInDouble)
                                        tInSingle = !tInSingle;
                                    else if (c === '"' && !tInSingle)
                                        tInDouble = !tInDouble;
                                    else if (c === ':' && trimmed[k + 1] === ':' && !tInSingle && !tInDouble) {
                                        mainPart = trimmed.substring(0, k).trim();
                                        let rawTpl = trimmed.substring(k + 2).trim();
                                        // Strip an optional surrounding quote pair (lets authors
                                        // protect leading/trailing whitespace or literal `::`).
                                        if ((rawTpl.startsWith('"') && rawTpl.endsWith('"')) ||
                                            (rawTpl.startsWith("'") && rawTpl.endsWith("'"))) {
                                            rawTpl = rawTpl.substring(1, rawTpl.length - 1);
                                        }
                                        perOptionTemplate = rawTpl;
                                        break;
                                    }
                                }
                            }

                            // Second pass: split mainPart on the first unquoted `:` to get
                            // Display vs Value (existing 2-segment behavior).
                            let colonIndex = -1;
                            let pInSingle = false;
                            let pInDouble = false;

                            for (let j = 0; j < mainPart.length; j++) {
                                const c = mainPart[j];
                                if (c === "'" && !pInDouble)
                                    pInSingle = !pInSingle;
                                else if (c === '"' && !pInSingle)
                                    pInDouble = !pInDouble;
                                else if (c === ':' && !pInSingle && !pInDouble) {
                                    colonIndex = j;
                                    break;
                                }
                            }

                            let optEntry;
                            if (colonIndex > 0) {
                                const display = mainPart.substring(0, colonIndex).trim();
                                let optValue = mainPart.substring(colonIndex + 1).trim();
                                if ((optValue.startsWith("'") && optValue.endsWith("'")) || (optValue.startsWith('"') && optValue.endsWith('"'))) {
                                    optValue = optValue.substring(1, optValue.length - 1);
                                }
                                optEntry = { display: display, value: optValue, template: perOptionTemplate };
                            } else {
                                let optValue = mainPart;
                                if ((optValue.startsWith("'") && optValue.endsWith("'")) || (optValue.startsWith('"') && optValue.endsWith('"'))) {
                                    optValue = optValue.substring(1, optValue.length - 1);
                                }
                                optEntry = { display: optValue, value: optValue, template: perOptionTemplate };
                            }
                            result.options.push(optEntry);
                            if (seenAutofill) {
                                result.optionsAfter.push(optEntry);
                            } else {
                                result.optionsBefore.push(optEntry);
                            }
                        }
                        );
                        break;
                    }
            }
        }

        const valuelessRegex = /;?\s*([a-zA-Z0-9_-]+)(?=(;|$))/g;
        let valuelessContent = content.replace(paramRegex, '');

        while ((match = valuelessRegex.exec(valuelessContent)) !== null) {
            const key = match[1].trim().toLowerCase();
            if (key === 'noquote')
                result.noquote = true;
            if (key === 'hidden')
                result.hidden = true;
            if (key === 'nosave')
                result.nosave = true;
            if (key === 'okonly')
                result.okonly = true;
            if (key === 'share')
                result.share = true;
            if (key === 'forcedefault') {
                if (result.forcedefault === null) {
                    result.forcedefault = true;
                }
            }
        }

        if (!result.type) {
            if (result.forcedefault === null && !result.hidden) {
                result.type = 'text';
            }
        }
        if (!result.message && result.type === 'text') {
            result.message = 'Please provide a value';
        }

        if (result.type === 'select' || result.type === 'multi-select') {
            if (!result.autofill && result.options.length === 0) {
                throw new Error('Select and Multi-Select prompts require at least one option or autofill to be defined.');
            }
        }

        return result;
    }

    /**
 * Helper to safely parse a multi-select string containing HTML entities.
 * Handles decoding commas (&#44;) and semicolons (&#59;) AFTER splitting.
 */
    function parseMultiSelectDefault(rawString) {
        if (!rawString)
            return [];

        // 1. Decode basic XML entities first to ensure clean splitting
        let preProcessed = String(rawString).replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#039;/g, "'");

        // 2. Split by comma
        return preProcessed.split(',').map(v => {
            let val = v.trim();
            // Remove surrounding quotes if present - matched pair ONLY, because a
            // legitimate option value can end in a quote (an inch mark: 4",6",8").
            val = stripWrappingQuotePair(val);

            // 3. Decode special separators (comma and semicolon) that were "hidden"
            return val.replace(/&#44;/g, ',').replace(/&#59;/g, ';');
        }
        );
    }

    /**
     * Split a validate= value into its top-level rules: commas separate rules
     * unless they sit inside parentheses (range(1,9999)) or inside a /regex/
     * literal (/^\d{3,5}$/). The Tag Generator joins a regex, a range() and
     * min_date()/max_date() with commas, so a single-rule reader rejected
     * every answer to such a prompt with "Invalid regex format".
     */
    function splitValidateRules(str) {
        const out = [];
        let cur = '', depth = 0, inRegex = false, esc = false;
        const s = String(str || '');
        for (let k = 0; k < s.length; k++) {
            const ch = s[k];
            if (inRegex) {
                cur += ch;
                if (esc) { esc = false; continue; }
                if (ch === '\\') { esc = true; continue; }
                if (ch === '/') inRegex = false;
                continue;
            }
            if (ch === '/' && cur.trim() === '') { inRegex = true; cur += ch; continue; }
            if (ch === '(') depth++;
            else if (ch === ')') depth = Math.max(0, depth - 1);
            if (ch === ',' && depth === 0) {
                if (cur.trim() !== '') out.push(cur.trim());
                cur = '';
                continue;
            }
            cur += ch;
        }
        if (cur.trim() !== '') out.push(cur.trim());
        return out;
    }

    /**
 * Validates a given value against prompt validation rules.
 * @param {string} inputValue - The value to test.
 * @param {object} promptConfig - The parsed prompt configuration object.
 * @returns {string|null} An error message if invalid, or null if valid.
 */
    function validatePromptInput(inputValue, promptConfig) {
        if (!promptConfig.validate) return null;
        // validate= may hold several comma-separated rules - every rule must
        // pass. Date bounds are checked together so the min-after-max sanity
        // check still sees both halves.
        const _vRules = splitValidateRules(promptConfig.validate);
        const _vIsDate = r => /^(min_date|max_date)\(/i.test(r);
        const _vDateRules = _vRules.filter(_vIsDate);
        const _vOtherRules = _vRules.filter(r => !_vIsDate(r));
        if (_vDateRules.length) {
            const dateErr = checkOneRule(_vDateRules.join(','));
            if (dateErr) return dateErr;
        }
        for (const _vr of _vOtherRules) {
            const ruleErr = checkOneRule(_vr);
            if (ruleErr) return ruleErr;
        }
        return null;

        function checkOneRule(validationRule) {

            // --- START: Date Validation Logic ---
            const minDateMatch = validationRule.match(/min_date\((.+?)\)/);
            const maxDateMatch = validationRule.match(/max_date\((.+?)\)/);

            // Check if either date rule exists
            if (minDateMatch || maxDateMatch) {
                // The datepicker writes DD-MMM-YY, but accept the same explicit
                // formats the server-side resolver understands (users may type
                // ISO or slash dates; natural phrases arrive pre-resolved).
                const inputDate = moment(inputValue, ['DD-MMM-YY', 'D-MMM-YY', 'DD-MMM-YYYY', 'YYYY-MM-DD', 'MM/DD/YYYY', 'M/D/YYYY', 'MM/DD/YY'], true);
                if (!inputDate.isValid()) {
                    return promptConfig.verrormessage || 'A valid date is required.';
                }

                // Relaxed formats for the prompt definition (allows 01-JAN-24 or 2024-01-01)
                const defFormats = ['YYYY-MM-DD', 'DD-MMM-YY', 'D-MMM-YY'];
                let minDate = null;
                let maxDate = null;

                if (minDateMatch) {
                    minDate = moment(minDateMatch[1], defFormats, false);
                    if (!minDate.isValid())
                        return "Invalid min_date format in prompt definition.";
                }
                if (maxDateMatch) {
                    maxDate = moment(maxDateMatch[1], defFormats, false);
                    if (!maxDate.isValid())
                        return "Invalid max_date format in prompt definition.";
                }

                // Sanity check: Ensure the prompt definition itself is logical
                if (minDate && maxDate && minDate.isAfter(maxDate)) {
                    return "Invalid prompt definition: min_date cannot be after max_date.";
                }

                // Validate User Input against Constraints
                if (minDate && inputDate.isBefore(minDate, 'day')) {
                    return promptConfig.verrormessage || `Date must be on or after ${minDate.format('DD-MMM-YY').toUpperCase()}.`;
                }
                if (maxDate && inputDate.isAfter(maxDate, 'day')) {
                    return promptConfig.verrormessage || `Date must be on or before ${maxDate.format('DD-MMM-YY').toUpperCase()}.`;
                }

                // If we passed all checks, the date is valid
                return null;
            }
            // --- END: Date Validation Logic ---

            const rangeMatch = validationRule.match(/^range\((\d+),(\d+)\)$/);

            if (rangeMatch) {
                const min = parseInt(rangeMatch[1], 10);
                const max = parseInt(rangeMatch[2], 10);
                const numValue = parseInt(inputValue, 10);

                // THIS IS THE FIX:
                // This regex ensures the *entire* string is composed of digits only.
                const isPureInteger = /^\d+$/.test(inputValue.trim());

                if (!isPureInteger || isNaN(numValue) || numValue < min || numValue > max) {
                    return promptConfig.verrormessage || `Input must be a number between ${min} and ${max}.`;
                }
            } else {
                const regexParts = validationRule.match(/^\/(.*?)\/([iI]?)$/);
                if (!regexParts) {
                    return "Invalid regex format in prompt definition.";
                }
                const regex = new RegExp(regexParts[1], regexParts[2] || '');
                if (!regex.test(inputValue)) {
                    return promptConfig.verrormessage || `Input does not match the required format.`;
                }
            }
            return null; // this rule passed
        }
    }

    /**
 * Sanitizes a raw CSS string to allow only safe properties and values.
 * @param {string} rawStyle - The raw CSS string from the prompt.
 * @returns {string} A sanitized CSS string.
 */
    function sanitizeCssString(rawStyle) {
        if (!rawStyle || typeof rawStyle !== 'string') {
            return '';
        }

        // 1. Define a "safelist" of CSS properties.
        const safeProperties = new Set(['font-size', 'font-family', 'font-weight', 'color', 'background-color', 'border', 'border-radius', 'padding', 'margin', 'width', 'height', 'min-width', 'min-height', 'max-width', 'max-height', 'text-align']);

        // 2. Define a regex for dangerous values.
        // This blocks: url(), expression(), javascript:, calc() (can be abused), and -moz-binding
        const dangerousValueRegex = /url\(|expression\(|javascript:|calc\(|-moz-binding/i;

        const sanitizedPairs = [];

        // 3. Process the raw string
        rawStyle.split(';').forEach(pair => {
            if (!pair.includes(':')) {
                return;
                // Not a valid property:value pair
            }

            let [property, value] = pair.split(/:(.+)/);
            // Split only on the first colon
            if (!property || !value) {
                return;
            }

            property = property.trim().toLowerCase();
            value = value.trim();

            // 4. Validate against safelist and dangerous values
            if (safeProperties.has(property) && !dangerousValueRegex.test(value)) {
                // Re-build the safe pair
                sanitizedPairs.push(`${property}: ${escapeHtml(value)}`);
                // Escape value just in case
            }
        }
        );

        // 5. Return the joined, safe CSS string.
        return sanitizedPairs.join('; ');
    }

    // ===== START: ADD THESE NEW FUNCTIONS FOR PIVOT CSV COPY =====

    /**
 * Escapes a string for use in a delimited file (CSV or TSV).
 * @param {string} cell - The content of the cell.
 * @param {string} [delimiter=','] - The delimiter character (',' for CSV, '\t' for TSV).
 * @returns {string} The properly escaped cell content.
 */
    // Neutralizes spreadsheet formula/CSV injection: a value whose first
    // character is one a spreadsheet treats as the start of a formula is
    // prefixed with a single quote so Excel / Google Sheets render it as
    // literal text instead of evaluating it. `=` `@` and leading TAB/CR are
    // always guarded; `+`/`-` are guarded only when the value isn't a plain
    // number, so legitimate negative/positive numbers (e.g. -1234.5) pass
    // through unchanged.
    function neutralizeFormulaInjection(str) {
        if (!str) return str;
        const first = str.charAt(0);
        if (first === '=' || first === '@' || first === '\t' || first === '\r') {
            return "'" + str;
        }
        if ((first === '+' || first === '-') && str.length > 1) {
            // A lone "-"/"+" (common "no value" placeholder) is harmless; only
            // guard when there's more after it and it isn't a plain number.
            const isPlainNumber = /^[+-]?[\d,]*\.?\d+(?:[eE][+-]?\d+)?$/.test(str.trim());
            if (!isPlainNumber) return "'" + str;
        }
        return str;
    }

    function escapeCsvCell(cell, delimiter) {
        if (delimiter === undefined) delimiter = ',';
        let cellStr = String(cell == null ? '' : cell);
        // Guard against spreadsheet formula injection before any quoting.
        cellStr = neutralizeFormulaInjection(cellStr);

        if (delimiter === '\t') {
            // TSV is consumed by pasting into a spreadsheet, and Excel/Sheets
            // paste does NOT honor CSV-style double-quote escaping - an embedded
            // tab/newline would still spill the value into adjacent cells/rows.
            // Collapse structural whitespace to single spaces so each value
            // stays inside one cell. (CSV, opened as a file, keeps RFC-4180
            // quoting below.)
            return cellStr.replace(/[\t\r\n]+/g, ' ');
        }

        // CSV: wrap in double quotes if the value contains the delimiter, a
        // quote, or a line break (RFC 4180 - honored when the .csv is opened).
        if (cellStr.indexOf('"') >= 0 || cellStr.indexOf(delimiter) >= 0 || cellStr.indexOf('\n') >= 0 || cellStr.indexOf('\r') >= 0) {
            cellStr = '"' + cellStr.replace(/"/g, '""') + '"';
        }
        return cellStr;
    }

    /**
     * Generates a delimited string (CSV or TSV) of the currently visible pivot table.
     * Extracts raw JSON from hidden containers if present.
     * @param {string} [delimiter=','] - The delimiter character (',' for CSV, '\t' for TSV).
     * @returns {{content: string, rowCount: number}} An object with the delimited content and row count.
     */
    function getPivotCsvForCopy(delimiter) {
        if (delimiter === undefined) delimiter = ',';
        const $pivotTable = $('#pivotResultTable');
        if (!$pivotTable.is(':visible'))
            return {
                content: '',
                rowCount: 0
            };
        // The rowspan memory below is indexed over every body row, hidden ones
        // included, so the output depends on collapsed rows existing.
        penumbraPivotEnsureAllRows();

        const headerGrid = [];
        const $headerRows = $pivotTable.find('thead tr');

        // Parse the header into a 2D grid
        $headerRows.each(function (rowIndex) {
            let colIndex = 0;
            $(this).find('th').each(function () {
                const $th = $(this);
                const colspan = parseInt($th.attr('colspan') || '1');
                const rowspan = parseInt($th.attr('rowspan') || '1');
                const text = $th.clone().find('.sort-icon, .col-sort-icon').remove().end().text().trim();

                while (headerGrid[rowIndex] && headerGrid[rowIndex][colIndex]) {
                    colIndex++;
                }

                for (let r = 0; r < rowspan; r++) {
                    if (!headerGrid[rowIndex + r])
                        headerGrid[rowIndex + r] = [];
                    for (let c = 0; c < colspan; c++) {
                        headerGrid[rowIndex + r][colIndex + c] = text;
                    }
                }
                colIndex += colspan;
            });
        });

        // Flatten header grid
        const finalHeaders = [];
        if (headerGrid.length > 0) {
            for (let c = 0; c < headerGrid[0].length; c++) {
                const colTexts = [];
                for (let r = 0; r < headerGrid.length; r++) {
                    if (headerGrid[r]?.[c] && (r === 0 || headerGrid[r][c] !== headerGrid[r - 1][c])) {
                        colTexts.push(headerGrid[r][c]);
                    }
                }
                finalHeaders.push(colTexts.join('-'));
            }
        }

        const csvRows = [finalHeaders.map(function(h) { return escapeCsvCell(h, delimiter); }).join(delimiter)];
        const rowHeaderMemory = {};

        // Parse the table body
        $pivotTable.find('tbody tr').each(function (rowIndex) {
            // Skip hidden rows (collapsed children and hidden summaries).
            // Visible summary rows ARE included so CSV matches on-screen layout.
            var $thisRow = $(this);
            if ($thisRow.css('display') === 'none') return;

            const rowData = [];
            let cellIndex = 0;

            $thisRow.find('td').each(function () {
                const $td = $(this);
                const rowspan = parseInt($td.attr('rowspan') || 1);

                while (rowHeaderMemory[rowIndex]?.[cellIndex]) {
                    rowData.push(rowHeaderMemory[rowIndex][cellIndex]);
                    cellIndex++;
                }

                let text = "";
                // CHECK: If cell has hidden raw JSON, use that.
                const $rawJson = $td.find('.raw-json-data');

                if ($rawJson.length > 0) {
                    text = $rawJson.text();
                } else {
                    // Clone and strip collapse toggle icons before extracting text
                    var $clean = $td.clone();
                    $clean.find('.pivot-collapse-toggle').remove();
                    text = $clean.text().trim();
                }

                rowData.push(text);

                if (rowspan > 1) {
                    for (let i = 1; i < rowspan; i++) {
                        if (!rowHeaderMemory[rowIndex + i])
                            rowHeaderMemory[rowIndex + i] = {};
                        rowHeaderMemory[rowIndex + i][cellIndex] = text;
                    }
                }
                cellIndex++;
            });

            while (rowHeaderMemory[rowIndex]?.[cellIndex]) {
                rowData.push(rowHeaderMemory[rowIndex][cellIndex]);
                cellIndex++;
            }
            csvRows.push(rowData.map(function(c) { return escapeCsvCell(c, delimiter); }).join(delimiter));
        });

        // Parse the table footer (expand colspan so columns stay aligned)
        $pivotTable.find('tfoot tr').each(function () {
            const rowData = [];
            $(this).find('td').each(function () {
                const $cell = $(this);
                const colspan = parseInt($cell.attr('colspan') || 1);
                const text = $cell.text().trim();
                rowData.push(text);
                // Fill extra columns for colspan with empty strings to maintain alignment
                for (let i = 1; i < colspan; i++) {
                    rowData.push('');
                }
            });
            csvRows.push(rowData.map(function(c) { return escapeCsvCell(c, delimiter); }).join(delimiter));
        });

        return {
            content: csvRows.join('\n'),
            rowCount: $pivotTable.find('tbody tr').length
        };
    }
