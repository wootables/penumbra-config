    /**
     * Generates a short, URL-safe random string: up to 4 base-36 chars (0-9, a-z).
     * Usually 4 chars, occasionally 3 (when the random value is "short" in base 36).
     * Plenty of combinations, and collisions are retried in generateAndCheckRandomId().
     */
    function generateRandomShortId() {
        return Math.random().toString(36).substring(2, 6);
        // e.g., "4f5a"
    }

    /**
     * Checks the database to see if a short_id already exists.
     * @param {string} shortId - The ID to check.
     * @returns {Promise<object>} A promise that resolves to { exists: boolean, error?: string }
     */
    async function checkServerId(shortId) {
        if (!shortId) {
            return {
                exists: false
            };
        }
        try {
            const data = await $.ajax({
                url: 'check_short_id.php',
                type: 'GET',
                data: {
                    short_id: shortId
                },
                dataType: 'json'
            });
            return data;
        } catch (e) {
            if (e.status === 0 || e.status === 403) {
                handleSessionExpiredError();
                return {
                    exists: false,
                    error: 'Session Expired'
                };
            }
            console.error("Failed to check server ID:", e);
            return {
                exists: false,
                error: e.responseJSON?.error || 'AJAX Error'
            };
        }
    }

    /**
     * Generates a new random ID and checks until it finds a unique one.
     * Updates the input field when a unique ID is found.
     */
    async function generateAndCheckRandomId() {
        const $button = $('#generateRandomIdBtn');
        const $input = $('#serverSaveIdInput');
        $button.prop('disabled', true).addClass('is-loading').text('Checking...');

        let newId = generateRandomShortId();
        let data = await checkServerId(newId);
        let attempts = 0;

        while (data.exists && attempts < 10) {
            newId = generateRandomShortId();
            data = await checkServerId(newId);
            attempts++;
        }

        $button.prop('disabled', false).removeClass('is-loading').text('Generate');

        if (data.exists) {
            // Extremely unlucky, just tell them to try again
            $('#serverSaveStatus').text('Could not generate a unique ID. Please try again.').addClass('save-error').show();
        } else {
            $input.val(newId).trigger('input');
            // Trigger validation logic
        }
    }

    /**
     * One candidate SHORT_ID for a copy.
     *
     * save_server_state.php only lets a NON-admin CREATE a report whose id matches
     * one of their report-grant patterns, so a plain random id would be rejected for
     * a scoped editor. Seed from a grant pattern instead: "ORIED_*" -> "ORIED_4f5a".
     * Patterns without a '*' are skipped - that id IS an existing report (very
     * likely the one being copied), so it can't host the copy. Admins bypass the
     * gate entirely and just get a random id. The server always has the final say.
     */
    function _copyIdCandidate() {
        var rnd = generateRandomShortId();
        if (penumbra_vars.isGlobalAdmin) return rnd;
        var pats = Array.isArray(penumbra_vars.reportGrantPatterns) ? penumbra_vars.reportGrantPatterns : [];
        for (var i = 0; i < pats.length; i++) {
            var p = String(pats[i] || '');
            if (p.indexOf('*') === -1) continue;
            var seeded = p.replace(/\*/g, rnd);
            // Must still satisfy the ID field's own URL-safety rule, or the user
            // would be handed an id the dialog itself refuses to submit.
            if (/^[a-z0-9\-_]+$/i.test(seeded)) return seeded;
        }
        return rnd;
    }

    /**
     * Mint a SHORT_ID for a copy that is not already taken. Mirrors
     * generateAndCheckRandomId()'s retry budget. Returns null if every attempt
     * collided (caller reports it rather than saving over something).
     */
    /**
     * Client mirror of penumbraWildcardMatch() in db_connection.php: '*' becomes
     * '.*', anchored, case-insensitive. Used to check a candidate id against the
     * user's own report grants BEFORE offering it, so a scoped editor is never handed
     * an id that save_server_state.php's CREATE gate will refuse.
     */
    function _grantPatternMatches(pattern, shortId) {
        var esc = String(pattern).replace(/[.*+?^${}()|[\]\\]/g, '\\$&').replace(/\\\*/g, '.*');
        try {
            return new RegExp('^' + esc + '$', 'i').test(String(shortId));
        } catch (e) {
            return false;
        }
    }

    /** True when this user may CREATE this id (admins bypass the gate entirely). */
    function _copyIdAllowed(id) {
        if (penumbra_vars.isGlobalAdmin) return true;
        var pats = Array.isArray(penumbra_vars.reportGrantPatterns) ? penumbra_vars.reportGrantPatterns : [];
        for (var i = 0; i < pats.length; i++) {
            if (_grantPatternMatches(pats[i], id)) return true;
        }
        return false;
    }

    // A copy's id is DERIVED from its source - "coi-quarterly" -> "coi-quarterly-2" -
    // so the permanent URL still says what the report is and copies sort next to the
    // original in any ID-ordered list. A source that already ends in -<n> increments
    // instead of stacking ("coi-2" -> "coi-3", never "coi-2-2").
    //
    // Bounded on both axes: at most COPY_ID_TRIES candidates (each costs one
    // availability round-trip, and in practice the first is free), and the SHORT_ID
    // column width as the length ceiling. 100 = the real column limit (confirmed
    // 2026-07-25); deriving only adds 2-4 chars to an id that already fits, so a
    // tighter cap would buy nothing and would silently downgrade a copy of a long
    // source id to a random one instead.
    var COPY_ID_MAX_LEN = 100;
    var COPY_ID_TRIES = 6;
    function _derivedCopyIds(sourceId) {
        var out = [];
        var src = String(sourceId || '').trim();
        if (!src) return out;
        var base = src, start = 2;
        var m = /^(.*[^-])-(\d+)$/.exec(src);
        if (m) {
            base = m[1];
            start = parseInt(m[2], 10) + 1;
        }
        for (var n = start; n < start + COPY_ID_TRIES; n++) {
            var cand = base + '-' + n;
            if (cand.length > COPY_ID_MAX_LEN) break;
            if (!/^[a-z0-9\-_]+$/i.test(cand)) break;
            // Every candidate shares one shape, so if the grant rejects this one it
            // rejects them all - stop rather than burn round-trips.
            if (!_copyIdAllowed(cand)) break;
            out.push(cand);
        }
        return out;
    }

    /**
     * Mint a SHORT_ID for a copy that is not already taken: derived ids first, then
     * the random / grant-seeded fallback for when every derived form is taken, too
     * long, or outside this user's grants. Returns null if nothing was free (the
     * caller reports that rather than saving over something).
     */
    async function _mintCopyShortId() {
        var derived = _derivedCopyIds(_serverSaveCopySourceId);
        for (var i = 0; i < derived.length; i++) {
            var d = await checkServerId(derived[i]);
            if (d.error) return null;
            if (!d.exists) return derived[i];
        }

        var id = _copyIdCandidate();
        var data = await checkServerId(id);
        var attempts = 0;
        while (data.exists && attempts < 10) {
            id = _copyIdCandidate();
            data = await checkServerId(id);
            attempts++;
        }
        if (data.error) return null;
        return data.exists ? null : id;
    }

    /**
     * Arm / disarm copy mode and reflect it across the dialog: the notice banner,
     * the primary button's label, and the overwrite row (meaningless for a
     * brand-new id, so it is cleared and hidden).
     */
    function _serverSaveSetCopyMode(on, newId) {
        _serverSaveCopyMode = !!on;
        var $notice = $('#serverSaveCopyNotice');
        var $primary = $('#confirmServerSaveBtn');
        if (on) {
            $notice.find('.ssc-new-id').text(newId);
            $notice.find('.ssc-src-id').text(_serverSaveCopySourceId || '(this report)');
            $notice.show();
            $('#serverSaveOverwriteContainer').hide();
            $('#serverSaveOverwriteCheckbox').prop('checked', false);
            $primary.text('Save Copy to Server').prop('disabled', false);
            $('#saveAsCopyBtn').prop('disabled', true);
        } else {
            _serverSaveCopyTitle = null;
            $notice.hide();
            $primary.text('Save to Server');
            $('#saveAsCopyBtn').prop('disabled', false);
        }
    }

    // --- "Save as Copy": reserve a new id + retitle, then let the normal save run ---
    // This only PREPARES the dialog; #confirmServerSaveBtn still does the saving, so
    // the copy goes through exactly the same validation, encryption, scope and audit
    // path as any other save.
    $(document).on('click', '#saveAsCopyBtn', async function () {
        // Belt and braces behind #saveQuery: a copy made from an as-of page would
        // silently fork the OLD definition under a new id, which is a plausible
        // thing to want but never a thing to do by accident.
        if (_pnbAsOfBlocked('Save as Copy')) return;
        const $btn = $(this);
        const $statusBox = $('#serverSaveStatus');
        $btn.prop('disabled', true).addClass('is-loading');
        $statusBox.text('Reserving a new report ID...').removeClass('save-error save-success').show();

        const newId = await _mintCopyShortId();
        $btn.removeClass('is-loading');
        if (!newId) {
            $btn.prop('disabled', false);
            $statusBox.text('Could not reserve a unique ID for the copy. Please try again.').addClass('save-error').show();
            return;
        }

        // " (copy)" is appended once, never stacked - re-arming on an already-copied
        // title keeps a single suffix.
        const baseTitle = stripHtml(getReportTitle());
        _serverSaveCopyTitle = /\(copy\)\s*$/i.test(baseTitle) ? baseTitle : (baseTitle + ' (copy)');

        // Set the id directly instead of .trigger('input'): availability was just
        // checked, so the debounced lookup would only re-ask the server what we
        // already know and re-disable the save button for 500ms in the meantime.
        $('#serverSaveIdInput').val(newId).removeAttr('aria-invalid');
        _serverSaveSetCopyMode(true, newId);

        // Expand Last Stop so the renamed Title is visible. _serverSaveCopyTitle is
        // set FIRST because _lscSetCollapsed re-mirrors the title fields on expand
        // and now reads the copy title from there.
        _lscSetCollapsed(false);

        $statusBox.text('New ID reserved. Review the title, then save the copy.')
            .removeClass('save-error').addClass('save-success').show();
    });

