    // --- Keep AI panel synced with editor tabs height ---
    // The panel should match the editor's height, but never exceed the viewport.
    // CSS `position: sticky; top: 0` keeps it pinned on-screen when scrolling.
    var _syncTimer = null;
    var _syncing = false;       // guard against resize feedback loop
    var _lastEditorH = 0;       // track real editor height changes
    var _userResizedWidth = false; // true when user drags the resize handle
    function syncAiPanelSize() {
        var $panel = $('#aiAssistPanel');
        if (!$panel.is(':visible')) return;

        // Width: 35% of viewport so the panel scales with window size,
        // with a usable minimum of 400px.
        // If the user has manually dragged the resize handle, respect that
        // width until the panel is closed and reopened.
        if (!_userResizedWidth) {
            var panelWidth = Math.max(Math.round($(window).width() * 0.35), 400);
            $panel.css('width', panelWidth + 'px');
        }

        // Height strategy depends on editor mode:
        //  • Fixed-height mode:  editor has a set pixel height (400px), so
        //    reading editorTabs.outerHeight() is safe - no feedback loop.
        //    Match it so the panel bottom aligns with the editor bottom.
        //  • Dynamic (auto-expand) mode:  editor grows to fit content, and
        //    reading its height causes a resize loop (panel grows flex →
        //    editor grows → ResizeObserver fires → repeat). Use the viewport
        //    to cap the panel instead; CSS sticky keeps it pinned on scroll.
        var isDynamic = $('body').hasClass('dynamic-editor-mode');
        var panelHeight;
        if (!isDynamic) {
            // Fixed mode - measure the editor's natural height without the
            // panel inflating the flex container.  Temporarily zero the panel
            // so the flex row collapses to the editor's intrinsic height.
            var oldH = $panel[0].style.height;
            $panel[0].style.height = '0px';
            panelHeight = $('#editorTabs').outerHeight() || 400;
            $panel[0].style.height = oldH;
        } else {
            // Dynamic mode - use viewport to avoid feedback loop
            var viewportHeight = $(window).height();
            var panelTop = $panel[0].getBoundingClientRect().top;
            panelHeight = viewportHeight - panelTop - 10;
        }
        panelHeight = Math.max(panelHeight, 300);

        _syncing = true;
        $panel.css('height', panelHeight + 'px');
        // Clear the guard after a tick so ResizeObserver callbacks from our
        // own change are suppressed
        setTimeout(function () { _syncing = false; }, 60);
    }

    // Debounced version to avoid rapid-fire calls from ResizeObserver
    function syncAiPanelSizeDebounced() {
        if (_syncing || _syncTimer) return;   // skip if we caused the resize
        _syncTimer = setTimeout(function () {
            _syncTimer = null;
            syncAiPanelSize();
        }, 50);
