            $tip.css({ top: '-9999px', left: '-9999px' }).addClass('pivot-th-tooltip-visible');
            var rect = this.getBoundingClientRect();
            var tipW = $tip.outerWidth();
            var tipH = $tip.outerHeight();
            var vw = window.innerWidth;
            var vh = window.innerHeight;
            var margin = 8;
            // Prefer below the header; flip above if it would overflow the viewport
            var top = rect.bottom + 6;
            if (top + tipH + margin > vh) {
                top = rect.top - tipH - 6;
                if (top < margin) top = margin;
