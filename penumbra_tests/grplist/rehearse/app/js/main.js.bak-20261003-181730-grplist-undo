    /**
     * Detect the current database type from editor content.
     * Checks table names against known table sets and uses MS-SQL syntax hints.
     */
    function detectCurrentDbType() {
        if (!editor) return 'oracle';
        // Strip [PROMPT]/[SUBQUERY]/[CTE_SUBQUERY]/[IMPORT] tag bodies BEFORE any
        // detection (mirrors query.php). The SQL inside a cross-db tag is written
        // in the REMOTE database's dialect, so its functions (e.g. CHARINDEX) and
        // tables must not flip the MAIN query's detected type - that would mislabel
        // the [Database type] context sent to the AI and the formatter language.
        // Innermost pairs are removed repeatedly so nested brackets are handled.
        var text = editor.getValue();
        for (var s = 0; s < 20 && /\[[^\[\]]*\]/.test(text); s++) {
            text = text.replace(/\[[^\[\]]*\]/g, ' ');
        }
        var upper = text.toUpperCase();

        // 1. Check for MS-SQL syntax markers
        if (/\bTOP\s+\d/i.test(text) || /\bISNULL\s*\(/i.test(text) || /\bGETDATE\s*\(/i.test(text) ||
            /\bCONVERT\s*\(/i.test(text) || /\bFOR\s+JSON\b/i.test(text) || /\bFOR\s+XML\b/i.test(text) ||
            /\bCROSS\s+APPLY\b/i.test(text) || /\bOUTER\s+APPLY\b/i.test(text) ||
            /\bCHARINDEX\s*\(/i.test(text) || /\bLEN\s*\(/i.test(text) || /\bDATEDIFF\s*\(/i.test(text) ||
            /\bPATINDEX\s*\(/i.test(text)) {
            return 'mssql';
        }

        // 2. Extract table names from FROM/JOIN clauses and check against known sets.
        // Only PINS and InfoEd are MS-SQL. HR and FIN are Oracle (OCI) connections,
        // so their tables confirm the Oracle dialect.
        var tableMatches = upper.match(/(?:FROM|JOIN)\s+([A-Z_][A-Z0-9_]*)/g);
        if (tableMatches) {
            for (var i = 0; i < tableMatches.length; i++) {
                var tbl = tableMatches[i].replace(/^(?:FROM|JOIN)\s+/i, '').trim();
                if (typeof pinsTableSet !== 'undefined' && pinsTableSet.has(tbl)) return 'mssql';
                if (typeof infoEdTableSet !== 'undefined' && infoEdTableSet.has(tbl)) return 'mssql';
                if (typeof hrTableSet !== 'undefined' && hrTableSet.has(tbl)) return 'oracle';
                if (typeof finTableSet !== 'undefined' && finTableSet.has(tbl)) return 'oracle';
            }
        }

        // 3. Check for Oracle syntax markers
        // (default is oracle, but these confirm it)
        return 'oracle';
    }

    /**
     * Lazily load the SQL formatter: the third-party js/sql-formatter.min.js
     * (NO ?v= - the file never changes between deploys, so the browser keeps
     * it as long as the server's 7-day clientCache allows) plus Penumbra's own
     * js/penumbra_sqlfmt.js (filemtime-versioned like every other lazy module),
     * which carries the tag masking, the extended Oracle grammar and the
     * tidy-up passes. Formatting is rare, so a page that never clicks Format
     * pays for neither. loadScript() de-dupes in-flight loads and turns an
     * expired-SSO failure into err.sessionExpired (the sign-in dialog is
     * already up in that case - callers stay quiet).
     * Returns a jQuery promise that resolves once PenumbraSqlFormat is ready.
     */
    var _sqlFormatterLoad = null;
    function sqlFormatterReady() {
        return !!(window.PenumbraSqlFormat && window.sqlFormatter &&
                  typeof window.sqlFormatter.formatDialect === 'function');
    }
    function ensureSqlFormatter() {
        if (sqlFormatterReady()) {
            return $.Deferred().resolve().promise();
        }
        if (_sqlFormatterLoad) return _sqlFormatterLoad; // load already in flight

        var dfd = $.Deferred();
        var modSrc = (window.PENUMBRA_SQLFMT_ASSETS && window.PENUMBRA_SQLFMT_ASSETS.js) ||
                     'js/penumbra_sqlfmt.js';
        Promise.all([loadScript('js/sql-formatter.min.js'), loadScript(modSrc)]).then(function () {
            if (sqlFormatterReady()) {
                dfd.resolve();
            } else {
                _sqlFormatterLoad = null; // allow a retry on the next click
                dfd.reject(new Error('SQL formatter loaded but exposed nothing'));
            }
        }).catch(function (err) {
            _sqlFormatterLoad = null; // allow a retry on the next click
            var expired = !!(err && err.sessionExpired);
            var e = new Error(expired ? err.message : 'Could not load the SQL formatter.');
            e.sessionExpired = expired;
            dfd.reject(e);
        });
        _sqlFormatterLoad = dfd.promise();
        return _sqlFormatterLoad;
    }

    /**
     * Format SQL locally. The engine lives in js/penumbra_sqlfmt.js (see its
     * header for exactly what is and is not touched: [PROMPT;...],
     * [SUBQUERY;...], [CTE_SUBQUERY;...], @@HTML and @@JSON are restored
     * verbatim; strings and comments are never altered). dbType is 'mssql' or
     * anything else (= Oracle), as detectCurrentDbType() and
     * subqueryDbDialect() produce.
     *
     * @returns {string|null} formatted SQL, or null if the module is missing.
     *                        Throws if the SQL can't be parsed (caller handles).
     */
    function penumbraFormatSql(sql, dbType) {
        if (!window.PenumbraSqlFormat) return null;
        return window.PenumbraSqlFormat.format(sql, dbType);
    }

