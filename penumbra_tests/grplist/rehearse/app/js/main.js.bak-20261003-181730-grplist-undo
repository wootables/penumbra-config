    // to computeCurrentViewRawSignature()'s format, i.e. the LOCAL-snapshot
    // dataSignature format. Used directly by copy-to-local (which used to store
    // the server's SIG_ form into local consumers that compare raw - permanently
    // killing the match-dot and duplicate detection for copied snapshots) and as
    // the base for the hashed server form below.
    function _rawSignatureFromSnapshotRows(rows) {
        if (!Array.isArray(rows) || rows.length === 0) return '';
        // Journal toggle/notes columns are DECORATION appended to the stored
        // rowData (journalSnapshotRowData); the badge's live side hashes the
        // UNdecorated masterRowData, so they must be excluded here - otherwise a
        // snapshot saved on a report with toggle columns could never light
        // "matches current view" (and copy-to-server inherited the mismatch).
