                    if (m && m.isValid()) {
                        const ts = m.valueOf();
                        if (st.dateBest === null || (type === 'min' ? ts < st.dateBest : ts > st.dateBest)) {
                            st.dateBest = ts;
                            st.dateText = s.trim();
                        }
                        st.dateSeen++;
                        return;
                    }
                    if (st.dateSeen > 0) return;   // established date column: ignore the stray
                    // First non-blank value was not a date - this is not a date
                    // column. Fall through to numbers for good.
                    st.dateOk = false; st.dateBest = null; st.dateText = null; st.dateSeen = 0;
                }

                const num = parseAccountingNumber(s);
                if (isNaN(num)) return;
                st.numN++;
                st.sum += num;
                if (st.min === null || num < st.min) st.min = num;
                if (st.max === null || num > st.max) st.max = num;
                // Welford: one pass, numerically stable, no value retention.
                const d = num - st.mean;
                st.mean += d / st.numN;
                st.m2 += d * (num - st.mean);
                if (st.vals) st.vals.push(num);
                if (s.indexOf('$') !== -1) st.isCurrency = true;
                if (s.indexOf('%') !== -1) st.isPercent = true;
                // Remember the source column's own precision so a summary can
                // render like the cells above it.
                const clean = s.replace(/[$,()%\s\x02]/g, '');
                const dot = clean.indexOf('.');
                if (dot >= 0) {
                    const dd = clean.length - dot - 1;
                    if (dd > st.decimals) st.decimals = dd;
                }
            },
            // null = nothing worth showing for this column (all blank, no
            // numbers, or a stddev over a single row).
            finish: function () {
                if (type === 'formula') {
                    if (!formulaAst) return null;   // empty or invalid expression
                    const _med = (function () {
                        if (!st.vals.length) return 0;
                        const s2 = st.vals.slice().sort(function (a, b) { return a - b; });
                        const mid = Math.floor(s2.length / 2);
                        return (s2.length % 2 === 0) ? (s2[mid - 1] + s2[mid]) / 2 : s2[mid];
                    })();
                    const v = evaluatePivotFormula(formulaAst, {
                        sum: st.sum,
                        count: st.n,
                        filled: st.filled,
                        blank: st.blank,
                        unique: Object.keys(st.uniq).length,
                        min: (st.min === null) ? 0 : st.min,
                        max: (st.max === null) ? 0 : st.max,
                        avg: st.numN ? (st.sum / st.numN) : 0,
                        median: _med,
                        range: (st.min === null || st.max === null) ? 0 : (st.max - st.min),
                        stddev: (st.numN > 1) ? Math.sqrt(st.m2 / (st.numN - 1)) : 0
                    });
                    // null = a division by zero or an unresolved reference; show
                    // nothing rather than a misleading 0.
                    if (v === null || !isFinite(v)) return null;
                    return {
                        kind: 'num', value: v, decimals: st.decimals,
                        isCurrency: st.isCurrency, isPercent: st.isPercent, n: st.numN
                    };
                }
                if (type === 'count')        return { kind: 'int', value: st.n };
                if (type === 'count_filled') return { kind: 'int', value: st.filled };
                if (type === 'count_blank')  return { kind: 'int', value: st.blank };
                if (type === 'count_unique') return { kind: 'int', value: Object.keys(st.uniq).length };

                if (st.freq) {
                    if (!st.order.length) return null;
                    let best = st.order[0];
                    for (let i = 1; i < st.order.length; i++) {
                        const c = st.freq[st.order[i]], b = st.freq[best];
                        // Ties keep the FIRST value seen, so the answer is
                        // stable across re-renders and matches the server, which
                        // walks rows in the same order.
                        if (type === 'mode' ? c > b : c < b) best = st.order[i];
                    }
                    return { kind: 'text', value: best, count: st.freq[best] };
                }

                if (st.dateOk && st.dateSeen > 0) return { kind: 'date', value: st.dateBest, text: st.dateText };
                if (st.numN === 0) return null;

                let v;
                switch (type) {
                    case 'sum':    v = st.sum; break;
                    case 'avg':    v = st.sum / st.numN; break;
                    case 'min':    v = st.min; break;
                    case 'max':    v = st.max; break;
                    case 'range':  v = st.max - st.min; break;
                    case 'stddev':
                        if (st.numN < 2) return null; // one row has no spread to report
                        v = Math.sqrt(st.m2 / (st.numN - 1)); // sample stddev
                        break;
                    case 'median': {
                        const s2 = st.vals.slice().sort(function (a, b) { return a - b; });
                        const mid = Math.floor(s2.length / 2);
                        v = (s2.length % 2 === 0) ? (s2[mid - 1] + s2[mid]) / 2 : s2[mid];
                        break;
                    }
                    default: return null;
                }
                return {
                    kind: 'num', value: v, decimals: st.decimals,
                    isCurrency: st.isCurrency, isPercent: st.isPercent, n: st.numN
                };
            }
        };
    }

    // Render a finished summary result for display.
    //
    // THE canonical summary number format - one rule, every renderer, both
    // sides. Mirrored exactly by penumbra_format_summary() in schedule_runner.php.
    //
    // Before this, four renderers disagreed: the flat footer forced 2dp with
    // accounting parens, the grouped footer followed source precision and wrote
    // a bare "$-1,234", the snapshot-diff footer dropped the '$' entirely, and
    // the server suppressed thousands separators whenever the SOURCE cells had
    // none (so a column rendering "30,936,356.00" in the browser mailed as
    // "30936356"). The rule now is:
    //
    //   - thousands separators: ALWAYS
    //   - decimals: the source column's own precision, capped at 2...
    //       ...rounded up to 2 for currency that HAS cents (money shows cents),
    //          but never invented for a whole-dollar column - see 2026-08-12
    //       ...floored at 2 for avg/median/stddev (inherently fractional)
    //       ...0 for the counting types
    //   - currency: '$' prefix whenever the column is currency, negatives in
    //     accounting parens -> ($1,234.00)
    //   - non-currency negatives: -1,234.00
    //   - '%' suffix for a percent column on every type EXCEPT sum (a sum of
    //     percentages is not a percentage)
    //
    // opts.isCurrency is the caller's column-level flag (from columnProperties,
    // sampled over the first 100 rows). When the caller has none - the
    // snapshot-diff footer builds from a bare column list - the '$' sniff
    // gathered while accumulating is used instead.
    function penumbraFormatSummary(result, type, opts) {
        if (!result) return '';
        opts = opts || {};
        if (result.kind === 'date') return result.text;
        if (result.kind === 'text') return result.value;
        if (result.kind === 'int') {
            return Number(result.value).toLocaleString(undefined, { maximumFractionDigits: 0 });
        }

        const isCurrency = (typeof opts.isCurrency === 'boolean') ? opts.isCurrency : !!result.isCurrency;

        let dec = Math.min(result.decimals || 0, 2);
        // Currency shows CENTS - but only when the column actually HAS cents.
        // (2026-08-12) Forcing 2dp unconditionally invented a precision the
        // source never had: a column the report formats as whole dollars
        // (TO_CHAR(AMOUNT_TOTAL, '$999,999,999,990')) rendered every cell "$10"
        // and its group header "Sum of AMOUNT: $10", while this footer alone
        // said "$10.00" - the same number written three ways on one screen.
        // A column that really carries cents still reports them, because its
        // result.decimals is > 0 and this rounds it up to a full 2.
        if (isCurrency && (result.decimals || 0) > 0) dec = 2;
        // A formula's result is derived, not a member of the column, so like an
        // average it needs decimals even when the source data has none.
        if (type === 'avg' || type === 'median' || type === 'stddev' || type === 'formula') dec = Math.max(dec, 2);

        let val = Number(result.value);
        if (!isFinite(val)) return '';
        // Drop a negative sign that survives only because the value rounds to
        // zero at this precision. Intl renders -0 and -0.000000000001 as "-0.00"
        // where PHP's number_format prints "0.00"; both are "correct" but they
        // are a visible browser/email difference on identical data.
        if (Math.abs(val) < Math.pow(10, -dec) / 2) val = 0;
        const fmtOpts = { minimumFractionDigits: dec, maximumFractionDigits: dec };

        if (isCurrency) {
            return (val < 0)
                ? '($' + Math.abs(val).toLocaleString(undefined, fmtOpts) + ')'
                : '$' + val.toLocaleString(undefined, fmtOpts);
        }
        let txt = val.toLocaleString(undefined, fmtOpts);
        if (result.isPercent && type !== 'sum') txt += '%';
        return txt;
    }

    // Footer keyword for the label cell: the type's own word when every
    // summarized column agrees, otherwise the neutral 'SUMMARY'.
    function penumbraSummaryHeaderLabel(typesUsed) {
        const uniq = [];
        for (let i = 0; i < typesUsed.length; i++) {
            if (typesUsed[i] && uniq.indexOf(typesUsed[i]) === -1) uniq.push(typesUsed[i]);
        }
        if (uniq.length === 1 && penumbraSummaryDef(uniq[0])) return penumbraSummaryDef(uniq[0]).header;
        return 'SUMMARY';
    }

    // Badges render on EVERY summarized cell, including when all columns agree -
    // they are self-documenting in scheduled email and PDF, where there is no
    // hover to fall back on. Users who find them noisy turn them off with the
    // SHOW toggle in the settings panel's column header.
    const PENUMBRA_SUMMARY_BADGE_ONLY_WHEN_MIXED = false;

    // Type chip appended after a summary value. Carries data-sum-type so the
    // click-to-change handler knows which column it belongs to without having to
    // re-derive it from the cell.
    // colName is optional and only used to surface a custom formula's actual
    // expression on hover - without it an FX badge just says "Custom Formula",
    // which tells the reader nothing about what was computed.
    function penumbraSummaryBadgeHtml(type, mixed, colName) {
        if (!penumbraSummaryBadgesOn()) return '';
        if (PENUMBRA_SUMMARY_BADGE_ONLY_WHEN_MIXED && !mixed) return '';
        const def = penumbraSummaryDef(type);
        if (!def) return '';
        let tip = def.label;
        if (type === 'formula') {
            const fx = penumbraResolveSummaryFormula(colName);
            if (fx) tip += ': ' + fx;
        }
        // Disclosure caret (2026-08-21). The badge has opened the summary-type
        // menu since it shipped, but nothing on screen said so - it read as a
        // static label. This is the SAME up-chevron the status bar puts on a
        // chip that has something to uncover (#pnbStatusBar .sb-caret), so the
        // two affordances teach each other.
        //
        // It sits INSIDE the badge span on purpose. Every path that takes this
        // footer somewhere non-interactive - penumbraSummaryCellText() for the
        // CSV/TSV/XLSX/PDF scrapers, the email/PDF <tfoot> clones - removes
        // .pnb-sum-badge wholesale, so an affordance parked inside it can never
        // reach a file, an email or a PDF. A sibling span would have to be
        // taught to every one of them. The server's own badge builder
        // (penumbra_summary_badge_html, schedule_runner.php) is deliberately
        // NOT given a caret: nothing in an email is clickable.
        //
        // stroke-width 3, not the status bar's 2: the caret box is 9px here
        // against the bar's 11px, and a 2-unit stroke in a 24-unit viewBox
        // scales down to ~0.75px, which greys out to nothing. Box size lives
        // in .pnb-sum-caret (css/main.css), stroke has to be on the element.
        return ' <span class="pnb-sum-badge" role="button" tabindex="0" data-sum-type="' + escapeHtml(type) +
               '" title="' + escapeHtml(tip) + ' - click to change (not saved)">' +
               escapeHtml(def.badge) +
               '<svg class="pnb-sum-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>' +
               '</span>';
    }

    // The type to pre-select when a user newly ticks the summary box on a column
    // that had none. Numbers get a total; everything else gets a non-blank count,
    // which is the only summary that is meaningful on arbitrary text.
    function penumbraSuggestSummaryType(colId) {
        const props = ($("#resultsTable").data('columnProperties') || {})[colId];
        if (props && (props.isNumeric || props.isCurrency) && !props.isBoolean) return 'sum';
        return 'count_filled';
    }

    // The summarizable value of a BODY cell.
    //
    // Most cells are just their text. Journal toggle cells are not: they render
    // an empty <td> whose state lives on a <button class="journal-toggle-box">,
    // so reading textContent gave "" for every row and every counting type
    // reported zero.
    //
    // A ticked box reads '1' and an unticked one '0' - EXACTLY the strings the
    // server materializes for the same column in journalExportToggleRowValues()
    // (journal_export.php). Matching it is not optional: that function also
    // feeds snapshots, change analysis and custom conditions, so it is the
    // browser that has to agree with it, and anything else would put a
    // different number on screen than in the scheduled email.
    //
    // Practical consequence worth knowing: on a toggle column it is SUM (or
    // Average, for the proportion) that answers "how many are done" - 1s and 0s
    // add up to the ticked count. Count Non-Blank counts every row, because
    // every row has a state.
    //
    // Journal NOTES cells need no special case: their text is already the note
    // count, so they count AND sum as-is.
    function penumbraReadCellForSummary(td) {
        if (!td) return '';
        const tog = td.querySelector('.journal-toggle-box');
        if (tog) {
            const on = tog.getAttribute('aria-checked') === 'true' || tog.classList.contains('is-on');
            return on ? '1' : '0';
        }
        return td.textContent;
    }

    // Text of a summary footer cell WITHOUT its type badge.
    //
    // Every client-side export (CSV, TSV, XLSX, PDF) SCRAPES the rendered
    // <tfoot> rather than recomputing, and the badge is a child <span> of the
    // very <td> they read - so a plain .text() ships "$3,000.25 SUM" into the
    // file. Every one of those scrapers must go through this.
    function penumbraSummaryCellText($td) {
        if (!$td || !$td.length) return '';
        if (!$td.find('.pnb-sum-badge').length) return $td.text().trim();
        return $td.clone().find('.pnb-sum-badge').remove().end().text().trim();
    }

    // ----- Breakdown (infobox drill-down) table summaries ------------------
    // Breakdown tables follow the report's column layout, so they follow its
    // column SUMMARIES too. There are TWO drill builders - the chart drill and
    // the pivot-cell drill - and they are hand-copies of each other, so both go
    // through these helpers instead of growing a fourth and fifth copy of the
    // footer logic.
    //
    // Browser-only surface: a breakdown table cannot be reached from an email,
    // so there is deliberately no server mirror for any of this.
    function penumbraDrillSummaryInit(visibleCols) {
        const mainProps = $("#resultsTable").data('columnProperties') || {};
        const nameToId = $("#resultsTable").data('columnNameToOriginalIndex') || {};
        const out = { types: {}, accs: {}, numeric: {}, props: {} };
        visibleCols.forEach(function (col) {
            if (col === '#') return;
            const colId = nameToId[col];
            const props = (colId !== undefined) ? mainProps[colId] : null;
            out.props[col] = props;
            // Numeric-ness drives the column's SORT type and is independent of
            // whether anyone asked for a summary on it - keep the two separate.
            out.numeric[col] = !!(props && (props.isCurrency || props.isNumeric) && !props.isBoolean);
            const type = penumbraResolveSummaryForName(col, props);
            if (type) {
                out.types[col] = type;
                out.accs[col] = penumbraSummaryAccumulator(type, col);
            }
        });
        return out;
    }

    function penumbraDrillFooterHtml(drillCols, ds, tdStyle) {
        const results = {};
        const typesShown = [];
        Object.keys(ds.accs).forEach(function (col) {
            const res = ds.accs[col].finish();
            if (res === null) return;
            results[col] = res;
            typesShown.push(ds.types[col]);
        });
        if (typesShown.length === 0) return '';

        const label = penumbraSummaryHeaderLabel(typesShown);
        const isMixed = (label === 'SUMMARY');
        let html = '<tfoot><tr>';
        let labelPlaced = false;
        drillCols.forEach(function (col) {
            if (col === '#' || (!labelPlaced && results[col] === undefined)) {
                html += '<td class="pnb-sum-label" style="' + tdStyle + '">' + escapeHtml(label) + '</td>';
                labelPlaced = true;
            } else if (results[col] !== undefined) {
                const props = ds.props[col];
                const val = penumbraFormatSummary(results[col], ds.types[col], {
                    isCurrency: props ? !!props.isCurrency : undefined
                });
                // data-sum-col is what makes the badge clickable here: a drill
                // table's cells have no data-column and its headers no
                // data-colname, so this is the ONLY way back to the column name.
                html += '<td style="' + tdStyle + '" data-sum-col="' + escapeHtml(col) +
                        '" data-sum-type="' + escapeHtml(ds.types[col]) + '">'
                      + escapeHtml(val) + penumbraSummaryBadgeHtml(ds.types[col], isMixed, col) + '</td>';
            } else {
                html += '<td style="' + tdStyle + '"></td>';
            }
        });
        return html + '</tr></tfoot>';
    }

    // ----- "View in table" gate ---------------------------------------------
    // The breakdown's "View in table" link works by clicking #exitPivotModeBtn,
    // and that exit is DESTRUCTIVE: the handler empties #pivot-output-container
    // and drops currentPivotSourceData / pivotMasterDataSource. Rebuilding the
    // pivot afterwards needs the builder.
    //
    // A viewer whose View Options have "Pivot / Crosstab" turned off has no way
    // to do that -- body.restrict-pivot hides the toolbar pivot button, Modify
    // Pivot Table, Restore Transaction List AND the status-bar pivot chip. For
    // them the link is a one-way door out of the report's saved pivot view, and
    // the only way back is re-running the report. So the link stands down
    // whenever the controls are gone. Admins never get restrict-pivot (they
    // always have the builder), so this only affects restricted viewers.
    function penumbraDrillExitBlocked() {
        return document.body.classList.contains('restrict-pivot');
    }

    // What a column summarizes as when NOTHING is saved at either the report or
    // the user layer. This is the pre-existing behaviour, unchanged: the global
    // total_exemptions whitelist and the '$' sniff have already been folded into
    // columnProperties by the time this runs.
    function penumbraGlobalSummaryDefault(props) {
        if (!props) return null;
        if (props.isBoolean || props.isDate) return null;
        return (props.isNumeric || props.isCurrency) ? 'sum' : null;
    }

    // Effective summary type for every column of the flat table.
    // Returns { colId: type }; a colId absent from the map gets no summary.
    // `false` or null stored at the user or report layer means "explicitly off"
    // and stops the fallback - that is how a user un-totals a column the global
    // whitelist would otherwise grab (an oddly-named ID column, say).
    function penumbraResolveSummaries() {
        const props = $("#resultsTable").data('columnProperties') || {};
        const nameToId = $("#resultsTable").data('columnNameToOriginalIndex') || {};
        const idToName = {};
        for (const n in nameToId) {
            if (Object.prototype.hasOwnProperty.call(nameToId, n)) {
                idToName[String(nameToId[n])] = String(n).toUpperCase();
            }
        }

        const out = {};
        // Iterate the HEADER, not columnProperties. columnProperties only holds
        // the query's own columns (keyed 0..N), so DOM-only columns - journal
        // toggles and journal notes - were never assigned a type at all. The
        // settings panel builds its list from the header, so it offered a
        // summary checkbox for those columns that the engine then ignored,
        // which read as "ticking it does nothing".
        $('#tableHeader th[data-colname]').each(function () {
            const colId = String($(this).attr('data-column'));
            const colName = $(this).attr('data-colname');
            if (!colName || colName === '#' || colId === '#') return;
            // props[colId] is undefined for a DOM-only column; the global layer
            // then yields null, so these stay OFF by default exactly as before.
            const eff = penumbraResolveSummaryForName(colName, props[colId]);
            if (eff) out[colId] = eff;
        });
        return out;
    }

    // Same resolution, keyed by column NAME - for the settings panel, which
    // works in names, and for the snapshot-comparison footer, which is built
    // from a bare column list with no columnProperties to consult.
    //
    // Pass `props` when the caller has the metadata. Without it the global layer
    // falls back to the raw whitelist substring test, which is exactly what the
    // comparison footer has always done on its own.
    function penumbraResolveSummaryForName(colName, props) {
        const name = String(colName || '').toUpperCase();
        // transient (badge click) > user override > report > global
        if (Object.prototype.hasOwnProperty.call(transientColumnSummaries, name)) {
            const t = transientColumnSummaries[name];
            return (t && penumbraSummaryDef(t)) ? t : null;
        }
        return penumbraResolveSummaryPersisted(name, props);
    }

    // Resolution with the TRANSIENT layer deliberately skipped: user > report >
    // global. This is what anything that WRITES must use.
    //
    // A badge click promises "not saved". Resolving through the transient layer
    // in a write path broke that promise three ways at once - the pick was baked
    // into a saved report, into every ?state= share link (Copy Link, the
    // download dialog, the emailed report URL), and into a Save Column Layout.
    // The settings panel uses this too, so the panel always shows the persisted
    // truth and Apply can never round-trip a throwaway experiment back into
    // storage.
    function penumbraResolveSummaryPersisted(colName, props) {
        const name = String(colName || '').toUpperCase();
        if (Object.prototype.hasOwnProperty.call(userColumnSummaries, name)) {
            const eff = userColumnSummaries[name];
            return (eff && penumbraSummaryDef(eff)) ? eff : null;
        }
        return penumbraInheritedSummaryForName(name, props);
    }

    // What this column WOULD summarize as with the user's own override removed -
    // i.e. the report author's choice, else the global default.
    //
    // This is what the user override is diffed against when it is saved, so the
    // stored map holds only genuine deviations. A column the user never touched
    // therefore keeps following the report, and an author who later changes a
    // default still reaches every user who never disagreed with it.
    function penumbraInheritedSummaryForName(colName, props) {
        const name = String(colName || '').toUpperCase();
        let eff;
        if (Object.prototype.hasOwnProperty.call(reportColumnSummaries, name)) {
            eff = reportColumnSummaries[name];
        } else if (props) {
            eff = penumbraGlobalSummaryDefault(props);
        } else {
            eff = (name !== '#' && totalExemptionList.some(function (part) {
                return name.includes(part);
            })) ? 'sum' : null;
        }
        return (eff && penumbraSummaryDef(eff)) ? eff : null;
    }
    // ===== END USER-DEFINED COLUMN SUMMARIES =============================

    let currentGroupSort = { key: 'label', dir: 'asc' };

    // Same synthetic label the pivot uses for its rank rollup, so a reader who
    // meets it in both views is meeting one concept.
    const PENUMBRA_GROUP_OTHER_LABEL = '(Other)';

    /**
     * Coerce a group-limit object from saved state or the dialog into the one
     * shape the renderer trusts. Returns null when nothing is actually limited,
     * so "no limit" is a single value rather than three ways of spelling it.
     * Saved state is user-editable, so every field is clamped here rather than
     * at the ~4 places that read it.
     */
    function _groupNormalizeLimit(raw) {
        if (!raw) return null;
        var n = parseInt(raw.n, 10);
        var minRows = parseInt(raw.minRows, 10);
        if (isNaN(n) || n < 0) n = 0;
        if (isNaN(minRows) || minRows < 0) minRows = 0;
        if (n === 0 && minRows === 0) return null;
        return {
            n: n,
            dir: (String(raw.dir).toLowerCase() === 'bottom') ? 'bottom' : 'top',
            other: raw.other !== false,
            minRows: minRows
        };
    }

    // Group-level filtering (gap #6, 2026-08-30). Mirrors the pivot's rank
    // vocabulary - { n, dir, other } - plus a minimum group size, which the
    // pivot has no equivalent of. null = show every group, the default.
    //   n       how many groups to keep (0/absent = no limit)
    //   dir     'top' | 'bottom', by the configured summary or, with none, size
    //   other   roll everything excluded into one "(Other)" band
    //   minRows drop groups smaller than this (0 = no minimum)
    // Applies at LEVEL 0 only: "the top 10 departments" is the reading people
    // want, and ranking each parent's children separately is a scope knob the
    // pivot needed and this does not.
    let currentGroupLimit = null;

    // How many LEVELS to open when a grouping is first rendered. 0 = none, the
    // long-standing behaviour and still the default. A depth rather than pivot's
    // boolean because a group LEAF renders every underlying row: "all expanded"
    // on a 3-level report means 716 open bands and 4,559 visible rows, which is
    // not a defensible saved default. (2026-08-30)
    let currentGroupStartDepth = 0;
    // The grouped view's LAYOUT (2026-10-03, grplist): 'stacked' (every group in
    // one scrolling page - the default) or 'list' (the names on the left, one
    // group on the right: js/penumbra_grouplist.js). Saved as state.groupLayout
    // only when 'list'. Browser-only, like the start depth: the scheduler never
    // reads it, and without the module a List report simply shows Stacked.
    let currentGroupLayout = 'stacked';
    // The default is a STARTING state, not a rule applied on every render.
    // rebuildGroupedView() runs on every search keystroke, and re-applying there
    // would re-open whatever the reader had just collapsed. Reset only when the
    // grouping itself changes - see setGroupingColumns().
    let _groupStartDepthApplied = false;
    let wasContainerizedBeforeGrouping = false;
    let pivotMasterDataSource = null;
    let _pivotPreSearchCollapseState = null; // collapse state captured before first search, restored on clear
    let pivotOtherExcludedKeys = []; // row keys ranked out into the synthetic "(Other)" bucket
    let _pivotOtherRowCounts = {};   // "(Other)" rowKey -> excluded source-row count (per-group rank scopes have one per parent)
    let isSnippetPrompting = false;
    let allResolvedPrompts = [];
    const _forceDefaultApplied = new Set(); // tracks forcedefault prompts applied this page session
    let savedQueries = [];
    try { savedQueries = JSON.parse(localStorage.getItem("savedQueries") || "[]"); } catch (e) { console.warn("Failed to parse savedQueries from localStorage:", e); }
    const FAVORITE_STATES_KEY = "penumbra_favorite_states";
    const FAVORITE_SERVER_REPORTS_KEY = "penumbra_favorite_server_reports";
    const WORD_WRAP_ENABLED_KEY = "penumbra_word_wrap_enabled";
    const REPORT_PREFS_KEY = "penumbra_report_preferences";
    const FLOATING_BTN_POS_KEY = "penumbra_floating_btn_position";
    const tableColumnCache = new Map();
    let isWordWrapEnabled = true;
    let originalDataBeforeSnapshot = null;
    let isViewingSnapshot = false;
    // The full snapshot object (with compressedData) currently shown in a lazy
    // ?snap= tab, kept so the header's "Compare to current" can diff it against
    // freshly-run live data. Cleared with the header.
    let _lazyViewedSnapshot = null;
    // When set, the next executeQuery run (kicked off by "Compare to current")
    // should, once live data is loaded, overlay a snapshot-vs-live comparison
    // instead of landing on the plain/default view. Shape: {snapshot, kind, key}.
    let _pendingSnapshotCompare = null;
    // One-shot: keep the loading overlay up across the query→comparison handoff
    // so the header-compare doesn't flash the overlay off and back on.
    let _snapCompareDeferLoad = false;
    let isViewingImportedFile = false;
    let importedFileName = '';
    let originalDataBeforeImport = null;
    window._penumbraImportedData = {};
    window._penumbraImportIds = {};    // Maps IMPORT_NAME → server DB ID
    window._penumbraImportMeta = {};   // Maps IMPORT_NAME → {id, filename, row_count}
    const distinctValueCache = new Map();
    let lastExecutionTime = 'N/A';
    let lastLoadTime = null;        // client render seconds (query-finish -> interactive); pairs with lastExecutionTime for the status-bar "Loaded in" breakdown
    let _sbQueryDoneMark = null;    // perf timestamp armed when the query returns, read by hideLoading() once the view is interactive
    let pageLoadTime = null;        // seconds: navigation start -> DOMContentLoaded (the page's pre-query load), read once (free) from the Navigation Timing API
    let _loadIsInitialView = false; // true while the initial-load query's timing is shown (page load counts toward Total; re-queries exclude it)
    let _sbFirstQueryDone = false;
    let _sbTimingIsSnapshot = false; // true while the status-bar timing describes a frozen-snapshot load (no query ran for this view)
    let lastQueryState = {};
    let lastCopySettings = null;
    let globalDecryptedState = null;
    // Set true once resolveStateData detects the loaded report is encrypted
    // (either the {encrypted,content} wrapper or a raw PENUMBRA_GCM::
    // string). Reliable across both storage formats and both ?id / ?state
    // load paths - unlike penumbra_vars.preloadedState.encrypted, which only
    // sees the wrapper form. Used to disable the API-snippet copy option.
    let currentReportIsEncrypted = false;
    // The plaintext report password, retained in memory only (never persisted)
    // after a successful unlock in resolveStateData(). Reused to encrypt/decrypt
    // this report's snapshots so a snapshot of an encrypted report is stored as
    // ciphertext at rest, not plaintext. Null when the report isn't encrypted.
    let currentReportPassword = null;
    let currentReportTheme = 'theme-default';
    let currentReportDensity = 'standard';
    let resolverLinksEnabled = true;
    let spInitialState = null;
    const _infoboxContentRegistry = {};
    const _chainRegistry = {};
    // Slide registry for the snippet `slide()` function. Rebuilt every render.
    // Each entry: { inline: bool, bodyEl: HTMLElement|null }.
    // Lookup from the fullscreen carousel: entries are pulled in DOM order from
    // `.penumbra-slide-frame` / `.penumbra-slide-marker` nodes in #reportSnippetOutput.
    const _penumbraSlideRegistry = [];
    window._penumbraSlideRegistry = _penumbraSlideRegistry;
    let _chainInProgress = false;
    // Whitelisted total rows - Loaded from server configuration
    const totalExemptionList = penumbra_vars.totalExemptions || [];

    // --- URL PARAMETER OVERRIDES ---
    // Parsed once on load. Links can force specific UI state regardless of the
    // viewer's stored preferences. Booleans accept true|false, yes|no, 1|0
    // (bare key with no value also counts as true). Strings must match a known
    // theme/density value or are ignored.
    //   fullscreen = force carousel mode on open (no-op if no charts present)
    //   rowheight  = force row auto-expand ON (true; rows grow to fit content)
    //                or OFF (false; uniform truncated row height) - see the
    //                assignment in applyLayoutPreferences()
    //   deeplink   = force vendor code deep links on (true) or off (false)
    //   rowlimit   = force the row limiter on (true) or off (false), same as the
    //                #toggleLimitBtn funnel. Matches data(rowlimit) semantics:
    //                true = capped at 200. `true` is open to anyone; `false` is
    //                admin-only - see _penumbraRowLimitOverride() for why.
    //   rows       = force the flat table's rows-per-page (10, 100, 200, 500,
