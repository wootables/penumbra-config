                });

                // Per-parent sub-row maps for this row, read from the cell itself.
                const nestedRowsByCol = {};
                let maxNestedRows = 0;
                visibleNestedParents.forEach(pName => {
                    const np = nestedByName[pName];
                    const arr = getRowNestedArray($row, np.colId);
                    if (arr && arr.length) {
                        nestedRowsByCol[pName] = arr.map(item => {
                            const m = {};
                            np.subNames.forEach(sub => {
                                let v = item[sub];
                                if (v == null) { m[sub] = ''; return; }
                                let sv = String(v);
                                if (sv.substring(0, 6) === '@@HTML') {
                                    sv = sv.substring(6).replace(/<[^>]*>/g, '').trim();
                                }
                                m[sub] = sv;
                            });
                            return m;
                        });
                        if (arr.length > maxNestedRows) maxNestedRows = arr.length;
                    } else {
                        nestedRowsByCol[pName] = null;
                    }
                });

