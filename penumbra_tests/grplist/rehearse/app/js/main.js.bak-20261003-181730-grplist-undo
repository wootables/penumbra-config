    // --- Toggle Task Status Handler (Green Dot) ---
    $(document).off('click', '.task-status-toggle');
    $(document).on('click', '.task-status-toggle', function (e) {
        e.stopPropagation();
        // Prevent opening/collapsing logic

        const $btn = $(this);
        const taskId = $btn.data('task-id');
        const newStatus = $btn.data('new-status');

        // Visual feedback (fade out slightly)
        $btn.css('opacity', '0.5');

        $.post('manage_schedule.php', {
            action: 'toggle_status',
            task_id: taskId,
            new_status: newStatus
        }, function (resp) {
            if (resp.status === 'success') {
                show_text("<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> " + resp.message + "</p>");

                // Re-truth the sidebar AND the header Subscribe chip (the chip
                // model rebuilds from every list reload; enabling/disabling a
                // task changes whether its subscriptions are offered). The
                // in-place dot updates below still apply first - the reload
                // lands async and repaints to the same state.
                loadSchedulerTaskList();

                // [NEW] Instant UI Update (for Lightbox usage)
                const isNowActive = newStatus === 1;
                const newColor = isNowActive ? "var(--accent-success, green)" : "var(--border-color, #ccc)";
                const newChar = isNowActive ? "●" : "○";
                const newNextStatus = isNowActive ? 0 : 1;
                const newTitle = isNowActive ? "Task is Active. Click to Disable." : "Task is Inactive. Click to Enable.";
                const parentBorder = isNowActive ? "3px solid var(--accent-success, green)" : "3px solid var(--border-color, #ccc)";

                $btn.css('color', newColor).text(newChar).attr('title', newTitle).data('new-status', newNextStatus).css('opacity', '1');

                // Update border if in the details pane
                $btn.closest('.sched-task-item').css('border-left', parentBorder);

                // Sync the active state data attribute if this event is currently open in the form
                const openTaskId = $('#schedTaskId').val();
                if (openTaskId && String(openTaskId) === String(taskId)) {
