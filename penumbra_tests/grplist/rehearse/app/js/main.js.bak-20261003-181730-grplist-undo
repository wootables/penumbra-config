        // single-column X) and per-chart filter-panel flags (they're
        // recalibrated per chart).
        var parentType = state.originalCfg.type || 'bar';
        var numericXTypes = ['histogram', 'scatter'];
        var effectiveType = (numericXTypes.indexOf(parentType) !== -1) ? 'bar' : parentType;
