    // Per-line LCS: which lines of A were removed, which of B were added, PLUS
    // the alignment the walk discovers on the way (`rows`). The alignment used to
    // be thrown away and each column rendered its own line list independently,
    // which meant the two sides drifted apart after the very first insertion -
    // row N on the left stopped being row N on the right for the whole rest of a
    // long query. Every caller that only wants the counts can still read
    // del/add; the renderer walks rows.
    //
    // The common head and tail are trimmed BEFORE the O(n*m) table is built: a
    // 900-line query with a three-line edit collapses to a three-line LCS
    // problem, so the size cap below almost never fires on real report SQL
    // (it used to reject any side over 900 lines outright).
    function _auditLineDiff(aText, bText) {
        var a = String(aText).split('\n'), b = String(bText).split('\n');
        var aN = a.length, bN = b.length;
        var head = 0;
        while (head < aN && head < bN && a[head] === b[head]) head++;
        var tail = 0;
        while (tail < (aN - head) && tail < (bN - head) && a[aN - 1 - tail] === b[bN - 1 - tail]) tail++;
        var am = a.slice(head, aN - tail), bm = b.slice(head, bN - tail);
        var n = am.length, m = bm.length;
        // Guard the PRODUCT, not each side: 2000 lines against 3 is cheap, 1200
        // against 1200 is not. Anything over the cap falls back to the raw
        // side-by-side view rather than to a dead end.
        if (n * m > 1000000) return null;
        var dp = new Array(n + 1), i, j;
        for (i = n; i >= 0; i--) {
            dp[i] = new Array(m + 1);
            for (j = m; j >= 0; j--) {
                if (i === n || j === m) dp[i][j] = 0;
                else if (am[i] === bm[j]) dp[i][j] = dp[i + 1][j + 1] + 1;
                else dp[i][j] = dp[i + 1][j] >= dp[i][j + 1] ? dp[i + 1][j] : dp[i][j + 1];
            }
        }
        var del = {}, add = {}, rows = [];
        for (i = 0; i < head; i++) rows.push({ a: i, b: i, t: 'same' });
        i = 0; j = 0;
        while (i < n && j < m) {
            if (am[i] === bm[j]) { rows.push({ a: head + i, b: head + j, t: 'same' }); i++; j++; }
            else if (dp[i + 1][j] >= dp[i][j + 1]) { del[head + i] = 1; rows.push({ a: head + i, b: null, t: 'del' }); i++; }
            else { add[head + j] = 1; rows.push({ a: null, b: head + j, t: 'add' }); j++; }
        }
        while (i < n) { del[head + i] = 1; rows.push({ a: head + i, b: null, t: 'del' }); i++; }
        while (j < m) { add[head + j] = 1; rows.push({ a: null, b: head + j, t: 'add' }); j++; }
        for (i = 0; i < tail; i++) rows.push({ a: aN - tail + i, b: bN - tail + i, t: 'same' });
        return { aLines: a, bLines: b, del: del, add: add, rows: _auditPairRuns(rows) };
    }

    // A run of deletions immediately followed by a run of additions is an EDIT,
    // not a delete-then-insert: pair them off so the old line sits directly
    // across from the line that replaced it. Without this the two sides stagger
    // and an edited line reads as two unrelated changes.
    function _auditPairRuns(rows) {
