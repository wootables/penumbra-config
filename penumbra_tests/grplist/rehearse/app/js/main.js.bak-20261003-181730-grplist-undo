    // --- Pop-out (cross-document move) support ---------------------------------
    // The old Chart.js rail had to be REBUILT on every cross-document move: its
    // attach/detach watcher is a MutationObserver hard-bound to the MAIN
    // document, so moving the console into the pop-out fired _resize(0,0) and
    // blanked the canvases (full story with _mountConsoleIn). The pulse strip's
    // sparkline is plain inline SVG - colours resolve from CSS vars at paint
    // time and size comes from its stretched viewBox - so theme switches,
    // resizes and pop-out moves all cost nothing. These two hooks survive as
    // no-ops because the pop-out engine still calls them on mount, per-resize
    // and restore; keeping that delicate code untouched is worth two stubs.
    function _reRenderAuditRailCharts() { /* inline SVG - nothing to rebuild */ }
    function _resizeAuditRailCharts() { /* viewBox stretch - nothing to resize */ }

    // Compact "Chrome 149 · Windows" from a raw UA string; null when nothing is
    // recognizable (the caller falls back to a generic "UA" chip whose title
    // still carries the full string). Order matters: Chromium UAs contain
    // Chrome/ AND Edg|OPR/, so the derivatives are tested first.
    function _auditParseUa(ua) {
        if (!ua) return null;
        var b = null, m;
        if ((m = ua.match(/Edge?\/(\d+)/)))          b = 'Edge ' + m[1];
        else if ((m = ua.match(/OPR\/(\d+)/)))       b = 'Opera ' + m[1];
        else if ((m = ua.match(/Firefox\/(\d+)/)))   b = 'Firefox ' + m[1];
        else if ((m = ua.match(/Chrome\/(\d+)/)))    b = 'Chrome ' + m[1];
        else if (/Safari\//.test(ua) && (m = ua.match(/Version\/(\d+)/))) b = 'Safari ' + m[1];
        var os = null;
        if (/Windows/.test(ua)) os = 'Windows';
        else if (/iPhone|iPad/.test(ua)) os = 'iOS';
        else if (/Mac OS X/.test(ua)) os = 'macOS';
        else if (/Android/.test(ua)) os = 'Android';
        else if (/Linux/.test(ua)) os = 'Linux';
        if (!b && !os) return null;
        return b && os ? b + ' · ' + os : (b || os);
    }

    // Short provenance for the referrer chip ("via repository", "via <report>",
    // or the external host). The full URL stays in the chip's title.
    function _auditRefLabel(ref) {
        if (!ref) return null;
        try {
            var u = new URL(ref, window.location.href);
            if (u.host === window.location.host) {
                if (u.pathname.indexOf('analytics.php') !== -1) return 'via analytics';
                var rid = u.searchParams.get('id');
                if (rid) return 'via ' + rid;
                return 'via home';
            }
            return 'via ' + u.host;
        } catch (e) {
            return ref.length > 40 ? ref.substring(0, 40) + '…' : ref;
        }
    }

    // ---- Pulse strip -------------------------------------------------------
    // One-line metrics row + 30-day sparkline, fed by response.kpis from the
    // SAME get_audit_log.php call (no extra request). Additive: hidden when
    // kpis are absent, and the strip renders without the sparkline when the
    // trend series is missing (stale PHP).
    function _auditSparkSvg(trend, w, h, titleFn) {
        if (!trend || !trend.length) return '';
        var W = w || 300, H = h || 40, P = 2, mx = 1, mxReal = 0, i;
        for (i = 0; i < trend.length; i++) if (trend[i] > mx) mx = trend[i];
        for (i = 0; i < trend.length; i++) if (trend[i] > mxReal) mxReal = trend[i];
        var pts = [];
        var stepX = (W - 2 * P) / Math.max(1, trend.length - 1);
        for (i = 0; i < trend.length; i++) {
            pts.push((P + i * stepX).toFixed(1) + ' ' + (H - P - (trend[i] / mx) * (H - 2 * P)).toFixed(1));
        }
        var line = 'M' + pts.join('L');
        var area = line + 'L' + (W - P) + ' ' + (H - P) + 'L' + P + ' ' + (H - P) + 'Z';
        var total = 0;
        for (i = 0; i < trend.length; i++) total += trend[i];
        var alt = 'Report activity: ' + total.toLocaleString() + ' opens across the last 30 days' +
                  (mxReal > 0 ? '; busiest day ' + mxReal.toLocaleString() + '.' : '.');
        // Invisible per-point hit strips give the line the same hover values
        // the hours bars already have (a transparent fill is still "painted",
        // so it receives pointer events; text stays OUTSIDE the stretched SVG).
        var hits = '';
        if (titleFn) {
            var segW = (W - 2 * P) / trend.length;
            for (i = 0; i < trend.length; i++) {
                hits += '<rect x="' + (P + i * segW).toFixed(2) + '" y="0" width="' + segW.toFixed(2) + '" height="' + H + '" fill="transparent"><title>' +
                        escapeHtml(titleFn(i, trend[i])) + '</title></rect>';
            }
        }
        return '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none" role="img" aria-label="' + escapeHtml(alt) + '">' +
                   '<path class="audit-spark-area" d="' + area + '"></path>' +
                   '<path class="audit-spark-line" d="' + line + '"></path>' + hits +
               '</svg>';
    }

    // ---- Segment machinery (Mockup C: Pulse | Events | Changes | Health) ----
    // The bar is a titled banner (2026-09-25, owner-picked mockup D): an
    // "Audit trail" label, an icon on each view, and the metrics link as a
    // solid button. `ico` = the inner nodes of a 24x24 stroke icon.
    var AUDIT_SEGS = [
        { key: 'pulse',   label: 'Pulse',   ico: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>' },
        { key: 'events',  label: 'Events',  ico: '<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>' },
        { key: 'changes', label: 'Changes', ico: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/>' },
        { key: 'health',  label: 'Health',  ico: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8z"/>' }
    ];
    // Decorative: every icon sits beside its own words.
    function _auditSegIco(inner) {
        return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' + inner + '</svg>';
    }

    // Attention rollup: totals from the 72h aggregate + whether the newest bad
    // event has been ACKed server-side (an AUDIT_ACK row at/after it). ACK
    // clears the ribbon + Health dot for EVERY admin; the localStorage dismiss
    // stays as a personal, this-browser-only fallback.
    function _auditAttention(kpis) {
        var att = kpis && kpis.attention ? kpis.attention : null;
        // + query timeouts / too-big results since 2026-09-25 (`|| 0`: an older
        // get_audit_log.php response has no `query`). Browser errors never count.
        var total = att ? (att.badpass + att.denied + att.email_fail + att.sched_fail + (att.query || 0)) : 0;
        var acked = !!(att && att.last && kpis.ack_last && kpis.ack_last >= att.last);
        return { att: att, total: total, acked: acked };
    }

    function _auditSyncSegPanels() {
        ['Pulse', 'Events', 'Changes', 'Health'].forEach(function (v) {
            $('#auditSeg' + v).toggleClass('on', v.toLowerCase() === _auditSeg);
        });
        // The banner's Pop out belongs to the Changes view alone.
        $('#auditChangesPopOut').prop('hidden', _auditSeg !== 'changes');
    }

    function renderAuditSegBar(counts, kpis, shortId) {
        var $bar = $('#auditSegBar');
        if (!$bar.length) return;
        if (!$bar.data('built')) {
            // The title is aria-hidden: the tablist's own aria-label ("Auditor
            // views") already names the group, and a tablist should own tabs.
            var h = '<span class="audit-seg-title" aria-hidden="true">' +
                    _auditSegIco('<path d="M12 2l8 3v6c0 5-3.4 9.4-8 11-4.6-1.6-8-6-8-11V5l8-3z"/><path d="M9 12l2 2 4-4"/>') + '<span class="audit-seg-title-t">Audit trail</span></span>';
            AUDIT_SEGS.forEach(function (s) {
                h += '<button type="button" class="audit-seg" role="tab" data-seg="' + s.key + '" aria-selected="false" tabindex="-1">' +
                     _auditSegIco(s.ico) + s.label + ' <span class="seg-n"></span><span class="seg-dot" style="display:none;" title="Unresolved errors - see Health"><span class="sr-only">unresolved errors</span></span></button>';
            });
            // Pop out (2026-09-28): the Changes view's full-height dialog. It was
            // a 10px link in the Changes footer; the footer is gone (its height
            // went to the list and the diff) and view-level actions live here.
            // _auditSyncSegPanels shows it only while Changes is the view. Its
            // title names the key: Ctrl+Shift+Y opens the same dialog, and while
            // this button is on screen the key clicks it (same entry kept).
            h += '<span class="audit-seg-note"><span class="audit-seg-hint">view is remembered per report &middot; </span>' +
                 '<button type="button" id="auditChangesPopOut" class="audit-seg-pop" hidden aria-label="Pop out" aria-keyshortcuts="Control+Shift+Y" ' +
                 'title="(CTRL+SHIFT+Y) Pop out this version history into a full-height dialog, still on the version you are viewing. The Auditor switches to Events, since the dialog takes over the Changes view.">' +
                 _auditSegIco('<polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>') +
                 '<span class="audit-seg-pop-t">Pop out</span></button>' +
                 '<a id="auditFootMetricsLink" href="#" target="_blank" rel="noopener">' +
                 _auditSegIco('<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>') +
                 'Report metrics &rarr;</a></span>';
            $bar.html(h).data('built', true);
        }
        $bar.find('#auditFootMetricsLink').attr('href', 'analytics.php?id=' + encodeURIComponent(shortId || ''));
        if (counts) {
            $bar.find('.audit-seg[data-seg=events] .seg-n').text((counts.total || 0).toLocaleString());
            $bar.find('.audit-seg[data-seg=changes] .seg-n').text((counts.change || 0).toLocaleString());
        }
        var a = _auditAttention(kpis);
        $bar.find('.audit-seg[data-seg=health] .seg-dot').toggle(a.total > 0 && !a.acked);
        $bar.find('.audit-seg').each(function () {
            var on = $(this).attr('data-seg') === _auditSeg;
            $(this).attr('aria-selected', on ? 'true' : 'false').attr('tabindex', on ? '0' : '-1');
        });
        _auditSyncSegPanels();
        $bar.show();
    }

    function _auditShowSeg(name) {
        if (!name || !{ pulse: 1, events: 1, changes: 1, health: 1 }[name]) return;
        _auditSeg = name;
        var shortId = _auditShortId();
        try { localStorage.setItem('penumbra_audit_seg::' + shortId, name); } catch (e) { }
        $('#auditSegBar .audit-seg').each(function () {
