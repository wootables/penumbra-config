                    if (_penumbraUrlOverrides && _penumbraUrlOverrides.snap) {
                        // Lazy snapshot boot: ?snap= means the user came to see
                        // frozen data - don't burn a live query they'll never
                        // look at (it used to run only so the snapshot could
                        // overlay it, and made snapshot links hostage to the
                        // query's speed/health). autoLoadSnapshotFromUrl
                        // renders the snapshot directly; leaving the snapshot
                        // (Restore live data / Run Query) executes the query
                        // at that point, and every snapshot-load failure path
                        // falls back to running it immediately.
                    } else if (_penumbraUrlOverrides && _penumbraUrlOverrides.snapcmp) {
                        // Comparison boot: autoCompareSnapshotFromUrl owns the
                        // run order - it fetches the baseline snapshot FIRST,
                        // arms _pendingSnapshotCompare, and only then fires the
                        // query, so the success handler can't race past an
                        // unarmed compare. Every failure path there falls back
                        // to firing the query itself.
                    } else if (_penumbraUrlOverrides && _penumbraUrlOverrides.snapab) {
                        // A-vs-B boot: autoCompareABFromUrl diffs two stored
                        // snapshots - neither side is live, so no query runs
                        // at all (mirrors the lazy ?snap= boot). Every failure
                        // path there falls back to firing the query itself.
                    } else if (_penumbraUrlOverrides && _penumbraUrlOverrides.livecmp) {
                        // Live-vs-live boot: autoCompareLiveFromUrl fetches the
                        // AGAINST report via its ?json=1 API first, arms
                        // _pendingSnapshotCompare, then fires this query
                        // itself (mirrors the ?snapcmp= run order). Every
                        // failure path there falls back to firing the query.
                    } else if (/\[\s*import/i.test(decodedState.query) && window._penumbraImportsReady) {
