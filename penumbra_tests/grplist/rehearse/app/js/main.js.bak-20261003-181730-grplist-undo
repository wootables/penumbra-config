        // minus allowed on both sides - a negative sum()/min() otherwise made
        // the whole condition silently false. Twin: evaluate_aggregate_condition_php
        // in schedule_runner.php - keep the two gates identical.
        const match = processedCondition.match(/^\s*(-?\d*\.?\d+)\s*([<>=!]+)\s*(-?\d*\.?\d+)\s*$/);
        if (!match)
