                        // comma-grouped by the end pass (engine A tokens me() output).
                        if (stringOnlyKeys.indexOf(lowerResolved) !== -1) {
                            return '\x02' + ((typeof penumbra_vars !== 'undefined' && penumbra_vars.shibboleth) ? (penumbra_vars.shibboleth[lowerResolved] || '') : '') + '\x02';
                        }
                        if (typeof penumbra_vars !== 'undefined' && penumbra_vars.shibboleth) {
                            for (var key in penumbra_vars.shibboleth) {
                                var meRegex = new RegExp('\\b' + key + '\\b', 'gi');
                                resolvedString = resolvedString.replace(meRegex, penumbra_vars.shibboleth[key]);
                            }
                        }
                        return '\x02' + resolvedString + '\x02';
                    }
                    return m; // Unhandled - return original
                });
                if (!hadMatch) break;
            }
            // Display formatting happens HERE, once, after every function has been
            // resolved with raw numbers - engine A's design, ported. See
            // penumbraFormatNumbersInHtml for why it can't happen any earlier.
            let finalHtml = penumbraFormatNumbersInHtml(result);
            // Backtick contents restore AFTER the number pass, so they are never
            // comma-formatted (see the protection block at the top of this fn).
            protectedStrings.forEach((str, index) => {
                finalHtml = finalHtml.replace(`__PROTECTED_STRING_${index}__`, () => String(str));
            });
            return { html: finalHtml, vizTasks };
    }

    /**
     * Opens a responsive, theme-aware infobox modal dialog.
     * Reusable - can be called from action(infobox, ...) or programmatically by other features.
     *
     * @param {object} opts
     * @param {string} opts.title    - Dialog title (displayed in the header)
     * @param {string} opts.content  - Inline HTML/text/JSON string, OR a URL to fetch
     * @param {string} opts.mode     - 'raw' (render HTML with DOMPurify) or 'jsontable' (parse JSON → themed table)
     * @param {boolean} [opts.isUrl=false] - If true, opts.content is treated as a URL and fetched via AJAX on open
     * @param {function} [opts.onClose] - Optional callback when dialog is closed
     */

    /**
     * Normalises a ?json=1 response into a flat array of rows.
     *
     * index.php answers an ENVELOPE, and `data` is not always a JS array:
     *   { data: [ ... ] }                      flat report
     *   { data: { Group: [ ... ] },
     *     viewMode: 'grouped' }                grouped report (index.php ~694)
     *   { data: { "0": {...}, "1": {...} } }   PHP json_encode renders ANY
     *                                          non-sequential array as an OBJECT
     *   { error: "..." }                       the endpoint refused
     * A hand-written bare array passes straight through.
     *
     * @returns {{rows: Array}|{error: string}}
     */
    function penumbraNormalizeJsonEnvelope(parsed) {
        if (Array.isArray(parsed)) return { rows: parsed };
        if (!parsed || typeof parsed !== 'object') return { rows: [] };
        if (typeof parsed.error === 'string' && parsed.error) return { error: parsed.error };
        if (parsed.data && typeof parsed.data === 'object') {
            if (Array.isArray(parsed.data)) return { rows: parsed.data };
            // An object: either grouped ({ Group: [rows] }) or numeric-keyed rows.
            // Flatten groups back to rows - this renders one flat table, and
            // showing every row beats showing a key/value blob.
            const vals = Object.keys(parsed.data).map(k => parsed.data[k]);
            return { rows: vals.length && vals.every(Array.isArray) ? [].concat.apply([], vals) : vals };
        }
        return { rows: [] };
    }

    /**
     * Renders rows as a nested data-grid table PLUS the sibling .raw-json-data
     * the nested-table sort handler (~14036) re-reads to sort and re-render.
     * Both must be direct children of one wrapper or the header arrows draw but
     * sort nothing. Same shape formatCellContent() gives a grid cell.
     */
    /**
     * ?json=1 cells arrive ENTITY-ENCODED (query.php encodes every cell), and
     * createTableFromJson escapes on output - so without a decode pass a cell
     * holding R&D displayed as R&amp;D (user-caught 2026-08-24). Decode every
     * string cell ONCE, markup-safely (real < > survive as text; the engine's
     * decoder guards them). @@JSON payloads are skipped - query.php passes
     * those through unencoded. Keys decode too (headers render from them),
     * keeping the original on the rare decoded-name collision. Runs BEFORE
     * penumbraRenderJsonTable so the .raw-json-data blob (sorting, exports)
     * holds the decoded rows as well.
     */
    function penumbraDecodeJsonRows(rows) {
        const dec = (window.PenumbraTiles && PenumbraTiles.decodeEntities)
            ? PenumbraTiles.decodeEntities
            : (s) => { const t = document.createElement('textarea'); t.innerHTML = String(s).replace(/</g, '&lt;'); return t.value; };
        const decVal = (v) => {
            if (typeof v !== 'string' || v.indexOf('&') === -1) return v;
            if (v.indexOf('@@JSON') === 0) return v;
            return dec(v);
        };
        return rows.map((row) => {
            if (row === null || typeof row !== 'object' || Array.isArray(row)) return decVal(row);
            const out = {};
            for (const k of Object.keys(row)) {
                const dk = decVal(k);
                out[(dk !== k && Object.prototype.hasOwnProperty.call(row, dk)) ? k : dk] = decVal(row[k]);
            }
            return out;
        });
    }

    function penumbraRenderJsonTable(rows) {
        return '<div class="infobox-jsontable">' + createTableFromJson(rows, '') +
            '<div class="raw-json-data" style="display:none;">' +
            escapeHtml(JSON.stringify(rows)) + '</div></div>';
    }

    /**
     * True when a failed XHR means "your Shibboleth session died", not "the
     * report is broken". An expired session answers a GET with a 302 to the IdP;
     * that redirect is CROSS-ORIGIN, so the browser blocks reading it and jQuery
     * reports status 0 - you never get a readable login page to sniff for.
     * Shows the shared re-auth toast (which also closes .infobox-overlay).
     */
    // Takes either an xhr or the flagged Error a lazy asset load rejects with
    // once penumbraProbeAssetForExpiry has already confirmed the session died -
    // in that case the dialog is up and this just answers "handled, stay quiet".
    function penumbraHandledAsSessionExpiry(xhr) {
        if (xhr && xhr.sessionExpired) return true;
        if (xhr && (xhr.status === 0 || xhr.status === 403)) {
            handleSessionExpiredError();
            return true;
        }
        return false;
    }

    // True for relative URLs and absolute URLs on THIS origin. The app's CSP is
    // connect-src 'self': a cross-origin XHR is blocked by the browser before it
    // leaves, and surfaces as status 0 - the very signature the handler above
    // reads as "your session died". Every infobox URL fetch checks this FIRST, so
    // an author who points jsontable| at another host is told the real reason
    // instead of being asked to sign in again. (www3 and oitras are different
    // origins too - relative URLs are the safe spelling.)
    function penumbraIsSameOriginUrl(url) {
        if (window.PenumbraTiles && typeof PenumbraTiles.isSameOrigin === 'function') return PenumbraTiles.isSameOrigin(url);
        try {
            const u = new URL(String(url), window.location.href);
            return u.origin === window.location.origin && (u.protocol === 'http:' || u.protocol === 'https:');
        } catch (e) { return false; }
    }
    function penumbraCrossOriginMessage() {
        return (window.PenumbraTiles && PenumbraTiles.CROSS_ORIGIN_MSG) ||
            "Only same-origin (Penumbra) URLs can be fetched: the browser's security policy (Content-Security-Policy connect-src 'self') blocks cross-origin requests.";
    }

    /**
     * The link an action(infobox, LABEL, 'tile|...') / 'embed|...' renders (both
     * engines). The payload is a SPEC for the shared tile engine
     * (js/penumbra_tiles.js), stored in the registry like raw content and
     * rendered at click time by penumbraRenderInfoboxTiles().
     *
     * Depth guard: inside an EMBEDDED page (a dashboard embed tile, or an embed|
     * infobox's own frame - body.embed-view) an embed| link opens the report in a
     * new tab instead of framing a page inside a frame inside a dialog.
     */
    function penumbraInfoboxTileLink(mode, payload, linkText, rowData, columns) {
        const T = window.PenumbraTiles;
        if (!T) {
            return `<span class="snippet-action-disabled" title="js/penumbra_tiles.js did not load">${htmlEncode(linkText)}</span>`;
        }
        if (mode === 'embed' && document.body && document.body.classList.contains('embed-view')) {
            const p = T.parseEmbedSpec(payload);
            if (p.error) return `<span class="snippet-action-disabled" title="${htmlEncode(p.error)}">${htmlEncode(linkText)}</span>`;
            const href = T.openUrl(p.spec, { via: 'infobox ' + penumbraCurrentReportId() });
            // Deliberately NOT .snippet-action: the delegated click handler would
            // swallow the navigation. A plain link inherits the theme's link style.
            return `<a href="${htmlEncode(href)}" target="_blank" rel="noopener" title="Opens the report in a new tab (an embedded page does not open embeds within embeds)">${htmlEncode(linkText)}</a>`;
        }
        const key = 'ib_' + Math.random().toString(36).substr(2, 9);
        _infoboxContentRegistry[key] = { snippet: payload, rowData: rowData, columns: columns, mode: mode };
        return `<a href="#" class="snippet-action" data-action-name="infobox" data-action-value="${htmlEncode(key)}" data-action-mode="${htmlEncode(mode)}" data-action-isurl="0">${htmlEncode(linkText)}</a>`;
    }
    function penumbraCurrentReportId() {
        try { return (new URLSearchParams(window.location.search).get('id') || '').trim() || 'report'; }
        catch (e) { return 'report'; }
    }

    /**
     * Renders the tile| and embed| infobox modes into an OPEN dialog's body.
     *
     *   embed|REPORT[?show=header|table|chart&chart=N&search=...&height=...&<prompt>=v]
     *       -> the real report page (or one section / one chart) framed in the
     *          dialog, auto-sized to its content like a dashboard embed tile.
     *   tile|{spec} or tile|[{spec},...]
     *       -> stat / chart / table / note / embed cards, each over its own
     *          source: live report (?json=1), newest snapshot, same-origin JSON
     *          URL, inline JSON, or 'current' = THIS report's rows (the rowData
     *          the infobox already holds).
     *
     * Everything data-shaped is PenumbraTiles' - the same functions a dashboard
     * tile runs - so a tile reads identically in both hosts; this function only
     * owns the dialog-side chrome (cards, feet, error slots, chart tracking).
     *
     * @param {object} o  { dialogId, mode, payload, rowData, columns, charts,
     *                      isClosed(), title }
     */
    function penumbraRenderInfoboxTiles(o) {
        const $body = $(`#${o.dialogId}_body`);
        if (!$body.length) return;
        const T = window.PenumbraTiles;
        if (!T) { $body.html('<div class="pnb-tile-err">The tile engine (js/penumbra_tiles.js) did not load.</div>'); return; }
        const via = 'infobox ' + penumbraCurrentReportId();
        const pageTheme = (document.body.className.match(/\btheme-[\w-]+\b/) || [''])[0];
        const fits = [];
        $(`#${o.dialogId}`).data('pnbFits', fits);
        const errBox = (msg) => `<div class="pnb-tile-err">${escapeHtml(msg)}</div>`;
        const frameMax = () => Math.max(240, Math.floor(window.innerHeight * 0.78));

        // ---- embed| : the framed section IS the dialog -------------------------
        if (o.mode === 'embed') {
            const p = T.parseEmbedSpec(o.payload);
            if (p.error) { $body.html(errBox(p.error)); return; }
            const spec = p.spec;
            // fstheme only when the embed| spec names a theme: an explicit theme=
            // should reach the carousel too; otherwise the snippet's pin stands.
            const src = T.embedUrl(spec, { theme: spec.theme || pageTheme, fstheme: spec.theme || '', via: via });
            const fixedH = spec.height ? String(spec.height).trim() : '';
            const $fr = $('<iframe class="pnb-embed-frame"></iframe>')
                .attr('title', o.title || spec.report)
                .attr('src', src);
            if (fixedH && fixedH !== 'auto') { $fr.css('height', /^\d+$/.test(fixedH) ? fixedH + 'px' : fixedH); }
            const openHref = T.openUrl(spec, { via: via });
            $body.empty().append($fr).append(
                `<div class="pnb-embed-note"><a href="${escapeHtml(openHref)}" target="_blank" rel="noopener">Open the full report &#8599;</a></div>`);
            // Auto-height: measure the framed page exactly as a dashboard embed
            // tile does (between a floor and ~78% of the viewport; past that the
            // frame scrolls inside). One-chart embeds are a fixed carousel stage
            // - the page behind the overlay would be measured - so they keep
            // the CSS height.
            if (spec.show !== 'chart' && (!fixedH || fixedH === 'auto')) {
                // Header-only: the banner IS the frame - size it exactly (no
                // bottom slack, a lower floor) so the card meets every edge.
                // Table/full frames keep a TALL floor instead: a pivot-on-load
                // report's scroll region sizes itself to whatever the frame is
                // (it can never "grow" the measurement), so a low floor showed
                // one row forever - give elastic views real room up front.
                const isHdr = spec.show === 'header';
                if (isHdr) $fr.addClass('pnb-embed-header');
                fits.push(T.fitFrameHeight($fr[0], { min: isHdr ? 60 : Math.min(560, frameMax()), max: frameMax(), slack: isHdr ? 0 : 10 }));
            }
            return;
        }

        // ---- tile| : cards ------------------------------------------------------
        const p = T.parseTileSpec(o.payload);
        if (p.error) { $body.html(errBox(p.error)); return; }
        const specs = p.specs;
        const cardLabel = (s) => s.label || (s.type === 'note' ? '' : (s.report ||
            (s.url ? 'JSON URL' : (T.effectiveSource(s) === 'current' ? 'This report' : 'Inline data'))));
        let html = '<div class="pnb-tiles">';
        specs.forEach((s, i) => {
            const badge = T.sourceBadge(s);
            const label = cardLabel(s);
            const open = (s.type !== 'note' && s.report)
                ? `<a class="pnb-tile-open" href="${escapeHtml(T.openUrl(s, { via: via }))}" target="_blank" rel="noopener" title="Open the source report (with this tile's prompt values)">&#8599;</a>`
                : '';
            html += `<div class="pnb-tile pnb-tile-${escapeHtml(s.type)}" data-pnb-tile="${i}" style="--pnb-tile-w:${s.w};--pnb-tile-h:${s.h};">` +
                (s.type === 'note' ? '' :
                    `<div class="pnb-tile-head"><span class="pnb-tile-label" title="${escapeHtml(label)}">${escapeHtml(label)}</span>` +
                    (badge.text ? `<span class="pnb-tile-badge" title="${escapeHtml(badge.title)}">${escapeHtml(badge.text)}</span>` : '') +
                    open + '</div>') +
                '<div class="pnb-tile-body"><div class="pnb-tile-wait"><span class="pnb-tile-spin"></span></div></div>' +
                '<div class="pnb-tile-foot"></div></div>';
        });
        html += '</div>';
        $body.html(html);

        // Chart.js is lazy on the report page (the infobox's vis() path loads it
        // the same way); only wait for it when a chart card exists.
        const needChart = specs.some((s) => s.type === 'chart');
        const chartReady = needChart
            ? loadScript("js/chart-4.5.1.min.js").then(function () { return penumbraLoadChartModule(); })
            : Promise.resolve();

        specs.forEach((s, i) => {
            const $tile = $body.find(`.pnb-tile[data-pnb-tile="${i}"]`);
            const $tb = $tile.find('.pnb-tile-body');
            const $tf = $tile.find('.pnb-tile-foot');
            if (s.type === 'note') { T.renderNote($tb, s.text); return; }
            if (s.type === 'embed') {
                const src = T.embedUrl(s, { theme: s.theme || pageTheme, fstheme: s.theme || '', via: via });
                $tb.html(`<iframe src="${escapeHtml(src)}" title="${escapeHtml(cardLabel(s))}"></iframe>`);
                if (s.show !== 'chart') {
                    fits.push(T.fitFrameHeight($tb.find('iframe')[0], { min: Math.max(120, s.h * 150 - 40), max: frameMax(), slack: s.show === 'header' ? 0 : 10 }));
                }
                return;
            }
            T.fetchRows(s, { currentRows: o.rowData, currentColumns: o.columns })
                .then((data) => chartReady.then(() => data))
                .then((data) => {
                    if (o.isClosed()) return;
                    const bits = [T.fmtNumber(data.totalRows, 0) + ' rows'];
                    if (data.asOf) bits.push('as of ' + escapeHtml(String(data.asOf).substring(0, 16)));
                    $tf.html(bits.join(' &middot; '));
                    const res = T.renderInto($tb, s, data);
                    if (res.error) { $tb.html(errBox(res.error)); return; }
                    if (res.chart) {
                        // Tracked for destroy-on-close; if the dialog already went
                        // away while the data was in flight, destroy now.
                        if (o.isClosed()) { try { res.chart.destroy(); } catch (e) { } }
                        else o.charts.push(res.chart);
                    }
                })
                .catch((err) => {
                    if (o.isClosed()) return;
                    // A dead session answers with status 0 (cross-origin redirect
                    // to the IdP); a 403 is the fail-closed "not your report".
                    if (err && err.status === 0) handleSessionExpiredError();
                    $tb.html(errBox(T.errorMessage(err)));
                    $tf.empty();
                });
        });
    }

    function showInfoboxDialog(opts) {
        const dialogId = 'infoboxDialog_' + Date.now();
        const title = opts.title || 'Info';
        const mode = (opts.mode || 'raw').toLowerCase();
        const isUrl = opts.isUrl || false;
        const onClose = opts.onClose || null;
        const headerHtml = opts.headerHtml || '';
        // Registry key of the action(infobox) that opened this dialog, when
        // there is one. Stamped on the overlay so a chart canvas rendered
        // inside can be traced back to its _infoboxContentRegistry entry -
        // that's how _penumbraChartPageNumber gives infobox charts a real
        // fspages number (registry-harvested carousel entries carry
        // canvas:null, so canvas identity can never match them).
        const registryKey = (!isUrl && opts.registryKey) ? String(opts.registryKey) : '';

        // Breakdown / drill-down tables (their content carries .infobox-drill-table)
        // get the table glyph; every other infobox keeps the info 'i'. Callers may
        // also force it with opts.icon: 'breakout' | 'info'.
        const headerIconId = (opts.icon === 'breakout' ||
            (opts.icon !== 'info' && typeof opts.content === 'string' && opts.content.indexOf('infobox-drill-table') !== -1))
            ? 'pnbi-breakout' : 'pnbi-info';

        const dialogHtml = `
        <div id="${dialogId}" class="modal-prompt-overlay infobox-overlay"${registryKey ? ` data-infobox-key="${escapeHtml(registryKey)}"` : ''}>
            <div class="modal-prompt-box infobox-dialog" style="position:relative;">
                <div class="pnb-dlg-head">
                    <span class="pnb-dlg-ico" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#${headerIconId}"/></svg></span>
                    <div class="pnb-dlg-tt">
                        <h3 class="pnb-dlg-title" id="${dialogId}_title">${escapeHtml(title)}</h3>
                    </div>
                    ${headerHtml ? `<span class="pnb-dlg-action infobox-head-action">${headerHtml}</span>` : ''}
                    <button class="close-lightbox" aria-label="Close" title="Close (Esc)">&times;</button>
                </div>
                <div class="modal-prompt-content infobox-content">
                    <div class="infobox-body" id="${dialogId}_body">
                        ${isUrl ? '<div class="infobox-loading"><span class="infobox-spinner"></span> Loading...</div>' : ''}
                    </div>
                </div>
                <div class="modal-prompt-buttons" style="justify-content: flex-end;">
                    <button id="${dialogId}_ok" class="modal-btn-primary">OK</button>
                </div>
            </div>
        </div>`;

        // _pnbModalHost: infoboxes are raised from report cells AND from the
        // console's table list, so build this where the user is looking.
        window._pnbModalHost().append(dialogHtml);

        // Store optional drill-down search string on the dialog element
        if (opts._drillSearchString) {
            $(`#${dialogId}`).data('drill-search', opts._drillSearchString);
        }

        // Close handlers - ESC is handled by the global keydown handler (which detects .infobox-overlay:visible)
        const infoboxCharts = [];
        let dialogClosed = false;
        const closeDialog = () => {
            dialogClosed = true;
            // Destroy any Chart.js instances tracked at creation time
            infoboxCharts.forEach(c => { try { c.destroy(); } catch (e) { } });
            // Stop the frame-fit observers/pollers of embed| content (tile engine).
            const pnbFits = $(`#${dialogId}`).data('pnbFits');
            if (pnbFits) pnbFits.forEach(f => { try { f.stop(); } catch (e) { } });
            // Also destroy any charts created after tracking (filter rebuilds, slow-network async)
            $(`#${dialogId}`).find('canvas').each(function () {
                var inst = (typeof Chart !== 'undefined') && Chart.getChart ? Chart.getChart(this) : null;
                if (inst) { try { inst.destroy(); } catch (e) { } }
            });
            // Destroy all open tooltips (jQuery UI + chart filter tip)
            $('.ui-tooltip').stop(true, true).remove();

            $(`#${dialogId}`).fadeOut(150, function () {
                $(this).remove();
                if (onClose) onClose();
            });
        };

        $(`#${dialogId}_ok`).on('click', closeDialog);
        $(`#${dialogId} .close-lightbox`).on('click', closeDialog);

        // Click overlay to close
        $(`#${dialogId}`).on('click', function (e) {
            if ($(e.target).hasClass('infobox-overlay')) closeDialog();
        });


        // Render content into the dialog body
        const renderContent = (data) => {
            const $body = $(`#${dialogId}_body`);
            if (!$body.length) return;

            if (mode === 'jsontable') {
                try {
                    let parsed;
                    if (typeof data === 'string') {
                        parsed = JSON.parse(data);
                    } else {
                        parsed = data;
                    }

                    const norm = penumbraNormalizeJsonEnvelope(parsed);
                    if (norm.rows) { norm.rows = penumbraDecodeJsonRows(norm.rows); }
                    if (norm.error) {
                        // The endpoint refused (bad key, bad id, SQL error).
                        // Say so, instead of rendering {error:"..."} as a table.
                        $body.html(`<div style="color: var(--accent-danger, #e74c3c); padding: 10px;"><strong>The report returned an error:</strong><br>${escapeHtml(norm.error)}</div>`);
                        return;
                    }
                    $body.html(penumbraRenderJsonTable(norm.rows));
                } catch (e) {
                    $body.html(`<div style="color: #e74c3c; padding: 10px;"><strong>JSON Parse Error:</strong> ${escapeHtml(e.message)}<br><br><pre style="white-space: pre-wrap; font-size: 11px; opacity: 0.7;">${escapeHtml(String(data).substring(0, 500))}</pre></div>`);
                }
            } else {
                // raw mode - sanitize with DOMPurify, then restore canvas placeholders
                // Canvas elements are replaced with <div> placeholders before sanitization
                // and restored after, so DOMPurify can't strip them.
                let safeData = data;
                const canvasMap = {};
                safeData = safeData.replace(/<canvas\b[^>]*id=["']([^"']+)["'][^>]*><\/canvas>/gi, (m, id) => {
                    const placeholder = `<div data-infobox-canvas="${id}"></div>`;
                    canvasMap[id] = m;
                    return placeholder;
                });
                if (typeof DOMPurify !== 'undefined') {
                    safeData = DOMPurify.sanitize(safeData, {
                        ADD_ATTR: ['style', 'class', 'id', 'src', 'alt', 'target', 'href', 'width', 'height', 'data-infobox-canvas', 'data-infobox-jsontable', 'data-sort-type', 'data-sort-val', 'data-action-name', 'data-action-value', 'data-action-mode', 'data-action-isurl'],
                        ADD_TAGS: ['table', 'thead', 'tbody', 'tfoot', 'tr', 'th', 'td', 'img']
                    });
                } else {
                    safeData = escapeHtml(safeData);
                }
                $body.html(safeData);
                // Restore canvas elements from placeholders
                $body.find('[data-infobox-canvas]').each(function () {
                    const canvasId = $(this).attr('data-infobox-canvas');
                    if (canvasMap[canvasId]) {
                        $(this).replaceWith(canvasMap[canvasId]);
                    }
                });
            }
        };

        if (mode === 'tile' || mode === 'embed') {
            // Shared tile engine (js/penumbra_tiles.js): stat/chart/table cards
            // over another report (live / snapshot / same-origin JSON / inline)
            // or this report's own rows, and framed report sections. The same
            // code renders dashboard tiles - nothing data-shaped lives here.
            const renderTiles = () => penumbraRenderInfoboxTiles({
                dialogId: dialogId,
                mode: mode,
                payload: opts.content,
                rowData: opts.rowData || [],
                columns: opts.columns || [],
                charts: infoboxCharts,
                isClosed: () => dialogClosed,
                title: title
            });
            // Embeds mount an iframe with no XHR of their own, so an expired
            // Shibboleth session used to render as a browser-crash-looking
            // error page INSIDE the frame (the IdP redirect dies cross-origin
            // there, out of reach of every handler). Probe a tiny same-origin
            // asset first: on expiry the probe raises the shared sign-in
            // dialog itself (and fades this overlay with the rest).
            if (mode === 'embed' || /"type"\s*:\s*"embed"/.test(String(opts.content))) {
                $(`#${dialogId}_body`).html('<div class="pnb-tile-wait"><span class="pnb-tile-spin"></span></div>');
                penumbraProbeAssetForExpiry('css/penumbra_tiles.css?pnbSsoProbe=' + Date.now()).then((expired) => {
                    if (!expired && !dialogClosed) renderTiles();
                });
            } else {
                renderTiles();
            }
        } else if (isUrl && !penumbraIsSameOriginUrl(opts.content)) {
            // Refuse cross-origin up front: CSP (connect-src 'self') would block
            // the XHR with status 0, which the failure path below reads as an
            // expired session - the wrong diagnosis for a wrong URL.
            $(`#${dialogId}_body`).html(`<div style="color: var(--accent-danger, #e74c3c); padding: 10px;"><strong>This URL cannot be fetched.</strong><br>${escapeHtml(penumbraCrossOriginMessage())}<br><small>${escapeHtml(opts.content)}</small></div>`);
        } else if (isUrl) {
            // Fetch URL content on click
            $.ajax({
                url: opts.content,
                type: 'GET',
                dataType: mode === 'jsontable' ? 'json' : 'html',
                timeout: 30000
            }).done(function (data) {
                renderContent(data);
            }).fail(function (xhr, status, error) {
                // Without this the infobox blamed the report ("Failed to load:
                // error") for what is really "you are logged out".
                if (penumbraHandledAsSessionExpiry(xhr)) return;
                const $body = $(`#${dialogId}_body`);
                if ($body.length) {
                    $body.html(`<div style="color: #e74c3c; padding: 10px;"><strong>Failed to load:</strong> ${escapeHtml(error || status)}<br><small>${escapeHtml(opts.content)}</small></div>`);
                }
            });
        } else {
            // Resolve snippet functions if we have data context
            const rowData = opts.rowData || [];
            const cols = opts.columns || [];
            let contentToRender = opts.content;
            let vizTasks = [];

            // --- jsontable(URL) inside raw| content ---------------------------
            // Swap each call for a placeholder div, then fill it after render -
            // the same deferral vis() uses for its canvases, because the fetch is
            // async and this render is not.
            //
            // This runs BEFORE resolveInfoboxSnippet() to keep the URL opaque to
            // every later pass, including DOMPurify.
            //
            // CORRECTION (2026-07-29): this comment used to claim engine B has a
            // number-format pass that would turn `?id=123456` into `?id=123,456`.
            // It does not - only engine A has a whole-output pass, and B formats
            // at its numeric handler returns instead, which never touches a URL.
            // The claim was wrong and it masked the real A/B number divergence for
            // a long time, so it is called out rather than quietly deleted.
            //
            // `[^()]` for the URL means a literal ')' in a URL ends the call
            // early - percent-encode it as %29.
            const jsonTableTasks = [];
            contentToRender = String(contentToRender == null ? '' : contentToRender)
                .replace(/jsontable\(\s*([^()]+?)\s*\)/gi, function (m, rawUrl) {
                    const slotId = 'ibjt_' + jsonTableTasks.length + '_' + Math.random().toString(36).substr(2, 6);
                    // Matched-pair strip: a query string can legitimately end with a
                    // quote (`?q="a"`), and a surviving leading quote defeats isUrl.
                    jsonTableTasks.push({ id: slotId, url: stripWrappingQuotePair(rawUrl).trim() });
                    return `<div data-infobox-jsontable="${slotId}"></div>`;
                });

            // Zero-row gate carries engine B's FULL resolvable-name set (twin of
            // resolveInfoboxSnippet's fnRegex - keep them in step): the old
            // 19-name subset skipped resolution for content using only e.g.
            // string()/lookup()/date_format()/me(), showing raw call text.
            if (rowData.length > 0 || /\b(noweb|web|filter_strip|layout_switch|toggle_switch|info|vis|calc|progress_bar|sparkline|count|sum|avg|min|max|distinct|action|chain|median|mode|now|rank|percentile|stddev|lookup|date_diff|date_format|round|abs|floor|ceil|mod|fixed|me|data|string|case)\s*\(/i.test(contentToRender)) {
                const resolved = resolveInfoboxSnippet(contentToRender, rowData, cols);
                contentToRender = resolved.html;
                vizTasks = resolved.vizTasks;
            } else {
                // No snippet pass to consume the author's backticks (a report with
                // no rows, text with no calls): drop them here, as engine B would.
                contentToRender = contentToRender.replace(/`([^`]+)`/g, function (m, c) { return c; });
            }

            renderContent(contentToRender);

            // Fill each jsontable(URL) placeholder - the divs are in the DOM now.
            // Every slot fetches independently, so one dead URL can't blank the
            // prose or the other tables around it.
            jsonTableTasks.forEach(function (task) {
                const $slot = $(`#${dialogId}_body`).find(`[data-infobox-jsontable="${task.id}"]`);
                if (!$slot.length) return;
                if (!penumbraIsSameOriginUrl(task.url)) {
                    // Same reason as the URL-mode check above: say "wrong origin",
                    // never "session expired".
                    $slot.html(`<div style="color: var(--accent-danger, #e74c3c); padding: 8px;"><strong>This URL cannot be fetched.</strong><br>${escapeHtml(penumbraCrossOriginMessage())}<br><small>${escapeHtml(task.url)}</small></div>`);
                    return;
                }
                $slot.html('<div class="infobox-loading"><span class="infobox-spinner"></span> Loading...</div>');
                $.ajax({ url: task.url, type: 'GET', dataType: 'json', timeout: 30000 })
                    .done(function (data) {
                        try {
                            const parsed = (typeof data === 'string') ? JSON.parse(data) : data;
                            const norm = penumbraNormalizeJsonEnvelope(parsed);
                            if (norm.rows) { norm.rows = penumbraDecodeJsonRows(norm.rows); }
                            if (norm.error) {
                                $slot.html(`<div style="color: var(--accent-danger, #e74c3c); padding: 8px;"><strong>The report returned an error:</strong><br>${escapeHtml(norm.error)}</div>`);
                                return;
                            }
                            // replaceWith, not html(): the sort handler reads its
                            // source from .raw-json-data as a SIBLING of the
                            // table, so .infobox-jsontable must be their parent.
                            $slot.replaceWith(penumbraRenderJsonTable(norm.rows));
                        } catch (e) {
                            $slot.html(`<div style="color: var(--accent-danger, #e74c3c); padding: 8px;"><strong>JSON Parse Error:</strong> ${escapeHtml(e.message)}</div>`);
                        }
                    })
                    .fail(function (xhr, status, error) {
                        if (penumbraHandledAsSessionExpiry(xhr)) return;
                        $slot.html(`<div style="color: var(--accent-danger, #e74c3c); padding: 8px;"><strong>Failed to load:</strong> ${escapeHtml(error || status)}<br><small>${escapeHtml(task.url)}</small></div>`);
                    });
            });

            // Render deferred vis() charts into the dialog (canvases are now in the DOM)
            if (vizTasks.length > 0) {
                (async () => {
                    try {
                        await loadScript("js/chart-4.5.1.min.js");
                        await loadScript("js/chartjs-plugin-datalabels-2.0.0.min.js");
                        await loadScript("js/chartjs-chart-treemap-3.1.0.min.js");
                        await penumbraLoadChartModule();
                        if (window.ChartDataLabels) Chart.register(ChartDataLabels);

                        for (const task of vizTasks) {
                            const canvasEl = document.getElementById(task.id);
                            if (!canvasEl) continue;
                            // Reconstruct comboSeriesArr for infobox combo charts
                            var _icsArr = ((task.config.type === 'combo' || task.config.type === 'butterfly') && task.config.comboSeries) ? task.config.comboSeries : null;
                            const chartData = generateChartDataFromMaps(task.data, task.config.xAxis, task.config.yAxis, task.config.groupBy, task.config.agg, task.config.limit, task.config.type, task.config.sortBy, task.config.sortDir, task.config.stackOrder, task.config.normalize, task.config.otherBucket, _icsArr, task.config.funnelMode, task.config);
                            // Guard: no chartable data (zero rows / all-blank x-axis)
                            if (chartData._noData) {
                                $(`#${task.id}`).replaceWith(`<div style="text-align:center; padding:12px; border:1px dashed var(--text-muted, #999); border-radius:6px; color:var(--text-muted, #999); font-size:11px; display:inline-block;"><strong>No matching data</strong><br>${chartData._noData}</div>`);
                                continue;
                            }
                            // Guard: too many groups → inline error
                            if (chartData._groupByError) {
                                $(`#${task.id}`).replaceWith(`<div style="text-align:center; padding:12px; border:1px dashed #c0392b; border-radius:6px; background:#fdf2f2; color:#c0392b; font-size:11px; display:inline-block;"><strong>&#9888; Too Many Groups</strong><br>${chartData._groupByError}</div>`);
                                continue;
                            }
                            // Guard: scatter with non-numeric axes → inline error
                            if (chartData._scatterError) {
                                $(`#${task.id}`).replaceWith(`<div style="text-align:center; padding:12px; border:1px dashed #c0392b; border-radius:6px; background:#fdf2f2; color:#c0392b; font-size:11px; display:inline-block;"><strong>&#9888; No Valid Scatter Data</strong><br>${chartData._scatterError}</div>`);
                                continue;
                            }
                            if (typeof renderSnippetChart === 'function') {
                                // Percentage width: now that the dialog is on screen,
                                // re-resolve against the infobox's actual content box so
                                // 100% = the full available width INSIDE the infobox.
                                if (canvasEl.getAttribute('data-viz-wpct')) {
                                    var _ibBase = canvasEl.closest('.infobox-content') || canvasEl.parentElement;
                                    var _ibPx = penumbraResolveVizDim(task.config.width, { baseEl: _ibBase, fallback: 800 }).px;
                                    var _ibHpx = penumbraResolveVizDim(task.config.height, { height: true, fallback: 300 }).px;
                                    canvasEl.setAttribute('width', _ibPx);
                                    canvasEl.setAttribute('height', _ibHpx);
                                    canvasEl.style.width = _ibPx + 'px';
                                    canvasEl.style.height = _ibHpx + 'px';
                                }
                                if (task.config.trendLine && task.config.trendLine !== 'none') injectTrendDataset(chartData, task.config.trendLine);
                                renderSnippetChart(task.id, task.config.type, chartData, task.config.title, task.config.legend, task.config.values, task.config.legendPos, task.config.valuePos, task.config.animate, task.config.stacked, task.config.horizontal, task.config.titlePos, task.config.isCurrency, task.config.normalize, task.config.subtitle, task.config.xAxisLabel, task.config.yAxisLabel, task.config.logScale, task.config.yMin, task.config.yMax, _icsArr, task.config.comboFill, task.config.referenceLine);
                                // Attach vizConfig so label/legend click-to-filter works
                                $(`#${task.id}`).data('vizConfig', task.config);
                                // Cache source rows for single-click drill-down
                                $(`#${task.id}`).data('sourceRowData', task.data);

                                // --- SETTINGS COG + FILTER STATE ---
                                // Wrap every chart so the settings cog appears;
                                // filter state is built conditionally inside
                                // buildChartFilterPanel based on config flags.
                                var $ifc = $(`#${task.id}`);
                                var ifcChart = Chart.getChart($ifc[0]);
                                $ifc.wrap('<div class="penumbra-chart-filter-wrapper"></div>');
                                var ifcWrapper = $ifc.parent()[0];
                                $(ifcWrapper).css({ width: '100%' });
                                $(ifcWrapper).data('sourceRowData', task.data);
                                buildChartFilterPanel(ifcWrapper, ifcChart, task.config, chartData);

                                // Track for cleanup on close; if dialog was already dismissed
                                // while scripts were loading, destroy the instance immediately
                                const chartInstance = Chart.getChart(canvasEl);
                                if (chartInstance) {
                                    if (dialogClosed) {
                                        try { chartInstance.destroy(); } catch (e) { }
                                    } else {
                                        infoboxCharts.push(chartInstance);
                                    }
                                }
                            }
                        }
                    } catch (e) {
                        console.error("Infobox vis() error:", e);
                        // Expired session: sign-in dialog is up and the canvases
                        // are fine - keep them for the retry (same as the main
                        // deferred-viz path).
                        if (!penumbraHandledAsSessionExpiry(e)) {
                            vizTasks.forEach(t => $(`#${t.id}`).replaceWith(`<span style="color:var(--accent-danger, #cc0000); font-size:11px;">[Chart Error: ${e.message}]</span>`));
                        }
                    }
                })();
            }
        }

        // Fade in
        $(`#${dialogId}`).css('display', 'flex').hide().fadeIn(150);
    }

    // Expose globally so other features can call it
    window.showInfoboxDialog = showInfoboxDialog;

    /**
     * Shows a prompt dialog based on the prompt configuration
     * REVISED: Uses unified modal styling with theme support.
     * UPDATE: Label font size increased; Multi-select now fills vertical space (flex-grow).
     * @param {object} promptConfig - The parsed prompt configuration
     * @param {any} [prefillValue=null] - The specific value(s) to pre-fill (from saved state), overriding the default
     * @returns {Promise<string|null>} The user's input or null if cancelled
     */
    function showPromptDialog(promptConfig, prefillValue = null) {
        return new Promise(async (resolve, reject) => {
            const dialogId = 'promptDialog_' + Date.now();
            let inputHtml = '';

            let themeBg = '';
            // Wolfpack and the default light theme get a near-white dialog bg;
            // other themes inherit. Preserves the prior per-theme behavior.
            var _promptTid = currentThemeId();
            if (_promptTid === 'theme-wolfpack' || _promptTid === 'theme-default') {
                themeBg = 'background-color: #fcfcfc';
            }

            // Determine initial value.
            // prefillValue may be a plain string OR a {value, display} object -
            // the latter is used when re-opening an autofill text/textarea prompt
            // whose previous selection has a friendly display distinct from the
            // underlying value (e.g. "Limon, Bruce (4095)" → unique_id GUID).
            let initialValue = prefillValue;
            let initialSelectedValue = null;
            if (prefillValue && typeof prefillValue === 'object' && !Array.isArray(prefillValue)
                && prefillValue.value !== undefined && prefillValue.display !== undefined) {
                initialValue = prefillValue.display;
                initialSelectedValue = prefillValue.value;
            }
            if (initialValue === null) {
                if (promptConfig.type === 'multi-select') {
                    let rawDefault = promptConfig.forcedefault !== null ? promptConfig.forcedefault : (promptConfig.default || '');
                    initialValue = parseMultiSelectDefault(rawDefault);
                } else {
                    initialValue = promptConfig.forcedefault !== null ? promptConfig.forcedefault : (promptConfig.default || '');
                }
            }

            // Handle autofill if configured.
            //
            // SELECT / MULTI-SELECT ONLY. This blocking `term:''` fetch exists to
            // build the <option> list, and autofillOptions is read in exactly two
            // places - the select and multi-select cases below. text/textarea used
            // to be admitted here too, but nothing on those paths ever touched the
            // result: they render a bare <input> and wire a jQuery UI autocomplete
            // that re-fetches per keystroke with `term:<typed>` (minLength 3), and
            // the OK handler reads .val() without validating against any list. So
            // the trip pulled the whole DISTINCT list (Oracle caps at 10000 rows -
            // ~8.2k for ?id=rpt's PI names) and dropped it, while the awaited
            // "Loading options..." overlay delayed the dialog every single time.
            // The default needs no server either; it resolves locally above.
            //
            // Two things that fetch did incidentally, and where they went:
            //  - earliest expired-session detection -> now the first 3-char lookup,
            //    which routes through the same handleSessionExpiredError().
            //  - immediate "your autofill= is broken" feedback -> now surfaces in
            //    the field's error line once the user types.
            // `date` is unaffected: it uses mode=range via resolvePromptDateRange.
            let autofillOptions = [];
            if (promptConfig.autofill && (promptConfig.type === 'select' || promptConfig.type === 'multi-select')) {
                try {
                    showLoading("Loading options...");
                    const systemTables = ['ALL_', 'DBA_', 'USER_', 'V$', 'GV$'];
                    const tableNameUpper = promptConfig.autofill.table.toUpperCase();

                    // Check prefixes
                    const isSystemPrefix = systemTables.some(prefix => tableNameUpper.startsWith(prefix));

                    // EXCEPTION: Allow ALL_TAB_COLUMNS
                    if (isSystemPrefix && tableNameUpper !== 'ALL_TAB_COLUMNS') {
                        throw new Error("System tables are not allowed for autofill");
                    }

                    const response = await $.ajax({
                        url: 'get_autofill_values.php',
                        type: 'GET',
                        data: {
                            table: promptConfig.autofill.table,
                            column: promptConfig.autofill.column,
                            condition: promptConfig.autofill.condition || '',
                            valueColumn: promptConfig.autofill.valueColumn || '',
                            term: '',
                            isExpression: promptConfig.autofill.isExpression ? '1' : '',
                            short_id: new URLSearchParams(window.location.search).get('id') || ''
                        },
                        dataType: 'json'
                    });

                    // A 200 carrying {error:...} is not a list. Route it into the
                    // catch below so it gets the same treatment as a transport
                    // failure, instead of silently rendering an empty dropdown.
                    const listErr = autofillPayloadError(response);
                    if (listErr) {
                        throw listErr.isAuth
                            ? { status: 403, statusText: 'Access Denied.' }
                            : new Error(listErr.message);
                    }
                    if (response && Array.isArray(response)) {
                        autofillOptions = response.slice(0, 10000);
                    }
                    hideLoading();
                } catch (error) {
                    if (autofillAuthFailed(error)) {
                        $(`#${dialogId}`).remove();
                        // Close the modal so user can see the error
                        handleSessionExpiredError();
                    } else {
                        hideLoading();
                        console.error("Autofill failed:", error);
                        show_text(`<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Failed to load autofill options: ${error.message || error.responseJSON?.error || 'Unknown error'}</p>`);
                    }
                }
            }

            // Dynamic date-range prompts: make sure bounds + `min`/`max` keyword
            // defaults are resolved before the input renders. Usually already done
            // by processPrompts; this covers the chip-edit path, which reads
            // parent answers from localStorage instead of the loop's answer map.
            if (promptConfig.type === 'date' && promptConfig.autofill) {
                await resolvePromptDateRange(promptConfig, getPromptAnswerByName);
                if (prefillValue === null || _isRangeKeyword(initialValue)) {
                    initialValue = promptConfig.forcedefault !== null ? promptConfig.forcedefault : (promptConfig.default || '');
                }
            }

            // type=date-range: the same lookup feeds the "All dates" quick range
            // and the hints under a min / max half. The ANSWER stays raw, keywords
            // and all - they are resolved each time the report runs.
            const _dlgIsDr = penumbraIsDateRangeType(promptConfig.type);
            if (_dlgIsDr && promptConfig.autofill) {
                await resolvePromptDateRange(promptConfig, getPromptAnswerByName);
            }

            // --- Boolean Prompt Logic ---
            if (promptConfig.type === 'boolean') {
                const yesOpt = promptConfig.yesOption || {
                    display: 'OK',
                    value: '1'
                };
                const noOpt = promptConfig.noOption || {
                    display: 'Cancel',
                    value: '0'
                };
                const dialogTitle = promptConfig.title || 'Confirmation';

                // SVG Icon for Boolean (Question Mark)
                const iconSvg = `<svg xmlns="http://www.w3.org/2000/svg" class="prompt-header-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;

                // Apply the same safelist-sanitized style= override used by the
                // other prompt types so authors can size/color the boolean dialog
                // identically (width, height, background-color, etc.).
                const booleanStyleString = sanitizeCssString(promptConfig.style);

                // OK-only / attestation mode: hide the Cancel button so the dialog
                // becomes a single-button acknowledgement (e.g. "I Understand").
                // The yes= label is still authored via the standard mechanism.
                const okOnly = !!promptConfig.okonly;
                const noBtnHtml = okOnly
                    ? ''
                    : `<button id="${dialogId}_no" class="modal-btn-secondary" style="min-width: 100px;">${escapeHtml(noOpt.display)}</button>`;

                const dialogHtml = `
                <div id="${dialogId}" class="modal-prompt-overlay">
                    <div class="modal-prompt-box" style="${themeBg} ${booleanStyleString}">
                        <h3>${iconSvg} ${escapeHtml(dialogTitle)}</h3>
                        <div class="modal-prompt-content">
                            ${typeof DOMPurify !== 'undefined' ? DOMPurify.sanitize(promptConfig.message || 'Input Required') : escapeHtml(promptConfig.message || 'Input Required')}
                        </div>
                        <div class="modal-prompt-buttons" style="justify-content: center; gap: 20px;">
                            ${noBtnHtml}
                            <button id="${dialogId}_yes" class="modal-btn-primary" style="min-width: 100px;">${escapeHtml(yesOpt.display)}</button>
                        </div>
                        <div style="text-align: center; margin-top: 10px;">
                            ${generateResetLinkHtml(promptConfig, prefillValue, dialogId)}
                        </div>
                    </div>
                </div>`;

                window._pnbModalHost().append(dialogHtml);   // {PROMPT} dialog - follows the window that ran the query

                $(`#${dialogId}_yes`).on('click', function () {
                    $(`#${dialogId}`).remove();
                    resolve({
                        value: yesOpt.value,
                        display: yesOpt.display
                    });
                });
                if (!okOnly) {
                    $(`#${dialogId}_no`).on('click', function () {
                        $(`#${dialogId}`).remove();
                        resolve({
                            value: noOpt.value,
                            display: noOpt.display
                        });
                    });
                }
                attachResetHandler(dialogId, promptConfig);
                return;
            }

            // --- Standard Inputs Logic ---
            switch (promptConfig.type) {
                case 'textarea':
                    inputHtml = `<textarea id="${dialogId}_input" style="min-height: 120px; font-family: sans-serif;">${escapeHtml(String(initialValue))}</textarea>`;
                    break;
                case 'text':
                case 'date':
                    inputHtml = `<input type="text" id="${dialogId}_input" value="${escapeHtml(String(initialValue)).replace(/"/g, '&quot;')}">`;
                    break;
                case 'select':
                    inputHtml = `<select id="${dialogId}_input">`;
                    // Match options by the answer's VALUE. A {value, display} prefill
                    // (chip re-open, "Review all", the scheduler form) leaves the LABEL
                    // in initialValue, so for options=Label:Value or a label/value
                    // autofill nothing matched: the dialog opened on the first option
                    // and OK quietly changed the answer.
                    const selectedOptionValue = initialSelectedValue !== null ? initialSelectedValue : initialValue;
                    const renderSelectOption = (val, label) => {
                        const isSelected = String(val) === String(selectedOptionValue) ? 'selected' : '';
                        inputHtml += `<option value="${escapeHtml(val).replace(/"/g, '&quot;')}" ${isSelected}>${escapeHtml(label)}</option>`;
                    }
                        ;
                    // Merge order: optionsBefore -> autofill rows -> optionsAfter.
                    // Token order in the prompt controls which bucket each options=
                    // entry lands in. When autofill returns 0 rows (or isn't set),
                    // both buckets still render and act as the option list.
                    if (promptConfig.optionsBefore && promptConfig.optionsBefore.length > 0) {
                        promptConfig.optionsBefore.forEach(opt => renderSelectOption(opt.value, opt.display));
                    }
                    if (autofillOptions.length > 0) {
                        if (typeof autofillOptions[0] === 'object') {
                            autofillOptions.forEach(opt => renderSelectOption(opt.value, opt.label));
                        } else {
                            autofillOptions.forEach(opt => renderSelectOption(opt, opt));
                        }
                    }
                    if (promptConfig.optionsAfter && promptConfig.optionsAfter.length > 0) {
                        promptConfig.optionsAfter.forEach(opt => renderSelectOption(opt.value, opt.display));
                    }
                    inputHtml += '</select>';
                    break;
                case 'multi-select':
                    // UPDATED: Used flex layout for multi-select components
                    inputHtml = `
                        <div style="display: flex; align-items: center; margin-bottom: 5px; min-height: 20px; flex-shrink: 0;">
                            <span id="${dialogId}_filter_icon" title="Filter options" style="cursor: pointer; opacity: 0.7; margin-right: 5px; display: flex; align-items: center;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                                <span style="font-size: 10px; margin-left: 3px; text-decoration: underline;">Filter List</span>
                            </span>
                            <input type="text" id="${dialogId}_filter_input" placeholder="Type to filter options..." style="display: none; flex-grow: 1; font-size: 11px; padding: 4px; border: 1px solid #ccc; border-radius: 3px; margin-top:0;">
                        </div>`;

                    // UPDATED: Removed fixed height, added flex-grow: 1 to fill available space
                    inputHtml += `<select id="${dialogId}_input" multiple style="width: 100%; flex-grow: 1; padding: 5px; min-height: 150px;">`;

