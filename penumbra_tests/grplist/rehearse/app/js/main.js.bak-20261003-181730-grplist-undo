    function applyPagination() {
        // (The EMPTY-cell safety net runs after the page loop below: it fills the
        // rows that are on screen, whatever path showed their columns.)
        const rowsPerPage = $('#rowsPerPageSelector').val();

        // "None": hide the data table for chart / dashboard / carousel reports.
        // A body class (CSS, scoped to the flat view via :has()) collapses
        // #table-view-container to zero height -- NOT display:none, so the header
        // cells keep their layout boxes and exports / copies / downloads keep
        // working (they read the live DOM: columns via `th:visible`, rows via
        // :not(.search-hidden)). The page nav + count are hidden by the same
        // class; the Rows selector stays so the user can switch back. `inert`
        // drops the hidden table from the tab order + a11y tree. We skip the
        // per-row paging loop + conditional formatting -- wasted work on a table
        // nobody is looking at -- and let updateFilteredResultCount() keep the
        // row tally (status bar) honest.
        const _dataHidden = (rowsPerPage === 'none');
        document.body.classList.toggle('pnb-data-hidden', _dataHidden);
        const _flatTable = document.getElementById('resultsTable');
        if (_flatTable) _flatTable.inert = _dataHidden;
        if (_dataHidden) {
            $('#paginatorContainer').css('visibility', 'visible');
            // Lazy rows (2026-09-30): nothing is on screen, but the rows left
            // displayed (the build's first page, a search's matches) are what
            // the email embed carries.
            _pnbFillDisplayedRows();
            updateFilteredResultCount();
            return;
        }

        // Remember the active page size so the status-bar "show table" chip can
        // restore it after a stint in "None".
        $('#rowsPerPageSelector').data('pnbPrevRows', rowsPerPage);

        // PERF: Native DOM loop instead of jQuery selector scan on 90K rows.
        // Build a lightweight array of only non-hidden rows (by reference, no cloning).
        const allRows = document.querySelectorAll("#resultsTable tbody tr");
        const filteredRows = [];
        for (let pi = 0; pi < allRows.length; pi++) {
            if (!allRows[pi].classList.contains('search-hidden')) {
                filteredRows.push(allRows[pi]);
            }
        }
        const totalRows = filteredRows.length;
        let totalPages = 1;

        if (rowsPerPage === 'all' || totalRows === 0) {
            for (let pi = 0; pi < filteredRows.length; pi++) {
                filteredRows[pi].style.display = '';
            }
            $('#paginatorContainer').css('visibility', totalRows > 0 ? 'visible' : 'hidden');
            $('#pageInfo').text(`1 - ${totalRows} of ${totalRows}`);
            $('#firstPageBtn, #prevPageBtn, #nextPageBtn, #lastPageBtn').prop('disabled', true);
        } else {
            $('#paginatorContainer').css('visibility', 'visible');
            const numRowsPerPage = parseInt(rowsPerPage, 10);
            totalPages = Math.ceil(totalRows / numRowsPerPage);

            currentPage = Math.min(currentPage, totalPages) || 1;

            const startRow = (currentPage - 1) * numRowsPerPage;
            const endRow = startRow + numRowsPerPage;

            // Hide all filtered rows, then show only the current page
            for (let pi = 0; pi < filteredRows.length; pi++) {
                filteredRows[pi].style.display = (pi >= startRow && pi < endRow) ? '' : 'none';
            }

            $('#pageInfo').text(`Page ${currentPage} of ${totalPages}`);
            $('#firstPageBtn, #prevPageBtn').prop('disabled', currentPage === 1);
            $('#nextPageBtn, #lastPageBtn').prop('disabled', currentPage >= totalPages);
        }

        // Lazy rows / hidden columns (2026-09-30): the rows now on screen get
        // their EMPTY cells in every showing column - before the count's style
        // read and before format() / rewrite() / stripes below run over them.
        _pnbFillDisplayedRows();

        // AFTER the page loop, not before it (2026-09-30). The count reads only
        // the .search-hidden classes, but the PDF guard it calls asks for
        // "#tableHeader th:visible" - a forced style pass over every DISPLAYED
        // row. Before the loop, a search has just displayed every match, so
        // that pass restyled all of them (2,000 rows x 150 cells, hidden
        // columns included, ~0.4 s); after it, one page.
        updateFilteredResultCount();

        // --- START MODIFICATION ---
        // This new block intelligently toggles the correct row within the tfoot.
        const $tfoot = $("#resultsTable tfoot");
        if ($tfoot.length > 0) {
            const $totalDataRow = $tfoot.find('.total-row-data');
            const $totalLinkRow = $tfoot.find('.total-row-link');

            const showAll = (rowsPerPage === 'all');
            const isLastPage = (currentPage >= totalPages);

            // Show the actual totals if on the last page or if 'All' is selected.
            $totalDataRow.toggle(showAll || isLastPage);

            // Show the link row ONLY if not on the last page and not showing all rows.
            $totalLinkRow.toggle(!showAll && !isLastPage && totalRows > 0);
        }
        // --- END MODIFICATION ---

        applyConditionalFormatting();
        applyRewriteRules();
        applyZebraStriping();
    }

    $(document).on('click', '#viewLastPageLink', function (e) {
