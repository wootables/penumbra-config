    // True if parentheses in a custom-condition expression are balanced,
    // ignoring any parens inside quoted strings ('...', "...", `...`). A naive
    // char scan counts parens inside string literals - e.g.
    // count(NOTES == "a(b") - and false-flags a valid expression as unbalanced.
    // Backticks are literal (no escaping, matching the snippet engine); single
    // and double quotes honor backslash escapes.
    function _condParensBalanced(s) {
        var depth = 0, q = null;
        for (var i = 0; i < s.length; i++) {
            var ch = s[i];
            if (q) {
                if (q !== '`' && ch === '\\') { i++; continue; }
                if (ch === q) q = null;
                continue;
            }
            if (ch === "'" || ch === '"' || ch === '`') { q = ch; continue; }
            if (ch === '(') depth++;
            else if (ch === ')') { depth--; if (depth < 0) return false; }
        }
        return depth === 0;
    }

    function validateCustomConditionExpr() {
        var $warning = $('#schedCustomConditionWarning');
        var $input = $('#schedCustomConditionExpr');
        var expr = $input.val().trim();

        if (!$('#schedSkipCustomCondition').is(':checked')) {
            $warning.hide();
            return;
        }

        if (expr === '') {
            $warning.attr('title', 'Condition is empty. Enter a snippet expression (e.g. sum(AMOUNT) < 10000000).').show();
            return;
        }

        // Require at least one snippet function call (a bare literal comparison
        // can't read report data).
        // Keep this list in step with engine C's evaluate_custom_condition
        // pattern (schedule_runner.php) - percentile/stddev/date_format were
        // added there 2026-08-06 and this validator blocked them at save time.
        var hasFunction = /\b(count|sum|avg|min|max|median|mode|distinct|rank|percentile|stddev|calc|round|abs|floor|ceil|mod|fixed|now|lookup|date_diff|date_format|data|string|case)\s*\(/i.test(expr);
        // A recipient variable reads the RECIPIENT rather than the rows, so
        // {PI_ELIGIBLE} = 0 is a complete condition with no function (2026-09-23).
        if (!hasFunction) hasFunction = /\{(?:FNAME|LNAME|USERNAME|EMAIL|OUCS2D|OUCS4D|OUCS6D|OUCS|OUC2D|OUC4D|OUC6D|DEPT|OUC|EMPL_ID4|EMPL_ID|JOBCODE_PREFIX|JOBCODE|EMPL_CLASS|EMPL_STATUS|PI_ELIGIBLE)\}/i.test(_pnbCanonBraceTokens(expr));

        if (!hasFunction) {
            $warning.attr('title', 'Expression should contain at least one snippet function (e.g. sum(), count(), avg()) or a recipient variable (e.g. {PI_ELIGIBLE} = 0).').show();
            return;
        }

        // Check for balanced parentheses (ignoring quoted strings)
        if (!_condParensBalanced(expr)) {
            $warning.attr('title', 'Unbalanced parentheses in expression.').show();
            return;
        }

        // Looks valid
        $warning.hide();
    }

    // 6. Save Handler (Updated with Inline Errors)
    $('#saveTaskBtn').on('click', function () {
        // A scheduled task re-reads the report's LIVE state at run time, so this
        // could not write a stale definition. It is blocked anyway because the
        // task DOES capture what is on screen now - prompt answers, the change
        // columns, the active filter - and on an as-of page all of that came from
        // the old version. Building a recurring job out of it is not something to
        // do while looking at history.
        if (_pnbAsOfBlocked('Scheduling')) return;
        const $msg = $('#schedMsgContainer');
        $msg.hide().empty();
        // Clear previous messages
        ['#schedCron', '#schedEmailInput', '#schedCustomConditionExpr'].forEach(function (s) {
            var el = document.querySelector(s);
            if (!el) return;
            el.removeAttribute('aria-invalid');
            if (el.getAttribute('aria-describedby') === 'schedMsgContainer') el.removeAttribute('aria-describedby');
        });

        const showError = (text, field) => {
            $msg.html(`<span style="color: var(--accent-danger, #dc3545);">⚠️ ${text}</span>`).fadeIn('fast');
            if (field) {
                var fEl = document.querySelector(field);
                if (fEl) {
                    fEl.setAttribute('aria-invalid', 'true');
                    fEl.setAttribute('aria-describedby', 'schedMsgContainer');
                    if (typeof fEl.focus === 'function') fEl.focus();
                }
            }
        }
            ;

        const urlParams = new URLSearchParams(window.location.search);
        const reportId = urlParams.get('id');

        // Commit anything typed into the recipients box but never tokenized
        // into a capsule: the collection below reads capsules ONLY, so a typed
        // address was dropped at save time and the task then ran without that
        // recipient indefinitely. See commitPendingRecipients.
        const _schedLeftover = commitPendingRecipients('#schedEmailInput', '#schedEmailContainer');
        if (_schedLeftover) {
            showError('"' + escapeHtml(_schedLeftover) + '" was not added as a recipient. Enter a full email address, or pick the person from the suggestions.', '#schedEmailInput');
            return;
        }
        // Reject an address the RUNNER could not resolve, before it is stored and
        // starts quietly skipping someone every run. Uses the scheduler's own rule
        // (bare Unity IDs are fine) - manage_schedule.php re-checks server-side.
        const _badSched = [];
        $('#schedEmailContainer .email-capsule').each(function () {
            const em = String($(this).data('email') || '');
            if (!penumbraSchedulerRecipientOk(em)) _badSched.push(em);
        });
        if (_badSched.length) {
            showError('Not valid email addresses: ' + escapeHtml(_badSched.join(', '))
                + '. Correct or remove them, then save again.', '#schedEmailInput');
            return;
        }

        const emails = [];
        const recipientVars = {};
        $('#schedEmailContainer .email-capsule').each(function () {
            const email = $(this).data('email');
            const name = $(this).data('name');
            // Strip the RECIPIENTS separators out of the display name before it
            // is folded into "Name <email>". The runner splits that column on
            // ';' AND ',', so a name like "Doe, John" becomes TWO entries and
            // the orphan "Doe" is alphanumeric - which the runner happily
            // resolves to a real, mailable Doe@ncsu.edu. Validation cannot catch
            // it (both halves look legitimate), so it has to be prevented here,
            // at composition. manage_subscription.php's pnb_sub_current_name()
            // already does exactly this for the subscribe path.
            const safeName = String(name || '').replace(/[<>,;"]+/g, ' ').replace(/\s{2,}/g, ' ').trim();
            emails.push(safeName ? `${safeName} <${email}>` : email);
            // Preserve rich user variable data for tooltip restoration on load
            var uv = $(this).data('user-vars');
            if (uv) {
                recipientVars[email] = uv;
            }
        });

        // Gather Prompts
        const promptAnswers = {};
        const prompts = extractPromptsForScheduler();
        const emptyPrompts = [];

        $('.sched-prompt-input').each(function () {
            const name = $(this).data('name');
            // Prefer the stored underlying value (the GUID/key for autofill
            // prompts) over the visible display text. Falls back to the
            // visible value for prompts without a separate stored value.
            const stored = $(this).attr('data-stored-value');
            const val = (stored !== undefined && stored !== '') ? String(stored).trim() : $(this).val().trim();
            promptAnswers[name] = val;
        });

        prompts.forEach(p => {
            const val = promptAnswers[p.name];
            // Skip prompts with `resultif` - they're child prompts and being
            // empty is expected when the parent's value doesn't match.
            if ((!val || val === '') && p.forcedefault === null && !p.hidden && !p.resultif) {
                emptyPrompts.push(p.message || p.name);
            }
        });

        if (emptyPrompts.length > 0) {
            $msg.html(`<span style="color: var(--accent-warning, #b58900);">⚠️ Warning: Empty prompt${emptyPrompts.length > 1 ? 's' : ''}: ${emptyPrompts.map(n => '"' + n + '"').join(', ')}. The query may receive NULL values.</span>`).fadeIn('fast');
        }

        // Gather me() macro resolutions (scheduler-resolved; see openSchedulerForm).
        // Blank fields are omitted so a blank = "unset" (query.php then empties it),
        // and the server-side protective merge preserves prior values on an empty
        // post - mirroring prompt_answers.
        const meMap = {};
        $('.sched-me-input').each(function () {
            const key = $(this).attr('data-me-key') || '';
            const val = $(this).val().trim();
            if (val !== '') meMap[key] = val;
        });

        const passVal = $('#schedReportPassword').val();
        const preservePass = $('#schedPasswordNotice').is(':visible');
        const cronExpr = $('#schedCron').val().trim();

        // --- Client-side Validation ---
        // One-time draft test: the cron is irrelevant (it fires on the next
        // cycle and the hidden row is deleted after the run), so a schedule
        // isn't required - the server normalizes a blank/invalid one.
        if (!validateCronExpression(cronExpr) && !_schedTestOnceIntent) {
            showError("Invalid Cron Expression. Format should be:<br>minute(0-59) hour(0-23) day(1-31) month(1-12) day-of-week(0-7, 0 or 7 = Sunday)<br>Separators (','), ranges ('-') and Steps ('/') allowed.", '#schedCron');
            return;
        }

        var taskType = $('#schedEventType').val();

        // Recipients required only for EMAIL tasks. A saved task with current
        // self-service SUBSCRIBERS is exempt: the runner merges them in at send
        // time, so an empty typed list is a valid subscription-driven schedule.
        // (If everyone later unsubscribes, the runner skips the run with a
        // SCHEDULE_SKIPPED audit instead of failing.) An unsaved draft can't
        // have subscribers yet, so it still needs a direct recipient to start.
        if (taskType === 'EMAIL' && emails.length === 0) {
            var subsCoverRecipients = $('#schedSubsEnable').is(':checked')
                && $('#schedTaskId').val()
                && Array.isArray(_schedCurrentSubscribers) && _schedCurrentSubscribers.length > 0;
            if (!subsCoverRecipients) {
                if ($('#schedSubsEnable').is(':checked')) {
                    showError("Please add at least one recipient. Subscriptions are enabled, but this schedule has no subscribers yet"
                        + ($('#schedTaskId').val() ? "" : " (viewers can subscribe only after the event is saved)")
                        + " - it needs at least one direct recipient to start.", '#schedEmailInput');
                } else {
                    showError("Please add at least one recipient.", '#schedEmailInput');
                }
                return;
            }
        }

        // me() recipient-variable guard: {VAR} tokens ({OUC}, {EMAIL}, ...) resolve
        // per-recipient and ONLY on EMAIL tasks. On any other task type there is no
        // recipient, so the token would survive into the SQL unresolved (an empty or
        // failed run), which reads as "it silently didn't work". Block the save.
        if (taskType !== 'EMAIL') {
            // EMPL_ID4 listed BEFORE EMPL_ID: `EMPL_ID` followed by `\}` cannot
            // match "{EMPL_ID4}" (the next char is '4', not '}'), so without its
            // own alternative the guard silently passes and the token survives
            // into the SQL of a non-EMAIL task.
            var _meRecipTokenRe = /\{(?:FNAME|LNAME|USERNAME|EMAIL|OUCS2D|OUCS4D|OUCS6D|OUCS|OUC2D|OUC4D|OUC6D|DEPT|OUC|EMPL_ID4|EMPL_ID|JOBCODE_PREFIX|JOBCODE|EMPL_CLASS|EMPL_STATUS|PI_ELIGIBLE)\}/i;
            var _badMeKeys = Object.keys(meMap).filter(function (k) { return _meRecipTokenRe.test(String(meMap[k])); });
            if (_badMeKeys.length > 0) {
                var _badMeLabels = _badMeKeys.map(function (k) { return k ? ('me(' + k + ')') : 'me()'; });
                showError('Recipient variables like {OUC} only work on per-recipient EMAIL tasks. Enter a fixed value for ' + _badMeLabels.join(', ') + ' on a ' + taskType + ' task.', '#schedMeContainer');
                return;
            }
        }

        // Warn (but allow) scheduling if query references imported file data
        // Imports are now persisted on the server and will be available to the scheduler

        // Build options object - include both email and snapshot options
        // (unused fields are harmless; the runner reads only what it needs per task type)
        var optionsObj = {
            attach_csv: $('#schedAttachCsv').is(':checked'),
            attach_xlsx: $('#schedAttachXlsx').is(':checked'),
            attach_pdf: $('#schedAttachPdf').is(':checked'),
            no_body: !$('#schedIncludeBody').is(':checked'),
            include_link: $('#schedIncludeLink').is(':checked'),
            no_links: $('#schedStripLinks').is(':checked'),
            skip_empty: $('#schedSkipEmpty').is(':checked'),
            skip_no_change: $('#schedSkipNoChange').is(':checked'),
            skip_custom_condition: $('#schedSkipCustomCondition').is(':checked'),
            custom_condition_expr: $('#schedCustomConditionExpr').val().trim(),
            // Minutes, 0 = off. The checkbox is a fixed 60-minute window for now;
            // storing minutes keeps a future per-task window free of migrations.
            skip_if_missed_min: $('#schedSkipMissed').is(':checked') ? 60 : 0,
            include_snippet: $('#schedIncludeSnippet').is(':checked'),
            theme_override: $('#schedThemeOverride').val(),
            body_preamble: $('#schedBodyPreamble').val().trim(),
            prompt_answers: promptAnswers,
            me_map: meMap,
            search_filter: $('#schedSearchFilter').val().trim(),
            recipient_vars: recipientVars,
            // Subscriptions card: settings only. The subscriber LIST is never
            // sent - manage_schedule.php owns preserving the stored list.
            subscriptions_enabled: $('#schedSubsEnable').is(':checked'),
            subscriptions_notify: $('#schedSubsNotify').is(':checked'),
            // "Allow only on custom condition" - blank = no condition (the server
            // validates it and drops the key for other task types).
            subscriptions_condition: $('#schedSubsCondEnable').is(':checked') ? String($('#schedSubsCondExpr').val() || '').trim() : ''
        };

        // Validate custom condition expression if enabled
        if (optionsObj.skip_custom_condition) {
            var condExpr = optionsObj.custom_condition_expr;
            if (!condExpr) {
                showError("Custom condition is enabled but the expression is empty.", '#schedCustomConditionExpr');
                return;
            }
            // Twin of the tooltip validator's list above - keep both in step
            // with engine C's evaluate_custom_condition pattern.
            var hasFunction = /\b(count|sum|avg|min|max|median|mode|distinct|rank|percentile|stddev|calc|round|abs|floor|ceil|mod|fixed|now|lookup|date_diff|date_format|data|string|case)\s*\(/i.test(condExpr);
            if (!hasFunction) {
                showError("Custom condition must contain at least one snippet function (e.g. sum(), count()).", '#schedCustomConditionExpr');
                return;
            }
            if (!_condParensBalanced(condExpr)) {
                showError("Custom condition has unbalanced parentheses.", '#schedCustomConditionExpr');
                return;
            }
        }

        // Shared change detection options (used by EMAIL/SNAPSHOT/DROP_FILE
        // skip-no-change and by the EMAIL "Send as Change Analysis" option)
        var skipNoChangeActive = $('#schedSkipNoChange').is(':checked');
        var changeAnalysisActive = $('#schedChangesOnly').is(':checked') && taskType === 'EMAIL';

        optionsObj.change_mode = $('input[name="schedChangeMode"]:checked').val() || 'all';
        if (optionsObj.change_mode === 'custom' && (skipNoChangeActive || changeAnalysisActive)) {
            var customCols = [];
            $('#schedColumnSelector input:checked').each(function () {
                customCols.push($(this).val());
            });
            if (customCols.length === 0) {
                showError("Please select at least one column for change detection, or choose 'All columns'.");
                return;
            }
            optionsObj.change_columns = customCols;
        } else if (optionsObj.change_mode === 'custom') {
            // Custom mode selected but skip-no-change not active - save columns anyway (no validation)
            var customCols = [];
            $('#schedColumnSelector input:checked').each(function () {
                customCols.push($(this).val());
            });
            optionsObj.change_columns = customCols.length > 0 ? customCols : null;
        } else {
            optionsObj.change_columns = null;
        }

        // "Send as Change Analysis" (EMAIL delivery option, independent of
        // skip_no_change). Saved as-checked; only the EMAIL runner reads it.
        optionsObj.changes_only = $('#schedChangesOnly').is(':checked');

        // On Completion notifications (shared card; shown for every type except WEBHOOK).
        // Each recipient box defaults to the owner's email; an empty box falls back to
        // the owner at send time. Validate any provided addresses before saving.
        if (taskType !== 'WEBHOOK') {
            optionsObj.notify_success = $('#schedNotifySuccess').is(':checked');
            optionsObj.notify_success_recipients = ($('#schedNotifySuccessEmails').val() || '').trim();
            optionsObj.notify_failure = $('#schedNotifyFailure').is(':checked');
            optionsObj.notify_failure_recipients = ($('#schedNotifyFailureEmails').val() || '').trim();
            var badNotify = [];
            var checkNotifyEmails = function (val) {
                String(val || '').split(/[,;\s]+/).filter(function (s) { return s; }).forEach(function (p) {
                    if (p.indexOf('@') === -1) { if (!/^[A-Za-z0-9._-]+$/.test(p)) badNotify.push(p); return; }
                    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(p)) badNotify.push(p);
                });
            };
            if (optionsObj.notify_success) checkNotifyEmails(optionsObj.notify_success_recipients);
            if (optionsObj.notify_failure) checkNotifyEmails(optionsObj.notify_failure_recipients);
            if (badNotify.length) { showError('Invalid On Completion email address(es): ' + badNotify.join(', ')); return; }
        }

        // Snapshot-specific options
        if (taskType === 'SNAPSHOT') {
            optionsObj.snap_max_keep = parseInt($('#schedSnapMaxKeep').val()) || 50;
            if (optionsObj.snap_max_keep < 1) optionsObj.snap_max_keep = 1;
            if (optionsObj.snap_max_keep > 50) optionsObj.snap_max_keep = 50;
        }

        // DROP_FILE-specific options
        if (taskType === 'DROP_FILE') {
            optionsObj.drop_protocol         = $('#schedDropProtocol').val();
            optionsObj.drop_host             = $('#schedDropHost').val().trim();
            optionsObj.drop_port             = parseInt($('#schedDropPort').val()) || null;
            optionsObj.drop_path             = $('#schedDropPath').val().trim();
            optionsObj.drop_username         = $('#schedDropUsername').val().trim();
            optionsObj.drop_filename_pattern = $('#schedDropFilenamePattern').val().trim() || '{TITLE}_{DATE}';
            optionsObj.drop_format_csv       = $('#schedDropFormatCsv').is(':checked');
            optionsObj.drop_format_xlsx      = $('#schedDropFormatXlsx').is(':checked');
            optionsObj.drop_format_pdf       = $('#schedDropFormatPdf').is(':checked');
            optionsObj.drop_format_json      = $('#schedDropFormatJson').is(':checked');
            optionsObj.drop_passive_mode     = $('#schedDropPassiveMode').is(':checked');
            optionsObj.drop_use_ftps         = $('#schedDropUseFtps').is(':checked');
            optionsObj.drop_sftp_key         = $('#schedDropSftpKey').val().trim();

            // S3 fields
            optionsObj.drop_s3_bucket        = $('#schedDropS3Bucket').val().trim();
            optionsObj.drop_s3_region        = $('#schedDropS3Region').val().trim();
            optionsObj.drop_s3_endpoint      = $('#schedDropS3Endpoint').val().trim();

            // Custom Template: saved VERBATIM (no trim - leading/trailing spaces in a
            // fixed-width template are content). The fields ride along even while the
            // box is unticked, so unticking and re-ticking does not lose the template.
            optionsObj.drop_format_custom    = $('#schedDropFormatCustom').is(':checked');
            optionsObj.drop_custom_header    = $('#schedDropCustomHeader').val();
            optionsObj.drop_custom_template  = $('#schedDropCustomTemplate').val();
            optionsObj.drop_custom_ext       = $('#schedDropCustomExt').val() || 'txt';
            optionsObj.drop_custom_newline   = $('#schedDropCustomNewline').is(':checked');

            // Validation: at least one format
            if (!optionsObj.drop_format_csv && !optionsObj.drop_format_xlsx && !optionsObj.drop_format_pdf && !optionsObj.drop_format_json && !optionsObj.drop_format_custom) {
                showError("Please select at least one file format (CSV, XLSX, PDF, JSON, or Custom Template).");
                return;
            }
            // Validation: custom template. manage_schedule.php and the runner apply
            // the same rule (penumbra_tpl_drop_options_error) - this is the early,
            // field-focused copy of it.
            if (optionsObj.drop_format_custom) {
                if (!String(optionsObj.drop_custom_template).trim()) {
                    showError("Custom Template is ticked but the row template is empty. An empty template writes a file of blank lines.", '#schedDropCustomTemplate');
                    return;
                }
                var _dropExtClash = _schedDropCustomExtClash();
                if (_dropExtClash) {
                    showError(_dropExtClash, '#schedDropCustomExt');
                    return;
                }
            }
            // Validation: path required for UNC
            if (optionsObj.drop_protocol === 'unc' && !optionsObj.drop_path) {
                showError("Please enter a UNC destination path.");
                return;
            }
            // Validation: host required for SFTP/SCP/FTP
            if ((optionsObj.drop_protocol === 'sftp' || optionsObj.drop_protocol === 'scp' || optionsObj.drop_protocol === 'ftp') && !optionsObj.drop_host) {
                showError("Please enter a host address.");
                return;
            }
            // Validation: bucket required for S3
            if (optionsObj.drop_protocol === 's3' && !optionsObj.drop_s3_bucket) {
                showError("Please enter an S3 bucket name.");
                return;
            }
        }

        // DB_DUMP-specific options. The hidden schema field is normally empty for
        // new tasks (server resolves to current Oracle user); for existing tasks
        // we echo back whatever was loaded. The server has final say either way.
        if (taskType === 'DB_DUMP') {
            optionsObj.destination_schema = ($('#schedDbDumpSchema').val() || '').toUpperCase().trim();
            optionsObj.destination_table  = ($('#schedDbDumpTable').val() || '').toUpperCase().trim();
            optionsObj.collision_override = $('#schedDbDumpOverride').is(':checked');
            optionsObj.override_reason    = optionsObj.collision_override
                ? $('#schedDbDumpOverrideReason').val().trim()
                : '';

            if (!optionsObj.destination_table) {
                showError("Please enter a destination table name.");
                return;
            }
            if (!/^[A-Z][A-Z0-9_]{0,29}$/.test(optionsObj.destination_table)) {
                showError("Destination table name must start with a letter and contain only A–Z, 0–9, and underscores (max 30 chars).");
                return;
            }
            if (optionsObj.collision_override && !optionsObj.override_reason) {
                showError("Please provide a reason for the override (required for the audit trail).");
                return;
            }

            // Auto-populate the SUBJECT column from the destination so audit
            // log lines (which use $task['SUBJECT'] as the display label)
            // remain meaningful - the Subject row is hidden for DB_DUMP.
            $('#schedSubject').val('DB Dump → ' + optionsObj.destination_table);

            // Options card: explicit column list (always shown now) + HTML strip.
            // At least one column must be checked.
            var customCols = [];
            $('#schedDbDumpColumnSelector input[type=checkbox]:checked').each(function () {
                customCols.push(String($(this).val()).toUpperCase());
            });
            if (customCols.length === 0) {
                showError('No columns are checked for the DB dump. Check at least one column to include.');
                return;
            }
            optionsObj.dbdump_columns_mode = 'custom';
            optionsObj.dbdump_columns_custom = customCols;
            optionsObj.dbdump_strip_html = $('#schedDbDumpStripHtml').is(':checked');

            // Row limit: "all" ignores the report's own limiter and dumps every
            // row; "enforce" caps at the entered count (default 200 - the
            // limiter's own cap - but user-overridable, with no upper bound).
            var rowMode = $('input[name="schedDbDumpRowMode"]:checked').val() || 'enforce';
            optionsObj.dbdump_row_mode = rowMode;
            if (rowMode === 'enforce') {
                var rowLimitVal = parseInt($('#schedDbDumpRowLimit').val(), 10);
                if (isNaN(rowLimitVal) || rowLimitVal < 1) {
                    showError('Enter a valid row limit (a whole number of 1 or more), or choose "Always include all rows".');
                    return;
                }
                optionsObj.dbdump_row_limit = rowLimitVal;
            } else {
                optionsObj.dbdump_row_limit = null;
            }

            // Reload strategy: 'recreate' (default) drops/creates each run;
            // 'truncate' preserves the table object (truncate + insert),
            // recreating only when the report's column set changes.
            optionsObj.dbdump_reload_mode = $('input[name="schedDbDumpReloadMode"]:checked').val() || 'recreate';
        }

        // Subscription condition: refuse an empty one, and ask before a save that
        // the last check says will remove current subscribers - AFTER every other
        // check, so nobody confirms a save that then fails.
        if (taskType === 'EMAIL' && !_schedSubsCondSaveGuard(showError)) return;

        // Check if task is disabled and warn user.
        // Skip this prompt when the save was auto-triggered by a Test Run
        // (_schedRunAfterSave): the Test Run confirm already ran and explicitly
        // promised a one-time run that returns the task to its disabled state.
        // Showing a second "enable it now?" confirm here is both a jarring
        // double-prompt and a trap - clicking OK would permanently enable the
        // task, contradicting the one-time-run intent. Keep it disabled and let
        // the run_now path temporarily enable + auto-revert it.
        var isActive = $('#saveTaskBtn').data('task-is-active');
        if (!isActive && !_schedRunAfterSave && !_schedTestOnceIntent) {
            var enableNow = confirm(
                'This task is currently not active/enabled and will not run on schedule.\n\n' +
                'Would you like to enable it now?\n\n' +
                'Click OK to enable and save, or Cancel to save as disabled.\n' +
                '(You can enable it later by clicking the green status dot.)'
            );
            if (enableNow) {
                isActive = true;
                $('#saveTaskBtn').data('task-is-active', true);
            }
        }

        const payload = {
            action: 'save',
            task_id: $('#schedTaskId').val(),
            report_id: reportId,
            task_type: taskType,
            subject: $('#schedSubject').val(),
            cron_expression: cronExpr,
            recipients: (taskType === 'SNAPSHOT' || taskType === 'DROP_FILE') ? '' : emails.join(';') + ';',
            is_active: isActive ? 1 : 0,
            // One-time draft test: server stores a hidden transient task the
            // runner executes once and deletes (see Test Run click handler)
            test_once: _schedTestOnceIntent ? 1 : 0,
            report_password: passVal,
            preserve_password: (preservePass && !passVal) ? 'true' : 'false',
            options: JSON.stringify(optionsObj),
            // DROP_FILE secret fields (sent separately for server-side encryption)
            drop_password: taskType === 'DROP_FILE' ? ($('#schedDropPassword').val() || '') : '',
            drop_s3_access_key: taskType === 'DROP_FILE' ? ($('#schedDropS3AccessKey').val() || '') : '',
            drop_s3_secret_key: taskType === 'DROP_FILE' ? ($('#schedDropS3SecretKey').val() || '') : '',
            preserve_drop_secrets: taskType === 'DROP_FILE' ? (
                ($('#schedDropPasswordNotice').is(':visible') && !$('#schedDropPassword').val()) ||
                ($('#schedDropS3AccessKeyNotice').is(':visible') && !$('#schedDropS3AccessKey').val()) ||
                ($('#schedDropS3SecretKeyNotice').is(':visible') && !$('#schedDropS3SecretKey').val())
                ? 'true' : 'false') : 'false'
        };

        // UI Feedback
        const originalText = $(this).text();
        $(this).prop('disabled', true).text('Saving...');

        $.post('manage_schedule.php', payload, function (resp) {
            if (resp.status === 'success') {
                if (resp.test_once) {
                    // One-time test of an unsaved draft: the server stored a
                    // hidden transient task the runner executes once and deletes.
                    // Stay in NEW mode - #schedTaskId stays empty on purpose, the
                    // event type stays unlocked, the panel stays open, and the
                    // baseline is NOT captured (the draft is still unsaved, so
                    // the leave-warning remains correct).
                    _schedTestOnceIntent = false;
                    _schedTransientTestId = resp.task_id || null;
                    markTransientTestQueued();
                    show_text("<p id='undo_text'><span style='color: lightgreen'>QUEUED:</span> " + (resp.message || 'One-time test run queued.') + "</p>");
                    startTransientTestPoll();
                    return;
                }
                // Lock the event type the instant the task is saved (it is now
                // an "existing" task); reopening it from the list re-locks too.
                setEventTypeLocked(true);
                // The draft is now a real row, so stop treating it as one - both
                // branches below reload the list, and the loader would otherwise
                // re-append a phantom draft card next to the saved event.
                // (The resp.test_once branch returned above on purpose: a
                // transient test leaves the draft unsaved and still open.)
                _schedDraftType = null;
                $('#cancelTaskBtn').hide();
                $('#deleteTaskBtn').show();
                if (_schedRunAfterSave) {
                    // This save was auto-triggered by Test Run on a dirty form.
                    // Keep the panel open, mark the form clean, then chain
                    // straight into the run (its toast reports the auto-save).
                    _schedRunAfterSave = false;
                    captureSchedulerBaseline();
                    // Refresh the sidebar + header Subscribe chip even though the
                    // panel stays open - the loader only repaints the list, it
                    // never touches the config panel.
                    loadSchedulerTaskList();
                    queueSchedulerTestRun($('#schedTaskId').val(), true);
                } else {
                    // Normal save: toast, then close the panel back to the list.
                    // (Shown as a toast since the panel closes.)
                    show_text("<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> " + resp.message + "</p>");
                    loadSchedulerTaskList();
                    $('.scheduler-config-panel').hide();
                    $('#schedulerPlaceholder').show();
                }
            } else if (resp.status === 'foreign_destination') {
                // Save-time server-side refusal: destination exists but isn't
                // penumbra-owned. The blur-time AJAX warning may have been
                // ignored or never fired. Surface the same red ownership banner
                // so the user has one place to look. Save does not proceed.
                var $box = $('#schedDbDumpOwnershipStatus');
                var html = '&#9888; <strong>Save refused:</strong> ' + escapeHtml(resp.message || 'Destination exists but is not penumbra-owned.');
                if (resp.existing_comment) html += '<div style="margin-top:3px; font-size: 9px; opacity:0.85;">Existing comment: ' + escapeHtml(resp.existing_comment) + '</div>';
                $box.css('border-left-color', '#a52020').html(html).show();
                var fbox = window._pnbById('schedDbDumpOwnershipStatus'); // PiP-aware
                if (fbox && fbox.scrollIntoView) fbox.scrollIntoView({behavior: 'smooth', block: 'center'});
                showError(resp.message || 'Cannot save: destination is not penumbra-owned.');
            } else if (resp.status === 'collision') {
                // DB_DUMP destination is taken by another active task. Surface the
                // collision panel with the conflict details so the user can either
                // change the table name or check Override + supply a reason and
                // resubmit.
                var c = resp.conflict || {};
                var detail = 'Currently targeted by task #' + (c.task_id || '?')
                    + ' (owner: ' + (c.owner_id || 'unknown')
                    + (c.last_run ? ', last run: ' + c.last_run : '')
                    + ').';
                $('#schedDbDumpCollisionDetail').text(detail);
                $('#schedDbDumpCollisionBox').show();
                // Don't auto-check override - user must explicitly opt in.
                $('#schedDbDumpOverride').prop('checked', false);
                $('#schedDbDumpOverrideReasonRow').hide();
                $('#schedDbDumpOverrideReason').val('');
                showError(resp.message || 'Destination is in use by another active task.');
                // Scroll the panel into view so the user notices it
                var box = window._pnbById('schedDbDumpCollisionBox'); // PiP-aware
                if (box && box.scrollIntoView) box.scrollIntoView({behavior: 'smooth', block: 'center'});
            } else if (resp.status === 'pending' && resp.test_once) {
                // Dup guard: a one-time draft test is already queued for this
                // report (e.g. from another tab). Adopt its id so Cancel and the
                // completion poll work, and reflect the queued state.
                _schedTestOnceIntent = false;
                if (resp.task_id) _schedTransientTestId = resp.task_id;
                markTransientTestQueued();
                $('#schedMsgContainer').html('<span style="color: #6c757d;">' + (resp.message || 'A one-time test is already queued for this report.') + '</span>').show();
                startTransientTestPoll();
            } else {
                showError(resp.message || "Unknown error occurred.");
            }
        }, 'json').fail(function (xhr) {
            if (xhr.status === 0 || xhr.status === 403) {
                handleSessionExpiredError();
                return;
            }

            let msg = "Server Error (500).";
            try {
                const json = JSON.parse(xhr.responseText);
                if (json.message)
                    msg = json.message;
            } catch (e) {
                if (xhr.responseText)
                    msg += " " + xhr.responseText.substring(0, 100);
            }
            showError(msg);
        }).always(function () {
            $('#saveTaskBtn').prop('disabled', false).text(originalText);
            // Clear any pending "run after save" / "test once" intent the success
            // branch didn't consume (validation/collision/server errors) so a
            // later manual save can't accidentally trigger a test run.
            _schedRunAfterSave = false;
            _schedTestOnceIntent = false;
        });
    });

    // 7. Delete Handler
    $('#deleteTaskBtn').on('click', function () {
        if (!confirm("Are you sure you want to delete this scheduled event? This cannot be undone.")) {
            return;
        }

        const $btn = $(this);
        const originalText = $btn.text();
        $btn.prop('disabled', true).text('Deleting...');

        // Hide previous errors
        $('#schedMsgContainer').hide().empty();

        $.post('manage_schedule.php', {
            action: 'delete',
            task_id: $('#schedTaskId').val()
        }, function (resp) {
            if (resp.status === 'success') {
                show_text("<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> " + (resp.message || "Task deleted.") + "</p>");
                loadSchedulerTaskList();
                $('.scheduler-config-panel').hide();
                $('#schedulerPlaceholder').show();
            } else {
                // Inline error if container exists, otherwise alert
                const msg = resp.message || "Unknown error.";
                if ($('#schedMsgContainer').length) {
                    $('#schedMsgContainer').html(`<span style="color: var(--accent-danger, #dc3545);">Error: ${msg}</span>`).show();
                } else {
                    alert("Error: " + msg);
                }
            }
        }, 'json').fail(function (xhr) {
            if (xhr.status === 0 || xhr.status === 403) {
                handleSessionExpiredError();
                return;
            }

            const msg = "Server Error (500).";
            if ($('#schedMsgContainer').length) {
                $('#schedMsgContainer').html(`<span style="color: var(--accent-danger, #dc3545);">${msg}</span>`).show();
            } else {
                alert(msg);
            }
        }).always(function () {
            $btn.prop('disabled', false).text(originalText);
        });
    });

    // --- Cancel: abandon an unsaved draft --------------------------------------
    // Sits in the action bar's LEFT slot, where Delete Event sits for a saved
    // event; openSchedulerForm shows exactly one of the two. It is a full
    // scheduler refresh rather than just a panel close, because the draft card
    // lives only in the DOM - re-fetching the list is what makes it disappear.
    $('#cancelTaskBtn').on('click', function () {
        if (!confirmLeaveScheduler()) return;
        resetSchedulerView();
    });

    // --- Test Run: queue a one-time immediate run on the next scheduler cycle ---
    // Sets the task's NEXT_RUN to now (server-side) so the runner picks it up on
    // its next tick (~5 min), runs it once, then recalculates NEXT_RUN from the
    // cron - so the normal schedule is untouched. Works on disabled tasks too: the
    // server temporarily enables them and the runner reverts to disabled after the
    // single run. Once queued, the button shows "Test Run Queued" and is disabled
    // until the runner clears the pending marker. Only available for saved tasks.
    // Queue the actual run_now request. `autoSaved` = true when we just saved the
    // user's pending edits on their behalf, so the toast can say so. Defined as a
    // hoisted function so the save handler (above) can chain into it.
    function queueSchedulerTestRun(taskId, autoSaved) {
        if (!taskId) return;
        var $btn = $('#testRunTaskBtn');
        $btn.prop('disabled', true).removeClass('has-unsaved-changes').html('Queuing…');
        $('#schedMsgContainer').hide().empty();

        function markPending() {
            $btn.prop('disabled', true).addClass('test-run-pending').removeClass('has-unsaved-changes')
                .html('&#10003;&nbsp;Test Run Queued')
                .attr('title', 'A test run is already queued for this task. It will run on the next scheduler cycle (within ~5 min), then clear automatically.');
            // Reflect the queued run in the "Next run:" preview (strike + note).
            if (typeof updateCronPreview === 'function') updateCronPreview();
        }
        function restoreDefault() {
            $btn.prop('disabled', false).removeClass('test-run-pending')
                .html('&#9658;&nbsp;Test Run')
                .attr('title', "Queue a one-time run on the next scheduler cycle (within ~5 min). Does not change the task's schedule.");
            // Drop the strike/queued note from the "Next run:" preview.
            if (typeof updateCronPreview === 'function') updateCronPreview();
            refreshTestRunDirtyState();
        }

        var savedNote = autoSaved
            ? "<span style='color: #8fd19e;'>Your unsaved changes were saved first.</span> "
            : "";

        // No 'enable' flag - the server decides from the task's stored IS_ACTIVE
        // whether to temporarily enable + auto-revert a disabled task.
        $.post('manage_schedule.php', { action: 'run_now', task_id: taskId }, function (resp) {
            if (resp.status === 'success') {
                markPending();
                show_text("<p id='undo_text'><span style='color: lightgreen'>QUEUED:</span> " + savedNote + (resp.message || 'Test run queued.') + "</p>");
                loadSchedulerTaskList();
            } else if (resp.status === 'pending') {
                // Already queued (e.g. from another tab) - reflect that state.
                markPending();
                $('#schedMsgContainer').html('<span style="color: #6c757d;">' + (resp.message || 'A test run is already queued.') + '</span>').show();
            } else {
                var msg = resp.message || 'Unknown error.';
                $('#schedMsgContainer').html('<span style="color: var(--accent-danger, #dc3545);">Error: ' + msg + '</span>').show();
                restoreDefault();
            }
        }, 'json').fail(function (xhr) {
            if (xhr.status === 0 || xhr.status === 403) { handleSessionExpiredError(); return; }
            $('#schedMsgContainer').html('<span style="color: var(--accent-danger, #dc3545);">Server Error (500).</span>').show();
            restoreDefault();
        });
    }

    // --- One-time Test Run of a NEW (unsaved) draft ---
    // The draft was saved server-side as a hidden transient task (test_once=1)
    // that the runner executes once and deletes. These helpers own the queued
    // state: disabled button, a Cancel link, and a light poll that notices the
    // row disappearing (= the run happened / was purged). The state lives only
    // in this page session on purpose - the task is invisible everywhere else.
    function resetTransientTestUi() {
        if (_schedTransientPoll) { clearInterval(_schedTransientPoll); _schedTransientPoll = null; }
        _schedTransientTestId = null;
        $('#testRunCancelLink').remove();
    }

    function markTransientTestQueued() {
        var $btn = $('#testRunTaskBtn');
        $btn.prop('disabled', true).addClass('test-run-pending').removeClass('has-unsaved-changes')
            .html('&#10003;&nbsp;Test Queued (one-time)')
            .attr('title', 'A one-time test of this draft is queued. It runs on the next scheduler cycle (within ~5 min), then removes itself - nothing was added to the events list.');
        // Reflect the queued run in the "Next run:" preview (strike + note).
        if (typeof updateCronPreview === 'function') updateCronPreview();
        // No id (server couldn't return one) -> no Cancel link: it would be a
        // dead control, since cancel posts action=delete with that id.
        if (_schedTransientTestId && !$('#testRunCancelLink').length) {
            $('<a href="#" id="testRunCancelLink" style="font-size: 11px; white-space: nowrap; color: var(--accent-danger, #dc3545); text-decoration: underline;">Cancel queued test</a>')
                .insertAfter($btn);
        }
    }

    // Back to the clickable new-draft Test Run button. `message` (optional) is
    // shown as a quiet gray note in the scheduler message container.
    function restoreTransientTestDefault(message) {
        resetTransientTestUi();
        $('#testRunTaskBtn').prop('disabled', false).removeClass('test-run-pending')
            .html('&#9658;&nbsp;Test Run')
            .attr('title', SCHED_TEST_DRAFT_TITLE);
        if (typeof updateCronPreview === 'function') updateCronPreview();
        if (message) $('#schedMsgContainer').html('<span style="color: #6c757d;">' + message + '</span>').show();
        refreshTestRunDirtyState();
    }

    // Poll test_status every 30s (runner tick is ~5 min) until the transient row
    // is gone or ~15 min passes; pauses (but keeps counting) while the panel is
    // hidden so returning to the form doesn't strand a stale "Test Queued"
    // button. report_id rides along because the non-admin grant gate can't
    // resolve the report from a deleted task id.
    function startTransientTestPoll() {
        if (_schedTransientPoll) { clearInterval(_schedTransientPoll); _schedTransientPoll = null; }
        if (!_schedTransientTestId) return;
        var pollTaskId = _schedTransientTestId;
        var reportId = new URLSearchParams(window.location.search).get('id');
        var polls = 0;
        var timer = setInterval(function () {
            polls++;
            if (polls > 30) { clearInterval(timer); return; }
