    /**
     * Classify a raw access list entry into a type.
     * @param {string} raw - The raw entry string.
     * @returns {{ type: string, value: string, display: string }}
     *   type: 'ncsu' | 'external' | 'text'
     *   value: the full string to store
     *   display: the label to show on the pill
     */
    function parseAccessEntry(raw) {
        raw = raw.trim();
        if (!raw) return null;

        // Pattern: "Firstname Lastname <email@domain>"
        var angleMatch = raw.match(/^(.+?)\s*<([^>]+)>$/);
        if (angleMatch) {
            var name = angleMatch[1].trim();
            var email = angleMatch[2].trim().toLowerCase();
            if (email.indexOf('@ncsu.edu') !== -1) {
                return { type: 'ncsu', value: raw, display: name };
            } else {
                return { type: 'external', value: raw, display: name };
            }
        }

        // Pattern: "something@ncsu.edu"
        if (raw.indexOf('@ncsu.edu') !== -1 && raw.indexOf('@') !== -1) {
            return { type: 'ncsu', value: raw, display: raw.split('@')[0] };
        }

        // Pattern: "other@emaildomain.com" (has @ and a dot after)
        if (raw.indexOf('@') !== -1 && raw.indexOf('.') !== -1) {
            return { type: 'external', value: raw, display: raw };
        }

        // Pattern: bare OUC code. Only 2/4/6-digit tokens act as OUC rules -
        // checkAuthorization (report_auth.php) matches list entries against the
        // user's 6/4/2-digit OUC prefixes by EXACT string, so other lengths
        // never match anyone and stay plain text.
        if (/^(\d{2}|\d{4}|\d{6})$/.test(raw)) {
            return { type: 'ouc', value: raw, display: raw };
        }

        // Reserved access keywords - explanatory pills. 'public' opens the
        // report (server compares the WHOLE list, case-insensitively);
        // 'adminonly' is the conventional matches-no-one placeholder. Value
        // keeps the user's exact casing so the list round-trips byte-identical.
        if (/^public$/i.test(raw)) {
            return { type: 'public', value: raw, display: raw };
        }
        if (/^adminonly$/i.test(raw)) {
            return { type: 'adminonly', value: raw, display: raw };
        }

        // Everything else: plain unityids etc.
        return { type: 'text', value: raw, display: raw };
    }
    window.parseAccessEntry = parseAccessEntry;

