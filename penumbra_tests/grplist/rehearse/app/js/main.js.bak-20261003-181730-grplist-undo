        if (matched === 0) { $note.text('None of these values appear in the current results, so this order will do nothing.'); return; }
        $note.text((count - matched) + ' of ' + count + ' values are not in the current results.');
    }

    function _csRenumberValuesList() {
        var $ul = $('#csValuesList');
        var known = _csDataValues;
        var count = 0, matched = 0;
        $ul.find('li').each(function (idx) {
            var $li = $(this);
            $li.find('.cs-val-idx').text(idx + 1);
            count++;
            if (known && !$li.hasClass('cs-val-orphan')) matched++;
        });
        _csUpdateListChrome(count, known ? matched : -1);
    }

    // Brief tint + scroll so a move/duplicate hit is perceivable without relying
    // on the focus ring. The animation is disabled under prefers-reduced-motion.
    function _csFlashValueRow($li) {
        if (!$li || !$li.length) return;
        $li.removeClass('cs-val-moved');
        void $li[0].offsetWidth;
        $li.addClass('cs-val-moved');
        if ($li[0].scrollIntoView) { try { $li[0].scrollIntoView({ block: 'nearest' }); } catch (e) { } }
    }

    function renderCSValuesList(values) {
        var $ul = $('#csValuesList');
        var ul = $ul[0];
        $ul.empty();
        var known = _csEnsureDataValueSet($('#csColumnSelect').val());
        var matched = 0;
        // Native DOM into a single fragment. "Load from Data" on a high-cardinality
        // column can produce thousands of rows, and textContent is both faster than
        // assembling an HTML string and immune to the quoting hazards that string
        // had. ownerDocument, not `document`: the dialog follows the admin console
        // into its pop-out window.
        var doc = ul ? ul.ownerDocument : document;
        var frag = doc.createDocumentFragment();
        for (var i = 0; i < values.length; i++) {
            var v = String(values[i]);
            var inData = known ? ((v.trim().toLowerCase()) in known) : true;
            if (known && inData) matched++;
            var li = doc.createElement('li');

            // A real <button>, not a <span>: keyboard users get Up/Down reordering
            // (jQuery UI sortable is pointer-only) and the row controls are tab stops.
            var grip = doc.createElement('button');
            grip.type = 'button';
            grip.className = 'cs-drag-handle';
            grip.innerHTML = '&#9776;';
            grip.title = 'Drag to reorder, or press Up / Down';
            grip.setAttribute('aria-label', 'Reorder ' + v);
            li.appendChild(grip);

            var idx = doc.createElement('span');
            idx.className = 'cs-val-idx';
            idx.textContent = String(i + 1);
            li.appendChild(idx);

            var txt = doc.createElement('span');
            txt.className = 'cs-val-text';
            txt.textContent = v;
            li.appendChild(txt);

            if (known && !inData) {
                li.className = 'cs-val-orphan';
                var flag = doc.createElement('span');
                flag.className = 'cs-val-flag';
                flag.title = 'This value is not in the current results, so it has no effect on the sort.';
                flag.textContent = 'not in data';
                li.appendChild(flag);
            }

            var rm = doc.createElement('button');
            rm.type = 'button';
            rm.className = 'cs-val-remove';
            rm.innerHTML = '&times;';
            rm.title = 'Remove';
            rm.setAttribute('aria-label', 'Remove ' + v);
            li.appendChild(rm);

            frag.appendChild(li);
        }
        if (ul) ul.appendChild(frag);
        _csUpdateListChrome(values.length, known ? matched : -1);

        // Re-initialize sortable. `cancel` MUST be overridden: its default is
        // "input,textarea,button,select,option", which would refuse to start a
        // drag on our <button> grip - the handle would look draggable and do
        // nothing. Keep the remove button cancelled so clicking it never drags.
        if ($ul.hasClass('ui-sortable')) $ul.sortable('destroy');
        $ul.sortable({
            handle: '.cs-drag-handle',
            cancel: 'input, textarea, select, option, .cs-val-remove',
            placeholder: 'ui-sortable-placeholder',
            update: function() { _csRenumberValuesList(); }
        });
    }

    function getCSValuesFromList() {
