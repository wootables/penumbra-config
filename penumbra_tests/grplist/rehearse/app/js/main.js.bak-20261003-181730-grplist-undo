            case '=':
            case '==':
                return L_val === R_val;
            case '!=':
            case '<>':
                return L_val !== R_val;
            case '>':
                return L_val > R_val;
            case '<':
                return L_val < R_val;
            case '>=':
                return L_val >= R_val;
            case '<=':
                return L_val <= R_val;
            default:
                return false;
        }
    }

