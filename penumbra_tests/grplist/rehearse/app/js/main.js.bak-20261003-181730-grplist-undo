        // data element so users discover that bars/slices/points are
        // clickable.  Edge-triggered: only writes to cursor when the
        // state changes, preventing per-mousemove canvas restyling.
        var prevOnHover = config.options.onHover;
        config.options.onHover = function (evt, elements, chart) {
            if (prevOnHover) { try { prevOnHover.call(this, evt, elements, chart); } catch (e) { } }
