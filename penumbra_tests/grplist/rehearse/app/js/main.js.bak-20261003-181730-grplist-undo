    // Opens a small config dialog for dashboard title/subtitle/autoload/animate/chartnumber.
    // If an `action(trigger, fullscreen, ...)` call already exists anywhere in the snippet,
    // the dialog opens in EDIT mode (fields pre-populated, button relabeled, replaceRange
    // used on submit). Otherwise it inserts a new line at the top.

    // Scan the snippet for an existing fullscreen action and return its args +
    // CodeMirror positions, or null if there is no match. The regex mirrors
    // the one in _snippetHasAutoloadFullscreen; the splitter handles commas
    // inside quoted strings.
    //
    // Only the FIRST match is returned. A snippet with several fullscreen
    // actions still renders every one of them at runtime (each link launches
    // with its own settings; if more than one has autoload, the LAST parsed
    // wins), but this dialog can only edit/remove one - so the returned object
    // also carries `total`, and the dialog warns when it is > 1 instead of
    // silently rewriting the first and leaving the rest behind.
    function _findExistingFullscreenAction() {
        if (!snippetEditor) return null;
        var text = snippetEditor.getValue();
        if (!text || text.indexOf('fullscreen') === -1) return null;
        var re = /action\s*\(\s*trigger\s*,\s*['"]?fullscreen['"]?\s*,([^)]*)\)/i;
        var m = re.exec(text);
        if (!m) return null;
        // Count every occurrence (fresh /g regex - a lastIndex shared with the
        // single-match exec above would skip the first one).
        var _all = text.match(/action\s*\(\s*trigger\s*,\s*['"]?fullscreen['"]?\s*,[^)]*\)/gi);
        var _total = _all ? _all.length : 1;
        var inner = m[1];
        var parts = [];
        var cur = '';
        var inStr = null;
        for (var i = 0; i < inner.length; i++) {
            var ch = inner.charAt(i);
            if (inStr) {
                // `\'` is an escaped quote, not the end of the string - the same
                // rule parseFunctionArgs uses. Without this a title holding an
                // apostrophe AND a comma ("A's, B's") closed the string early and
                // split mid-value, shifting every later arg by one and filling the
                // dialog with the wrong fields.
                if (ch === inStr && inner.charAt(i - 1) !== '\\') inStr = null;
                cur += ch;
            } else if (ch === "'" || ch === '"') {
                inStr = ch;
                cur += ch;
            } else if (ch === ',') {
                parts.push(cur.trim());
                cur = '';
            } else {
                cur += ch;
            }
        }
        if (cur) parts.push(cur.trim());
        // Strip surrounding quotes from string args for UI display. Matched-pair
        // only: linkTitle/fsTitle/fsSubtitle below are free text and may legitimately
        // end with a quote (`Live "Now"`) without starting with one.
        function unq(s) { return stripWrappingQuotePair(String(s || '')).replace(/\\'/g, "'"); }
        var autoloadRaw = unq(parts[3] || '').toLowerCase();
        var animateRaw  = unq(parts[4] || '').toLowerCase();
        var chartnumRaw = unq(parts[5] || 'all').toLowerCase();
        var intervalRaw = unq(parts[6] || '');
        var intervalNum = parseFloat(intervalRaw);
        return {
            linkTitle:  unq(parts[0] || ''),
            fsTitle:    unq(parts[1] || ''),
            fsSubtitle: unq(parts[2] || ''),
            autoload:   autoloadRaw === 'true',
            // animate defaults to true when missing/invalid (matches parser)
            animate:    animateRaw !== 'false',
            chartnumber: chartnumRaw || 'all',
            // interval (seconds): default 10 when missing/invalid, min 2 enforced at runtime
            interval:   (isFinite(intervalNum) && intervalNum >= 2) ? intervalNum : 10,
            // carousel theme override; '' = inherit the report's theme. Runs
            // through the same normalizer the runtime parser uses, so a hand-typed
            // alias ('oled') round-trips into the dropdown as its real id.
            theme:      penumbraNormalizeThemeId(unq(parts[7] || '')),
            total:      _total,
            from: snippetEditor.posFromIndex(m.index),
            to:   snippetEditor.posFromIndex(m.index + m[0].length)
