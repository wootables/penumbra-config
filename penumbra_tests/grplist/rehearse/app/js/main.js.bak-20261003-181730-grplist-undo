    // Refresh/Reset Handler
    $('#refreshSchedulerBtn').on('click', function () {
        // Refresh discards whatever is open, so it owes the same warning the
        // tab-switch, console-close and Cancel paths give. (It used to bin
        // unsaved edits silently; that matters more now that an unsaved DRAFT
        // can be what is open.)
        if (!confirmLeaveScheduler()) return;

        // Visual feedback: spin just the icon, and only if the viewer allows motion.
        const $icon = $(this).find('svg');
        if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            $icon.css('transform', 'rotate(180deg)').css('transition', 'transform 0.3s');
            setTimeout(() => $icon.css('transform', ''), 300);
        }

        // Reload data + reset the view (this is also exactly what Cancel does
        // on an unsaved draft - one function, so they cannot drift).
        resetSchedulerView();
    });

    // 2. Load Task List
    function loadSchedulerTaskList() {
        const urlParams = new URLSearchParams(window.location.search);
        const reportId = urlParams.get('id');
        const $list = $('#scheduledTasksList');

        if (!reportId) {
            $list.html('<li style="color: orange; padding: 10px;">Scheduling events require the report be saved to the server first, to attach the event info to. <a href="#" id="schedSaveReportLink" style="color: var(--brand-text, var(--brand-primary, #4285f4)); text-decoration: underline; font-weight: 600;">Save</a> this report to the server before scheduling events.</li>');
            // Hide (not just disable) the Add New Event button while the report is
            // unsaved - a visible-but-dead button alongside the notice is confusing.
            $('#schedAddRow').hide().prev('hr').hide();
            $('#addNewTaskBtn').prop('disabled', true);
            $('#schedEventsCount').text('');
            // Unsaved reports have no audit trail at all, so the jump would land
            // on the Auditor's "private, unsaved report" notice.
            $('#schedEventsLogLink').hide();
            return;
        }

        $('#schedAddRow').show().prev('hr').show();
        $('#addNewTaskBtn').prop('disabled', false);

        $.ajax({
            url: 'manage_schedule.php',
            data: {
                action: 'list',
                report_id: reportId
            },
            dataType: 'json',
            success: function (response) {
                $list.empty();
                if (response.data && response.data.length > 0) {
                    response.data.forEach(task => {
                        const isActive = parseInt(task.IS_ACTIVE) === 1;

                        // NEW: interactive dot configuration
                        const dotTitle = isActive ? "Task is Active. Click to Disable." : "Task is Inactive. Click to Enable.";
                        const dotColor = isActive ? "green" : "#ccc";
                        const dotChar = isActive ? "●" : "○";
                        const nextState = isActive ? 0 : 1;

                        const statusDot = `<span class="task-status-toggle" 
                                            data-task-id="${task.ID}" 
                                            data-new-status="${nextState}" 
                                            style="color:${dotColor}; font-weight:bold; font-size: 24px; cursor: pointer; display:inline-block;" 
                                            title="${dotTitle}">${dotChar}</span>`;

                        // --- CHANGED: Added recipient display block ---
                        // (+ current subscriber count for subscription-enabled
                        // schedules, so owners see their reach at a glance)
                        let sbCount = 0, sbEnabled = false;
                        try {
                            const sbOpts = JSON.parse(task.OPTIONS || '{}') || {};
                            // EMAIL guard: every task type round-trips the option
                            // key, so non-EMAIL tasks can carry a stale true.
                            sbEnabled = task.TASK_TYPE === 'EMAIL' && !!sbOpts.subscriptions_enabled && !sbOpts._test_run_transient;
                            if (sbEnabled && Array.isArray(sbOpts.subscribers)) sbCount = sbOpts.subscribers.length;
                        } catch (e) { }
                        const sbSuffix = sbEnabled ? ' + ' + sbCount + ' subscriber' + (sbCount === 1 ? '' : 's') : '';
                        let recipientDisplay = '';
                        if (task.RECIPIENTS) {
                            // Convert semi-colons to comma-space for nicer display
                            const cleanRecipients = task.RECIPIENTS.replace(/;/g, ', ').replace(/, $/, '');
                            recipientDisplay = `<div style="font-size: 10px; color: var(--text-muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escapeHtml(cleanRecipients + sbSuffix)}">To: ${escapeHtml(cleanRecipients)}${escapeHtml(sbSuffix)}</div>`;
                        } else if (sbEnabled) {
                            recipientDisplay = `<div style="font-size: 10px; color: var(--text-muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">To: ${sbCount} subscriber${sbCount === 1 ? '' : 's'} (subscription-only)</div>`;
                        }

                        const li = $(`<li class="sched-task-item" data-task-id="${task.ID}" style="padding: 10px; border-bottom: 1px solid #eee; cursor: pointer;">
                            <div style="display:flex; justify-content:space-between;">
                                <button type="button" class="sched-task-open" aria-label="${escapeHtml('Open ' + task.TASK_TYPE + ' event: ' + stripHtml(task.SUBJECT))}"><strong>${task.TASK_TYPE}</strong></button>
                                ${statusDot}
                            </div>
                            ${recipientDisplay}
                            <span style="font-size: 11px; opacity: 0.8;">${escapeHtml(stripHtml(task.SUBJECT))}</span><br>
                            <code style="font-size: 10px; background: rgba(0,0,0,0.05); padding: 2px; border-radius:3px;">${escapeHtml(task.CRON_EXPRESSION)}</code>
                        </li>`);
                        // ----------------------------------------------

                        li.data('task-data', task);
                        $list.append(li);
                    }
                    );
                    // Active/total count for THIS report's events - derived from the
                    // list we just fetched, so no extra round trip.
                    const schedTotal = response.data.length;
                    const schedActive = response.data.filter(function (t) { return parseInt(t.IS_ACTIVE) === 1; }).length;
                    $('#schedEventsCount').text(' · ' + schedActive + ' of ' + schedTotal + ' active');
                } else {
                    $list.html('<li style="color: var(--text-muted); padding: 10px;">No events scheduled.</li>');
                    $('#schedEventsCount').text('');
                }
                // "view log" rides alongside the count, and stays up even at zero
                // events - the schedule audit trail is exactly where a just-deleted
                // task went.
                $('#schedEventsLogLink').show();
                // The list was just rebuilt from scratch, so whatever the config
                // panel is pointing at lost its <li>. Put it back: an unsaved
                // DRAFT is re-appended (it lives only in _schedDraftType), and a
                // saved task that is open re-acquires its highlight.
                syncSchedulerListSelection();
                // Keep the header Subscribe chip in sync with scheduler edits -
                // this loader re-runs after every task save/delete/toggle, so a
                // just-enabled (or just-disabled) subscription option updates
                // the chip without a page reload.
                if (window._pnbSubSyncFromTaskList) window._pnbSubSyncFromTaskList(response.data || []);
            },
            error: function (xhr) {
                if (xhr.status === 0 || xhr.status === 403) {
                    handleSessionExpiredError();
                    return;
                }
                $list.html('<li style="color: red; padding: 10px;">Failed to load schedule list.</li>');
                $('#schedEventsCount').text('');
                $('#schedEventsLogLink').hide();
            }
        });
    }

