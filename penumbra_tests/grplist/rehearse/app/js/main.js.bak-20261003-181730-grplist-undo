        var cols = [];
        $("#tableHeader th[data-colname]").each(function () {
            var raw = $(this).data('colname');
            if (!raw || raw === '#') return;
            if (info.isNotes(raw)) return; // Notes never participates in a comparison
            var togName = info.sentinelToName[String(raw).toUpperCase()];
            if (togName) {
                // UPPERCASE like every other name this returns - the column-sync
                // dialog's raw set-membership saw a phantom mismatch otherwise.
                if (info.include) cols.push(String(togName).toUpperCase());
