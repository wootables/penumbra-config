        if (type === 'mode' || type === 'antimode') { st.freq = Object.create(null); st.order = []; }
        if (type === 'count_unique' || type === 'formula') st.uniq = Object.create(null);

        return {
            push: function (raw) {
                const s = (raw == null) ? '' : String(raw);
                st.n++;
                const t = s.trim();
                // An unticked checkbox is "blank" for the two counting types.
                if (t === '' || (toggleBlankZero && t === '0')) { st.blank++; return; }
                st.filled++;

                // Counting families never look at the value itself.
                if (type === 'count' || type === 'count_blank' || type === 'count_filled') return;
                // Trimmed, blanks already dropped above - same contract as the
                // snippet distinct().
                // A formula tracks uniqueness AND keeps going, because it may
                // need the numeric aggregates below in the same pass.
                if (st.uniq) { if (!(t in st.uniq)) st.uniq[t] = 1; if (type !== 'formula') return; }
                if (st.freq) {
                    if (!(t in st.freq)) { st.freq[t] = 0; st.order.push(t); }
                    st.freq[t]++;
                    return;
                }

                // Date-aware min/max. Strict parse against the shared format
                // list, so a bare number can never be mistaken for a year.
                //
                // The FIRST non-blank value decides whether this is a date
                // column (same rule as the group-aggregation engine). After
                // that, unparseable values are SKIPPED rather than abandoning
                // the date track - abandoning it meant a single "N/A" or "TBD"
                // anywhere in the column made min/max return nothing at all,
                // because the remaining date strings then failed the numeric
                // parse too and the footer cell came out blank.
