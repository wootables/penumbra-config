            // has no trustworthy history of its own, and the current visit's own
            // OPEN row is not written until the report query POSTs, which is what
            // makes "excluding now" exact rather than approximate.
            // -1 = first visit, so onboarding is `data(lastaccess) < 0` and
            // "what changed since" is `data(lastaccess) > 604800`. Numeric, so
            // calc()/case()/round() all work on it without a type dance.
            case 'lastaccess':
            case 'last':
                return { kind: 'num', v: (typeof penumbra_vars !== 'undefined' && typeof penumbra_vars.lastAccess === 'number') ? penumbra_vars.lastAccess : -1 };
            case 'vw':
                return { kind: 'num', v: window.innerWidth };
            case 'vh':
                return { kind: 'num', v: window.innerHeight };
            case 'prompt1':
            case 'prompt2':
            case 'prompt3':
            case 'prompt4':
            case 'prompt5':
            case 'prompt6': {
                const index = parseInt(dataType.replace('prompt', ''), 10) - 1;
                if (index >= 0 && index < allResolvedPrompts.length) {
                    val = allResolvedPrompts[index];
                } else {
                    val = 'undefined';
                }
                return { kind: 'str', v: String(val) };
            }
            default: {
                val = 'undefined';
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.has(dataType)) {
                    val = urlParams.get(dataType);
                } else {
                    const fullQuery = getQuery() + "\n" + getSnippet();
                    const promptRegex = /\[\s*PROMPT[^\]]*\]/gi;
                    let match;
                    while ((match = promptRegex.exec(fullQuery)) !== null) {
                        try {
                            const parsed = parsePrompt(match[0]);
                            if (parsed.name === dataType) {
                                const storageKey = getPromptStorageKey(match[0]);
                                const storedDataString = localStorage.getItem(storageKey);
                                if (storedDataString) {
                                    const stored = JSON.parse(storedDataString);
                                    if (stored.values !== undefined) {
                                        val = Array.isArray(stored.values) ? stored.values.map(v => v.value).join(',') : stored.values;
                                    } else if (stored.value !== undefined) {
                                        val = stored.value;
                                    } else {
                                        val = stored;
                                    }
                                } else {
                                    val = parsed.forcedefault !== null ? parsed.forcedefault : (parsed.default || 'undefined');
                                }
                                break;
                            }
                        } catch (e) { }
                    }
                }
                return { kind: 'str', v: String(val) };
            }
        }
    }

    /**
     * info(SECTION?) - the phpinfo() of a Penumbra report.
     *
     * One table listing every value a snippet can read - all of me(), all of
     * data(), plus the browser environment and the app/engine state that
     * explains WHY a value came out the way it did. It exists to answer
     * "why does my snippet say that?" without a console.
     *
     * ADMIN ONLY. Non-admins get '' (the call disappears, no placeholder, no
     * error) - the environment/engine rows are the same class of internals
     * query.php keeps behind $isAdmin. `?noadm` clears isGlobalAdmin, which
     * makes that gate testable from the URL bar.
     *
     * Values are read through penumbraDataLookup() and penumbra_vars.shibboleth
     * - the SAME sources data() and me() read - so the table can never claim a
     * value the functions would not return. That is the whole point of it.
     *
     * Callers must protect the result from their number-format pass (engine A
     * pushes it through unformattedLiterals, engine B wraps it in \x02): an
     * emplid like 001132622 re-rendered as "1,132,622" would make the one
     * surface that must be exact the least trustworthy one.
     *
     * @param {string} section - 'all' (default) or one section / alias
     * @param {string} engineLabel - which engine is rendering (troubleshooting
     *                 A-vs-B divergence is a first-class use of this table)
     * @returns {string} HTML, or '' when the viewer is not an app admin
     */
    function penumbraBuildInfoTable(section, engineLabel) {
        if (typeof penumbra_vars === 'undefined' || !penumbra_vars || !penumbra_vars.isGlobalAdmin) return '';

        const SECTIONS = {
            identity:    ['identity', 'me', 'user'],
            report:      ['report', 'data'],
            view:        ['view', 'table', 'columns'],
            prompts:     ['prompts', 'prompt'],
            environment: ['environment', 'env', 'browser'],
            engine:      ['engine', 'app', 'build']
        };
        const want = String(section == null ? '' : section).replace(/^['"]|['"]$/g, '').toLowerCase().trim() || 'all';
        const show = name => want === 'all' || SECTIONS[name].indexOf(want) !== -1;

        // Every reader is wrapped: this table is most valuable exactly when
        // something is broken, so one missing global must never take the whole
        // snippet down with it.
        const safe = fn => { try { const v = fn(); return (v === undefined || v === null) ? '' : v; } catch (e) { return '(error: ' + (e && e.message ? e.message : 'unreadable') + ')'; } };
        const dv = (key, arg, arg2) => safe(() => String(penumbraDataLookup(key, arg, arg2).v));

        const out = [];
        // Cell text: HTML-escaped, then PARENTHESES turned into entities.
        //
        // The entities are load-bearing, not cosmetic. Both engines resolve
        // nesting by substituting a handler's result back into the text and
        // re-scanning it, and this table's whole left column is literal
        // `data(count)` / `me(fname)` strings - which the very next pass would
        // happily match and RESOLVE, replacing the key names with their own
        // values. `&#40;` renders as '(' but is invisible to a regex looking for
        // a literal one. (Engine A defers restoration past the loop and would
        // survive without this; engine B substitutes immediately and would not.)
        const cell = s => escapeHtml(String(s)).replace(/\(/g, '&#40;').replace(/\)/g, '&#41;');
        const sec = title => out.push('<tr><th class="penumbra-info-section" colspan="2">' + cell(title) + '</th></tr>');
        const row = (k, v) => {
            const s = (v === undefined || v === null) ? '' : String(v);
            out.push('<tr><td class="penumbra-info-key">' + cell(k) + '</td><td class="penumbra-info-val">'
                + (s === '' ? '<span class="penumbra-info-empty">(empty)</span>' : cell(s)) + '</td></tr>');
        };
        // Seconds -> "3 days, 4 hours" so an author can sanity-check a
        // data(lastaccess) threshold without doing the arithmetic themselves.
        const humanAge = secs => {
            const n = parseInt(secs, 10);
            if (isNaN(n)) return '';
            if (n < 0) return 'never (first visit)';
            if (n < 60) return n + ' second' + (n === 1 ? '' : 's');
            const units = [['day', 86400], ['hour', 3600], ['minute', 60]];
            const parts = [];
            let rest = n;
            units.forEach(u => {
                const q = Math.floor(rest / u[1]);
                if (q > 0) { parts.push(q + ' ' + u[0] + (q === 1 ? '' : 's')); rest -= q * u[1]; }
            });
            return parts.slice(0, 2).join(', ');
        };

        if (show('identity')) {
            sec('Identity - me()');
            const shib = (penumbra_vars && penumbra_vars.shibboleth) ? penumbra_vars.shibboleth : {};
            // Iterating the object rather than a hand-kept key list: me() reads
            // penumbra_vars.shibboleth directly, so a key added to index.php
            // shows up here the same day it starts working in me().
            const shibKeys = Object.keys(shib).sort();
            if (!shibKeys.length) row('me()', '(no Shibboleth attributes present)');
            shibKeys.forEach(k => row('me(' + k + ')', shib[k]));
            row('currentUserKey', safe(() => penumbra_vars.currentUserKey));
        }

        if (show('report')) {
            sec('Report - data()');
            row('data(title)', dv('title'));
            row('data(subtitle)', dv('subtitle'));
            row('data(count)', dv('count'));
            row('data(search)', dv('search'));
            row('data(timestamp)', dv('timestamp'));
            row('data(executetime)', dv('executetime'));
            row('data(url)', dv('url'));
            row('data(prompts)', dv('prompts'));
            const la = dv('lastaccess');
            row('data(lastaccess)', la + '  [' + humanAge(la) + ']');
            row('data(admin)', dv('admin'));
            row('data(rowlimit)', dv('rowlimit'));
            row('data(rowexpand)', dv('rowexpand'));
            row('data(snapshot)', dv('snapshot'));
        }

        if (show('view')) {
            sec('View - data()');
            row('data(pivot)', dv('pivot'));
            row('data(group)', dv('group'));
            row('data(pivot_rows)', dv('pivot_rows'));
            row('data(pivot_cols)', dv('pivot_cols'));
            row('data(pivot_vals)', dv('pivot_vals'));
            row('data(pivot_agg)', dv('pivot_agg'));
            row('data(coltotal)', dv('coltotal'));
            row('data(coltotal, visible)', dv('coltotal', 'visible'));
            row('data(coltotal, all, hidden)', dv('coltotal', 'all', 'hidden'));
            row('data(pagerows)', dv('pagerows'));
            row('data(pagepos)', dv('pagepos'));
            row('data(theme)', dv('theme'));
            row('data(density)', dv('density'));
            // colorder/colsort/colvisible need a COLUMN argument, so they cannot
            // be listed as bare keys - show the live sort instead, which is what
            // an author is usually chasing when they reach for data(colsort).
            row('active sort', safe(() => (typeof sortCriteria !== 'undefined' && sortCriteria && sortCriteria.length)
                ? sortCriteria.map(c => c.colIdentifier + ' ' + c.direction).join(', ') : '(none)'));
            row('data(colsort/colorder/colvisible)', 'per-column - call with a column name, e.g. data(colsort, AMOUNT)');
        }

        if (show('prompts')) {
            sec('Prompts');
            const prompts = safe(() => (typeof allResolvedPrompts !== 'undefined' && allResolvedPrompts) ? allResolvedPrompts : []);
            if (!prompts || !prompts.length) {
                row('(none)', 'this report resolved no prompts');
            } else {
                prompts.forEach((p, i) => row('data(prompt' + (i + 1) + ')', p));
            }
        }

        if (show('environment')) {
            sec('Environment');
            row('data(vw) x data(vh)', dv('vw') + ' x ' + dv('vh'));
            row('screen', safe(() => screen.width + ' x ' + screen.height));
            row('devicePixelRatio', safe(() => window.devicePixelRatio));
            row('page URL', safe(() => window.location.href));
            row('referrer', safe(() => document.referrer));
            row('language', safe(() => navigator.language));
            row('time zone', safe(() => Intl.DateTimeFormat().resolvedOptions().timeZone));
            row('clock (browser)', safe(() => new Date().toString()));
            row('platform', safe(() => navigator.platform));
            row('user agent', safe(() => navigator.userAgent));
            row('online', safe(() => String(navigator.onLine)));
            row('cookies enabled', safe(() => String(navigator.cookieEnabled)));
            row('prefers-reduced-motion', safe(() => String(window.matchMedia('(prefers-reduced-motion: reduce)').matches)));
            row('prefers-color-scheme', safe(() => window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
        }

        if (show('engine')) {
            sec('Engine and app');
            row('snippet engine', engineLabel || 'unknown');
            row('report id (?id=)', safe(() => new URLSearchParams(window.location.search).get('id') || '(unsaved / ad-hoc view)'));
            row('loaded state name', safe(() => currentLoadedStateName || '(none)'));
            row('isGlobalAdmin', safe(() => String(penumbra_vars.isGlobalAdmin)));
            row('isAdmin (may edit this report)', safe(() => String(penumbra_vars.isAdmin)));
            row('canEditReport / canScheduleReport', safe(() => String(penumbra_vars.canEditReport) + ' / ' + String(penumbra_vars.canScheduleReport)));
            row('noadm', safe(() => String(penumbra_vars.noadm)));
            row('?asof= version', safe(() => penumbra_vars.asOf ? JSON.stringify(penumbra_vars.asOf) : (penumbra_vars.asOfError || '(live)')));
            row('subscriptions', safe(() => penumbra_vars.subscriptions && penumbra_vars.subscriptions.tasks
                ? penumbra_vars.subscriptions.tasks.length + ' subscribable task(s)' : '(none)'));
            row('rows loaded (master)', safe(() => (typeof masterRowData !== 'undefined' && masterRowData) ? masterRowData.length : ''));
            // Counted off the DOM, not off a `visibleColumns` variable: that name
            // is declared in more than one scope in this file (an array in the
            // renderer, a number elsewhere) and whichever one the closure resolves
            // here is not guaranteed to be the array. The header row is unambiguous.
            row('columns (visible / total)', safe(() => $('#tableHeader th:visible').length + ' / ' + $('#tableHeader th').length));
            // Build stamp: index.php cache-busts main.js with filemtime, so the
            // ?v= on its own <script> tag IS the deployed build of the engine
            // rendering this table.
            row('main.js build', safe(() => {
                const s = document.querySelector('script[src*="js/main.js"]');
                const m = s ? String(s.getAttribute('src')).match(/[?&]v=([^&]+)/) : null;
                return m ? m[1] : '(unversioned)';
            }));
            row('jQuery', safe(() => $.fn.jquery));
            row('moment', safe(() => (typeof moment !== 'undefined' && moment.version) ? moment.version : '(absent)'));
            row('Chart.js', safe(() => (typeof Chart !== 'undefined' && Chart.version) ? Chart.version : '(not loaded)'));
            row('DOMPurify', safe(() => (typeof DOMPurify !== 'undefined' && DOMPurify.version) ? DOMPurify.version : '(absent)'));
            row('penumbra_* localStorage keys', safe(() => {
                let n = 0;
                for (let i = 0; i < localStorage.length; i++) { if (String(localStorage.key(i)).indexOf('penumbra') === 0) n++; }
                return n;
            }));
            row('rendered at', safe(() => new Date().toISOString()));
        }

        if (!out.length) {
            row('info(' + want + ')', 'unknown section - try all, identity, report, view, prompts, environment or engine');
        }

        // DIV, not SPAN: a <table> is not phrasing content, so an HTML parser
        // hoists it straight out of a <span> and the wrapper (and its scroll
        // box and its title bar) end up wrapping nothing.
        return '<div class="penumbra-info">'
            // Entity parens in the title for the same reason as in the cells: a
            // literal `info()` here would be re-matched by the engine's own
            // dispatch regex on the next pass and expand the table inside itself.
            + '<div class="penumbra-info-title">Penumbra info&#40;&#41; - admin diagnostics</div>'
            + '<table><tbody>' + out.join('') + '</tbody></table>'
            + '</div>';
    }

    function generateTemplateOutput(template) {
        const outputLines = [];
        const isGroupedCustom = $('#groupedResultsContainer').is(':visible');
        const isPivotCustom = $('#pivot-output-container').is(':visible');

        // Parse string(...) calls once up front (js/penumbra_template.js).
        // Templates without calls keep the legacy whole-string replace path
        // byte-for-byte, so pre-existing templates cannot change behavior.
        const tplSegments = (typeof PenumbraTemplate !== 'undefined') ? PenumbraTemplate.parse(template) : null;
        const tplHasCalls = !!(tplSegments && PenumbraTemplate.hasCalls(tplSegments));
        // data() in templates resolves run-scoped values (prompt answers,
        // title, search, theme, ...) through the same lookup the snippet
        // engine uses. Resolved per-render, identical for every row.
        const resolveTplData = argVals => {
            const dataType = String(argVals[0] || 'search').toLowerCase().trim();
            const colParam = argVals[1] ? stripWrappingQuotePair(String(argVals[1]).toUpperCase()).trim() : null;
            const dv = penumbraDataLookup(dataType, colParam, argVals[2]);
            return String(dv.v);
        };

        if (isPivotCustom) {
            const tableArray = getPivotDataAsArray();
            const flatHeaders = getFlatPivotHeaders();
            const bodyRows = tableArray.slice($('#pivotResultTable thead tr').length);
            bodyRows.forEach(row => {
                const substPivot = txt => txt.replace(/{[^}]+}/g, function (match) {
                    const colName = match.substring(1, match.length - 1);
                    const colIndex = flatHeaders.findIndex(h => h.toUpperCase() === colName.toUpperCase());
                    if (colIndex === -1) return match; // unknown placeholder - leave literal
                    return row[colIndex] != null ? String(row[colIndex]) : '';
                });
                let line;
                if (tplHasCalls) {
                    const resolvePivotRef = name => {
                        const colIndex = flatHeaders.findIndex(h => h.toUpperCase() === String(name).toUpperCase());
                        if (colIndex === -1) return null;
                        return row[colIndex] != null ? String(row[colIndex]) : '';
                    };
                    line = tplSegments.map(seg => seg.type === 'text'
                        ? substPivot(seg.value)
                        : PenumbraTemplate.evalNode(seg, resolvePivotRef, resolveTplData)).join('');
                } else {
                    line = substPivot(template);
                }
                outputLines.push(line);
            });
            return outputLines;
        }

        // Flat / grouped path with nested support.
        const $sourceRowsCustom = isGroupedCustom
            ? $("#groupedResultsContainer tbody tr:not(.search-hidden):not(.journal-note-child)")
            : $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)");
        // Comparison views key their tds POSITIONALLY over their own header
        // (which can carry snapshot-only columns) - resolve placeholders there,
        // not against the flat table's query-index ids.
        const _tplCompareView = $('#snapshotComparisonContainer').is(':visible');
        const headersCustom = (_tplCompareView
            ? $('#snapshotComparisonContainer .group-wrapper:first thead th[data-colname]').filter(function () { return $(this).attr('data-colname') !== '__SNAP_TYPE'; })
            : $("#resultsTable > thead > tr#tableHeader th[data-colname]")).map(function () {
            var _dc = $(this).data('colname');
            return { name: _dc, id: $(this).data('column'), isToggle: String(_dc).indexOf('__JOURNAL_TOGGLE__') === 0 };
        }).get();

        const nestedPlanCustom = getNestedColumnPlan();
        // Uppercase "PARENT-SUB" → { parentName, subName }
        const nestedKeyMap = {};
        nestedPlanCustom.forEach(p => {
            p.subNames.forEach(sub => {
                nestedKeyMap[(p.parentName + '-' + sub).toUpperCase()] = {
                    parentName: p.parentName,
                    subName: sub
                };
            });
        });
        const templatePlaceholdersUpper = (template.match(/{[^}]+}/g) || [])
            .map(p => p.substring(1, p.length - 1).toUpperCase());
        // Bare column refs inside string() calls also participate in
        // nested-column zip detection ({PARENT-SUB} refs are already caught
        // by the raw-template scan above).
        if (tplHasCalls) {
            PenumbraTemplate.collectRefs(tplSegments).forEach(r => templatePlaceholdersUpper.push(r));
        }
        // Placeholders may name hidden columns, whose cells may still be EMPTY.
        penumbraFillLazyColumnsByName(templatePlaceholdersUpper);
        const referencedParents = new Set();
        templatePlaceholdersUpper.forEach(ph => {
            if (nestedKeyMap[ph]) referencedParents.add(nestedKeyMap[ph].parentName);
        });
        const expandsNested = referencedParents.size > 0;
        const nestedParentByUpperName = {};
        nestedPlanCustom.forEach(p => {
            nestedParentByUpperName[p.parentName.toUpperCase()] = p;
        });

        function renderLine(plainSubs, extraSubs) {
            const substFlat = txt => txt.replace(/{[^}]+}/g, function (match) {
                const key = match.substring(1, match.length - 1).toUpperCase();
                if (extraSubs && Object.prototype.hasOwnProperty.call(extraSubs, key)) return extraSubs[key];
                if (Object.prototype.hasOwnProperty.call(plainSubs, key)) return plainSubs[key];
                if (nestedKeyMap[key]) return ''; // known nested placeholder, no data this row
                return match; // unknown placeholder - leave literal
            });
            if (!tplHasCalls) return substFlat(template);
            const resolveFlatRef = name => {
                const key = String(name).toUpperCase();
                if (extraSubs && Object.prototype.hasOwnProperty.call(extraSubs, key)) return extraSubs[key];
                if (Object.prototype.hasOwnProperty.call(plainSubs, key)) return plainSubs[key];
                if (nestedKeyMap[key]) return '';
                return null; // not a column - ref renders as its literal text
            };
            return tplSegments.map(seg => seg.type === 'text'
                ? substFlat(seg.value)
                : PenumbraTemplate.evalNode(seg, resolveFlatRef, resolveTplData)).join('');
        }

        // Journal columns are keyed in plainSubs by their sentinel data-colname;
        // alias each to its friendly name so a {Done}/{Notes} token resolves too
        // (the legacy {__JOURNAL_TOGGLE__done} token keeps working via its own key).
        var _jTplAlias = [];
        headersCustom.forEach(function (h) {
            var f = (window.Penumbra && window.Penumbra.journalFriendlyCol && window.Penumbra.journalFriendlyCol(h.name)) || null;
            if (f) _jTplAlias.push({ s: String(h.name).toUpperCase(), f: String(f).toUpperCase() });
        });

        $sourceRowsCustom.each(function () {
            const $row = $(this);

            // Plain values; bare {Parent} on a nested column emits the full
            // raw JSON string (from the row's own cell) instead of garbled
            // mixed text + JSON.
            const plainSubs = {};
            headersCustom.forEach(h => {
                const upperName = String(h.name).toUpperCase();
                const np = nestedParentByUpperName[upperName];
                if (np) {
                    const rawText = getRowNestedRawText($row, np.colId);
                    plainSubs[upperName] = (rawText != null) ? rawText : '';
                } else if (h.isToggle) {
                    // A journal TOGGLE cell is a textless checkbox, so emit its
                    // '1'/'0' via the SHARED export helper - the exact value the
                    // Copy/Download/Email exports and journal_export.php produce.
                    // Fall back to displayed text when the helper can't read it
                    // (e.g. a snapshot-comparison cell that renders a value as text).
                    const _tCell = $row.find(`td[data-column='${h.id}']`)[0];
                    const _tv = (window.Penumbra && window.Penumbra.journalExportCell) ? window.Penumbra.journalExportCell(_tCell) : null;
                    plainSubs[upperName] = (_tv != null) ? _tv : _readComparisonCellText(_tCell);
                } else {
                    // Current value only for comparison "modified" cells - a bare
                    // .text() rendered both dual views glued into the template.
                    plainSubs[upperName] = _readComparisonCellText($row.find(`td[data-column='${h.id}']`)[0]);
                }
            });
            for (var _ja = 0; _ja < _jTplAlias.length; _ja++) {
                if (Object.prototype.hasOwnProperty.call(plainSubs, _jTplAlias[_ja].s)) plainSubs[_jTplAlias[_ja].f] = plainSubs[_jTplAlias[_ja].s];
            }

            if (!expandsNested) {
                outputLines.push(renderLine(plainSubs, null));
                return;
            }

            // Parallel-zip across all referenced nested parents on this row.
            const subRowsByParent = {};
            let maxRows = 0;
            referencedParents.forEach(pName => {
                const planEntry = nestedPlanCustom.find(p => p.parentName === pName);
                if (!planEntry) { subRowsByParent[pName] = []; return; }
                const parsed = getRowNestedArray($row, planEntry.colId);
                if (!Array.isArray(parsed)) { subRowsByParent[pName] = []; return; }
                const rows = parsed.filter(it => it && typeof it === 'object').map(item => {
                    const m = {};
                    planEntry.subNames.forEach(sub => {
                        const key = (pName + '-' + sub).toUpperCase();
                        let v = item[sub];
                        if (v == null) { m[key] = ''; return; }
                        let sv = String(v);
                        if (sv.substring(0, 6) === '@@HTML') {
                            sv = sv.substring(6).replace(/<[^>]*>/g, '').trim();
                        }
                        m[key] = sv;
                    });
                    return m;
                });
                subRowsByParent[pName] = rows;
                if (rows.length > maxRows) maxRows = rows.length;
            });

            if (maxRows === 0) {
                outputLines.push(renderLine(plainSubs, {}));
                return;
            }

            for (let ni = 0; ni < maxRows; ni++) {
                const extra = {};
                referencedParents.forEach(pName => {
                    const rows = subRowsByParent[pName] || [];
                    const subMap = (ni < rows.length) ? rows[ni] : null;
                    const planEntry = nestedPlanCustom.find(p => p.parentName === pName);
                    if (!planEntry) return;
                    planEntry.subNames.forEach(sub => {
                        const key = (pName + '-' + sub).toUpperCase();
                        extra[key] = subMap ? (subMap[key] || '') : '';
                    });
                });
                outputLines.push(renderLine(plainSubs, extra));
            }
        });

        return outputLines;
    }

    // Returns true if the current (non-pivot) view contains @@JSON nested
    // sub-tables in any visible column. Used to decide whether to surface
    // the "flatten nested tables" sub-option in the CSV/TSV export pickers.
    // Defers to getNestedColumnPlan (DOM-based) so it agrees with the
    // extraction paths in every view, including snapshot comparison.
    function hasNestedJsonData() {
        if ($('#pivot-output-container').is(':visible')) return false;
        try {
            return getNestedColumnPlan().length > 0;
        } catch (e) {
            return false;
        }
    }

    // Builds a per-parent description of the nested @@JSON sub-column schema
    // for the current view: returns an array of
    //   { parentName: <display name>, colId: <td data-column id>, mapKey: <masterRowData key>, subNames: [<sub keys>] }
    // Shared by the CSV/TSV flatten path (getExportData), the custom-copy
    // template path, and the distinct-column copy so all surfaces agree on
    // which columns are nested and what sub-keys live inside them. Sub-key
    // discovery scans the rendered DOM cells (works in flat, grouped, and
    // comparison views); colId lets callers read each row's own cell.
    // Returns [] when there is no nested data (pivot, empty, or flat tables).
    function getNestedColumnPlan() {
        if ($('#pivot-output-container').is(':visible')) return [];

        const isGrouped = $('#groupedResultsContainer').is(':visible');
        const $rows = isGrouped
            ? $("#groupedResultsContainer tbody tr:not(.search-hidden):not(.journal-note-child)")
            : $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)");
        if ($rows.length === 0) return [];
        const sampleMax = Math.min($rows.length, 50);
        // Hidden @@JSON parents may still be EMPTY (penumbraFillLazyColumns):
        // fill each one whose sampled rows carry nested data, so the plan sees
        // the same rendered cells the build used to make. (2026-09-30)
        if (_pnbLazyCols.size) {
            const _npIdx = [];
            for (let i = 0; i < sampleMax; i++) {
                const _ix = _pnbLazyRowIndex($rows[i]);
                if (_ix >= 0 && masterRowData[_ix]) _npIdx.push(_ix);
            }
            const _npFill = [];
            const _npThs = document.querySelectorAll('#resultsTable > thead > tr#tableHeader th[data-colname]');
            for (let t = 0; t < _npThs.length; t++) {
                const _id = _npThs[t].getAttribute('data-column');
                if (!_pnbLazyCols.has(_id)) continue;
                const _key = String(_npThs[t].getAttribute('data-colname')).toUpperCase();
                for (let k = 0; k < _npIdx.length; k++) {
                    const _v = masterRowData[_npIdx[k]].get(_key);
                    if (_v != null && String(_v).indexOf('@@JSON') !== -1) { _npFill.push(_id); break; }
                }
            }
            if (_npFill.length) penumbraFillLazyColumns(_npFill);
        }

        const plan = [];
        $("#resultsTable > thead > tr#tableHeader th[data-colname]").each(function () {
            const name = $(this).data('colname');
            const colId = $(this).data('column');
            if (!name || name === '#') return;

            // Resolve display name → masterRowData key (Oracle UPPERCASE, mixed
            // case, etc.) for callers that still read masterRowData. Best-effort;
            // extraction itself uses the DOM cell so this isn't load-bearing.
            let mapKey = name;
            if (masterRowData && masterRowData.length) {
                for (let i = 0; i < masterRowData.length; i++) {
                    const m = masterRowData[i];
                    if (!m) continue;
                    if (m.has(name)) { mapKey = name; break; }
                    const upper = String(name).toUpperCase();
                    if (m.has(upper)) { mapKey = upper; break; }
                    let found = false;
                    for (const k of m.keys()) {
                        if (String(k).toUpperCase() === upper) { mapKey = k; found = true; break; }
                    }
                    if (found) break;
                    break;
                }
            }

            // Discover sub-keys by sampling the rendered cells for this column.
            const subNamesSet = new Set();
            for (let i = 0; i < sampleMax; i++) {
                const arr = getRowNestedArray($rows.eq(i), colId);
                if (!arr) continue;
                arr.forEach(item => {
                    if (item && typeof item === 'object') {
                        Object.keys(item).forEach(k => subNamesSet.add(k));
                    }
                });
            }

            if (subNamesSet.size > 0) {
                plan.push({
                    parentName: name,
                    colId: colId,
                    mapKey: mapKey,
                    subNames: Array.from(subNamesSet)
                });
            }
        });

        return plan;
    }

    // Resolves the current prompt values keyed by their URL parameter name,
    // matching what the live query is actually running with. Used by the
    // API-snippet generator so the emitted code runs out of the box and
    // returns the same data the user is currently seeing.
    //
    // Priority order mirrors `updatePromptDisplay` (the byline renderer):
    //   1. URL param: ?promptname=value wins (URL override is the system's
    //      canonical "current value" when present).
    //   2. localStorage: the saved answer keyed by getPromptStorageKey.
    //   3. Skip: prompt has no answer in either place (will fall through to
    //      its default at runtime - same as if the user hadn't set it).
    //
    // Only prompts that declare `name=` are included; nameless prompts can't
    // be addressed via URL parameter, so emitting them in the snippet's
    // params dict would be useless. Hidden prompts are also skipped since
    // they're not user-facing.
    function getCurrentPromptParams() {
        const result = {};
        try {
            const query = (typeof getQuery === 'function') ? getQuery() : (typeof editor !== 'undefined' && editor ? editor.getValue() : '');
            const snippet = (typeof getSnippet === 'function') ? getSnippet() : '';
            const allQueries = (query || '') + '\n' + (snippet || '');
            const urlParams = new URLSearchParams(window.location.search);
            const promptRegex = /\[\s*PROMPT[^\]]*\]/gi;
            let match;
            while ((match = promptRegex.exec(allQueries)) !== null) {
                let parsed;
                try { parsed = parsePrompt(match[0]); } catch (e) { continue; }
                if (!parsed || !parsed.name || parsed.hidden) continue;
                // Don't emit duplicates if the same prompt appears twice
                if (Object.prototype.hasOwnProperty.call(result, parsed.name)) continue;

                // 1. URL takes priority - current page is the canonical "what
                //    am I looking at right now" source.
                if (urlParams.has(parsed.name)) {
                    result[parsed.name] = urlParams.get(parsed.name);
                    continue;
                }

                // 2. Fall back to localStorage. The stored shape varies by
                //    prompt type (single text → string/obj; dropdown → {value,
                //    display}; multi-select → {values: [{value,display}]} or
                //    a bare array). We extract `value` (the bind value)
                //    rather than `display` since that's what the URL param
                //    needs to be for the server to re-resolve it correctly.
                let storedDataString;
                try {
                    const storageKey = getPromptStorageKey(match[0]);
                    storedDataString = localStorage.getItem(storageKey);
                } catch (e) { continue; }
                if (!storedDataString) continue;

                let storedData;
                try { storedData = JSON.parse(storedDataString); } catch (e) { continue; }

                let valueToParse = storedData;
                if (storedData && storedData.values !== undefined) {
                    valueToParse = storedData.values;
                }

                let urlValue = null;
                if (Array.isArray(valueToParse)) {
                    // Multi-select: comma-join the bind values (NOT the
                    // display labels). System reassembles on the server side.
                    const parts = valueToParse.map(item => {
                        if (item == null) return '';
                        if (typeof item === 'object') {
                            return (item.value !== undefined && item.value !== null) ? String(item.value)
                                : (item.display !== undefined && item.display !== null) ? String(item.display)
                                : '';
                        }
                        return String(item);
                    }).filter(s => s !== '');
                    if (parts.length > 0) urlValue = parts.join(',');
                } else if (valueToParse && typeof valueToParse === 'object') {
                    if (valueToParse.value !== undefined && valueToParse.value !== null) urlValue = String(valueToParse.value);
                    else if (valueToParse.display !== undefined && valueToParse.display !== null) urlValue = String(valueToParse.display);
                } else if (valueToParse !== null && valueToParse !== undefined) {
                    urlValue = String(valueToParse);
                }

                if (urlValue !== null && urlValue !== '') {
                    result[parsed.name] = urlValue;
                }
            }
        } catch (e) {
            // Any failure (no editor, no localStorage access, etc.) - return
            // whatever we managed to collect rather than throw out of the
            // snippet generator.
        }
        return result;
    }

    // Collects the currently-visible column names for use in API-snippet
    // example comments. Returns at most `limit` names; pass 0 (or omit) for
    // unlimited (all visible columns). Pivot mode reads from
    // getFlatPivotHeaders so pivoted column structure is reflected. Falls
    // back to a generic placeholder when the view has no resolvable columns.
    function getApiSnippetSampleColumns(limit) {
        const unlimited = !limit || limit <= 0;
        let names = [];
        try {
            if ($('#pivot-output-container').is(':visible') && typeof getFlatPivotHeaders === 'function') {
                names = getFlatPivotHeaders().filter(function (n) { return n && n !== '#'; });
            } else {
                names = $("#resultsTable > thead > tr#tableHeader th[data-colname]")
                    .map(function () { return $(this).data('colname'); })
                    .get()
                    .filter(function (n) { return n && n !== '#'; });
            }
        } catch (e) { /* fall through */ }
        if (names.length === 0) names = ['COLUMN_1', 'COLUMN_2', 'COLUMN_3'];
        return unlimited ? names : names.slice(0, limit);
    }

    // Per-language third-party-API snippet generators. Each takes the
    // already-resolved URL (with &json=1), the full visible-column array,
    // and a dict of prompt parameter defaults pulled from the current URL
    // query string. Returns an idiomatic, copy-pasteable script.
    //
    // The shape is the same across all five:
    //   1. Define a `params` dict containing the report's prompt overrides
    //      (defaulted to the user's current view values - that's why the
    //      script works out of the box and produces the same data the user
    //      is currently looking at).
    //   2. Declare URL → fetch (with params attached) → parse JSON.
    //   3. Iterate rows with EVERY column listed as a commented field
    //      reference inside the loop body so the user has the full schema
    //      in front of them when customizing the script.
    //
    // Auth: this endpoint isn't Shibboleth-protected - index.php gates JSON
    // access via API key + IP allowlist + per-report access list (the
    // `Use 'public' for global access` field on saved reports). A short
    // one-line note appears in each snippet so anyone running the script
    // from a new machine understands why they might get an "Invalid API
    // key" error and who to ask.
    function generateApiSnippet(language, apiUrl, sampleCols, promptParams) {
        // Use all visible columns. The first two seed the "real" example
        // print/log line (so the snippet does *something* visible out of
        // the box); the rest are listed as commented references.
        const cols = (sampleCols && sampleCols.length) ? sampleCols : ['COLUMN_1', 'COLUMN_2', 'COLUMN_3'];
        const col1 = cols[0];
        const col2 = cols.length > 1 ? cols[1] : cols[0];

        // Per-language line of accessor comments - one per column.
        const exampleLines = (formatter) => cols.map(formatter).join('\n');

        const params = promptParams || {};
        const paramKeys = Object.keys(params);
        const hasParams = paramKeys.length > 0;

        switch (language) {
            case 'python': {
                const paramLines = hasParams
                    ? paramKeys.map(k => '    ' + JSON.stringify(k) + ': ' + JSON.stringify(params[k]) + ',').join('\n')
                    : '    # "your_prompt_name": "value",';
                return [
                    'import requests',
                    '',
                    '# Live-view URL. With a saved-report id this is the canonical short URL;',
                    '# otherwise it carries the full encoded view state. The &json=1 parameter',
                    '# switches the response from HTML to JSON.',
                    'url = ' + JSON.stringify(apiUrl),
                    '',
                    '# Report parameters - defaults to your current view\'s prompt values.',
                    '# Change any value here to query a different slice without rebuilding the URL.',
                    'params = {',
                    paramLines,
                    '}',
                    '',
                    '# Access requires the report\'s access list to include \'public\' or your identity.',
                    '# If you get "Access Denied", ask the report owner to update the access list.',
                    '',
                    'response = requests.get(url, params=params)',
                    'response.raise_for_status()',
                    'data = response.json()',
                    '',
                    '# Check for API errors (auth failures return an object, not a row list).',
                    'if isinstance(data, dict) and \'error\' in data:',
                    '    print(\'API error:\', data[\'error\'])',
                    '    exit(1)',
                    '',
                    '# `data` is a list of dicts - one per row. Each dict\'s keys match the',
                    '# report\'s column headers as shown in the live view.',
                    'for row in data:',
                    '    # Replace with your own logic. Every visible field is listed below:',
                    exampleLines(function (c) { return '    #   row[' + JSON.stringify(c) + ']'; }),
                    '    print(row[' + JSON.stringify(col1) + '], row[' + JSON.stringify(col2) + '])',
                    ''
                ].join('\n');
            }

            case 'powershell': {
                // PS hashtable. Keys are bareword if valid identifier,
                // else single-quoted. Values single-quoted strings.
                const psKey = function (k) {
                    return /^[A-Za-z_][A-Za-z0-9_]*$/.test(k) ? k : powershellQuote(k);
                };
                const paramLines = hasParams
                    ? paramKeys.map(k => '    ' + psKey(k) + ' = ' + powershellQuote(params[k])).join('\n')
                    : "    # your_prompt_name = 'value'";
                return [
                    '# Live-view URL. With a saved-report id this is the canonical short URL;',
                    '# otherwise it carries the full encoded view state. The &json=1 parameter',
                    '# switches the response from HTML to JSON.',
                    '$url = ' + powershellQuote(apiUrl),
                    '',
                    '# Report parameters - defaults to your current view\'s prompt values.',
                    '# Change any value here to query a different slice without rebuilding the URL.',
                    '$params = @{',
                    paramLines,
                    '}',
                    '',
                    '# Access requires the report\'s access list to include \'public\' or your identity.',
                    '# If you get "Access Denied", ask the report owner to update the access list.',
                    '',
                    '# Invoke-RestMethod appends -Body params as a query string for GET requests.',
                    '$data = Invoke-RestMethod -Uri $url -Body $params',
                    '',
                    '# Check for API errors (auth failures return an object, not a row array).',
                    'if ($data.error) {',
                    '    Write-Error "API error: $($data.error)"',
                    '    exit 1',
                    '}',
                    '',
                    '# $data is an array of PSCustomObjects - one per row. Property names match',
                    '# the report\'s column headers as shown in the live view.',
                    'foreach ($row in $data) {',
                    '    # Replace with your own logic. Every visible field is listed below:',
                    exampleLines(function (c) { return '    #   $row.' + powershellPropAccess(c); }),
                    '    Write-Output ("{0} - {1}" -f $row.' + powershellPropAccess(col1) + ', $row.' + powershellPropAccess(col2) + ')',
                    '}',
                    ''
                ].join('\n');
            }

            case 'node': {
                const paramLines = hasParams
                    ? paramKeys.map(k => '    ' + JSON.stringify(k) + ': ' + JSON.stringify(params[k]) + ',').join('\n')
                    : '    // your_prompt_name: "value",';
                return [
                    '// Live-view URL. With a saved-report id this is the canonical short URL;',
                    '// otherwise it carries the full encoded view state. The &json=1 parameter',
                    '// switches the response from HTML to JSON.',
                    'const url = ' + JSON.stringify(apiUrl) + ';',
                    '',
                    '// Report parameters - defaults to your current view\'s prompt values.',
                    '// Change any value here to query a different slice without rebuilding the URL.',
                    'const params = {',
                    paramLines,
                    '};',
                    '',
                    '// Access requires the report\'s access list to include \'public\' or your identity.',
                    '// If you get "Access Denied", ask the report owner to update the access list.',
                    '// Native fetch is available in Node 18+.',
                    '',
                    'async function main() {',
                    '    const qs = new URLSearchParams(params).toString();',
                    '    const fullUrl = qs ? url + "&" + qs : url;',
                    '    const response = await fetch(fullUrl);',
                    '    if (!response.ok) throw new Error(`HTTP ${response.status}: ${response.statusText}`);',
                    '    const data = await response.json();',
                    '',
                    '    // Check for API errors (auth failures return an object, not a row array).',
                    '    if (!Array.isArray(data)) {',
                    '        console.error(\'API error:\', data.error || JSON.stringify(data));',
                    '        process.exit(1);',
                    '    }',
                    '',
                    '    // `data` is an array of objects - one per row. Each object\'s keys match',
                    '    // the report\'s column headers as shown in the live view.',
                    '    for (const row of data) {',
                    '        // Replace with your own logic. Every visible field is listed below:',
                    exampleLines(function (c) { return '        //   row[' + JSON.stringify(c) + ']'; }),
                    '        console.log(row[' + JSON.stringify(col1) + '], row[' + JSON.stringify(col2) + ']);',
                    '    }',
                    '}',
                    '',
                    'main().catch(err => { console.error(err); process.exit(1); });',
                    ''
                ].join('\n');
            }

            case 'php': {
                const paramLines = hasParams
                    ? paramKeys.map(k => '    ' + phpQuote(k) + ' => ' + phpQuote(params[k]) + ',').join('\n')
                    : "    // 'your_prompt_name' => 'value',";
                return [
                    '<?php',
                    '// Live-view URL. With a saved-report id this is the canonical short URL;',
                    '// otherwise it carries the full encoded view state. The &json=1 parameter',
                    '// switches the response from HTML to JSON.',
                    '$url = ' + phpQuote(apiUrl) + ';',
                    '',
                    '// Report parameters - defaults to your current view\'s prompt values.',
                    '// Change any value here to query a different slice without rebuilding the URL.',
                    '$params = [',
                    paramLines,
                    '];',
                    '',
                    '// Access requires the report\'s access list to include \'public\' or your identity.',
                    '// If you get "Access Denied", ask the report owner to update the access list.',
                    '',
                    '$fullUrl = empty($params) ? $url : $url . "&" . http_build_query($params);',
                    '$ch = curl_init($fullUrl);',
                    'curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);',
                    'curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);',
                    '',
                    '$response = curl_exec($ch);',
                    'if ($response === false) {',
                    '    fwrite(STDERR, "Request failed: " . curl_error($ch) . "\\n");',
                    '    exit(1);',
                    '}',
                    'curl_close($ch);',
                    '',
                    '$data = json_decode($response, true);',
                    '',
                    '// Check for API errors (auth failures return an object, not a row list).',
                    'if (isset($data[\'error\'])) {',
                    '    fwrite(STDERR, "API error: " . $data[\'error\'] . "\\n");',
                    '    exit(1);',
                    '}',
                    '',
                    '// $data is an array of associative arrays - one per row. Each row\'s keys',
                    '// match the report\'s column headers as shown in the live view.',
                    'foreach ($data as $row) {',
                    '    // Replace with your own logic. Every visible field is listed below:',
                    exampleLines(function (c) { return '    //   $row[' + phpQuote(c) + ']'; }),
                    '    echo $row[' + phpQuote(col1) + '] . " - " . $row[' + phpQuote(col2) + '] . "\\n";',
                    '}',
                    ''
                ].join('\n');
            }

            case 'bash': {
                // For bash, expose each prompt as an individual env-style
                // variable (PARAM_<KEY>=…) so the user can edit them one at
                // a time. Then assemble them via jq's @uri filter for safe
                // URL-encoding (handles spaces, special chars, etc.).
                const bashSafeVarName = function (key) {
                    return 'PARAM_' + String(key).toUpperCase().replace(/[^A-Z0-9_]/g, '_');
                };
                const paramDecls = hasParams
                    ? paramKeys.map(k => bashSafeVarName(k) + '=' + bashQuote(params[k])).join('\n')
                    : '# PARAM_YOUR_PROMPT_NAME="value"';
                const paramBuildLines = hasParams
                    ? [
                        '# URL-encode each value via jq\'s @uri filter, then join into a query string.',
                        'PARAMS=""',
                        ...paramKeys.map(k =>
                            'PARAMS="${PARAMS:+$PARAMS&}' + k + '=$(jq -rn --arg v "$' + bashSafeVarName(k) + '" \'$v|@uri\')"'
                        )
                    ].join('\n')
                    : 'PARAMS=""';
                return [
                    '#!/usr/bin/env bash',
                    '# Live-view URL. With a saved-report id this is the canonical short URL;',
                    '# otherwise it carries the full encoded view state. The &json=1 parameter',
                    '# switches the response from HTML to JSON.',
                    'URL=' + bashQuote(apiUrl),
                    '',
                    '# Report parameters - defaults to your current view\'s prompt values.',
                    '# Change any value here to query a different slice.',
                    paramDecls,
                    '',
                    paramBuildLines,
                    '',
                    '# Access requires the report\'s access list to include \'public\' or your identity.',
                    '# If you get "Access Denied", ask the report owner to update the access list.',
                    '# Requires `jq` for JSON parsing (and for URL-encoding the params above).',
                    '',
                    'RESPONSE=$(curl -fsSL "${URL}${PARAMS:+&$PARAMS}")',
                    '',
                    '# Check for API errors (auth failures return an object, not a row array).',
                    'ERROR=$(echo "$RESPONSE" | jq -r \'.error // empty\')',
                    'if [ -n "$ERROR" ]; then',
                    '    echo "API error: $ERROR" >&2',
                    '    exit 1',
                    'fi',
                    '',
                    '# Iterate each row as a compact JSON object piped through jq.',
                    'echo "$RESPONSE" | jq -c \'.[]\' | while IFS= read -r row; do',
                    '    # Replace with your own logic. Every visible field is listed below:',
                    exampleLines(function (c) { return '    #   $(echo "$row" | jq -r ' + bashQuote('.' + jqFieldPath(c)) + ')'; }),
                    '    COL1=$(echo "$row" | jq -r ' + bashQuote('.' + jqFieldPath(col1)) + ')',
                    '    COL2=$(echo "$row" | jq -r ' + bashQuote('.' + jqFieldPath(col2)) + ')',
                    '    echo "$COL1 - $COL2"',
                    'done',
                    ''
                ].join('\n');
            }

            default:
                return '// Unknown language: ' + language + '\n';
        }
    }

    // --- Per-language quoting helpers for the snippet generator ---

    // PowerShell single-quoted string literal: no interpolation, ' escaped by doubling.
    function powershellQuote(s) {
        return "'" + String(s).replace(/'/g, "''") + "'";
    }

    // PowerShell property accessor: if the property name has non-identifier
    // characters (spaces, dashes, etc.) use the single-quoted property-name
    // form (`$obj.'odd name'`). For typical SQL-column names (PROPOSAL_ID,
    // SPONSOR_NAME) this just returns the bareword.
    function powershellPropAccess(name) {
        if (/^[A-Za-z_][A-Za-z0-9_]*$/.test(String(name))) return name;
        return "'" + String(name).replace(/'/g, "''") + "'";
    }

    // PHP single-quoted string literal: only ' and \ need escaping.
    function phpQuote(s) {
        return "'" + String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'") + "'";
    }

    // bash single-quoted string literal: ' can't appear inside; close-quote,
    // escape-quote, reopen-quote pattern handles it ('\'').
    function bashQuote(s) {
        return "'" + String(s).replace(/'/g, "'\\''") + "'";
    }

    // jq field path: if the key is a valid identifier just emit `.key`,
    // otherwise use `.["key"]` which jq accepts for arbitrary strings.
    function jqFieldPath(name) {
        const s = String(name);
        if (/^[A-Za-z_][A-Za-z0-9_]*$/.test(s)) return s;
        return '["' + s.replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"]';
    }

    // Shows/hides the per-format nested-table sub-option panel based on the
    // currently-selected radio + whether the view actually has nested data.
    // Used by both the download and copy lightboxes; pass the format name
    // ("csv"|"tsv"|other) and the location suffix ("download"|"copy").
    function refreshNestedExportOptionPanels(selectedFormat, locationSuffix) {
        const hasNested = hasNestedJsonData();
        // Hide every nested-options sub-panel in this lightbox first
        $('.nested-table-export-options[data-for$="-' + locationSuffix + '"]').hide();
        if (!hasNested) return;
        // Show the one matching the active format (if any)
        if (selectedFormat === 'csv' || selectedFormat === 'tsv') {
            $('.nested-table-export-options[data-for="' + selectedFormat + '-' + locationSuffix + '"]').slideDown(200);
        }
    }

    // "Don't include theme colors" is redundant while the page's theme IS
    // Monochrome - the workbook comes out greyscale either way - so the row
    // is hidden (and the box cleared) whenever that is the active theme.
    // Re-evaluated every time the dialog opens or Excel is picked, because
    // the theme can change while the page is up.
    function _dlSyncMonoOption() {
        const isMono = (typeof currentThemeId === 'function') && currentThemeId() === 'theme-monochrome';
        $('#xlsMonochromeRow').toggle(!isMono);
        if (isMono) $('#xlsMonochrome').prop('checked', false);
    }

    // Show/hide Excel header options in download dialog
    $('input[name="downloadFormat"]').on('change', function () {
        const v = $(this).val();
        if (v === 'xls') {
            _dlSyncMonoOption();
            $('#excelHeaderOptions').slideDown(200);
        } else {
            $('#excelHeaderOptions').slideUp(200);
        }
        refreshNestedExportOptionPanels(v, 'download');
        $('#downloadCustomTemplateOptions').toggle(v === 'custom');
        if (v === 'custom') _dlMaybePrefillHeader();
    });

    // Trigger on page load to show if Excel is pre-selected
    if ($('input[name="downloadFormat"]:checked').val() === 'xls') {
        _dlSyncMonoOption();
        $('#excelHeaderOptions').show();
    }

    // Show/hide Excel header options in email dialog
    $('#emailAttachXLS').on('change', function () {
        if ($(this).is(':checked')) {
            $('#emailExcelHeaderOptions').slideDown(200);
        } else {
            $('#emailExcelHeaderOptions').slideUp(200);
        }
    });

    // Records an EXPORT audit entry server-side when the user actually downloads
    // report data. Mirrors the log_badpass beacon (js/main.js ~58344):
    // fire-and-forget and best-effort - a failed audit must never break the
    // download. Only saved (?id=) reports are logged: an ad-hoc / local report
    // has no PENUMBRA_REPORTS row to attribute the export to, exactly like the
    // 'OPEN' audit in query.php. Called from each format branch below at the
    // point the file is handed to the browser, so "no data to export" attempts
    // are not logged. query.php's permission gate ensures a non-admin can only
    // log against a report they are authorized to open.
    // extra.theme overrides the recorded theme when the file was NOT built in
    // the page's theme (the Excel "Don't include theme colors" option builds
    // it in Monochrome whatever the page shows).
    function penumbraLogExport(format, extra) {
        try {
            var shortId = new URLSearchParams(window.location.search).get('id');
            if (!shortId) return;
            var dims = _penumbraExportDims(); // {rows, cols} of what was exported, or null
            var view = _penumbraViewMode();   // {mode, snap} of the current view
            var payload = {
                action: 'log_export',
                short_id: shortId,
                format: String(format || '').toLowerCase(),
                mode: view.mode
            };
            if (view.snap) { payload.snap = 1; }
            // A ?download= direct-link export routes through this same handler;
            // flag it so the audit distinguishes a direct download from a dialog
            // one. The param is still on the URL while the splash is shown.
            if (new URLSearchParams(window.location.search).get('download')) {
                payload.origin = 'direct';
            }
            if (dims && dims.rows >= 0 && dims.cols >= 0) {
                payload.rows = dims.rows;
                payload.cols = dims.cols;
            }
            // Extra context describing HOW the report looked when exported:
            // theme + density (always), and the active prompt parameters +
            // in-table search filter (only when set).
            var ctx = _penumbraExportContext();
            payload.theme = (extra && extra.theme) ? String(extra.theme) : ctx.theme;
            payload.density = ctx.density;
            if (ctx.prompts) { payload.prompts = ctx.prompts; }
            if (ctx.search)  { payload.search = ctx.search; }
            _penumbraSendAuditBeacon(payload);
        } catch (e) { /* auditing is best-effort - never block the download */ }
    }

    // Posts an audit payload to query.php. Prefers sendBeacon: it queues the
    // POST in the browser and delivers it independent of page lifetime, so it
    // survives the direct-download path closing the tab (~4s after firing) and a
    // user closing the tab right after a download/email. Falls back to a plain
    // async POST where sendBeacon is unavailable or refuses the payload.
    function _penumbraSendAuditBeacon(payload) {
        var sent = false;
        if (navigator && typeof navigator.sendBeacon === 'function') {
            try {
                var body = new URLSearchParams();
                Object.keys(payload).forEach(function (k) { body.append(k, payload[k]); });
                sent = navigator.sendBeacon('query.php', body);
            } catch (e) { sent = false; }
        }
        if (!sent) { $.post('query.php', payload); }
    }

    // Records an EMAIL audit entry when the user sends a report from the Email
    // dialog (js/main.js #sendEmailBtn). Mirrors penumbraLogExport: same view /
    // dims / theme / density / prompts / search context, plus the email options
    // (recipients, attachment formats, body inclusions, subject). Best-effort;
    // saved (?id=) reports only. opts is captured at send time by the caller.
    function penumbraLogEmail(opts, fail) {
        try {
            var shortId = new URLSearchParams(window.location.search).get('id');
            if (!shortId) return;
            opts = opts || {};
            var dims = _penumbraExportDims();
            var view = _penumbraViewMode();
            var ctx = _penumbraExportContext();

            // Attachment formats (xls+ = Excel with the header block embedded).
            var atts = [];
            if (opts.attXls) { atts.push(opts.attXlsHeader ? 'xlsx+' : 'xlsx'); }
            if (opts.attCsv) { atts.push('csv'); }
            if (opts.attPdf) { atts.push('pdf'); }

            // Which pieces were embedded in the email body.
            var bodyParts = [];
            if (opts.bodyData)    { bodyParts.push('table'); }
            if (opts.bodySnippet) { bodyParts.push('charts'); }
            if (opts.bodyLink)    { bodyParts.push('link'); }

            var recips = String(opts.recipients || '').split(/[;,]/).map(function (s) { return s.trim(); }).filter(Boolean);

            var payload = {
                action: 'log_email',
                short_id: shortId,
                mode: view.mode,
                recipients: recips.join('; '),
                recipient_count: recips.length,
                attachments: atts.join(', '),
                body_parts: bodyParts.join(', '),
                subject: opts.subject || '',
                theme: ctx.theme,
                density: ctx.density
            };
            if (view.snap) { payload.snap = 1; }
            if (dims && dims.rows >= 0 && dims.cols >= 0) { payload.rows = dims.rows; payload.cols = dims.cols; }
            if (ctx.prompts) { payload.prompts = ctx.prompts; }
            if (ctx.search)  { payload.search = ctx.search; }
            // A failed send (share.php error) is logged as EMAIL_FAIL with the
            // HTTP status + server error message, so mail-pipeline problems leave
            // a trail instead of vanishing.
            if (fail) {
                payload.failed = 1;
                if (fail.status != null) { payload.http_status = fail.status; }
                if (fail.error) { payload.error = String(fail.error); }
            }
            _penumbraSendAuditBeacon(payload);
        } catch (e) { /* auditing is best-effort - never block the send */ }
    }

    // Presentation context of the export: theme + density (read from the live
    // body classes, so URL/pref overrides are reflected), the active prompt
    // parameters (from the #promptInfoList chips - "Message=Value" pairs), and
    // the in-table search filter. Best-effort; any failure yields safe defaults.
    function _penumbraExportContext() {
        var ctx = { theme: 'default', density: 'standard', prompts: '', search: '' };
        try {
            var cls = (document.body.className || '').split(/\s+/);
            for (var i = 0; i < cls.length; i++) {
                if (cls[i].indexOf('theme-') === 0) { ctx.theme = cls[i].slice(6); }
                else if (cls[i].indexOf('density-') === 0) { ctx.density = cls[i].slice(8); }
            }
            var params = [];
            $('#promptInfoList li a').each(function () {
                var msg = $(this).find('em').text().replace(/:\s*$/, '').trim();
                var val = $(this).find('strong').text().trim();
                if (msg && val) { params.push(msg + '=' + val); }
                else if (val)   { params.push(val); }
            });
            ctx.prompts = params.join('; ');
            ctx.search = ($('#tableSearch').val() || '').trim();
        } catch (e) { /* keep defaults */ }
        return ctx;
    }

    // The current view's layout (flat / group / pivot) plus whether a snapshot is
    // being viewed - the two are orthogonal (a snapshot can be shown flat, grouped
    // or pivoted), so they are reported separately and the server composes the
    // label. Snapshot is detected from any of the signals the rest of main.js uses.
    function _penumbraViewMode() {
        var mode = 'flat';
        if ($('#pivot-output-container').is(':visible')) { mode = 'pivot'; }
        else if ($('#groupedResultsContainer').is(':visible')) { mode = 'group'; }
        var snap = false;
        try {
            snap = (isViewingSnapshot === true) ||
                   $('#snapshotComparisonContainer').is(':visible') ||
                   $('body').hasClass('snapshot-comparison-active') ||
                   !!new URLSearchParams(window.location.search).get('snap');
        } catch (e) { snap = false; }
        return { mode: mode, snap: snap };
    }

    // Best-effort {rows, cols} of what is about to be exported, matched to the
    // current view mode - flat / grouped / pivot, and snapshot views too since
    // those render into the same containers. The selectors mirror the row /
    // column sources getExportData() and getPivotCsvForCopy() use, so the audit
    // count tracks the actual file (it is the rendered, search-filtered data).
    // Returns null on any failure so it can never block a download.
    function _penumbraExportDims() {
        try {
            if ($('#pivot-output-container').is(':visible')) {
                return {
                    rows: penumbraPivotBodyRowCount(),
                    cols: $('#pivotResultTable thead tr:last th').length
                };
            }
            if ($('#groupedResultsContainer').is(':visible')) {
                var gRows = 0;
                var $firstHdr = null;
                $('#groupedResultsContainer .group-wrapper.group-leaf').not('.search-hidden').each(function () {
                    var $tbl = $(this).children('.group-content').children('table');
                    gRows += $tbl.children('tbody').children('tr').not('.search-hidden').not('.journal-note-child').length;
                    if (!$firstHdr) { $firstHdr = $tbl.children('thead').children('tr').children('th'); }
                });
                var gCols = $firstHdr ? $firstHdr.filter(function () { return $(this).css('display') !== 'none'; }).length : 0;
                return { rows: gRows, cols: gCols };
            }
            return {
                rows: $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)").length,
                cols: $("#resultsTable > thead > tr#tableHeader th:visible").length
            };
        } catch (e) { return null; }
    }

    // --- Main handler for the new "Download Selected" button ---
    $('#confirmDownloadBtn').on('click', async function () {
        const format = $('input[name="downloadFormat"]:checked').val();
        if (!format) {
            alert("Please select a download format.");
            return;
        }
        // Lazy rows (2026-09-30): a big fill gets "Preparing N rows..." first.
        const _prepDl = penumbraPrepareRows();
        if (_prepDl) await _prepDl;

        const isPivotMode = $('#pivot-output-container').is(':visible');

        // A switch statement to handle the selected format.
        switch (format) {
            case 'xls':
                // The lightbox (z-index 20000) sits ABOVE #loadingOverlay (10000),
                // so "Download Selected" stays clickable while the workbook builds.
                // On a slow report an impatient second click started a second
                // generation. XLSX and PDF are the only awaited branches, so they
                // are the only two that need the button held.
                showLoading("Generating Excel (.xlsx) file...");
                $('#confirmDownloadBtn').prop('disabled', true);
                try {
                    // This dialog's OWN checkboxes - never the email dialog's.
                    var _xlsWithHeader = $('#xlsIncludeHeader').is(':checked');
                    var _xlsMono = $('#xlsMonochrome').is(':checked');
                    const workbook = await createXlsxWorkbook(_xlsWithHeader, { monochrome: _xlsMono });
                    if (workbook) {
                        // ExcelJS download method
                        const buffer = await workbook.xlsx.writeBuffer();
                        const blob = new Blob([buffer], {
                            type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                        });

                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = getReportFilename('xlsx');
                        document.body.appendChild(a);
                        a.click();
                        window.URL.revokeObjectURL(url);
                        document.body.removeChild(a);
                        // 'xls+' when the report header data was embedded (the
                        // "Excel + Header" option) so the audit shows XLSX+.
                        penumbraLogExport(_xlsWithHeader ? 'xls+' : 'xls', _xlsMono ? { theme: 'monochrome' } : null);
                    } else {
                        alert("There is no visible data to export.");
                    }
                } catch (error) {
                    console.error("XLSX Generation Error:", error);
                    // Expired session (ExcelJS is lazy-loaded): dialog already up.
                    if (!penumbraHandledAsSessionExpiry(error)) {
                        show_text(`<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Could not generate Excel file. ${error.message}</p>`);
                    }
                } finally {
                    hideLoading();
                    $('#confirmDownloadBtn').prop('disabled', false);
                }
                break;
            case 'pdf':
                showLoading("Loading PDF module and generating file...");
                $('#confirmDownloadBtn').prop('disabled', true);
                try {
                    // Lazily load the PDF libraries
                    await loadScript("js/jspdf-2.5.1.umd.min.js");
                    await loadScript("js/jspdf-autotable-3.5.23.min.js");

                    const pdfBase64 = await generatePdfContent();
                    if (pdfBase64) {
                        const byteCharacters = atob(pdfBase64);
                        const byteNumbers = new Array(byteCharacters.length);
                        for (let i = 0; i < byteCharacters.length; i++) {
                            byteNumbers[i] = byteCharacters.charCodeAt(i);
                        }
                        const byteArray = new Uint8Array(byteNumbers);
                        const blob = new Blob([byteArray], {
                            type: 'application/pdf'
                        });
                        const link = document.createElement("a");
                        link.href = URL.createObjectURL(blob);
                        link.setAttribute("download", getReportFilename('pdf'));
                        document.body.appendChild(link);
                        link.click();
                        URL.revokeObjectURL(link.href); // else the blob store retains the full PDF per click (same pattern as the xlsx case)
                        document.body.removeChild(link);
                        penumbraLogExport('pdf');
                    } else {
                        alert("There is no visible data to export.");
                    }
                } catch (error) {
                    console.error(error);
                    // Expired session: dialog already up.
                    if (!penumbraHandledAsSessionExpiry(error)) {
                        show_text(`<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> Could not load the PDF module.</p>`);
                    }
                } finally {
                    hideLoading();
                    $('#confirmDownloadBtn').prop('disabled', false);
                }
                break;

            case 'csv':
                let csvExportData;
                if (isPivotMode) {
                    csvExportData = getPivotCsvForCopy();
                } else {
                    const csvFlatten = $('input[name="csvDownloadNestedOption"]:checked').val() === 'flatten';
                    csvExportData = getExportData('csv', { flattenNested: csvFlatten });
                }

                if (!csvExportData || !csvExportData.content) {
                    alert("There are no visible rows to export.");
                    return;
                }
                const bom = "\uFEFF";
                const blob = new Blob([bom + csvExportData.content], {
                    type: 'text/csv;charset=utf-8;'
                });
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.setAttribute("download", getReportFilename('csv'));
                document.body.appendChild(link);
                link.click();
                URL.revokeObjectURL(link.href); // else the blob store retains the full CSV per click (same pattern as the xlsx case)
                document.body.removeChild(link);
                penumbraLogExport('csv');
                break;

            case 'tsv':
                // Mirrors the CSV case but emits tab-separated content. Pivot
                // mode reuses getPivotCsvForCopy with '\t' (same helper the
                // copy-as-TSV path uses at js/main.js:40993); the flat path
                // routes through getExportData('tsv'). UTF-8 BOM is included
                // for the same reason as CSV - Excel needs it to detect the
                // encoding correctly when the file is opened directly.
                let tsvExportData;
                if (isPivotMode) {
                    tsvExportData = getPivotCsvForCopy('\t');
                } else {
                    const tsvFlatten = $('input[name="tsvDownloadNestedOption"]:checked').val() === 'flatten';
                    tsvExportData = getExportData('tsv', { flattenNested: tsvFlatten });
                }

                if (!tsvExportData || !tsvExportData.content) {
                    alert("There are no visible rows to export.");
                    return;
                }
                const tsvBom = "\uFEFF";
                const tsvBlob = new Blob([tsvBom + tsvExportData.content], {
                    type: 'text/tab-separated-values;charset=utf-8;'
                });
                const tsvLink = document.createElement("a");
                tsvLink.href = URL.createObjectURL(tsvBlob);
                tsvLink.setAttribute("download", getReportFilename('tsv'));
                document.body.appendChild(tsvLink);
                tsvLink.click();
                URL.revokeObjectURL(tsvLink.href); // else the blob store retains the full TSV per click
                document.body.removeChild(tsvLink);
                penumbraLogExport('tsv');
                break;

            case 'json':
                const jsonExportData = getExportData('json');

                if (!jsonExportData || jsonExportData.rowCount === 0) {
                    alert("There is no visible data to export.");
                    return;
                }

                // The content from getExportData is already a valid JSON string
                const jsonBlob = new Blob([jsonExportData.content], {
                    type: 'application/json'
                });

                const jsonLink = document.createElement("a");
                jsonLink.href = URL.createObjectURL(jsonBlob);
                jsonLink.setAttribute("download", getReportFilename('json'));
                document.body.appendChild(jsonLink);
                jsonLink.click();
                URL.revokeObjectURL(jsonLink.href); // else the blob store retains the full JSON per click
                document.body.removeChild(jsonLink);
                penumbraLogExport('json');
                break;

            case 'custom':
                // Client-side Blob download (like every other format here), so the
                // chosen extension is only a filename suffix - never a server
                // Content-Type. Shared with the ?download=custom direct-link path.
                // On failure, return WITHOUT closing the dialog (same as the
                // csv/tsv/json "nothing to export" paths) so the user can fix the
                // template instead of having to reopen and retype it.
                if (!_fireCustomDownload(null)) return;
                break;

            case 'php':
                const sqlQuery = editor.getValue();
                const themeName = $('body').attr('class').split(' ').find(cls => cls.startsWith('theme-')) || 'theme-default';
                const reportTitle = stripHtml(getReportTitle());

                // 1. CREATE FORM FIRST
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = 'generate_stub.php';
                form.style.display = 'none';

                // 2. NOW create and append inputs
                const viewModeInput = document.createElement('input');
                viewModeInput.type = 'hidden';
                viewModeInput.name = 'view_mode';

                if ($('#pivot-output-container').is(':visible')) {
                    viewModeInput.value = 'pivot';
                } else if ($('#groupedResultsContainer').is(':visible')) {
                    viewModeInput.value = 'group';
                } else {
                    viewModeInput.value = 'standard';
                }
                form.appendChild(viewModeInput);

                // Add SQL query as a hidden input
                const queryInput = document.createElement('input');
                queryInput.type = 'hidden';
                queryInput.name = 'sql_query';
                queryInput.value = sqlQuery;
                form.appendChild(queryInput);

                // Add theme name as a hidden input
                const themeInput = document.createElement('input');
                themeInput.type = 'hidden';
                themeInput.name = 'theme_name';
                themeInput.value = themeName;
                form.appendChild(themeInput);

                const emailInput = document.createElement('input');
                emailInput.type = 'hidden';
                emailInput.name = 'email';
                emailInput.value = penumbra_vars.shibboleth.email;
                form.appendChild(emailInput);

                const subjectInput = document.createElement('input');
                subjectInput.type = 'hidden';
                subjectInput.name = 'subject';
                subjectInput.value = reportTitle.replace(/\n/g, ' ');
                form.appendChild(subjectInput);

                let liveLinkUrl;
                const urlParams = new URLSearchParams(window.location.search);

                if (urlParams.has('id')) {
                    // Server-saved report: Send the exact current URL
                    liveLinkUrl = window.location.href;
                } else {
                    // Local/Unsaved report: Build the state string
                    liveLinkUrl = buildViewStateURL();
                }

                const urlInput = document.createElement('input');
                urlInput.type = 'hidden';
                urlInput.name = 'live_link_url';
                urlInput.value = liveLinkUrl ? liveLinkUrl : '';
                form.appendChild(urlInput);

                const fullnameInput = document.createElement('input');
                fullnameInput.type = 'hidden';
                fullnameInput.name = 'user_fullname';
                fullnameInput.value = (penumbra_vars.shibboleth.fname || '') + ' ' + (penumbra_vars.shibboleth.lname || '');
                form.appendChild(fullnameInput);

                const unityidInput = document.createElement('input');
                unityidInput.type = 'hidden';
                unityidInput.name = 'user_unityid';
                unityidInput.value = penumbra_vars.currentUserKey || 'unknown';
                form.appendChild(unityidInput);

                document.body.appendChild(form);
                form.submit();
                document.body.removeChild(form);
                penumbraLogExport('php');
                break;

        }
        $('#downloadActionsLightbox').fadeOut();
    });

    // ===== END: Consolidated Download Actions =====

    // ===== START: Consolidated Copy Actions Feature =====

    // --- Show the lightbox ---
    $('#copyActionsBtn').on('click', function () {
        const totalRowCount = $('#groupedResultsContainer').is(':visible') ? $('#groupedResultsContainer tbody tr:not(.search-hidden):not(.journal-note-child)').length : $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)").length;

        // ===== START: ADD THIS BLOCK TO DISABLE SQL OPTION =====
        const isPivotMode = $('#pivot-output-container').is(':visible');
        const isGroupedMode = $('#groupedResultsContainer').is(':visible');
        const $sqlOption = $('input[name="copyFormat"][value="sql"]');
        const $sqlLabel = $sqlOption.closest('label');

        if (isPivotMode || isGroupedMode) {
            $sqlOption.prop('disabled', true);
            $sqlLabel.css({
                'opacity': 0.5,
                'cursor': 'not-allowed'
            }).attr('title', 'SQL Inserts are not applicable for pivoted or grouped data.');
            // If SQL was selected, default back to HTML
            if ($sqlOption.is(':checked')) {
                $('input[name="copyFormat"][value="html"]').prop('checked', true).trigger('change');
            }
        } else {
            $sqlOption.prop('disabled', false);
            $sqlLabel.css({
                'opacity': 1,
                'cursor': 'pointer'
            }).removeAttr('title');
        }
        // ===== END: ADD THIS BLOCK =====

        // ===== Disable the API connection string for ENCRYPTED reports =====
        // The report's saved state (and therefore its query) is encrypted
        // client-side, so a one-round ?json=1 call returns an encrypted blob,
        // not data. Decrypting requires PBKDF2/AES-256-CBC + HMAC + a second
        // query.php POST - too much to bake into a lightweight snippet across
        // five languages. The PHP Stub already implements that flow, so we
        // steer encrypted-report users there instead.
        const isEncryptedReport = currentReportIsEncrypted === true;
        const $apiSnippetOption = $('input[name="copyFormat"][value="api_snippet"]');
        const $apiSnippetLabel = $apiSnippetOption.closest('label');
        if (isEncryptedReport) {
            $apiSnippetOption.prop('disabled', true);
            $apiSnippetLabel.css({
                'opacity': 0.5,
                'cursor': 'not-allowed'
            }).attr('title', 'Not available for encrypted reports - the API returns an encrypted payload. Use "Copy Code for PHP Stub", which handles decryption.');
            if ($apiSnippetOption.is(':checked')) {
                $('input[name="copyFormat"][value="html"]').prop('checked', true).trigger('change');
            }
        } else {
            $apiSnippetOption.prop('disabled', false);
            $apiSnippetLabel.css({
                'opacity': 1,
                'cursor': 'pointer'
            }).removeAttr('title');
        }
        // ===== END encrypted-report API-snippet disable =====

        if (totalRowCount === 0) {
            show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> There is no data to copy.</p>");
            return;
        }

        // --- START: Restore Last Settings ---
        if (lastCopySettings) {
            // A. Restore radio button
            $(`input[name="copyFormat"][value="${lastCopySettings.format}"]`).prop('checked', true);

            // B. Restore text/select values.
            // NOTE: #copyColumnSelector is restored *after* it's repopulated
            // further down (the <option>s don't exist yet at this point), so
            // it's intentionally omitted here.
            $('#copyDelimiterInput').val(lastCopySettings.delimiter);
            $('#sqlTableNameInput').val(lastCopySettings.tableName);
            $('#customTemplateInput').val(lastCopySettings.customTemplate);

            if (lastCopySettings.customNewline !== undefined) {
                $('#customTemplateNewline').prop('checked', lastCopySettings.customNewline);
            }
            if (lastCopySettings.apiSnippetLanguage) {
                $('#apiSnippetLanguage').val(lastCopySettings.apiSnippetLanguage);
            }

            // C. Manually trigger change to show/hide correct panels
            $('#singleColumnOptions').hide();
            $('#sqlInsertOptions').hide();
            $('#customTemplateOptions').hide();
            $('#apiSnippetOptions').hide();

            switch (lastCopySettings.format) {
                case 'single_col':
                    $('#singleColumnOptions').show();
                    break;
                case 'sql':
                    $('#sqlInsertOptions').show();
                    break;
                case 'custom':
                    $('#customTemplateOptions').show();
                    break;
                case 'api_snippet':
                    $('#apiSnippetOptions').show();
                    break;
            }
        } else {
            // Default behavior for first-time open
            $('input[name="copyFormat"]').first().prop('checked', true);
            $('#singleColumnOptions').hide();
            $('#sqlInsertOptions').hide();
            $('#customTemplateOptions').hide();
            $('#apiSnippetOptions').hide();
        }
        // --- END: Restore Last Settings ---

        // Guard: the SQL-disable block above runs BEFORE the restore, so a saved
        // format like 'sql' can re-check a now-disabled radio (e.g. after
        // switching to pivot/grouped). If the selected format is disabled, fall
        // back to a safe default so a greyed-out option can't be submitted.
        if ($('input[name="copyFormat"]:checked').prop('disabled')) {
            $('input[name="copyFormat"][value="html"]').prop('checked', true).trigger('change');
        }

        const highlightedTable = $("#tableSelector option.highlighted[data-type='table']").first();

        // --- START: MODIFICATION ---
        // Only pre-fill table name if it's not already set by lastCopySettings
        if (!lastCopySettings || !lastCopySettings.tableName) {
            if (highlightedTable.length > 0) {
                $('#sqlTableNameInput').val(highlightedTable.val());
            } else {
                $('#sqlTableNameInput').val('');
