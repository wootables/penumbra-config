    // Suppressed when the toggle is "overridden" (the query supplies its own
    // FETCH FIRST/LIMIT): the 200-row cap doesn't apply, so the warning would be wrong.
    //
    // With the limiter on, the banner is sized by liveQueryRowCount, the rows this
    // report's query last returned here. That count is the full set, or 200 when
    // the cap trimmed it, so it always lands in the right band:
    //   under SCHED_ROW_WARN_MIN_ROWS   no banner - the cap is nowhere near
    //   from there up to 199            fits today, but "may not always" as it grows
    //   200 or more                     at the cap: events ship only the first 200
    //   unknown (null)                  the generic wording shipped in index.php
    // The count is this page's run: an event whose prompt values differ may return
    // more or fewer rows than that.
    //
    // DB_DUMP is the other exception. Its Options card carries its own row-mode
    // radios and the runner hands that choice to query.php as a row_limit_override,
    // so the report's saved limiter never reaches the dump at all. The generic
    // "disable the row limit and re-save the report" advice is therefore wrong for
    // a dump: under "Always include all rows" the full set already ships (that IS
    // the point of the option), and under "Enforce row limit" the cap is the one
    // just chosen in this form, which no re-save of the report would lift. So for
    // DB_DUMP the banner follows the task's own setting - hidden for 'all', and
    // retargeted at the radios for 'enforce', where it is sized like the report
    // banner but against the dump's own cap (hidden under 75% of it).
    var _schedRowLimitWarnDefaultHtml = null;
    var SCHED_ROW_WARN_MIN_ROWS = 150;
    function updateSchedRowLimitWarning() {
        var $warn = $('#schedRowLimitWarning');
        if (!$warn.length) return;
        // Cache the markup shipped in index.php before any DB_DUMP rewrite, so the
        // generic wording can be restored when the type switches back.
        if (_schedRowLimitWarnDefaultHtml === null) {
            _schedRowLimitWarnDefaultHtml = $warn.html();
        }

        if ($('#schedEventType').val() === 'DB_DUMP') {
            var dumpMode = $('input[name="schedDbDumpRowMode"]:checked').val() || 'enforce';
            if (dumpMode === 'all') { $warn.hide(); return; }
            var dumpLimit = parseInt($('#schedDbDumpRowLimit').val(), 10);
            if (isNaN(dumpLimit) || dumpLimit < 1) dumpLimit = 200;
            var dumpRows = ' row' + (dumpLimit === 1 ? '' : 's');
            var capWords = '⚠️ This dump is capped at ' + dumpLimit.toLocaleString() + dumpRows +
                ' by the "Enforce row limit" option above';
            // Sized like the report banner below, its 150-of-200 buffer scaled to
            // the dump's own cap. Exactly 200 rows may be the report's 200-row
            // limiter talking (the full set could be any size), so that count is
            // only a floor; any other count is the full set.
            var dn = liveQueryRowCount;
            var exact = dn !== null && dn !== 200;
            if (exact && dn < dumpLimit * SCHED_ROW_WARN_MIN_ROWS / 200) {
                $warn.hide();
            } else if (exact && dn < dumpLimit) {
                $warn.html(capWords + '. This report returns ' + dn.toLocaleString() +
                    ' rows now, so as it grows the dump may not always load the full result set. ' +
                    'Choose "Always include all rows" so it always does.').show();
            } else if (dn !== null && dn >= dumpLimit) {
                $warn.html(capWords + ' and this report reaches it, so the dump loads only the first ' +
                    dumpLimit.toLocaleString() + dumpRows + '. ' +
                    'Choose "Always include all rows" to load the full result set.').show();
            } else {
                $warn.html(capWords + ', so it may not always load the full result set. ' +
                    'Choose "Always include all rows" so it always does.').show();
            }
            return;
        }

        var $btn = $('#toggleLimitBtn');
        var n = liveQueryRowCount;
        if (!$btn.hasClass('is-active') || $btn.hasClass('is-overridden') ||
            (n !== null && n < SCHED_ROW_WARN_MIN_ROWS)) {
            $warn.html(_schedRowLimitWarnDefaultHtml).hide();
        } else if (n !== null && n < 200) {
            $warn.html('⚠️ Row limit is on (max 200 rows). This report returns ' + n.toLocaleString() +
                ' rows now, so as it grows scheduled events may not always deliver the full result set. ' +
                'Disable the row limit and re-save the report so they always do.').show();
        } else if (n !== null) {
            $warn.html('⚠️ Row limit is on (max 200 rows) and this report reaches it, so scheduled events ' +
                'deliver only the first 200 rows. Disable the row limit and re-save the report so they ' +
                'deliver the full result set.').show();
        } else {
            $warn.html(_schedRowLimitWarnDefaultHtml).show();
        }
    }
