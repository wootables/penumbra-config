    // message have taken their share. Mirrors penumbra_email_body_budget() in
    // schedule_runner.php: measure attachments on the WIRE (base64 is 4/3 plus
    // chunk newlines), then keep a reserve for the header, preamble, link block
    // and MIME envelope, none of which are known until after the table is built.
    var PENUMBRA_EMAIL_SHELL_RESERVE = 262144;   // 256 KB, header/preamble/link/MIME
