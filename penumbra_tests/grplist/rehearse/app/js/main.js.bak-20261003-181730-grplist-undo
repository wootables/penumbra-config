    // --- Saved States Management ---

    // Global cache for search performance
    let savedStateSearchCache = [];

    function populateSavedStatesList() {
        const $selector = $('#savedStatesListSelector').empty();
        $('#savedStateDetails').html('Select a state to see its details.');
        $('#deleteSelectedStateBtn').prop('disabled', true);

        // Clear search input on reload
        $('#savedStateSearchInput').val('');

        const savedQueries = JSON.parse(localStorage.getItem("savedQueries") || "[]");
        savedStateSearchCache = [];

        if (savedQueries.length > 0) {
            // Sort alphabetically case-insensitive
            savedQueries.sort((a, b) => a.name.localeCompare(b.name, undefined, {
                sensitivity: 'base'
            }));

            savedQueries.forEach((state) => {
                // 1. Build Search Cache (Deep Search)
                let searchableText = state.name.toLowerCase();

                try {
                    const urlObj = new URL(state.url, window.location.href);
                    const stateParam = urlObj.searchParams.get('state');
                    if (stateParam) {
                        const decompressed = decompressString(stateParam);
                        if (!decompressed.includes('PENUMBRA_GCM::')) {
                            const data = JSON.parse(decompressed);
                            // Add relevant fields to search text
                            if (data.query)
                                searchableText += " " + data.query.toLowerCase();
                            if (data.reportTitle)
                                searchableText += " " + data.reportTitle.toLowerCase();
                            if (data.reportSnippet)
                                searchableText += " " + data.reportSnippet.toLowerCase();
                            if (data.visibleColumns)
                                searchableText += " " + data.visibleColumns.join(' ').toLowerCase();
                        }
                    }
                } catch (e) {/* Ignore errors during indexing */
                }

                savedStateSearchCache.push({
                    name: state.name,
                    searchText: searchableText
                });

                // 2. Append Option
                $selector.append(`<option value="${escapeHtml(state.name)}">${escapeHtml(state.name)}</option>`);
            }
            );
        } else {
            $selector.append('<option disabled>No saved states found.</option>');
        }
    }

