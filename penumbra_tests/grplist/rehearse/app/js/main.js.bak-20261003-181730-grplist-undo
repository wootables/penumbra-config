                // We layer any *other* URL params on top in case a non-prompt
                // override is present (rare, but matches generate_stub.php's
                // permissive behavior at lines 51-57).
                const promptParams = getCurrentPromptParams();
                const _urlParams = new URLSearchParams(window.location.search);
                const _systemKeys = new Set(['id', 'state', 'json', 'noadm', 'console', 'debug']);
                _urlParams.forEach(function (value, key) {
                    if (_systemKeys.has(key.toLowerCase())) return;
                    if (!Object.prototype.hasOwnProperty.call(promptParams, key)) {
                        promptParams[key] = value;
                    }
                });

                const snippet = generateApiSnippet(language, apiUrl, sampleCols, promptParams);
