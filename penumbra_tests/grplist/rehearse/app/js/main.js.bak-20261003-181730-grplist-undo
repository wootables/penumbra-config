                // Dedup by master-row index: grouped mode clones the SAME parent row
                // into every group it belongs to (multi-value @@JSON grouping), so the
                // same index appears multiple times in the grouped container. Without
                // this, count()/sum()/avg() inside a format() condition double-count
                // those rows (mirrors the dedup in renderReportSnippet, main.js ~23232).
                const _eacSeenIdx = new Set();
