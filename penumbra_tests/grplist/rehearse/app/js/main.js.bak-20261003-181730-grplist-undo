    // Tag params live in the HEAD of a tag (everything before query=); the SQL
    // body may legitimately contain "db=" or "transport=" text, so the head is
    // the only place these are read from. Mirrors the db/transport/query order
    // extractSubqueryTags enforces server-side. 'oracle' is the legacy alias
    // of ieprd (same connection) and is normalised so the picker can show it.
    function parseSubqueryTagHead(tagText) {
        const queryAt = tagText.search(/query\s*=/i);
        const head = queryAt === -1 ? tagText : tagText.substring(0, queryAt);
        const dbMatch = head.match(/[;\s]db\s*=\s*([^;\s]+)/i);
        let db = dbMatch ? dbMatch[1].toLowerCase() : '';
        if (db === 'oracle') db = 'ieprd';
        return {
            isCte: /^\[?\s*CTE_SUBQUERY/i.test(tagText),
            db: db,
            transport: /[;\s]transport\s*=\s*json\b/i.test(head) ? 'json' : 'literal',
            queryAt: queryAt
        };
    }

    // 3. Populate Dropdown (Updated for Nested Brackets)
    function populateSubqueryLoader() {
        const query = editor.getValue();
        const snippet = snippetEditor.getValue();
        const allCode = query + "\n" + snippet;

        // Use the balanced parser instead of simple Regex
        const foundTagsRaw = extractBalancedTags(allCode, '(?:CTE_)?SUBQUERY');

        const $loader = $('#subqueryLoader').empty();
        $loader.append('<option value="">(Create new subquery)</option>');

        const uniqueTags = new Set(foundTagsRaw);

        if (uniqueTags.size > 0) {
            $loader.append('<option disabled>----------- Select existing tag to edit --------------</option>');
            uniqueTags.forEach((rawString) => {
                const head = parseSubqueryTagHead(rawString);
                const dbName = head.db || '?';

                // Query excerpt for the label: multi-line tags are collapsed to
                // one line (the old /query=(.+)/ stopped at the first newline).
                const queryMatch = rawString.match(/query\s*=\s*([\s\S]*)$/i);
                let querySnippet = "Invalid";
                if (queryMatch) {
                    const flat = queryMatch[1].replace(/\]\s*$/, '').replace(/\s+/g, ' ').trim();
                    querySnippet = flat.length > 70 ? flat.substring(0, 70) + '...' : flat;
                }

                const label = `[${dbName.toUpperCase()} ${head.isCte ? 'CTE' : 'IN list'}${head.transport === 'json' ? ', JSON' : ''}]: ${querySnippet}`;
                const safeValue = rawString.replace(/"/g, '&quot;');
                $loader.append(`<option value="${safeValue}">${escapeHtml(label)}</option>`);
            }
            );
            $('#subqueryLoader').closest('.bld-field').show();
        } else {
            $('#subqueryLoader').closest('.bld-field').hide();
        }
    }

    // 4. Prefill Logic (Updated)
    function prefillSubqueryGenerator(tagString) {
        resetSubqueryForm();

        // Remove outer brackets
        let content = tagString.trim();
        if (content.startsWith('['))
            content = content.substring(1);
        if (content.endsWith(']'))
            content = content.substring(0, content.length - 1);

        const head = parseSubqueryTagHead(content);
        setSubqueryRadio('subqueryType', head.isCte ? 'cte' : 'in');
        setSubqueryRadio('subqueryTransport', head.transport);
        if (head.db && $('#subqueryDb option[value="' + head.db + '"]').length)
            $('#subqueryDb').val(head.db);

        // Robust Query Extraction - the SQL is kept VERBATIM (including any
        // newline right after query=) so an Overwrite round-trips cleanly.
        if (head.queryAt !== -1) {
            const sql = content.substring(head.queryAt).replace(/^query\s*=/i, '');

            // Update CodeMirror
            if (subqueryEditor) {
                subqueryEditor.setValue(sql);
                setTimeout(() => subqueryEditor.refresh(), 10);
            }
        }

        $('#generateSubqueryBtn').data('overwrite-target', tagString).text('Overwrite Tag');
        refreshSubqueryHints();
    }

