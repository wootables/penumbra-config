    // Organization switched off, non-admins see the author's widths only.
    function penumbraColWidthsRestricted() {
        return !penumbra_vars.isAdmin && !!window._penumbraHideColumns;
    }
    // Stored beside the layout keys under the frozen count's rule: only where
    // it DIFFERS from the report, so a viewer who never touched a column keeps
    // following the author if the author later changes it. No-op for an ad-hoc
    // query - no report id to file it under; the in-memory map lasts the session.
    function persistColumnWidthsPref() {
        userColumnWidths = penumbraColWidthsUserDiff();
        if (!currentLoadedStateName) return;
        try {
            const prefs = _spPrefMap('penumbra_column_prefs');
            const entry = prefs[currentLoadedStateName] || {};
            const keep = {};
            Object.keys(userColumnWidths).forEach(function (n) { keep[n] = userColumnWidths[n]; });
            if (Object.keys(keep).length) entry.widths = keep;
            else delete entry.widths;
            if (Object.keys(entry).length === 0) delete prefs[currentLoadedStateName];
            else prefs[currentLoadedStateName] = entry;
            localStorage.setItem('penumbra_column_prefs', JSON.stringify(prefs));
        } catch (e) { /* storage blocked or full: the in-memory pick still holds */ }
    }
    function penumbraColWidthsRefresh() {
        try { if (window.Penumbra && window.Penumbra.colWidths) window.Penumbra.colWidths.refresh(); } catch (e) {}
    }
    // What buildStateObject() writes: the widths as the author sees them now
    // (WYSIWYG, like visibleColumns) for the columns the flat header holds.
    // With no header to read - a failed, empty or in-flight run, the trap
    // _pnbStoredLayout covers for the layout - or with the width module
    // switched off, the report's own map goes through untouched. It runs
    // inside every save, so it fails SAFE: any surprise saves the report's map.
    function penumbraColWidthsForSave() {
        const stored = {};
        Object.keys(reportColumnWidths).forEach(function (n) { stored[n] = reportColumnWidths[n]; });
        try {
            const ths = document.querySelectorAll('#tableHeader th[data-colname]');
            if (!ths.length || !(window.Penumbra && window.Penumbra.colWidths)) return stored;
            const out = {};
            for (let i = 0; i < ths.length; i++) {
                const n = String(ths[i].getAttribute('data-colname') || '').toUpperCase();
                const w = penumbraColWidthFor(n);
                if (w) out[n] = w;
            }
            // A pivot's row-label widths are not flat columns: every one in
            // force goes through, whether a pivot is on screen or not.
            penumbraColWidthsPivotKeys().forEach(function (k) {
                const pw = penumbraColWidthFor(k);
                if (pw) out[k] = pw;
            });
            return out;
        } catch (e) { return stored; }
    }
    // After a save the widths it wrote ARE the report's, and the viewer's picks
    // that now match them are dropped - otherwise they would pin this browser
    // to today's widths after the author changes them. Called from the save
    // handlers' success paths, so nothing in here may throw into them.
    function penumbraColWidthsSaved(saved) {
        try {
            reportColumnWidths = penumbraCleanColWidths(saved, false);
            persistColumnWidthsPref();
            penumbraColWidthsRefresh();
            document.dispatchEvent(new CustomEvent('penumbra:columns-changed'));
        } catch (e) { /* widths are cosmetic; the save itself already succeeded */ }
    }
    window.Penumbra = window.Penumbra || {};
    window.Penumbra.colWidthsHost = {
        min: PENUMBRA_COLW_MIN,
        minValue: PENUMBRA_COLW_MIN_VALUE,
        max: PENUMBRA_COLW_MAX,
        widthFor: penumbraColWidthFor,
        restricted: penumbraColWidthsRestricted,
        // One viewer pick: whole px, 'auto' (fit to content, even over a width
        // the report set) or null (follow the report again).
        setUser: function (name, v) {
            const n = String(name || '').toUpperCase();
            if (!n || penumbraColWidthsRestricted()) return;
            if (v === null || v === undefined) delete userColumnWidths[n];
            else {
                const one = {};
                one[n] = v;
                const c = penumbraCleanColWidths(one, true);
                if (!(n in c)) return;
                userColumnWidths[n] = c[n];
            }
            persistColumnWidthsPref();
            try { document.dispatchEvent(new CustomEvent('penumbra:columns-changed')); } catch (e) {}
        },
        clearUser: function () {
            userColumnWidths = Object.create(null);
            persistColumnWidthsPref();
            try { document.dispatchEvent(new CustomEvent('penumbra:columns-changed')); } catch (e) {}
        },
        userDiff: function () { return Object.keys(penumbraColWidthsUserDiff()); },
        friendly: function (n) {
            return (window.Penumbra && window.Penumbra.journalFriendlyCol && window.Penumbra.journalFriendlyCol(n)) || n;
        },
        // For the suite and the console.
        state: function () {
            return { report: Object.assign({}, reportColumnWidths), user: Object.assign({}, userColumnWidths), key: currentLoadedStateName || null };
        }
    };
    // For a pivot's row-label columns: the row fields level by level (what a
    // width is filed under, PIVOT:<field>) and the pivot's sticky-column
    // layout, which reads those columns' widths by hand.
    window.Penumbra.colWidthsHost.pivotRowFields = function () {
        return (currentPivotSettings && Array.isArray(currentPivotSettings.rows)) ? currentPivotSettings.rows.slice() : [];
    };
    window.Penumbra.colWidthsHost.pivotRelayout = function () {
        try { updateStickyColumnLayout(); } catch (e) { /* no pivot on screen */ }
    };
    // A pivot's value column, while it has only one (js/penumbra_colwidths.js
    // decides that from the table): the field its one aggregation reads - that
    // aggregation's own column when it names one, else the pivot's value field.
    // A width for it is filed as PIVOT:=<field>, which penumbraColWidthsPivotKeys()
    // already carries through a save.
    window.Penumbra.colWidthsHost.pivotValueField = function () {
        const s = currentPivotSettings;
        if (!s) return null;
        const own = Array.isArray(s.aggColOverrides) ? s.aggColOverrides[0] : null;
        return (own || s.vals) ? String(own || s.vals) : null;
    };

    // Per-column custom formula text, same layers as the summaries themselves:
    // a formula typed into a footer badge > the user's > the report's. Kept in
    // a SIDECAR map rather than turning columnSummaries' values into objects,
    // so every report already saved keeps loading.
    let reportColumnSummaryFormulas = {};
    let userColumnSummaryFormulas = {};
    // The badge layer (2026-10-02): never saved, and cleared at the same two
    // moments as transientColumnSummaries (report change, settings Apply).
    let transientColumnSummaryFormulas = {};
    function penumbraResolveSummaryFormula(colName) {
        const name = String(colName || '').toUpperCase();
        if (Object.prototype.hasOwnProperty.call(transientColumnSummaryFormulas, name)) {
            return String(transientColumnSummaryFormulas[name] || '');
        }
        return penumbraResolveSummaryFormulaPersisted(name);
    }
    // The same lookup with the badge layer skipped: user > report. Anything
    // that WRITES must use this one, as with penumbraResolveSummaryPersisted()
    // for the type - through the full resolver, a formula only tried out on a
    // badge would be saved into the report and every ?state= link.
    function penumbraResolveSummaryFormulaPersisted(colName) {
        const name = String(colName || '').toUpperCase();
        if (Object.prototype.hasOwnProperty.call(userColumnSummaryFormulas, name)) {
            return String(userColumnSummaryFormulas[name] || '');
        }
        if (Object.prototype.hasOwnProperty.call(reportColumnSummaryFormulas, name)) {
            return String(reportColumnSummaryFormulas[name] || '');
        }
        return '';
    }

    // The pivot formula parser is case-sensitive on {Label}; our variables are a
    // fixed lowercase vocabulary, so fold the parsed references once instead of
    // asking users to match case.
    function _penumbraLowerFormulaLabels(ast) {
        if (!ast) return ast;
        if (ast.type === 'label') ast.name = String(ast.name || '').toLowerCase();
        else if (ast.type === 'neg') _penumbraLowerFormulaLabels(ast.operand);
        else if (ast.type === 'binop') { _penumbraLowerFormulaLabels(ast.left); _penumbraLowerFormulaLabels(ast.right); }
        return ast;
    }

    // Parse + validate a column formula. Returns {ast} or {error}.
    // Reuses the pivot's recursive-descent parser (no eval, already mirrored in
    // schedule_runner.php), so there is exactly one formula grammar in the app.
    function penumbraParseSummaryFormula(expr) {
        if (!expr || !String(expr).trim()) return { error: 'Formula is empty' };
        let ast;
        try {
            ast = _penumbraLowerFormulaLabels(parsePivotFormula(String(expr)));
        } catch (e) {
            return { error: (e && e.message) ? e.message : 'Invalid formula' };
        }
        const refs = collectFormulaLabelRefs(ast, []);
        for (let i = 0; i < refs.length; i++) {
            if (PENUMBRA_FORMULA_VARS.indexOf(refs[i]) === -1) {
                return { error: 'Unknown value {' + refs[i] + '}. Available: ' + PENUMBRA_FORMULA_VARS.join(', ') };
            }
        }
        return { ast: ast };
    }

    // Refresh the in-memory map from storage. Safe to call on every render pass:
    // it only reloads when the report actually changed, so re-running a query
    // does not wipe summary choices the user just made. Going through
    // loadColumnPrefs() keeps the admin "hide columns" gate intact.
    function hydrateUserColumnSummaries() {
        const key = currentLoadedStateName || null;
        if (_userSummariesKey !== undefined && key === _userSummariesKey) return;
        _userSummariesKey = key;
        const prefs = (typeof loadColumnPrefs === 'function') ? loadColumnPrefs() : null;
        userColumnSummaries = (prefs && prefs.summaries && typeof prefs.summaries === 'object')
            ? prefs.summaries
            : {};
        userSummaryBadges = (prefs && typeof prefs.summaryBadges === 'boolean') ? prefs.summaryBadges : null;
