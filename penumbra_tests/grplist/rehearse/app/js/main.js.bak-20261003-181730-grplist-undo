    }

    // Where does the LIVE side of "Compare To Live" actually live? A snapshot's live
    // counterpart is its OWN report's current data - never whatever happens to be on
    // screen. That has to be asked every time, because the list shows other reports'
    // snapshots whenever Browse All is on (which is always, on a home-screen tab).
    //   here      - the live rows on screen ARE the right side: compare in place.
    //   elsewhere - the snapshot belongs to a different report (or this tab has none):
    //               the live side is one navigation away, and ?snapcmp= is that link.
    //   nodata    - right report, but nothing has been rendered to compare against.
    //   unknown   - no source report recorded and no rows here, so there is no live
    //               side to find and nowhere to send the user.
    // masterRowData is the test, not ?id=: an admin running ad-hoc SQL on an unsaved
    // report has real live rows and no id, and comparing a local snapshot against them
    // is exactly what this has always done. A snapshot with no recorded parent (the
    // pre-2026-08 local shape) takes those same rows as its live side.
    function _snapCompareTarget(snap) {
        var hasLive = (typeof masterRowData !== 'undefined') && Array.isArray(masterRowData) && masterRowData.length > 0;
        var here = '';
        try { here = new URLSearchParams(window.location.search).get('id') || ''; } catch (e) { /* probe only */ }
        var rid = (snap && snap.reportShortId) || '';
        var title = (snap && snap.reportTitle) || '';
        if (!rid) {
            // No REPORT_SHORT_ID on the row, which happens two ways and BOTH mean
            // "this report": a SCOPED server list omits the column entirely (every row
            // in it is this report's, so the endpoint only sends it for Browse All),
            // and a pre-2026-08 local snapshot never stamped one. Fall back to this
            // tab's own report; with no report here either, the rows on screen are the
            // only live side there could be.
            if (here) { return { where: hasLive ? 'here' : 'nodata', rid: here, title: '' }; }
            return { where: hasLive ? 'here' : 'unknown', rid: '', title: '' };
        }
        if (rid === here) { return { where: hasLive ? 'here' : 'nodata', rid: rid, title: title }; }
        return { where: 'elsewhere', rid: rid, title: title };
    }

    function _updateUnifiedSnapSelection() {
