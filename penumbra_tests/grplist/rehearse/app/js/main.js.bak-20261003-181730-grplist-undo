    // --- DB_DUMP UI handlers ---
    // Normalize destination table name to A-Z, 0-9, _ (uppercase). Live filter on input
    // (paste-safe) plus a final trim on blur. Empty string allowed mid-typing; validation
    // happens at save-time in manage_schedule.php.
    $('#schedDbDumpTable').on('input', function () {
        var $el = $(this);
        var raw = $el.val();
        var cleaned = raw.toUpperCase().replace(/[^A-Z0-9_]/g, '');
        if (cleaned !== raw) {
            var pos = $el[0].selectionStart - (raw.length - cleaned.length);
            $el.val(cleaned);
            try { $el[0].setSelectionRange(pos, pos); } catch (e) { /* selection not supported on this input type */ }
        }
        // Hide stale ownership status while user is typing - it'll be
        // re-queried on blur. Prevents misleading green/red flicker.
        $('#schedDbDumpOwnershipStatus').hide().empty();
    });

    // Ownership check on blur. Hits manage_schedule.php?action=check_dump_destination
    // which inspects ALL_TAB_COMMENTS in the writer's schema. Renders one of:
    //   - green available banner   (table doesn't exist)
    //   - blue penumbra-owned banner (we made it; safe to recreate)
    //   - red foreign-table warning (someone else's table; DANGER)
    // The server's RUNNER also enforces this at execution time, so even if
    // the client skips this check the worst case is one wasted scheduler tick.
    $('#schedDbDumpTable').on('blur', function () {
        var table = ($(this).val() || '').toUpperCase().trim();
        var $box = $('#schedDbDumpOwnershipStatus');
        if (!table) { $box.hide().empty(); return; }
        if (!/^[A-Z][A-Z0-9_]{0,29}$/.test(table)) { $box.hide().empty(); return; }

        $.post('manage_schedule.php', { action: 'check_dump_destination', table: table }, function (resp) {
            if (!resp || !resp.status) { $box.hide().empty(); return; }
            // Theme-aware styling: only the LEFT BORDER color signals status
            // (green/blue/red/grey). Text and bg keep their theme-driven values
            // from the inline style on #schedDbDumpOwnershipStatus so the
            // banner reads correctly in light, dark, and brand themes.
            var html = '', borderColor = '';
            if (resp.status === 'available') {
                html = '&#10003; <strong>' + resp.schema + '.' + resp.table + '</strong> doesn\'t exist yet - will be created on first run.';
                borderColor = '#1a7f3a';
            } else if (resp.status === 'penumbra_owned') {
                html = '&#9432; <strong>' + resp.schema + '.' + resp.table + '</strong> already exists and is penumbra-owned. It will be dropped and recreated each run.'
                     + '<div style="margin-top:3px; font-size: 9px; opacity:0.75;">' + escapeHtml(resp.comment || '') + '</div>';
                borderColor = '#0a558c';
            } else if (resp.status === 'foreign') {
                html = '&#9888; <strong>Warning:</strong> <strong>' + resp.schema + '.' + resp.table + '</strong> already exists in the destination schema but is NOT marked as penumbra-owned. The runner will refuse to drop it. <strong>Pick a different name</strong> or ask a DBA to remove the existing table first.';
                if (resp.comment) html += '<div style="margin-top:3px; font-size: 9px; opacity:0.85;">Existing comment: ' + escapeHtml(resp.comment) + '</div>';
                borderColor = '#a52020';
            } else if (resp.status === 'error') {
                html = '&#9432; Could not verify destination: ' + escapeHtml(resp.message || '(unknown)');
                borderColor = ''; // keep default border-color (var(--border-color))
            } else {
                $box.hide().empty(); return;
            }
            // Only override the left-border color; everything else stays as
            // the inline theme-aware defaults set in index.php.
            $box.css('border-left-color', borderColor || '').html(html).show();
        }, 'json').fail(function () {
            $box.hide().empty();
        });
    });

