        //                            "Paused" is the actionable segment, and vice-versa.
        function setIntent(runningActive) {
            $runBtn.attr('aria-pressed', runningActive ? 'true' : 'false');
            $pauseBtn.attr('aria-pressed', runningActive ? 'false' : 'true');
        }

        $card.attr('data-runner-state', 'loading');
        $word.text('Checking…');
        $sub.text('Checking scheduler status…').removeAttr('title');
        $runBtn.off('click'); $pauseBtn.off('click');

        $.ajax({
            url: 'manage_schedule.php',
            data: { action: 'check_runner' },
            dataType: 'json',
            success: function (response) {
                if (!response || response.status !== 'success') {
                    $card.attr('data-runner-state', 'unknown');
                    $word.text('Status unknown');
                    $sub.text('The scheduler status could not be determined.').removeAttr('title');
                    setIntent(true);
                    return;
                }

                if (response.runner_status === 'paused') {
                    const p = response.pause_info || {};
                    const until = p.paused_until
                        ? new Date(p.paused_until * 1000).toLocaleString()
                        : 'until manually resumed';
                    $card.attr('data-runner-state', 'paused');
                    $word.text('Paused');
                    $sub.text((p.paused_by ? ('Paused by ' + p.paused_by) : 'Scheduler paused')
                        + ' · resumes ' + until)
                        .attr('title', p.note ? ('Note: ' + p.note) : '');
                    setIntent(false);   // "Paused" is the current intent
                    $pauseBtn.attr('title', 'All scheduled events are paused');
                    $runBtn.attr('title', 'Resume all scheduled events');

                    // Actionable segment: "Running" resumes the scheduler.
                    $runBtn.on('click', function () {
                        let msg = 'Scheduler is currently PAUSED';
                        if (p.paused_by) { msg += ' by ' + p.paused_by; }
                        if (p.note) { msg += '.\nNote: ' + p.note; }
                        msg += '\n\nResume scheduler operations for ALL tasks now?';
                        if (confirm(msg)) {
                            $.post('manage_schedule.php', { action: 'resume_scheduler' }, function () {
                                show_text("<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Scheduler resumed.</p>");
                                checkSchedulerRunnerStatus();
                            });
                        }
                    });
                    $pauseBtn.on('click', function () { return false; });   // already paused
                } else {
                    /* Four readings, not two. 'blocked' means the runner's own
                       log proves the process is ticking while the database
                       cannot be written - it IS running, so calling it Offline
                       here sent admins to restart a healthy scheduler during
                       the 2026-09-20 Oracle windows. 'unknown' means the check
                       itself could not be made, which is not a claim about the
                       runner at all. Only a confirmed dead runner is Offline. */
                    const rState = response.runner_status;
                    const isOnline  = rState === 'online';
                    const isBlocked = rState === 'blocked';
                    const isUnknown = rState === 'unknown';
                    $card.attr('data-runner-state',
                        isOnline ? 'online' : (isBlocked ? 'blocked' : (isUnknown ? 'unknown' : 'offline')));
                    $word.text(isOnline ? 'Online' : (isBlocked ? 'Blocked' : (isUnknown ? 'Status unknown' : 'Offline')));

                    if (isOnline) {
                        const ago = (response.seconds_ago != null)
                            ? (response.seconds_ago + 's ago')
                            : (response.last_run || 'recently');
                        $sub.text('All events live · last check-in ' + ago);
                    } else if (isBlocked) {
                        $sub.text('⚠ Running, but it cannot reach the database to record a heartbeat · check the database, not the scheduler');
                    } else if (isUnknown) {
                        $sub.text('The scheduler could not be checked · the database did not answer');
                    } else {
                        $sub.text('⚠ Runner not responding · last run ' + (response.last_run || 'unknown'));
                    }
                    $sub.attr('title', 'Last successful run: ' + (response.last_run || '?')
                        + (response.seconds_ago != null ? (' (' + response.seconds_ago + 's ago)') : ''));
                    setIntent(true);    // "Running" is the current intent
                    $runBtn.attr('title', 'All scheduled events are running');
                    $pauseBtn.attr('title', 'Pause all scheduled events globally');

                    $runBtn.on('click', function () { return false; });     // already running
                    // Actionable segment: "Paused" opens the global pause modal.
                    $pauseBtn.on('click', function () { showSchedulerPauseModal(); });
                }
            },
            error: function () {
                $card.attr('data-runner-state', 'unknown');
                $word.text('Status check failed');
                $sub.text('Could not reach the scheduler service.').removeAttr('title');
                setIntent(true);
            }
        });
    }

