        // Reliably strips hidden JSON/UI artifacts that jQuery.text() might accidentally include.
        const getCleanText = ($cell) => {
            const cellNode = $cell[0];
            if (!cellNode)
                return "";

            // Journal toggle cell: a textless <button aria-checked> - emit 1/0
            // (the totals-row placeholder has no button -> journalExportCell null -> "").
            if (cellNode.classList && cellNode.classList.contains('journal-toggle-col')) {
                const _tv = (window.Penumbra && window.Penumbra.journalExportCell) ? window.Penumbra.journalExportCell(cellNode) : null;
                return _tv !== null ? _tv : "";
            }

            // Faster exports (2026-09-30): a cell with no child ELEMENT is plain
            // text - nothing below changes it, so skip the clone.
            if (!cellNode.firstElementChild) return cellNode.textContent.trim();

            // 1. Deep clone the node to avoid modifying the live table
            const clone = cellNode.cloneNode(true);

            // 2. Remove specific garbage classes
            // Note: We use querySelectorAll to ensure we catch them all
            const garbage = clone.querySelectorAll('.raw-json-data, .json-error-fallback, .sort-icon, .col-sort-icon, .drag-handle');
            garbage.forEach(el => el.remove());

            // 2b. Modified-cell dual-view cleanup: each .snap-cell-modified
            // carries BOTH a .snap-ba-now-only (default visible) span and a
            // .snap-ba-pair ([was:]/[now:]) span, with CSS swapping visibility
            // based on body.snap-show-before-after. textContent ignores CSS,
            // so without this strip the export would concat both views.
            const _baOn = document.body.classList.contains('snap-show-before-after');
            clone.querySelectorAll(_baOn ? '.snap-ba-now-only' : '.snap-ba-pair').forEach(el => el.remove());

            // 3. Convert <br> to newlines for cleaner text output
            const brs = clone.querySelectorAll('br');
            brs.forEach(br => br.replaceWith('\n'));

            return clone.textContent.trim();
        }
            ;

        // ============================================================
        // 1. HTML Export (Email & Copy) - Uses WYSIWYG Helper
        // ============================================================
        if (format === 'html') {
            let htmlContent = '';
            let rowCount = 0;

            // opts come from Copy as HTML (allPages, budget, notice - see its
            // handler). The email embed passes none: it carries the page on screen.
            if (isPivotMode) {
                htmlContent = generateWysiwygHtml($('#pivotResultTable'), false, opts);
                rowCount = penumbraPivotBodyRowCount();
            } else if (isGrouped) {
                htmlContent = generateWysiwygHtml($('#groupedResultsContainer'), true, opts);
                rowCount = $('#groupedResultsContainer tbody tr:not(.search-hidden):not(.journal-note-child)').length;
            } else if (opts.allPages) {
                // EVERY page, laid out as Rows = All shows it (2026-09-30).
                const _lay = _pnbAllPagesLayout();
                try {
                    htmlContent = generateWysiwygHtml($('#resultsTable'), false, $.extend({}, opts, { offPageRows: true }));
