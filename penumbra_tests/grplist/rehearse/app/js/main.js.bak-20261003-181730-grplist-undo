        // Regex to detect "DD-MMM-YY" followed by a space and more characters.
        const oracleTimestampRegex = /^\d{2}-[A-Z]{3}-\d{2}\s/i;

        if (oracleTimestampRegex.test(processedDateStr)) {
            // If it matches, just take the first 9 characters (the "DD-MMM-YY" part)
            processedDateStr = processedDateStr.substring(0, 9);
        }
        // --- END: MODIFICATION ---

        let result = null;
        for (const fmt of _parseDateFormats) {
            const momentDate = moment(processedDateStr, fmt.format, true);
            if (momentDate.isValid()) {
                result = {
                    date: momentDate,
                    granularity: fmt.granularity
                };
                break;
            }
        }

        // Cache the result (cap size to prevent memory leak on huge datasets).
        // When full, STOP INSERTING instead of clearing: a .clear() here thrashed
        // the whole cache many times per pass on high-cardinality timestamp
        // columns, and wiped hot entries (including the parsed search term, which
        // is looked up once per row). Entries cached before the cap persist;
        // overflow values just pay the parse, same as a miss today. 2026-08-01
        if (_parseDateCache.size < _parseDateCacheMax) {
            _parseDateCache.set(dateStr.trim(), result);
        }

        return result;
    }

    // ===== START: ADD THIS NEW HELPER FUNCTION FOR PIVOT DATA PARSING =====
    /**
 * Parses the entire pivot table (head, body, foot) into a 2D array of strings.
 * This correctly handles all colspans and rowspans to create a perfect grid.
 * @returns {string[][]} A 2D array representing the table data.
 */
    function getPivotDataAsArray() {
        const $pivotTable = $('#pivotResultTable');
        if (!$pivotTable.is(':visible'))
            return [];
        // Reads every body row, collapsed ones included.
        penumbraPivotEnsureAllRows();

        const tableData = [];
        const cellMemory = {};
        // Handles rowspans

        // Iterate over every row in the entire table
        $pivotTable.find('tr').not('.pivot-group-summary-row').each(function (rowIndex) {
            let colIndex = 0;
            // Iterate over every cell in the current row
            $(this).find('th, td').each(function () {
                const $cell = $(this);
                const rowspan = parseInt($cell.attr('rowspan') || 1);
                const colspan = parseInt($cell.attr('colspan') || 1);
                let text = $cell.clone().find('.sort-icon, .col-sort-icon, .pivot-collapse-toggle').remove().end().text().trim();

                // Find the next available horizontal slot in our memory grid
                while (cellMemory[rowIndex]?.[colIndex]) {
                    colIndex++;
                }

                // Mark the cells this element occupies in memory for future rows
                for (let r = 0; r < rowspan; r++) {
                    if (!cellMemory[rowIndex + r])
                        cellMemory[rowIndex + r] = {};
                    for (let c = 0; c < colspan; c++) {
                        cellMemory[rowIndex + r][colIndex + c] = text;
                    }
                }
                colIndex += colspan;
            });
        });

        // Convert the memory grid into a simple 2D array
        let r = 0;
        while (cellMemory[r]) {
            let c = 0;
            const rowData = [];
            while (cellMemory[r][c] !== undefined) {
                rowData.push(cellMemory[r][c]);
                c++;
            }
            tableData.push(rowData);
            r++;
        }
        return tableData;
    }
    // ===== END: ADD THIS NEW HELPER FUNCTION =====

    /**
     * Returns a flattened version of getPivotDataAsArray() where multi-row headers
     * are collapsed into a single header row with "-" separators (e.g. "Design-Sum").
     * Used by XLSX and PDF exports for clean single-row headers.
     * @returns {string[][]} A 2D array with a single header row, body rows, and footer rows.
     */
    function getPivotDataAsArrayFlat() {
        const rawArray = getPivotDataAsArray();
        if (rawArray.length === 0) return [];

        const headerRowCount = $('#pivotResultTable thead tr').length;
        const footerRowCount = $('#pivotResultTable tfoot tr').length;
        const numRowFields = (typeof currentPivotSettings !== 'undefined' && currentPivotSettings && currentPivotSettings.rows)
            ? currentPivotSettings.rows.length : 0;

        // Fix footer: colspan-expanded "Grand Total" repeats across row-field columns
        // Replace repeated label with empty strings (keep only first)
        if (footerRowCount > 0 && numRowFields > 1) {
            for (let fi = rawArray.length - footerRowCount; fi < rawArray.length; fi++) {
                var footRow = rawArray[fi];
                if (footRow && footRow.length > numRowFields) {
                    var footLabel = footRow[0] || '';
                    // Check if the label is repeated across all row-field columns
                    var allSame = true;
                    for (var fc = 1; fc < numRowFields; fc++) {
                        if (footRow[fc] !== footLabel) { allSame = false; break; }
                    }
                    if (allSame && footLabel) {
                        for (var fc = 1; fc < numRowFields; fc++) {
                            footRow[fc] = '';
                        }
                    }
                }
            }
        }

        if (headerRowCount <= 1) return rawArray; // Already single-row header

        // Extract the multi-row header grid
        const headerRows = rawArray.slice(0, headerRowCount);
        const dataRows = rawArray.slice(headerRowCount);

        // Flatten: for each column, join distinct header values with "-"
        const colCount = headerRows[0] ? headerRows[0].length : 0;
        const flatHeaders = [];
        for (let c = 0; c < colCount; c++) {
            const parts = [];
            for (let r = 0; r < headerRows.length; r++) {
                var cellText = headerRows[r][c] || '';
                // Skip if same as previous row (e.g. colspan fills with repeated text)
                if (r === 0 || cellText !== headerRows[r - 1][c]) {
                    if (cellText) parts.push(cellText);
                }
            }
            flatHeaders.push(parts.join('-'));
        }

        return [flatHeaders].concat(dataRows);
    }

    // Tracks the snapshot + customKeys for the currently-displayed snapshot
    // Compare-to-Live View. Set by runComparisonAndDisplayGrouped(); cleared
    // by runComparisonTwoSnapshots() (A-vs-B doesn't benefit from re-running
    // since neither side is live). Used by runTableSearch() to decide whether
    // a search/clear should re-execute the comparison with the new filter.
    var _activeCompareSnapshot = null;

    // The A-vs-B counterpart: the two (already timestamp-ordered) snapshots +
    // customKeys behind the displayed snapshot-vs-snapshot diff. Set by
    // runComparisonTwoSnapshots(), cleared by runComparisonAndDisplayGrouped()
    // so the two trackers are mutually exclusive. Not used for search re-runs
    // (neither side is live) - only for _rerunActiveComparison().
    var _activeCompareAb = null;

    // Re-renders the currently-displayed snapshot comparison from its source
    // snapshot(s). Needed when something the comparison renders FROM changes -
    // notably the column layout: rebuildGroupedView() regroups the LIVE flat
    // rows, but a comparison is grouped by the synthetic __SNAP_TYPE column and
    // contains rows ("Removed") that aren't in the live table at all, so it
    // can't reconstruct the diff and would silently leave the groups stale.
    // Both renderers re-read the (already-updated) header for column order and
    // visibility, and their initial-render guards see snapshot-comparison-active
    // still set, so this counts as a re-run and won't re-collapse the header.
    // Returns true when a re-run was dispatched.
    function _rerunActiveComparison() {
        if (_activeCompareSnapshot && _activeCompareSnapshot.snapshot) {
            runComparisonAndDisplayGrouped(_activeCompareSnapshot.snapshot, _activeCompareSnapshot.customKeys);
            return true;
        }
        if (_activeCompareAb && _activeCompareAb.snapA && _activeCompareAb.snapB) {
            runComparisonTwoSnapshots(_activeCompareAb.snapA, _activeCompareAb.snapB, _activeCompareAb.customKeys);
            return true;
        }
        return false;
    }

    // Applies the current search box value to the (hidden) #resultsTable rows
    // by toggling the .search-hidden class - purely a side effect on those
    // rows, without re-rendering the flat-table view or its pagination. Used
    // before a comparison re-run so that runComparisonAndDisplayGrouped's
    // `tr:not(.search-hidden)` read picks up the new filter. Mirrors the
    // logic in runTableSearch's flat-table branch (lines ~31587-31644) but
    // skipping all the UI updates that would clobber the comparison view.
    function _applySearchToLiveTable(searchValue) {
        // This mirrors runTableSearch's flat branch, so the class stamp is
        // updated the same way (2026-08-01).
        _flatSearchAppliedFor = searchValue;
        if (searchValue === '') {
            const clearRows = document.querySelectorAll("#resultsTable tbody tr");
            for (let ci = 0; ci < clearRows.length; ci++) {
                clearRows[ci].classList.remove('search-hidden');
            }
            return;
        }
        const allColumns = Object.keys($("#resultsTable").data('columnNameToOriginalIndex') || {});
        if (!allColumns.includes('#')) allColumns.unshift('#');
        const virtualColNames = buildVirtualColumnNames();
        virtualColNames.forEach(vc => { if (!allColumns.some(c => c.toUpperCase() === vc)) allColumns.push(vc); });

        var requireRowMatch = false;
        var sv = searchValue;
        if (/^__ROW\s+/i.test(sv)) {
            requireRowMatch = true;
            sv = sv.replace(/^__ROW\s+/i, '');
        }
        const parsedQuery = parseAdvancedQuery(sv, allColumns);

        const matchSet = new Set();
        for (let mi = 0; mi < masterRowData.length; mi++) {
            const rowDataMap = masterRowData[mi];
            rowDataMap.set('#', String(mi + 1));
            if (evaluateParsedQuery(rowDataMap, parsedQuery, allColumns, requireRowMatch)) {
                matchSet.add(mi);
            }
        }
        const flatRows = document.querySelectorAll("#resultsTable tbody tr");
        for (let ri = 0; ri < flatRows.length; ri++) {
            const row = flatRows[ri];
            const rowIndex = parseInt(row.cells[0] ? row.cells[0].textContent : '', 10) - 1;
            if (matchSet.has(rowIndex)) {
                row.classList.remove('search-hidden');
            } else {
                row.classList.add('search-hidden');
            }
        }
    }

    // Reads a comparison-view cell's CURRENT value as plain text. Modified
    // cells carry BOTH pre-rendered views (.snap-ba-now-only / .snap-ba-pair,
    // CSS-swapped by body.snap-show-before-after) and a raw .text() returns
    // the two concatenated ("NEW [was:] OLD [now:] NEW") - which silently
    // broke the A-vs-B comparison search (numeric/exact conditions never
    // matched a modified cell) and made recomputeWrapperTotals parse NaN and
    // drop every modified cell from the group totals. Search and totals always
    // evaluate the CURRENT (new-side) value, matching the initial render's
    // totals semantics and the pre-dual-view search behavior.
    function _readComparisonCellText(cellNode) {
        if (!cellNode) return '';
        if (cellNode.querySelector) {
            var nowOnly = cellNode.querySelector('.snap-ba-now-only');
            if (nowOnly) return (nowOnly.textContent || '').trim();
        }
        return (cellNode.textContent || '').trim();
    }

    // Strips machine-generated __SNAP_TYPE group clauses (the comparison
    // group-header X buttons append them) from a search string, leaving only
    // real data clauses. Shared by the comparison renderer, the compare
    // search re-run, and the compare exit path so the three can't drift.
    function _stripSnapTypeClauses(s) {
        if (!s) return s;
        return s
            .replace(/\s+(and|or)\s+__SNAP_TYPE\s*(=|!=|<>)\s*'[^']*'/gi, '')
            .replace(/^__SNAP_TYPE\s*(=|!=|<>)\s*'[^']*'\s+(and|or)\s+/i, '')
            .replace(/^__SNAP_TYPE\s*(=|!=|<>)\s*'[^']*'\s*$/i, '')
            .replace(/\s{2,}/g, ' ').trim();
    }

    // The names the search parser must know for the flat table's rows: the
    // given column names, '#', the @@JSON nested columns and the journal
    // toggle/notes columns. ONE list for the search box's flat branch
    // (runTableSearch) and the two on-load pre-filters - a name missing from it
    // is read as a literal comparison that hides EVERY row, which a nested-column
    // condition did on load (a dashboard filter, a ?search= link, a default
    // preset) until 2026-09-29.
    function penumbraFlatSearchColumns(names) {
        const all = (names || []).map(c => String(c));
        if (!all.includes('#')) all.unshift('#');
        buildVirtualColumnNames().forEach(vc => { if (!all.some(c => c.toUpperCase() === vc)) all.push(vc); });
        if (window.Penumbra && window.Penumbra.journalSearchColumnNames) {
            window.Penumbra.journalSearchColumnNames().forEach(function (jc) {
                if (jc && !all.some(function (c) { return c.toUpperCase() === jc.toUpperCase(); })) all.push(jc);
            });
        }
        return all;
    }

    // The on-load pre-filter (the live table build and the snapshot table
    // rebuild): the masterRowData indexes the load's search keeps, read the way
    // the search box reads it once the page is up (runTableSearch, flat branch):
    // __SRC dropped, a leading __ROW holds nested conditions to ONE sub-row, and
    // the parser knows every name penumbraFlatSearchColumns lists. __SNAP_TYPE
    // group clauses go first - they are comparison-view group filters, not row
    // conditions (a ?snapcmp deep link carries the task's filter verbatim, and an
    // '=' form would blank every row); the box keeps the raw query. Stamps each
    // row's '#'. null = the query parses to nothing, so nothing is filtered.
    function penumbraPreFilterMatchSet(query, names) {
        let q = penumbraTakeSrcModifier(_stripSnapTypeClauses(query)).query;
        const rowMatch = /^__ROW\s+/i.test(q);
        if (rowMatch) q = q.replace(/^__ROW\s+/i, '');
        const cols = penumbraFlatSearchColumns(names);
        const parsed = parseAdvancedQuery(q, cols);
        if (!parsed.length) return null;
        const matchSet = new Set();
        for (let i = 0; i < masterRowData.length; i++) {
            masterRowData[i].set('#', String(i + 1));
            if (evaluateParsedQuery(masterRowData[i], parsed, cols, rowMatch)) matchSet.add(i);
        }
        penumbraRerunAfterJournalData(query);
        return matchSet;
    }

    // Does a search name a journal column (its friendly name - Done, Notes - or
    // its __JOURNAL sentinel) in a condition?
    function penumbraSearchNamesJournal(query) {
        const jn = (window.Penumbra && window.Penumbra.journalSearchColumnNames) ? window.Penumbra.journalSearchColumnNames() : [];
        if (!jn.length) return false;
        const up = jn.map(n => String(n).toUpperCase());
        const q = penumbraTakeSrcModifier(_stripSnapTypeClauses(String(query || ''))).query.replace(/^(?:__(?:ROW|ALL)\s+)*/i, '');
        const cols = penumbraFlatSearchColumns(Object.keys($('#resultsTable').data('columnNameToOriginalIndex') || {}));
        return parseAdvancedQuery(q, cols).some(function (p) {
            if (!p || p.type !== 'condition' || p.column == null) return false;
            const c = String(p.column).replace(/^\{\s*['"]?|['"]?\s*\}$/g, '').toUpperCase();
            return up.indexOf(c) !== -1 || c.indexOf('__JOURNAL') === 0;
        });
    }

    // A journal-column condition (Done = ☑, Notes > 0) reads journal state that
    // is fetched on its own when a report's state loads (toggle state, note
    // counts - manage_journal.php) and races the report query. A search
    // evaluated before that state lands reads every row as unchecked / without
    // notes, and nothing ran it again (until 2026-09-29): the on-load pre-filter
    // (a dashboard filter, a ?search= link, a default preset) and any search run
    // in that window. So once the fetches in flight have landed and the page's
    // own load has settled, that search runs again - the newest such search, and
    // only while the box still holds it (never text typed since). Only a search
    // that ran WHILE a fetch was in flight arms this, so posting a note later
    // never re-filters the rows under the user.
    var _pnbJournalRerunQuery = null;
    function penumbraRerunAfterJournalData(query) {
        const pend = (window.Penumbra && window.Penumbra.journalDataPending) ? window.Penumbra.journalDataPending() : [];
        if (!pend.length || !penumbraSearchNamesJournal(query)) return;
        const waiting = _pnbJournalRerunQuery !== null;
        _pnbJournalRerunQuery = String(query || '').trim();
        if (waiting) return;   // one re-run is already queued; it takes the newest search
        $.when.apply($, pend).always(function () {
            (function settle(n) {
                if (!_pnbDashSettled() && n < 80) { setTimeout(function () { settle(n + 1); }, 250); return; }
                const want = _pnbJournalRerunQuery;
                _pnbJournalRerunQuery = null;
                if (want && _pnbDashSettled() && String($('#tableSearch').val() || '').trim() === want) runTableSearch();
            })(0);
        });
    }

    async function runTableSearch() {
        // A journal-column condition run before the journal state has landed is
        // run again once it has (see penumbraRerunAfterJournalData).
        penumbraRerunAfterJournalData(String($('#tableSearch').val() || '').trim());
        // --- START: Special search handler for the snapshot comparison view ---
        if ($('#snapshotComparisonContainer').is(':visible')) {
            // NEW behavior for Compare-To-Live: re-run the comparison from
            // scratch with the new search applied to the live data. This makes
            // the diff stay apples-to-apples as the user narrows/widens the
            // filter on the live side. Only fires when we have a tracked
            // snapshot (Compare-To-Live path); A-vs-B comparisons fall through
            // to the legacy filter-within-comparison behavior below since
            // neither side is live.
            if (_activeCompareSnapshot && _activeCompareSnapshot.snapshot) {
                // Strip __SNAP_TYPE group clauses BEFORE the live-table filter:
                // __SNAP_TYPE isn't a live column, so an `=` clause parsed as an
                // always-false literal and blanked the entire live side (the `!=`
                // X-button form only survived because its literal is always
                // true). The renderer extracts the group clauses itself and
                // applies them to the rendered groups.
                try {
                    // __SRC only means something in pivot view; here it is dropped.
                    _applySearchToLiveTable(_stripSnapTypeClauses(penumbraTakeSrcModifier($('#tableSearch').val().trim()).query));
                    runComparisonAndDisplayGrouped(
                        _activeCompareSnapshot.snapshot,
                        _activeCompareSnapshot.customKeys
                    );
                } catch (eCmpSearch) {
                    // An unparseable search must never strand the overlay - this
                    // function is async, so a throw would surface only as an
                    // unhandled rejection with "Filtering..." left on screen.
                    console.error('Comparison search re-run failed:', eCmpSearch);
                    hideLoading();
                    show_text("<p id='undo_text'><span style='color: var(--accent-danger, #cc0000)'>ERROR:</span> That search couldn't be applied to the comparison. " + escapeHtml(eCmpSearch.message || '') + "</p>");
                }
                return;
            }
            showLoading("Filtering comparison results...");
            const searchValue = penumbraTakeSrcModifier($('#tableSearch').val().trim()).query;
            let totalVisibleRows = 0;

            // Recompute a wrapper's tfoot totals from the currently-visible tbody rows.
            // Without this, exports (CSV/XLS/HTML/email) carry stale per-group totals that
            // were calculated from ALL rows at render time, so the filter applies to data
            // but not totals - a confusing mismatch the user reported.
            const recomputeWrapperTotals = function ($wrapper) {
                const $tfootCells = $wrapper.find('tfoot td');
                if ($tfootCells.length === 0) return;
                $tfootCells.each(function () {
                    const $td = $(this);
                    const dataCol = $td.attr('data-column');
                    // Skip the row-number cell and any non-summary cell.
                    if (dataCol === '#' || dataCol === '__SNAP_TYPE') return;
                    const $strong = $td.find('strong');
                    if ($strong.length === 0) return;
                    // The relocated keyword cell (when '#' is hidden) is a <strong>
                    // in an unsummarized column - don't overwrite it. Class first,
                    // then the legacy literal for any footer rendered before this
                    // build stamped the class.
                    if ($td.hasClass('pnb-sum-label') || $strong.text().trim() === 'TOTALS') return;
                    // Re-run THIS column's own summary. Blind-summing here used to
                    // be correct when sum was the only possibility; with per-column
                    // types it would silently rewrite an Average or a Count into a
                    // total the moment the user typed in the search box.
                    const sumType = $td.attr('data-sum-type') || 'sum';
                    const acc = penumbraSummaryAccumulator(sumType, $td.attr('data-sum-col') || dataCol);
                    $wrapper.find('tbody tr:not(.search-hidden):not(.journal-note-child) td[data-column="' + dataCol + '"]').each(function () {
                        // _readComparisonCellText: modified cells summarize their
                        // CURRENT value, not the concatenated dual-view text.
                        acc.push(_readComparisonCellText(this));
                    });
                    const res = acc.finish();
                    // Serves both the grouped and the snapshot-diff footers -
                    // one shared format now, so no per-container branch. The
                    // currency flag must be passed: a currency column whose cells
                    // carry no literal '$' otherwise lost its symbol and its
                    // forced 2dp on every search.
                    const _cn = $td.attr('data-sum-col');
                    const _cid = _cn ? ($("#resultsTable").data('columnNameToOriginalIndex') || {})[_cn] : undefined;
                    const _props = (_cid !== undefined) ? ($("#resultsTable").data('columnProperties') || {})[_cid] : null;
                    $strong.text(res === null ? '' : penumbraFormatSummary(res, sumType, {
                        isCurrency: _props ? !!_props.isCurrency : undefined
                    }));
                });
            };

            if (searchValue === '') {
                // Logic for CLEARING the search - use the .search-hidden class instead of
                // inline display so getExportData() (which filters .group-wrapper:not(.search-hidden)
                // and tr:not(.search-hidden)) sees the correct visibility state.
                $('#snapshotComparisonContainer .group-wrapper, #snapshotComparisonContainer tbody tr').removeClass('search-hidden');
                $('#snapshotComparisonContainer .group-header').each(function () {
                    const $header = $(this);
                    const total = $header.data('total-rows');
                    $header.find('.group-count').text(`${total}`);
