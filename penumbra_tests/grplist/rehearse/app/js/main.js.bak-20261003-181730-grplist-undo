        // 1. Prevent duplicates based on email within the specific container
        let exists = false;
        $(`${containerSel} .email-capsule`).each(function () {
            if ($(this).data('email') === cleanEmail)
                exists = true;
        });

        if (exists) {
            $(inputSel).val('');
            // Clear input
            return;
        }

        let displayName = name || cleanEmail;
        let fullTooltipText = email;

        // 2. SPECIAL CASE: Check if the email being added is the current user's email.
        const currentUserEmail = (penumbra_vars.shibboleth.email || penumbra_vars.currentUserKey + "@ncsu.edu").toLowerCase();

        if (cleanEmail === currentUserEmail) {
            displayName = (penumbra_vars.shibboleth.fname && penumbra_vars.shibboleth.lname) ? `${penumbra_vars.shibboleth.fname} ${penumbra_vars.shibboleth.lname}` : penumbra_vars.currentUserKey;
