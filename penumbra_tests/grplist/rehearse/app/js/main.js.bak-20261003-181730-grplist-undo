        // also mounted by the admin chrome pages). The merged rules - pins
        // first by last-open then recents, zone rule between, no display caps
        // (the list scrolls via #sbReportsList max-height) - are documented
        // there. Row hrefs are explicit index.php so they work from every mount.
        function _sbRowHtml(it, isPinned, hideTime) {
            return window.PenumbraUserSeg.rowHtml(it, isPinned, hideTime);
        }
        function renderReportsList() {
            var $list = $('#sbReportsList');
            if (!$list.length) return;
            var html = window.PenumbraUserSeg.buildListHtml(_sbCurrentReportId());
            if (!html) {
                $list.html('<div class="sb-recent-empty">No other reports opened yet.</div>');
                return;
            }
            $list.html(html);
        }
        // Pinned SNAPSHOTS (server-side pins, PINNED_BY = me): lazily fetched
        // the first time the snapshots section renders, cached for the page life,
        // and re-rendered into the section when they arrive. Rows are OPEN-only
        // (?snap= deep link) - unpinning lives in the snapshot manager and the
        // home Pinned card, not this compact popover.
        var _sbSnapPins = null, _sbSnapPinsLoading = false;
        // LOCAL pinned snapshots live in browser storage (pinnedAt +
        // pinnedReportId stamped by the snapshot manager) - merged after the
        // server list so both kinds show here.
        function _sbLocalSnapPins() {
            try {
                var arr = JSON.parse(localStorage.getItem(SNAPSHOT_STORAGE_KEY) || '[]');
                if (!Array.isArray(arr)) return [];
                var out = [];
                for (var i = 0; i < arr.length; i++) {
                    var s = arr[i];
                    if (s && s.pinnedAt && s.pinnedReportId) {
                        out.push({ _localTs: String(s.timestamp), SNAP_NAME: s.name || 'Local snapshot', REPORT_SHORT_ID: s.pinnedReportId, REPORT_TITLE: '' });
                    }
                }
                return out;
            } catch (e) { return []; }
        }
        function _sbFetchSnapPins() {
            if (_sbSnapPins !== null || _sbSnapPinsLoading) return;
            // LOCAL pins are storage reads - render them instantly, never
            // gated on the network. The SERVER list rides a 5-minute
            // sessionStorage cache (invalidated by every pin/unpin), so the
            // popover usually costs zero round trips.
            _sbSnapPins = _sbLocalSnapPins();
            var cachedSrv = null;
            try {
                var rawC = sessionStorage.getItem('penumbra:sb:snapPins');
                if (rawC) {
                    var pc = JSON.parse(rawC);
                    if (pc && Array.isArray(pc.data) && (Date.now() - (+pc.ts || 0)) < 300000) cachedSrv = pc.data;
                }
            } catch (cacheErr) { /* the cache is a nicety */ }
            if (cachedSrv) {
                _sbSnapPins = cachedSrv.concat(_sbLocalSnapPins());
                if (_sbSnapPins.length) renderSnapPins();
                return;
            }
            _sbSnapPinsLoading = true;
            $.getJSON('manage_snapshots.php?action=list_pinned_mine')
                .done(function (resp) {
                    var srvPins = (resp && resp.status === 'success' && Array.isArray(resp.data)) ? resp.data : [];
                    try { sessionStorage.setItem('penumbra:sb:snapPins', JSON.stringify({ ts: Date.now(), data: srvPins })); } catch (cwErr) { /* best-effort */ }
                    _sbSnapPins = srvPins.concat(_sbLocalSnapPins());
                    if (_sbSnapPins.length) renderSnapPins();
                })
                .fail(function () { /* locals already shown */ })
                .always(function () { _sbSnapPinsLoading = false; });
        }
        function _sbSnapRowHtml(sp) {
            var nm = escapeHtml(sp.SNAP_NAME || ('Snapshot #' + sp.ID));
            var rt = escapeHtml(sp.REPORT_TITLE || sp.REPORT_SHORT_ID || 'report');
            var href = sp._localTs
                ? '?id=' + encodeURIComponent(String(sp.REPORT_SHORT_ID)) + '&snap=' + encodeURIComponent('local|' + sp._localTs)
                : '?snap=' + encodeURIComponent(String(sp.ID));
            // The parent report's short id rides the tooltip in parentheses for
            // the same reason the report rows carry it: a copied or duplicated
            // report keeps the original's title, so "Frozen snapshot of
            // <title>" alone is ambiguous. REPORT_SHORT_ID comes back
            // space-padded from Oracle - trim it.
            var rsid = escapeHtml(String(sp.REPORT_SHORT_ID == null ? '' : sp.REPORT_SHORT_ID).replace(/^\s+|\s+$/g, ''));
            var ttl;
            if (sp._localTs) {
                // The id takes the parenthetical the "this computer only" note
                // used to hold, which then trails on a hyphen the way the home
                // dock's own local-snapshot tooltip reads. No id-twice guard is
                // needed here: this branch never names the report.
                ttl = rsid ? 'Browser-local snapshot (' + rsid + ') - this computer only'
                           : 'Browser-local snapshot (this computer only)';
            } else {
                // rt ALREADY is the short id when the snapshot's report has no
                // title, so guard against printing it twice.
                ttl = 'Frozen snapshot of ' + rt;
                if (rsid && rsid !== rt) ttl += ' (' + rsid + ')';
            }
            // Static 📌 marker reuses .sb-recent-pin for the row grid, but is a
            // SPAN with no data-id and pointer-events:none - the report pin
            // toggle handler can never fire on it (_sbTogglePin no-ops without
            // an id anyway). The stretched .sb-recent-main link owns the click.
            return '<div class="sb-recent-row is-pinned">'
                 + '<span class="sb-recent-pin" style="pointer-events:none;" aria-hidden="true" title="Pinned snapshot">&#128204;</span>'
                 + '<a class="sb-recent-main" href="' + href + '" title="' + ttl + '">'
                     + '<span class="rt">&#128248; ' + nm + '</span></a>'
                 + '</div>';
        }
        // Pinned snapshots get their own trailing section (a frozen snapshot
        // is a different noun than a live report - no heart, open-only rows),
        // uncapped: the list scrolls (#sbSnapPinsList max-height) instead of
        // the old slice(0,3) truncation.
        function renderSnapPins() {
            var $sec = $('#sbSnapPinsSection'), $list = $('#sbSnapPinsList');
            if (!$list.length) return;
            _sbFetchSnapPins();
            var snaps = _sbSnapPins || [];
            if (!snaps.length) { $sec.hide(); return; }
            var html = '';
            for (var si = 0; si < snaps.length; si++) html += _sbSnapRowHtml(snaps[si]);
            $list.html(html);
            $sec.show();
        }
        // The report currently being viewed gets its own row at the top of the
        // popover so it can be pinned on the spot. It is excluded from Recent and
        // Pinned (above) so it never shows twice. Title comes from #mainReportTitle
        // - the same source recordRecentOpen() uses. hideTime=true: no "x ago".
        function renderCurrent() {
            var $sec = $('#sbCurrentSection'), $list = $('#sbCurrentList');
            if (!$list.length) return;
            var curId = _sbCurrentReportId();
            var title = $('#mainReportTitle').text().replace(/\s+/g, ' ').trim();
            if (!curId || !title) { $sec.hide(); $list.empty(); return; }
            var isPinned = !!_sbPinnedIdSet()[curId];
            $list.html(_sbRowHtml({ id: curId, title: title }, isPinned, true));
            $sec.show();
        }
        // Add/remove a report from the pinned set - storage writing + the
        // penumbra:favorites-changed dispatch (source 'statusbar') live in
        // penumbra_userseg.js; this wrapper just refreshes the popover's own
        // lists afterwards. The home page / admin console resync off the event.
        function _sbTogglePin(id, title) {
            if (!window.PenumbraUserSeg.togglePin(id, title, 'statusbar')) return;
            renderCurrent();
            renderReportsList();
        }
        // The "Ctrl+O opens the repository" tip in the profile popover: the
        // document-level .pnl-open-repo handler opens the repository module;
        // this only closes the popover underneath so it isn't still sitting
        // open when the repository lightbox is later dismissed.
        $bar.on('click', '.sb-repo-tip', function () { _sbCloseAllPops(); });
        // Pin / unpin from either list (event-delegated; rows are re-rendered on toggle).
        $bar.on('click', '.sb-recent-pin', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $row = $(this).closest('.sb-recent-row');
            _sbTogglePin($(this).attr('data-id'), $row.attr('data-title'));
        });
        // Keep the popover's lists current if favorites change elsewhere (home page,
        // admin console) while it is open. Ignore the event we raised ourselves.
        document.addEventListener('penumbra:favorites-changed', function (ev) {
            if (ev && ev.detail && ev.detail.source === 'statusbar') return;
            if ($('#sbUserSeg').hasClass('sb-open')) { renderCurrent(); renderReportsList(); }
        });

        // Fan every existing update of these nodes into the bar without
        // touching their call sites. (#execution-timer is intentionally NOT
        // observed - it ticks every 100ms during a load; we read its final
        // value inside refreshAll, which fires when #resultCount settles.)
        if (window.MutationObserver) {
            var ids = ['resultCount', 'dataLoadedTimestamp', 'importTimestamps'];
            var mo = new MutationObserver(scheduleRefresh);
            for (var k = 0; k < ids.length; k++) {
                var el = document.getElementById(ids[k]);
                if (el) mo.observe(el, { childList: true, subtree: true, characterData: true });
            }
        }

        // Recompute the responsive collapse whenever the viewport width changes.
        // The bar is fixed and viewport-wide, so a ResizeObserver on it fires on
        // real width changes only; our class toggles don't alter its border box,
        // so there's no feedback loop. rAF-coalesced. window.resize is the
        // fallback where ResizeObserver is unavailable.
        var _sbOverflowRaf = null;
        function _sbScheduleOverflow() {
            if (_sbOverflowRaf) return;
            var raf = window.requestAnimationFrame || function (cb) { return setTimeout(cb, 16); };
            _sbOverflowRaf = raf(function () { _sbOverflowRaf = null; _sbUpdateOverflow(); });
        }
        if (window.ResizeObserver) {
            try { new ResizeObserver(_sbScheduleOverflow).observe($bar[0]); }
            catch (e) { $(window).on('resize', _sbScheduleOverflow); }
        } else {
            $(window).on('resize', _sbScheduleOverflow);
        }

        refreshAll();   // paint for any report already rendered at ready time
    })();

});