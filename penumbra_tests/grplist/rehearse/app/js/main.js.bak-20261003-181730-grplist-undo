                    condRefsVirtual = true;
                    condVirtualCols.push(vcNames[vi]);
                }
            }
        }
        if (!targetIsVirtual && !condRefsVirtual) return rowDataMaps;

        // Build set of required columns: a source must contain at least one
        // of these to be expanded. This prevents unrelated @@JSON sources
        // (e.g. KEYWORDS) from producing phantom expanded rows that inherit
        // flat virtual-column values from the base entries.
        var requiredCols = {};
        if (targetIsVirtual) requiredCols[targetCol.toUpperCase()] = true;
        for (var ci = 0; ci < condVirtualCols.length; ci++) requiredCols[condVirtualCols[ci]] = true;

        // Expand
        var expanded = [];
        for (var ri = 0; ri < rowDataMaps.length; ri++) {
            var rowMap = rowDataMaps[ri];
            var sources = getStructuredVirtualData(rowMap);
            if (sources.length === 0) {
                expanded.push(rowMap);
                continue;
            }

            // Build base map: parent columns without @@JSON values
            var baseEntries = [];
            for (var entry of rowMap.entries()) {
                var strVal = String(entry[1] || '');
                if (strVal.indexOf('@@JSON') !== -1) continue;
                baseEntries.push([entry[0], entry[1]]);
            }

            var nestedFound = false;
            for (var si = 0; si < sources.length; si++) {
                var src = sources[si];
                // Only expand sources that contain at least one required column
                var sourceRelevant = false;
                for (var reqCol in requiredCols) {
                    if (src.columns.has(reqCol)) { sourceRelevant = true; break; }
                }
                if (!sourceRelevant) continue;

                for (var nri = 0; nri < src.rows.length; nri++) {
                    nestedFound = true;
                    var expandedMap = new Map(baseEntries);
                    var nRow = src.rows[nri];
                    for (var nEntry of nRow.entries()) {
                        expandedMap.set(nEntry[0], nEntry[1]);
                    }
                    expanded.push(expandedMap);
                }
            }
            if (!nestedFound) {
                expanded.push(rowMap);
            }
        }
        return expanded;
    }

    /**
 * Recursively builds an HTML structure from a JSON object or array using divs.
 * NOW WITH WHITELIST & CURRENCY AWARE TOTALS
 * UPDATED: Totals respect source data formatting (decimals/commas)
 * @param {object | Array} jsonData - The parsed JSON data.
 * @param {string} path - The current dot-notation path to the data being rendered.
 * @returns {string} An HTML string of nested divs styled as a table.
 */
    function createTableFromJson(jsonData, path) {
        // --- CASE 1: Array of Objects (Data Grid style) ---
        if (Array.isArray(jsonData) && jsonData.length > 0 && typeof jsonData[0] === 'object' && jsonData[0] !== null) {
            let html = `<div class="nested-json-container data-grid-table" data-json-path="${path}">`;

            // 1. Analyze Columns
            // __PNBDIFF is a sub-row diff marker (comparison was/now views, see
            // _annotateJsonSubDiff) - consumed as a row tint below, never a column.
            const keys = Object.keys(jsonData[0]).filter(k => k !== '__PNBDIFF');
            const columnStats = {};

            // Load the whitelist from the global variables passed from PHP
            const exemptionList = (typeof penumbra_vars !== 'undefined' && penumbra_vars.totalExemptions) ? penumbra_vars.totalExemptions : [];

            keys.forEach(key => {
                columnStats[key] = {
                    sum: 0,
                    hasNumber: false,
                    isInvalid: false,
                    // Contains text/dates
                    isCurrency: false,
                    // Detected '$' in values
                    isWhitelisted: false,
                    // Matches config whitelist
                    maxDecimals: 0,
                    // Track max decimal precision found
                    hasCommas: false // Track if commas were used in source
                };

                // Check Whitelist (Case Insensitive)
                const upperKey = key.toUpperCase();
                if (exemptionList.some(term => upperKey.includes(term))) {
                    columnStats[key].isWhitelisted = true;
                }
            }
            );

            let rowsHtml = '';

            // 2. Iterate Data
            jsonData.forEach(item => {
                var _subDiff = (item && typeof item.__PNBDIFF === 'string') ? item.__PNBDIFF : '';
                if (_subDiff !== 'added' && _subDiff !== 'removed' && _subDiff !== 'changed') _subDiff = '';
                rowsHtml += _subDiff
                    ? '<div class="nested-json-row pnb-subdiff-' + _subDiff + '" title="Sub-row ' + _subDiff + ' in this comparison">'
                    : '<div class="nested-json-row">';

                keys.forEach(key => {
                    const rawVal = item[key];

                    // If the value is another object, recurse
                    if (typeof rawVal === 'object' && rawVal !== null) {
                        rowsHtml += `<div class="nested-json-cell">${createTableFromJson(rawVal, '')}</div>`;
                        columnStats[key].isInvalid = true;
                    } else {
                        var cellStr = String(rawVal == null ? '' : rawVal);
                        if (cellStr.indexOf('@@HTML') === 0) {
                            // Nested @@HTML - sanitize and render as HTML
                            var htmlContent = cellStr.substring(6);
                            var sanitized = (typeof DOMPurify !== 'undefined') ? DOMPurify.sanitize(htmlContent, {
                                ADD_ATTR: ['target', 'data-search', 'data-replace', 'data-prompt']
                            }) : htmlContent;
                            rowsHtml += '<div class="nested-json-cell">' + sanitized + '</div>';
                            columnStats[key].isInvalid = true;
                        } else if (cellStr.indexOf('@@JSON') === 0) {
                            // Nested @@JSON - hand to formatCellContent(), the same
                            // encoder-aware renderer the main grid uses, so we
                            // inherit its parse + truncation repair + hidden
                            // raw-json-data div rather than growing a second copy.
                            // (It calls back into this function for the parsed
                            // payload; recursion terminates on the data's depth.)
                            // Only @@HTML was handled here, so a @@JSON cell fell
                            // through to escapeHtml and printed literal
                            // "@@JSON[{...}]" text - in a jsontable| infobox AND
                            // in any @@JSON nested inside another @@JSON.
                            // query.php passes @@JSON through UNENCODED (~1255,
                            // "Pass formatted JSON"), so JSON.parse sees raw quotes.
                            rowsHtml += '<div class="nested-json-cell">' + formatCellContent(cellStr) + '</div>';
                            columnStats[key].isInvalid = true;
                        } else if (resolverLinksEnabled && resolverRegex.test(cellStr)) {
                            var esc = escapeHtml(cellStr);
                            // "project record", not "in RED": resolver/103 accepts all
                            // three ID shapes this app links (RED PAM/PT and RADAR), so
                            // naming one system was wrong on the RADAR_ID column.
                            rowsHtml += '<div class="nested-json-cell"><a href="https://oitras.oit.ncsu.edu/resolver/103?id=' + esc + '" target="_new" title="View the project record (requires proper access)" class="resolver-link">' + esc + '</a></div>';
                        } else {
                            rowsHtml += `<div class="nested-json-cell">${escapeHtml(rawVal)}</div>`;
                        }

                        if (!columnStats[key].isInvalid) {
                            // Ignore empty values
                            if (rawVal === null || rawVal === undefined || String(rawVal).trim() === '') {// Treat as 0, do nothing
                            } else {
                                const strVal = String(rawVal);

                                // Check for Currency Symbol
                                if (strVal.includes('$')) {
                                    columnStats[key].isCurrency = true;
                                }

                                // Check for Commas
                                if (strVal.includes(',')) {
                                    columnStats[key].hasCommas = true;
                                }

                                // Clean number (remove $ and , and handle parens)
                                const num = parseAccountingNumber(strVal);

                                // Strict number check
                                if (!isNaN(num) && isFinite(num)) {
                                    columnStats[key].sum += num;
                                    columnStats[key].hasNumber = true;

                                    // Track decimal precision
                                    if (strVal.includes('.')) {
                                        // Remove non-numeric from the end (like ')' or spaces)
                                        const decimalPart = strVal.split('.')[1].replace(/[^0-9]/g, '');
                                        columnStats[key].maxDecimals = Math.max(columnStats[key].maxDecimals, decimalPart.length);
                                    }
                                } else {
                                    columnStats[key].isInvalid = true;
                                    // Found text/date
                                }
                            }
                        }
                    }
                }
                );
                rowsHtml += '</div>';
            }
            );

            // 3. Build Header
            html += '<div class="nested-json-header">';
            keys.forEach(key => {
                html += `<div class="nested-json-cell">${escapeHtml(key)}<span class="sort-icon">&#9650;&#9660;</span></div>`;
            }
            );
            html += '</div>';

            // 4. Append Body
            html += rowsHtml;

            // 5. Build Total Row (Strict Logic)
            // Rule: Must be Numeric AND (Currency OR Whitelisted)
            const hasAnyTotal = keys.some(key => !columnStats[key].isInvalid && columnStats[key].hasNumber && (columnStats[key].isCurrency || columnStats[key].isWhitelisted));

            if (hasAnyTotal) {
                html += '<div class="nested-json-row nested-total-row">';
                keys.forEach((key, index) => {
                    const stats = columnStats[key];
                    const showTotal = !stats.isInvalid && stats.hasNumber && (stats.isCurrency || stats.isWhitelisted);

                    if (index === 0) {
                        html += `<div class="nested-json-cell"><strong>TOTAL</strong></div>`;
                    } else if (showTotal) {
                        const prefix = stats.isCurrency ? '$' : '';
                        // Use detected formatting options
                        const fmt = stats.sum.toLocaleString(undefined, {
                            minimumFractionDigits: stats.maxDecimals,
                            maximumFractionDigits: stats.maxDecimals,
                            useGrouping: stats.hasCommas
                        });
                        html += `<div class="nested-json-cell"><strong>${prefix}${fmt}</strong></div>`;
                    } else {
                        html += `<div class="nested-json-cell"></div>`;
                    }
                }
                );
                html += '</div>';
            }

            html += '</div>';
            return html;
        }// --- CASE 2: Single Object (Key-Value style) ---
        else if (typeof jsonData === 'object' && jsonData !== null && !Array.isArray(jsonData)) {
            let html = `<div class="nested-json-container key-value-table" data-json-path="${path}">`;
            for (const [key, value] of Object.entries(jsonData)) {
                html += '<div class="nested-json-row">';
                html += `<div class="nested-json-cell key">${escapeHtml(key)}</div>`;
                const newPath = path ? `${path}.${key}` : key;
                if (typeof value === 'object' && value !== null) {
                    html += `<div class="nested-json-cell value contains-sub-table">${createTableFromJson(value, newPath)}</div>`;
                } else {
                    html += `<div class="nested-json-cell value">${escapeHtml(value)}</div>`;
                }
                html += '</div>';
            }
            html += '</div>';
            return html;
        }// --- CASE 3: Simple Array (Comma separated list) ---
        else if (Array.isArray(jsonData)) {
            return escapeHtml(jsonData.join(', '));
        }

        return '';
    }

    /**
     * Updates table borders for headers and manages classes for row hover accents.
     * Uses Vanilla JS iteration to prevent stack overflow on large datasets (>65k rows).
     */
    function updateTableBorders() {
        return;
        // disabled for now until we work out permanent containerization
        // 1. Update Headers (Fast enough to keep jQuery)
        $('#resultsTable thead th, #groupedResultsContainer thead th, #pivotResultTable thead th').removeClass('first-visible last-visible');

        $('#resultsTable, #groupedResultsContainer table, #pivotResultTable').each(function () {
            const $visibleHeaders = $(this).find('thead tr:first th:visible');
            if ($visibleHeaders.length > 0) {
                $visibleHeaders.first().addClass('first-visible');
                $visibleHeaders.last().addClass('last-visible');
            }
        });

        // 2. Update Rows (Native JS for Performance)
        const tableSelectors = ['#resultsTable', '#groupedResultsContainer table', '#pivotResultTable'];

        tableSelectors.forEach(selector => {
            // Find all matching tables
            const tables = document.querySelectorAll(selector);

            tables.forEach(table => {
                // Skip hidden tables (optimization)
                if (table.offsetParent === null)
                    return;

                // Iterate rows directly
                const rows = table.querySelectorAll('tbody tr');
                for (let r = 0; r < rows.length; r++) {
                    const row = rows[r];
                    // Skip hidden rows
                    if (row.style.display === 'none')
                        continue;

                    const cells = row.cells;
                    let first = null;
                    let last = null;

                    // Find first and last visible cell
                    for (let c = 0; c < cells.length; c++) {
                        const cell = cells[c];
                        // Clear previous classes
                        cell.classList.remove('first-visible-cell', 'last-visible-cell');

                        if (cell.style.display !== 'none') {
                            if (!first)
                                first = cell;
                            last = cell;
                        }
                    }

                    // Apply classes
                    if (first)
                        first.classList.add('first-visible-cell');
                    if (last)
                        last.classList.add('last-visible-cell');
                }
            }
            );
        }
        );
    }

