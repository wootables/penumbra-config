        var values = getCSValuesFromList();
        var lc = val.toLowerCase();
        for (var i = 0; i < values.length; i++) {
            // Matching is case-insensitive, so a second copy would be dead weight
            // AND would fight the first for the value's position. Point at the
            // existing row instead of quietly adding a duplicate.
            if (String(values[i]).trim().toLowerCase() === lc) {
                $('#csManualValueInput').val('').focus();
