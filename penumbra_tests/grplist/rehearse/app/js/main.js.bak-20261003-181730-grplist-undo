        // 3. SCHEDULER SPECIFIC: Add warning text to display name if external
        //if (containerSel === '#schedEmailContainer' && !cleanEmail.endsWith('@ncsu.edu')) {
        //    displayName += ' (Shibboleth Authorization Required)';
        //}

        // 4. Create HTML (data-name stores the display name for scheduler per-recipient variables)
        // For current user with no explicit name, use Shibboleth name
        let capsuleName = name || '';
        if (!capsuleName && cleanEmail === currentUserEmail && penumbra_vars.shibboleth.fname) {
            capsuleName = penumbra_vars.shibboleth.lname
                ? `${penumbra_vars.shibboleth.fname} ${penumbra_vars.shibboleth.lname}`
