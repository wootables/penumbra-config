    function _groupBucketVariantsFor(col) {
        var out = [];
        var kind = _pivotFieldSplitKind(col);
        if (kind === 'date') {
            var gran = _pivotFieldDateGran(col);
            if (gran < 1) return out;
            PENUMBRA_PIVOT_SPLIT_MENU.forEach(function (id) {
                var v = PENUMBRA_PIVOT_SPLITS[id];
                if (v && v.minGran <= gran) out.push({ token: col + ':' + id, label: v.label, ex: v.ex });
            });
