     * correctly handling nested brackets [ ... [ ... ] ... ].
     *
     * The body scan mirrors extractSubqueryTags() in shared_logic.php, so the
     * Tag Generator sees exactly the tags the server will run: it is
     * quote-aware ('...' / "..." literals, MS-SQL [Column Name] brackets) AND
     * comment-aware (-- to end of line, slash-star block comments). Without
     * the comment rules a lone apostrophe in a comment (-- PI's dept) flipped
     * quote state and swallowed the closing ']' - the tag vanished from "Edit
     * Existing" and double-click - and a stray ']' in a comment closed the
     * tag early, so prefill loaded a truncated query. Shared caveat: because
     * -- runs to the newline, a closing ']' on the same line after a trailing
     * -- comment is comment text and the tag is skipped as unbalanced; keep
     * the ']' on its own line. An unterminated block comment likewise leaves
     * the tag unbalanced.
     * Returns an array of full tag strings.
     */
    function extractBalancedTags(text, tagPrefix) {
        const results = [];
        const regex = new RegExp(`\\[\\s*${tagPrefix}`, 'gi');
        let match;

        while ((match = regex.exec(text)) !== null) {
            let openCount = 1;
            let currentPos = match.index + match[0].length;
            let inQuote = false;
            let quoteChar = '';
            let inLineComment = false;
            let inBlockComment = false;

            while (openCount > 0 && currentPos < text.length) {
                const ch = text[currentPos];
                const next = (currentPos + 1 < text.length) ? text[currentPos + 1] : '';
                if (inLineComment) {
                    if (ch === '\n') inLineComment = false;
                } else if (inBlockComment) {
                    if (ch === '*' && next === '/') { inBlockComment = false; currentPos += 2; continue; }
                } else if (inQuote) {
                    if (ch === quoteChar) inQuote = false;
                } else if (ch === '-' && next === '-') {
                    inLineComment = true; currentPos += 2; continue;
                } else if (ch === '/' && next === '*') {
                    inBlockComment = true; currentPos += 2; continue;
                } else if (ch === "'" || ch === '"') {
                    inQuote = true;
                    quoteChar = ch;
                } else if (ch === '[') {
                    openCount++;
                } else if (ch === ']') {
                    openCount--;
                }
                currentPos++;
            }

            if (openCount === 0) {
                // Found complete tag
                results.push(text.substring(match.index, currentPos));
            }
        }
        return results;
    }

