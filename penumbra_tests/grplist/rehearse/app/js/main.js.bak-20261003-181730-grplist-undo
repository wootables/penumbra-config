    /**
     * Extracts the output column names from a SELECT clause.
     * V7: Handles T-SQL style [Brackets] in columns and aliases.
     */
    function extractColumnsFromSelect(selectQuery) {
        if (!selectQuery)
            return [];

        // 1. Clean Comments
        let cleanQuery = selectQuery.replace(/\/\*[\s\S]*?\*\//g, ' ').replace(/--.*/g, ' ').replace(/[\r\n]+/g, ' ').trim();

        // 2. Unwrap outer parentheses
        if (cleanQuery.startsWith('(') && cleanQuery.endsWith(')')) {
            let balance = 0;
            let isWrapped = true;
            for (let i = 0; i < cleanQuery.length - 1; i++) {
                if (cleanQuery[i] === '(')
                    balance++;
                if (cleanQuery[i] === ')')
                    balance--;
                if (balance === 0 && i > 0) {
                    isWrapped = false;
                    break;
                }
            }
            if (isWrapped) {
                cleanQuery = cleanQuery.substring(1, cleanQuery.length - 1).trim();
            }
        }

        const selectMatch = cleanQuery.match(/^\s*SELECT\s+(?:DISTINCT\s+)?/i);
        if (!selectMatch)
            return [];

        const startOfCols = selectMatch[0].length;
        const rest = cleanQuery.substring(startOfCols);

        // 3. Find FROM clause (Balance () and [])
        let balance = 0;
        let bracketBalance = 0;
        let fromIndex = -1;

        for (let i = 0; i < rest.length; i++) {
            const char = rest[i];
            if (char === '(')
                balance++;
            else if (char === ')')
                balance--;
            else if (char === '[')
                bracketBalance++;
            else if (char === ']')
                bracketBalance--;
            else if (balance === 0 && bracketBalance === 0) {
                if (rest.substr(i).match(/^\s+FROM\b/i)) {
                    fromIndex = i;
                    break;
                }
            }
        }

        let columnDefs = (fromIndex !== -1) ? rest.substring(0, fromIndex) : rest;
        const columns = [];

        // 4. Split by comma (Balance () and [])
        balance = 0;
        bracketBalance = 0;
        let start = 0;

        for (let i = 0; i < columnDefs.length; i++) {
            const char = columnDefs[i];
            if (char === '(')
                balance++;
            else if (char === ')')
                balance--;
            else if (char === '[')
                bracketBalance++;
            else if (char === ']')
                bracketBalance--;
            else if (char === ',' && balance === 0 && bracketBalance === 0) {
                columns.push(columnDefs.substring(start, i).trim());
                start = i + 1;
            }
        }
        columns.push(columnDefs.substring(start).trim());

        // 5. Extract Aliases (Now supports [Alias])
        return columns.map(col => {
            col = col.trim();
            if (!col)
                return null;
            col = col.replace(/\)+$/, '');

            // A. Check for "AS Alias" (supports [Alias])
            const asMatch = col.match(/\s+AS\s+(?:\[([^\]]+)\]|([a-zA-Z0-9_]+))/i);
            if (asMatch)
                return asMatch[1] || asMatch[2];

            // B. Check for Implicit Alias (Space + Identifier or [Identifier])
            // Regex checks for a space followed by either [Brackets] or Word, at the end of the string
            const spaceMatch = col.match(/\s+(?:\[([^\]]+)\]|([a-zA-Z0-9_]+))$/);
            if (spaceMatch) {
                const candidate = spaceMatch[1] || spaceMatch[2];
                if (!/^(AND|OR|FROM|WHERE|JOIN|DESC|ASC|NULL|END|ELSE|IS|IN)$/i.test(candidate) && !/^'.*'$/.test(candidate)) {
                    return candidate;
                }
            }

            // C. Fallback: table.column (supports [table].[column])
            // If the string ends with a bracketed section, take that.
            const bracketColMatch = col.match(/\[([^\]]+)\]$/);
            if (bracketColMatch)
                return bracketColMatch[1];

            // Standard split
            const parts = col.split('.');
            const lastPart = parts[parts.length - 1];

            // FIX: Preserve wildcards so the resolver can expand them later
            if (lastPart === '*') {
                return parts.join('.');
                // Returns "*" or "alias.*"
            }

            return lastPart.replace(/[^a-zA-Z0-9_]/g, '');
        }
        ).filter(c => c && c.toUpperCase() !== 'NULL');
    }

    /**
     * Parses a SQL query to find all CTEs AND APPLY subqueries.
     * V6: Relaxed regex (^\s*) to match aliases even without strict spacing.
     */
    function findAllCTEsInQuery(query) {
        const ctes = new Map();

        // --- 1. Find WITH clause CTEs ---
        const withClauseRegex = /\bWITH\s+/i;
        const withMatch = query.match(withClauseRegex);

        if (withMatch) {
            let searchIndex = withMatch.index + withMatch[0].length;
            let continueParsing = true;

            while (continueParsing) {
                const aliasRegex = /(\w+)\s*AS\s*\(/gi;
                aliasRegex.lastIndex = searchIndex;
                const aliasMatch = aliasRegex.exec(query);

                if (!aliasMatch)
                    break;

                const alias = aliasMatch[1].toUpperCase();
                const bodyStartIndex = aliasMatch.index + aliasMatch[0].length;
                let parenCount = 1;
                let bodyEndIndex = -1;

                for (let i = bodyStartIndex; i < query.length; i++) {
                    if (query[i] === '(')
                        parenCount++;
                    else if (query[i] === ')')
                        parenCount--;
                    if (parenCount === 0) {
                        bodyEndIndex = i;
                        break;
                    }
                }

                if (bodyEndIndex === -1)
                    break;
                ctes.set(alias, query.substring(bodyStartIndex, bodyEndIndex));

                let nextCharIndex = bodyEndIndex + 1;
                while (nextCharIndex < query.length && /\s/.test(query[nextCharIndex]))
                    nextCharIndex++;
                if (query[nextCharIndex] === ',')
                    searchIndex = nextCharIndex + 1;
                else
                    continueParsing = false;
            }
        }

        // --- 2. Find OUTER/CROSS APPLY Aliases ---
        const applyRegex = /\b(OUTER|CROSS)\s+APPLY\s*\(/gi;
        let applyMatch;
        while ((applyMatch = applyRegex.exec(query)) !== null) {
            const startBody = applyMatch.index + applyMatch[0].length;
            let parenCount = 1;
            let endBody = -1;
            for (let i = startBody; i < query.length; i++) {
                if (query[i] === '(')
                    parenCount++;
                else if (query[i] === ')')
                    parenCount--;
                if (parenCount === 0) {
                    endBody = i;
                    break;
                }
            }
            if (endBody !== -1) {
                // CHANGED: ^\s* allows alias immediately after paren
                const remainder = query.substring(endBody + 1);
                const aliasMatch = remainder.match(/^\s*(?:AS\s+)?([a-zA-Z0-9_]+)/i);
                if (aliasMatch) {
                    ctes.set(aliasMatch[1].toUpperCase(), query.substring(startBody, endBody));
                }
            }
        }
        return ctes;
    }

    /**
     * Recursively resolves columns for a table or CTE, handling wildcards.
     */
    async function resolveSourceColumns(sourceName, ctes, depth = 0) {
        if (depth > 5)
            return [];
        // Prevent infinite recursion

        const upperName = sourceName.toUpperCase();

        // 1. Is it a CTE?
        if (ctes.has(upperName)) {
            const query = ctes.get(upperName);
            const explicitCols = extractColumnsFromSelect(query);
            const resolvedCols = [];

            // Check if we need to resolve wildcards (e.g. "b.*" or "*")
            const hasWildcard = explicitCols.some(c => c.includes('*'));

            if (hasWildcard) {
                // We need to know the sources of THIS CTE to expand the wildcard
                const sources = findAllTablesInQueryV17(query, ctes);

                for (const col of explicitCols) {
                    if (col === '*') {
                        // Expand * -> All columns from all sources in this CTE
                        for (const src of sources) {
                            const srcCols = await resolveSourceColumns(src.name, ctes, depth + 1);
                            resolvedCols.push(...srcCols);
                        }
                    } else if (col.endsWith('.*')) {
                        // Expand alias.* -> All columns from that specific source
                        const alias = col.split('.')[0].toUpperCase();
                        const targetSrc = sources.find(s => (s.alias && s.alias.toUpperCase() === alias) || (!s.alias && s.name.toUpperCase() === alias));
                        if (targetSrc) {
                            const srcCols = await resolveSourceColumns(targetSrc.name, ctes, depth + 1);
                            resolvedCols.push(...srcCols);
                        }
                    } else {
                        resolvedCols.push(col);
                    }
                }
                return resolvedCols;
            } else {
                return explicitCols;
            }
        }

        // 2. Is it a Real Table?
        if (allTableNames.some(t => t.toUpperCase() === upperName)) {
            return await getTableColumns(sourceName);
        }

        return [];
    }

    // Concat dialect for the @@HTML Link hint: MS-SQL has no || operator, so
    // the wrap must use CONCAT() there. Resolves the dialect of the exact
    // scope receiving the insertion - an open [SUBQUERY]/[CTE_SUBQUERY] tag
    // follows its db= target (pins/infoed are the MS-SQL connections), the
    // Tag Generator editor follows its db dropdown, and everything else uses
    // the whole-query detector (which strips tag bodies).
    function dialectForHintScope(cm, pos) {
        const isMssqlDb = (db) => db === 'pins' || db === 'infoed';
        const full = cm.getValue();
        const idx = cm.indexFromPos(pos);
        const before = full.substring(0, idx);
        const lastOpen = before.lastIndexOf('[');
        if (lastOpen !== -1 && lastOpen > before.lastIndexOf(']')) {
            const nextClose = full.indexOf(']', idx);
            const tagText = full.substring(lastOpen, nextClose === -1 ? full.length : nextClose);
            if (/^\[\s*(?:CTE_)?SUBQUERY/i.test(tagText)) {
                // Only look at params before query= so an inner "...db=..." in
                // the subquery SQL itself can't be mistaken for the tag param.
                const head = tagText.split(/query\s*=/i)[0];
                const dbMatch = head.match(/[;\s]db\s*=\s*([a-zA-Z0-9_]+)/i);
                return isMssqlDb(dbMatch ? dbMatch[1].toLowerCase() : '') ? 'mssql' : 'oracle';
            }
        }
        if (typeof cm.getTextArea === 'function' && cm.getTextArea() === document.getElementById('subquerySql')) {
            return isMssqlDb(String($('#subqueryDb').val() || '').toLowerCase()) ? 'mssql' : 'oracle';
        }
        return detectCurrentDbType();
    }

    // --- NEW: Shared HTML Link Item Definition ---
    const htmlLinkItem = {
        text: '@@HTML Link',
        displayText: '@@HTML [value becomes clickable filter]',
        className: 'cm-hint-keyword',
        hint: function (cm, data, completion) {
            // 1. Initial positions
            let from = data.from;
            const to = data.to;

            // 2. Get text being replaced
            let textToReplace = cm.getRange(from, to).trim();

            // 3. Handle trailing comma
            let hasComma = false;
            if (textToReplace.endsWith(',')) {
                hasComma = true;
                textToReplace = textToReplace.slice(0, -1).trim();
            }

            // 3b. Existing COLUMN alias inside the selection
            // (e.g. user selected `p.LOG_DATE AS EVENT_DATE`, `LOG_DATE "Event Date"`,
            // or MS-SQL `f.email AS [Email]`). Capture it so the rewrite keeps it
            // instead of appending a second `AS rawCol` (double alias = invalid SQL).
            let existingAlias = null;      // alias token as written (may be "quoted" or [bracketed])
            let aliasInSelection = false;
            const inlineMatch = textToReplace.match(/^(.*\S)\s+AS\s+("[^"]+"|\[[^\]]+\]|[A-Za-z0-9_$#]+)$/i)
                || textToReplace.match(/^(.*\S)\s+("[^"]+"|\[[^\]]+\])$/);
            if (inlineMatch) {
                existingAlias = inlineMatch[2];
                aliasInSelection = true;
                textToReplace = inlineMatch[1].trim();
            }

            let fullRef = textToReplace;
            let rawCol = textToReplace;

            // 4. Robust Table-Alias Detection & Range Adjustment
            if (textToReplace.includes('.')) {
                // Case A: Selection already includes table alias (e.g. "p.LOG_DATE")
                const parts = textToReplace.split('.');
                rawCol = parts[1];
            } else {
                // Case B: Cursor is after dot (e.g. "p.|LOG_DATE")
                // Look backward to find "p." and move 'from' back to include it
                const lineText = cm.getLine(from.line);
                const textBefore = lineText.slice(0, from.ch);
                const match = textBefore.match(/([a-zA-Z0-9_]+)\.$/);

                if (match) {
                    from = CodeMirror.Pos(from.line, from.ch - match[0].length);
                    fullRef = match[1] + '.' + textToReplace;
                }
            }

            // 4b. Existing COLUMN alias right AFTER the selection
            // (e.g. double-clicked LOG_DATE in `p.LOG_DATE AS EVENT_DATE,`).
            // The alias text stays in the document untouched, so nothing extra
            // is appended. Skipped when the selection ended with a comma - the
            // item is complete and anything after belongs to the next column.
            if (!existingAlias && !hasComma) {
                const afterText = cm.getLine(to.line).slice(to.ch);
                const afterMatch = afterText.match(/^\s+AS\s+("[^"]+"|\[[^\]]+\]|[A-Za-z0-9_$#]+)/i) // explicit AS alias
                    || afterText.match(/^\s+("[^"]+"|\[[^\]]+\])/)                                   // bare "Quoted" / MS-SQL [Bracketed] alias
                    || afterText.match(/^\s+([A-Za-z_][A-Za-z0-9_$#]*)\s*(?=,|--|$)/);               // bare alias word ending the item
                if (afterMatch) {
                    const tok = afterMatch[1];
                    // Keyword veto only applies to the ambiguous bare-word form;
                    // explicit AS and quoted/bracketed aliases are unambiguous.
                    const isBareWord = tok.charAt(0) !== '"' && tok.charAt(0) !== '[' && !/^\s+AS\s/i.test(afterMatch[0]);
                    const RESERVED = /^(FROM|WHERE|GROUP|ORDER|HAVING|UNION|MINUS|INTERSECT|JOIN|INNER|LEFT|RIGHT|FULL|CROSS|OUTER|ON|USING|AND|OR|NOT|IN|IS|NULL|LIKE|BETWEEN|ASC|DESC|CASE|WHEN|THEN|ELSE|END|OVER|BY|CONNECT|START|WITH|AS|SELECT|DISTINCT|INTO|VALUES|SET|FETCH|OFFSET|ROWNUM)$/i;
                    if (!isBareWord || !RESERVED.test(tok)) {
                        existingAlias = tok;
                    }
                }
            }

            // 5. Generate SQL. The click-to-filter search matches on the
            // DISPLAYED column header, which is the alias when one exists -
            // so the data-search target must be the alias, not the raw column.
            const searchName = existingAlias ? existingAlias.replace(/^["\[]|["\]]$/g, '') : rawCol;
            // Simple names go in bare (existing behavior); names with spaces or
            // specials are single-quoted for the search parser - written as ''
            // because they sit inside a SQL string literal.
            const searchColSql = /^[A-Za-z0-9_$#]+$/.test(searchName)
                ? searchName
                : "''" + searchName.replace(/['"]/g, '') + "''";

            // Oracle concatenates with ||; MS-SQL (PINS/InfoEd scopes) has no
            // || operator, so use CONCAT() there - unlike +, it also converts
            // numeric/date columns to strings and doesn't NULL-out the row.
            const dialect = dialectForHintScope(cm, from);
            let sql = dialect === 'mssql'
                ? `CONCAT('@@HTML<a href="#" data-search="${searchColSql} = //', ${fullRef}, '//">', ${fullRef}, '</a>')`
                : `'@@HTML<a href="#" data-search="${searchColSql} = //' || ${fullRef} || '//">' || ${fullRef} || '</a>'`;
            if (aliasInSelection) {
                sql += ` AS ${existingAlias}`;   // alias was inside the replaced range - re-emit it
            } else if (!existingAlias) {
                sql += ` AS ${rawCol}`;          // no alias anywhere - add the default one
            }
            // (alias sits after the selection: leave the document's own alias in place)
            if (hasComma) sql += ',';

            // 6. Replace (Overwriting the table-alias prefix if it existed)
            cm.replaceRange(sql, from, to);

            // 7. Show Success Toast
            const aliasNote = existingAlias ? ` (kept alias <strong>${escapeHtml(searchName)}</strong>; the link filters on it)` : '';
            show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Column <strong>${escapeHtml(rawCol)}</strong> is now a filter link${aliasNote}: (CTRL+Z) to undo, (F9) to re-run the query to test it.</p>`, 6000);
        }
    };

    /**
     * The single, master autocomplete helper function.
     * V24: FIXED SELECTION BLOCKER.
     * 1. CRITICAL: supportsSelection = true allow CM to run this when text is selected.
     * 2. Logic: Removes selected text from context so you get suggestions for what you are typing over.
