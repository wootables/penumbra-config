        // Filter params ride only when set, so an older cached PHP (or a stale
        // client/server pair mid-deploy) behaves exactly as before.
        var auditReq = { id: shortId, limit: _auditLogLimit };
        if (_auditFilters.fam !== 'all') auditReq.fam = _auditFilters.fam;
        if (_auditFilters.q !== '') auditReq.q = _auditFilters.q;
