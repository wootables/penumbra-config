        if (added > CS_LOAD_WARN_AT && !confirm(col + ' has ' + added + ' more distinct values.\n\n' +
                'Adding them all makes a very long list to order by hand, and the dialog will be slow. Add them anyway?')) {
            return;
        }
        _csListSource = 'data';
        renderCSValuesList(values);
        $('#csPresetSelect').val('');
        show_text('Added ' + added + ' value' + (added === 1 ? '' : 's') + ' from the data.');
    });

    // Event: Clear the whole list (the affordance "Load from Data" used to be,
    // back when it replaced instead of appending).
    $(document).on('click', '#csClearValuesBtn', function() {
        var n = getCSValuesFromList().length;
