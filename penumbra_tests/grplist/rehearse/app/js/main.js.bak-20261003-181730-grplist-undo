    // task, the unsaved-changes guard, delete event, all of them. Route the
    // dialog to the window that actually holds the user's attention instead.
    // Installed on mount, removed on restore; the routers consult _admPip at
    // CALL time, so they are inert the moment restore clears it.
    function _pipInstallDialogRouting() {
        if (_admPip._dlgOrig) return;
        var orig = { confirm: window.confirm, alert: window.alert, prompt: window.prompt };
        _admPip._dlgOrig = orig;
        $.each(['confirm', 'alert', 'prompt'], function (i, kind) {
            window[kind] = function (a, b) {
                var w = _admPip.win;
                if (_admPip.active && w && !w.closed) {
                    var routeToPip = false;
                    // Pop-out has OS focus (the triggering interaction happened
                    // there), or the main tab is hidden (a dialog there would be
                    // invisible AND still block both windows).
                    try {
                        routeToPip = w.document.hasFocus() || document.visibilityState === 'hidden';
                    } catch (err) { }
                    if (routeToPip) {
                        try { return w[kind](a, b); } catch (err) { /* fall through to main */ }
                    }
                }
                return orig[kind].call(window, a, b);
            };
        });
    }
    function _pipRemoveDialogRouting() {
        var orig = _admPip._dlgOrig;
        if (!orig) return;
        _admPip._dlgOrig = null;
        window.confirm = orig.confirm;
        window.alert = orig.alert;
        window.prompt = orig.prompt;
    }

    // ---------------------------------------------------------------------
    // Console-owned dialogs
    // ---------------------------------------------------------------------
    // These lightboxes can ONLY be opened from the console (their triggers all
    // live inside #admWrapper, and the CTRL+O / CTRL+S hotkeys just .click()
    // those same buttons). While the console is popped out they therefore belong
    // in its window - opening them in the tab put them on the monitor the user
    // had just moved away from.
    //
    // WHY MOVED AS A SET ON MOUNT, not intercepted per open: every dialog opens
    // with `.css('display','flex').hide().fadeIn()`, so a display-watching
    // observer reads a single open as open -> close -> open and would move the
    // node three times mid-animation. The nodes are display:none until opened,
    // so parking them in the pop-out for the duration costs nothing and there is
    // no open path left to miss - including ones that chain from another dialog
    // (Manage Local Data -> Edit JSON).
    //
    // DELIBERATELY NOT HERE: dialogs reachable from the report toolbar AS WELL
    // as the console - Help Center, Manage Snapshots and its children, Search
    // Builder, Version History, the Pause Scheduler modal. Those need a per-open
    // decision based on which document the trigger lives in; moving them
    // unconditionally would drop a report-side dialog on the other monitor.
    var PNB_CONSOLE_DIALOGS = [
        '#openReportListLightbox',   // Server Repository   - #openReportListBtn, CTRL+O
        '#saveStateLightbox',        // Save dialog         - #saveQuery, CTRL+S
        '#manageDataLightbox',       // Local Data Manager  - #manageDataBtn
        '#promptGeneratorLightbox',  // Tag Generator       - #promptGeneratorIcon
        '#jsonStateEditorLightbox'   // Edit State (JSON)   - opened FROM Manage Local Data
    ];

    function _pipMoveConsoleDialogs(pipDoc) {
        _admPip.dialogHomes = [];
        for (var i = 0; i < PNB_CONSOLE_DIALOGS.length; i++) {
            // Missing is normal, not an error: #openReportListLightbox is
            // global-admin only and #saveStateLightbox/#manageDataLightbox are
            // gated on $canEditLoadedReport, so a viewer's DOM has neither.
            var el = document.querySelector(PNB_CONSOLE_DIALOGS[i]);
            if (!el || !el.parentNode) continue;
            var mark = document.createComment('pnb-dialog-home:' + PNB_CONSOLE_DIALOGS[i]);
            el.parentNode.insertBefore(mark, el);
            pipDoc.body.appendChild(el);   // appendChild auto-adopts across documents
            _pipRetargetUiWidgets(el, pipDoc);
            _admPip.dialogHomes.push({ el: el, mark: mark });
        }
    }

    function _pipReturnConsoleDialogs() {
        var homes = _admPip.dialogHomes || [];
        _admPip.dialogHomes = [];
        for (var i = 0; i < homes.length; i++) {
            var h = homes[i];
            try {
                if (h.mark && h.mark.parentNode) h.mark.parentNode.insertBefore(h.el, h.mark);
                else document.body.appendChild(h.el);   // marker lost - anywhere in body will do
                _pipRetargetUiWidgets(h.el, document);
            } catch (err) { }
            if (h.mark && h.mark.parentNode) {
                try { h.mark.parentNode.removeChild(h.mark); } catch (err) { }
            }
        }
    }

    // ---------------------------------------------------------------------
    // Shared dialogs - hosted per OPEN, not parked at mount
    // ---------------------------------------------------------------------
    // These are reachable from the report toolbar AND from the console, so
    // unlike PNB_CONSOLE_DIALOGS there is no correct answer at mount time: the
    // right window is wherever the user opened it FROM. Each opener calls
    // window._pnbHostDialog(sel) first.
    //
    // Grouped because a child dialog must never end up in a different window
    // from the parent that spawns it (New Snapshot / column sync / filter sync
    // all open from the snapshot manager).
    var PNB_SHARED_DIALOG_GROUPS = [
        ['#helpCenterLightbox'],
        ['#customSortOrderLightbox'],
        ['#versionHistoryLightbox'],
        ['#searchBuilderLightbox'],
        ['#manageSnapshotsLightbox', '#createSnapshotLightbox', '#snapColumnSyncLightbox', '#snapFilterSyncLightbox']
    ];

    function _pnbDialogGroupFor(sel) {
        for (var i = 0; i < PNB_SHARED_DIALOG_GROUPS.length; i++) {
            if (PNB_SHARED_DIALOG_GROUPS[i].indexOf(sel) !== -1) return PNB_SHARED_DIALOG_GROUPS[i];
        }
        return [sel];
    }

    // Move one dialog into `doc`, keeping _admPip.dialogHomes accurate so the
    // return-to-tab sweep still finds everything. Reuses the same marker scheme
    // as the mount-time move, so a dialog hosted mid-session lands back in its
    // exact authored position.
    function _pnbMoveDialogTo(sel, doc) {
        var p = window._admPip;
        var el = document.querySelector(sel);
        if (!el && p && p.win) { try { el = p.win.document.querySelector(sel); } catch (err) { el = null; } }
        if (!el || el.ownerDocument === doc) return;

        var homes = (p && p.dialogHomes) || [];
        for (var i = 0; i < homes.length; i++) {
            if (homes[i].el !== el) continue;
            // Tracked => it is in the pop-out and is being sent home.
            if (doc === document) {
                var mk = homes[i].mark;
                if (mk && mk.parentNode) {
                    mk.parentNode.insertBefore(el, mk);
                    try { mk.parentNode.removeChild(mk); } catch (err) { }
                } else {
                    document.body.appendChild(el);
                }
                homes.splice(i, 1);
                _pipRetargetUiWidgets(el, document);
            }
            return;
        }
        if (doc === document) return;   // untracked and already in the tab

        var mark = document.createComment('pnb-dialog-home:' + sel);
        el.parentNode.insertBefore(mark, el);
        doc.body.appendChild(el);
        _pipRetargetUiWidgets(el, doc);
        if (p) p.dialogHomes.push({ el: el, mark: mark });
    }

    // Put a shared dialog (and its group) in the window that currently holds the
    // user's attention, and return that document. Docked, or popped out with the
    // report side in use, that is always the tab. Same focus test as the
    // confirm()/alert()/prompt() routers and _pnbModalHost.
    window._pnbHostDialog = function (sel) {
        var p = window._admPip;
        var target = document;
        if (p && p.active && p.win && !p.win.closed) {
            try {
                if (p.win.document.hasFocus() || document.visibilityState === 'hidden') target = p.win.document;
            } catch (err) { target = document; }
        }
        var group = _pnbDialogGroupFor(sel);
        for (var i = 0; i < group.length; i++) _pnbMoveDialogTo(group[i], target);
        return target;
    };

    // The toast dock is a single #action_overlay in the main document, so every
    // "Report saved" / "Task deleted" confirmation a console action raises would
    // land in the window the user was not looking at. Give the pop-out its own
    // dock; show_text() then picks a side per call (see _pnbToastEls).
    function _pipInstallToastHost(pipDoc) {
        var src = document.getElementById('action_overlay');
        if (!src || pipDoc.getElementById('action_overlay')) return;
        // Fresh empty dock, NOT a deep clone: cards are runtime state (the old
        // strip-clone carried whatever toast happened to be up at pop-out time,
        // showing a stale message in the new window). Close/hover handlers and
        // the countdown loop attach lazily on first use - see _pnbToastDockState.
        var dock = pipDoc.createElement('div');
        dock.id = 'action_overlay';
        dock.className = src.className || 'pnb-toast-dock';
        var pill = pipDoc.createElement('span');
        pill.className = 'pnb-toast-more';
        pill.hidden = true;
        dock.appendChild(pill);
        pipDoc.body.appendChild(dock);
    }

    function _pipRemoveToastHost(pipWin) {
        if (!pipWin) return;
        try {
            var el = pipWin.document ? pipWin.document.getElementById('action_overlay') : null;
            if (el && el.parentNode) el.parentNode.removeChild(el);
        } catch (err) { }
    }

    // NOTE (2026-07-16): popOutAdminConsole() - the Document Picture-in-Picture
    // container - was REMOVED here. Its only unique power was floating above OTHER
    // APPLICATIONS, and both real workflows are already covered without it:
    //   report on another screen -> "Open in Window": no on-top needed, and it can
    //       FILL the monitor, which PiP never could (Chrome clamps it to ~30%).
    //   report on the same screen -> "Undock Window": already floats over the
    //       report AND supports the opacity slider, which PiP can never do (OS
    //       windows have no web-exposed transparency).
    // So PiP was strictly worse at both jobs - the outlier. (User call.)
    //
    // EVERYTHING BELOW STAYS AND IS STILL LOAD-BEARING. The move-the-node engine
    // (_mountConsoleIn + _pipCopyStyles / _pipMirrorClasses / _pipForwardEvents /
    // _pipRetargetUiWidgets / _pipSyncInnerHeight, the jQuery lookup + find shims,
    // _pnbById / _pnbBodyFor / _pnbPipDoc, and the codemirror.min.js
    // PENUMBRA-PIP-FOCUS patch) all exist because the console is MOVED INTO ANOTHER
    // DOCUMENT - which the window container does every bit as much as PiP did.
    // The "pip" in those names is now historical. They are deliberately NOT
    // renamed: js/codemirror.min.js is patched against window._pnbPipDoc BY NAME,
    // so renaming means re-patching a vendor file for cosmetics. See vendor_patches.

    /**
     * The OTHER container: a plain window.open() window instead of a PiP.
     *
     * WHY BOTH. The move-the-node engine below is container-agnostic - every
     * shim (_pnbById, _pnbCmWin, _pnbPipDoc, the jQuery lookup/find shims, event
     * forwarding, UI-widget retarget) keys off _admPip.win and does not care what
     * KIND of window that is. So the two openers differ only in how the window is
     * made; _mountConsoleIn() does everything else for both.
     *
     * The trade, measured:
     *   PiP    - always-on-top, no chrome, but Chrome CLAMPS the size request to
     *            ~30% of the work area (~59% reachable only by dragging). Cannot
     *            fill a monitor.
     *   window - ANY size, maximizable, multi-monitor; costs a URL strip, is not
     *            always-on-top, and must be closed when the opener unloads.
     * On a second monitor always-on-top is worthless and size is everything,
     * which is exactly what this mode is for.
     */
    function popOutAdminWindow() {
        if (_admPip.win) { try { _admPip.win.focus(); } catch (err) { } return; }
        if (!document.getElementById('admWrapper')) { return; }
        if (isAdminFloating) { $('#toggleDockBtn').click(); }

        // Unlike requestWindow(), this size is GRANTED - no clamp. Ask for most
        // of the current screen; the user drags/maximizes onto the other monitor
        // from there. 'popup=yes' drops the tab strip and toolbar (a URL strip
        // remains - Chrome will not surrender that, and it is the honest cost of
        // this mode). No spaces are allowed in the features string.
        var w = Math.round(screen.availWidth * 0.9);
        var h = Math.round(screen.availHeight * 0.9);
        var feats = 'popup=yes,width=' + w + ',height=' + h +
            ',left=' + Math.round((screen.availWidth - w) / 2) +
            ',top=' + Math.round((screen.availHeight - h) / 2) +
            ',resizable=yes,scrollbars=yes';

        // '' (about:blank) inherits this page's origin AND base URL, so the
        // console's relative asset URLs and hash anchors behave as they do in the
        // PiP. A named target means a second click re-focuses the same window
        // rather than spawning another.
        var win = null;
        try { win = window.open('', 'penumbraAdminConsole', feats); } catch (err) { win = null; }
        if (!win) {
            show_text("<p id='undo_text'><span style='color: salmon'>POP OUT FAILED:</span> the browser blocked the window. Allow pop-ups for this site and try again.</p>", 3500);
            return;
        }

        // about:blank is normally parsed by the time open() returns, but a body
        // is load-bearing here (we append the console into it) - so wait a frame
        // if the document has not settled rather than throwing.
        var tries = 0;
        (function waitForBody() {
            if (win.closed) { return; }
            if (!win.document || !win.document.body) {
                if (++tries > 40) {
                    show_text("<p id='undo_text'><span style='color: salmon'>POP OUT FAILED:</span> the window never finished opening.</p>", 3000);
                    try { win.close(); } catch (err) { }
                    return;
                }
                setTimeout(waitForBody, 25);
                return;
            }
            _mountConsoleIn(win);
        })();
    }

    /**
     * Move the console into `targetWin` and wire it up.
     *
     * Deliberately still takes ANY window and touches nothing PiP-specific: this
     * is the move-the-node engine, and it was container-agnostic even when there
     * were two of them. If a second container is ever wanted again (a PiP, an
     * iframe, whatever), it only has to produce a window and call this.
     */
    function _mountConsoleIn(pipWin) {
            var pipDoc = pipWin.document;
            pipDoc.title = 'Penumbra — Admin Console';

            // Compact Mode is counter-productive in a pop-out (the window
            // itself is the size control), so unwind it while still docked,
            // remember it for re-dock, and lock the checkbox below.
            var $compact = $('#toggleCompactMode');
            _admPip.wasCompact = $compact.is(':checked');
            if (_admPip.wasCompact) $compact.prop('checked', false).trigger('change');

            _pipCopyStyles(pipDoc);
            _pipMirrorClasses(pipDoc);
            // _pipCopyStyles snapshots the head as it is right now; the Custom
            // Code panel's sheet is lazy and may arrive later (or have arrived
            // via a path this snapshot raced). Re-assert it against the new doc.
            try { window.Penumbra.ensureSnipHelpCss(pipDoc); } catch (err) { /* non-fatal */ }

            // PiP-only layout: the console fills the window and scrolls inside.
            // The second half mirrors the floating-dialog editor-fill rules from
            // main.css (scoped there under .ui-dialog-content, which the PiP
            // wrapper doesn't have): editors flex-fill the window instead of
            // keeping their fixed 400px height. Compact mode opts out, same as
            // floating.
            var layout = pipDoc.createElement('style');
            layout.textContent =
                // max-width is LOAD-BEARING here. main.css gives `body` a
                // `max-width:90%; margin:auto` page gutter (and density-compact
                // narrows it to 96%). The margin:0 below kills the auto-centering
                // but the cap survived, so the console rendered 90% wide AND
                // jammed left - the worst of both. A console window is all
                // editor: fill it edge to edge.
                'html,body{width:100%!important;max-width:none!important;height:100%!important;margin:0!important;padding:0!important;overflow:hidden!important}' +
                '#admWrapper{display:block!important;width:100%!important;height:100%!important;max-height:none!important;' +
                'margin:0!important;border:none!important;border-radius:0!important;box-sizing:border-box!important;' +
                'overflow:auto!important;opacity:1!important}' +
                '#editorTabs{min-height:0}' +
                '#admWrapper:not(.compact-admin-mode) #editorTabs{overflow:hidden}' +
                // Panel overflow auto + low editor floor, NOT hidden + 80px:
                // in a short PiP window a hidden panel clips the editors'
                // bottom lines out of scroll reach (CodeMirror only scrolls
                // its own wrapper). Mirrors the floating-dialog fix in main.css.
                '#admWrapper:not(.compact-admin-mode) .ui-tabs-panel{overflow:auto!important}' +
                '#admWrapper:not(.compact-admin-mode) #sql-editor-tab .CodeMirror,' +
                '#admWrapper:not(.compact-admin-mode) #report-options-tab .CodeMirror{' +
                'height:0!important;flex:1 1 0%;min-height:40px;min-width:0;width:100%;max-width:100%}' +
                '#admWrapper:not(.compact-admin-mode) #sql-editor-tab .CodeMirror-scroll,' +
                '#admWrapper:not(.compact-admin-mode) #report-options-tab .CodeMirror-scroll{' +
                'max-height:none!important;overflow-y:auto!important;overflow-x:auto!important}' +
                // Console-owned dialogs live in THIS document now (see
                // PNB_CONSOLE_DIALOGS) and they carry fixed widths authored for a
                // full browser window - 1050px (save), 1200px (manage data),
                // 1000px (repository). This window is whatever size the user
                // dragged it to, so clamp them to it rather than letting the
                // content overflow a window that cannot scroll (html/body are
                // overflow:hidden above).
                '.help-lightbox > .lightbox-content{max-width:96vw!important;max-height:94vh!important}';
            pipDoc.head.appendChild(layout);

            // Track theme/density changes made in the main tab while popped out.
            _admPip.classObserver = new MutationObserver(function () { _pipMirrorClasses(pipDoc); });
            _admPip.classObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style'] });
            _admPip.classObserver.observe(document.body, { attributes: true, attributeFilter: ['class', 'style'] });

            // Move the REAL node (appendChild auto-adopts across documents),
            // leaving a marker so restore() can put it back exactly where it was.
            var wrapperEl = document.getElementById('admWrapper');
            _pipCloseTooltips(wrapperEl);   // or they are stranded in the tab
            _admPip.home = document.createComment('admWrapper-home');
            wrapperEl.parentNode.insertBefore(_admPip.home, wrapperEl);
            pipDoc.body.appendChild(wrapperEl);
            $(wrapperEl).css({ display: 'block', opacity: '' });
            _pipRetargetUiWidgets(wrapperEl, pipDoc);

            _admPip.win = pipWin;
            _admPip.active = true;
            $('body').addClass('admin-pip-active');

            // -- Controls that make no sense while popped out --
            try { $('#admin-opacity-slider').slider('disable'); } catch (err) { }
            $compact.prop('disabled', true).closest('label')
                .css({ opacity: 0.35, cursor: 'not-allowed' })
                .attr('title', 'Compact Mode is unavailable while popped out - the window itself is the size control');
            var $fixedBtn = $('#toggleFixedEditorBtn');
            var wasDynamic = $('body').hasClass('dynamic-editor-mode');
            $fixedBtn.data('wasDynamicBeforeFloat', wasDynamic);
            if (wasDynamic) {
                $fixedBtn.data('_skipSave', true);
                $fixedBtn.click(); // fixed height while the window controls sizing
            }
            $fixedBtn.prop('disabled', true)
                .css({ opacity: 0.35, cursor: 'not-allowed' })
                .attr('title', 'Editor height is controlled by the window size while popped out.');
            $('#toggleDockBtn').prop('disabled', true)
                .css({ opacity: 0.35, cursor: 'not-allowed' })
                .attr('title', 'Return to the tab first (Esc)');
            $('#popOutWindowBtn').html('<span class="icon">⬇</span> Return to Tab')
                .attr('title', '(Esc) Move the Admin Console back into the browser tab');
            // Main page reflows now that the console left the layout.
            if (typeof updateContainerHeight === 'function') updateContainerHeight();
            if (typeof updateStickyHeaderOffset === 'function') updateStickyHeaderOffset();
            if (typeof updateStickyColumnLayout === 'function') updateStickyColumnLayout();
            $(window).trigger('resize');

            // Initial sizing + follow the PiP window if the user drag-resizes
            // it via the OS window edges (no in-app resize controls).
            _pipSyncInnerHeight();
            setTimeout(function () {
                _pipSyncInnerHeight();
                // AFTER the sync above: the rail's height comes from
                // #admin-flex-container, so rebuilding any earlier would size the
                // charts against a container that hasn't been laid out yet.
                _reRenderAuditRailCharts();
            }, 80);
            pipWin.addEventListener('resize', _pipSyncInnerHeight);

            // Hash-href anchors inside the PiP must never fire their NATIVE
            // navigation: the pip document's base URL differs from the app
            // page's, and Chrome redirects pip-window navigations into a NEW
            // window (observed: cycling the editor tabs spawned index.php in
            // a fresh window). jQuery-bound handlers still run - tabs still
            // switch - this only cancels the browser's follow-the-link.
            pipDoc.addEventListener('click', function (ev) {
                var a = ev.target && ev.target.closest ? ev.target.closest('a') : null;
                if (a) {
                    var href = a.getAttribute('href');
                    if (href && href.charAt(0) === '#') ev.preventDefault();
                }
            }, true);

            // Esc inside the PiP window: dismiss an open autocomplete first
            // (same rule as the main-window handler), otherwise return home.
            pipDoc.addEventListener('keydown', function (e) {
                // Enter in the Save dialog, which now lives in THIS document.
                // Shares the main handler's implementation (see the comment on
                // _pnbHandleSaveEnter) rather than duplicating its pass-throughs.
                if (e.key === 'Enter' && _pnbHandleSaveEnter(e)) return;
                if (e.key === 'Escape') {
                    // Same modifier pass-through as the main-window handler:
                    // Shift+Esc is Chrome's Task Manager shortcut.
                    if (e.shiftKey || e.ctrlKey || e.altKey || e.metaKey) return;
                    if (window._dismissOpenAutocomplete && window._dismissOpenAutocomplete()) {
                        e.preventDefault();
                        e.stopPropagation();
                        return;
                    }
                    e.preventDefault();
                    e.stopPropagation();
                    // Console-owned dialogs live in THIS document now
                    // (PNB_CONSOLE_DIALOGS), so Escape must close the open dialog
                    // first and pull the console home only when nothing is open.
                    // Don't reimplement that precedence here - the main window's
                    // Escape handler owns it, and it is a NATIVE capture listener
                    // on the MAIN document, so _pipForwardEvents (which replays
                    // through jQuery's dispatch) never reaches it. Replay the key
                    // onto the main document instead and let the one handler run:
                    // its sections A-C close the topmost overlay (cross-document
                    // aware via _pnbAll) and its section D0 restores the console
                    // when there is none. keyCode/which are readonly on a
                    // synthetic KeyboardEvent - that handler tests e.key.
                    var replayed = false;
                    try {
                        document.dispatchEvent(new KeyboardEvent('keydown', {
                            key: 'Escape', code: 'Escape', bubbles: true, cancelable: true
                        }));
                        replayed = true;
                    } catch (err) { }
                    if (!replayed) restoreAdminFromPip(true);
                }
            }, true);

            _pipForwardEvents(pipDoc);
            _pipInstallDialogRouting();
            _pipMoveConsoleDialogs(pipDoc);
            _pipInstallToastHost(pipDoc);
            // Modal focus management (trigger tracking + the Tab trap) is bound
            // per document with NATIVE listeners, which are not forwarded.
            try { if (window._pnbA11yAttach) window._pnbA11yAttach(pipDoc); } catch (err) { }

            // Native close (the X, "back to tab", or browser cleanup) - put
            // everything back. Guarded: restore() also closes the window.
            pipWin.addEventListener('pagehide', function () {
                if (_admPip.active) restoreAdminFromPip(true);
            });

            show_text("<p id='undo_text'><span style='color: lightgreen'>ADMIN MODE:</span> Popped Out</p>", 1500);

            setTimeout(function () {
                if (editor) editor.refresh();
                if (snippetEditor) snippetEditor.refresh();
            }, 120);

        // Unlike a PiP window, a normal window does NOT die with its opener. If
        // the tab navigates away or reloads, the console node would live on in an
        // orphaned window with no main.js driving it - a dead console the user has
        // to hunt down and close. Take it with us.
        $(window).off('pagehide.pnbConsoleWin').on('pagehide.pnbConsoleWin', function () {
            try { if (_admPip.win) { _admPip.win.close(); } } catch (err) { }
        });
    }

    function restoreAdminFromPip(show) {
        var pipWin = _admPip.win;
        if (!pipWin) return;
        // Clear state FIRST: toggleSmartAdminView() and the compact handler
        // consult it, and the pagehide callback must find it already inactive.
        _admPip.win = null;
        _admPip.active = false;
        if (_admPip.classObserver) {
            try { _admPip.classObserver.disconnect(); } catch (err) { }
            _admPip.classObserver = null;
        }
        _pipRemoveDialogRouting();
        // Console-owned dialogs come home too. A dialog left OPEN in the pop-out
        // is moved back still visible rather than closed: the console it belongs
        // to is landing in the tab at the same moment, so silently discarding
        // half-entered save/tag state would be the surprising outcome.
        _pipReturnConsoleDialogs();
        _pipRemoveToastHost(pipWin);

        // Move the node back to its marked home (adopts back into this document).
        try {
            var wrapperEl = pipWin.document ? pipWin.document.getElementById('admWrapper') : null;
