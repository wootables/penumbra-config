    //  re-renders it behind a circuit breaker.
    //
    //  Height stays PIXELS (that is the vis() contract - a % height degrades
    //  to px by design), so "ratio" is expressed as a fraction of the width
    //  the chart will actually occupy, clamped so it stays readable at both
    //  extremes. That is what makes it screen-size aware: the same chart is
    //  ~300px tall on a laptop and ~500px on a wide monitor, rather than
    //  180px on both.
    //
    //  NOTE on 100% width: it is 100% of the space the snippet is given, not
    //  of the page. In the default header layout the snippet sits beside the
    //  report title; Header Layout = Dashboard gives it a full-width line.
    // ════════════════════════════════════════════════════════════════════
    var VIZ_DEFAULT_SHAPE = { r: 0.36, min: 260, max: 520 };
    var VIZ_TYPE_SHAPE = {
        // Category-axis workhorses: wide and shallow reads best, but 0.36 of a
        // 1200px report is 432px, not the old 180.
        bar:       { r: 0.36, min: 260, max: 520 },
        line:      { r: 0.36, min: 260, max: 520 },
        combo:     { r: 0.36, min: 260, max: 520 },
        histogram: { r: 0.36, min: 260, max: 520 },
        waterfall: { r: 0.38, min: 280, max: 520 },
        box:       { r: 0.38, min: 280, max: 520 },
        // Horizontal-bar families need vertical room per category.
        butterfly: { r: 0.42, min: 300, max: 580 },
        funnel:    { r: 0.42, min: 300, max: 560 },
        gantt:     { r: 0.42, min: 300, max: 600 },
        // Area-filling types earn their height.
        treemap:   { r: 0.45, min: 300, max: 600 },
        scatter:   { r: 0.42, min: 280, max: 560 },
        // Circular: the disc is bounded by the SHORTER side, so height is what
        // actually sizes it. Taller floor than the plotted types for that
        // reason - a 260px pie is a coin.
        pie:       { r: 0.42, min: 320, max: 520 },
        doughnut:  { r: 0.42, min: 320, max: 520 },
        radar:     { r: 0.42, min: 320, max: 520 },
        // Maps letterbox into their box, so this only has to be a sane shape.
        // 0.52 suits all four kinds (us-grid 1.38, us-outline 1.65,
        // nc-counties 2.62, world 2.28 aspect).
        map:       { r: 0.52, min: 320, max: 640 },
        // One dial / one bar against a track: these are genuinely short, and
        // giving them a plotted chart's height just adds empty space.
        gauge:     { r: 0.24, min: 200, max: 340 },
        bullet:    { r: 0.26, min: 200, max: 380 }
