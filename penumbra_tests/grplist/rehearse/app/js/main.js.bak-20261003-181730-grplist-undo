                return;
            const action = $(this).data('action');
            menu.remove();

            // --- 1. Handle Standard Actions ---
            if (action === 'delete-favorite' || action.startsWith('copy-') || action === 'open-state' || action === 'open-new' || action === 'view-audit-log') {
                handleFavoriteAction(action, triggerElement, e);
                return;
            }

            // --- 2. Handle Table Specific Actions ---
            if (fullData.type === 'table') {
                handleTableAction(action, triggerElement, e);
            }// --- 3. Handle State Specific Actions ---
            else if (fullData.type === 'state') {
                if (action === 'edit-json') {
                    const itemData = getFavoriteItemData('state', fullData.name);
                    if (itemData)
                        handleEditJsonState(itemData);
                }// --- RENAME LOGIC ---
                else if (action === 'rename-state') {
                    const oldName = fullData.name;
                    let newName = prompt("Enter the new name for this state:", oldName);
                    if (!newName || newName.trim() === '' || newName === oldName)
                        return;
                    newName = newName.trim();

                    let savedQueries = JSON.parse(localStorage.getItem("savedQueries") || "[]");
                    const isDuplicate = savedQueries.some(state => state.name.toLowerCase() === newName.toLowerCase());

                    if (isDuplicate) {
                        alert(`Error: A state named "${newName}" already exists.`);
                        return;
                    }

                    const stateIndex = savedQueries.findIndex(state => state.name === oldName);
                    if (stateIndex > -1) {
                        savedQueries[stateIndex].name = newName;
                        localStorage.setItem("savedQueries", JSON.stringify(savedQueries));

                        // Update Favorites to match
                        let favs = new Set(JSON.parse(localStorage.getItem("penumbra_favorite_states") || "[]"));
                        if (favs.has(oldName)) {
                            favs.delete(oldName);
                            favs.add(newName);
                            localStorage.setItem("penumbra_favorite_states", JSON.stringify(Array.from(favs)));
                        }
                        populateSelectorBox();
                        show_text(`<p id='undo_text'><span style='color: lightgreen'>SUCCESS:</span> Renamed "${oldName}" to "${newName}".</p>`);
                    }
                }// --- DUPLICATE LOGIC ---
                else if (action === 'duplicate-state') {
                    const originalName = fullData.name;
                    let savedQueries = JSON.parse(localStorage.getItem("savedQueries") || "[]");
