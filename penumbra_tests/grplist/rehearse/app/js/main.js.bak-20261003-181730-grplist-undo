        $('#subqueryDialectHint').html(html);
        $('#subqueryDialectWord').text(dialectName(inner));

        // The JSON transport only engages for an Oracle OUTER query (and, for
        // IN lists, only past 1,000 values). Say so up front rather than
        // letting the engine fall back silently at run time.
        const $note = $('#subqueryTransportNote');
        if (getSubqueryTransport() === 'json') {
