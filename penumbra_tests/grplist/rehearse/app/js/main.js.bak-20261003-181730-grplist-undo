        // ============================================================
        // 4. JSON Export (Flat/Grouped) - FIXED LOGIC
        // ============================================================
        if (format === 'json') {
            const jsonData = [];
            $sourceRows.each(function () {
                const $row = $(this);
                const rowObject = {};

                visibleColumnInfo.forEach(header => {
