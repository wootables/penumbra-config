    // --- Crypto Helpers (AES-256-GCM) ---
    async function deriveGcmKey(password, salt) {
        const enc = new TextEncoder();
        const keyMaterial = await window.crypto.subtle.importKey("raw", enc.encode(password), {
            name: "PBKDF2"
        }, false, ["deriveKey"]);
        return window.crypto.subtle.deriveKey({
            name: "PBKDF2",
            salt: salt,
            iterations: 100000,
            hash: "SHA-256"
        }, keyMaterial, {
            name: "AES-GCM",
            length: 256
        }, false, ["encrypt", "decrypt"]);
    }

    async function encryptState(password, plainText) {
        const enc = new TextEncoder();
        const salt = window.crypto.getRandomValues(new Uint8Array(16));
        const iv = window.crypto.getRandomValues(new Uint8Array(12));
        // GCM uses a 12-byte (96-bit) nonce, the size the spec recommends for best performance

        const key = await deriveGcmKey(password, salt);

        // AES-GCM encrypt() output has the 16-byte auth tag appended already
        const encrypted = await window.crypto.subtle.encrypt({
            name: "AES-GCM",
            iv: iv
        }, key, enc.encode(plainText));

        // Pack: Salt(16) + IV(12) + Ciphertext+Tag
        const buffer = new Uint8Array(16 + 12 + encrypted.byteLength);
        buffer.set(salt, 0);
        buffer.set(iv, 16);
        buffer.set(new Uint8Array(encrypted), 28);

        return "PENUMBRA_GCM::" + btoa(String.fromCharCode(...buffer));
    }

    async function decryptState(password, encryptedBase64) {
        const cleanBase64 = encryptedBase64.replace("PENUMBRA_GCM::", "");
        const binaryStr = atob(cleanBase64);
        const bytes = new Uint8Array(binaryStr.length);
        for (let i = 0; i < binaryStr.length; i++)
            bytes[i] = binaryStr.charCodeAt(i);

        // Extract Parts: Salt(16) + IV(12) + Ciphertext+Tag
        const salt = bytes.slice(0, 16);
        const iv = bytes.slice(16, 28);
        const ciphertext = bytes.slice(28);

        const key = await deriveGcmKey(password, salt);

        try {
            const decrypted = await window.crypto.subtle.decrypt({
                name: "AES-GCM",
                iv: iv
            }, key, ciphertext);
            return new TextDecoder().decode(decrypted);
        } catch (e) {
            throw new Error("Incorrect Password or Corrupt Data");
        }
    }

    // --- Snapshot-at-rest codec (AES-256-GCM) ---
    // A snapshot of a password-encrypted report must be stored as ciphertext, not
    // plaintext - otherwise the password gate is bypassable via a direct
    // manage_snapshots.php?action=load call. These wrap the raw SNAP_DATA JSON
    // string with the same scheme used for report state, keyed on the report
    // password retained at unlock (currentReportPassword). Snapshots of
    // non-encrypted reports are left as plaintext JSON, unchanged.
    async function encodeSnapDataForStorage(rawJsonString) {
        if (!currentReportIsEncrypted) return rawJsonString;
        if (!currentReportPassword) {
            throw new Error("Report password unavailable - cannot secure the snapshot. Reload the report, unlock it, and try again.");
        }
        return await encryptState(currentReportPassword, rawJsonString);
    }

    // Returns the plaintext SNAP_DATA JSON string. If the stored value is
    // ciphertext (PENUMBRA_GCM:: prefix), decrypt with the retained report
    // password, prompting (with retry) only if no working password is held.
    async function decodeSnapDataFromStorage(snapData) {
        if (typeof snapData !== 'string' || !snapData.startsWith("PENUMBRA_GCM::")) {
            return snapData; // plaintext snapshot (non-encrypted report) - unchanged
        }
        // Fast path: the currently-loaded report's password (retained at unlock)
        // decrypts its own snapshots with no prompt. On a cross-report load it's
        // the wrong password and throws - fall through to prompt.
        if (currentReportPassword) {
            try {
                return await decryptState(currentReportPassword, snapData);
            } catch (e) { /* wrong report (cross-report) or stale - prompt below */ }
        }
        // Prompt path (cross-report load, or report not unlocked in this view).
        // Two things to get right:
        //  1. requestPassword() intentionally leaves its full-screen overlay up
        //     after resolving (no flicker while the caller verifies the password),
        //     so WE must remove it on every exit - success, cancel, or lockout -
        //     otherwise it covers the decrypted view and Unlock appears to do nothing.
        //  2. Do NOT write the prompted password to currentReportPassword: on a
        //     cross-report load that belongs to a DIFFERENT report, and overwriting
        //     it would mis-key encryption of the loaded report's next snapshot.
        let errorMessage = null;
        try {
            for (let attempt = 0; attempt < 4; attempt++) {
                const pw = await requestPassword(errorMessage);
                if (pw === null) throw new Error("Password required to open this snapshot.");
                try {
                    return await decryptState(pw, snapData);
                } catch (e) {
                    errorMessage = "Incorrect password. Try again.";
                }
            }
            throw new Error("Too many incorrect password attempts.");
        } finally {
            $('#passwordPromptOverlay').remove();
        }
    }

