    /**
     * Inspects a raw SQL query (tags intact) and, if it reads from exactly one
     * table with no joins / subqueries / CTEs / set-operations, returns that
     * table's name (or an imported file's name for a [IMPORT; name=X] source).
     * Returns null for anything that touches more than one source so the
     * auto-title only ever fires for genuine single-table reports.
     */
    function detectSingleTableTitle(rawQuery) {
        if (!rawQuery) return null;

        // Strip SQL comments so keywords inside them don't trip detection.
        var q = String(rawQuery).replace(/--[^\n\r]*/g, ' ').replace(/\/\*[\s\S]*?\*\//g, ' ');

        // Cross-db subquery tags live inside [...]; check before masking.
        if (/\[\s*(?:CTE_)?SUBQUERY/i.test(q)) return null;
        if (/\bWITH\b[\s\S]*?\bAS\b\s*\(/i.test(q)) return null; // common table expression

        // Mask the contents of bracket tags/identifiers (e.g. [IMPORT; name=data
        // from 2024]) so inner keywords or semicolons don't perturb structural
        // parsing below. The real name is recovered from the original query later.
        var masked = q.replace(/\[[^\]]*\]/g, '[]');

        // Set operations mean more than one result set.
        if (/\b(?:UNION|INTERSECT|EXCEPT)\b/i.test(masked)) return null;

        // A derived table or scalar subquery introduces a second FROM.
        if ((masked.match(/\bFROM\b/gi) || []).length !== 1) return null;

        // Capture the FROM clause up to the next top-level clause keyword.
        var fromMatch = masked.match(/\bFROM\b([\s\S]*?)(?:\bWHERE\b|\bGROUP\s+BY\b|\bORDER\s+BY\b|\bHAVING\b|\bLIMIT\b|\bOFFSET\b|\bFETCH\b|\bFOR\b|\bOPTION\b|;|$)/i);
        if (!fromMatch) return null;
        var fromClause = (fromMatch[1] || '').trim();
        if (!fromClause) return null;

        // Joins, comma-lists, or derived tables/functions mean more than one source.
        if (/\bJOIN\b/i.test(fromClause)) return null;
        if (fromClause.indexOf(',') !== -1) return null;
        if (fromClause.indexOf('(') !== -1) return null;

        // Single source confirmed - resolve its display name from the ORIGINAL query.
        // Imported file source: [IMPORT; name=Some Name] -> "Some Name"
        var imp = q.match(/\bFROM\s+\[\s*IMPORT\s*;\s*name\s*=\s*([^\]]+?)\s*\]/i);
        if (imp) return imp[1].trim();

        // Other bracketed identifier: [Table Name] -> Table Name
        if (fromClause.charAt(0) === '[') {
            var br = q.match(/\bFROM\s+\[\s*([^\];]+?)\s*\]/i);
            return br ? br[1].trim() : null;
        }

        // Plain or schema-qualified identifier, returned exactly as written (drop alias).
        var firstToken = fromClause.split(/\s+/)[0];
        if (/^[A-Za-z_#][\w$#.]*$/.test(firstToken)) {
            return firstToken;
        }
        return null;
    }

    /**
     * Auto-names an otherwise-untitled report after the single table it queries.
     * Called from the query-success path once results are confirmed. Admin
