                htmlContent = generateWysiwygHtml($('#resultsTable'), false);
                rowCount = $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)").length;
            }

            return {
                content: htmlContent,
                rowCount: rowCount
            };
        }

        // ============================================================
        // 2. Pivot Mode (CSV & JSON)
        // ============================================================
        if (isPivotMode) {
            if (format === 'csv' || format === 'tsv') {
                const pivotDelim = (format === 'tsv') ? '\t' : ',';
                const csvData = getPivotCsvForCopy(pivotDelim);
                // Post-process to strip @@JSON tags from the raw content if they exist
                const rows = csvData.content.split('\n');
                const processedRows = rows.map(row => {
                    return row.replace(/@@JSON/g, '').replace(/@@HTML/g, '');
                }
                );
                return {
                    content: processedRows.join('\n'),
                    rowCount: csvData.rowCount
                };
            }

            if (format === 'json') {
                const tableArray = getPivotDataAsArray();
                if (tableArray.length < 2)
                    return {
                        content: "[]",
                        rowCount: 0
                    };

                const flatHeaders = getFlatPivotHeaders();
                const headerRowCount = $('#pivotResultTable thead tr').length;
                const footerRowCount = $('#pivotResultTable tfoot tr').length;

                // Slice out body rows (include footer/totals to match CSV/Excel exports)
                const bodyRows = tableArray.slice(headerRowCount);
                const jsonData = [];

                bodyRows.forEach(row => {
                    const rowObject = {};
                    flatHeaders.forEach((header, index) => {
                        let cellVal = row[index] || "";
                        // Parse nested JSON if detected from getPivotDataAsArray
                        if (typeof cellVal === 'string' && cellVal.startsWith('@@JSON')) {
                            try {
                                // Strip prefix and parse to Object/Array
                                var parsedPivotJson = JSON.parse(cellVal.substring(6));
                                // Strip nested @@HTML prefixes and HTML tags
                                if (Array.isArray(parsedPivotJson)) {
                                    parsedPivotJson.forEach(function(obj) {
                                        if (typeof obj === 'object' && obj !== null) {
                                            for (var k in obj) {
                                                if (typeof obj[k] === 'string' && obj[k].substring(0, 6) === '@@HTML') {
                                                    obj[k] = obj[k].substring(6).replace(/<[^>]*>/g, '').trim();
                                                }
                                            }
                                        }
                                    });
                                }
                                rowObject[header] = parsedPivotJson;
                            } catch (e) {
                                // Fallback: Strip the tag but return string
                                rowObject[header] = cellVal.substring(6);
                            }
                        } else {
                            rowObject[header] = cellVal;
                        }
                    }
                    );
                    jsonData.push(rowObject);
                }
                );

                return {
                    content: JSON.stringify(jsonData, null, 2),
                    rowCount: jsonData.length
                };
