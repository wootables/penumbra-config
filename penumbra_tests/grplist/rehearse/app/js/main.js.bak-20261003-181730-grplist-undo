    // Make a saved/removed order visible NOW. The help has always promised the
    // order "takes effect immediately", but nothing ever re-sorted: the comparator
    // is only consulted the next time something sorts, so an already-sorted table
    // just sat there and the feature read as broken.
    function _csApplyToCurrentView(col) {
        if (!col) return;
        var target = String(col).toUpperCase();
        var grouped = $('#groupedResultsContainer').is(':visible');

        // Grouped view: the group HEADER order comes from the grouping comparator,
        // so that needs a rebuild rather than a row re-sort.
        if (grouped && currentGroupingColumn && String(currentGroupingColumn).toUpperCase() === target) {
            var visibleColumnOrder = $('#tableHeader th').filter(function () {
                return this.style.display !== 'none';
            }).map(function () { return $(this).data('column'); }).get();
            rebuildGroupedView(visibleColumnOrder);
            return;
