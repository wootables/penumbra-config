            // one is not yet (`'OAK `). A matched-pair strip would leave the leading quote in
            // the prefix and the autocomplete would never match anything.
            const currentWord = valuePart.replace(/^'|'$/g, '').trim();

            let tableName;
            let columnName;
            const parts = fullColumnIdentifier.split('.');
            if (parts.length > 1) {
