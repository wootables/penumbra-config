        const columnNames = Array.from(firstRow.keys());

        // 3. Regenerate all necessary metadata for other functions to use
        const columnNameToOriginalIndex = {};
        const columnProperties = {};
        const numericRegex = /^[-+]?\$?(\d{1,3}(,?\d{3})*(\.\d+)?|\.\d+)$/;
        const sampleSize = Math.min(masterRowData.length, 100);

        columnNames.forEach((colName, index) => {
            const colId = isSnapshotLoad ? `col_${index}` : index;
            // Use numeric index for live data
            columnNameToOriginalIndex[colName.toUpperCase()] = colId;
            const upperColName = colName.toUpperCase();
            let isNumeric = true
                , isCurrency = true
                , isBoolean = true
                , isDate = true
                , hasValues = false;

            for (let i = 0; i < sampleSize; i++) {
                const val = masterRowData[i].get(colName);
                if (val === null || val === '')
                    continue;
                const valStr = String(val).trim();
                if (valStr === '')
                    continue;

                hasValues = true;
                if (isDate && parseDate(valStr) === null)
                    isDate = false;
                if (isNumeric && !numericRegex.test(valStr))
                    isNumeric = false;
                if (isCurrency && !valStr.includes('$'))
                    isCurrency = false;
                if (isBoolean && !/^(true|false|1|0|yes|no|y|n)$/i.test(valStr))
                    isBoolean = false;
            }

            if (!hasValues)
                isCurrency = false;
            if (isDate || isBoolean) {
                isNumeric = false;
                isCurrency = false;
            }
            if (isCurrency)
                isNumeric = false;

            const isInWhitelist = totalExemptionList.some(part => upperColName.includes(part));
