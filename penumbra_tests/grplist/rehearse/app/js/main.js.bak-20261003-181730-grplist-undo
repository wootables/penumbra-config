    }

    function computeCurrentViewRawSignature() {
        var $rows = $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)");
        if ($rows.length === 0) return '';
        var sigs = [];
        $rows.each(function () {
            var idx = parseInt($(this).find("td[data-column='#']").text(), 10) - 1;
            var rowMap = masterRowData[idx];
            if (rowMap) sigs.push(generateRowSignature(rowMap));
        });
        return sigs.sort().join('');
    }

    // Hash a raw per-row signature string into the compact `SIG_<base36>_<count>`
    // form stored in PENUMBRA_SNAPS.DATA_SIGNATURE (VARCHAR2(200)). This is the
    // SINGLE canonical format for server-snapshot signatures: both the live-view
    // signature and the from-rows signature run through here so every client
    // write path produces an identical, badge-comparable value. (The scheduler's
    // md5 in schedule_runner.php is a DELIBERATELY separate value - it must support
    // change-detection scoped to selected columns, which a whole-row badge
    // signature can't express, so the two intentionally never match. Don't try to
    // "unify" them without splitting the column.)
    function _hashRawSignature(raw, rowCount) {
        if (!raw) return '';
        var h = 0;
        for (var i = 0; i < raw.length; i++) {
            h = ((h << 5) - h) + raw.charCodeAt(i);
            h = h & h;
        }
        return 'SIG_' + Math.abs(h).toString(36) + '_' + rowCount;
    }

    /**
     * Returns the compact hashed data signature (`SIG_<hex>_<count>`) for the current view.
     * Matches the format stored in DB as DATA_SIGNATURE for server snapshots.
     */
    function computeCurrentViewHashedSignature() {
        var raw = computeCurrentViewRawSignature();
        if (!raw) return '';
        // Row count for the suffix - visible (non-search-hidden) rows, matching
        // the set computeCurrentViewRawSignature() hashed.
        var rowCount = $("#resultsTable tbody tr:not(.search-hidden):not(.journal-note-child)").length;
        return _hashRawSignature(raw, rowCount);
    }

    // Compute the same canonical hashed signature from an explicit array of
    // snapshot rows ([{signature?, rowData}, ...]) rather than the live DOM. Used
    // by any save path whose rows are NOT the current view - e.g. copying a local
    // snapshot to the server - so the stored signature describes the snapshot's
    // own data and its "matches current view" dot lights correctly later. Mirrors
    // loadSnapshotData()'s ingestion (keys upper-cased, null/'null' -> '') so the
    // signature equals what the live view would produce if this data were loaded.
    // Normalizes a parsed SNAP_DATA payload to its rows array. Bare arrays pass
    // through; a legacy/external `{_meta, rows}` wrapper (only 2 of the 6 parse
