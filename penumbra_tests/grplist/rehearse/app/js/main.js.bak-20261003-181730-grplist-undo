        // buildVirtualColumnNames() discovered; any other name degrades to a
        // literal condition that silently matches zero rows.
        if (!colName || buildVirtualColumnNames().indexOf(colName.toUpperCase()) === -1)
            return null;

        const value = (sub.textContent || '').trim();
        // Same two value guards as the flat path below.
        if (!value || value.indexOf('//') !== -1)
            return null;
        return { col: colName, value: value };
