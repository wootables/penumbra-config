    // Escape a column name for the scheduler column selectors and give the line
    // breaker somewhere to break. Names like MASTER_RECORD_TOTAL_SPONSOR_COSTS are
    // a single unbreakable "word", so as a grid item they used to size to their own
    // full width and spill over the next column's label (worse for the italic
    // report-hidden ones, which are a shade wider still). A <wbr> after each
    // underscore turns every segment boundary into a soft break, so a long name
    // wraps inside its own cell at a readable point instead of overlapping.
    // The CSS backstop (min-width:0 + overflow-wrap on .sched-col-name) covers
    // names that carry no underscore at all. NB the class is sched-col-name, not
    // the app-wide .sp-col-name - that one is the column chooser's, and it carries
    // white-space:nowrap + text-overflow:ellipsis, the exact opposite of what this
    // needs.
    function colNameBreakHtml(name) {
        return escapeHtml(String(name)).replace(/_/g, '_<wbr>');
    }

    // Populate the DB_DUMP column selector. The list is always shown now (no
    // visible/custom radio). Every column is listed, including ones hidden in
    // the report - those render italic+dimmed (class dbdump-col-hidden) and are
    // unchecked by default; columns currently shown in the report are checked.
    // The CSS rule in main.css applies the grid + label layout to this ID.
    function populateDbDumpColumnSelector() {
        var $sel = $('#schedDbDumpColumnSelector');
        // Snapshot previously checked values so a re-render keeps the user's
        // selection. On a fresh render (selector currently empty) we fall back
        // to the default: check the report's shown columns, leave hidden ones off.
        var hadCheckboxes = $sel.find('input[type=checkbox]').length > 0;
        var prevChecked = {};
        $sel.find('input[type=checkbox]:checked').each(function () { prevChecked[$(this).val()] = true; });

        // Collect every column (including report-hidden ones). A column counts
        // as hidden when its header <th> is display:none in the live table.
        var cols = [];
        $("#tableHeader th[data-colname]").each(function () {
            var name = $(this).data('colname');
            if (!name || name === '#') return;
            // Journal columns (toggles / notes) are report-local UI state, not
            // source data - the dump cannot materialize them (custom mode NULL-
            // fills any column missing from rawData, and 'visible' mode strips
            // toggles for the same reason), so don't offer them at all.
            var up = String(name).toUpperCase();
            if (up.indexOf('__JOURNAL_TOGGLE__') === 0 || up === '__JOURNAL_NOTES') return;
            cols.push({ name: String(name), hidden: (this.style.display === 'none') });
        });
        cols.sort(function (a, b) { return a.name.localeCompare(b.name); });

        $sel.empty();
        if (cols.length === 0) {
            $sel.append('<label>No columns detected - load the report data first, then re-open this task.</label>');
            return;
        }
        cols.forEach(function (col) {
            var up = col.name.toUpperCase();
            var isChecked;
            if (hadCheckboxes) {
                isChecked = !!prevChecked[up];
            } else {
                isChecked = !col.hidden;
            }
            var cls = col.hidden ? ' class="dbdump-col-hidden"' : '';
            var ttl = col.hidden ? ' title="Hidden in the report"' : '';
            $sel.append(
                '<label' + cls + ttl + '><input type="checkbox" value="' + up + '" style="margin-right:4px;"' + (isChecked ? ' checked' : '') + '> <span class="sched-col-name">' + colNameBreakHtml(col.name) + '</span></label>'
            );
        });
    }

    // Compare a saved task's column list against the report's CURRENT columns.
    //
    // populateDbDumpColumnSelector() only ever lists what the report has right
    // now, and the edit-restore re-checks saved names by matching checkbox
    // values. So a saved column the report no longer has matches NOTHING and
    // disappears from this card without a word - while the task itself keeps
    // dumping that name until somebody re-saves it, and the runner quietly
    // NULL-fills it ("requested column(s) not in raw query result"). Renaming a
    // report column is enough to trigger it; the only obvious escape was to
    // delete the task and rebuild it.
    //
    // Report both directions - names that are gone, and report columns the saved
    // list never knew about - and point at "select report", which already
    // re-syncs the selection.
    function renderDbDumpColumnDrift(savedCols) {
        var $box = $('#schedDbDumpColumnDrift');
        if (!$box.length) return;
        var esc = function (s) {
            return String(s).replace(/[&<>"]/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
            });
        };
        if (!$.isArray(savedCols) || savedCols.length === 0) { $box.hide().empty(); return; }

        var live = {}, liveCount = 0;
        $('#schedDbDumpColumnSelector input[type=checkbox]').each(function () {
            live[String($(this).val()).toUpperCase()] = true;
            liveCount++;
        });
        // No columns rendered means the report data is not loaded yet, not that
        // every saved column vanished. Saying nothing beats crying wolf.
        if (liveCount === 0) { $box.hide().empty(); return; }

        var saved = {}, gone = [], added = [];
        for (var i = 0; i < savedCols.length; i++) {
            var up = String(savedCols[i]).toUpperCase();
            saved[up] = true;
            if (!live[up]) gone.push(up);
        }
        for (var k in live) { if (live.hasOwnProperty(k) && !saved[k]) added.push(k); }
        if (gone.length === 0 && added.length === 0) { $box.hide().empty(); return; }

        var wrap = function (arr) { return '<code>' + arr.sort().map(esc).join('</code>, <code>') + '</code>'; };
        var msg = '<strong>This task\'s column list no longer matches the report.</strong>';
        if (gone.length) {
            msg += '<br>Saved, but the report no longer has ' + (gone.length === 1 ? 'it' : 'them') + ': '
                 + wrap(gone) + ' - the dump writes ' + (gone.length === 1 ? 'this' : 'these') + ' as an empty column.';
        }
        if (added.length) {
            msg += '<br>In the report but not selected here: ' + wrap(added) + '.';
        }
        msg += '<br>Click <strong>select report</strong> above to re-sync, then save the task.';
        $box.html(msg).show();
    }

    // Any manual change to the selection means the owner has taken the drift in
    // hand - stop nagging.
    $(document).on('click', '#schedDbDumpSelectAll, #schedDbDumpSelectNone, #schedDbDumpSelectReport', function () {
        $('#schedDbDumpColumnDrift').hide().empty();
    });

