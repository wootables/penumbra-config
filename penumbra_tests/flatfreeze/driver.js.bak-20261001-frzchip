    FF.set(1, null);
    H.setName('rep6'); H.hydrate();
    var restricted = FF.state();
    penumbra_vars.isAdmin = true; window._penumbraHideColumns = false;
    rec('P7 column customization off: a non-admin gets the report count, not their old pick', restricted.user === null && restricted.wanted === 1, JSON.stringify({ u: restricted.user, w: restricted.wanted }));
    localStorage.removeItem(KEY);
    H.setName('rep1'); H.hydrate();
    FF.set(0, null);
  }

  // ------------------------------------------------------------------------
  function phaseS() {
    if (!FF || !H.openSP) { rec('S settings panel', false, 'flatFreeze or hook missing'); return; }
    var $sel = $('#spFreezeSelect');
    rec('S0 the Freeze control exists: a select offering None and 1 to 5', $sel.length === 1 && $sel.find('option').map(function () { return this.value; }).get().join(',') === '0,1,2,3,4,5' && $('label[for="spFreezeSelect"]').length === 1,
      'options=' + $sel.find('option').map(function () { return this.value; }).get().join(','));
    FF.set(3, null);
    H.openSP();
    rec('S1 opening the panel shows the control at the count in force', $('#spFreezeWrap').is(':visible') && $sel.val() === '3', 'visible=' + $('#spFreezeWrap').is(':visible') + ' val=' + $sel.val());
    var marks = function () { return $('#spColumnList .sp-col-item').map(function (i) { return $(this).hasClass('sp-col-frozen') ? (i + ($(this).hasClass('sp-col-frozen-last') ? 'L' : '')) : null; }).get().join(','); };
    rec('S2 the first three rows of the list are marked, the third as the edge', marks() === '0,1,2L', marks());
    $('#spColumnList .sp-col-item').eq(1).find('.sp-col-check').prop('checked', false).trigger('change');
    rec('S3 unticking a row moves the marks to the first three CHECKED rows (the pending layout)', marks() === '0,2,3L', marks());
    $sel.val('1').trigger('change');
    rec('S4 changing the count re-marks the list straight away', marks() === '0L', marks());

    penumbra_vars.isAdmin = false; window._penumbraHideColumns = true;
    H.openSP();
    var hid = !$('#spFreezeWrap').is(':visible'), m5 = marks();
    penumbra_vars.isAdmin = true; window._penumbraHideColumns = false;
    rec('S5 column customization off: no control and no marks for a non-admin', hid && m5 === '', 'hidden=' + hid + ' marks=' + m5);

    H.openSP();
    FF.set(0, 2);
    wrap().style.width = '260px'; FF.apply();
    var hintOn = $('#spFreezeHint').is(':visible');
    wrap().style.width = '900px'; FF.apply();
    rec('S6 the paused notice shows only while the width guard has the freeze paused', hintOn && !$('#spFreezeHint').is(':visible'), 'paused=' + hintOn + ' after=' + $('#spFreezeHint').is(':visible'));
    $('#settingsPanel').removeClass('is-open');
    FF.set(0, null);
  }

  // ------------------------------------------------------------------------
  function phaseX() {
    if (!FF) { rec('X export count', false, 'flatFreeze missing'); return; }
    FF.set(0, 3);
    var a = FF.exportCount();
    ths()[2].classList.add('journal-notes-col');
    var b = FF.exportCount();
    ths()[2].classList.remove('journal-notes-col');
    FF.set(0, null);
    rec('X1 the XLSX split = the frozen columns the export keeps (the journal notes column is left out)', a === 3 && b === 2 && FF.exportCount() === 0, 'plain=' + a + ' withNotes=' + b + ' none=' + FF.exportCount());
  }

  // ------------------------------------------------------------------------
  function phaseC() {
    if (!FF || !H.setName) { rec('C custom-layout pill', false, 'flatFreeze or hook missing'); return; }
    var fire = function () { document.dispatchEvent(new CustomEvent('penumbra:columns-changed')); };
    localStorage.removeItem('penumbra_column_prefs');
    H.setName('rep1'); H.hydrate();
    FF.set(0, null); fire();
    var off = $('#sbCustomCols').css('display');
    FF.set(0, 2); fire();
    var on = $('#sbCustomCols').css('display'), txt = $('#sbCustomColsDiff').text();
    FF.set(3, 0); fire();
    var txt2 = $('#sbCustomColsDiff').text();
    FF.set(2, 2); fire();
    var same = $('#sbCustomCols').css('display');
    rec('C1 the pill lights for a count that departs from the report, and says both numbers',
      off === 'none' && on !== 'none' && txt.indexOf('Frozen columns: 2 here, none in the report') !== -1 && txt2.indexOf('Frozen columns: none here, 3 in the report') !== -1 && same === 'none',
      'off=' + off + ' on=' + on + ' [' + txt + '] [' + txt2 + '] same=' + same);
    FF.set(0, null); fire();
  }

  // ?frames=1: frames_check.py drives the page itself over CDP. Hand it the
  // fixture helpers and stand aside.
  if (window.__FRAMES) {
    window.__drv = { runQuery: runQuery, makeRows: makeRows, ths: ths, cell: cell, wrap: wrap, setHidden: setHidden };
    document.getElementById('out').textContent = 'READY';
    return;
  }

  (async function () {
    try {
      phaseU();
      var ok = await phaseG();
      if (ok) { phaseK(); phaseP(); phaseS(); phaseX(); phaseC(); }
      finish();
    } catch (e) { finish('driver threw: ' + ((e && e.stack) || e)); }
  })();
})();
