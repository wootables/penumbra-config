// The one template line that CALLS $fn (an open-tag line naming it, whatever
// its arguments - so a mutated call is rendered and judged, not just "not
// found").
function one_line($text, $fn, $label) {
    $hits = array();
    foreach (explode("\n", $text) as $ln) if (strpos($ln, $fn) !== false && strpos($ln, '<' . '?php') !== false) $hits[] = $ln . "\n";
    if (count($hits) !== 1) { fwrite(STDERR, "new line $label found " . count($hits) . " times\n"); exit(2); }
    return $hits[0];
}
