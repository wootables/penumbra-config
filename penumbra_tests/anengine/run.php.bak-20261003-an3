    function bindValue($k, $v, $t = null) { $this->c->log[] = 'bind ' . $k . '=' . json_encode($v); return true; }
    function execute() { $this->c->log[] = 'execute'; if ($this->c->down === 'execute') throw new Exception('fake DB down at execute'); return true; }
    function fetch($mode = null) { return $this->c->rows ? array_shift($this->c->rows) : false; }
}
class FakeSubConn {
    public $log = array(); public $rows; public $down;
    function __construct($rows, $down) { $this->rows = $rows; $this->down = $down; }
    function prepare($sql) { $this->log[] = norm_sql($sql); if ($this->down === 'prepare') throw new Exception('fake DB down at prepare'); return new FakeSubStmt($this); }
}
