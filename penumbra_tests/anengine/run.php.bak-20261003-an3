// ---- cutting blocks ----------------------------------------------------------------
function cut($text, $start, $end, $label) {
    if (substr_count($text, $start) !== 1) { fwrite(STDERR, "block $label: start found " . substr_count($text, $start) . " times\n"); exit(2); }
    $a = strpos($text, $start); $b = strpos($text, $end, $a);
    if ($b === false) { fwrite(STDERR, "block $label: no end\n"); exit(2); }
    return substr($text, $a, $b + strlen($end) - $a);
}
function callOf($text, $fn, $label) {
    if (!preg_match('/^list\(([^)]*)\) = ' . $fn . '\(\n.*?\);\n/ms', $text, $m)) { fwrite(STDERR, "new call $label not found\n"); exit(2); }
    if (preg_match_all('/= ' . $fn . '\(/', $text) !== 1) { fwrite(STDERR, "new call $label found more than once\n"); exit(2); }
    return $m[0];
}

