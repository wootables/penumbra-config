                 'EMPL_CLASS' => '', 'PI_ELIGIBLE' => '0', 'JOBCODE' => '', 'EMPL_STATUS' => 'A', 'OUCS_ALL' => $o, 'SOURCE' => 'HR', 'KIND' => 'person');
}
