// ---- lift functions under their REAL names --------------------------------------
function lift($code, $names) {
    $toks = token_get_all($code); $out = ''; $n = count($toks);
    for ($i = 0; $i < $n; $i++) {
        if (!is_array($toks[$i]) || $toks[$i][0] !== T_FUNCTION) continue;
        $j = $i + 1; while ($j < $n && is_array($toks[$j]) && $toks[$j][0] === T_WHITESPACE) $j++;
        if (!is_array($toks[$j]) || $toks[$j][0] !== T_STRING || !in_array($toks[$j][1], $names, true)) continue;
        $buf = ''; $depth = 0; $started = false;
        for ($k = $i; $k < $n; $k++) {
            $tk = $toks[$k]; $buf .= is_array($tk) ? $tk[1] : $tk;
            if ($tk === '{' || (is_array($tk) && ($tk[0] === T_CURLY_OPEN || $tk[0] === T_DOLLAR_OPEN_CURLY_BRACES))) { $depth++; $started = true; }
            elseif ($tk === '}') { $depth--; if ($started && $depth === 0) break; }
        }
        $out .= $buf . "\n";
    }
    return $out;
}
