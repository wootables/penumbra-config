function canon($sql, $binds) {
    $s = norm_sql($sql);
    ksort($binds);
    if (stripos($s, ' MINUS ') !== false || stripos($s, 'ROWNUM') !== false) return 'RAW ' . $s . ' | ' . json_encode($binds);
    if (!preg_match('/^SELECT (.*) FROM PENUMBRA_AUDIT WHERE (.*?)(?: GROUP BY (.*?))?( ORDER BY 1)?$/', $s, $m)) return 'UNPARSED ' . $s;
    $items = array_map('trim', split_depth0($m[1], '/^,/')); sort($items);
