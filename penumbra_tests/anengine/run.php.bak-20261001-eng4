function split_depth0($s, $sepRe) {   // split at depth 0, outside quotes
    $parts = array(); $depth = 0; $cur = ''; $n = strlen($s); $inq = false;
    for ($i = 0; $i < $n; $i++) {
        $c = $s[$i];
        if ($c === "'") $inq = !$inq;
        if (!$inq) { if ($c === '(') $depth++; elseif ($c === ')') $depth--; }
        if (!$inq && $depth === 0 && preg_match($sepRe, substr($s, $i, 6), $mm)) { $parts[] = $cur; $cur = ''; $i += strlen($mm[0]) - 1; continue; }
        $cur .= $c;
    }
    $parts[] = $cur;
    return $parts;
}
function preds($where) {
    $out = array();
    foreach (split_depth0(' AND ' . $where, '/^ AND /i') as $p) {
        $p = trim($p); if (strtoupper(substr($p, 0, 4)) === 'AND ') $p = trim(substr($p, 4));
        if ($p !== '' && $p !== '1=1') $out[] = $p;
    }
    sort($out);
    return $out;
}
function norm_sql($sql) { return trim(preg_replace('/\s+/', ' ', preg_replace('#/\*.*?\*/#s', ' ', $sql))); }

// ---- the fake directory (increment 3): PENUMBRA_PEOPLE behind the PDO-shaped shim ----
// Who is known hangs off the id alone: ~20% nobody, then a name with no unit
// number, a unit number with no name, a name that carries its number, or a
// plain unit - 20 college prefixes (three unknown: 99, 45, 77) x 60 units, so
// a big crowd fills more than the 250 ranked department rows AND more than 10
// college rows (the deptrank mutant stayed green with 8 prefixes).
function fake_person($u) {
    $c = crc32('dir|' . $u);
    if ($c % 10 < 2) return null;
    $pfxs = array('06', '14', '17', '11', '99', '51', '20', '45', '01', '02', '04', '12', '13', '15', '16', '18', '19', '24', '77', '41');
    $pfx = $pfxs[($c >> 2) % 20]; $unit = ($c >> 4) % 60;
    $ouc = $pfx . str_pad((string)$unit, 4, '0', STR_PAD_LEFT);
    switch (($c >> 10) % 5) {
        case 0:  $o = '';   $d = 'Research Comms'; break;
        case 1:  $o = $ouc; $d = ''; break;
        case 2:  $o = $ouc; $d = $ouc . '-Unit ' . $unit; break;
        default: $o = $ouc; $d = 'Unit ' . $unit . ' of ' . $pfx; break;
    }
    return array('EMPLID' => (string)(100000 + $c % 900000), 'UNITY_ID' => $u, 'FIRST_NAME' => 'F', 'LAST_NAME' => 'L', 'PREFERRED_NAME' => '',
                 'EMAIL' => $u . '@ncsu.edu', 'SUPERVISOR_EMAIL' => '', 'OUC' => $o, 'DEPT_NAME' => $d, 'ACTIVE' => '1', 'JOB_TITLE' => '',
                 'EMPL_CLASS' => '', 'PI_ELIGIBLE' => '0', 'JOBCODE' => '', 'EMPL_STATUS' => 'A', 'OUCS_ALL' => $o, 'SOURCE' => 'HR', 'KIND' => 'person');
}
class FakeDirStmt {
    private $c; private $sql; private $b = array(); private $rows = array();
    function __construct($c, $sql) { $this->c = $c; $this->sql = $sql; }
    function bindValue($k, $v, $t = null) { $this->b[$k] = $v; return true; }
    function execute() {
        $this->c->log[] = norm_sql($this->sql) . ' | ' . json_encode($this->b);
        if ($this->c->down) throw new Exception('fake directory down');
        $this->rows = array();
        foreach ($this->b as $k => $u) if (strpos($k, ':u') === 0) { $p = fake_person($u); if ($p) $this->rows[] = $p; }
        return true;
    }
    function fetch($mode = null) { return $this->rows ? array_shift($this->rows) : false; }
}
