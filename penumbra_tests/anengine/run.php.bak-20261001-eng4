            $hr = str_pad((string)$h, 2, '0', STR_PAD_LEFT); $c = crc32($salt . $dy . $hr) % 6; if ($c) $rows[] = array('DY' => $dy, 'HR' => $hr, 'CNT' => (string)$c);
        }
    } elseif (preg_match('/^SELECT (.*) FROM PENUMBRA_AUDIT WHERE (.*)$/', $s, $m)) {
        // A counter row: every column's value hangs off ITS OWN expression text
        // (and the scope), so an alias asked with a different expression - or a
        // different alias - can never come back with the same number.
        $row = array(); $scope = implode(' & ', preds($m[2]));
        foreach (split_depth0($m[1], '/^,/') as $item) {
            if (!preg_match('/^(.*) AS ([A-Z_0-9]+)$/s', trim($item), $im)) continue;
            $row[$im[2]] = (string)(crc32(trim($im[1]) . '|' . $scope) % 997);
        }
        $rows[] = $row;
    }
    return $rows;
}
