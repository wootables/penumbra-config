function split_depth0($s, $sepRe) {   // split at depth 0, outside quotes
    $parts = array(); $depth = 0; $cur = ''; $n = strlen($s); $inq = false;
    for ($i = 0; $i < $n; $i++) {
        $c = $s[$i];
        if ($c === "'") $inq = !$inq;
        if (!$inq) { if ($c === '(') $depth++; elseif ($c === ')') $depth--; }
        if (!$inq && $depth === 0 && preg_match($sepRe, substr($s, $i, 6), $mm)) { $parts[] = $cur; $cur = ''; $i += strlen($mm[0]) - 1; continue; }
        $cur .= $c;
    }
    $parts[] = $cur;
    return $parts;
}
function preds($where) {
    $out = array();
    foreach (split_depth0(' AND ' . $where, '/^ AND /i') as $p) {
        $p = trim($p); if (strtoupper(substr($p, 0, 4)) === 'AND ') $p = trim(substr($p, 4));
        if ($p !== '' && $p !== '1=1') $out[] = $p;
    }
    sort($out);
    return $out;
}
function norm_sql($sql) { return trim(preg_replace('/\s+/', ' ', preg_replace('#/\*.*?\*/#s', ' ', $sql))); }
function canon($sql, $binds) {
    $s = norm_sql($sql);
    ksort($binds);
    if (stripos($s, ' MINUS ') !== false || stripos($s, 'ROWNUM') !== false) return 'RAW ' . $s . ' | ' . json_encode($binds);
    if (!preg_match('/^SELECT (.*) FROM PENUMBRA_AUDIT WHERE (.*?)(?: GROUP BY (.*?))?( ORDER BY 1)?$/', $s, $m)) return 'UNPARSED ' . $s;
    $items = array_map('trim', split_depth0($m[1], '/^,/')); sort($items);
    return implode(' ; ', $items) . ' | ' . implode(' & ', preds($m[2])) . ' | GROUP ' . (isset($m[3]) ? $m[3] : '') . ' | ' . (!empty($m[4]) ? 'ORDERED' : 'unordered') . ' | ' . json_encode($binds);
}
function fake_rows($sql, $env) {
    $s = norm_sql($sql);
    if (stripos($s, ' MINUS ') !== false) return array(array('CNT' => '7'));
    if (stripos($s, 'ROWNUM') !== false) {
        return (strpos($s, "ACTION='UPDATE'") !== false) ? array(array('USER_ID' => 'jdoe', 'TS' => '2026-09-30 10:00'))
                                                         : array(array('ACTION' => 'SCHEDULE_RUN_OK', 'TS' => '2026-09-30 11:00'));
    }
    $salt = ($env['priorFilter'] !== '' && strpos($sql, $env['priorFilter']) !== false) ? 'P' : 'M';
    $clock = $GLOBALS['__clock']; $rows = array();
    // The row SHAPE comes from the SELECT list only: a custom window's
    // TO_DATE('...','YYYY-MM-DD') sits in the WHERE clause of every query.
    $sel = substr($sql, 0, (int)strpos($sql, 'FROM PENUMBRA_AUDIT'));
    if (strpos($sel, "'YYYY-MM-DD HH24'") !== false) {
        for ($t = $clock - 3 * 86400; $t <= $clock; $t += 3600) { $k = date('Y-m-d H', $t); $c = crc32($salt . $k) % 5; if ($c) $rows[] = array('BUCKET' => $k, 'CNT' => (string)$c); }
    } elseif (strpos($sel, "'YYYY-MM-DD'") !== false) {
        for ($d = 0; $d < 800; $d++) { $k = date('Y-m-d', strtotime("-$d days", $clock)); $c = crc32($salt . $k) % 4; if ($c) $rows[] = array('BUCKET' => $k, 'CNT' => (string)$c); }
    } elseif (strpos($sel, "'YYYY-MM'") !== false) {
        for ($mo = 30; $mo >= 0; $mo--) { $k = date('Y-m', strtotime("-$mo months", strtotime(date('Y-m-01', $clock)))); $c = crc32($salt . $k) % 9; if ($c) $rows[] = array('BUCKET' => $k, 'CNT' => (string)$c); }
    } elseif (strpos($sel, "'DY'") !== false) {
        foreach (array('MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN', ' sun', 'XYZ') as $dy) for ($h = 0; $h <= 24; $h++) {
            $hr = str_pad((string)$h, 2, '0', STR_PAD_LEFT); $c = crc32($salt . $dy . $hr) % 6; if ($c) $rows[] = array('DY' => $dy, 'HR' => $hr, 'CNT' => (string)$c);
        }
    } elseif (preg_match('/^SELECT (.*) FROM PENUMBRA_AUDIT WHERE (.*)$/', $s, $m)) {
        // A counter row: every column's value hangs off ITS OWN expression text
        // (and the scope), so an alias asked with a different expression - or a
        // different alias - can never come back with the same number.
        $row = array(); $scope = implode(' & ', preds($m[2]));
        foreach (split_depth0($m[1], '/^,/') as $item) {
            if (!preg_match('/^(.*) AS ([A-Z_0-9]+)$/s', trim($item), $im)) continue;
            $row[$im[2]] = (string)(crc32(trim($im[1]) . '|' . $scope) % 997);
        }
        $rows[] = $row;
    }
    return $rows;
}
function make_run(&$calls, $env, $failAt) {
    return function ($sql, $binds) use (&$calls, $env, $failAt) {
        $calls[] = canon($sql, $binds);
        if ($failAt !== null && count($calls) === $failAt) throw new Exception('fake DB down');
        return fake_rows($sql, $env);
    };
}
