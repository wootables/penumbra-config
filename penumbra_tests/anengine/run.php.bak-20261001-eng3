        'all_trend' => array('all', array('trend', 'trendPrior', 'trendLabels')),
        'all_heat'  => array('all', array('heatRows', 'heatTotal')),
    );
    foreach ($panels as $pk => $pd) {
        section("1. increment 1, $pk: old inline block vs the new shared call");
        $cases = 0; $outBad = 0; $sqlBad = 0; $logBad = 0; $firstOut = ''; $firstSql = '';
        foreach ($clocks as $clock) foreach ($windows as $get) foreach (($pd[0] === 'an' ? $anScopes : $allScopes) as $sc) foreach (array(null, 1, 2) as $failAt) {
            $w = window_env($get, $clock);
