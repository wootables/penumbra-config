            $env['anWin'] = $w;
            $callsO = array(); $callsN = array();
            $envO = $env; $envO['run'] = make_run($callsO, $env, $failAt);
            $envN = $env; $envN['run'] = make_run($callsN, $env, $failAt);
            read_log($tmpLog);
            $o = \PnbOld\run_block($old[$pk], $envO, $pd[1]); $logO = read_log($tmpLog);
            $n = run_new($new[$pk], $envN, $pd[1]);           $logN = read_log($tmpLog);
            $cases++;
            if ($o !== $n) { $outBad++; if ($firstOut === '') $firstOut = date('Y-m-d H:i', $clock) . ' ' . json_encode($get) . ' fail@' . var_export($failAt, true) . ' old=' . substr(json_encode($o), 0, 200) . ' new=' . substr(json_encode($n), 0, 200); }
            if ($callsO !== $callsN) { $sqlBad++; if ($firstSql === '') $firstSql = json_encode($get) . ' old=' . substr(json_encode($callsO), 0, 300) . ' new=' . substr(json_encode($callsN), 0, 300); }
            if ($logO !== $logN) $logBad++;
        }
        echo "    $cases cases\n";
        t_eq($outBad, 0, "$pk: identical series" . ($firstOut ? " [first: $firstOut]" : ''));
        t_eq($sqlBad, 0, "$pk: the same queries (predicates in any order, binds, grouping, order)" . ($firstSql ? " [first: $firstSql]" : ''));
        t_eq($logBad, 0, "$pk: the same error-log line when the database fails mid-panel");
    }
