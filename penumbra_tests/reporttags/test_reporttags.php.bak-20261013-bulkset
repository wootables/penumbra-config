$PASS = 0; $FAIL = 0;
function ok($cond, $label) { global $PASS, $FAIL; if ($cond) { $PASS++; echo "  ok   $label\n"; } else { $FAIL++; echo "  FAIL $label\n"; } }
function eq($got, $want, $label) {
    global $PASS, $FAIL;
    if ($got === $want) { $PASS++; echo "  ok   $label\n"; }
    else { $FAIL++; echo "  FAIL $label\n       want: " . var_export($want, true) . "\n       got:  " . var_export($got, true) . "\n"; }
}
function fatal($msg) { echo "FATAL: $msg\nRESULT: RED\n"; exit(1); }
/** The :names a statement binds, in order of first appearance (literals stripped first: HH24:MI is not a bind). */
function bindsOf($sql) { $sql = preg_replace("/'[^']*'/", "''", $sql); preg_match_all('/:([a-z0-9_]+)/i', $sql, $m); return array_values(array_unique($m[1])); }
/** The text between two unique anchors of a source file. */
function cut($src, $a, $b, $what) {
    $i = strpos($src, $a);
    if ($i === false) fatal("$what: start anchor missing: $a");
    if (strpos($src, $a, $i + 1) !== false) fatal("$what: start anchor is not unique: $a");
    $j = strpos($src, $b, $i + strlen($a));
    if ($j === false) fatal("$what: end anchor missing: $b");
    return substr($src, $i, $j - $i);
}

