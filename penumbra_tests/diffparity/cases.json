  {
    "name": "sd-sched-keys",
    "what": "date-format calc column vs a scheduler snapshot, key RID",
    "keys": ["RID"],
    "cols": ["RID", "DSRC", "NOTE"],
    "live": [
      {"RID": "r1", "DSRC": "2026-11-04", "NOTE": "a"},
      {"RID": "r2", "DSRC": "2026-11-05", "NOTE": "b"},
      {"RID": "r3", "DSRC": "2026-12-01", "NOTE": "c"},
      {"RID": "r4", "DSRC": "2026-01-15", "NOTE": "d"},
      {"RID": "r6", "DSRC": "", "NOTE": "blank date"}
    ],
    "snap": [
      {"RID": "r1", "DSRC": "2026-11-04", "NOTE": "a", "DUE": "Nov 4, 2026"},
      {"RID": "r2", "DSRC": "2026-11-20", "NOTE": "b", "DUE": "Nov 20, 2026"},
      {"RID": "r3", "DSRC": "2026-12-01", "NOTE": "x", "DUE": "Dec 1, 2026"},
      {"RID": "r4", "DSRC": "2026-01-15", "NOTE": "d", "DUE": "Jan 15, 2026"},
      {"RID": "r5", "DSRC": "2026-02-02", "NOTE": "e", "DUE": "Feb 2, 2026"},
      {"RID": "r6", "DSRC": "", "NOTE": "blank date", "DUE": ""}
    ],
    "snapCreator": "SCHEDULER",
    "calcColumns": [
      {"name": "DUE", "formula": "{DSRC}", "format": "date:MMM D, YYYY"}
    ],
    "expectGroups": {"new": [], "removed": ["r5"], "modified": ["r2:DSRC,DUE", "r3:NOTE"], "unchanged": ["r1", "r4", "r6"]}
  },
