  {
    "name": "duplicate-keys",
    "what": "key ID with the same key twice on both sides: paired by place",
    "keys": ["ID"],
    "cols": ["RID", "ID", "NAME", "AMOUNT", "NOTE"],
    "live": [
      {"RID": "a1", "ID": "7", "NAME": "Golf", "AMOUNT": "$10.00", "NOTE": "first"},
      {"RID": "a2", "ID": "7", "NAME": "Golf", "AMOUNT": "$25.00", "NOTE": "second"},
      {"RID": "a3", "ID": "7", "NAME": "Golf", "AMOUNT": "$30.00", "NOTE": "third"},
      {"RID": "b1", "ID": "8", "NAME": "Hotel", "AMOUNT": "$80.00", "NOTE": "only"}
