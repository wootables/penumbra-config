    "snap": [
      {"RID": "a1", "ID": "7", "NAME": "Golf", "AMOUNT": "$10.00", "NOTE": "first"},
      {"RID": "a2", "ID": "7", "NAME": "Golf", "AMOUNT": "$20.00", "NOTE": "second"},
