    ]
  },
  {
    "name": "ignore-with-key",
    "what": "key ID, NOTE ignored: a row that differs only in NOTE is unchanged; one that also differs in AMOUNT is modified",
    "keys": ["ID", "!NOTE"],
    "cols": ["RID", "ID", "NAME", "AMOUNT", "NOTE"],
    "live": [
      {"RID": "r1", "ID": "1", "NAME": "Alpha", "AMOUNT": "$100.00", "NOTE": "new note"},
      {"RID": "r2", "ID": "2", "NAME": "Bravo", "AMOUNT": "$250.00", "NOTE": "new note"},
