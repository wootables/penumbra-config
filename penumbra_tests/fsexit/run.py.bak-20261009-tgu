def scn_esc():
    tab = Tab('host.html'); obs = {}
    try:
        obs['s0'] = tile_ready(tab)
        # Windowed first: a click on the tile's chart gives the frame focus, so
        # this Escape DOES reach the page (main.js's capture handler routes it
        # to the x -> close()) - and a persistent overlay must survive it.
        c = tab.probe('#%s .cc-canvas' % OVERLAY)
        tab.click(c['x'], c['y'])
        time.sleep(0.2)
        tab.key_escape()
        time.sleep(0.6)
        obs['win'] = tab.state()
        obs['fs'] = press_fs_button(tab, obs, 'e')
        tab.key_escape()
        tab.until(lambda s: s.get('tileFs') is None and s.get('hostFs') is None, 4)
        time.sleep(0.6)
        obs['after'] = tab.state()
    finally:
        tab.close()
    return obs

def scn_report():
    tab = Tab('report.html'); obs = {}
