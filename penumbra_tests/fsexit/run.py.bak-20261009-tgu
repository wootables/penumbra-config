def run_build(js, css):
    open(os.path.join(stage, 'main.js'), 'wb').write(js.encode('utf-8', 'surrogateescape'))
    open(os.path.join(stage, 'main.css'), 'wb').write(css.encode('utf-8', 'surrogateescape'))
    out = {}
    for name, fn in SCENARIOS:
        try: out[name] = fn()
        except Exception as e: out[name] = {'fatal': '%s: %s' % (type(e).__name__, e)}
    return out

def g(d, *ks):
    for k in ks:
        if not isinstance(d, dict): return None
        d = d.get(k)
    return d

def shown(p):
    return bool(p and p.get('exists') and p.get('display') != 'none' and p.get('w') and p.get('opacity') == '1'
                and p.get('visibility') == 'visible' and p.get('inView') and p.get('onTop'))

def brief(p):
    if not p or not p.get('exists'): return 'absent'
    return '%s op=%s pe=%s %dx%d %s%s' % (p.get('display'), p.get('opacity'), p.get('pe'), p.get('w') or 0, p.get('h') or 0,
                                         'on-screen' if p.get('inView') else 'OFF-screen',
                                         ' on-top' if p.get('onTop') else (' covered by %s' % p.get('hitDesc') if p.get('hitDesc') else ' no box'))

def fsbrief(s):
    return 'tile fs=%s host fs=%s overlay=%s denied=%s chart=%s' % (g(s, 'tileFs'), g(s, 'hostFs'), g(s, 'overlay'), g(s, 'denied'), g(s, 'chart'))

# "Fills its stage": the chart's own size (Chart.js width/height, CSS px) within
# this many px of the stage's content box - the wrap padding plus the mount's
# chrome estimates. Measured 2026-10-01 on the fixed build: +16..+32 wide,
# -31..+24 tall (a two-page carousel's chart runs 31 px into the stage padding:
# its nav-bar estimate, as before). The bug it guards: +212 tall in fullscreen,
# -454 wide after a window shrink.
TOL_W, TOL_H = 60, 40
def fills(f):
    return bool(f and f.get('overlay') and f.get('cw') and abs(f['sw'] - f['cw']) <= TOL_W and abs(f['sh'] - f['ch']) <= TOL_H)

def fitbrief(f):
    if not f or not f.get('overlay'): return 'no overlay'
    s = 'viewport %sx%s%s: chart %sx%s in a %sx%s stage (off by %+d x %+d)' % (
        f.get('vw'), f.get('vh'), ' fullscreen' if f.get('fs') else '', f.get('cw'), f.get('ch'), f.get('sw'), f.get('sh'),
        (f.get('sw') or 0) - (f.get('cw') or 0), (f.get('sh') or 0) - (f.get('ch') or 0))
    if 'mounts' in f: s += ', %s mount(s)' % f.get('mounts')
    return s

def evaluate(R):
    out = []
    add = lambda aid, ok, detail: out.append((aid, bool(ok), detail))
    t = R.get('tile', {})
    if t.get('fatal'):
        add('T-fatal', False, t['fatal'])
    else:
        s0 = t.get('s0', {})
        add('T-mount', s0.get('overlay') and s0.get('persistent') and s0.get('chart'), 'overlay %s, persistent %s, chart %s' % (s0.get('overlay'), s0.get('persistent'), s0.get('chart')))
        add('T-nox', g(t, 'x0', 'exists') and g(t, 'x0', 'display') == 'none', 'x in the tile: %s' % brief(t.get('x0')))
        add('T-offer', s0.get('denied') and g(t, 'r1btn', 'opacity') == '1' and g(t, 'r1btn', 'pe') == 'auto' and g(t, 'r1btn', 'onTop'),
            'offered %s; before hover %s; on hover %s' % (s0.get('denied'), brief(t.get('r1btn0')), brief(t.get('r1btn'))))
        f1 = t.get('r1fs') or {}
        add('T-fs', f1.get('tileFs') == OVERLAY and f1.get('hostFs') == 'tile', fsbrief(f1) + ' (screen %sx%s)' % (f1.get('vw'), f1.get('vh')))
        add('T-x', shown(t.get('r1x')), 'x in fullscreen: %s' % brief(t.get('r1x')))
        add('T-name', g(t, 'r1x', 'aria') == 'Exit fullscreen' and g(t, 'r1x', 'title') == 'Exit fullscreen (Esc)',
            'aria-label %r, title %r' % (g(t, 'r1x', 'aria'), g(t, 'r1x', 'title')))
        a1 = t.get('r1after') or {}
        add('T-exit', t.get('r1clicked') and a1.get('tileFs') is None and a1.get('hostFs') is None,
            ('clicked the x: ' if t.get('r1clicked') else 'NO x to click: ') + fsbrief(a1))
        add('T-stay', a1.get('overlay') and a1.get('persistent') and a1.get('chart') and a1.get('denied') and g(t, 'r1x2', 'display') == 'none',
            fsbrief(a1) + '; x after: %s' % brief(t.get('r1x2')))
        f2, a2 = t.get('r2fs') or {}, t.get('r2after') or {}
        add('T-again', f2.get('tileFs') == OVERLAY and shown(t.get('r2x')) and t.get('r2clicked') and a2.get('tileFs') is None
            and a2.get('hostFs') is None and a2.get('overlay') and a2.get('chart') and a2.get('denied'),
            'round 2: in %s / x %s / out %s' % (fsbrief(f2), brief(t.get('r2x')), fsbrief(a2)) if f2 else 'no round 2')
        add('T-fit', fills(t.get('r1fit')) and g(t, 'r1fit', 'fs') and fills(t.get('r1fit2')),
            'fullscreen: %s; back: %s' % (fitbrief(t.get('r1fit')), fitbrief(t.get('r1fit2'))))
        add('T-err', not g(t, 'end', 'errors') and g(t, 'end', 'ready'), 'errors %s' % g(t, 'end', 'errors'))
    k = R.get('kiosk', {})
    if k.get('fatal'):
        add('K-fatal', False, k['fatal'])
    else:
        add('K-kiosk', g(k, 'k', 'hostFs') == 'HTML', 'host fs=%s (%s)' % (g(k, 'k', 'hostFs'), g(k, 'k', 'kiosk')))
        add('K-fs', g(k, 'fs', 'tileFs') == OVERLAY and g(k, 'fs', 'hostFs') == 'tile', fsbrief(k.get('fs')))
        add('K-x', shown(k.get('kx')), 'x: %s' % brief(k.get('kx')))
        ka = k.get('after') or {}
        add('K-exit', k.get('kclicked') and ka.get('tileFs') is None and ka.get('hostFs') == 'HTML' and ka.get('overlay') and ka.get('chart'),
            ('clicked the x: ' if k.get('kclicked') else 'NO x to click: ') + fsbrief(ka))
        add('K-err', not g(k, 'end', 'errors'), 'errors %s' % g(k, 'end', 'errors'))
    e = R.get('esc', {})
    if e.get('fatal'):
        add('E-fatal', False, e['fatal'])
    else:
        ew = e.get('win') or {}
        add('E-win', ew.get('escSeen', 0) >= 1 and ew.get('overlay') and ew.get('persistent') and ew.get('chart') and ew.get('tileFs') is None,
            'windowed: the page saw %s Escape keydown(s); %s' % (ew.get('escSeen'), fsbrief(ew)))
        add('E-fs', g(e, 'fs', 'tileFs') == OVERLAY, fsbrief(e.get('fs')))
        ea = e.get('after') or {}
        add('E-exit', ea.get('tileFs') is None and ea.get('hostFs') is None and ea.get('overlay') and ea.get('chart') and ea.get('denied'),
            fsbrief(ea) + '; the page saw %s Escape keydown(s) in all (the browser keeps the one that leaves fullscreen)' % ea.get('escSeen'))
        add('E-err', not ea.get('errors'), 'errors %s' % ea.get('errors'))
    r = R.get('report', {})
    if r.get('fatal'):
        add('R-fatal', False, r['fatal'])
    else:
        rf = r.get('fs') or {}
        add('R-fs', rf.get('overlay') and not rf.get('persistent') and rf.get('hostFs') == OVERLAY, fsbrief(rf).replace('tile fs=None ', ''))
        add('R-x', shown(r.get('rx')) and g(r, 'rx', 'aria') == 'Close' and g(r, 'rx', 'title') == 'Close (Esc)',
            'x: %s, aria-label %r, title %r' % (brief(r.get('rx')), g(r, 'rx', 'aria'), g(r, 'rx', 'title')))
        ra = r.get('after') or {}
        add('R-close', r.get('rclicked') and not ra.get('overlay') and ra.get('hostFs') is None,
            ('clicked the x: ' if r.get('rclicked') else 'NO x to click: ') + 'overlay %s, fs=%s' % (ra.get('overlay'), ra.get('hostFs')))
        add('R-err', not ra.get('errors'), 'errors %s' % ra.get('errors'))
        ns = r.get('resizeNs')
        left = [n for n in (ns or []) if any(k in n for k in ('ccFit', 'ccPersistentFit', 'chartCarouselSlide'))]
        add('R-unbind', r.get('rclicked') and ns is not None and not left,
            'carousel resize handlers left after the close: %s (window resize namespaces: %s)' % (left or 'none', ns))
    f = R.get('fit', {})
    if f.get('fatal'):
        add('F-fatal', False, f['fatal'])
    else:
        ff = f.get('fit') or {}
        add('F-fs', ff.get('fs'), fitbrief(ff))
        add('F-size', ff.get('fs') and fills(ff), fitbrief(ff))
        add('F-once', ff.get('mounts') == 1, '%s mount(s) of the stage chart' % ff.get('mounts'))
        add('F-err', not g(f, 'end', 'errors'), 'errors %s' % g(f, 'end', 'errors'))
    w = R.get('win', {})
    if w.get('fatal'):
        add('W-fatal', False, w['fatal'])
    else:
        wo, ws, wg, wf = w.get('open') or {}, w.get('shrink') or {}, w.get('grow') or {}, w.get('fs') or {}
        add('W-open', not wo.get('fs') and wo.get('denied') and fills(wo) and wo.get('mounts') == 1, fitbrief(wo))
        add('W-shrink', ws.get('vw') == 1100 and fills(ws), fitbrief(ws))
        adv = [e for e in (w.get('log') or []) if e.get('text') == '2 / 2']
        add('C-keep', bool(adv) and 3600 <= adv[0]['ms'] <= 4600,
            'page 2 at %s ms after the open (interval 4 s; a re-fit ~1.0 s in); counter log %s' % (adv[0]['ms'] if adv else None, w.get('log')))
        add('W-grow', wg.get('vw', 0) > 1100 and fills(wg), fitbrief(wg))
        add('W-fs', wf.get('fs') and fills(wf), fitbrief(wf) if g(w, 'btn', 'w') else 'no fullscreen button: %s' % brief(w.get('btn')))
        add('W-err', not g(w, 'end', 'errors'), 'errors %s' % g(w, 'end', 'errors'))
    return out

def report(res):
    p = f = 0; failed = []
    for aid, passed, detail in res:
        print('  %s  %-8s %s' % ('PASS' if passed else 'FAIL', aid, detail))
        if passed: p += 1
        else: f += 1; failed.append(aid)
    return p, f, failed

try:
    print('candidate: %s' % js_path)
    print('           %s%s' % (css_path, ('   (CONTROL: the build before %s)' % ('FSEXIT' if control_fsexit else 'FSFIT')) if control else ''))
    if mutants or one_mutant:
        ok = bad = 0
        for name in ([one_mutant] if one_mutant else list(MUTANTS)):
            must = MUTANTS[name][1]
            mj, mc = mutate(JS0, CSS0, name)
            res = evaluate(run_build(mj, mc))
            red = [a for a, passed, _ in res if not passed]
            good = not [m for m in must if m not in red]
            ok += good; bad += (not good)
            print('  %s  mutant %-9s turns %s red   [red: %s]' % ('PASS' if good else 'FAIL', name, ' '.join(must), ' '.join(red)))
            if verbose:
                for aid, passed, detail in res:
                    if not passed: print('        %-8s %s' % (aid, detail[:400]))
        print('SUMMARY mutants ok=%d bad=%d' % (ok, bad))
        print('RESULT: GREEN' if bad == 0 else 'RESULT: RED')
    else:
        R = run_build(JS0, CSS0)
        if explore:
            print(json.dumps(R, indent=1, sort_keys=True))
        res = evaluate(R)
        p, f, failed = report(res)
        print('TOTAL pass=%d fail=%d   failed: %s' % (p, f, ' '.join(failed)))
        if control:
            want = sorted(CONTROL_RED_FSEXIT if control_fsexit else CONTROL_RED)
            print('CONTROL: red %s, expected %s' % (' '.join(sorted(failed)), ' '.join(want)))
            print('RESULT: GREEN (the control is red on exactly the expected asserts)' if sorted(failed) == want else 'RESULT: RED (the control is not red where expected)')
        else:
            print('RESULT: GREEN' if f == 0 and p > 0 else 'RESULT: RED')
