class Tab(object):
    def __init__(self, page):
        self.t = jget('/json/new?about:blank', 'PUT')
        self.ws = websocket.create_connection(self.t['webSocketDebuggerUrl'], timeout=60, suppress_origin=True)
        self.n = 0
        # Every build is written to the same main.js / main.css: never let the
        # browser hand a page the previous one (heuristic freshness).
        self.call('Network.enable')
        self.call('Network.setCacheDisabled', {'cacheDisabled': True})
        self.call('Page.enable')
        self.call('Page.bringToFront')
        self.call('Page.navigate', {'url': 'http://127.0.0.1:%d/%s' % (hp, page)})
    def call(self, m, p=None):
        self.n += 1; mid = self.n
        self.ws.send(json.dumps({'id': mid, 'method': m, 'params': p or {}}))
        while True:
            r = json.loads(self.ws.recv())
            if r.get('id') == mid:
                if 'error' in r: raise RuntimeError('%s: %s' % (m, r['error']))
                return r.get('result', {})
    def ev(self, expr):
        r = self.call('Runtime.evaluate', {'expression': expr, 'returnByValue': True})
        if r.get('exceptionDetails'): return None
        return r.get('result', {}).get('value')
    def state(self):
        v = self.ev('window.__state ? JSON.stringify(window.__state()) : null')
        return json.loads(v) if v else {}
    def probe(self, sel, top=False):
        v = self.ev('window.__probe ? JSON.stringify(window.__probe(%s, %s)) : null' % (json.dumps(sel), 'true' if top else 'false'))
        return json.loads(v) if v else {'exists': False}
    def fit(self, fn='__fit'):
        v = self.ev('window.%s ? JSON.stringify(window.%s()) : null' % (fn, fn))
        return json.loads(v) if v else {}
    def viewport(self, w=None, h=None):
        # A device-metrics override resizes the viewport (and fires resize) the way a
        # window resize does; None clears it, back to the window's own size.
        if w is None: self.call('Emulation.clearDeviceMetricsOverride')
        else: self.call('Emulation.setDeviceMetricsOverride', {'width': w, 'height': h, 'deviceScaleFactor': 1, 'mobile': False})
    def until(self, pred, timeout):
        t0 = time.time(); s = self.state()
        while time.time() - t0 < timeout:
            if pred(s): return s
            time.sleep(0.1); s = self.state()
        return s
    def move(self, x, y):
        self.call('Input.dispatchMouseEvent', {'type': 'mouseMoved', 'x': x, 'y': y, 'button': 'none', 'buttons': 0})
    def click(self, x, y):
        self.move(x, y); time.sleep(0.05)
        self.call('Input.dispatchMouseEvent', {'type': 'mousePressed', 'x': x, 'y': y, 'button': 'left', 'buttons': 1, 'clickCount': 1})
        time.sleep(0.05)
        self.call('Input.dispatchMouseEvent', {'type': 'mouseReleased', 'x': x, 'y': y, 'button': 'left', 'buttons': 0, 'clickCount': 1})
    def key_escape(self):
        k = {'key': 'Escape', 'code': 'Escape', 'windowsVirtualKeyCode': 27, 'nativeVirtualKeyCode': 27}
        self.call('Input.dispatchKeyEvent', dict(k, type='rawKeyDown'))
        self.call('Input.dispatchKeyEvent', dict(k, type='keyUp'))
    def close(self):
        try: self.ws.close()
        except Exception: pass
        try: urllib.request.urlopen('http://127.0.0.1:%d/json/close/%s' % (dp, self.t['id']), timeout=10).read()
        except Exception: pass

def tile_ready(tab):
    return tab.until(lambda s: s.get('ready') and s.get('overlay') and s.get('denied'), 20)

def press_fs_button(tab, obs, tag):
    # Hover first (the button is hover-gated in a tile), then a trusted click.
    b = tab.probe('#%s .cc-fsbtn' % OVERLAY)
    obs[tag + 'btn0'] = b
    if not b.get('w'): return None
    tab.move(b['x'], b['y']); time.sleep(0.35)
    b = tab.probe('#%s .cc-fsbtn' % OVERLAY)
    obs[tag + 'btn'] = b
    tab.click(b['x'], b['y'])
    s = tab.until(lambda s: s.get('tileFs') == OVERLAY, 4)
    time.sleep(0.6)   # the persistent refit re-mounts the chart at the new size (200 ms debounce)
    return tab.state()

def press_x(tab, obs, tag, want):
    x = tab.probe('#%s .cc-close' % OVERLAY)
    obs[tag + 'x'] = x
    if not (x.get('w') and x.get('display') != 'none'):
        obs[tag + 'clicked'] = False
        return tab.state()
    obs[tag + 'clicked'] = True
    tab.click(x['x'], x['y'])
    tab.until(want, 4)
    time.sleep(0.6)
    return tab.state()

def scn_tile():
    tab = Tab('host.html'); obs = {}
    try:
        obs['s0'] = tile_ready(tab)
        obs['x0'] = tab.probe('#%s .cc-close' % OVERLAY)
        for rnd in ('r1', 'r2'):
            obs[rnd + 'fs'] = press_fs_button(tab, obs, rnd)
            obs[rnd + 'fit'] = tab.fit('__tileFit')
            obs[rnd + 'after'] = press_x(tab, obs, rnd, lambda s: s.get('tileFs') is None and s.get('hostFs') is None)
            obs[rnd + 'x2'] = tab.probe('#%s .cc-close' % OVERLAY)
            obs[rnd + 'fit2'] = tab.fit('__tileFit')
            if rnd == 'r1' and (obs['r1after'] or {}).get('tileFs'):
                break   # never left fullscreen: there is no second round
        obs['end'] = tab.state()
    finally:
        tab.close()
    return obs

def scn_kiosk():
    tab = Tab('host.html'); obs = {}
