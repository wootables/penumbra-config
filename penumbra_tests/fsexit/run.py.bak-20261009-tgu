def scn_win():
    tab = Tab('report.html?charts=2'); obs = {}
    try:
        obs['s0'] = tab.until(lambda s: s.get('ready'), 20)
        t0 = time.time()
        tab.ev('window.__openNoGesture({ interval: 4 })')   # CDP evaluate = no user activation: refused, windowed
        time.sleep(0.8)
        obs['open'] = tab.fit()
        tab.viewport(1100, 640)
        time.sleep(0.9)
        obs['shrink'] = tab.fit()
        time.sleep(max(0, 4.9 - (time.time() - t0)))   # past the first advance (4 s after the open)
        v = tab.ev('JSON.stringify(window.__counterLog)')
        obs['log'] = json.loads(v) if v else []
        tab.viewport(None)
        time.sleep(0.9)
        obs['grow'] = tab.fit()
        b = tab.probe('#%s .cc-fsbtn' % OVERLAY)
        obs['btn'] = b
        if b.get('w'):
            tab.click(b['x'], b['y'])
            tab.until(lambda s: s.get('hostFs') == OVERLAY, 4)
            time.sleep(0.9)
        obs['fs'] = tab.fit()
        obs['end'] = tab.state()
    finally:
        tab.close()
    return obs

