function run_json($sql, $get) {
    $level = ob_get_level();
    try { $o = json_engine($sql, $get); }
    catch (EngineExit $x) { $j = json_decode($x->getMessage(), true); $o = 'REFUSED: ' . (is_array($j) && isset($j['error']) ? $j['error'] : $x->getMessage()); }
    catch (Throwable $x) { $o = 'THREW: ' . $x->getMessage(); }
    while (ob_get_level() > $level) { ob_end_clean(); }
    return $o;
}
function run_runner($sql, $answers) {
    $a = array(); $b = array();
    try { return process_scheduler_prompts($sql, $answers, $a, $b, array()); }
    catch (Throwable $x) { return 'REFUSED: ' . $x->getMessage(); }
}

// ---- the corpus (format: see its own header)
function load_corpus($file) {
    $text = file_get_contents($file);
    if ($text === false) { fwrite(STDERR, "cannot read $file\n"); exit(2); }
    $cases = array(); $group = ''; $cur = null;
    foreach (preg_split('/\r?\n/', $text) as $line) {
        if (trim($line) === '' || $line[0] === '#') { continue; }
        if (!preg_match('/^([a-z]+):(.*)$/', $line, $m)) { fwrite(STDERR, "corpus: cannot read this line: $line\n"); exit(2); }
        $k = $m[1]; $v = trim($m[2]);
        if ($k === 'group') { $group = $v; continue; }
        if ($k === 'case') {
            if ($cur !== null) { $cases[] = $cur; }
            $cur = array('group' => $group, 'label' => $v, 'sql' => null, 'answers' => array(), 'mode' => '', 'expect' => array());
            continue;
        }
        if ($cur === null) { fwrite(STDERR, "corpus: '$k:' before any case:\n"); exit(2); }
        if ($k === 'sql') { $cur['sql'] = str_replace('\n', "\n", $v); }
        elseif ($k === 'ans') {
            foreach (($v === '' ? array() : explode('&', $v)) as $pair) {
                $eq = strpos($pair, '=');
                $cur['answers'][substr($pair, 0, $eq)] = substr($pair, $eq + 1);
            }
        }
        elseif ($k === 'mode') { $cur['mode'] = $v; }
        elseif ($k === 'all') { $cur['expect'] = array('browser' => $v, 'runner' => $v, 'json' => $v); }
        elseif ($k === 'browser' || $k === 'runner' || $k === 'json') { $cur['expect'][$k] = $v; }
        else { fwrite(STDERR, "corpus: unknown key '$k:'\n"); exit(2); }
    }
    if ($cur !== null) { $cases[] = $cur; }
    foreach ($cases as $c) {
        if ($c['sql'] === null || count($c['expect']) !== 3) { fwrite(STDERR, "corpus: case '" . $c['label'] . "' needs sql: and an expectation for all three engines\n"); exit(2); }
    }
    return $cases;
}

