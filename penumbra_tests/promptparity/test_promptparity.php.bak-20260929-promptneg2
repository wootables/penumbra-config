$pass = 0; $fail = 0; $lines = array();
function check($label, $got, $want) {
    global $pass, $fail, $lines;
    if ($got === $want) { $pass++; $lines[] = '  ok   ' . $label; return; }
    $fail++;
    $lines[] = '  FAIL ' . $label;
    $lines[] = '     got : ' . var_export($got, true);
    $lines[] = '     want: ' . var_export($want, true);
}
function section($t) { global $lines; $lines[] = ''; $lines[] = '--- ' . $t; }
function finish() {
    global $pass, $fail, $lines;
    while (ob_get_level() > 0) { ob_end_clean(); }
    echo implode("\n", $lines), "\n\nPASS: $pass   FAIL: $fail\n";
    exit($fail === 0 ? 0 : 1);
}

function lift($file, array $names) {
    $code = file_get_contents($file);
    if ($code === false) { fwrite(STDERR, "cannot read $file\n"); exit(2); }
    $want = array_flip($names);
    $tokens = token_get_all($code);
    $n = count($tokens); $out = ''; $found = array(); $depth = 0;
    for ($i = 0; $i < $n; $i++) {
        $t = $tokens[$i];
        if ($depth === 0 && is_array($t) && $t[0] === T_FUNCTION) {
            $k = $i + 1;
            while ($k < $n && is_array($tokens[$k]) && in_array($tokens[$k][0], array(T_WHITESPACE, T_COMMENT, T_DOC_COMMENT), true)) { $k++; }
            if ($k < $n && is_array($tokens[$k]) && $tokens[$k][0] === T_STRING) {
                $fname = $tokens[$k][1]; $buf = ''; $d = 0; $opened = false;
                for ($j = $i; $j < $n; $j++) {
                    $tt = $tokens[$j]; $txt = is_array($tt) ? $tt[1] : $tt; $buf .= $txt;
                    if (is_array($tt) && ($tt[0] === T_CURLY_OPEN || $tt[0] === T_DOLLAR_OPEN_CURLY_BRACES)) { $d++; }
                    elseif ($txt === '{') { $d++; $opened = true; }
                    elseif ($txt === '}') { $d--; if ($opened && $d === 0) { break; } }
                }
                if (isset($want[$fname])) { $out .= "if (!function_exists('$fname')) {\n$buf\n}\n"; $found[$fname] = true; }
                $i = $j; continue;
            }
        }
        if (is_array($t)) { if ($t[0] === T_CURLY_OPEN || $t[0] === T_DOLLAR_OPEN_CURLY_BRACES) { $depth++; } }
        elseif ($t === '{') { $depth++; } elseif ($t === '}') { $depth--; }
    }
    foreach ($names as $nm) { if (!isset($found[$nm])) { fwrite(STDERR, "lift: function $nm not found in $file\n"); exit(2); } }
    return $out;
}

