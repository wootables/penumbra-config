       file = 'index.php'; php = 1; browser = 0
       from = '                    $noQuote || $tagGrew || $raw_value === '''');'
       to   = '                    $tagGrew || $raw_value === '''');' },
    @{ name = "M: ?json=1 - the quote rule reaches the NO ANSWER path (c = '''' becomes c = '')"
       file = 'index.php'; php = 1; browser = 0
