    @{ name = "N: scheduler - the quote rule reaches the NO ANSWER path (c = 'NULL' becomes c = NULL)"
       file = 'schedule_runner.php'; php = 1; browser = 0
       from = '            $sql = substr_replace($sql, $nullSql, $tagOffset, strlen($full_tag));'
       to   = '            $sql = penumbraPromptSplice($sql, $tagOffset, strlen($full_tag), $nullSql, false);' },
    @{ name = "I: PHP - what stands in front of a quoted tag is read WITH its quote: c IN ('[tag]') goes out as ONE value"
       file = 'shared_logic.php'; php = 4; browser = 0
       from = "    if (!`$noQuote && `$offset > 0 && `$sql[`$offset - 1] === `"'`""
       to   = "    if (false && `$offset > 0 && `$sql[`$offset - 1] === `"'`"" },
