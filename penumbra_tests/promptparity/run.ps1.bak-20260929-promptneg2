$bad = 0
if ($Only) { $mutants = @($mutants | Where-Object { $Only.Contains($_.name.Substring(0, 1)) }) }
foreach ($m in $mutants) {
    [void](Copy-AppInto $mutApp)
    $target = Join-Path $mutApp $m.file
    $text = [IO.File]::ReadAllText($target)
    $eol  = if ($text.Contains("`r`n")) { "`r`n" } else { "`n" }
    $from = $m.from.Replace("`r`n", "`n").Replace("`n", $eol)
    $to   = $m.to.Replace("`r`n", "`n").Replace("`n", $eol)
    $mut  = $text.Replace($from, $to)
    if ($mut -ceq $text) {
        Write-Output ("ANCHOR MISS - " + $m.name + " (the file has moved; fix the mutant)")
        $bad++
        continue
    }
    # .Replace() changes EVERY copy: an anchor found twice would mutate two places at once.
    $hits = ([regex]::Matches($text, [regex]::Escape($from))).Count
    if ($hits -ne 1) {
        Write-Output ("ANCHOR NOT UNIQUE ($hits hits) - " + $m.name + " (lengthen the anchor)")
        $bad++
        continue
    }
    [IO.File]::WriteAllText($target, $mut)
    $r = Invoke-PromptParitySuite $mutApp $false $m.file
    $wantBuilder = if ($m.ContainsKey('builder')) { $m.builder } else { 0 }
    if ($r.php -eq $m.php -and $r.browser -eq $m.browser -and $r.builder -eq $wantBuilder) { $verdict = 'BITES' } else { $verdict = 'WRONG'; $bad++ }
    Write-Output ("{0,-6} {1}  (expected php {2} / browser {3} / builder {4}, got {5} / {6} / {7})" -f $verdict, $m.name, $m.php, $m.browser, $wantBuilder, $r.php, $r.browser, $r.builder)
    if ($verdict -eq 'WRONG') { $r.lines | Where-Object { $_ -match 'FAIL |NO RESULT|HARNESS|STALLED|lift:' } | ForEach-Object { Write-Output "         $_" } }
}
Write-Output ''
Write-Output $(if ($bad -eq 0) { "MUTANTS: all $($mutants.Count) bite exactly as specified" } else { "MUTANTS: $bad problem(s) - the suite is not pinning what it claims" })
Remove-Work
